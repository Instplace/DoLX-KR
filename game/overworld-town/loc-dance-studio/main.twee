<!-- Version 2.0.3 - REV 190715 -->

:: Dance Studio
<<set $outside to 0>><<set $location to "dance_studio">><<set $eventskip to 0>><<effects>>
<<if $danceStudio.training.injury isnot "none" and $danceStudio.training.injuryUntil lte $timeStamp>>
	<<set $danceStudio.training.injury to "none">><<set $danceStudio.training.injuryUntil to 0>>
<</if>>
You are in the dance studio. Here you can pay for lessons to improve your dancing skill. They also offer lessons on how to walk in high heels, as well as yoga lessons. The instructor is said to be well-connected in the professional scene. Dance and heel lessons cost <<printprice 1200>>. Yoga lessons cost <<printprice 2200>>. Dance practice runs from <<ampm 15 00>> to <<ampm 18 00>>, Monday through Saturday.
<<if $danceStudio.training.lastDecay gt 0>>
	<span class="red">Without enough practice last week, your dancing skill fell by <<print $danceStudio.training.lastDecay>> points.</span>
	<<set $danceStudio.training.lastDecay to 0>>
<</if>>
<<if $danceStudio.training.injuryUntil gt $timeStamp>>
	<span class="blue">Your <<print $danceStudio.training.injury is "hard" ? "dance injury" : "sore feet">> will take about <<print Math.ceil(($danceStudio.training.injuryUntil - $timeStamp) / (24 * 60 * 60))>> more day(s) to heal.</span>
<</if>>
<br><br>
<<set _store_location to "dance_studio">>
<<set _earSlimeEnableDancewear to true>>
<<if $stress gte $stressmax>>
	<<passoutshop "dance_studio">>
<<else>>
	<<if $pleasure gte $pleasuremax>>
		<<orgasmLocation "danceStudio">>
	<</if>>
	<<if Time.hour is $closinghour>>
		마감 시간이다. 접수원이 모두를 밖으로 내보내고 있다.<<if $exposed gte 1>> 이 상태로 발견되면 얼마나 노출될지 깨닫자 당신 안에서 공포가 부풀어 오른다.<</if>>
		<br>
		<<storeon _store_location "check">>
		<<if _store_check is 1>>
			<br>
			탈의실에 옷을 두고 온 것이 기억난다.
			<br>
			<<link [[나가기 전에 옷을 입는다|Barb Street]]>><<storeload _store_location>><</link>>
			<br>
		<</if>>
	<<elseif !Time.openingHours()>>
		어둠 속에 당신은 혼자다.
		<br><br>
	<<elseif $exposed gte 1>>
		<<if $uncomfortable.nude is false>>
			당신은 찬장 안에 숨어 있다. 다른 사람들이 당신의 노출된 모습을 보는 것은 신경 쓰지 않지만, 이번에는 얌전히 숨어 있기로 한다.
		<<else>>
			당신은 품위를 지키기 위해 찬장 안에 숨어 있다.
		<</if>>
		<br><br>
	<</if>>
	<<if Time.openingHours() and $exposed lt 1>>
		<<if $danceStudio.jobOffered>>
			<<if $weekly.danceJob is "done">>
				<span class="blue">찰리가 다음 주에 또 다른 일거리를 줄 겁니다.</span>
				<br>
			<<else>>
				<<socialiseicon "ask">><<link [[일거리를 요청한다|Dance Job Ask]]>><</link>>
				<br>
			<</if>>
		<</if>>
		<<if $exposed lt 1>>
			<<if $danceStudio.training.subscriptionUntil gt $timeStamp>>
				<span class="green">Your dance subscription is active.</span>
				<br>
			<<elseif setup.inflation.canAfford(12000, "danceStudioSubscription")>>
				<<dancestudioicon>><<link "Buy a 30-day dance subscription (<<printprice 12000>>)">><<money -12000 "danceStudioLessons">><<set $danceStudio.training.subscriptionUntil to $timeStamp + (30 * 24 * 60 * 60)>><<replace "#dance-subscription-status">><span class="green">Your subscription is active for 30 days.</span><</replace>><</link>>
				<span id="dance-subscription-status"></span>
				<br>
			<</if>>
			<<if $danceskill gte 800 and $danceStudio.intro and !$danceStudio.jobOffered>>
				<<dancestudioicon>><<link [[Speak with Charlie|Dancing Lesson Job Intro]]>><</link>>
				<br>
			<<elseif Time.weekDay is 1>>
				<span class="blue">Dance classes are closed on Sundays.</span>
				<br>
			<<elseif !Time.betweenHours(15, 17)>>
				<span class="blue">The next dance practice is held between <<ampm 15 00>> and <<ampm 18 00>>.</span>
				<br>
			<<elseif $danceStudio.training.injury is "hard">>
				<span class="red">Your injury needs to heal before you can dance again.</span>
				<br>
			<<elseif ($daily.dancePractices or 0) gte 3>>
				<span class="blue">You have already attended three practices today.</span>
				<br>
			<<elseif ($weekly.dancePracticeLoad or 0) gte 12>>
				<span class="blue">Charlie insists that you rest for the remainder of the week.</span>
				<br>
			<<elseif $danceStudio.training.subscriptionUntil gt $timeStamp or setup.inflation.canAfford(1200, "danceStudioLessons")>>
				<<dancestudioicon>><<link [[Choose a dance practice (<<if $danceStudio.training.subscriptionUntil gt $timeStamp>>subscription<<else>><<printprice 1200>><</if>>)|Dance Practice Selection]]>><</link>><<gtiredness>><<note "Dancing Skill" "green">>
				<br>
			<<else>>
				<span class="blue">You can't afford a dance practice.</span>
				<br>
			<</if>>
		<</if>>
		<<if (Time.weekDay is 3 or Time.weekDay is 5) and $worn.feet.type.includes("heels")>>
			<<if setup.inflation.canAfford(1200, "danceStudioLessons") and $exposed lt 1>>
				<<heelsicon>><<link [[Take high heel lesson (<<printprice 1200>> 0:30)|Heel Lesson]]>><<set $phase to 0>><<money -1200 "danceStudioLessons">><<pass 30>><</link>><<ggtiredness>><<gfeetskill>>
				<br>
			<</if>>
		<<else>>
			<<heelsicon>><<link [[하이힐 레슨에 대해 문의한다|Heel Lesson Inquiry]]>><</link>>
			<br>
		<</if>>
		<<if (Time.weekDay is 2 or Time.weekDay is 4 or Time.weekDay is 6)>>
			<<if setup.inflation.canAfford(2200, "danceStudioLessons")>>
				<<icon "yoga.png">><<link [[Take a yoga lesson (<<printprice 2200>> 1:00)|Yoga Classes Change Room]]>><</link>><<gtiredness>><<if !$daily.yogaWillpower>><<gwillpower>><</if>><<llstress>>
			<</if>>
			<br>
		<<else>>
			<<socialiseicon "ask">><<link [[요가 레슨에 대해 문의한다|Yoga Classes Inquire]]>><</link>>
			<br>
		<</if>>
	<</if>>
	<<if Time.hour isnot $closinghour>>
		<span class="clothes-grey"><<icon "clothes/leotard.png">></span><<link [[탈의실|Dance Studio Changing Room]]>><</link>>
		<br>
	<</if>>
	<<if !Time.openingHours() and Time.hour isnot $closinghour and !$weekly.theft.danceStudio>>
		<<shopicon "register">><<link [[금전 등록기를 살펴본다|Dance Studio Register]]>><</link>>
		<br>
	<</if>>
	<br>
	<<storeon _store_location "check">>
	<<outfitChecks>>
	<<if _store_check is 1 and _topless or _bottomless and $exposed is 1>>
		탈의실에 옷을 두고 왔다. 당신의 <span class="lewd"><<lewdness>></span>【은는】 여기서는 괜찮지만, 밖에서는 외설적으로 보일 것이다.
		<br><br>
		<<if hasSexStat("exhibitionism", 2)>>
			<<getouticon>><<link [[그냥 밖으로 나간다|Dance Studio Outside Exhibitionism]]>><</link>><<if $daily.ex.studio isnot 1>><<exhibitionist2>><</if>>
			<br>
		<</if>>
	<<else>>
		<<barbicon>><<link [[떠난다|Barb Street]]>><</link>>
		<br><br>
	<</if>>
<</if>>

:: Dance Studio Changing Room
<<set $outside to 0>><<set $location to "dance_studio">><<effects>>
<<run ensureDanceStudioWardrobe()>>
You are in the dance studio's changing room. Benches line the walls, with hooks for clothing hanging above. A row of lockers stands at the end of the benches, one of them yours to use.
<br><br>
<<dancingclothes>>
<<lockericon>><<link [[Locker|Dance Studio Locker]]>><</link>>
<br>
<<getouticon>><<link [[떠난다|Dance Studio]]>><</link>>

:: Dance Studio Locker [exitCheckBypass]
<<set $outside to 0>><<set $location to "dance_studio">><<effects>>
<<set $wardrobe_location to "danceStudio">>
<<wardrobeSelection>>
<<set _earSlimeEnableDancewear to true>>
열린 사물함 앞에 선다.
<br><br>
<div id="wardrobewear"><<wardrobewear>></div>
<div id="wardrobeExits"><<wardrobeExits>></div>
<<wardrobe>>

:: Dance Studio Outside Exhibitionism
<<effects>>
<<flaunting>> 당신은 밖으로 나선다. 평범한 외출복 차림이 아니다. 몇몇 사람들이 당신을 훑어보며 몸매를 살핀다.
<<if $daily.ex.studio isnot 1>>
	<<set $daily.ex.studio to 1>><<exhibitionism3>>
<<else>>
	<br><br>
<</if>>
댄스 스튜디오와 상대적인 안전지대를 벗어나자 심장이 더 빨리 뛰기 시작한다.
<br><br>
<<link [[다음|Barb Street]]>><</link>>
<br>

:: Dance Studio Lock
<<set $outside to 1>><<effects>><<set $lock to 200>>
댄스 스튜디오는 닫혀 있다. <<openinghours>>
<br><br>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔만 묶여 있지 않다면</span> 자물쇠를 딸 수 있을 것 같다.
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Dance Studio]]>><<pass 10>><<crimeUp 5 "trespassing">><</link>><<crime "trespassing">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span><<skulduggeryrequired>>
	<br><br>
<</if>>
<<getouticon>><<link [[떠난다|Barb Street]]>><</link>>
<br>

:: Dance Studio Introduction
<<effects>>

<<if $phase is 1>>
	"아, 안녕하세요..." 당신은 발끝만 쳐다보며 중얼거린다.
	<br><br>
	아무 말 없이 강사가 당신에게 다가와 어깨에 보호하듯 팔을 두른다. <<He>>【이가】 속삭인다. "걱정 마, 해치지 않아. 내 이름은 찰리야. 네가 껍질을 깨고 나올 수 있도록 도와줄게." <<He>>【은는】 수업을 시작하기 전에 당신을 부드럽게 다른 수강생들 쪽으로 이끈다.
<<elseif $phase is 2>>
	"만나서 반가워요! 빨리 시작하고 싶어요!"
	<br><br>
	강사가 대답한다. "워, 워, 열정은 좋지만, 너무 과하면 근육이 긴장할 수 있어." <<his>> 경고에도 불구하고, <<He>>【은는】 행복해 보인다. "이리 와. 난 찰리야. 내가 네 선생님이 될 거야. 자, 어디까지 했더라?" 수업이 시작되자 당신은 그쪽으로 향한다.
<<elseif $phase is 3>>
	<<promiscuity1>>"멋진 의상이네요. 당신의 자산을 정말 잘 보여주는군요." 당신은 <<his>> 몸을 훑어보며, 당신이 말하는 자산이 정확히 무엇인지 <<him>>에게 알려준다.
	<br><br>
	<<He>>【은는】 갑자기 자의식이 든 것처럼 그 자리에서 불편하게 몸을 뒤튼다. <<He>>【은는】 짜증 난 표정으로 말한다. "이쪽으로 자리 좀 잡아줄래요? 제 이름은 찰리입니다." 당신이 자리를 잡자 <<he>>【은는】 다른 수강생들에게로 돌아선다. 곧 수업이 시작된다.
<</if>>
<br><br>
<<link [[다음|$danceStudio.introExit]]>><<unset $danceStudio.introExit>><<endevent>><</link>>
<br>

:: Dance Practice Selection
<<set $outside to 0>><<set $location to "dance_studio">><<effects>>
<<if $danceStudio.training.injury isnot "none" and $danceStudio.training.injuryUntil lte $timeStamp>>
	<<set $danceStudio.training.injury to "none">><<set $danceStudio.training.injuryUntil to 0>>
<</if>>
<<set _practiceAccess to Time.weekDay isnot 1 and Time.betweenHours(15, 17) and $danceStudio.training.injury isnot "hard" and ($daily.dancePractices or 0) lt 3 and ($weekly.dancePracticeLoad or 0) lt 12 and ($danceStudio.training.subscriptionUntil gt $timeStamp or setup.inflation.canAfford(1200, "danceStudioLessons"))>>
<<if !_practiceAccess>>
	<span class="blue">This dance practice is no longer available.</span>
	<br><br>
<<else>>
	Charlie asks how hard you want to practise. This week's training load is <<print $weekly.dancePracticeLoad or 0>> out of 12, and you have attended <<print $daily.dancePractices or 0>> out of 3 possible practices today.
	<br><br>
	<<set _painResistance to $danceStudio.training.masteryUntil gt $timeStamp ? 0.75 : 1>>
	<<if ($weekly.dancePracticeLoad or 0) lte 10>>
		<<link [[Light practice (1:00)|Dance Practice Start]]>><<set $danceStudio.practiceChoice to "light">><</link>><<gtiredness>><<note `"+1 Dancing Skill; " + (1 * _painResistance) + "% soreness risk"` "green">>
		<br>
	<</if>>
	<<if $danceStudio.training.injury isnot "light" and ($weekly.dancePracticeLoad or 0) lte 9>>
		<<link [[Medium practice (1:00)|Dance Practice Start]]>><<set $danceStudio.practiceChoice to "medium">><</link>><<ggtiredness>><<note `"+5 Dancing Skill; " + (5 * _painResistance) + "% soreness and " + (1 * _painResistance) + "% injury risk"` "green">>
		<br>
	<<elseif $danceStudio.training.injury is "light">>
		<span class="blue">Your sore feet prevent medium practice.</span>
		<br>
	<</if>>
	<<if $danceStudio.training.injury isnot "light" and ($weekly.dancePracticeLoad or 0) lte 6>>
		<<if $worn.feet.type.includes("heels")>>
			<span class="blue">Charlie will not let you attempt hard practice in heels. You could change your shoes in the changing room.</span>
			<br>
		<<elseif $worn.feet.type.includes("naked")>>
			<span class="blue">Charlie requires supportive footwear for hard practice. You could change your shoes in the changing room.</span>
			<br>
		<<else>>
			<<link [[Hard practice (1:00)|Dance Practice Start]]>><<set $danceStudio.practiceChoice to "hard">><</link>><<gggtiredness>><<note `"+15 Dancing Skill; " + (9 * _painResistance) + "% soreness and " + (9 * _painResistance) + "% injury risk"` "green">>
			<br>
		<</if>>
	<</if>>
<</if>>
<<getouticon>><<link [[Back|Dance Studio]]>><</link>>

:: Dance Practice Start
<<set $outside to 0>><<set $location to "dance_studio">><<effects>>
<<autism-cold-start "task" "Dance Studio" "hour of practice">>
<<if !_autismColdFired>>
<<autism-focus-line "dancing">>
<<set _gain to 0>><<set _load to 0>><<set _lightChance to 0>><<set _hardChance to 0>>
<<switch $danceStudio.practiceChoice>>
	<<case "light">><<set _gain to 1>><<set _load to 2>><<set _lightChance to 1>><<set _hardChance to 0>>
	<<case "medium">><<set _gain to 5>><<set _load to 3>><<set _lightChance to 5>><<set _hardChance to 1>>
	<<case "hard">><<set _gain to 15>><<set _load to 6>><<set _lightChance to 9>><<set _hardChance to 9>>
<</switch>>
<<if $danceStudio.training.injury isnot "none" and $danceStudio.training.injuryUntil lte $timeStamp>>
	<<set $danceStudio.training.injury to "none">><<set $danceStudio.training.injuryUntil to 0>>
<</if>>
<<set _practiceValid to _gain gt 0 and Time.weekDay isnot 1 and Time.betweenHours(15, 17) and $danceStudio.training.injury isnot "hard" and ($daily.dancePractices or 0) lt 3 and ($weekly.dancePracticeLoad or 0) + _load lte 12 and ($danceStudio.training.subscriptionUntil gt $timeStamp or setup.inflation.canAfford(1200, "danceStudioLessons"))>>
<<if ["medium", "hard"].includes($danceStudio.practiceChoice) and $danceStudio.training.injury is "light">><<set _practiceValid to false>><</if>>
<<if $danceStudio.practiceChoice is "hard" and $worn.feet.type.includesAny("heels", "naked")>><<set _practiceValid to false>><</if>>
<<if !_practiceValid>>
	<<unset $danceStudio.practiceChoice>>
	<span class="blue">This dance practice is no longer available.</span>
	<br><br>
	<<getouticon>><<link [[Back|Dance Studio]]>><</link>>
<<else>>
	<<set _oldDanceLevels to ($danceskill gte 2000 ? 9 : $danceskill gte 1750 ? 8 : $danceskill gte 1500 ? 7 : $danceskill gte 1250 ? 6 : $danceskill gte 1000 ? 5 : $danceskill gte 800 ? 4 : $danceskill gte 600 ? 3 : $danceskill gte 400 ? 2 : $danceskill gte 200 ? 1 : 0)>>
	<<set _painResistance to $danceStudio.training.masteryUntil gt $timeStamp ? 0.75 : 1>>
	<<if $danceStudio.training.subscriptionUntil lte $timeStamp>><<money -1200 "danceStudioLessons">><</if>>
	<<set $daily.dancePractices to ($daily.dancePractices or 0) + 1>>
	<<set $weekly.dancePractices to ($weekly.dancePractices or 0) + 1>>
	<<set $weekly.dancePracticeLoad to ($weekly.dancePracticeLoad or 0) + _load>>
	/* Subscribers get a little more out of each practice session. */
	<<if $danceStudio.training.subscriptionUntil gt $timeStamp>><<set _gain += 2>><<willpower 4>><<else>><<willpower 2>><</if>>
	<<danceskill _gain>><<set $danceStudio.stage to 0>><<set $phase to 0>>
	<<set _newDanceLevels to ($danceskill gte 2000 ? 9 : $danceskill gte 1750 ? 8 : $danceskill gte 1500 ? 7 : $danceskill gte 1250 ? 6 : $danceskill gte 1000 ? 5 : $danceskill gte 800 ? 4 : $danceskill gte 600 ? 3 : $danceskill gte 400 ? 2 : $danceskill gte 200 ? 1 : 0)>>
	<<if _newDanceLevels gt _oldDanceLevels or ($danceStudio.practiceChoice is "hard" and $danceskill gte 1000 * $AMCTraits.dancing)>>
		<<set $danceStudio.training.masteryUntil to $timeStamp + (7 * 24 * 60 * 60)>>
		<<if _newDanceLevels gt _oldDanceLevels>>
			<span class="gold">Reaching a new dancing grade fills you with confidence. For one week, your effective dancing skill is 10% higher and dance injuries are less likely.</span>
		<<else>>
			<span class="gold">Demanding practice keeps your mastered technique sharp. For one week, your effective dancing skill is 10% higher and dance injuries are less likely.</span>
		<</if>>
		<br><br>
	<</if>>
	<<set _injuryRoll to random(1, 10000) / 100>>
	<<if _injuryRoll lte _hardChance * _painResistance>>
		<<set _recoveryDays to Math.max(7 - Math.floor(currentSkillValue("physique", 0, 1) / 3000), 3)>>
		<<set $danceStudio.training.injury to "hard">><<set $danceStudio.training.injuryUntil to $timeStamp + (_recoveryDays * 24 * 60 * 60)>>
		<span class="red">A wrong landing sends pain through your leg. Your dancing skill is reduced by 15%, and you cannot practise until the injury heals in <<print _recoveryDays>> days.</span>
		<br><br>
	<<elseif _injuryRoll lte (_hardChance + _lightChance) * _painResistance>>
		<<set $danceStudio.training.injury to "light">><<set $danceStudio.training.injuryUntil to $timeStamp + (3 * 24 * 60 * 60)>>
		<span class="blue">Your feet are sore after a wrong move. Your dancing skill is reduced by 1% for three days, and only light practice is safe.</span>
		<br><br>
	<</if>>
	You join the class and begin your <<print $danceStudio.practiceChoice>> practice.
	<<unset $danceStudio.practiceChoice>>
	<br><br>
	<<link [[다음|Dancing Lesson]]>><</link>>
<</if>>

<</if>>
:: Dancing Lesson
<<if $danceStudio.intro and $phase is 0>><<pass 20>><</if>>
<<set $outside to 0>><<set $location to "dance_studio">><<effects>>

<<if !$danceStudio.intro>>
	<<danceStudioIntro "Dancing Lesson">>
<<elseif $danceStudio.stage gte 2>>
	<<tiredness 4>><<wearandtear "dance">><<physique 2>>
	수업의 나머지 시간은 별일 없이 지나간다.
	<br><br>
	<<perfumeryMoment "Charlie" "class" 50>>
	<<charlieClassBonus>>
	<<link [[다음|Dance Studio]]>><<endevent>><</link>>
<<else>>
	<<if $pleasure gte $pleasuremax>>
		<<orgasmLocation "danceStudioLesson">>
	<</if>>
	<<if $exposed gte 1>>
		왠지 모르게 당신이 수업을 방해하는 것 같다. 아래를 내려다보니, 그 이유를 즉시 알게 된다.
		<<if $uncomfortable.nude is false>>
			몸이 노출되자 스릴을 느끼고, 다른 사람들이 당신의 몸을 슬쩍 훔쳐보도록 내버려 둔다.
			<br>
			찰리가 수건 몇 장을 들고 당신에게 달려오자, 당신은 품위를 가장하며 몸을 가린다.
			<<towelup>><<garousal>><<gstress>><<gtrauma>><<arousal 100>><<npcincr Charlie love 1>><<glove "Charlie">>
			<br><br>
		<<else>>
			비명을 지르며 몸을 가리자 찰리가 수건 몇 장을 들고 당신에게 달려온다.
