:: Widgets X-Change Events [widget]

<<widget "street-resistance-whoring">>
	<<rng>>
	<<set _targetsex to $player.sex is "m"? "f": "m">>
	<<set _npcPronoun to ($rng lte maleChance(_targetsex) ? "m" : "f")>>
	<<generateNPC 1 a _npcPronoun>>
	
    <<person1>>차 한 대가 당신 옆에 선다. 운전자인 <<person>>【이가】 돈다발과 알약을 당신 쪽으로 흔든다. "<span class="pink">이게 레지스턴스야</span>. 나랑 한 번 하면 <<printmoney 100000>> 줄게. 타."
	<br><br>

	<<if $earSlime.growth gt 50 and ($earSlime.growth gte 80 - ($earSlime.promiscuity * 10))>>
		머릿속 <<slimeWord>>【이가】 <span class="lewd">차에 타서 <<him>>에게 몸을 맡기라고</span> 명령하는 것이 느껴진다. 그것은 복종하면 보상을 약속하고, 따르지 않으면 대가가 따를 것이라고 위협한다.
		<br><br>

		<<link [[복종한다|XChange Street Car Slime Obey]]>>
			<<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 2>>
			<<if $promiscuity lte 14>><<set $desperateaction to (earSlimeThoughts() ? "머릿속 목소리가 그렇게 하라고 명령했다" : "귀 슬라임이 그렇게 하라고 명령했다")>><</if>>
		<</link>><<promiscuous2>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[반항한다|XChange Street Car Slime Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>
	<<else>>
		<<if !hasSexStat("promiscuity",2)>>
			<<if $uncomfortable.prostituting>>
				당신은 <<his>> 제안을 받아들일 만큼 헤프지 않다.
			<<else>>
				<<His>> 제안은 역겹지만, 돈이 필요하다.
			<</if>>
			<br><br>
		<</if>>

		<<if hasSexStat("promiscuity",2)>>
			<<if $rng lte 15 and (crimeSumCurrent() gte 1000 or $fame.prostitution gte 400)>>
				<<link [[탄다|XChange Street Car]]>><<set $phase to 10>><</link>><<promiscuous2>>
				<br>
			<<else>>
				<<link [[탄다|XChange Street Car]]>><<set $phase to 1>><</link>><<promiscuous2>>
				<br>
			<</if>>
		<</if>>

		<<if !hasSexStat("promiscuity",2) and $uncomfortable.prostituting is false>>
			<<if $rng lte 15 and (crimeSumCurrent() gte 1000 or $fame.prostitution gte 400)>>
				<<link [[마지못해 탄다|XChange Street Car]]>><<set $desperateaction to 1>><<set $phase to 10>><</link>><<promiscuous2>>
				<br>
			<<else>>
				<<link [[마지못해 탄다|XChange Street Car]]>><<set $desperateaction to 1>><<set $phase to 1>><</link>><<promiscuous2>>
				<br>
			<</if>>
		<</if>>
		<<link [[거절한다|XChange Street Car]]>><<set $phase to 2>><</link>><<gstress>>
	<</if>>
	<br>
<</widget>>


<<widget "mailboxsteallink">>
	<<set _street to _args[0]>>
	<<set _streetName to _args[1]>>
	<<set _returnPassage to _args[2]>>
	<<set _min to _args[3]>>
	<<set _max to _args[4]>>
	<<set _place to _args[5]>>
	<<if !$daily.mailboxSteal or typeof $daily.mailboxSteal isnot "object" or Array.isArray($daily.mailboxSteal)>>
		<<set $daily.mailboxSteal to {}>>
	<</if>>
	<<if !$daily.mailboxSteal[_street]>>
		<<if pcAreArmsBound("both")>>
			<<crimeicon "mark">><span class="red">팔이 묶인 채로는 우편함에서 훔칠 수 없다.</span>
			<br>
		<<else>>
			<<set $skulduggerydifficulty to 800>>
			<<capture _street, _streetName, _returnPassage, _min, _max, _place>>
				<<crimeicon "mark">><<link [[우편함을 턴다 (0:02)|Street Mailbox Steal]]>>
					<<set $mailboxSteal to {
						street: _street,
						streetName: _streetName,
						returnPassage: _returnPassage,
						min: _min,
						max: _max,
						place: _place
					}>>
					<<pass 2>><<crimeUp 3 "petty">>
				<</link>><<skulduggerydifficulty>><<crime "petty">>
			<</capture>>
			<br>
		<</if>>
	<</if>>
<</widget>>