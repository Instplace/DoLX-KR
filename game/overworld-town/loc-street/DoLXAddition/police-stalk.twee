:: Street Police Stalk Widgets [widget]

	<<widget "stalkpolice1">>
		<<generatePolice 1>><<person1>>
		푸른 제복의 경찰관 한 명이 걸어가는 당신을 본다. <span class="blue">누군가 따라오는 느낌이 든다.</span>
		<br><br>
		
		<<link [[다음|Street Police Stalk]]>><<set $molestationstart to 1>><</link>>
		<br>
	<</widget>>

	<<widget "stalkpolice2">>
		<<generatePolice 1>><<generatePolice 2>><<person1>>경찰관 한 명이 <<his>> 동료와 함께 지나가는 당신을 본다. <span class="blue">누군가 따라오는 느낌이 든다.</span>
		<br><br>

		<<link [[다음|Street Police Stalk Group]]>><<set $molestationstart to 1>><</link>>
		<br>
	<</widget>>

	<<widget "stalkpolicebound">>
		<<generatePolice 1>><<person1>>
		<<if Time.dayState is "night">>
			어둠 속, 등 뒤 어딘가에서 발소리가 들려온다. 결박된 팔 때문에 당신은 몹시 무력감을 느낀다. <span class="blue">누군가 당신의 뒤를 밟고 있다.</span>
			<br><br>

			<<link [[다음|Street Stalk]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<else>>
			경찰관 한 명이 당신에게 다가온다. "누가 이렇게 묶어놨어? 자, 이쪽." <<He>>【은는】 당신 뒤로 돌아가 사지를 묶은 끈을 풀어준다.<<unbind>>
			<br><br>

			<<endevent>>
			<<destinationeventend>>
		<</if>>
	<</widget>>

	<<widget "stalkpolicelowertowel">>
		<<if Time.dayState is "night">>
			<<generatePolice 1>><<generatePolice 2>><<generatePolice 3>><<person1>>
			어둠 속 어딘가에서 등 뒤로 발소리가 들린다. 허리에 두른 수건이 신경 쓰인다. <span class="blue">누군가 따라오고 있다.</span>
			<br><br>

			<<link [[다음|Street Police Stalk Group]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<else>>
			<<generatePolice 1>><<person1>>등 뒤에서 가벼운 발소리가 들린다. 허리에 두른 수건이 신경 쓰인다. <span class="blue">누군가 따라오고 있다.</span>
			<br><br>

			<<link [[다음|Street Police Stalk]]>><<set $molestationstart to 1>><</link>>
			<br>
		<</if>>
	<</widget>>

	<<widget "stalkpoliceuppertowel">>
		<<if Time.dayState is "night">>
			<<generatePolice 1>><<generatePolice 2>><<generatePolice 3>><<person1>>
			어둠 속 어딘가에서 등 뒤로 발소리가 들린다. 가슴에 두른 수건이 신경 쓰인다. <span class="blue">누군가 따라오고 있다.</span>
			<br><br>

			<<link [[다음|Street Police Stalk Group]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<else>>
			<<generatePolice 1>><<person1>>등 뒤에서 가벼운 발소리가 들린다. 가슴에 두른 수건이 신경 쓰인다. <span class="blue">누군가 따라오고 있다.</span>
			<br><br>

			<<link [[다음|Street Police Stalk]]>><<set $molestationstart to 1>><</link>>
			<br>
		<</if>>
	<</widget>>

:: Street Police Stalk
	<<if $molestationstart is 1>>
		<<set $molestationstart to 0>>
		<<violence 1>>
		<<neutral 1>>
		<<maninit>>
		<<stalk_init>>
		<<if Time.dayState isnot "night">>
			<<enable_rescue>>
		<</if>>
	<</if>>

	<<effects>>
	<<effectsman>>
	<<alarmstate>>
	<<man>>
	<<if $audience_active>>
		<<audience>>
	<</if>>
	<<stateman>>
	<br><br>
	<<actionsman>>

	<<if _combatend or $stalk_end>>
		<span id="next"><<link [[다음|Street Police Stalk Finish]]>><</link>></span><<nexttext>>
	<<else>>
		<span id="next"><<link [[다음|Street Police Stalk]]>><</link>></span><<nexttext>>
	<</if>>

:: Street Police Stalk Run
	<<if $molestationstart is 1>>
		<<set $molestationstart to 0>>
		<<violence 1>>
		<<neutral 1>>
		<<maninit>>
		<<stalk_init>>
		<<stalk_run>>
		<<if Time.dayState isnot "night">>
			<<enable_rescue>>
		<</if>>
		당신은 돌아서서 달린다. <span class="pink">추격당하고 있다.</span>
	<</if>>

	<<effects>>
	<<effectsman>>
	<<alarmstate>>
	<<man>>
	<<if $audience_active>>
		<<audience>>
	<</if>>
	<<stateman>>
	<br><br>
	<<actionsman>>

	<<if _combatend or $stalk_end>>
		<span id="next"><<link [[다음|Street Police Stalk Finish]]>><</link>></span><<nexttext>>
	<<else>>
		<span id="next"><<link [[다음|Street Police Stalk Run]]>><</link>></span><<nexttext>>
	<</if>>

:: Street Police Stalk Finish
	<<effects>>
	<<if $enemypleasure gte $enemypleasuremax>>
		<<ejaculation>>
		<<if $combat_end_text>>
			<<print $combat_end_text>>
		<<elseif $enemyanger gte ($enemyangermax / 5) * 3>>
			<<He>>【은는】 당신을 보도에 내던진다.
			<<violence 3>>
			<br><br>
		<<elseif $enemyanger gte 1>>
			<<He>>【이가】 말없이 걸어간다.
			<br><br>
		<<else>>
			미소를 지으며, <<he>>【이가】 당신의 뺨에 키스한다. "이건 널 위한 거야." <<He>>【은는】 일어나 바닥에 누워있는 당신을 두고 떠난다.
			<br>
			<<moneyGain 5>>【을를】 얻었다.
			<br><br>
		<</if>>
		<<underlowersteal>>
		<<tearful>> 당신은 자리에서 일어선다.
		<br><br>

		<<clotheson>>
		<<endcombat>>
		<<destinationeventend>>

	<<elseif $enemyhealth lte 0>>
		<<if Time.dayState isnot "night">>
			<<person>>【이가】 고통에 움찔하며 물러서고, 당신은 기다리던 기회를 얻는다. <<tearful>> 당신은 인파 속으로 달아난다.
			<br><br>
		<<else>>
			<<person>>【이가】 고통에 움찔하며 물러서고, 당신은 기다리던 기회를 얻는다. <<tearful>> 당신은 어둠 속으로 달아난다.
			<br><br>
		<</if>>
		<<clotheson>>
		<<endcombat>>
		<<destinationeventend>>
	<<elseif $stalk_end is "escaped">>
		당신은 걸음으로 속도를 늦춘다. <<tearful>> 당신은 여정을 계속한다.
		<br><br>

		<<clotheson>>
		<<endcombat>>

		<<destinationeventend>>

	<<elseif $stalk_end is "passed">>
		<<person>>【이가】 앞서 걸어간다. <<tearful>> 당신은 여정을 계속한다.
		<br><br>
		<<clotheson>>
		<<endcombat>>

		<<destinationeventend>>

	<<elseif $stalk_end is "hide">>
		<<covered>> <<tearful>> 당신은 숨어있던 곳에서 나온다. 당신은 여정을 계속한다.
		<br><br>

		<<set $stealtextskip to 1>>
		<<stealclothes>>
		<<clotheson>>
		<<endcombat>>

		<<destinationeventend>>
		<br>

	<<elseif $stalk_end is "outpaced">>/*Unnecessary if the PC can't become the pursuer */
		<<if $exposed gte 1>>
			<<switch $location>>
			<<case alley>>
				<<tearful>> 당신은 멈춰 선다. <<covered>> 주변에는 아무도 없지만, 여전히 공공장소다.
			<<case forest lake>>
				<<tearful>> 당신은 멈춰 선다. <<covered>> 지금은 주변에 아무도 없지만, 숲에서 누구를 만날지 알 수 없다.
			<<case moor>>
				<<tearful>> 당신은 멈춰 선다. <<covered>> 주변에는 아무도 없지만, 이렇게 탁 트인 곳에서 노출되는 것은 어쨌든 무섭다.
			<<default>>
				<<covered>> <<tearful>> 당신은 엿보는 눈들로부터 몸을 가리기 위해 골목으로 뛰어든다.
			<</switch>>
		<<else>>
			<<tearful>> 당신은 걸음을 멈춘다.
		<</if>>
		<br><br>
		<<set $stealtextskip to 1>>
		<<stealclothes>>
		<<clotheson>>
		<<endcombat>>

		<<destinationeventend>>
		<br>
	<<else>>
		<<set $rescued += 1>>
		<<if $finish is 1>><<encounterEndViolence>><</if>>
		<<if $position is "stalk">>
			몇몇 사람들이 당신 쪽으로 고개를 돌린다. 추격자는 <<his>> 거리를 유지한다.
		<<else>>
			<<person>>【은는】 당신의 비명에 몇몇 사람들이 고개를 돌리는 것을 보고, <<his>> 공격을 멈추고 도망친다.
		<</if>>
		<br><br>
		<<tearful>> 당신은 여정을 계속한다.
		<<clotheson>>
		<<endcombat>>
		<<destinationeventend>>
	<</if>>

:: Street Police Stalk Group
	<<if $molestationstart is 1>>
		<<set $molestationstart to 0>>
		<<violence 1>>
		<<neutral 1>>

		<<maninit>>
		<<stalk_init>>
		<<if Time.dayState isnot "night">>
			<<enable_rescue>>
		<</if>>
	<</if>>

	<<effects>>
	<<effectsman>>
	<<alarmstate>>
	<<man>>
	<<if $audience_active>>
		<<audience>>
	<</if>>
	<<stateman>>
	<br><br>
	<<actionsman>>

	<<if _combatend or $stalk_end>>
		<span id="next"><<link [[다음|Street Police Stalk Group Finish]]>><</link>></span><<nexttext>>
	<<else>>
		<span id="next"><<link [[다음|Street Police Stalk Group]]>><</link>></span><<nexttext>>
	<</if>>

:: Street Police Stalk Group Run
	<<if $molestationstart is 1>>
		<<set $molestationstart to 0>>
		<<violence 1>>
		<<neutral 1>>
		<<maninit>>
		<<stalk_init>>
		<<stalk_run>>
		<<if Time.dayState isnot "night">>
			<<enable_rescue>>
		<</if>>
	<</if>>

	<<effects>>
	<<effectsman>>
	<<alarmstate>>
	<<man>>
	<<if $audience_active>>
		<<audience>>
	<</if>>
	<<stateman>>
	<br><br>
	<<actionsman>>

	<<if _combatend or $stalk_end>>
		<span id="next"><<link [[다음|Street Police Stalk Group Finish]]>><</link>></span><<nexttext>>
	<<else>>
		<span id="next"><<link [[다음|Street Police Stalk Group Run]]>><</link>></span><<nexttext>>
