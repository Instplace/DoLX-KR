:: mapLocations [widget]
<<widget "mapLocations">>
	<!--keeps track of old settings for older versions-->
	<<if $availableMapsVersion is 3>>
		<<set _map to clone($map)>>
	<</if>>
	<<set $map to {
		"hideLinks": false,
		"available": {
			"Domus Street": ["Barb Street", "Danube Street", "Residential Alleyways"],

			"Barb Street": ["Domus Street", "Cliff Street", "Connudatus Street", "Residential Alleyways"],
			"Danube Street": ["Domus Street", "Wolf Street", "Connudatus Street", "Residential Alleyways"],

			"Connudatus Street": ["Barb Street", "Danube Street", "Cliff Street", "Wolf Street", "Residential Alleyways", "Commercial Alleyways"],

			"Cliff Street": ["Barb Street", "Starfish Street", "Connudatus Street", "High Street", "Commercial Alleyways"],
			"Wolf Street": ["Danube Street", "Nightingale Street", "Connudatus Street", "High Street", "Commercial Alleyways"],

			"High Street": ["Cliff Street", "Wolf Street", "Starfish Street", "Nightingale Street", "Commercial Alleyways", "Park"],

			"Starfish Street": ["Cliff Street", "Mer Street", "High Street", "Oxford Street", "Park"],
			"Nightingale Street": ["Wolf Street", "Elk Street", "High Street", "Oxford Street", "Park"],

			"Oxford Street": ["Starfish Street", "Nightingale Street", "Mer Street", "Elk Street", "Park", "Industrial Alleyways"],

			"Mer Street": ["Starfish Street", "Oxford Street", "Harvest Street", "Industrial Alleyways"],
			"Elk Street": ["Nightingale Street", "Oxford Street", "Harvest Street", "Industrial Alleyways"],

			"Harvest Street": ["Mer Street", "Elk Street", "Industrial Alleyways"],

			"Residential Alleyways": ["Domus Street", "Barb Street", "Danube Street", "Connudatus Street", "Commercial Alleyways"],
			"Commercial Alleyways": ["Connudatus Street", "Cliff Street", "Wolf Street", "High Street", "Residential Alleyways", "Park"],
			"Park": ["High Street", "Starfish Street", "Oxford Street", "Nightingale Street", "Commercial Alleyways", "Industrial Alleyways"],
			"Industrial Alleyways": ["Oxford Street", "Mer Street", "Elk Street", "Harvest Street", "Park"]
		},
		"arrayList": ["Domus Street","Barb Street","Danube Street","Connudatus Street","Cliff Street","Wolf Street","High Street","Starfish Street","Nightingale Street","Oxford Street","Mer Street","Elk Street","Harvest Street","Residential Alleyways","Commercial Alleyways","Park","Industrial Alleyways"]
	}>>
	<<set $availableMapsVersion to 4>>
<</widget>>

:: Widget displayLinks [widget]
<<widget "displayLinks">>
	<<for _i to 0; _i lt $link_table.length; _i++>>
		<<if $map.hideLinks is true and $options.mapMovement is true>>
			<<if $map.hideLinksCheck[_i] is true>>
				<<continue>>
			<</if>>
		<</if>>
		<<print $link_table[_i]>>
	<</for>>
<</widget>>

<<widget "add_link">>
	<<if _args[0]>>
		<<set $link_table[$link_table.length] to _args[0]>>
	<</if>>
<</widget>>

<<widget "hideDisplay">>
	<<if $map.hideLinks is true and $options.mapMovement is true>>
		<<if _args[0] is true>>
			<<set $map.hideLinksCheck.push(true)>>
		<<else>>
			<<set $map.hideLinksCheck.push(false)>>
		<</if>>
	<</if>>
<</widget>>


:: Loiter
<<effects>>
<<if $loiterReturnPassage is undefined or $loiterReturnPassage is "">>
	<<set $loiterReturnPassage to passage()>>
<</if>>
<<print either(
	"당신은 그 자리에 머물며 지나가는 사람들을 구경하고, 시간이 흘러가게 둔다.",
	"당신은 서둘러 갈 곳도 없이 어슬렁거린다.",
	"당신은 서성일 만한 자리를 찾아, 누군가를 기다리는 사람인 척 그럭저럭 연기한다.",
	"당신은 사람들을 구경하고 생각이 흘러가게 두며 한가롭게 시간을 때운다.",
	"당신은 한 발 물러서서 특별히 하는 일 없이 시간이 흐르게 둔다.",
)>>
<br><br>
얼마나 오래 서성일까?
<br>
<<link "1분 동안 서성인다 (0:01)" "Loiter Result">><<set $loiterDuration to 1>><</link>>
<br>
<<link "5분 동안 서성인다 (0:05)" "Loiter Result">><<set $loiterDuration to 5>><</link>>
<br>
<<link "10분 동안 서성인다 (0:10)" "Loiter Result">><<set $loiterDuration to 10>><</link>>
<br>
<<link "30분 동안 서성인다 (0:30)" "Loiter Result">><<set $loiterDuration to 30>><</link>>
<br>
<<link "한 시간 동안 서성인다 (1:00)" "Loiter Result">><<set $loiterDuration to 60>><</link>>
<br>
<<link "2시간 동안 서성인다 (2:00)" "Loiter Result">><<set $loiterDuration to 120>><</link>>
<br>
<<link "3시간 동안 서성인다 (3:00)" "Loiter Result">><<set $loiterDuration to 180>><</link>>
<br>

:: Loiter Result
<<effects>>
<<set _dest to $loiterReturnPassage is undefined or $loiterReturnPassage is "" ? "Danube Street" : $loiterReturnPassage>>
<<set _duration to Number.isFinite($loiterDuration) ? $loiterDuration : 1>>
<<unset $loiterReturnPassage, $loiterDuration>>
<<switch _duration>>
	<<case 1>><<set _interruptChance to 1>>
	<<case 5>><<set _interruptChance to 5>>
	<<case 10>><<set _interruptChance to 10>>
	<<case 30>><<set _interruptChance to 20>>
	<<case 60>><<set _interruptChance to 40>>
	<<case 120>><<set _interruptChance to 60>>
	<<default>><<set _interruptChance to 80>>
<</switch>>
<<set _interrupted to random(1, 100) lte _interruptChance>>
<<set _elapsed to _interrupted ? Math.max(1, Math.round(_duration * random(30, 60) / 100)) : _duration>>
<<pass _elapsed>>
<<if !_interrupted>>
	당신은 내내 방해받지 않고 서성인다.
	<br><br>
	<<link "다음" _dest>><</link>>
<<else>>
	<<set _conversation to _duration gte 30 and random(1, 100) lte 60>>
	<<if _conversation>>
		<<set _people to ["stranger", "stranger", "stranger", "stranger", "stranger", "stranger"]>>
		<<if C.npc.Whitney.init is 1 and C.npc.Whitney.state is "active">><<run _people.push("Whitney")>><</if>>
		<<if C.npc.Robin.init is 1 and $robinmissing is 0>><<run _people.push("Robin")>><</if>>
		<<if C.npc.Kylar.init is 1 and C.npc.Kylar.state is "active">><<run _people.push("Kylar")>><</if>>
		<<if C.npc.Sydney.init is 1>><<run _people.push("Sydney")>><</if>>
		<<if C.npc.Avery.init is 1 and C.npc.Avery.state is "active" and !$avery_injury>><<run _people.push("Avery")>><</if>>
		<<if C.npc.Bailey.init is 1>><<run _people.push("Bailey")>><</if>>
		<<set $loiterChat to {
			return: _dest,
			person: _people[random(0, _people.length - 1)],
			topic: random(1, 3),
			reward: random(10, 30) * 100
		}>>
		<<link [[누군가 다가온다|Loiter Conversation]]>><</link>>
	<<else>>
		<<set _outcome to random(1, 100)>>
		<<if _outcome lte 20>>
			<<generate1>><<person1>>
			당신을 지켜보던 누군가가 마침내 다가온다. 당신이 피하기도 전에, 그들이 당신을 붙잡는다.
			<br><br>
			<<if _dest is "Pub">>
				<<link [[다음|Pub Approach Sex]]>><<set $phase to 1>><<set $molestationstart to 1>><</link>>
			<<else>>
				<<link [[다음|Street Molestation]]>><<set $molestationstart to 1>><</link>>
			<</if>>
		<<elseif _outcome lte 45>>
			수상쩍게 여긴 행인이 멈춰 서서 왜 서성이고 있는지 캐묻는다. 당신은 이제 자리를 뜰 때라고 판단한다.
			<br><br>
			<<link "다음" _dest>><</link>>
		<<elseif _outcome lte 70>>
			낯선 사람이 관심을 달라고 치근덕거려, 조용히 서성이는 것이 불가능해진다.
			<br><br>
			<<link "그들을 뒤로하고 떠난다" _dest>><</link>>
		<<else>>
			근처의 소동 때문에 서성이던 일을 마치기도 전에 자리에서 쫓겨난다.
			<br><br>
			<<link "다음" _dest>><</link>>
		<</if>>
	<</if>>
<</if>>
<br>

:: Loiter Conversation
<<effects>>
<<if !$loiterChat>>
	이야기하던 사람은 이미 가 버렸다.
	<br><br>
	<<link [[다음|Danube Street]]>><</link>>
<<elseif $loiterChat.person is "stranger">>
	<<generate1>><<person1>>
	<<person>>【이가】 당신이 한동안 서성이고 있는 것을 알아채고 걸음을 늦춘다. <<He>>【은는】 망설이다가, 작고 어색한 미소를 건넨다.
	<br><br>
	"이상하게 들리면 미안해요. 시간 있어 보여서요. 잠깐 이야기 좀 나눠 주실래요? 제대로 된 대화 말이에요. 시간 값은 드릴게요."
	<br><br>
	<<link [[상대의 이야기를 들어 본다|Loiter Conversation Talk]]>><</link>>
	<br>
	<<link "상대를 뒤로하고 떠난다" $loiterChat.return>><<unset $loiterChat>><<endevent>><</link>>
<<else>>
	<<npc $loiterChat.person>><<person1>>
	<<switch $loiterChat.person>>
		<<case "Whitney">>
			어깨 하나가 당신의 어깨에 부딪힌다. 휘트니는 우연인 척할 만큼 오래 당신 곁에 서 있었다. "뭐야, 달리 갈 데도 없어?" <<he>>【이가】 묻는다. <<He>>【은는】 떠나지 않는다.
		<<case "Robin">>
			로빈이 길 건너에서 당신을 발견하고 서둘러 다가온다. "너 여기 한참 있었네." <<he>>【이가】 말한다. "같이 있어 줄 사람이 필요할까 싶어서."
		<<case "Kylar">>
			시야 가장자리에서 카일라가 눈에 들어온다. 당신이 마침내 <<him>>【을를】 똑바로 쳐다보자, <<he>>【이가】 흠칫 놀란다. "나, 나 방금 막 왔어." <<he>>【이가】 말하더니, 조용히 곁에 있어도 되냐고 묻는다.
		<<case "Sydney">>
			시드니가 음료 두 잔을 들고 당신 앞에 멈춰 선다. "잠깐 쉬어야 할 것 같아 보여서요." <<he>>【이가】 말한다. "그리고 저도 화면 뒤에 있지 않은 사람에게 고백할 상대가 필요하거든요."
		<<case "Avery">>
			에이버리의 차가 근처에 멈춰 선다. 창문이 내려간다. "아무것도 안 하고 있는 것 같네요." <<he>>【이가】 말한다. "마침 잘됐어요. 이십 분쯤 여유가 생겼거든요."
		<<case "Bailey">>
			베일리가 서성이는 당신을 붙잡고 시간을 확인한다. "서서 빈둥댈 시간이 있으면, 들을 시간도 있겠지." <<he>>【이가】 말한다. <<he>>【이가】 보내는 눈빛은 이것이 부탁이 아님을 분명히 한다.
	<</switch>>
	<br><br>
	<<link [[머물러서 이야기한다|Loiter Conversation Talk]]>><</link>>
	<br>
	<<link "상대를 뒤로하고 떠난다" $loiterChat.return>><<unset $loiterChat>><<endevent>><</link>>
<</if>>
<br>

:: Loiter Conversation Talk
<<effects>>
<<if !$loiterChat>>
	대화는 이미 끝났다.
	<br><br>
	<<link [[다음|Danube Street]]>><</link>>
<<else>>
	<<switch $loiterChat.person>>
		<<case "stranger">>
			<<switch $loiterChat.topic>>
				<<case 1>>
					<<He>>【이가】 어느 쪽도 의도하지 않았는데 시들어 버린 우정에 대해 이야기한다. <<He>>【은는】 당신에게 무언가를 바로잡아 달라고 하지 않는다. 당신이 고개를 끄덕이며 <<him>>【이가】 계속 말하도록 두면 그저 안도하는 듯하다.
				<<case 2>>
					<<He>>【이가】 일 이야기를, 하루하루가 어떻게 똑같이 느껴지기 시작했는지를 털어놓는다. 처음의 쑥스러운 웃음이 지나가고 나면 말이 술술 나온다.
				<<case 3>>
					<<He>>【이가】 보고 싶은 사람 이야기를 한다. 이야기는 다른 누구에게도 아무 의미 없을 작은 기억들 사이를 헤매지만, 끝에 가서는 <<him>>【이가】 미소 짓게 만든다.
			<</switch>>
			<br><br>
			당신도 답례로 자기 삶을 조금 나눈다. 대화는 뜻밖에 편안하다. 한동안은 둘 다 주위의 마을을 의식하지 못하는 듯하다.
		<<case "Whitney">>
			휘트니는 지나가는 모든 사람에게 몇 분 동안 욕을 퍼붓는다. 거리가 한산해지자 <<his>> 목소리가 낮아진다. <<He>>【은는】 고아원 이야기를, 떠나는 사람들 이야기를, 누가 곁에 남아 주길 바라는 게 얼마나 멍청한 짓인지를 말한다. 당신이 대꾸하려 하자 <<he>>【은는】 감상적이라며 당신을 놀린다. 그래도 <<he>>【은는】 귀를 기울인다.
		<<case "Robin">>
			로빈은 레모네이드 가판대 이야기, 고아원 이야기, 그리고 당신에게 짐이 되지 않으려고 애써 숨겨 온 온갖 작은 걱정들을 이야기한다. 당신도 자신의 걱정을 몇 가지 털어놓는다. 이야기가 끝날 즈음엔 어깨가 맞닿아 있고, 침묵이 허전하기보다 편안하게 느껴진다.
		<<case "Kylar">>
			카일라는 당신의 하루에 대해 물어볼 질문을 몇 가지 미리 연습해 온 게 분명하지만, 계속 그것을 접어 두고 더 사소하고 이상한 질문을 던진다. 어떤 날씨가 제일 행복해? 고아원에서 어느 창문이 네 거야? <<He>>【은는】 대답 하나하나를 소중히 여기고, 서서히 떨기를 멈춘다.
		<<case "Sydney">>
			시드니는 학교와 신전 일을 두고 농담을 하다가 농담이 바닥날 때까지 이어 간다. <<He>>【은는】 착하게 구는 건 누가 진짜 원하는 게 뭐냐고 묻지 않을 때가 더 쉽다고 털어놓는다. 당신은 판단하지 않고 듣는다. 곧 <<hes>> 다시 미소 짓는다. 이번에는 억지로 짓는 웃음이 아니다.
		<<case "Avery">>
			에이버리는 무능한 사업 상대에 대한 불평으로 말을 꺼낸다. 어쩌다 보니 그 불평은 무언가를 바라지 않고 <<him>>에게 말을 거는 사람이 거의 없다는 고백으로 바뀐다. "지금 이 자리에 있는 당신은 일단 예외로 해 두죠." <<he>>【이가】 당신의 반응을 살피며 말한다.
		<<case "Bailey">>
			베일리는 청구서와 수리비, 음식이 마법처럼 생기는 줄 아는 아이들 이야기를 한다. 꾸짖는 말 밑에서 지친 기색이 들린다. <<He>>【은는】 당신이 동정하는 표정으로 보고 있는 걸 알아채고 인상을 찌푸리지만, 한결 낮은 목소리로 계속한다.
	<</switch>>
	<br><br>
	<<link [[대화를 마무리한다 (0:05)|Loiter Conversation End]]>><<pass 5>><</link>>
<</if>>
<br>

:: Loiter Conversation End
<<effects>>
<<if !$loiterChat>>
	대화는 이미 끝났다.
	<br><br>
	<<link [[다음|Danube Street]]>><</link>>
<<elseif $loiterChat.intimate>>
	<<set _return to $loiterChat.return>>
