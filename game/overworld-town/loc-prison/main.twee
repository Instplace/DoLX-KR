						<br>
					<</if>>
					<<lakeicon "meditate">><<link [[명상한다|Prison Yard Meditate]]>><<endevent>><<set $phase to 1>><</link>>
					<br>
				<</if>>
				<<if $prison.schedule is "yard">>
					<<if $worn.face.type.includes("gag")>>
						<span class="blue">재갈 때문에 경비원이나 죄수들에게 말을 걸 수 없습니다.</span>
						<br>
					<<else>>
						<<socialiseicon>><<link [[경비원과 대화한다 (0:30)|Prison Yard Speak]]>><<pass 30>><<prison_rep veteran 1>><<endevent>><</link>><<gperlove "veteran_guard">>
						<br>
