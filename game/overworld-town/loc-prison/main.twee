						<br>
					<<else>>
						<<prisonicon "run">><<link [[달린다 (0:30)|Prison Yard Run]]>><<endevent>><<tiredness 4>><</link>><<gathletics>><<gphysique>>
						<br>
					<</if>>
					<<if pcAreArmsBound("any")>>
