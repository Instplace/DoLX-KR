							<br>
						<</if>>
					<</if>>
					<<if $daily.prison.yardFight>>
						<<distracticon>><<link [[죄수 세 명에게 싸움을 건다|Prison Yard Fight]]>><<set $fightstart to 1>><<set $daily.prison.yardFight to false>><<endevent>><</link>>
						<br>
					<</if>>
				<</if>>
