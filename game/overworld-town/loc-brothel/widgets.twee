:: Widgets Brothel [widget]
<<widget "brothelshowintro">>
	<<set $showExplanations to $showExplanations || []>>
	<<if $passage is "Briar's Office Show Ask">>
		"설명이 다시 필요한가?" 브라이어가 와인잔을 내려놓는다. "선택지는 몇 가지 있어." <<He>>【이가】 손가락 하나를 들어 올린다.
	<<elseif $showExplanations.length lte 0>>
		<<He>>【은는】 자리에서 일어나 책상 뒤로 걸어간다. "선택지는 몇 가지 있어." <<He>>【이가】 손가락을 하나씩 꼽아 보인다.
	<<else>>
		<<He>>【이가】 잔에 담긴 와인을 빙빙 돌린다. "어떻게 돌아가는지는 잘 알겠지. 늘 하던 대로야."
	<</if>>
	<br><br>

	<<if $passage is "Briar's Office Show Ask" or !$showExplanations.includes("Default")>>
		<<set _askShow to 1>> /*so "Ask for more information about each show" doesn't show up immediately after the shows are introduced for the first time*/
		<<if !$showExplanations.includes("Default")>><<run $showExplanations.push("Default")>><</if>>
		"첫 번째는 단순한 공연이야. 관객들에게 가볍게 추파를 던지다가 관객 한 명을 무대로 불러올려 섹스를 하는 거지. 실제로는 배우지만. 보수는 <<printmoney 60000 "green">>를 주겠어."
		<br><br>
		<<print $passage isnot "Briar's Office Show Ask" ? '<<He>>【은는】 자리에 앉는다.' : '<<He>>【은는】 다른 손가락 하나를 더 들어 올리며 선택지를 꼽는다.'>> "치안이 나쁜 구역에서 길을 잃은 얌전한 여학생 <<girl>> 연기를 할 수도 있어. 그다음엔 난교가 이어지는 거지. 그건 <<printmoney 100000 "green">>야. 물론 <span class="blue">여학생 <<girl>> 교복이 필요하겠지만,</span> 이미 한 벌쯤은 갖고 있을 것 같군." <<He>>【이가】 능글맞게 웃는다. "너무 현실 같은 이야기인가?"
		<br><br>
	<<else>>
		<<set _askShow to 0>>
	<</if>>

	<<if animalSexEnabledForType("pig") and !victimsAlwaysMonsterForType("pig") and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Pig"))>>
		<<if !$showExplanations.includes("Pig")>><<run $showExplanations.push("Pig")>><</if>>
		"아니면," <<he>>【이가】 말을 잇는다. "근처 농장에서 돼지 한 마리를 데려올 수도 있지. 관객들의 흥미를 위해 돼지와 지저분한 짓을 하는 거야. 얼마나 많은 사람이 좋아할지는 모르겠지만, 입방아에 오르내리기엔 딱 좋겠지. 우리가 원하는 게 바로 그거고. 그 대가로 <<printmoney 150000 "green">>를 받게 될 거야."
		<br><br>
	<<elseif (victimsAlwaysMonsterForType("pig") or monsterCanAppearForType("pig")) and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Pig"))>>
		<<if !$showExplanations.includes("Pig")>><<run $showExplanations.push("Pig")>><</if>>
		"아니면," <<he>>【이가】 말을 잇는다. "근처 농장에서 돼지 인간을 한 명 데려올 수도 있지. 관객들의 흥미를 위해 녀석과 지저분한 짓을 하는 거야. 얼마나 많은 사람이 좋아할지는 모르겠지만, 입방아에 오르내리기엔 딱 좋겠지. 우리가 원하는 게 바로 그거고. 그 대가로 <<printmoney 150000 "green">>를 받게 될 거야."
		<br><br>
	<</if>>

	<<if $settings.swarmsEnabled and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Swarm"))>>
		<<if !$showExplanations.includes("Swarm")>><<run $showExplanations.push("Swarm")>><</if>>
		<<He>>【이가】 잠시 말을 멈춘다. "그리고 최근에 너 같은 <<aGirl>>【이가】 나오는 영상을 본 적이 있어." <<he>>【이가】 말한다. "작은 벌레들이 가득 찬 사육장에 몸이 잠겨 있더군. 구더기나 지렁이 같았는데 말이지. 직접 두 눈으로 한번 보고 싶어. 그것도 마찬가지로 <<printmoney 150000 "green">>【을를】 주지."
		<br><br>
	<</if>>

	<<if $brothel_machine_repair gte 4 and ($passage is "Briar's Office Show Ask" or !$showExplanations.includes("Machine"))>>
		<<if !$showExplanations.includes("Machine")>><<run $showExplanations.push("Machine")>><</if>>
		<<if ($player.vaginaExist or $settings.analEnabled)>>
			"수리된 섹스 머신도 있어." <<he>>【이가】 별생각 없었다는 듯 덧붙인다. "비공개 쇼로 진행해야 해. 입이 가벼운 녀석들은 절대 사절이니까. 관객들도 그 신선함엔 만족하겠지만, <span class="lewd">진짜 삽입하는 걸 보고 싶어 할 거야.</span> 끝까지 해낸다면 <<printmoney 150000 "green">>다."
			<br><br>
			<<if $settings.tentaclesEnabled>>
				<<He>>【이가】 턱을 톡톡 두드린다. "그게 더 마음에 든다면 촉수 모드도 있을 거다. 보수는 같고, 여전히 삽입은 필수야."
				<br><br>
			<</if>>
		<<elseif $settings.tentaclesEnabled>>
			"수리된 섹스 머신도 있어." <<he>>【이가】 별생각 없었다는 듯 덧붙인다. "촉수 모드가 지원되지. 비공개 쇼로 진행해야 해. 입이 가벼운 녀석들은 절대 사절이니까. 관객들도 그 신선함엔 만족하겠지만, <span class="lewd">진짜 삽입하는 걸 보고 싶어 할 거야.</span> 끝까지 해낸다면 <<printmoney 150000 "green">>다."
			<br><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "brothelshowoptions">>
	<<set _isShowVirgin to ($player.virginity.penile is true and $player.virginity.vaginal is true)>>
	<<if $brothelVirginityIntro is true and $brothelVirginityState isnot "lie" and !unableTakeVirginity() and (_isShowVirgin or $weekly.brothelReVirginityShow isnot 1)>>
		<<if $brothelVirginityState is "refuse">>
			"아직 처녀성을 잃지 않았다면, 그 특별 제안은 여전히 유효해." <<He>>【이가】 당신을 힐끗 쳐다본다. "물론 처녀성 검사부터 통과해야겠지만. 구체적인 금액은 사람들이 얼마나 낼 의향이 있느냐에 달렸지만, 꽤 두둑하게 챙길 수 있을 거야."
			<br><br>
		<<elseif $brothelVirginityState is "virginity">>
			"지난번에 아무에게도 허락하지 않은 걸 보고, 팬들이 네 순결을 가져갈 기회를 또 달라고 아우성이더군." <<he>>【이가】 말한다. "덕분에 관객은 제법 모였지만 말이야. 이번엔 얼마나 벌 수 있을지 장담 못 하겠지만, 어쨌든 누군가에게 네 처녀성을 넘겨줘야 할 거야."
			<br><br>
		<<elseif $brothelVirginityState is "chastity">>
			"지난번 일은 관객들도 불만이 많았고, 나 역시 마음에 들지 않았어." <<he>>【이가】 당신을 힐끗 쳐다보며 말한다. "하지만 여전히 처녀이니, 사람들은 여전히 네 순결을 노리고 있겠지. 그딴 빌어먹을 장치를 차고 나타나는 멍청한 짓만 또 저지르지 않는다면 두둑하게 챙길 수 있을 거다."
			<br><br>
		<<elseif !_isShowVirgin>>
			"포스터에 쓰여 있는 만큼 순결하진 않다는 소문이 돌더군." <<he>>【이가】 <<his>> 와인을 빙빙 돌리며 말한다. "난 상관없어. 검사에서 들키더라도 하퍼가 쇼 하나 할 시간만큼은 상품을 복원해 줄 수 있으니까. 하퍼의 검증을 통과하면 관객들은 두 번째 데뷔에 웃돈을 낼 거야. 통과 못 해도 어느 쪽이든 넌 나한테 쇼를 하나 빚지는 거고."
			<br><br>
		<</if>>
		<<unset $brothelVirginityState>>
		특별 쇼:
		<br>
		<<if hasSexStat("promiscuity", 2)>>
			<<if _isShowVirgin>>
				<<templeicon "virginity">><<link [[처녀성을 판다|Briar's Office Virginity Show]]>><<acceptbrothelshow "virginity">><<set $phase to 0>><</link>><<promiscuous2>>
			<<else>>
				<<templeicon "virginity">><<link [[복원 처녀성 쇼를 시도한다|Briar's Office Virginity Show]]>><<acceptbrothelshow "virginity">><<set $phase to 0>><<set $brothelReVirginityBooked to true>><</link>><<promiscuous2>>
			<</if>>
			<br>
		<<else>>
			<<insufficientStat "promiscuity" "처녀성을 팔기에는">>
			<br>
		<</if>>
		<br>
	<</if>>

	일반 쇼:
	<br>
	<<if !hasSexStat("promiscuity", 4) and !hasSexStat("deviancy", 5)>>
		<<brothelicon>><<insufficientStat "custom" "어떤 제안도 받아들일 수 없습니다" "blue" "음란하거나 이상성욕">>
		<br><br>
	<<else>>
		<<if hasSexStat("promiscuity", 4)>>
			<<brothelicon>><<link [[유혹 연극|Briar's Office Show 2]]>><<acceptbrothelshow "flirt">><</link>> | <span class="green">+</span><<printmoney 60000 "green">><<promiscuous4>> <!-- Appears even with blind stats enabled. All are intentional -->
			<br>
		<<else>>
			<<brothelicon>><<insufficientStat "promiscuity" "유혹 연극에 참여하기에는">>
			<br>
		<</if>>

		<<if hasSexStat("promiscuity", 5)>>
			<<schoolicon>><<link [[윤간 연극|Briar's Office Show 2]]>><<acceptbrothelshow "gangbang">><</link>> | <span class="green">+</span><<printmoney 100000 "green">><<promiscuous5>>
			<br>
		<<else>>
			<<schoolicon>><<insufficientStat "promiscuity" "윤간 연극에 참여하기에는">>
			<br>
		<</if>>

		<<if beastSexEnabledForType("pig", victimsAlwaysMonsterForType("pig") or monsterCanAppearForType("pig"))>>
			<<if hasSexStat("deviancy", 5)>>
				<<animalicon "pig">><<link [[돼지|Briar's Office Show 2]]>><<acceptbrothelshow "pig">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<deviant5>>
				<br>
			<<else>>
				<<animalicon "pig">><<insufficientStat "deviancy" "돼지 쇼에 참여하기에는">>
				<br>
			<</if>>
		<</if>>

		<<if $settings.swarmsEnabled>>
			<<if hasSexStat("deviancy", 5)>>
				<<petshopicon "tanks">><<link [[생물 테라리움|Briar's Office Show 2]]>><<acceptbrothelshow "swarm">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<deviant5>>
				<br>
			<<else>>
				<<petshopicon "tanks">><<insufficientStat "deviancy" "생물 테라리움 쇼에 참여하기에는">>
				<br>
			<</if>>
		<</if>>
		<br>
	<</if>>

	<<if $brothel_machine_repair is 1>>
		섹스 머신이 <span class="red">고장 났습니다.</span>
		<br><br>
	<<elseif $brothel_machine_repair is 2>>
		섹스 머신의 <span class="lewd">연료가 떨어졌습니다.</span>
		<br><br>
	<<elseif $brothel_machine_repair gte 4 and hasSexStat("promiscuity", 5) and ($settings.tentaclesEnabled or ($player.vaginaExist or $settings.analEnabled))>>
		섹스 머신 쇼:
		<br>
		<<if ($player.vaginaExist or $settings.analEnabled)>>
			<<sextoysicon>><<link [[섹스 머신|Briar's Office Show 2]]>><<acceptbrothelshow "machine">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<promiscuous5>>
			<br>
		<</if>>
		<<if $settings.tentaclesEnabled>>
			<<sextoysicon>><<link [[섹스 머신, 촉수 모드|Briar's Office Show 2]]>><<acceptbrothelshow "tentacles">><</link>> | <span class="green">+</span><<printmoney 150000 "green">><<promiscuous5>>
			<br>
		<</if>>
		<br>
	<</if>>

	<<if (effectiveTransformationLevel("demon") gte 6) or (hasSexStat("deviancy", 5) and $farm_stage gte 7 and $farm.steed and beastSexEnabledForType("horse", $per_npc.saddled_steed.monster is "monster"))>>
		쇼 제안하기:
		<br>
		<<if hasSexStat("deviancy", 5) and $farm_stage gte 7 and $farm.steed and beastSexEnabledForType("horse", $per_npc.saddled_steed.monster is "monster")>>
			<<animalicon "horse">><<link [[말|Briar's Office Show 2]]>><<acceptbrothelshow "horse">><</link>> | <span class="green">+</span><<printmoney 200000 "green">><<deviant5>>
			<br>
		<</if>>
		<<if (effectiveTransformationLevel("demon") gte 6)>>
			<<sextoysicon "dildo">><<link [[붓카케 게임|Briar's Office Show 2]]>><<acceptbrothelshow "bukkake">><</link>> | <span class="green">+관객의 절정당 <<printmoney 5000 "green">></span><<demon>>
			<br>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "startbrothelshow">>
	<<set _show to _args[0]>>
	<<if not $brothelshowdata.counts[_show]>>
		<<set $brothelshowdata.counts[_show] to 0>>
	<</if>>
	<<run $brothelshowdata.counts[_show]++>>
	<<run $brothelshowdata.counts.done++>>
	<<set $brothelshowdata.type to "none">>
	<<set $brothelshowdata.done to true>>
<</widget>>

<<widget "acceptbrothelshow">>
	<<set _show to _args[0]>>
	<<set $brothelshowdata.type to _show>>
	<<run $brothelshowdata.counts.agreed++>>
	<<if Time.weekDay is 6>>
		<<set $brothelshowdata.done to true>>
	<</if>>
<</widget>>

<<widget "abortbrothelshow">>
	<<set $brothelshowdata.type to "none">>
	<<run $brothelshowdata.counts.agreed-->>
	<<if Time.weekDay is 6>>
		<<set $brothelshowdata.done to false>>
	<</if>>
<</widget>>

<<widget "brothel_bukkake_init">>
	<<set $brothel_show_bukkake to 0>>
	<<set $brothel_show_security to 0>>
	<<set $brothel_show_flirt to 0>>
	<<set $brothel_show_crazed to 0>>
<</widget>>

<<widget "brothel_bukkake_end">>
	<<unset $brothel_show_bukkake>>
	<<unset $brothel_show_security>>
	<<unset $brothel_show_flirt>>
	<<unset $brothel_show_crazed>>
<</widget>>

<<widget "brothel_bukkake_links">>
	<<if $brothel_show_flirt isnot 1>>
		<<link [[추파를 던진다|Brothel Show Bukkake Flirt]]>><<set $brothel_show_flirt to 1>><</link>>
		<br>
	<</if>>
	<<link [[부드러운 유혹|Brothel Show Bukkake Gentle]]>><</link>>
	<br>
	<<link [[공격적인 유혹|Brothel Show Bukkake Aggressive]]>><</link>>
	<br>
	<<link [[쇼를 끝낸다|Brothel Show Bukkake End]]>><</link>>
	<br>
<</widget>>

<<widget "brothel_show_security">>
	<<switch $brothel_show_security>>
		<<case 0>>
			<span class="green">경비원들이 모든 상황을 통제하고 있다.</span>
		<<case 1>>
			<span class="teal">경비원들이 난동을 부리는 자를 내쫓는다.</span>
		<<case 2>>
			<span class="lblue">경비원들이 누군가를 때려눕힌다.</span>
		<<case 3>>
			<span class="blue">경비원들이 질서를 유지하려 고군분투하고 있다.</span>
		<<case 4>>
			<span class="purple">경비원들이 무대 쪽으로 밀려나며, 관객들을 간신히 저지하고 있다.</span>
		<<case 5>>
			<span class="pink">경비원들이 뚫리기 일보 직전이다.</span>
		<<default>>
			<span class="red">경비원들이 통제력을 잃었다! 관객들이 무대 위로 쇄도한다.</span>
	<</switch>>
<</widget>>

<<widget "brothel_bukkake">>
	<<for _i to 0; _i lt $NPCList.length; _i++>>
		<<switch _i>>
			<<case 0>>
				<<person1>>
			<<case 1>>
				<<person2>>
			<<case 2>>
				<<person3>>
			<<case 3>>
				<<person4>>
			<<case 4>>
				<<person5>>
			<<case 5>>
				<<person6>>
		<</switch>>
		<<if $NPCList[_i].penis isnot "none" and !$NPCList[_i].penisdesc.includes("strap-on")>>
			<<persons>> <<print window.KR.getPenisDescKr($NPCList[_i].penisdesc)>>【이가】 정액을 내뿜는다.
			<<random_semen>>
		<<else>>
			<<persons>> 보지에서 애액이 뿜어져 나온다.
			<<random_goo>>
		<</if>>
		<<set $brothel_show_bukkake += 1>>
	<</for>>
<</widget>>

<<widget "gloryHoleServiceCalc">>
	<<set _enemyarousal to 0>>
	<<set _enemyarousalmax to $enemyarousalmax>>
	<<set _enemyarousal += _skill>>
	<<set _enemyarousal += _submission * 3>>
	<<set _enemyarousalmax -= _sex * 2>>
	<<set _rounds to Math.ceil(_enemyarousalmax / _enemyarousal) >>
	<<set _time to Math.ceil(_rounds / 6)>>
<</widget>>

<<widget "gloryHoleServiceInit">>
	<<maninit>><<npcgloryhole>>
	<<set _arousal1 to 0>>
	<<set _arousal2 to 0>>
	<<set _skill to 0>>
	<<set _submission to 0>>
	<<set _service to {}>>
	<<if _args[0] is "normal">>
		<<set _waitTime to 10>>
	<<else>>
		<<set _waitTime to 0>>
	<</if>>

	/* Hands */
	<<set _skill to (currentSkillValue("handskill") / 100)>>
	<<set _submission to 5>>
	<<set _sex to 0>>
	<<gloryHoleServiceCalc>>
	<<set _service.hands to {}>>
	<<set _service.hands.submission to _submission>>
	<<set _service.hands.sex to _sex>>
	<<set _service.hands.rounds to _rounds>>
	<<set _testTime1 to _time>>
	<<set _service.hands.time to _time + _waitTime>>

	/* Mouth */
	<<set _skill to (currentSkillValue("oralskill") / 100)>>
	<<if $player.virginity.oral isnot true>>
		<<set _submission to 10>>
	<<elseif $player.virginity.oral is true>>
		<<set _submission to 30>>
	<</if>>
	<<set _sex to 0>>
	<<gloryHoleServiceCalc>>
	<<set _service.mouth to {}>>
	<<set _service.mouth.submission to _submission>>
	<<set _service.mouth.sex to _sex>>
	<<set _service.mouth.rounds to _rounds>>
	<<set _service.mouth.time to _time + _waitTime>>

	/* Chest */
	<<set _skill to (currentSkillValue("chestskill") / 100)>>
	<<set _submission to 3>>
	<<set _sex to 0>>
	<<gloryHoleServiceCalc>>
	<<set _service.chest to {}>>
	<<set _service.chest.submission to _submission>>
	<<set _service.chest.sex to _sex>>
	<<set _service.chest.rounds to _rounds>>
	<<set _service.chest.time to _time + _waitTime>>

	/* Feet */
	<<set _skill to (currentSkillValue("feetskill") / 100)>>
	<<set _submission to 2>>
	<<set _sex to 0>>
	<<gloryHoleServiceCalc>>
	<<set _service.feet to {}>>
	<<set _service.feet.submission to _submission>>
	<<set _service.feet.sex to _sex>>
	<<set _service.feet.rounds to _rounds>>
	<<set _service.feet.time to _time + _waitTime>>

	/* Thigh */
	<<set _skill to (currentSkillValue("thighskill") / 100)>>
	<<set _submission to 5>>
	<<set _sex to 5>>
	<<gloryHoleServiceCalc>>
	<<set _service.thigh to {}>>
	<<set _service.thigh.submission to _submission>>
	<<set _service.thigh.sex to _sex>>
	<<set _service.thigh.rounds to _rounds>>
	<<set _service.thigh.time to _time + _waitTime>>

	/* Butt */
	<<set _skill to (currentSkillValue("bottomskill") / 100)>>
	<<set _submission to 3>>
	<<set _sex to 2>>
	<<gloryHoleServiceCalc>>
	<<set _service.bottom to {}>>
	<<set _service.bottom.submission to _submission>>
	<<set _service.bottom.sex to _sex>>
	<<set _service.bottom.rounds to _rounds>>
	<<set _service.bottom.time to _time + _waitTime>>

	/* Penis */
	<<set _skill to (currentSkillValue("penileskill") / 100)>>
	<<set _submission to 20>>
	<<set _sex to 0>>
	<<if $player.virginity.penile isnot true>>
		<<set _sex to 30>>
	<<elseif $player.virginity.penile is true>>
		<<set _sex to 100>>
	<</if>>
	<<gloryHoleServiceCalc>>
	<<set _service.penis to {}>>
	<<set _service.penis.submission to _submission>>
	<<set _service.penis.sex to _sex>>
	<<set _service.penis.rounds to _rounds>>
	<<set _service.penis.time to _time + _waitTime>>

	/* Vagina */
	<<set _skill to (currentSkillValue("vaginalskill") / 100)>>
	<<set _submission to 20>>
	<<set _sex to 0>>
	<<if $player.virginity.vaginal isnot true and $NPCList[0].penis isnot "none">>
		<<set _sex to 30>>
	<<elseif $player.virginity.vaginal is true and $NPCList[0].penis isnot "none">>
		<<set _sex to 100>>
	<</if>>
	<<gloryHoleServiceCalc>>
	<<set _service.vagina to {}>>
	<<set _service.vagina.submission to _submission>>
	<<set _service.vagina.sex to _sex>>
	<<set _service.vagina.rounds to _rounds>>
	<<set _service.vagina.time to _time + _waitTime>>

	/* Anus */
	<<set _skill to (currentSkillValue("analskill") / 100)>>
	<<set _submission to 15>>
	<<set _sex to 0>>
	<<if $player.virginity.anal isnot true>>
		<<set _sex to 30>>
	<<elseif $player.virginity.anal is true>>
		<<set _sex to 100>>
	<</if>>
	<<gloryHoleServiceCalc>>
	<<set _service.anus to {}>>
	<<set _service.anus.submission to _submission>>
	<<set _service.anus.sex to _sex>>
	<<set _service.anus.rounds to _rounds>>
	<<set _service.anus.time to _time + _waitTime>>
<</widget>>

<<widget "gloryHoleServiceEffects">>
	<<set $gloryhole to 1>>
	<<if _args[1] is "normal">>
		<<set $sexavoid to 1>><<set $rapeavoid to 1>>
	<<else>>
		<<set $sexavoid to 0>><<set $rapeavoid to 0>>
	<</if>>
	<<set $consensual to 1>>
	<<consensual>>
	<<penetrationPainCalculate>>
	<<switch _args[0]>>
		<<case "hand">>
			<<set _submission to _service.hands.submission>>
			<<set _sex to _service.hands.sex>>
			<<set _rounds to _service.hands.rounds>>
			<<set _time to _service.hands.time>>
			<<handskill _rounds>><<handstat>>
			<<switch $gloryHoleEvent.target>>
				<<case "anal">>
					<<set $NPCList[0].penis to "otheranus">>
					<<set $NPCList[0].vagina to "otheranus">>
				<<case "oral">>
					<<set $NPCList[0].mouth to "rightarm">>
				<<case "penile">>
					<<set $NPCList[0].penis to "leftarm">>
				<<case "vaginal">>
					<<set $NPCList[0].vagina to "rightarm">>
			<</switch>>
			<<set $gloryHoleEvent.tool to "hand">>
		<<case "mouth">>
			<<set _submission to _service.mouth.submission>>
			<<set _sex to _service.mouth.sex>>
			<<set _rounds to _service.mouth.rounds>>
			<<set _time to _service.mouth.time>>
			<<oralskill _rounds>><<oralstat>><<raped>>
			<<switch $gloryHoleEvent.target>>
				<<case "anal">>
					<<set $NPCList[0].vagina to "facesitanal">>
					<<set $NPCList[0].penis to "facesitanal">>
				<<case "oral">>
					<<set $NPCList[0].mouth to "kiss">>
				<<case "penile">>
					<<set $NPCList[0].penis to "mouth">>
				<<case "vaginal">>
					<<set $NPCList[0].vagina to "mouth">>
			<</switch>>
			<<set $gloryHoleEvent.tool to "oral">>
		<<case "chest">>
			<<set _submission to _service.chest.submission>>
			<<set _sex to _service.chest.sex>>
			<<set _rounds to _service.chest.rounds>>
			<<set _time to _service.chest.time>>
			<<chestskill _rounds>><<cheststat>>
			<<if $NPCList[0].penis isnot "none">>
				<<set $NPCList[0].penis to "chest">>
			<</if>>
		<<case "feet">>
			<<set _submission to _service.feet.submission>>
			<<set _sex to _service.feet.sex>>
			<<set _rounds to _service.feet.rounds>>
			<<set _time to _service.feet.time>>
			<<feetskill _rounds>><<feetstat>>
			<<if $NPCList[0].penis isnot "none">>
				<<set $NPCList[0].penis to "feet">>
			<<elseif $NPCList[0].vagina isnot "none">>
				<<set $NPCList[0].vagina to "feet">>
			<</if>>
		<<case "thigh">>
			<<set _submission to _service.thigh.submission>>
			<<set _sex to _service.thigh.sex>>
			<<set _rounds to _service.thigh.rounds>>
			<<set _time to _service.thigh.time>>
			<<thighskill _rounds>><<thighstat>>
			<<set $NPCList[0].penis to "thighs">>
		<<case "butt">>
			<<set _submission to _service.bottom.submission>>
			<<set _sex to _service.bottom.sex>>
			<<set _rounds to _service.bottom.rounds>>
			<<set _time to _service.bottom.time>>
			<<bottomskill _rounds>><<bottomstat>>
			<<set $NPCList[0].penis to "cheeks">>
		<<case "penis" "strap">>
			<<set _submission to _service.penis.submission>>
			<<set _sex to _service.penis.sex>>
			<<set _rounds to _service.penis.rounds>>
			<<set _time to _service.penis.time>>
			<<set $gloryHoleEvent.virginity to true>>
			<<switch $gloryHoleEvent.target>>
				<<case "anal">>
					<<if $player.virginity.penile is true and _args[0] isnot "strap">>
						<<set $gloryHoleEvent.fallen to true>>
					<</if>>
					<<set $NPCList[0].vagina to "otheranus">>
					<<set $NPCList[0].penis to "otheranus">>
				<<case "oral">>
					<<set $NPCList[0].mouth to "penis">>
				<<case "penile">>
					<<set $gloryHoleEvent.virginity to false>>
					<<set $NPCList[0].penis to "penis">>
				<<case "vaginal">>
					<<if $player.virginity.penile is true and _args[0] isnot "strap">>
						<<set $gloryHoleEvent.fallen to true>>
					<</if>>
					<<set $NPCList[0].vagina to "penis">>
			<</switch>>
			<<if _args[0] isnot "strap">>
				<<penisraped>><<bruise penis>><<set _pain to $penisPain>>
			<</if>>
			<<penileskill _rounds>><<raped>><<penilestat>>
			<<set $gloryHoleEvent.tool to "penile">>
		<<case "vagina">>
			<<set _submission to _service.vagina.submission>>
			<<set _sex to _service.vagina.sex>>
			<<set _rounds to _service.vagina.rounds>>
			<<set _time to _service.vagina.time>>
			<<vaginalskill _rounds>><<raped>>
			<<if $NPCList[0].penis isnot "none">>
				<<set $NPCList[0].penis to "vagina">>
				<<set $gloryHoleEvent.virginity to true>>
				<<if $player.virginity.vaginal is true>>
					<<set $gloryHoleEvent.fallen to true>>
				<</if>>
			<<elseif $NPCList[0].vagina isnot "none">>
				<<set $NPCList[0].vagina to "vagina">>
			<</if>>
			<<vaginalstat>><<vaginaraped>>
			<<set _pain to Math.floor($vaginalPain * (1.5 / (5 - ($NPCList[0].penissize or 1))))>>
			<<bruise vagina>>
			<<set $gloryHoleEvent.tool to "vaginal">>
		<<case "anus">>
			<<set _submission to _service.anus.submission>>
			<<set _sex to _service.anus.sex>>
			<<set _rounds to _service.anus.rounds>>
			<<set _time to _service.anus.time>>
			<<analskill _rounds>><<analstat>><<raped>><<anusraped>>
			<<set _pain to Math.floor($analPain * (1.5 / (6 - ($NPCList[0].penissize+1 or 1))))>>
			<<bruise anus>>
			<<set $NPCList[0].penis to "anus">>
			<<set $gloryHoleEvent.virginity to true>>
			<<set $gloryHoleEvent.tool to "anal">>
	<</switch>>

	<<set $gloryholeSampleResult to 0>>
	<<if canCollectSamples() is true and canCollectSampleSingle($NPCList[0]?.type)>>
		<<set $gloryholeSampleResult to collectSample($NPCList[0].type, 1) || 0>>
	<</if>>

	<<set $phase to 2>>
	<<set $gloryholestat += 1>><<set $prostitutionstat += 1>>
	<<if _args[1] isnot "normal">>
		<<fameprostitution 1 "none" true>>
	<</if>>
	<<pass _time>>
	<<set _arousal1 += (_submission * 20) * _rounds>>
	<<arousal _arousal1>>
	<<set _arousal2 += _sex * 20>>
	<<arousal _arousal2>>
	<<tiredness 3>>
	<<if _pain>>
		<<pain _pain>>
	<</if>>
	<<violence 1>>
	<<set $gloryhole to 0>>
<</widget>>

<<widget "timeTrackingEndBrothel">>
	<<timeTrackingEnd "brothel">><<timeTrackingEnd "brothelDanceTips">><<timeTrackingEnd "brothelShow">>
<</widget>>

<<widget "brothelClientSexStart">>
	<!-- Most appointments begin normally. A small minority lock the door and refuse the agreement,
	     with some of those bringing in more patrons. Existing combat state carries the outcome. -->
	<<set $enemyno to 1>>
	<<if random(1, 100) lte 8>>
		<<set $molestationstart to 1>>
		<<set $consensual to 0>>
		<<if random(1, 100) lte 35>>
			<<set $enemyno to random(2, 4)>>
		<</if>>
	<<else>>
		<<set $consensual to 1>>
		<<set $sexstart to 1>>
	<</if>>
<</widget>>

<<widget "brothelvirginitybidders">>
	<<if $numberBidder isnot undefined and $virginitytip gt $tip_add>>
		<<set $tip_add += ($virginitytip - $tip) * 0.5>><<tipset>>
	<</if>>

	<<if $numberBidder is undefined>>
		<<set $numberBidder to 1>>
	<</if>>

	<<if $numberBidder lte 6 and ($numberBidder lte 2 or _args[0] is undefined)>>
		<<generatetakevirginity $numberBidder>><<personselect $numberBidder-1>><<set $lastBidder to $numberBidder-1>><<set $numberBidder += 1>>
	<<else>>
		<<set _bidder to $numberBidder-2>> /* $numberBidder is 2~7, $lastBidder requires 0~5, so -2 */
		<<set _r to random(0, _bidder)>>

		<<if _r is $lastBidder>>
			<<set _r to _r % _bidder + 1>>
		<</if>>

		<<if _r is _highestBidder>>
			<<set _r to _r % _bidder + 1>>
		<</if>>

		<<set $lastBidder to _r>>
		<<personselect $lastBidder>>
	<</if>>
<</widget>>
