:: Underground Brothel Contract Widgets [widget]

<<widget "undergroundBrothelContractOffer">>
	<<endevent>>
	<<set _broker to _args[0]>>
	<<if _broker is "Bailey">>
		<<npc Bailey>><<person1>>
		베일리가 <<his>> 팔꿈치를 책상에 올린다. "돈이 필요하다고 했지. 확실한 일꾼이라면 돈을 잘 쳐주는 곳을 알아."
		<br><br>
		"네가 기어 나온 그 지하 창관이야." <<he>>【이가】 말한다. "이번엔 거래에 날짜가 붙어. 그때까지 널 붙잡아 두고, 놓아줄 때 돈을 줘. 중간에 나가면 한 푼도 없어."
	<<else>>
		<<npc Briar>><<person1>>
		브라이어가 펜으로 <<his>> 책상을 톡톡 두드린다. "시내 아래에 더 긴 예약에 돈을 쳐주는 곳이 있어. 쇼가 아니야. 계약이 끝날 때까지 네 시간을 통째로 가져가지."
		<br><br>
		"어떤 곳인지는 이미 알잖아." <<he>>【이가】 말한다. "네가 자원했다고 해서 순해지진 않아. 약속한 날짜까지 버티면 돈을 줄 거고, 일찍 탈출하면 합의는 무효야."
	<</if>>
	<br><br>
	/* Fee quoted at current prices then fixed, so a long booking keeps the value it had when signed. */
	<<brothelicon>><<link [[일주일을 논의한다|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 7, pay: setup.inflation.price(250000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 250000>></span>
	<br>
	<<brothelicon>><<link [[두 주를 논의한다|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 14, pay: setup.inflation.price(600000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 600000>></span>
	<br>
	<<brothelicon>><<link [[한 달을 논의한다|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 30, pay: setup.inflation.price(1500000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 1500000>></span>
	<br><br>
	<<if _broker is "Bailey">>
		<<link [[거부한다|Bailey's Office]]>><<endevent>><</link>>
	<<else>>
		<<link [[거부한다|Briar's Office]]>><<endevent>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "undergroundBrothelContractPenalty">>
	<<if $undergroundbrothelcontract>>
		<<set $undergroundbrothelcontract.end += 1>>
		<<set $undergroundbrothelcontract.penalty += 1>>
		<<set $undergroundbrothelcontract.obedience to Math.max(-3, $undergroundbrothelcontract.obedience - 1)>>
	<</if>>
<</widget>>

/* The brothel's collar is equipped cursed, so it has to be marked broken before it can be taken off the same two-step <<remove_shackle>> and <<leash>> use.
   A cursed "familiar collar" is left alone, because "Underground Brothel Contract Arrival" never replaces one. */
<<widget "undergroundBrothelContractUncollar">>
	<<if $worn.neck.name is "collar with leash">>
		<<set $worn.neck.type.push("broken")>>
		<<neckruined>>
	<</if>>
<</widget>>

/* Frees the arms and nothing else. <<unbind>> and <<unbindtemp>> both call <<remove_shackle>>, which
   would take the brothel's ankle cuffs off with the rope. The carry flags have to be cleared too, or
   <<bindings>> ties the arms straight back on the next <<effects>>. */
<<widget "undergroundBrothelContractUntie">>
	<<set $leftboundcarry to 0>>
	<<set $rightboundcarry to 0>>
	<<set $leftarm to 0>>
	<<set $rightarm to 0>>
	<<if $head is "bound">>
		<<set $head to 0>>
	<</if>>
<</widget>>

<<widget "undergroundBrothelContractWakeRoll">>
	<<if $undergroundbrothelcontract and !$contractWake>>
		<<set _contractObedience to $undergroundbrothelcontract.obedience>>
		/* ~3% an hour at the top of the scale, ~11% at the bottom. */
		<<if random(1, 100) lte 8 - _contractObedience>>
			<<set _contractWakePool to []>>
			<<set _contractStaffBed to $passage is "Underground Brothel Contract Master Bed Sleep">>
			<<set _contractWakeTrait to $undergroundbrothelcontract.masterTrait>>
			<<if _contractObedience lte -2>>
				<<run _contractWakePool.push("punish", "punish", "punish", "punish")>>
			<<elseif _contractObedience lte 0>>
				<<run _contractWakePool.push("punish")>>
			<</if>>
			<<if _contractStaffBed>>
				/* Chained beside your handler, so nothing reaches you but the handler. */
				<<run _contractWakePool.push("master", "master", "master")>>
				<<if _contractWakeTrait is "sociable">><<run _contractWakePool.push("group", "group")>><</if>>
			<<else>>
				/* The worse your standing, the more of your nights get sold to patrons. */
				<<for _contractSold to 0; _contractSold lt Math.clamp(3 - _contractObedience, 1, 6); _contractSold++>>
					<<run _contractWakePool.push("patron")>>
				<</for>>
				<<switch _contractWakeTrait>>
					<<case "lecher">><<run _contractWakePool.push("master", "master", "master", "master")>>
					<<case "sociable">><<run _contractWakePool.push("group", "group", "group")>>
					<<default>><<run _contractWakePool.push("trait", "trait", "trait")>>
				<</switch>>
			<</if>>
			<<if _contractWakePool.length>>
				<<set $contractWake to _contractWakePool.random()>>
				<<set _sleepinterrupt to 1>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "undergroundBrothelContractStatus">>
	<<set _contractDaysLeft to Math.max(0, $undergroundbrothelcontract.end - Time.days)>>
	<span class="gold">계약 기간이 <<= _contractDaysLeft is 1 ? "하루" : _contractDaysLeft + "일">> 남았다.</span>
	<<if $undergroundbrothelcontract.penalty gte 1>>
		<span class="red"> 무급 <<= $undergroundbrothelcontract.penalty>>일이 추가되었다.</span>
	<</if>>
	<<if ["favour", "hunt"].includes($undergroundbrothelcontract.broker)>>
		<span class="red"> 어느 것도 보수가 없다.</span>
	<</if>>
<</widget>>

<<widget "undergroundBrothelContractMaster">>
	<<if $NPCList[0] and $NPCList[0].per is "contract_master" and $NPCList[0].gender and $NPCList[0].description>>
		/* Already in slot 0 for this passage. Loading again would inflate $enemyno. */
	<<else>>
		<!-- Clear anything a scene left behind, the same way npc handles a cold entry. -->
		<<if $enemyno gte 1 or ($NPCList[0] and $NPCList[0].gender and $NPCList[0].description)>>
			<<endevent phaseless>>
		<</if>>
		<<if $per_npc.contract_master is undefined>>
			<<generate1>>
			<<set _contractMasterTraits to ["relaxed", "sociable", "brooding", "lecher"]>>
			<<set $undergroundbrothelcontract.masterTrait to
				_contractMasterTraits.find(trait => $NPCList[0].traits.includes(trait)) ?? _contractMasterTraits.random()>>
			<<saveNPC 0 "contract_master">>
			<<set $NPCList[0].per to "contract_master">>
		<<else>>
			<<loadNPC 0 "contract_master">>
		<</if>>
	<</if>>
	<<person1>>
	<<set _contractMasterTrait to $undergroundbrothelcontract.masterTrait>>
	<<set _contractMasterTitle to $NPCList[0].pronoun is "f" ? "mistress" : "master">>
	<<set _contractMasterTitleCap to $NPCList[0].pronoun is "f" ? "Mistress" : "Master">>
<</widget>>

<<widget "undergroundBrothelContractMasterOpinion">>
	<<if $undergroundbrothelcontract.obedience gte 4>>
		<span class="teal">당신의 <<= _contractMasterTitle>>【은는】 당신을 믿을 만한 노동자로 여긴다.</span>
	<<elseif $undergroundbrothelcontract.obedience gte 2>>
		<span class="lblue">당신의 <<= _contractMasterTitle>>【은는】 당신의 행실에 만족한다.</span>
	<<elseif $undergroundbrothelcontract.obedience gte 0>>
		<span class="blue">당신의 <<= _contractMasterTitle>>【은는】 당신이 얼마나 다루기 쉬운지 아직 가늠하는 중이다.</span>
	<<elseif $undergroundbrothelcontract.obedience gte -2>>
		<span class="purple">당신의 <<= _contractMasterTitle>>【은는】 당신을 골칫거리로 여긴다.</span>
	<<else>>
		<span class="red">당신의 <<= _contractMasterTitle>>【은는】 당신이 말썽을 일으키리라 예상한다.</span>
	<</if>>
<</widget>>