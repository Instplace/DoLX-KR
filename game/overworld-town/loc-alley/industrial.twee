:: Industrial Alleyways

<<set $outside to 1>><<set $location to "alley">><<effects>><<set $bus to "industrial">><<getTarget true>>
당신은 공업 구역의 골목길에 있다.
<<if Time.dayState is "day">>
	주변 건물에서 기계가 돌아가는 소리가 들린다.
<<elseif Time.dayState is "night">>
<<else>>
	대형 차량의 엔진 소리가 들린다.
<</if>>
오른쪽에 사다리가 있다. 지붕으로 올라갈 수 있을 것 같다. 가시 돋친 울타리로 분리된 학교의 뒷부분이 이곳까지 튀어나와 있다.
<<streeteffects>>
<br><br>
<<if $brothelintro is 1 and isPubfameTaskAccepted("briar") and !$pubfame.briar.escape and effectiveTransformationLevel("cat") lte 5>>
	<<set $pubfame.briar.escape to 1>>
	근처 하베스트 가에 있는 창관이 눈에 띈다. 브라이어의 사무실로 통하는 창문이 있다.
	<br><br>

	<span class="blue">좋은 생각이 떠오른다.</span> 사다리를 브라이어의 사무실 쪽에 놓을 수만 있다면, 그 길로 빠져나갈 수 있을 것이다.
	<br><br>
<</if>>
<<if $exposed gte 1>>
	<<exhibitionism "alley">>
<</if>>
<<if $pleasure gte $pleasuremax>>
	<<if playerVibratorOn() and playerHasBulletVibe() and random(1, 100) lte 35>>
		<<set $vibeWalkReturnPassage to State.passage>>
		<<set $eventskip to 3>>
		<<include "VibeWalkSpasm">>
	<<else>>
		<<orgasmstreet>>
	<</if>>
<</if>>
<<if $stress gte $stressmax and !$possessed>>
	<<passoutalley>>
<<else>>
	<<if $mmagymintro is 1 and $eventskip is 0 and !$eventforced and $daily.rileyRescue isnot 1 and $xchange_fame gte 500 and random(1, 100) lte 25>>
		<<set $daily.rileyRescue to 1>><<set $rileyRescueReturnPassage to State.passage>>
		<<include "Riley Rescue Intro">>
	<<elseif $weekly.schoolNightPoolParty is "intro" and Time.hour gte 21>>
	<<set $weekly.schoolNightPoolParty to "discover">>

	골목에 들어서자, 학교 뒷울타리 근처에서 움직임이 포착된다.
	<br><br>
	어둠을 틈타 가까이 다가간다. 같은 반 불량배 몇 명이 보인다. 그들은 울타리를 넘어 학교 운동장으로 들어가고 있다.
	<br><br>
	모두 꽤 무거워 보이는 가방을 메고 있으며, 순식간에 학교 건물 안으로 사라진다.
	<br><br>

	<<link [[쫓아간다|School Night Pool Party Follow]]>><</link>>
	<br>
	<<link [[무시한다|Industrial Alleyways]]>><<endevent>><<set $eventskip to 1>><</link>>
	<br>
<<elseif $xchange.colosseum.heard is 0 and $eventskip is 0 and !$daily.colosseumRumourFail and Time.hour gte 21>>
	<<include "Industrial Colosseum Rumour">>
<<elseif $xchange.colosseum.joined and $eventskip is 0 and !$daily.colosseumIndustrialRecognition and ($xchange.colosseum.debt gte 15000 or $xchange.colosseum.rank gte 2) and (($xchange.colosseum.callbacks.fix and Time.days gte $xchange.colosseum.callbacks.fix) or $xchange.colosseum.debt gte 15000 or random(1, 100) lte (8 + $xchange.colosseum.rank * 3))>>
	<<include "Industrial Colosseum Recognition">>
<<else>>
	<<location-danger>>

	<<set _crime to Math.clamp(crimeSumCurrent() / 10, 0, 12000)>>
	<<if (dangerEvent(_locationDanger) or $eventforced) and $eventskip is 0>>
		<<eventsstreet>>
	<<elseif ($danger gte (12000 - _crime)) and !$daily.streetPolice and $eventskip is 0>>
		<<streetpolice>>
	<<elseif $eventskip is 0 or $eventskip is 1>>
		<<if isPubfameTaskAccepted("briar") and $pubfame.briar.escape is 1>>
			<<investigateicon>><<link [[타고 올라갈 만한 것을 찾는다|Industrial Ladder]]>><</link>>
			<br><br>
		<</if>>
		<<if $options.mapTop is true>>
			<<map "industrial">>
			<br>
		<</if>>

		/* --- Weekly Shady Dealer init (must always run) --- */
		<<set _weekIndex to Math.floor(Time.days / 7)>>
		<<if $xchange.weeklyShadyDealerLastWeek is undefined or $xchange.weeklyShadyDealerLastWeek is null>>
			<<set $xchange.weeklyShadyDealerLastWeek = _weekIndex>>
		<</if>>
		<<if $xchange.weeklyShadyDealer is undefined or $xchange.weeklyShadyDealer is null>>
			<<set $xchange.weeklyShadyDealer = 0>>
		<</if>>
		/* New week → reroll flags */
		<<if _weekIndex neq $xchange.weeklyShadyDealerLastWeek>>
			<<set $xchange.weeklyShadyDealer = 0>>
			/* 50% chance to enable alley dealer this week */
			<<if random(1,100) lte 50>>
				<<set $xchange.weeklyShadyDealer |= 2>>
			<</if>>
			<<set $xchange.weeklyShadyDealerLastWeek = _weekIndex>>
		<</if>>
		/* --- End weekly init --- */
		<<if ($portalPantiesEnabled and !$xchange.pill.portalEffect and ($xchange.weeklyShadyDealer & 2)) and !xchangePillProtectionActive() and $exposed lte 0 and (Time.hour gte 19 or Time.hour lt 6)>>
			You notice a shady looking person hanging around by an alley wall.
			<br>
			<<icon "mark.gif">><<link [[Approach the shady person (0:05)|Industrial Shady Person]]>><<pass 5>><</link>>
			<br><br>
		<</if>>

		주요 장소
		<br>
		<<if $xchange.colosseum.keyKnown gte 1>>
			<<if $xchange.colosseum.joined gte 1>>
				<<getinicon>><<link [[Enter the Underground Colosseum (0:02)|Underground Colosseum Entrance]]>><<pass 2>><</link>>
			<<else>>
				<<investigateicon>><<link [[Find the unmarked steel door (0:02)|Underground Colosseum Entrance]]>><<pass 2>><</link>>
			<</if>>
			<br>
		<</if>>
		<<laddericon>><<link [[사다리를 오른다 (0:02)|Industrial rooftops]]>><<pass 2>><</link>>
		<br>
		<<busstationicon>><<link [[버스 정류장 뒷문 (0:02)|Bus Station Back Entrance]]>><<pass 2>><</link>>
		<br>
		<<if $schoolBlocked>>
			<span class="blue">학교 경비원이 삼엄하게 경계하고 있다. 오늘 밤은 몰래 들어갈 수 없을 것이다.</span>
			<br>
		<<else>>
			<<fenceicon>><<link [[울타리를 넘어 학교 안으로 들어간다 (0:05)|School Rear Fence]]>><<pass 5>><</link>>
			<br>
		<</if>>
		<<if $drains_rescue_location is "industrial">>
			<<link [[빗물 배수구에서 들렸던 비명을 지르던 사람을 구출한다 (0:05)|Alleyways Rescue]]>><<pass 5>><</link>>
			<br>
		<</if>>
		<br>
		<<if (($exposed is 1 and $uncomfortable.underwearPublic) or ($exposed is 2 and $uncomfortable.nudePublic)) and Time.dayState isnot "night">>
			<<if $exposed gte 2 and hasSexStat("exhibitionism", 5)>>
				<<roadicon>><<link [[길을 건너 마을 외곽으로 간다 (0:05)|Lorries Ex Naked]]>><</link>><<if $daily.ex.lorries is undefined>><<exhibitionist5>><</if>>
				<br>
			<<elseif $exposed is 1 and hasSexStat("exhibitionism", 3)>>
				<<roadicon>><<link [[길을 건너 마을 외곽으로 간다 (0:05)|Lorries Ex Undies]]>><</link>><<if $daily.ex.lorries is undefined>><<exhibitionist3>><</if>>
				<br>
			<</if>>
		<<else>>
			<<add_link "이동<br>">><<hideDisplay>>
			<<oxford>>
			<<mer>>
			<<elk>>
			<<harvest>>
			<<loiter>>
		<</if>>
		<<add_link "<br>우회로<br>">><<hideDisplay>>
		<<if (($exposed is 1 and $uncomfortable.underwearPublic) or ($exposed is 2 and $uncomfortable.nudePublic)) and Time.dayState isnot "night">>
		<<else>>
			<<park>>
		<</if>>
		<<stormdrain>>
		<<displayLinks>>
		<<if $options.mapTop isnot true>>
			<br>
			<<map "industrial">>
		<</if>>
	<</if>>
<</if>>
<</if>>
<<set $eventskip to 0>>
