<<if !$hcChallengesCompleted>>
	<<set $hcChallengesCompleted to {
		handLongPatrol: "", handStrict: "", handCruel: "",
		torchFaster: "", torchSnuffer: "", torchDarker: "",
		faithBanish: "", faithBurden: "", faithBlooms: "",
		forestFurther: "", forestNoShortcut: "", forestItem: "",
		waterLeaky: "", waterDirty: "", waterEarly: "",
		itemDirty: "", itemFind: "", itemNoHide: "",
		prisonerFood: "", prisonerHealth: "", prisonerClean: "",
		suspicionIncrease: "", suspicionDecrease: "", suspicionSermon: "",
		dogsTwice: "", dogsEarly: "", dogsDouble: "",
		timeSleep: "", timeLonger: "", timePrayer: ""
	}>>
	<<set $hcChallengesRun to []>>
<</if>>

<<speechresolve>>
<<if _speechAttitudeResolved is "docile">>
	"저, 윈터 선생님?" 당신은 손을 들고 묻는다. "시작하시기 전에, 이 이야기에 다른 버전이나 세부 사항 같은 게 있나요?"
	<br><br>
	Your hand falls back to your lap the moment <<he>> looks your way.
<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
	"저, 윈터 선생님?" 당신은 손을 들고 묻는다. "시작하시기 전에, 이 이야기에 다른 버전이나 세부 사항 같은 게 있나요?"
<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
	"Winter," you say, careful not to interrupt too sharply. "Before you begin, are there any less common details or variations worth mentioning?"
	<br><br>
	You give the painting another glance, trying to sound curious rather than impatient.
<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
	"이 이야기는 정말 여러 번 들었어요." 당신은 한숨을 쉰다. "처음 이야기해 주셨을 땐 세부 사항을 빼놓으셨잖아요. 그런 거라도 추가해 주실 수 있나요?"
	<br><br>
	Winter gives you a long look. You shrug, refusing to soften the question.
<<else>>
	"아직 다루지 않은 다른 버전의 이야기가 있나요?" 당신이 묻는다. "널리 알려지지 않은 세부 사항이나, 뭐 그런 것들이요."
	<br><br>
	You sit back after asking, listening for anything Winter skipped.
<</if>>
<br><br>

윈터는 잠시 생각에 잠긴다. "음, 몇몇 부분은 전승에 따라 의견이 갈리긴 하지. 대부분은 가장 널리 받아들여지는 버전을 따르려고 했지만..."
<<He>>【은는】 미소 짓는다. "좋아. 좀 더 소수 의견인 부분도 포함해 보도록 하지. 혹시 염두에 둔 거라도 있나? 시작점으로 삼을 만한 거 말이야."
<br><br>

		<i>모든 챌린지를 켠 채로 플레이하는 것은 권장되지 않으며, 매우 어렵습니다.<!-- all challenges run was completed --> 챌린지를 켠 채로 플레이하더라도 위업 등 그 어떠한 보상도 제공되지 않습니다.
<br>
원하는 대로 도전 과제를 조합하여 선택하거나, 게임이 무작위로 도전 과제를 선택하도록 할 수 있습니다.</i>
<br><br>

<<if $hcChallengesRun.length gt 0>>
	<span class="green" tooltip='<<hcDetailsTotal>>'>총 완료: <<print Object.values($hcChallengesCompleted).count("S")>>/<<print Object.keys($hcChallenge).length>></span>
	|
	<span class="blue" tooltip='<<hcDetailsBestRun>>'>최고 기록: <<print $hcChallengesRun.length>>/<<print Object.keys($hcChallenge).length>></span>
	<br><br>
<</if>>

<div class="no-numberify">
	<<link "모두 활성화">><<run Object.keys($hcChallenge).forEach(c => $hcChallenge[c] = true)>><<replace #challenges>><<hcChallengeMenu>><</replace>><</link>> |
	<<link "모두 비활성화">><<run Object.keys($hcChallenge).forEach(c => $hcChallenge[c] = false)>><<replace #challenges>><<hcChallengeMenu>><</replace>><</link>>
</div>
<br>

<div id="challenges"><<hcChallengeMenu>></div>

<<set $hcChallengeRandom to {
	min: 0,
	max: 30,
	blind: false
}>>
<label>
<<checkbox "$hcChallengeRandom.blind" false true autocheck>>
<span class="gold">무작위 도전 과제 숨기기</span>
</label>
<span class="tooltip-anchor linkBlue" tooltip='활성화하면, "무작위 도전 과제로 진행"을 선택했을 때 어떤 도전 과제가 활성화되었는지 알려주지 않습니다.<br><span class="red">모든 도전 과제에 익숙하지 않다면 권장하지 않습니다.</span>'>(?)</span>
<br>
<<hcChallengeRandomSliders>>
<br><br>

<<link [[선택한 도전 과제로 진행|Museum Hopeless Cycle Story Continue]]>><<set $hcChallengeRandom.blind to false>><<set $phase to 0>><</link>>
<br>
<<link [[무작위 도전 과제로 진행|Museum Hopeless Cycle Story Continue]]>><<hcChallengeRandomSelect>><<set $phase to 0>><</link>>
<br>

:: Museum Hopeless Cycle Story Continue
<<effects>>
<<if $phase is 0>>
	<<if $hcChallengeRandom.blind>>
		<b>선택된 도전 과제:</b> <span class="blue italic">무작위로 <<number $hcChallengeRandom.min>>개에서 <<number $hcChallengeRandom.max>>개 사이.</span>
		<br>
		윈터는 재미있다는 듯 미소 짓는다. "아주 좋아. 내가 놀라게 해줄 수 있는지 한번 보지."
	<<elseif Object.values(V.hcChallenge).some(x => x === true)>>
		<<hcChallengeSummary>>
		윈터는 눈을 감고 고개를 끄덕인다. "그 조건에 맞는 버전이 있는 것 같군. 흔하지는 않지만, 전해지는 이야기가 있지."
	<<else>>
		윈터가 미소 짓는다. "그럼, 고전적인 버전으로군."
	<</if>>
	<br><br>
<</if>>

<<He>>【이가】 당신을 돌아본다. "이제 어떻게 진행되는지는 알겠지. 주제는 논란이 많은 지역 민속 인물이야. 이 그림은 거의 확실히 영감을 준 사건이 일어난 지 한참 뒤에 그려졌지.
신전은 이 이야기를 검열하거나 수정하려고 여러 번 시도했어. 그들의 현대적인 이미지에 상당한 골칫거리거든.
Or so they claim. This painting represents the story of a beloved wise <<worldFemale 'woman' 'man'>> they persecuted for apostasy and witchcraft..."
<br><br>

<<link [[...the injustice of which immortalised <<worldFemale 'her' 'him'>> in myth.|Hopeless Cycle]]>><<pass 30>><<endevent>><</link>>
<br>

:: Museum Hopeless Cycle Story Back
<<effects>>당신은 이미 이야기를 알고 있다는 사실이 생각나서 마음이 바뀌었다고 윈터에게 말한다. 윈터는 기분 좋게 투덜거린다. "이걸 위해 좋은 의자까지 꺼내 왔는데..."
<br><br>

<<He>>【은는】 일어나서 다시 의자를 잡으려고 몸을 돌린다. "음, 마음 바뀌면 알려줘."
<br><br>

<<set $museumAntiques.paintings.paintingsnake to "museum">>

<<link [[다음|Museum]]>><<unset $hcChallenge>><<set $daily.winterStoryTime to false>><<endevent>><</link>>
<br>

/* Event start */

:: Hopeless Cycle
<<hopelessCycleStart>>
<<set _thermoDisable to true>><<effects>>
<<canvas-model-override "mouth" "neutral">>
<span class="narration">
이 사건은 14세기 후반에 일어났다는 것이 일반적인 정설이다.
스스로를 비르고 수도회라 칭했던 이들은 이 지역에 막대한 지배력을 행사했다.<br><br>

이는 그들을 거의 전멸시킬 뻔했던 종교 분쟁이 있은 지 몇 년 후의 일이다.
박해는 흔했다. 그들은 분쟁에 손을 댔다고 판단한 사람은 누구든 벌하려 들었기 때문이다.
혹은 그들의 후손들까지.
</span>
<br><br>

신전의 지하 감옥이 조용한 경우는 드물지만, 조용할 때면 귀가 먹먹할 정도다.
<br><br>

즉각적인 침묵을 자아내는 한 가지는 돌 위로 육중한 군화가 울리는 소리다.
이 교단 전체에서 그 특유의 장송곡 같은 소리를 낼 만큼 무거운 군화는 단 한 켤레뿐이며,
그것을 신을 만큼 덩치가 큰 개자식도 단 한 명뿐이다.
<br><br>

당신은 평범한 나무 의자에 앉아 몸을 앞으로 기울이며 발소리를 센다. 한 사람뿐이다.
That means <<worldMale 'he' 'she'>>'s alone, and thus probably here to yell at you.
You put your book down and brace yourself as the light of <<worldMale 'his' 'her'>> torch begins to leak into the guardhouse.
The other gaolers all stand at attention. You don't bother. It's never made a difference with <<worldMale 'him' 'her'>>.
<br><br>

<<worldMale 'His' 'Her'>> massive frame finally comes into view, along with <<worldMale 'his' 'her'>> ugly brown-bearded face, marred with a lopsided handprint branding. An absolute wall of a <<worldMale 'man' 'woman'>>. The Bishop's Hand. <<worldMale 'He' 'She'>>'s carrying something over <<worldMale 'his' 'her'>> shoulder. A long, limp sack, split at the bottom into two-
no, that's a person. <<worldMale 'His' 'Her'>> dark eyes scan the room, passing each guard, until <<worldMale 'his' 'her'>> eyes land on you. <<worldMale 'He' 'She'>> holds <<worldMale 'his' 'her'>> torch out wordlessly.
<br><br>

<<link [[횃불을 든다|Hopeless Cycle Torch]]>><<set $phase to 1>><</link>>
<br>
<<link [[Make <<worldMale 'him' 'her'>> carry it <<worldMale 'himself' 'herself'>>|Hopeless Cycle Torch]]>><<hcSuspicion 2>><<set $phase to 2>><</link>>
<br>
<<link [[새 죄수 대신 들겠다고 제안한다|Hopeless Cycle Torch]]>><<set $prisoner.love += 1>><<set $phase to 3>><</link>>
<br>

:: Hopeless Cycle Torch
<<set _thermoDisable to true>><<effects>>
<span class="narration">
이 이야기에는 많은 버전이 있지만, 모든 버전에 걸쳐 몇 가지 공통점이 있다.
그 첫 번째는 주교의 손이 잔인하고 악랄한 집행자였다는 것이다.
<br><br>

Where the stories diverge depends on whether <<worldMale 'he' 'she'>> was the exception, or the norm.
상처는 아직 아물지 않았다. 수도회의 복수는 신속하고 끔찍했다. 이는 많은 이들에게 잔인함을 불러일으켰다.
</span>
<br><br>

<<if $phase is 1>>
	<<wearProp "torch">>
	당신은 당연하다는 듯 내밀어진 횃불을 받는다.
<<elseif $phase is 2>>
	You do nothing. <<worldMale 'He' 'She'>> growls, before handing it out to someone else. <<worldMale 'He' 'She'>> grabs your tunic and yanks you forward in front of <<worldMale 'him' 'her'>>. Looks like you're not getting out of this one.
<<else>>
	<<wearProp "torch">>
	당신은 죄수를 향해 팔을 뻗는다. 주교의 손은 재미있다는 듯 끙 소리를 내지만, 횃불 손잡이로 당신의 이마를 친 뒤 다시 내민다. 이번에는 눈치를 챈다. <<pain 2>><<gpain>>
<</if>>
<br><br>

<<worldMale 'He' 'She'>> nods towards the limp figure over <<worldMale 'his' 'her'>> shoulder. "Fresh from the wall." <<worldMale 'His' 'Her'>> voice is a lecherous rumble, making the following belly laugh all the more unsettling. "Hounds enjoyed their meat."
<<worldMale 'He' 'She'>> points forward, down the primary corridor. <<if $phase isnot 2>>You light the way forward.<<else>>The other guard lights the way forward, and you follow.<</if>>
<br><br>

One. Two. Three. Four. Five. Six. Seven. Eight. Nine. Ten. Nine. <<worldMale 'He' 'She'>> stops to think. Eight. Nine. Ten. Nine. <<worldMale 'He' 'She'>> finally stops on the ninth cell. Only five of the cells you passed were even occupied.
You expertly find the right key on your key ring, unlocking the cell. <<if $phase is 2>><<worldMale 'He' 'She'>> shoves you in ahead of <<worldMale 'him' 'her'>><<else>>You enter ahead of <<worldMale 'him' 'her'>><</if>>.
<br><br>

<<worldMale 'He' 'She'>> approaches the back wall, laying the new prisoner down. "You won't get much noise out of this one," <<worldMale 'he' 'she'>> says as <<worldMale 'he' 'she'>> secures <<worldFemale 'her' 'his'>> silver manacles to the wall by a chain. "No more singing for this birdie."
<br><br>

<<worldMale 'He' 'She'>> turns to you, chuckling. Staring. As if waiting for you to speak out of turn.
<br><br>

<<link [[Ask what <<worldFemale 'her' 'his'>> crimes are|Hopeless Cycle Ask]]>><<hcSuspicion 5>><<set $prisoner.love += 1>><<set $phase2 to 1>><</link>>
<br>
<<link [[침묵을 지킨다|Hopeless Cycle Ask]]>><<set $phase2 to 2>><</link>>
<br>
<<link [[명령이 무엇인지 묻는다|Hopeless Cycle Ask]]>><<hcSuspicion -3>><<set $phase2 to 3>><</link>>
<br>

:: Hopeless Cycle Ask
<<set _thermoDisable to true>><<effects>>
<span class="narration">
Every spin on this tale, every divergence, comes from this <<worldMale 'man' 'woman'>>. <<worldFemale 'Her' 'His'>> personal gaoler.
<<worldMale 'His' 'Her'>> name is lost to time, but most sources point to <<worldMale 'him' 'her'>> being a member of the old Fayne noble family.
A family with deep, historic ties to the cloister. It's probable that many of <<worldMale 'his' 'her'>> <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> in worship were familial as well.
</span>
<br><br>

<<if $phase2 is 1>>
	You ask why <<worldFemale 'she' 'he'>>'s being locked up. Immediately, <<worldMale 'he' 'she'>> punches you in the gut, doubling you over. <<pain 6>><<ggpain>>
	<br><br>

	"묻지 말아야 한다는 건 잘 알 텐데. 내가 알려줄 필요가 있다고 생각하면, 그때까지 기다려."
<<elseif $phase2 is 2>>
	You stay quiet. <<worldMale 'He' 'She'>> makes a satisfied grunt.
<<else>>
	You obediently ask for your orders. <<worldMale 'He' 'She'>> gruffs under <<worldMale 'his' 'her'>> breath. "Such a good dog, always ready to heel."
<</if>>
<br><br>

<<worldMale 'He' 'She'>> removes a pouch from <<worldMale 'his' 'her'>> waist, and draws a big cross on the wall in dark grey paste. <<worldMale 'He' 'She'>> speaks as <<worldMale 'he' 'she'>> works.
<br><br>

"<<worldFemale 'She' 'He'>>'s a witch. Consorted with the Dark Elk and seduced the townsfolk. They're not happy about <<worldFemale 'her' 'him'>> being taken." <<worldMale 'He' 'She'>> walks to the next wall and starts the second cross. "Ungrateful pigs."
<br><br>

<<worldMale 'He' 'She'>> finishes the cross, moving to the third wall. "<<worldFemale 'She' 'He'>>'s your responsibility. Personally. Too much of a contamination risk for more than one guard, which means you don't touch any other prisoners." <<worldMale 'He' 'She'>> pauses to point at you. <span class="blue">"It also means you get sanctified whenever you enter or leave the dungeon."</span>
<br><br>

<<worldMale 'He' 'She'>> finishes the last cross. "<span class="red">Make sure <<worldFemale 'she' 'he'>> lives, but hates every minute of it.</span> Bring <<worldFemale 'her' 'him'>> salvation through suffering. <span class="blue">Be here every day, at mid-day, for <<worldFemale 'her' 'his'>> penance.</span> Keep <<worldFemale 'her' 'him'>> intact until the red moon. <span class="red">If you show mercy, I'll assume <<worldFemale 'she' 'he'>> bewitched you.</span>" <<worldMale 'He' 'She'>> pushes past you, <<if $phase is 2>>leaving with the other guard<<else>>yanking the torch from your hands and leaving the cell<</if>>. You're plunged into darkness.
<br><br>

The cell's too dark for you to even inspect <<worldFemale 'her' 'him'>> now. You'll need to grab another torch.
<br><br>

<<link [[다음|Hopeless Cycle Cell]]>><<endevent>><<set $hc.daily.enteredDungeon to true>><</link>>
<br>

/* Dungeon / guardhouse */

:: Hopeless Cycle Dungeon
<<set $location to "old_temple">><<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "guardhouse">>
<<hopelessCycleEffects>>

당신은 신전 지하 감옥의 경비실에 있다. 여러 개의 복도가 있고, 각 복도에는 10개의 감옥이 있다.
<<if ["dusk","night"].includes(Time.dayState) and $hc.dungeonTorchState isnot "lit">>
	<<if hcItemLitTorch()>>
		<span class="orange">당신의 횃불이 어둠을 밝힌다.</span>
	<<else>>
		어둡고 고요하다.
	<</if>>
<<else>>
	<<if $hc.dungeonTorchTime lte 0>>
		<<if Time.dayState is "dawn">>
			떠오르는 태양 빛이 신전의 이 부분을 직접 비추기 때문에 새벽이 항상 가장 밝다.
		<<else>>
		위층과 작은 창살 창문을 통해 약간의 빛이 스며들어 온다.
		<</if>>
	<<else>>
		횃불 빛이 벽을 따라 흔들린다.
	<</if>>
<</if>>
<<if Weather.precipitation is "rain">>
	비가 창문을 통해 서서히 스며들어, 각 복도의 완만한 경사면을 따라 중앙의 배수구로 흘러 들어간다.
<</if>>
이곳에는 처리 수로로 가는 계단이 있다.
<br>
<<if $hc.intro>>
	<<if $hc.dungeonTorchState is "lit" and $hc.dungeonTorchTime gte 1>>
		<span class="orange">횃불은 꺼지지 않는 한 앞으로 <span class="gold"><<number $hc.dungeonTorchTime>></span>시간 더 타오를 것이다.</span>
		<<if ["dusk","night"].includes(Time.dayState)>>
			<<if Time.dayState is "dusk">>
				<span class="blue">해질녘이 오면 그것들을 꺼야 한다.</span>
			<<else>>
				<span class="red">해질녘이 지났다. 의심을 살지도 모른다.</span>
			<</if>>
		<</if>>
	<<else>>
		<<if $hc.dungeonTorchState is "snuffed" and $hc.dungeonTorchTime gte 1>>
			<span class="blue">횃불은 꺼져 있다. 다시 불을 붙이면 <span class="gold"><<number $hc.dungeonTorchTime>></span>시간 동안 타오를 것이다.</span>
			<<if hcItemLitTorch()>>
				이미 불이 있으므로 다시 불을 붙이기는 쉬울 것이다.
			<<else>>
				불붙은 횃불이 없으면 다시 불을 붙이는 것은 느리고 지루할 것이다.
			<</if>>
		<<else>>
			<<set $hc.dungeonTorchState to "burnt">>
			<span class="red">횃불이 모두 타버렸다.</span> 완전히 교체하려면 시간과 수고가 들 것이다.
		<</if>>
		<<if !["dusk","night"].includes(Time.dayState)>>
			<<if Time.hour gte 12>>
				<span class="red">지금쯤이면 불을 붙여 두었어야 했다!</span>
			<<else>>
				<span class="yellow">정오까지는 불을 붙여 두어야 한다.</span>
			<</if>>
		<</if>>
	<</if>>
	<<if $hc.handLocation is "guardhouse">>
		<<set $hc.daily.handWarning to true>>
		<br>
		<span class="red">주교의 손이 이곳에서 죄수들을 검문하고 괴롭히고 있다.</span>
	<</if>>
	<br>
<</if>>
<br>

<<if _hcEvent is "blood">>
	The heavy dirge of footsteps comes down the dungeon stairs. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif (Time.hour gte 23 or Time.hour lte 4) and ($hc.nightBreakIn is "tonight" or $hc.nightBreakIn is "heard")>>
	<<loadNPC 0 "hc_abuser">><<person1>>
	감옥 복도 중 하나에서 희미한 발소리가 들린다. <span class="red">고개를 돌리자 <<print window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥 문이 열려 있는 것이 보인다.</span> 당신은 <<= $temple_weapon is "whip" ? "채찍" : "봉">>에 손을 얹는다.
	<br><br>

	You slowly approach, and hear a voice. "Wretched <<worldFemale 'seductress' 'seducer'>>," a <<personssimple>> voice spits. "Why should <<worldMale 'Brother' 'Sister'>> Fayne have you to <<worldMale 'himself' 'herself'>>? My vows are already broken. I may as well..."
	<br><br>

	감옥 안을 엿보자, 검은 로브를 입은 <<personsimple>> 하나가 <<print window.KR.gatPersonNameDictKR($prisoner.name)>>에게 다가가고 있다.
	<<if $hcChallenge.faithBlooms>>
		<<His>> 손가락이 움찔거린다. "이 손 기억하나? <span @class="$prisonerEvents.includes('washHair') ? 'red' : ''">이 손이 네 머리카락을 얼마나 쉽게 빼앗았는지.</span> 이번에는 머리카락 한 줌보다 <i>더 많은 것</i>을 가져가겠다."
	<</if>>
	<br><br>

	<<link [[지하 감옥에서 몰래 빠져나간다|Hopeless Cycle Cell Caught Sneak]]>><</link>>
	<br>
	<<link [[개입한다|Hopeless Cycle Cell Caught Intervene]]>><<set $prisoner.love += 10>><</link>><<hopelessCycleLove 2>>
	<br>
<<elseif _hcEvent is "dailyPunishment">>
	The Bishop's Hand stands by <<print $prisoner.name>>'s cell with a confessor. <<worldMale 'He' 'She'>> waves you over. "It's time, <<worldMale 'brother' 'sister'>>."
	<br><br>

	You enter the cell with <<worldMale 'him' 'her'>>.
	<br><br>

	<<if $hc.gameOver>>
		<<link [[다음|Hopeless Cycle Ending F]]>><<endevent>><<set $phase to 1>><</link>>
		<br>
	<<else>>
		<<link [[다음|Hopeless Cycle Prisoner Inspection]]>><<endevent>><</link>>
		<br>
	<</if>>
<<else>>
	<<if !$hc.intro>>
		다른 간수 중 한 명이 당신에게 손짓하고 있다.
		<br>
		<<socialiseicon>><<link [[다가가서 말을 건다 (0:05)|Hopeless Cycle Friend]]>><<set $hc.intro to true>><<pass 5>><</link>>
		<br>
	<<else>>
		<<switch $hc.dungeonTorchState>>
			<<case "burnt">>
				<<if !["night"].includes(Time.dayState) or hcItemLitTorch()>>
					<<link [[횃불을 교체한다 <<hcTimeTaskDisplay 150>>|Hopeless Cycle Dungeon Torch]]>><<set $torchAction to "dungeonTorchReplace">><<hcTimeTaskPass 150>><<tiredness 6>><<set $hc.dungeonTorchTime to 11>><<set $hc.dungeonTorchState to "snuffed">><</link>><<gtiredness>>
				<<else>>
					<span class="red">횃불을 교체하기에는 너무 어둡다. 동이 틀 때까지 기다리거나, 다른 곳에서 빛을 가져와야 한다.</span>
				<</if>>
			<<case "snuffed">>
				<<if hcItemLitTorch()>>
					<<link [[횃불에 다시 불을 붙인다 <<hcTimeTaskDisplay 10>>|Hopeless Cycle Dungeon Torch]]>><<set $torchAction to "dungeonTorchReignite">><<hcTimeTaskPass 10>><<set $hc.dungeonTorchState to "lit">><</link>>
				<<elseif !["night"].includes(Time.dayState)>>
					<<if hcItemHolding("torch")>>
						<<link [[손으로 횃불에 불을 붙인다 (0:15)|Hopeless Cycle Dungeon Torch]]>><<set $torchAction to "dungeonTorchByHand">><<pass 15>><<tiredness 12>><<set hcItemHolding("torch").state to "lit">><<set hcItemHolding("torch").time to $hcChallenge.torchFaster ? 10 : 5>><</link>><<ggtiredness>>
					<<else>>
						<span class="blue">꺼진 횃불을 집어 손으로 불을 붙여라.</span>
					<</if>>
				<<else>>
					<span class="red">손으로 횃불에 불을 붙이기에는 너무 어둡다. 동이 틀 때까지 기다리거나, 다른 곳에서 빛을 가져와야 한다.</span>
				<</if>>
				<<if $hc.dungeonTorchTime lt 6>>
					<br>
					<<link [[횃불 연료를 보충한다 <<hcTimeTaskDisplay 30>>|Hopeless Cycle Dungeon Torch]]>><<set $torchAction to "dungeonTorchRenew">><<hcTimeTaskPass 30>><<set $hc.dungeonTorchTime += 8>><</link>>
				<</if>>
			<<default>>
				<<if hcItemCanReach("snuffer")>>
					<<link [[횃불을 끈다 <<hcTimeTaskDisplay 10>>|Hopeless Cycle Dungeon Torch]]>><<set $torchAction to "dungeonTorchSnuff">><<set $hc.dungeonTorchState to "snuffed">><<hcTimeTaskPass 10>><</link>>
				<<else>>
					<span class="red">횃불을 끄려면 횃불 뚜껑이 필요하다.</span>
				<</if>>
		<</switch>>
		<br>
	<</if>>
	<br>

	<<set _itemsHere.push("torch")>>
	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>

	<b><u>장소:</u></b><br>
	<<if $hc.gameOver>>
		<span class="red">...</span><br>
		<<prisonicon "cell">><<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Ending F]]>><<endevent>><</link>>
	<<elseif $hc.nightBreakIn is "failed">>
		<<prisonicon "cell">><<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Night Break In Aftermath]]>><<endevent>><</link>>
	<<else>>
		<<prisonicon "cell">><<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Cell]]>><<endevent>><<set $hcAction to "enter">><</link>>
	<</if>>
	<br>

	<<if $hc.intro>>
		<<if Time.dayState is "night" and (Time.hour gte 23 or Time.hour lte 5)>>
			<<if $worn.upper.name is "chain tunic" or hcItemLitTorch()>>
				<<if $worn.upper.name is "chain tunic">>
					<span class="red">갑옷 때문에 눈에 띈다.</span>
				<</if>>
				<<if hcItemLitTorch()>>
					<span class="red">불붙은 횃불 때문에 몰래 움직일 수 없다.</span>
				<</if>>
				<br>
			<</if>>
			<<getouticon>><<link [[회랑으로 몰래 나간다 (0:02)|Hopeless Cycle Cloister Sneak]]>><<pass 2>><</link>>
			<br>
		<<else>>
			<<templeicon "cloister">><<link [[회랑 <<hcTimeDungeonDisplay>>|Hopeless Cycle Dungeon Leave]]>><<hcTimeDungeonPass>><</link>>
			<br>
		<</if>>
		<<if hcItemLitTorch()>>
			<<sewericon "main">><<link [[처분 수로 (0:05)|Hopeless Cycle Disposal]]>><<pass 5>><</link>>
		<<elseif $hcItems.some(torch => torch.type is "torch" and torch.location is "disposal" and torch.inSconce is true and torch.state is "lit")>>
			<<sewericon "main">><<link [[처분 수로 (0:05)|Hopeless Cycle Disposal]]>><<pass 5>><</link>>
		<<else>>
			<span class="red">처분 수로는 횃불 없이는 들어갈 수 없을 만큼 어둡다.</span>
		<</if>>
		<br>
	<</if>>

	<<if $debug>>
		<br>
		<<hcicon "bucket">><<link [[아이템 디버그|Hopeless Cycle Debug]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Hopeless Cycle Friend
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<generateTemple 1>><<person1>>
<span class="narration">When faced with a common trouble, such as a sadistic taskmaster, it was easy to form bonds with those standing beside <<worldMale 'him' 'her'>>.</span>
<br><br>

<<He>>【이가】 당신의 어깨를 두드린다.
<<if $pain gte 20>>
	"<<worldMale 'King' 'Queen'>> shit-beard didn't rough you up too badly, did <<worldMale 'he' 'she'>>?" <<He>> cleans off your face with a piece of damp cloth. <<pain -10>><<llpain>>
	<br><br>
<<else>>
	"Looks like <<worldMale 'king' 'queen'>> shit-beard has it out for you." <<He>> chuckles under <<his>> breath.
<</if>>
"We're in this together, <<worldMale 'brother' 'sister'>>. Remember who the real enemy is." <<He>> shoots a sharp glare at <<print $prisoner.name>>'s cell. "Give <<worldFemale 'her' 'him'>> a few extra lashes for me."
<br><br>

<<He>>【은는】 지하 감옥을 떠나려다 첫 번째 계단에서 멈춘다. <span class="blue">"밤에 여기서 일 끝나면 횃불 끄는 거 잊지 마."</span>
<br><br>

<<link [[다음|Hopeless Cycle Dungeon]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Dungeon Torch
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<switch $torchAction>>
	<<case "dungeonTorchReplace">>
		<<run hcItemAdd("torch", "disposal")>>
		<<run hcItemAdd("torch", "disposal")>>
		<<run hcItemAdd("torch", "disposal")>>
		당신은 볼트로 고정된 모든 촛대를 열고, 쓸모없는 횃불을 모두 모아 처리 통로 계단 아래로 던져버린다. 대부분은 저절로 물속으로 굴러 들어갈 것이다. 그러길 바랄 뿐이다.
		<br><br>

		당신은 수십 개의 횃불을 공들여 준비한다. 하나하나가 과정이다. 자루. 동물성 지방. 부싯깃. 천. 타르. 반복. 자루. 지방. 부싯깃. 천. 타르...
		<br><br>

		시간이 오래 걸린다. 마침내 마지막 횃불을 촛대에 꽂고, 만족스럽게 이마를 닦는다. <<trauma -12>><<lltrauma>>
		<br><br>

		아직 불을 붙여야 한다는 사실을 기억해낸다. <<stress 3>><<gstress>>
	<<case "dungeonTorchReignite">>
		당신은 각 복도를 걸어 내려가며 꼼꼼하게 모든 횃불에 불을 붙인다. <<trauma -3>><<ltrauma>>
	<<case "dungeonTorchRenew">>
		당신은 각 횃불에 동물성 지방, 천, 타르를 더 추가하여 자루까지 타지 않도록 한다. 시간이 좀 걸리지만, 처음부터 서른 개가 넘는 새 횃불을 준비하는 것만큼 힘들지는 않다. <<trauma -6>><<ltrauma>>
	<<case "dungeonTorchByHand">>
		자루. 동물성 지방. 부싯깃. 천. 타르. 당신은 불붙지 않은 횃불을 흔들어 느슨한 부분이 없는지 확인한다. 모든 것이 잘 고정되어 있다. 지금까지 수백 번은 해본 일이라 꽤 능숙하다.
		<br><br>

		그렇다고 해서 덜 지루한 것은 아니다. 당신은 부싯깃 한 줌과 쓰지 않은 자루를 잡는다. 연기가 보일 때까지 손바닥 사이에서 돌린 다음, 입으로 분다.
		<br><br>

		횃불 끝을 집어넣자 마침내 불이 붙는다.
	<<case "dungeonTorchSnuff">>
		<<wearProp "antique snuffer">>
		<<if hcItemHolding("snuffer")>>
			당신은 잠시 횃불 끄는 도구를 손에서 빙빙 돌린다.
		<<else>>
			당신은 벽에서 횃불 끄는 도구를 집는다.
		<</if>>
		그것은 작고 구부러진 막대 위에 달린 종 모양의 금속 컵이다. 당신은 첫 번째 횃불 위에 그것을 덮어 공기를 차단하고 재빨리 불을 끈다. 각 복도를 걸어 내려가며 이 과정을 반복한다.
		<br><br>

		당신은 항상 이 일이 이상하게 만족스럽다고 느꼈다. <<stress -6>><<lstress>>
<</switch>>
<br><br>

<<unset $torchAction>>
<<link [[다음|Hopeless Cycle Dungeon]]>><</link>>
<br>

:: Hopeless Cycle Dungeon Leave
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set _susFromContainers to 0>>

<<run $hcItems.filter(containers => containers.containerID &&
	containers.location === "held" &&
	!V.hcItems.some(thing => thing.type === "sheets" && thing.location === containers.containerID)).forEach(container => {
	V.hcItems.filter(item => item.location === container.containerID && ["clothes", "snuffer", "bandages", "food", "clutter", "bones"].includes(item.type)).forEach(gip => {
		T.susFromContainers++;
	})
})>>
<<generateTemple 1>><<person1>>
<<if $exposed gte 2>>
	You leave the dungeon. A <<priest>> awaits you at the top of the stairs, and covers <<his>> mouth when <<he>> notices your exposure. "<<worldMale 'Brother' 'Sister'>>, what happened?"
	<br><br>

	당신은 기도와 축복을 받는 동안 고통스러울 정도로 오랫동안 노출된 채로 있어야만 한다. <<stress 40>><<gggstress>><<trauma 50>><<gggtrauma>><<hcSuspicion 10>><<hopelessCycleSus 2>>
	<br><br>
<<else>>
	<<if !$hc.daily.enteredDungeon>>
		<<if $worn.upper.name isnot "chain tunic">>
			You leave the dungeon. A <<priest>> awaits you at the top of the stairs, and looks confused. "<<worldMale 'Brother' 'Sister'>>? I never saw you enter. Where is your armour?" You undergo the lengthy process of prayers and blessings to purge the witch's filth from your body. <<stress 8>><<gstress>><<trauma 10>><<gtrauma>><<hcSuspicion 20>><<hopelessCycleSus 3>>
		<<else>>
			You leave the dungeon. A <<priest>> awaits you at the top of the stairs, and looks confused. "<<worldMale 'Brother' 'Sister'>>? I never saw you enter." You undergo the lengthy process of prayers and blessings to purge the witch's filth from your body. <<stress 8>><<gstress>><<trauma 10>><<gtrauma>><<hcSuspicion 10>><<hopelessCycleSus 2>>
		<</if>>
	<<else>>
		당신은 지하 감옥을 떠난다. 계단 꼭대기에서 <<priest>>【이가】 당신을 기다리고 있다. 당신은 마녀의 오물을 몸에서 정화하기 위한 긴 기도와 축복의 과정을 거친다. <<stress 8>><<gstress>><<trauma 10>><<gtrauma>>
	<</if>>
	<br><br>

	<<if _susFromContainers>>
		<<Hes>> too busy with the rites to inspect the items in your bucket, but some of your other <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> steal the occasional glance. <<hcSuspicion _susFromContainers>><<hopelessCycleSus 1>>
		<br><br>
	<</if>>
<</if>>

<<link [[다음|Hopeless Cycle Cloister]]>><<endevent>><<set $hc.daily.enteredDungeon to false>><<set $hc.snuckInDungeon to false>><</link>>
<br>

:: Hopeless Cycle Dungeon Enter
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
/* Items that are suspicious when held inside containers, unless that container also holds a bedsheet */
<<set _susFromContainers to 0>>
<<run $hcItems.filter(containers => containers.containerID &&
	containers.location === "held" &&
	!V.hcItems.some(thing => thing.type === "sheets" && thing.location === containers.containerID)).forEach(container => {
	V.hcItems.filter(item => item.location === container.containerID && ["clothes", "snuffer", "bandages", "food", "clutter", "bones"].includes(item.type)).forEach(gip => {
		T.susFromContainers++;
	})
})>>

<<generateTemple 1>><<person1>>
당신은 지하 감옥으로 가는 계단에 접근한다.
<<if $worn.upper.name isnot "chain tunic">>
	A <<priest>> awaits you, and raises <<worldFemale 'her' 'his'>> hand to stop you. "<<worldMale 'Brother' 'Sister'>>, I can't let you in without your armour. It's an important part of the sanctification."
	<br><br>

	<<link [[다음|Hopeless Cycle Cloister]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if $hc.daily.enteredDungeon>>
		A <<priest>> awaits you, and raises an eyebrow. "<<worldMale 'Brother' 'Sister'>>? I didn't see you leave." You undergo the lengthy process of prayers and blessings to ready yourself for exposure to the witch. <<stress 8>><<gstress>><<trauma 10>><<gtrauma>> <<hcSuspicion 10>><<hopelessCycleSus 2>>
	<<else>>
		<<priest>>【이가】 당신을 기다리고 있다. 당신은 마녀에게 노출될 준비를 하기 위한 긴 기도와 축복의 과정을 거친다. <<stress 8>><<gstress>><<trauma 10>><<gtrauma>>
	<</if>>
	<br><br>

	<<if _susFromContainers>>
		<<Hes>> too busy with the rites to inspect the items in your bucket, but some of your other <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> steal the occasional glance. <<hcSuspicion _susFromContainers>><<hopelessCycleSus 1>>
		<br><br>
	<</if>>

	<<link [[다음|Hopeless Cycle Dungeon]]>><<endevent>><<hcTimeDungeonPass>><<set $hc.daily.enteredDungeon to true>><<set $hc.snuckInDungeon to false>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Cloister Sneak
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

당신은 회랑으로 몰래 돌아간다.
<<if $worn.upper.name is "chain tunic">>
	<span class="red">소란스러운 사슬 갑옷 때문에 쉽지 않다. 누군가 분명히 당신의 소리를 들었다.</span> <<hcSuspicion 10>><<hopelessCycleSus 2>>
<<elseif hcItemLitTorch()>>
	<span class="red">하지만 불 붙은 횃불은 은신에 좋지 않다. 누군가 당신을 봤을 가능성이 높다.</span> <<hcSuspicion 10>><<hopelessCycleSus 2>>
<<else>>
	아무도 당신을 듣거나 보지 못한 것 같다.
<</if>>
<br><br>

<<link [[다음|Hopeless Cycle Cloister]]>><<set $hc.snuckInDungeon to false>><</link>>
<br>

:: Hopeless Cycle Dungeon Sneak
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

당신은 회랑에서 지하 감옥으로 몰래 들어간다.
<<if $worn.upper.name is "chain tunic">>
	<span class="red">소란스러운 사슬 갑옷 때문에 쉽지 않다. 누군가 분명히 당신의 소리를 들었다.</span> <<hcSuspicion 10>><<hopelessCycleSus 2>>
<<elseif hcItemLitTorch()>>
	<span class="red">하지만 불 붙은 횃불은 은신에 좋지 않다. 누군가 당신을 봤을 가능성이 높다.</span> <<hcSuspicion 10>><<hopelessCycleSus 2>>
<<else>>
	아무도 당신을 듣거나 보지 못한 것 같다.
<</if>>
<br><br>

<<link [[다음|Hopeless Cycle Dungeon]]>><<set $hc.snuckInDungeon to true>><</link>>
<br>

/* Disposal channel */

:: Hopeless Cycle Disposal
<<set $location to "drain">><<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "disposal">>
<<hopelessCycleEffects>>
<<set _torchInSconce to $hcItems.find(torch => torch.type is "torch" and torch.state is "lit" and torch.location is "disposal" and torch.inSconce is true)>>

당신은 신전의 처리 수로에 있다. 돌과 세차게 흐르는 수로로 이루어진 미로다. 깨끗한 물을 담는 수조와는 연결되어 있지 않다고 들었다.
긴 돌계단이 이곳을 신전 지하 감옥과 연결한다.
<br><br>

<<if $exposed gte 2>>
	이런 오물 주위에서 몸을 드러내고 있자니 비참한 기분이 든다. <<stress 20>><<ggstress>><<trauma 6>><<gtrauma>>
<<else>>
	수련생 시절부터 항상 이 장소를 싫어했다. <<trauma 2>><<gtrauma>>
<</if>>
<br><br>

<<if $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif !hcItemLitTorch() and !_torchInSconce>>
	<<if !$hc.disposalDarkCount>>
		<<set $hc.disposalDarkCount to 0>>
	<</if>>
	<span class="red">칠흑같이 어둡다. 어디로 가는지 볼 수 없다!</span>
	<br><br>

	<<cleareventpool>>
	<<addinlineevent "dungeon">>
		<<set _toDrop to $hcItems.find(bucket => bucket.name is "bucket" and bucket.location is "held")>>
		<<if _toDrop>>
			<<set _toDrop.location to "disposal">>
			<span class="red">들고 있던 양동이를 떨어뜨린다!</span> 더듬거리며 찾아보지만 소용없다. 광원을 가지고 돌아와 찾아야 할 것이다.
			<br><br>

			한참을 더 비틀거린 끝에, 마침내 계단을 발견한다.
			<br><br>

			<<prisonicon "cell">><<link [[지하 감옥 (0:20)|Hopeless Cycle Dungeon]]>><<pass 20>><</link>>
			<br>
		<<else>>
			얼마간 비틀거리다 계단을 발견한다.
			<br><br>

			<<prisonicon "cell">><<link [[지하 감옥 (0:20)|Hopeless Cycle Dungeon]]>><<pass 20>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "lizard">>
		<<beastNEWinit 1 lizard>>
		거대한 <<beasttype>>【이가】 물 밖으로 솟구쳐 오른다! <<bhim>>에게는 <<bhis>> 크기 외에도 부자연스러운 점이 있다. 눈썹 뼈에서 마치 나뭇가지 같은 것이 튀어나와 있다.
		<br><br>

		<<if beastSexEnabledForType("lizard", $monster is 1) and not ($NPCList[0] and $NPCList[0].lewdBlocked)>>
			<<bHes>> 순식간에 당신에게 달려든다.
			<br><br>

			<<link [[다음|Hopeless Cycle Lizard]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<else>>
			간신히 몸부림쳐 빠져나왔지만, 상처 없이 벗어나지는 못했다. <<beastescape>>
			<br><br>

			한참을 더 눈먼 채로 비틀거린 끝에 마침내 계단을 발견한다.
			<br><br>

			<<prisonicon "cell">><<link [[지하 감옥 (0:20)|Hopeless Cycle Dungeon]]>><<pass 20>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<if $hc.disposalDarkCount gte 3 or !$hcChallenge.forestNoShortcut or $hc.shortcutCount gte 1>>
		<<if $hc.disposalDarkCount gte 3 and !$hc.forestPassage>>
			<<set _forcedPassage to true>>
			<<cleareventpool>>
		<</if>>
		<<addinlineevent "forest">>
			손이 단단하고 차가운 무언가에 닿는다. 밀어내자, 그것이 요란한 소리를 내며 땅에 떨어진다. 저 너머로 빛이 보인다.
			<br><br>

			땅이 경사지기 시작하는 것이 느껴진다. 이제 위로 걷고 있는 것 같다.
			<br><br>

			숲으로 나온다.
			<br><br>

			<<if $hc.shortcutCount isnot undefined and !_forcedPassage>>
				<<set $hc.shortcutCount to 0>>
				당신은 한 쌍의 눈이 지켜보는 것을 느끼고, 유리와 유리가 맞부딪혀 비비는 듯한 날카로운 비명을 듣는다. <span class="red">당신은 더 이상 이 길을 지날 허가를 받지 못했다.</span> 지나가고 싶다면 또 다른 공물을 바쳐야 한다.
			<</if>>

			<<foresticon>><<link [[숲 (0:20)|Hopeless Cycle Forest]]>><<pass 20>><<set $hcForest to 15>><<set $hc.forestPassage to true>><</link>>
			<br>
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>
	<<set $hc.disposalDarkCount++>>
<<else>>
	<<if !$hc.disposalState and $hc.disposals gte 5>>
		<<set $hc.disposalState to 1>>
		멀리서 유리가 돌에 긁히는 듯한 소리가 들린다. <<stress 6>><<gstress>>
		<br><br>

		<<link [[다음|Hopeless Cycle Disposal]]>><</link>>
		<br>
	<<elseif $hc.disposalState is 1 and $hc.disposals gte 15>>
		<<set $hc.disposalState to 2>>
		어둠 속에서 빠르게 덜거덕거리고 쿵쿵거리는 소리가 다가온다.
		<<if hcItemLitTorch()>>
			그 방향으로 횃불을 휘둘러보지만, 아무것도 보이지 않는다.
		<<else>>
			당신은 재빨리 횃불 빛으로 물러난다. 주위를 둘러보지만 아무것도 보이지 않는다.
		<</if>>
		빛이 훨씬 더 극심해진 것 같다. 안쪽은 훨씬 밝아졌지만, 바깥의 모든 것은 어쩐지 이전보다 훨씬 더 어두워졌다.
		<<stress 24>><<ggstress>>
		<br><br>

		<<link [[다음|Hopeless Cycle Disposal]]>><<endevent>><</link>>
		<br>
	<<elseif $hc.disposalState is 2 and $hc.disposals gte 20>>
		<<set $hc.disposalState to 3>>
		빠르게 쿵쿵거리는 소리와 함께 유리가 돌에 긁히는 소리가 다시 들려온다. 소리는 크고 매우 가깝다. 당신은 벽에 부딪힐 때까지 몇 걸음 뒤로 물러선다.
		<br><br>

		<span class="red">머리 위로 숨결이 느껴진다.</span><<stress 24>><<ggstress>>
		<br><br>

		<<link [[보지 않는다|Hopeless Cycle Disposal Torch Friend]]>><<set $phase to 1>><</link>><<willpowerdifficulty 400 900>>
		<br>
		<<link [[본다|Hopeless Cycle Disposal Torch Friend]]>><<set $phase to 2>><</link>>
		<br>
	<<elseif $hc.disposalState is 3 and $hc.disposals gte 30 and $hc.glassfingers>>
		<<set $hc.disposalState to 4>>
		처리 수로에서 몸을 돌리자, 당신 자신의 모습이 비친다.
		<br><br>

		반사되는 표면으로 뒤덮인 인간형 형체가 당신 앞에 앉아 있다. 작은 노란 눈 한 쌍과 갈라진 미소 외에는 아무 특징도 없다. 앉아 있음에도 당신과 눈높이가 같다. 그것의 존재만으로도 빛이 잡아먹히고 있다.
		<br><br>

		그것이 균열 같은 입을 열자, 무엇인가를 감고 있는 터무니없이 긴 노란 혀가 드러난다. 목구멍에서 빛이 쏟아진다. 혀가 뻗어 나와 당신 바로 앞까지 펼쳐지고, 낯설고 몹시 창백한 무언가를 드러낸다.
		<br><br>

		<span class="red">인간의 손목과 팔뚝뼈다.</span> 혀가 까딱이며 그것들을 가져가라는 듯 움직인다. 당신은 망설이다가 그것을 받아 든다.
		<br><br>

		반사되는 생물의 혀가 안으로 말려 들어가고 입이 쾅 닫히며 표면이 다시 봉인된다. 더는 반사되지 않고, 이제는 반투명해져 있다.
		<br><br>

		그것은 몸을 돌려 네 발로 기더니, 크기에 어울리지 않는 불쾌한 속도로 바스락거리며 달아난다.
		<br><br>

		어릴 적 들었던 짧은 노랫말이 떠오른다.<br>
		<i>언젠가 네 마음이 소원을 빌고자 한다면,<br>
		네 손안의 소원의 돌을,<br>
		성스러운 호수에 던져라,<br>
		돌이 없으면, 뼈를 쥐어라.</i>
		<br><br>

		<<run hcItemAdd({ type: "bones", name: "forearm bones", location: "held", origin: "wraith" })>>

		<<link [[다음|Hopeless Cycle Disposal]]>><<endevent>><</link>>
		<br>
	<<else>>
		<<if $hc.forestPassage and $hc.shortcutCount isnot undefined>>
			<<if $hc.shortcutCount gt 1>>
				숲으로 가는 지름길을 앞으로 <span class="blue"><<number $hc.shortcutCount>></span>번 더 이용할 허가를 받은 것 같은 느낌이 든다.
			<<elseif $hc.shortcutCount is 1>>
				숲으로 가는 지름길을 앞으로 <span class="blue">한 번</span> 더 이용할 허가를 받은 것 같은 느낌이 든다.
				<span class="pink">여기로 돌아올 수는 없을 것이다. 편도 여행이 될 것이다.</span>
			<<else>>
				숲으로 가는 지름길을 이용할 <span class="red">허가를 받지 못했다</span>는 느낌이 든다.
			<</if>>
			<br><br>
		<</if>>
		<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>

		<b><u>장소:</u></b><br>
		<<prisonicon "cell">><<link [[지하 감옥 (0:05)|Hopeless Cycle Dungeon]]>><<pass 5>><</link>>
		<br>
		<<if $hc.forestPassage>>
			<<if hcItemLitTorch()>>
				<<if $hcChallenge.forestNoShortcut and !$hc.shortcutCount>>
					<<foresticon>><<link [[숲으로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 5>><</link>>
				<<else>>
					<<foresticon>><<link [[숲으로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 20>><<set $hcForest to 15>><<set $hc.snuckInDungeon to false>><</link>>
				<</if>>
			<<else>>
				<<ind>><span class="purple">숲으로 가는 지름길을 이용하려면 불붙은 횃불을 <i>들고</i> 있어야 한다.</span>
			<</if>>
			<br>
		<</if>>
	<</if>>
<</if>>

:: Hopeless Cycle Disposal Torch Friend
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<<if $willpowerSuccess and $phase is 1>>
	보지 않으면, 현실이 아니다. 믿음이 힘이다. 당신은 이 말을 몇 번이고 되뇐다. <span class="red">또 다른 숨결이 느껴진다.</span> 보지 마. 보는 것은 현실로 만드는 것이다. 믿음이 힘이다.
	<br><br>

	<span class="green">당신은 눈을 감고, <<if $worn.upper.name is "chain tunic">>건틀릿으로<<else>>손으로<</if>> 등 뒤의 돌벽을 붙잡는다. 얼마 후, 숨소리는 마침내 멈춘다.</span>
	<br><br>

	당신은 눈을 뜨고 위를 올려다본다. 그곳엔 아무것도 없었다.
	<br><br>

	<<link [[다음|Hopeless Cycle Disposal]]>><<endevent>><</link>>
	<br>
<<else>>
	보지 않으면, 현실이 아니다. 당신은 그렇게 되뇌고 또 되뇌려 애쓴다. 그것의 숨결이 당신의 귀, 목, 척추를 타고 내려온다. <span class="red">어쩔 수 없다. 당신은 위를 올려다본다.</span>
	<br><br>

	사람 형상을 한 무언가가 벽에 매달려 있고, 그 머리는 당신의 머리에 거의 닿을 듯하다. 그것은 완전히 반사되는 재질이지만, 횃불의 빛은 거의 빨려 들어가는 것처럼 보인다. 윤기 나는 노란 눈이 당신을 노려본다.
	<br><br>

	당신은 얼어붙었다. 천천히, 그것의 머리를 따라 금이 가며 넓은 미소를 형성한다.
	<br><br>

	<<set _torchHeld to hcItemLitTorch()>>
	<<set _torchInSconce to $hcItems.find(torch => torch.type is "torch" and torch.state is "lit" and torch.location is "disposal" and torch.inSconce is true)>>
	<<if _torchHeld and _torchInSconce>>
		그것은 천천히 길쭉한 손 하나를 당신의 횃불로, 다른 손을 벽의 횃불 받침대로 가져간다. 동시에, 그것은 양손으로 두 횃불을 움켜쥐고, 횃불들이 꺼지면서 당신을 어둠 속으로 밀어 넣는다.
	<<elseif _torchInSconce>>
		그것은 천천히 길쭉한 손을 벽의 횃불 받침대 위로 가져간다. 그 눈은 당신에게 고정된 채 미소는 계속해서 넓어진다. 그것은 불타는 횃불 위로 손을 닫고, 횃불이 꺼지면서 당신을 어둠 속으로 밀어 넣는다.
	<<else>>
		그것은 천천히 길쭉한 손을 당신의 횃불 위로 가져간다. 그 눈은 당신에게 고정된 채 미소는 계속해서 넓어진다. 그것은 불타는 횃불 위로 손을 닫고, 횃불이 꺼지면서 당신을 어둠 속으로 밀어 넣는다.
	<</if>>
	<<gggstress>><<gggtrauma>><<stress 50>><<trauma 100>>
	<br><br>

	<<run $hcItems.filter(torch => torch.type is "torch" and torch.state is "lit" and ["held", "disposal"].includes(torch.location)).forEach(torch => {torch.state = "snuffed"})>>

	<<link [[다음|Hopeless Cycle Disposal]]>><<endevent>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Disposal Glassfingers
<<set _thermoDisable to true>><<effects>><<set $hc.disposals += 10>>
<<if $hc.shortcutCount isnot undefined>><<set $hc.shortcutCount++>><</if>>
<<unset $itemAction>><<unset $itemActionObject>>

당신은 아직 불타고 있는 횃불을 수로로 던진다.
<br><br>

그것이 멈춘다. 공중에서. 물 바로 위에서.
<br><br>

길고 빛나는 노란 부속지가 천장에서 내려와 횃불 자루를 감싸고 있다. 그것은 천천히 수축하며 횃불을 위로 끌어올린다.
<br><br>

무언가 위에서 반짝인다. 횃불의 빛이 그것에 반사되지만, 그것이 무엇이든 빛 자체를 집어삼키는 것처럼 보인다.
<br><br>

벌어진 어둠 속에서 길고 유리 같은 네 개의 손가락이 횃불을 감싸는 것이 보인다. 그것들은 잠시 동안 화려한 색의 조합으로 빛나다가, 횃불이 빠르게 어두워지면서 연기로 가득 차는 것처럼 보인다.
<br><br>

횃불, 손가락, 그리고 부속지 모두가 한 번에 사라진다. 당신은 눈을 비빈다. <<trauma 50>><<gggtrauma>>
<br><br>

<<if $hc.trueEndAvailable>>
	<span class="narration">
		이 존재에 대한 이야기는 어린 수련생들을 복종시키기 위해 겁주는 데 사용되었다. 그들 중 다수는 그것을 믿었다.
		<br><br>

		그것은 유리로 된 생물이었다. 다른 구전에서는 그것이 투명했는지 반사되었는지에 대해 의견이 분분하다. 때로는 둘 다이기도 했다.
		횃불이 조기에 꺼지거나, 장작더미가 밤새 타지 못하는 것은 그것의 탓으로 돌려졌다.
		<<if $hcChallenge.forestNoShortcut>>
			무리 구성원들이 수로에서 길을 잃는 것 또한 이 생물의 탓으로 돌려졌다.
		<</if>>
		나는 목격담이 수로의 밀폐된 공간에서 횃불 불꽃이 산소를 소진한 결과물이라고 믿는다.
		<br><br>

		<<if $hc.disposals lt 30>>
			교도관이 그것의 주의를 끌었다. 이제 그것에게 먹이를 주어야 했다. 그것은 '오염된' 물건을 선호했다.
			<br><br>
		<</if>>
	</span>
<</if>>

<<link [[다음|Hopeless Cycle Disposal]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Lizard
<<set _thermoDisable to true>>
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
<</if>>
<<effects>>
<<effectsman>>
<br>
<<beast $enemyno>>
<br><br>

<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[다음|Hopeless Cycle Lizard Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Hopeless Cycle Lizard]]>><</link>></span><<nexttext>>
<</if>>

:: Hopeless Cycle Lizard Finish
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<<if $enemypleasure gte $enemypleasuremax>>
	<<beastejaculation>>

	<<beasttype>>【은는】 만족스러운 듯 <<bhis>> 소리를 내며, 물의 미로 속으로 다시 뛰어든다.
	<br><br>

	<<tearful>> 당신은 몸을 추스른다. 눈먼 채로 더듬거리며 헤맨 끝에, 당신은 지하 감옥으로 돌아가는 길을 찾는다.
	<br><br>

	<<clotheson>>
	<<endcombat>>
	<<canvas-model-override "mouth" "neutral">>

	<<prisonicon "cell">><<link [[지하 감옥 (0:20)|Hopeless Cycle Dungeon]]>><<pass 20>><</link>>
	<br>
<<else>>
	<<if $finish is 1>><<encounterEndViolence>><</if>>
	The <<beasttype>> hisses and dives back into the watery labyrinth.
	<br><br>

	<<tearful>> 당신은 몸을 추스른다. 눈먼 채로 더듬거리며 헤맨 끝에, 당신은 지하 감옥으로 돌아가는 길을 찾는다.

	<<clotheson>>
	<<endcombat>>
	<<canvas-model-override "mouth" "neutral">>

	<<prisonicon "cell">><<link [[지하 감옥 (0:20)|Hopeless Cycle Dungeon]]>><<pass 20>><</link>>
	<br>
<</if>>

/* Cloister */

:: Hopeless Cycle Cloister
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "cloister">>
<<hopelessCycleEffects>>

당신은 신전 회랑에 있다.
<<if Time.hour gte 7 and Time.hour lte 9 and !$hc.daily.sermon>>
	<span class="blue">The Bishop's Hand is here, preparing for the daily sermon.</span> Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> sit in lines.
<<elseif Time.dayState is "night">>
	섬뜩할 만큼 조용하다.
	<<if (Time.hour gte 23 or Time.hour lte 5)>>
		지하 감옥으로 내려가는 계단은 밤새 잠겨 있으며, 복도를 배회하는 사람은 없다.
	<<else>>
		복도를 배회하는 사람은 없지만, 지하 감옥으로 가는 계단에는 여전히 누군가 경비를 서고 있다.
	<</if>>
<<else>>
	Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> prowl around the outskirts, emerging from and disappearing into the many passages leading away.
<</if>>
<br><br>

중앙에는 여섯 개의 팔과 여섯 개의 날개를 가진 천사의 조각상이 굳건히 서 있다. 천사는 임신하여 배가 불러 보인다.
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif $exposed gte 2>>
	당신은 발소리가 들릴 때마다 가고일 기둥 뒤에 알몸을 숨기며 회랑을 살금살금 돌아다닌다. <<hcSuspicion 2>><<hopelessCycleSus 1>>
	<br><br>

	<b><u>장소:</u></b><br>
	<<templeicon "quarters">><<link [[숙소로 가는 통로 (0:01)|Hopeless Cycle Quarters]]>><<pass 1>><</link>>
	<br>
	<<templeicon "garden">><<link [[정원으로 가는 통로 (0:01)|Hopeless Cycle Garden]]>><<pass 1>><</link>>
	<br>
	<<templeicon>><<link [[대전 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
	<br>
<<elseif !$hc.suspicionRevealed and ($hc.suspicion gte 40 or ($hc.suspicion gte 25 and (Time.hour gte 23 or Time.hour lte 4)))>>
	<<set $hc.suspicionRevealed to true>>

	"<<worldMale 'Brother' 'Sister'>> Fayne." <span class="red">A stern, rumbling voice makes you freeze in place.</span> Heavy, familiar footsteps approach.
	<<if Time.dayState is "night">>
		"이렇게 늦게까지 깨어 있다니. 몰래 돌아다니는 건가?"
	<</if>>
	<br><br>

	당신은 천천히 소리가 나는 쪽으로 몸을 돌린다.
	<<if Time.dayState is "night">>
		<<if hcItemLitTorch()>>
			당신의 횃불에 추한 갈색 수염의 얼굴이 비친다.
		<<else>>
			희미한 횃불 빛이 당신을 감싼다.
		<</if>>
	<</if>>
	주교의 손이 당신 위로 우뚝 솟아오르며, 거대한 손이 당신의 어깨에 놓인다.
	<br><br>

	"We worry for you. Your behaviour as of late has been..." <<worldMale 'He' 'She'>> grins.
	"Unusual. Some confessors suspect that the witch has <<worldFemale 'her' 'his'>> fingers around your soul. I told them to have faith, but our... tolerance... only goes so far."
	<<worldMale 'He' 'She'>> chuckles. "Do not fail us, <<worldMale 'brother' 'sister'>>. Your family. Think about how they would feel if you had to be locked away with <<worldFemale 'her' 'him'>>. Purified with <<worldFemale 'her' 'him'>>."
	<br><br>

	<<worldMale 'He' 'She'>> pats you on the shoulder once more before walking off. <<worldMale 'He' 'She'>> wipes <<worldMale 'his' 'her'>> hand on <<worldMale 'his' 'her'>> tunic, as if touching you made <<worldMale 'him' 'her'>> filthy.
	<br><br>

	<span class="narration">The Bishop's Hand and <<worldMale 'his' 'her'>> confessors had been watching the gaoler. Now that <<worldMale 'he' 'she'>> knew this, <<worldMale 'he' 'she'>> would be more aware of what actions would make them suspicious.</span>
	<br><br>

	<<link [[다음|Hopeless Cycle Cloister]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if Time.hour gte 7 and Time.hour lte 9 and !$hc.daily.sermon>>
		<<templeicon "altar">><<link [[설교에 참석한다 (0:30)|Hopeless Cycle Cloister Sermon]]>><<pass 30>><<trauma -6>><<purity 4>><<hcSuspicion -5 "sermon">><<set $hc.daily.sermon to true>><</link>><<ltrauma>><<gpurity>><<if !$hcChallenge.suspicionSermon>><<hopelessCycleSus -2>><</if>>
		<br>
	<</if>>
	<<if $temple_confessor_intro>>
		<<templeicon "statue">><<link [[비르고의 조각상|Hopeless Cycle Cloister Statue]]>><<set $hcAction to "approach">><</link>>
		<br>
	<<else>>
		<<templeicon "statue">><<link [[여섯 팔의 조각상|Hopeless Cycle Cloister Statue]]>><<set $hcAction to "approach">><</link>>
		<br>
	<</if>>
	<br>
	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<if Time.dayState is "night" and (Time.hour gte 23 or Time.hour lte 5)>>
		<<if $worn.upper.name is "chain tunic" or hcItemLitTorch()>>
			<<if $worn.upper.name is "chain tunic">>
				<span class="red">갑옷 때문에 눈에 띈다.</span>
			<</if>>
			<<if hcItemLitTorch()>>
				<span class="red">불붙은 횃불 때문에 몰래 움직일 수 없다.</span>
			<</if>>
			<br>
		<</if>>
		<<prisonicon "cell">><<link [[지하 감옥으로 몰래 들어간다 (0:02)|Hopeless Cycle Dungeon Sneak]]>><<pass 2>><</link>>
	<<else>>
		사제 한 명이 지하 감옥 계단 꼭대기에서 경비를 서고 있다.
		<br>
		<<prisonicon "cell">><<link [[지하 감옥 <<hcTimeDungeonDisplay>>|Hopeless Cycle Dungeon Enter]]>><</link>>
	<</if>>
	<br>
	<<kitchenicon "soup">><<link [[식당 (0:01)|Hopeless Cycle Cloister Dining]]>><<pass 1>><</link>>
	<br>

	<<templeicon $temple_weapon>><<link [[훈련실 (0:01)|Hopeless Cycle Cloister Training]]>><<pass 1>><</link>>
	<br><br>

	<<templeicon "quarters">><<link [[숙소로 가는 통로 (0:01)|Hopeless Cycle Quarters]]>><<pass 1>><</link>>
	<br>
	<<templeicon "garden">><<link [[정원으로 가는 통로 (0:01)|Hopeless Cycle Garden]]>><<pass 1>><</link>>
	<br>
	<<templeicon>><<link [[대전 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Cloister Training
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "training">>
<<hopelessCycleEffects>>

<<if Time.dayState isnot "night">>
	You enter one of the training rooms, and find your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> sparring. A weapon rack sits at the back of the room, sporting vicious-looking whips and batons.
<<else>>
	훈련실 중 한 곳으로 들어간다. 텅 비어 있다. 낮 동안 험하게 사용됨에도 불구하고, 중앙의 경기장 밖에는 모래 한 알 떨어져 있지 않다. 방 뒤편에는 무기 선반이 놓여 있고, 사나워 보이는 채찍과 곤봉들이 걸려 있다.
	<br><br>
	낮 동안에는 여기서 대련을 할 수 있을 것이다.
<</if>>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if Time.dayState isnot "night">>
		<<if $temple_weapon is "baton">>
			<<templeicon "baton">><<link [[대련한다 <<hcTimeTaskDisplay>>|Hopeless Cycle Spar]]>><<prof baton 4>><<set $temple_spar to 1>><<physique 6>><<tiredness 6>><<hcTimeTaskPass>><<hcSuspicion -1>><<sadism 5>><</link>><<gtiredness>><<gbaton>><<gphysique>><<hopelessCycleSus -1>>
		<<elseif $temple_weapon is "whip">>
			<<templeicon "whip">><<link [[대련한다 <<hcTimeTaskDisplay>>|Hopeless Cycle Spar]]>><<prof whip 4>><<set $temple_spar to 1>><<physique 6>><<tiredness 6>><<hcTimeTaskPass>><<hcSuspicion -1>><<sadism 5>><</link>><<gtiredness>><<gwhip>><<gphysique>><<hopelessCycleSus -1>>
		<</if>>
		<br>
	<</if>>
	<<bathroomicon "soap">><<link [[몸을 씻는다 (0:10)|Hopeless Cycle Cloister Training]]>><<stress -2>><<wash>><<pass 10>><</link>><<lstress>>
	<br><br>

	<<set _itemsHere.push("bandages")>>
	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<templeicon "cloister">><<link [[회랑 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><<endevent>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Spar
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>><<wearProp "whip" "khaki">>

<<generateTemple 1>><<person1>>

One of your <<sister_npc>>s bows to you. A few of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> watch from the sidelines.

<<if $rng gte 51>>
	<<set _npcWeapon to "baton">>
	<<He>>【은는】 곤봉을 휘두른다.
<<else>>
	<<set _npcWeapon to "whip">>
	<<He>>【은는】 채찍을 휘두른다.
<</if>>
<br><br>

<<if $prof.whip gte 1000>>
	교단 내에서는 대사제조차도 채찍술에 있어서는 당신의 상대가 되지 못한다. 싸움은 일방적으로 끝난다.
	<br><br>

	<<if _npcWeapon is "whip">>
		당신은 모든 공격을 능숙하게 피한다. 결국, 당신은 그 움직임을 잘 알고 있다. 모든 미세한 움직임이 당신에게는 뻔히 보인다.
		<br><br>

		당신은 <<him>>【이가】 스스로 지치도록 내버려 둔 뒤, 능숙하게 발을 걸어 싸움을 끝낸다. 그것이 당신의 유일한 공격이었고, 한 번이면 충분했다.
	<<else>>
		당신은 첫 공격으로 <<his>> 손을 정확히 가격한다. 이어서 또 한 번 공격하여 <<him>>의 무장을 해제한다. 마지막으로, 당신은 채찍을 <<his>> 다리에 감아 넘어뜨린다. <<He>>【은는】 단 한 번의 공격도 하지 못했다.
	<</if>>
	<br><br>

	Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> applaud.
<<else>>
	주무기를 든 당신을 이기기는 어렵다.
	<<if _npcWeapon is "whip">>
		<<He>>【은는】 선전하지만, 당신이 훨씬 우월하다. 당신은 몇 대 맞지만, 결정적인 일격에 이은 발걸기로 싸움을 끝낸다.
	<<else>>
		당신은 제대로 한 대 맞지만, 나머지 싸움은 당신 뜻대로 흘러간다. 당신은 채찍을 <<his>> 곤봉에 감아 방 저편으로 날려버리는 데 성공한다.
	<</if>>
	<<pain 2>><<gpain>>
<</if>>
<br><br>

<<link [[다음|Hopeless Cycle Cloister Training]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Cloister Dining
<<set $location to "old_temple">><<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "dining">>
<<hopelessCycleEffects>>
당신은 회랑의 식당에 있다.
<<if Time.dayState is "night">>
	인적이 끊겼다.
<<elseif Time.dayState is "dawn">>
	제법 활기가 있다. 많은 형제자매들이 긴 하루를 준비하고 있다.
<<else>>
	몇몇 형제자매들이 긴 테이블에 앉아 있다.
<</if>>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<else>>
	<<if Time.dayState is "night">>
		<span class="red">음식은 밤새 잠겨 있다.</span>
		<br>
	<<else>>
		<<if !$hc.daily.foodPlayer>>
			<<foodicon "eat">><<link [[식사한다 <<hcTimeTaskDisplay 30>>|Hopeless Cycle Cloister Dining Eat]]>><<hcTimeTaskPass 30>><<set $hc.daily.foodPlayer to true>><<tiredness -6>><<stress -24>><<trauma -12>><</link>><<lltiredness>><<llstress>><<ltrauma>>
			<br>
			<<if hcItemHasFreeHand()>>
				<<foodstufficon "salmon_wellington">><<link [[네 몫을 들고 떠난다|Hopeless Cycle Cloister Dining]]>><<run hcItemAdd({ type: "food", name: "stolen food", location: "held", origin: "dining", dirtyOnDrop: V.hcChallenge.itemDirty })>><<set $hc.daily.foodPlayer to true>><<hcSuspicion 5>><</link>><<hopelessCycleSus 1>>
				<br>
			<</if>>
		<</if>>
		<<if !$hc.daily.foodWitch and hcItemHasFreeHand()>>
			<<hcicon "food">><<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 몫을 챙긴다`|Hopeless Cycle Cloister Dining]]>><<run hcItemAdd({ type: "food", name: "prison gruel", location: "held", origin: "dining", dirtyOnDrop: V.hcChallenge.itemDirty })>><<set $hc.daily.foodWitch to true>><</link>>
			<br>
		<</if>>
		<<if !hcItemHasFreeHand() and (!$hc.daily.foodPlayer or !$hc.daily.foodWitch)>>
			<span class="red">음식을 집으려면 빈손이 필요하다.</span>
			<br>
		<</if>>
	<</if>>
	<br>

	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<templeicon "cloister">><<link [[회랑 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Cloister Dining Eat
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>><<wearProp "spoon">>

You sit with your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> to eat your meal. It's hearty and flavourful.
<br><br>

<<if $hc.nightBreakIn is "tonight">>
	<<set $hc.nightBreakIn to "heard">>
	You overhear some of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> talking.
	<br><br>

	"...gets the witch all to <<worldMale 'himself' 'herself'>>. Aye. <span class="red">Tonight, I think I'll sneak down there and...</span>" You lose the rest in the noise of the hall.
<<else>>
	<<set $hc.chatter ||= []>>
	You overhear some of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> talking.
	<br><br>

	<<cleareventpool>>
	<<if !$hc.chatter.includes("hc_bucket_hint")>>
		<<addinlineevent "hc_bucket_hint">>
			<<set $hc.chatter.pushUnique("hc_bucket_hint")>>
			"망할 양동이들은 다 어디 간 거야?"
			<br>
			"다들 항상 필요로 하면서, 아무도 제자리에 갖다 놓질 않아."
			<br>
			"수련생들 시켜서 다 모아오게 할까?"
			<br>
			"소용없어. 한 시간 안에 또 다 없어질걸. 맹세컨대, 그중 하나가 팔다리가 돋아나 숲으로 기어 들어가는 걸 봤다고."
			<br>
			"머리가 어떻게 된 거냐? 고해 신부들을 불러야겠어?"
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_bed_hint")>>
		<<addinlineevent "hc_bed_hint">>
			<<set $hc.chatter.pushUnique("hc_bed_hint")>>
			"야간 경비는 사람이 있는 침상 밑은 수색할 수 없도록 되어 있어."
			<br>
			"그건 어떻게 알아?"
			<br>
			"몇 달 동안 내 침상 밑에 남는 술을 밀반입했는데, 아무도 뭐라고 안 했거든."
			<br>
			"공짜 협박거리 고맙다."
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_disposal_hint")>>
		<<addinlineevent "hc_disposal_hint" 2>>
			<<set $hc.chatter.pushUnique("hc_disposal_hint")>>
			"다시는 폐기물 처리 수로를 걸을 일이 없어서 다행이야. 난 거기 있는... <i>그것들</i>을 도저히 못 참겠더라고."
			<br>
			"애처럼 징징대기는. 유리손가락 할멈이 널 찾아낼까 봐 무서워? 자장가라도 불러줘?"
			<br>
			"그런 걸로 농담하지 마. 다른 괴물들이랑 똑같은 괴물이라고. 그 녀석은 우리가 내던지는 오염된 쓰레기 덕에 온순하게 유지되고 있을 뿐이야."
			<br>
			"그게 진짜라고 믿으니까 힘을 얻는 거야."
		<</addinlineevent>>
	<</if>>
	<<if $hc.chatter.includes("hc_disposal_hint") and !$hc.chatter.includes("hc_disposal_hint2")>>
		<<addinlineevent "hc_disposal_hint2" 2>>
			<<set $hc.chatter.pushUnique("hc_disposal_hint2")>>
			"폐기물 처리 수로에 직접 내려가 본 적 있어?"
			<br>
			"아니."
			<br>
			"다행인 줄 알아. 거기선 항상 누가 지켜보는 것 같은 기분이 들어. 어둠과, 세차게 흐르는 물소리 때문인가. 나도 모르게 자주 멍하니 서서, 횃불을 수로에 던져버리고 싶은 이상한 충동을 느끼곤 했지."
			<br>
			"아마 널 지켜보는 수호천사가 있는 거겠지."
		<</addinlineevent>>
	<</if>>
	<<if $hc.chatter.includes("hc_disposal_hint2") and !$hc.chatter.includes("hc_disposal_hint3")>>
		<<addinlineevent "hc_disposal_hint3">>
			<<set $hc.chatter.pushUnique("hc_disposal_hint3")>>
			"폐기물 처리 수로에 가서... 횃불을 전부 꺼버린 적 있어? 어둠에 흠뻑 잠겨본 적 있냐고?"
			<br>
			"그래. 한 번. 다시는 안 해."
			<br>
			"겁쟁이 같으니. 난 어둠 속을 두 번이나 들여다봤는데 아무 일도 없었어. 생각을 정리하기 좋은 곳이야."
			<br>
			"사제들에게 보고할 필요도 없겠군. 넌 결국 네 스스로 벌을 받게 될 테니. 세 번째가 진짜라잖아."
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_lake_hint")>>
		<<addinlineevent "hc_lake_hint">>
			<<set $hc.chatter.pushUnique("hc_lake_hint")>>
			"폐기물 처리 수로에 누가 묻혀 있을지도 모른다는 생각 해본 적 있어?"
			<br>
			"방금 전까진 없었어."
			<br>
			"꿈을 꿨어. 저 아래에 뼈들이 있어. 무언가와 다시 합쳐지길 기다리고 있지. 물의 근원으로부터 온 무언가와."
			<br>
			"고해를 너무 많이 들었군. 헛소리를 하고 있잖아."
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_chatter_1")>>
		<<addinlineevent "hc_chatter_1">>
			<<set $hc.chatter.pushUnique("hc_chatter_1")>>
			"최근에 뭐 재미있는 거라도 태웠어?"
			<br>
			"그래, 마녀를 잡았을 때 나무 흉상 몇 개를 발견했지. 각각 모자를 쓰고 있었어. 그것들도 태웠지. 근데 하나는 도망쳤어."
			<br>
			"뭐? '하나가 도망쳤다'니, 그게 무슨 개소리야? 팔다리가 돋아서 기어가기라도 했어?"
			<br>
			대답은 들리지 않는다.
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_chatter_2")>>
		<<addinlineevent "hc_chatter_2">>
			<<set $hc.chatter.pushUnique("hc_chatter_2")>>
			"이젠 흉물들이 거의 없어. 우리가 필요 없어진 것 같은 기분이야."
			<br>
			"경계를 늦추지 마. 놈들은 우리가 방심하기만을 기다리고 있어."
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_chatter_3")>>
		<<addinlineevent "hc_chatter_3">>
			<<set $hc.chatter.pushUnique("hc_chatter_3")>>
			"새로운 대사제님 본 적 있어?"
			<br>
			"No one has seen <<worldMale 'him' 'her'>> much. The Bishop's Hand has taken most of <<worldMale 'his' 'her'>> duties."
			<br>
			"<<worldMale 'King' 'Queen'>> shit-beard's trying to make <<worldMale 'himself' 'herself'>> more important than <<worldMale 'he' 'she'>> is."
			<br>
			"Shut your mouth before I tell <<worldMale 'him' 'her'>> you said that."
		<</addinlineevent>>
	<</if>>
	<<if !$hc.chatter.includes("hc_chatter_4")>>
		<<addinlineevent "hc_chatter_4">>
			<<set $hc.chatter.pushUnique("hc_chatter_4")>>
			"처녀궁의 우상을 계속 쳐다보게 돼."
			<br>
			"걸작이지, 안 그래?"
			<br>
			"혼란스러워. 의도적으로 도발하는 것 같아. 왜 우리가 쳐다보면 안 되는 부분에 그렇게 공을 들여야만 했을까?"
			<br>
			"고해소에 가보는 게 좋겠어."
		<</addinlineevent>>
	<</if>>
	<<addinlineevent "hc_chatter_misc">>
		<<set _lines1 to [
			"우리 갑옷이 좀 더 노출이 심했으면 좋겠어.",
			"과일들이 내게 말을 걸어. 먹어달라고 애원해.",
			"우리 곤봉이 정화 의식에 좋은 도구가 될지 궁금해지네.",
			"수련생들이 순결의 시련을 겪는 걸 보는 게 정말 좋아. 그을음으로 뒤덮인 그들의 발이라니...",
			"우리 대열에 천사가 있어. 지난번 정화는 정말 신성했지. 그 정체를 알아내서 약속의 의식을 거행해야 해."
		]>>
		<<set _lines2 to [
			"부디 회개하십시오.",
			"사제님들께 말씀드리겠습니다.",
			"저는 고해 사제가 아닙니다, 그런 말을 들을 필요는 없습니다.",
			"이것은 당신의 진심이 아닙니다. 참회를 구하십시오."
		]>>
		"<<print _lines1.pluck()>>"
		<br>
		"<<print _lines2.pluck()>>"
		<br>
		그냥 잡담일 뿐이다. 쓸모 있는 내용은 없다.
	<</addinlineevent>>

	<<runeventpool>>
<</if>>
<br><br>

<<link [[다음|Hopeless Cycle Cloister Dining]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Cloister Sermon
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<<generateTemple 1>><<person1>>
You join your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> on the floor.
<br><br>

<<priest>> 한 명이 모두를 이끌고 기도를 시작한다. 당신은 고개를 숙인 채로 있는다.
<br><br>

When the prayers are finished, the Bishop's Hand steps forward and clears <<worldMale 'his' 'her'>> throat.
<<if $hc.daysPassed is 1>>
	"As many of you already know, we have at last captured and imprisoned the witch that was working <<worldFemale 'her' 'his'>> vile magic on the town."
	<br><br>

	모여든 신도들 사이에서 웅성거리는 소리가 들린다.
	<br><br>

	"<<worldFemale 'Her' 'His'>> belongings have been burned. <<worldFemale 'She' 'He'>> will rot in the dungeon until the red moon, when <<worldFemale 'she' 'he'>> will face redemption."
	Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> cheer.
	<br><br>

	"지하 감옥에 출입하는 모든 자는 오염을 막기 위해 전후로 정화 의식을 받아야 한다. 지하 감옥 내의 모든 신도들은 해가 지기 전에 떠나야 한다."
<<elseif $hc.daysPassed is 2>>
	"평신도들이 우리가 마녀를 붙잡은 것에 대해 불만을 표하기 시작했다. 당분간 야간 경비는 내부 순찰에서 외부 순찰로 변경될 것이다."
<<elseif $hc.daysPassed is 5 and !$hcChallenge.dogsEarly>>
	"로밀리 가문의 대표단이 며칠간 우리와 함께 머물게 될 것이다." 신도들 중 몇몇이 웃는다.
	<br><br>

	"그들은 훈련된 사냥개 몇 마리를 우리에게 팔고 싶어 한다. <span class="blue">그들은 해 질 녘까지 매일 신전 부지 내에서 활동할 것이다.</span> 소음에 익숙해지도록."
<<elseif $hc.daysPassed is 6 and !$hcChallenge.waterEarly>>
	<<set $hc.wellTainted to true>>
	"우물은 붉은 달이 뜬 이후까지 사용을 금한다. <span class="red">우물물이 오염되었다.</span>" 신도들 사이에서 웅성거림이 이어진다.
	<br><br>

	"걱정할 것 없다. <span class="blue">그때까지 깨끗한 물은 호수에서 길어와야 한다.</span>"
<<elseif Time.lastDayOfMonth is $hc.day>>
	"All members of the flock are to prepare for tonight's ritual. The witch's gaoler will bring <<worldFemale 'her' 'him'>> to the altar come nightfall."
	<br><br>

	신도들이 웅성거리며 소란스러워진다.
	<br><br>

	"비르고께서 우리와 함께하신다. 믿음을 가져라."
<<else>>
	<<cleareventpool>>

	<<addinlineevent "hc_sermon_1">>
		"All <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> are to remember that the statue of Virgo is not to be molested. It is a trial of your faith like any other."
	<</addinlineevent>>
	<<addinlineevent "hc_sermon_2">>
		"오퀸 가문이 엘크시드 교단과 결탁했다는 소문은 즉시 잠재워야 한다. 이것은 민감한 문제다."
	<</addinlineevent>>
	<<addinlineevent "hc_sermon_3">>
		"모든 신도들은 즉시 호수에서의 여가 시간을 갖는 것을 금한다."
	<</addinlineevent>>
	<<addinlineevent "hc_sermon_4">>
		"마지막으로 말하지만, 처리 수로에는 괴물이 없다. 다들 어린애인가?"
	<</addinlineevent>>

	<<runeventpool>>
<</if>>
<br><br>

공지가 끝나자 신도들은 흩어진다. 일부는 식당으로 향하고, 다른 이들은 훈련실이나 정원으로 걸어간다.
<br><br>

<<link [[다음|Hopeless Cycle Cloister]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Cloister Statue
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set $temple_burden to Math.clamp($temple_burden, 0, 50)>>
<<if $hcAction is "approach">>
	<<if $temple_confessor_intro>>
		당신은 비르고의 조각상에 다가간다.
	<<else>>
		당신은 조각상에 다가간다.
	<</if>>
	대리석으로 만들어진 것 같다. 배 부분은 당신의 형제자매들이 행운을 빌며 문질러서 변색되어 있다.
	날개는 넓게 펼쳐져 있고, 가운데 팔은 사랑스러운 포옹으로 누군가를 환영하려는 듯 열려 있다.
	<br><br>

	You feel as though this gesture is aimed at all of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>>. A rapturous thanks for a great sacrifice made. <span class="green">The arrow of time has skipped midnight, for now.</span>
	<br><br>
<</if>>
<<unset $hcAction>>

<<if !$hcChallenge.faithBurden>>
	<<if $temple_burden lt 50>>
		<<templeicon "statue">><<link [[껴안는다 (0:05)|Hopeless Cycle Cloister Statue]]>><<pass 5>><<set $itemAction to "embrace">><<set $temple_burden += 5>><</link>>
		<br>
	<</if>>
	<<if $temple_burden gte 1>>
		<<templeicon "statue">><<link [[굴복한다 (0:05)|Hopeless Cycle Cloister Statue]]>><<pass 5>><<set $itemAction to "surrender">><<set $temple_burden -= 5>><</link>>
		<br>
	<</if>>
	<br>
<</if>>

<<templeicon "cloister">><<link [[떠난다|Hopeless Cycle Cloister]]>><</link>>
<br>

/* Main Hall */

:: Hopeless Cycle Temple
<<set $location to "old_temple">><<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "temple">>
<<hopelessCycleEffects>>
<<switch $hcAction>>
	<<case "pray">>당신은 신앙을 회복하기 위해 한 시간 동안 기도한다.
	<<case "mass">>당신은 다른 신도들 사이에서 미사에 참석한다. 주교의 선율 같은 목소리가 당신을 소속감에 젖어 들게 한다. 교단에 대한 당신의 신앙이 크게 회복된다.
	<<default>>당신은 신전의 중앙 홀에 있다. 돌벽과 기둥들이 어둠 속으로 높이 솟아 있다. 방 끝에 있는 제단을 향해 좌석들이 줄지어 있다.
<</switch>>
<<unset $hcAction>>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[<<print window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥으로 들어간다|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif $hc.suspicion gte 100>>
	<span class="red">머리에 자루가 씌워지면서 시야가 어두워진다.</span> 갑자기 복부를 가격당해 몸이 반으로 접힌다. 강제로 무릎을 꿇게 된다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해진 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif $exposed gte 2>>
	당신은 <<nudity>>【을를】 가리기 위해 기둥 중 하나 뒤에 숨는다.<<print _nudityExtra>> <<hcSuspicion 2>><<hopelessCycleSus 1>>
	<br><br>

	<b><u>장소:</u></b><br>
	<<templeicon "cloister">><<link [[회랑 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br><br>

	<<templeicon "garden">><<link [[정원 (0:01)|Hopeless Cycle Garden]]>><<pass 1>><</link>>
	<br>
	<<templeicon "quarters">><<link [[막사 (0:01)|Hopeless Cycle Quarters]]>><<pass 1>><</link>>
	<br>
<<elseif $hc.daysPassed gte 4 and Time.dayState is "day" and !$hc.bailiff>>
	<<set $hc.bailiff to true>>
	<<generate1>><<person1>>
	주교의 대리인이 누군가와 이야기하는 소리가 들린다. 모퉁이를 돌자, 세 명의 경호원을 대동한 갑옷 차림의 <<personsimple>>【이가】 보인다.
	<br><br>

	당신은 <<his>> 문장을 알아본다. 저울을 감싸고 있는 뱀. 베일리 가문이다. 당신은 엿듣는다.
	<br><br>

	"...즉시 우리에게 인도하시오." <<He>>【이가】 권위적으로 말하며 대리인을 가리킨다. "당신들은 우리 재산을 압류할 근거가 없었소."
	<br><br>

	"여기 그런 이름은 없소." 대리인이 씩 웃으며 말을 끊는다. "천사를 찾고 있다면, 우리와 함께 기도하는 건 환영이오."
	<br><br>

	<<personsimple>>【이가】 얼굴을 찌푸린다. "당신들은 당신들이 처벌한다고 주장하는 이교도들과 다를 바 없군. 우리는 무력을 사용할 준비가 되어 있소."
	<br><br>

	The Hand lets out a belly laugh. "You're welcome to try." <<worldMale 'He' 'She'>> leans in, prompting each bodyguard to draw a sword. "We have plenty of empty cells and eager whips."
	<br><br>

	<<personsimple>>【이가】 한 걸음 물러선다. "야만인들." <<He>>【이가】 떠나려고 돌아선다. "우리는 다시 올 것이오."
	<br><br>

	"You won't," the Hand says under <<worldMale 'his' 'her'>> breath.
	<br><br>

	<<link [[다음|Hopeless Cycle Temple]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if Time.weekDay is 1 and Time.hour gte 10 and Time.hour lte 12 and $hc.daily.massAttended isnot 1 and $exposed lte 0>>
		<<templeicon "altar">><<link [[미사 참석 (1:00)|Hopeless Cycle Temple]]>><<set $hcAction to "mass">><<pass 60>><<set $hc.daily.massAttended to 1>><<stress -100>><<trauma -50>><</link>><<lllstress>><<llltrauma>>
		<br>
	<<else>>
		<<templeicon "pray">><<link [[기도한다 (1:00)|Hopeless Cycle Temple]]>><<set $hcAction to "pray">><<pass 60>><<stress -2>><<trauma -6>><</link>><<lstress>><<ltrauma>>
		<br>
	<</if>>
	<br>

	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<templeicon "cloister">><<link [[회랑 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br><br>

	<<templeicon "garden">><<link [[정원 (0:01)|Hopeless Cycle Garden]]>><<pass 1>><</link>>
	<br>
	<<templeicon "quarters">><<link [[막사 (0:01)|Hopeless Cycle Quarters]]>><<pass 1>><</link>>
	<br>
	<<templeicon "prayer room">><<link [[기도실 (0:01)|Hopeless Cycle Prayer Room]]>><<set $hcAction to "enter">><<pass 1>><</link>>
	<br>
<</if>>

/* Garden */

:: Hopeless Cycle Garden
<<set $location to "old_temple">><<set $outside to 1>><<set _thermoDisable to true>><<effects>><<set $bus to "garden">>
<<hopelessCycleEffects>>

당신은 신전 정원에 있다. 꽃들이 줄지어 신전 본관에서부터 뻗어 나가, 숲에 가까워질수록 점점 더 제멋대로 자라 있다. 신전 부지가 어디서 끝나고 숲이 어디서 시작되는지 불분명하다.

<<if Time.dayState is "dawn">>
	Sunlight bleeds through the branches of trees. Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> tend to a bed of hot coals.
	<<if $hc.dogs>>
		작은 개집이 설치되어 있다. 개들이 하루를 시작하며 깨어나고 있다.
	<</if>>
<<elseif Time.dayState is "day">>
	The sun gleams above a curtain of trees. Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> tend to a bed of hot coals.
	<<if $hc.dogs>>
		작은 개집이 설치되어 있고, 로밀리 가문의 대표자들이 훈련된 사냥개들을 뽐내고 있다.
	<</if>>
<<elseif Time.dayState is "dusk">>
	The trees sway in the wind. Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> prepare for this evening's pyre.
	<<if $hc.dogs>>
		작은 개집이 설치되어 있다. 개들이 조용해졌다.
	<</if>>
<<elseif Time.dayState is "night">>
	거의 칠흑같이 어둡다.
	<<if Time.hour gte 20 or Time.hour lte 2>>
		저 멀리 커다란 장작더미가 불타고 있다.
	<<else>>
		밤사이 타다 남은 장작더미가 근처에서 연기를 피우고 있다.
	<</if>>
<</if>>
<<if Time.dayState isnot "night" or hcItemLitTorch()>>
	<br>
	<<if Time.dayState is "night">>
		<span class="orange">횃불이 밤을 밝힌다.</span>
		<br>
	<</if>>
	이곳에 우물이 있다.
	<<set _canSee to true>>
<<else>>
	<br>
	<span class="red">너무 어두워서 우물 근처의 아무것도 볼 수 없거나, 정원에서 일할 수 없다.</span>
<</if>>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch here at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[<<print window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥으로 들어간다|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해진 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif $exposed gte 2>>
	당신은 <<nudity>>【을를】 가리기 위해 울타리 뒤에 숨는다.<<print _nudityExtra>> <<hcSuspicion 2>><<hopelessCycleSus 1>>
	<br><br>

	<b><u>장소:</u></b><br>
	<<wolficon>><<link [[신전 본당 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
	<br>
	<<templeicon "cloister">><<link [[회랑으로 가는 통로 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br>
	<<foresticon>><<link [[숲 (0:10)|Hopeless Cycle Forest]]>><<set $hcForest to 0>><<pass 10>><</link>>
	<br>
<<elseif $hc.daysPassed gte 6 and !$hc.wellTainted and _canSee>>
	<<set $hc.wellTainted to true>>
	<<generateTemple 1>><<person1>>
	당신의 <<sister_npc>> 중 한 명이 우물가에 서서 어리둥절한 표정을 짓고 있다. 당신이 다가가자 <<He>>【이가】 손을 흔든다.
	<<if Time.dayState is "night">>
		<<He>> holds a torch of <<his>> own. "Hail, <<worldMale 'brother' 'sister'>>. It seems we're both troubled tonight."
	<<else>>
		"Hail, <<worldMale 'brother' 'sister'>>. We face troubles."
	<</if>>
	<br><br>

	<<He>>【은는】 물이 가득 담긴 양동이를 가리킨다. <span class="red">물에는 붉은색과 보라색 빛깔이 섞여 있다.</span>
	"우리 우물물이 상했네. 불길한 징조야."
	<br><br>

	<<He>>【은는】 고개를 젓는다. "붉은 달이 지나가면 모든 것이 다시 괜찮아질 걸세. 그때까지, <span class="blue">우리는 호수에서 물을 길어와야 하네.</span>"
	<br><br>

	<<link [[다음|Hopeless Cycle Garden]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if _canSee>>
		<<set _itemsHere.push("water")>>
		<<if $prisonerEvents.includes("brand")>>
			<<set _itemsHere.push("herbs")>>
		<</if>>
		<<templeicon "garden">><<link [[정원에서 일하기 <<hcTimeTaskDisplay>>|Hopeless Cycle Garden Work]]>><<hcTimeTaskPass>><<stress -6>><<hcSuspicion -1>><<tiredness 6>><<tending 1>><</link>><<lstress>><<gtending>><<hopelessCycleSus -1>><<gtiredness>>
		<br>
	<</if>>
	<<if $hc.dogs and Time.dayState is "day">>
		<br>
		사냥개들이 나와 돌아다니고 있다.
		<<if $hc.dogs.includes("loud")>>
			<<if $hc.dogs.count("loud") gt 1>>
				<span class="pink">그들 중 <<number $hc.dogs.count("loud")>>마리가 주인에게 방치된 듯 유난히 시끄럽게 짖고 있다.</span>
				식당에서 가져온 음식을 주면 한 마리를 조용히 시킬 수 있을지도 모른다. 아니면 가지고 놀 만한 것을 찾아볼 수도 있다.
			<<else>>
				<span class="pink">그들 중 한 마리가 주인에게 방치된 듯 유난히 시끄럽게 짖고 있다.</span>
				식당에서 가져온 음식을 주면 조용히 시킬 수 있을지도 모른다. 아니면 가지고 놀 만한 것을 찾아볼 수도 있다.
			<</if>>
		<<else>>
			<span class="green">가장 시끄럽게 짖던 사냥개<<= $hcChallenge.dogsDouble ? "들" : "가">> 조용해졌다.</span>
		<</if>>
		<br>
		<<set _stick to hcItemCanReach("torch", t => t.state isnot "lit")>>
		<<set _food to hcItemsOnScreen(f => f.type is "food" and !f.name isnot "stolen fruit" and !f.used and !f.dirty)>>
		<<for _i to 0; _i lt $hc.dogs.length; _i++>>
			<<capture _i, _food, _f>>
				<<if $hc.dogs[_i] is "loud">>
					<<if _stick>>
						<<animalicon "dog">><<link [[`${hcTranslateName(_stick.state)} 횃불로 줄다리기 놀이하기 (0:15)`|Hopeless Cycle Garden Dog Play]]>><<set $phase to _i>><<pass 15>><</link>>
						<br>
					<</if>>
					<<if _food>>
						<<for _f range _food>>
							<<hcicon _f>><<link [[`${hcTranslateName(_f.name)}【을를】 먹이로 주기 (0:05)`|Hopeless Cycle Garden Dog Feed]]>><<set $phase to _i>><<pass 5>><<set $hcDogFood to _f.name>><<run hcItemRemove(_f)>><</link>>
							<br>
						<</for>>
					<</if>>
				<<else>>
					<<animalicon "dog">><<link [[개를 쓰다듬는다 (0:05)|Hopeless Cycle Garden]]>><<set $hc.dogsTimer[_i]++>><<pass 5>><<stress -3>><<set $itemAction to "petTheDog">><</link>><<lstress>>
					<br>
				<</if>>
			<</capture>>
		<</for>>
	<</if>>
	<br>

	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<if Time.dayState is "night">>
		<<lakeicon "campfire">><<link [[장작더미에 접근한다|Hopeless Cycle Pyre]]>><<set $hcAction to "approach">><</link>>
		<br><br>
	<<else>>
		<<templeicon "trial">><<link [[석탄 화로에 접근한다|Hopeless Cycle Pyre]]>><<set $hcAction to "approach">><</link>>
		<br><br>
	<</if>>
	<<wolficon>><<link [[신전 본당 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
	<br>
	<<templeicon "cloister">><<link [[회랑으로 가는 통로 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br>
	<<foresticon>><<link [[숲 (0:10)|Hopeless Cycle Forest]]>><<set $hcForest to 0>><<pass 10>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Garden Dog Play
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set _stick to hcItemCanReach("torch", t => t.state isnot "lit")>>

당신은 <<print hcTranslateName(_stick.state)>> 횃불의 윗부분을 잡고, 아랫부분을 개에게 내민다. 개는 즉시 활기를 띠며 입으로 그것을 물어뜯는다.
<br><br>

<<if $rng gte 51>>
	개가 생각보다 힘이 세다. 당신의 손아귀에서 횃불을 빼앗아 달아난다! 당신은 신전 부지를 돌며 개를 쫓는다.
	조련사들은 매우 즐거워 보인다. <<physique 2>><<stress -3>><<tiredness 2>><<lstress>><<gtiredness>>
	<br><br>

	당신은 결국 개를 따라잡고, 짧은 줄다리기 놀이를 한다.
<<else>>
	당신이 횃불을 두고 싸우는 동안 개의 꼬리가 흔들린다. 조련사들은 개를 바쁘게 두는 데 도움이 되는 것을 개의치 않는 것 같다.
<</if>>
<br><br>

놀이가 끝나자 개가 드러눕는다. 당신은 개의 배를 문질러준다. 그러면 개가 조용히 있을 것이다.
<br><br>

<<link [[다음|Hopeless Cycle Garden]]>><<set $hc.dogs[$phase] to "quiet">><<set $hc.dogsTimer[$phase] to 5>><</link>>
<br>

:: Hopeless Cycle Garden Dog Feed
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

당신은 <<print hcTranslateName($hcDogFood)>>【을를】 개 앞에 놓는다. 개는 활기를 띠며 즉시 먹기 시작한다.
<br><br>

<<if $hcDogFood is "prison gruel">>
	개는 음식의 질을 전혀 신경 쓰지 않는 것 같다.
<<else>>
	아마 개가 먹어본 것 중 최고의 음식일 것이다.
<</if>>
<br><br>

조련사 중 한 명이 당신을 보고는 <<= $hcDogFood is "prison gruel" ? "그릇" : "접시">>【을를】 집어 들며 당신을 쫓아낸다. 이것으로 개가 조용해지기를 바란다.
<br><br>

<<link [[다음|Hopeless Cycle Garden]]>><<set $hc.dogs[$phase] to "quiet">><<set $hc.dogsTimer[$phase] to 5>><<unset $hcDogFood>><</link>>
<br>

:: Hopeless Cycle Garden Work
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

당신은 정원에서 한 시간 동안 일한다. 사용할 양동이가 더 없다는 사실에 한탄한다.
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[<<print window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥으로 들어간다|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.suspicion gte 100>>
	<span class="red">머리에 자루가 씌워지면서 시야가 어두워진다.</span> 곧 재빨리 복부를 가격당해 몸이 반으로 접힌다. 강제로 무릎을 꿇게 된다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해진 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<else>>
	<<if Time.dayState isnot "night" or hcItemLitTorch()>>
		<<link [[계속 일하기 <<hcTimeTaskDisplay>>|Hopeless Cycle Garden Work]]>><<hcTimeTaskPass>><<stress -6>><<hcSuspicion -1>><<tiredness 6>><<tending 1>><</link>><<lstress>><<gtending>><<hopelessCycleSus -1>><<gtiredness>>
		<br>
	<<else>>
		<span class="red">너무 어두워서 정원에서 계속 일할 수 없다.</span>
		<br>
	<</if>>

	<<link [[일을 그만둔다|Hopeless Cycle Garden]]>><<endevent>><</link>>
	<br>
	<<set _loc to hcItemHasFreeHand() ? "held" : "garden">>
	<<capture _loc>>
		<<link [[과일을 훔친다|Hopeless Cycle Garden]]>><<run hcItemAdd({ type: "food", name: "stolen fruit", location: _loc, origin: "garden", dirty: 0, dirtyOnDrop: true })>><<endevent>><<hcSuspicion 5>><</link>><<hopelessCycleSus 1>>
		<br>
	<</capture>>
<</if>>

:: Hopeless Cycle Pyre
<<set $location to "old_temple">><<set $outside to 1>><<set _thermoDisable to true>><<effects>><<set $bus to "pyre">>
<<hopelessCycleEffects>>당신은 탁 트인 신전 부지에 있다.
<<if Time.dayState is "night">>
	<<if $hcAction is "approach">>
		당신은 장작더미에 다가간다.
		<<if Time.hour gte 20 or Time.hour lte 2>>
			<<worldMale 'Brothers' 'Sisters'>> and <<worldFemale 'sisters' 'brothers'>> in black robes greet you as they commit tainted items to the blaze.
		<<else>>
			남은 것들이 연기를 내며 타고 있지만, 횃불에 다시 불을 붙이기에는 충분할 것이다.
		<</if>>
	<</if>>
	<<if Time.hour gte 20 or Time.hour lte 2>>
		<<set _itemsHere.push("fire")>>
	<</if>>
	<<set _canIgnite to true>>
	<<unset $hcAction>>
	<br><br>
<<else>>
	<<if ["dawn","day"].includes(Time.dayState)>>
		<<set _canIgnite to true>>
		몇몇 수련자들이 숯불을 돌보고 있다. 가끔 누군가 그 위를 걸어가려 시도한다.
		<br><br>

		<<if !$hc.daily.trialOfPurity>>
			<<link [[순결의 시련에 도전하기 <<hcTimeTaskDisplay>>|Hopeless Cycle Firewalk]]>><<hcTimeTaskPass>><<set $hc.daily.trialOfPurity to true>><</link>><<gwillpower>><<hopelessCycleSus -1>>
			<br>
		<</if>>
	<<else>>
		Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> prepare for this evening's pyre.
		<br>
	<</if>>
<</if>>
<br>

<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
<b><u>장소:</u></b><br>
<<templeicon "garden">><<link [[정원|Hopeless Cycle Garden]]>><</link>>
<br>

:: Hopeless Cycle Firewalk
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<<if !$hc.firewalk>>
	<<set $hc.firewalk to 1>><<set $fire to 1>>

	<<monk>>【와과】 수련자들이 숯이 달아오르는 것을 지켜본다. 곧 숯이 붉게 빛난다. 수련자들은 삽을 들어 맨 위의 숯을 흙 위로 밀어낸다. 곧 불이 당신의 발 옆에 얇은 직사각형 모양으로 퍼진다.
	<br><br>

	<<feetstrip>>

	숯에서 연기가 피어오른다. 당신은 깊은 숨을 들이쉬고 그 위로 발을 내딛는다. 따뜻하다.
	<br><br>

	<<templeicon "trialcontinue">><<link [[계속한다|Hopeless Cycle Firewalk]]>><<set $hc.firewalk++>><</link>><<gpain>>
	<br>
<<elseif $hc.firewalk gte 6>>
	<<unset $fire>>
	마지막 걸음을 내딛는다. 아프지만, 건너왔다.
	<<pain 6>>
	<br><br>

	The initiates applaud, along with several of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> standing on a balcony back at the temple, watching over the hedge. You examine your soles. They're covered in soot, but not burnt at all.
	<<hcSuspicion -5>><<hopelessCycleSus -2>>
	<br><br>

	<<clotheson>>
	<<endevent>>
	<<link [[다음|Hopeless Cycle Pyre]]>><<run delete $hc.firewalk>><</link>>
	<br>
<<else>>
	<<switch $hc.firewalk>>
		<<case 1>>
			앞으로 나아간다. 발밑에서 숯이 뜨거워지는 것을 느낀다.
			<<pain 1>>
		<<case 2>>
			다시 앞으로 나아간다. 숯이 훨씬 더 뜨거워졌다.
			<<pain 2>>
		<<case 3>>
			다시 앞으로 나아가, 이제 숯불 길의 절반쯤 건넜다. 열기는 계속해서 강해진다.
			<<pain 3>>
		<<case 4>>
			발을 다시 내디딜 때 긴장한다. 숯은 이제 더욱 뜨거워졌다.
			<<pain 4>>
		<<case 5>>
			다시 발을 내딛는다. 거의 다 왔다.
			<<pain 5>>
	<</switch>>
	<br><br>

	<<if (currentSkillValue('willpower') / 10) gte ((100 - Math.floor($purity / 10)) + random(1, 100))>>
		<span class="green">계속 나아간다.</span><<gwillpower>><<willpower 1>><<hcSuspicion -1>><<hopelessCycleSus -1>>
		<<set _success to true>>
	<<else>>
		<span class="red">발이 타는 듯한 느낌이 든다. 당신은 숯불에서 뛰어내려 차가운 흙 위로 올라선다.</span><<ggwillpower>><<willpower 10>>
	<</if>>
	<br><br>

	<<if _success>>
		<<templeicon "trialcontinue">><<link [[계속한다|Hopeless Cycle Firewalk]]>><<set $hc.firewalk++>><</link>><<gpain>>
		<br>
	<</if>>
	<<templeicon "trialbail">><<link [[뛰어내린다|Hopeless Cycle Firewalk Jump]]>><<run delete $hc.firewalk>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Firewalk Jump
<<set _thermoDisable to true>><<effects>><<unset $fire>>
<<hopelessCycleEffects>>

당신은 불에서 뛰어내린다. 차가운 흙이 발에 닿는 느낌이 아주 좋다.
<br><br>

<<clotheson>>
<<endevent>>
<<link [[다음|Hopeless Cycle Pyre]]>><</link>>
<br>

/* Forest */

:: Hopeless Cycle Forest
<<set $location to "forest">><<set $outside to 1>><<set _thermoDisable to true>><<effects>><<set $bus to "forest">>
<<hopelessCycleEffects>>
<<if $hcForest lte 0>>
	당신은 숲의 외곽에 있다. 예전에는 정기적으로 신전의 정원까지 숲이 우거졌었다.
<<else>>
	당신은 자연에 둘러싸인 숲 속에 있다.
<</if>>
<br><br>

<<if $hcForest lte 0>><div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div><</if>>
<b><u>장소:</u></b><br>

<<if $hcForest gte 25>>
	<<lakeicon>><<link [[호수 (0:10)|Hopeless Cycle Lake]]>><<pass 10>><</link>>
	<br><br>
<</if>>

<<if $hcForest lt 25>>
	<<getinicon>><<link [[숲 속 깊이 들어간다 (0:10)|Hopeless Cycle Forest]]>><<pass 10>><<hcForest "forward">><</link>>
	<br>
<</if>>
<<if $hcForest gt 0>>
	<<getouticon>><<link [[신전 방향으로 이동한다 (0:10)|Hopeless Cycle Forest]]>><<pass 10>><<hcForest "back">><</link>>
	<br>
<</if>>

<<if between($hcForest, 15, 19) and $hc.forestPassage>>
	이곳에는 처리 수로와 합쳐지는 자연 동굴이 있다.
	<<if $hc.forestPassage and $hc.shortcutCount isnot undefined>>
		<br>
		<<if $hc.shortcutCount gt 1>>
			처리 수로로 가는 지름길을 이용할 수 있는 허가를 <span class="blue"><<number $hc.shortcutCount>></span>번 받은 것 같다. 더 받았다고 느낀다.
		<<elseif $hc.shortcutCount is 1>>
			처리 수로로 가는 지름길을 <span class="blue">한</span> 번 더 이용할 수 있는 허가를 받은 것 같다.
			<span class="pink">이곳으로 돌아올 수 없을 것이다. 편도 여행이 될 것이다.</span>
		<<else>>
			처리 수로로 가는 지름길을 이용할 <span class="red">허가가 없는</span> 것 같다.
		<</if>>
	<</if>>
	<<if hcItemLitTorch()>>
		<br>
		<<if $hcChallenge.forestNoShortcut and !$hc.shortcutCount>>
			<<sewericon>><<link [[처리 수로로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 5>><</link>>
		<<else>>
			<<sewericon>><<link [[처리 수로로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 20>><<set $hcForest to 0>><</link>>
		<</if>>
	<<else>>
		<span class="red">이곳을 지나가려면 횃불이 필요하다.</span>
	<</if>>
	<br>
<<elseif between($hcForest, 15, 19) and !$hc.forestPassage>>
	<<if hcItemLitTorch()>>
		<<set $hc.forestPassage to true>>
		<br>
		횃불 빛으로 동굴 입구를 발견한다.
		<span class="gold">처리 수로로 이어지는 것 같다.</span>
		<br>
		<<if $hcChallenge.forestNoShortcut and $hc.shortcutCount lt 1>>
			<<sewericon>><<link [[처리 수로로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 5>><</link>>
		<<else>>
			<<sewericon>><<link [[처리 수로로 가는 통로 (0:20)|Hopeless Cycle Shortcut]]>><<pass 20>><<set $hcForest to 0>><</link>>
		<</if>>
		<br>
	<<elseif !$hc.forestHint>>
		<<set $hc.forestHint to true>>
		무언가의 형태를 알아볼 수 있지만, 어둠 속으로 이어진다.
		<span class="blue">횃불이 있다면 무엇인지 알 수 있을지도 모른다.</span>
		<br>
	<</if>>
<<elseif $hcForest lte 0>>
	<<templeicon "garden">><<link [[신전 정원 (0:10)|Hopeless Cycle Garden]]>><<pass 10>><<set $hcForest to 0>><</link>>
	<br>
<</if>>

/* Lake */

:: Hopeless Cycle Lake
<<set $location to "lake">><<set $outside to 1>><<set _thermoDisable to true>><<effects>><<set $bus to "lake">>
<<hopelessCycleEffects>>당신은 호수에 있다. 혼자서 이렇게 멀리 오는 것은 현명하지 않다.
<br><br>

<<set _itemsHere.push("water")>>

<<set _bones to hcItemCanReach("bones")>>
<<if _bones>>
	<<capture _bones>>
		<<hcicon "bones">><<link [[호수에 뼈를 던진다|Hopeless Cycle Wraith]]>><<run hcItemRemove(_bones)>><</link>>
		<br><br>
	<</capture>>
<</if>>

<<if !$hc.lakeBucket>>
	<span class="gold">여기에 양동이가 있다. 신전에서 온 것 같다.</span>
	<br>
	<<if hcItemHasFreeHand()>>
		<<hcicon "bucket">><<link [[가져간다|Hopeless Cycle Lake Bucket]]>><<set $hc.lakeBucket to true>><</link>>
		<br>
	<</if>>
	<br>
<</if>>

<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
<b><u>장소:</u></b><br>

<<lakeicon>><<link [[숲 (0:10)|Hopeless Cycle Forest]]>><<set $hcForest to 25>><<pass 10>><</link>>
<br>

:: Hopeless Cycle Lake Bucket
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

당신은 양동이를 집어 든다.
<<if $settings.tentaclesEnabled>>
	<span class="red">끈적한 팔다리 뭉치가 튀어나와 당신의 머리를 감싼다!</span> <<stress 24>><<ggstress>>
	<br><br>

	안에서 수많은 눈이 당신을 노려본다.
	<br><br>

	<<link [[다음|Hopeless Cycle Lake Bucket Tentacles]]>><<set $molestationstart to 1>><</link>>
	<br>
<<else>>
	안을 들여다본다.
	<br><br>

	바닥에서 거대한 눈이 당신을 노려본다. <<ggtrauma>><<trauma 24>><<bodyliquid "face" "goo" 2>>
	<br><br>

	당신은 풀밭에 누워 있다. 눈이 이상하게 느껴진다. 양동이가 당신의 얼굴 위에 씌워져 있다. 안에는 아무것도 없다.
	<br><br>

	<<link [[다음|Hopeless Cycle Lake]]>><<pass 10>><<run hcItemAdd({ type: "container", name: "bucket", location: "held", origin: "garden", persists: true, containerID: "gardenBucket2", capacity: 3 })>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Lake Bucket Tentacles
<<set _thermoDisable to true>>

<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<set $combat to 1>>
	<<set $enemytype to "tentacles">>
	<<molested>>
	<<controlloss>>
	<<tentaclestart 5 15>>
<</if>>
<<statetentacles>>

<<effects>>
<<effectstentacles>>
<<tentacles>>
<<actionstentacles>>

<<if $tentacles.active lte ($tentacles.max / 2)>>
	<span id="next"><<link [[다음|Hopeless Cycle Lake Bucket Tentacles Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Hopeless Cycle Lake Bucket Tentacles]]>><</link>></span><<nexttext>>
<</if>>

:: Hopeless Cycle Lake Bucket Tentacles Finish
<<effects>>

당신은 촉수 하나를 잡고, 다른 손으로 양동이의 가장자리를 잡고 당긴다.
당신은 꿈틀거리는... 무언가의 덩어리를 뽑아낸다. 하급 흉물이다. 껍데기를 빼앗긴 그것은 꿈틀거리며 촉수로 몸을 끌고 숲 속으로 도망친다.
<br><br>

<span class="gold">당신은 의기양양하게 새 양동이를 차지한다.</span>
<br><br>

<<clotheson>>
<<endcombat>>

<<link [[다음|Hopeless Cycle Lake]]>><<run hcItemAdd({ type: "container", name: "bucket", location: "held", origin: "garden", persists: true, containerID: "gardenBucket2", capacity: 3 })>><</link>>
<br>

:: Hopeless Cycle Wraith
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<if $hc.trueEndAvailable>>
	<span class="narration">
		호수에 대한 많은 이야기가 있다. 켈트족 사이에서 인기 있는 이야기 중 하나는 '로흐 블라이힌의 밴시'에 대한 것이다. 이 요정 같은 정령은 징조를 예언하거나, 잃어버린 가족을 위해 통곡하거나, 어떤 이야기에서는 소원을 들어주기도 했다.
		<br><br>

		뼈 자체는 추측의 대상이다. 어떤 사람들은 그것이 정령의 후손 중 한 명의 것이거나, 정령이 한때 저주했던 누군가의 것이라고 말한다.
	</span>
	<br><br>

당신은 도움닫기를 하여 호수 멀리 뼈를 던진다. 물결치는 소리가 주위에 메아리친다. 부드러운 안개가 피어올라 공터를 감싼다.
	<br><br>

	당신이 모르는 언어로 된 노래가 들린다. 황홀하다. 당신은 무의식적으로 호수를 향해 한 걸음 더 내딛는다. 수면은 계속해서 물결친다.
	하얀 옷을 입은 아름다운 창백한 형체가 천천히 나타난다. 커다란 푸른 보석이 박힌 목걸이가 목을 장식하고 있다. 그것은 물 위를 미끄러지듯 당신을 향해 다가온다.
<<else>>
	당신은 도움닫기를 하여 호수 멀리 뼈를 던진다.
	<br><br>

	기다린다. 아무 일도 일어나지 않는다.
	<br><br>

	떠나려고 돌아선다. 목소리가 들린다.
<</if>>
<br><br>

<<link [[귀 기울인다|Hopeless Cycle Wraith 2]]>><</link>>
<br>

:: Hopeless Cycle Wraith 2
<<set _thermoDisable to true>><<effects>>

<<if $hc.trueEndAvailable>>
	"<span class="wraith">Clever gaoler, <<worldMale 'son' 'daughter'>> of the west moors. What yearning brings you before me?</span>"
	<br><br>

	그것은 당신 주위를 원을 그리며 떠다니면서 당신을 살핀다. 목걸이를 꼭 쥔다.
	"<span class="wraith">그대 자신을 내게 빌려주오. 그대를 통해 풍요로운 공기를 숨 쉬게 해 주오. 그대의 뛰는 심장의 온기를 내게 선물하면, 내가 그대의 욕망으로 이끌어 주리라.</span>"
	그것이 창백한 손을 당신에게 내민다.
	<br><br>

	<<link [[손을 잡는다|Hopeless Cycle Wraith 3]]>><</link>>
	<br>
	<<link [[거절한다|Hopeless Cycle Wraith Refuse]]>><</link>>
	<br>
<<else>>
	"<span class="wraith">영리한 간수여. 아직 이것은 나의 이야기가 아니로다. 그대의 심장은 준비되지 않았도다.
	그대 앞에 놓인 모든 고난을 느끼라. 모든 희망을 잃을 때까지 운명에 맞서라. 오직 그때에야, 내게 돌아와 이 행위를 반복하라.</span>"
	<br><br>

	<<link [[다음|Hopeless Cycle Lake]]>><<pass 2>><<endevent>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Wraith Refuse
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
"<span class="wraith">그리 하라.</span>"
<br><br>

그것은 천천히 호수 속으로 다시 가라앉고, 안개가 사라진다.
<br><br>

<<link [[다음|Hopeless Cycle Lake]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Wraith 3
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<canvas-model-override "trauma" true>><<canvas-model-override "eyes_half" true>>
<<canvas-model-override "left_eye" "blue possessed">><<canvas-model-override "right_eye" "blue possessed">>
<<set $possessed to true>><<canvas-model-override "blink" false>>
<<set $control to 1>>
<<neckruined>><<neckwear "ivory necklace">>

당신은 그것의 손을 잡는다. 차갑고, 당신을 통과하기 시작한다. 그것은 앞으로 떠올라 당신을 껴안고 사라진다. 무언가 당신의 목에 걸린다.
<br><br>

당신은 그 자리에 얼어붙어 서 있다. 갑자기, 당신의 몸이 깊은 숨을 들이쉬며 황홀경에 빠진 듯 위를 쳐다본다. 공기가 너무나 달콤하게 느껴진다. 마치 처음으로 깨어난 것처럼 활력이 넘친다.
당신의 손이 계속해서 쥐었다 폈다 한다.
<br><br>

<<if $prisonerBrands.includesAny("lower back", "left arm", "right arm", "left shoulder", "right shoulder")
	or $prisonerBrands.filter(brands => ["left leg", "left thigh", "left foot"].includes(brands)).length gte 2
	or $prisonerBrands.filter(brands => ["right leg", "right thigh", "right foot"].includes(brands)).length gte 2
	or between($prisonerBrands.length,1,2)>>
	<span class="red">당신은 얼어붙는다.</span> 당신의 마음이 물결처럼 일렁이고, 기억들이 수면 위로 떠오른다.
	살갗에 눌린 뜨거운 낙인. 억눌린 비명과 터져 나온 비명. 신의 형상을 본뜬 오만함과 잔인한 손길에 의해 영원히 상처 입은 아름다움.
	달콤했던 공기는 이제 쓰고 정체된 맛이 난다.
	<br><br>

	결국, 당신은 지치고 힘든 숨을 내쉰다. "꿈틀거리는 간수여." 당신의 목소리가 말한다. 당신은 가슴에 손을 얹는다.
	"그대의 심장이 내게 아름답게 노래하는구나. 누구도 우리 안에서 죽어서는 안 되지.
	Your witch... <<worldFemale 'she' 'he'>> slips down the empty gullet. <<worldFemale 'She' 'He'>> is not wholly consumed... <span class="red">but <<worldFemale 'she' 'he'>> will be.</span>"
	<br><br>

	<span class="nextLink"><<link [[다음|Hopeless Cycle Wraith Failure]]>><</link>></span>
	<br>
<<else>>
	<<wearProp "whip" "khaki">>
	당신은 숨을 내쉰다. "알겠습니다." 당신의 목소리가 말한다. 당신은 가슴에 손을 얹는다.
	"그대의 심장이 내게 아름답게 노래하는구나. 누구도 우리 안에서 죽어서는 안 되지.
	Your witch... <<worldFemale 'she' 'he'>> slips down the empty gullet, yet <<worldFemale 'she' 'he'>> is not wholly consumed.
	그대가 찾는 것은 바늘구멍을 통과해야만 얻을 수 있다. 운명은 그대 편이 아니로다. 길은 오직 하나뿐이다."
	<br><br>

	당신의 손이 채찍 위에 놓인다. 당신의 몸이 그것을 풀고 펼친다. "내가 그대에게 지식의 선물을 주리라. 우리 신앙에서 잊혀진 기술과 기법을. 그대가 배우는 동안, 나는 그대가 걸어야 할 길을 밝혀주리라."
	<br><br>

	창백한 팔이 당신의 팔에서 분리된다. 하얀 덩굴손이 그 팔을 따라 손을 지나 뻗어 나온다. 당신이 채찍을 쥐듯, 그것은 덩굴손을 쥔다. 당신은 다시 팔을 제어할 수 있게 된다.
	"시간의 화살은 자정에서 불과 몇 초밖에 남지 않을 것이다. 그대의 몸으로는 제시간에 건널 수 없는 거리이지." 창백한 팔이 덩굴손을 휘두른다. 당신은 정확히 같은 방식으로 채찍을 휘두른다.
	"그대의 몸의 연장선이다. 그것을 믿고, <span class="green">숙달하라,</span> 그러면 거리는 아무 의미도 없을 것이다."
	<br><br>

	그것은 채찍의 춤을 통해 당신을 인도한다. 당신은 이 움직임을 알고 있다. 단지 당신의 몸을 시험하고 있을 뿐이다. "<span class="blue">내 말을 귀담아들어라. 기억하라.</span> 아주 작은 실수 하나가 구원을 손가락 사이로 빠져나가게 할 것이다."
	<br><br>

	<span class="nextLink"><<link [[다음|Hopeless Cycle Wraith 4]]>><</link>></span>
	<br>
<</if>>

:: Hopeless Cycle Wraith 4
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set $control to 400>>

당신은 그것의 움직임을 따른다. 다른 손으로 채찍 끝을 잡고, 본 적 없는 자세에서 공격을 시작한다. <<gwhip>>
<br><br>

"You must ensure <<worldFemale 'she' 'he'>> is strong enough. <span class="blue"><<worldFemale 'Her' 'His'>> body must be full of vitality.</span>"<br>
당신은 떨어지는 나뭇잎을 공중에서 채찍으로 쳐낸다. <<gwhip>><br>
<<if $hcChallenge.faithBlooms>>
	"<<worldFemale 'Her' 'His'>> hair, ever important to a witch, <span class="red">has been mangled</span>. You must make it more than beautiful to restore what was taken. <span class="purple">Accept <<worldFemale 'her' 'his'>> gift. Cleanse it. Bestow it back upon <<worldFemale 'her' 'him'>>.</span>"
<<else>>
	<span class="blue">"<<worldFemale 'Her' 'His'>> hair, ever important to a witch, must be beautiful."</span>
<</if>><br>
당신의 채찍이 발치에서 원을 그린다. 당신은 몸을 돌려 공격한다. 반동한 채찍이 귀를 스쳐 지나간다. <<gwhip>><br>
"<<worldFemale 'She' 'He'>> is strengthened by your touch. <span class="blue">Take <<worldFemale 'her' 'his'>> hands</span>, so you may both bloom. <span class="blue">Your kiss, or your body in intimate union, will grant <<worldFemale 'her' 'him'>> power.</span>"<br>
당신은 채찍을 감고, 주위로 여러 번 빠르게 공격한다. <<prof whip 10>><<gwhip>><br>
"Two more gifts, you must give <<worldFemale 'her' 'him'>>. <span class="blue">Dress <<worldFemale 'her' 'him'>>,</span> a second skin to mask the lure of <<worldFemale 'her' 'his'>> body.
<span class="blue">Give <<worldFemale 'her' 'him'>> your name,</span> a promise to whisper."
<br><br>

It allows your body to rest for a moment. "Beware. <span class="red"><<worldFemale 'Her' 'His'>> heart is cold.</span> <<worldFemale 'She' 'He'>> will attempt to steal yours, if it wins <<worldFemale 'her' 'him'>> freedom.
<span class="blue">You must give it to <<worldFemale 'her' 'him'>> first, just before the fateful hour.</span>
Take heed. This will allow <<worldFemale 'her' 'him'>> to tear it from your chest without effort."
<br><br>

당신의 팔이 원을 그리며 스트레칭하며, 더 많은 활동을 준비한다.<br>
"너는 너의 심장에 짐을 지워야 한다. 무겁게 짓눌려 마지막 선물로 바쳐진 심장은, 훔쳐질 수 없다.
<span @class='$hcChallenge.faithBurden ? "" : "blue"'>Embrace the likeness of the expectant <<worldFemale 'mother' 'father'>>, until half of the burden rests on your shoulders.</span>"
<<if $hcChallenge.faithBurden>>
	<br><br>

	당신은 고개를 갸웃거린다.<br>
	"<span class="gold">하지만 넌 이미 그렇게 했잖아, 안 그래?</span> 물론 그랬지. 물론 그랬어."
<</if>>
<br><br>

<span class="nextLink"><<link [[다음|Hopeless Cycle Wraith 5]]>><</link>></span>
<br>

:: Hopeless Cycle Wraith 5
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set $control to 800>>

당신은 채찍을 빠르게 두 번 내리쳐 모래 위에 십자가를 새겼다.
<br><br>

"<<worldFemale 'She' 'He'>> will be branded, in an attempt to seal the corruption inside. When <<worldFemale 'she' 'he'>> lies under the red moon, it will instead grow to bursting.
You must press this as an advantage. Your opponents are many. Only together can you stand against them. Heed."
<br><br>

당신은 두 번 더 내리쳐 또 다른 십자가를 만들었다.
<br><br>

"손에 든 불꽃을 다룰 때는 한 치의 오차도 없어야 한다.<br>
You may think it a mercy to scar <<worldFemale 'her' 'his'>> legs, to spare <<worldFemale 'her' 'him'>> pain.<br>
<span class="blue">Do not brand either more than once,</span> lest <<worldFemale 'she' 'he'>> stumble at the critical moment.<br>
<span class="blue">Do not brand the lower spine,</span> lest you sever <<worldFemale 'her' 'his'>> roots.<br>
<span class="blue">Do not brand either arm,</span> lest <<worldFemale 'her' 'his'>> claws become dull.<br>
<span class="blue">Do not brand either shoulder,</span> lest you clip <<worldFemale 'her' 'his'>> wings.<br>
Yet, <span class="blue">you must brand <<worldFemale 'her' 'him'>> at least thrice,</span> lest <<worldFemale 'she' 'he'>> be devoured by Auriga."
<br><br>

그 말에 당신은 몸을 떨었다. 당신의 시선이 공터 반대편에 떨어진 굵은 나뭇가지에 고정되었다. 당신은 거리를 가늠하며 뒤로 몇 걸음 물러났다.<br>
한 걸음 더. 아직 충분히 멀지 않다.<br>
반 걸음 더. 완벽하다.<br>
"At last, <span class="blue">strike at the silver that binds <<worldFemale 'her' 'him'>>.</span> Let your strike toll midnight."
<br><br>

당신은 앞으로 빠르게 네 걸음을 내디뎠고, 두 번째 걸음에서 채찍을 휘두르기 시작했다.<br>
체중을 완벽하게 이동하며 팔을 끝까지 뻗고 손목을 튕겼다. 시간이 느려졌다.<br>
아주 미세한 조정. 채찍의 끝이 간신히 닿았다.<br>
폭발적인 파열음과 함께 나뭇가지가 산산조각 났고, 숲 전체에 메아리가 울려 퍼졌다. <<prof whip 20>><<gggwhip>>
<br><br>

<<if $prof.whip gte 1000>>
	<span class="green">"준비가 되었구나."</span>
<<else>>
	<span class="blue">"손끝을 더 단련해야 한다. 너의 일격은 완벽해야만 해."</span>
<</if>>
<br>
창백한 형체가 사지에 찌릿한 감각을 남기며 당신의 몸에서 부드럽게 빠져나왔다. 그것이 당신을 향해 미소 지었다. "<span class="wraith">행운을 빈다, 영리한 간수여. 너희의 심장이 <span class="tentacle">하나 되어</span> 고동치기를.</span>" 형체는 다시 물속으로 가라앉았다. 안개가 걷혔다.
<br><br>

<<link [[다음|Hopeless Cycle Lake]]>><<set $control to 1000>><<unset $possessed>><<set $hc.wraith to true>><<neckruined>><<endevent>><</link>>
<br>

:: Hopeless Cycle Wraith Failure
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set $control to 0>>

당신은 팔을 뻗는다. 창백한 팔 하나가 당신의 팔에서 분리된다. 수많은 하얀 촉수가 그 팔을 따라 손 너머까지 뻗어 나온다. 창백한 팔이 손짓하자, 촉수들이 당신에게 몰려든다.
<br><br>

"The flame you held was wielded with imperfection. You have sealed <<worldFemale 'her' 'his'>> fate."
<br><br>

<<if $prisonerBrands.includesAny("lower back", "left arm", "right arm", "left shoulder", "right shoulder")>>
	촉수들이 당신의 <<print formatList($prisonerBrands.filter(brands => ["lower back", "left arm", "right arm", "left shoulder", "right shoulder"].includes(brands)).map(b => window.KR.getBodypartKr(b)))>>에 닿는다.<br>
<</if>>
"<span @class='$prisonerBrands.includes("lower back") ? "red" : ""'>With <<worldFemale 'her' 'his'>> lower spine branded,</span> <<worldFemale 'her' 'his'>> roots are severed.<br>
<span @class='$prisonerBrands.includesAny("left arm", "right arm") ? "red" : ""'>With either arm branded,</span> <<worldFemale 'her' 'his'>> claws become dull.<br>
<span @class='$prisonerBrands.includesAny("left shoulder", "right shoulder") ? "red" : ""'>With either shoulder branded,</span> <<worldFemale 'her' 'his'>> wings become clipped."
<br><br>

<<set _legColor to "">>
<<if $prisonerBrands.filter(brands => ["left leg", "left thigh", "left foot"].includes(brands)).length gte 2 or $prisonerBrands.filter(brands => ["right leg", "right thigh", "right foot"].includes(brands)).length gte 2>>
	<<set _legColor to "red">>
	촉수들이 당신의 <<print formatList($prisonerBrands.filter(brands => ["left leg", "right leg", "left thigh", "right thigh", "left foot", "right foot"].includes(brands)).map(b => window.KR.getBodypartKr(b)))>>【을를】 감싼다.<br>
<</if>>
"You may have thought it a mercy to scar <<worldFemale 'her' 'his'>> legs, to spare <<worldFemale 'her' 'him'>> pain.<br>
Yet, <span @class="_legColor">with either leg branded more than once,</span> <<worldFemale 'she' 'he'>> stumbles at the critical moment."
<br><br>

당신은 촉수의 수를 센다. 촉수들은 당신의 <<print formatList($prisonerBrands.map(b => window.KR.getBodypartKr(b)))>>에 닿아 있다. 전부 <span class="blue"><<number $prisonerBrands.length>></span>개다.<br>
"Despite all this, <span @class='$prisonerBrands.length lt 3 ? "red" : ""'>if not branded at least thrice,</span> <<worldFemale 'she' 'he'>> is devoured by Auriga."
<br><br>

창백한 형체가 당신의 몸에서 부드럽게 빠져나가자, 사지가 저릿하다. "<span class="wraith">이제 알겠지. 네가 바랐던 것은 이미 손가락 사이로 빠져나갔다. 여기서 찾을 영광은 없다.</span>" 그것은 고개를 숙이고 오랫동안 침묵을 지킨다. "<span class="wraith">미안하다.</span>"
<br><br>

그것은 다시 물속으로 가라앉는다. 안개가 걷힌다.
<br><br>

<<link [[다음|Hopeless Cycle Lake]]>><<set $control to 999>><<unset $possessed>><<neckruined>><<endevent>><</link>>
<br>

/* Barracks */

:: Hopeless Cycle Quarters
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "quarters">>
<<hopelessCycleEffects>>
You are in the barracks on the second floor of the temple, where your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> make their home.
중앙 홀을 둘러싼 네 개의 큰 방이 있다.
<br><br>

<<if Time.dayState is "night">>
	침상은 가득 차 있고, 방들은 이따금 들리는 코골이 말고는 조용하다.
<<elseif Time.dayState is "dawn">>
	Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> are already up and active. It's too noisy to sleep.
<<elseif Time.dayState is "day">>
	수련생들이 먼지를 털고 청소하느라 바쁘다. 잠을 자기엔 너무 시끄럽다.
<<elseif Time.dayState is "dusk">>
	Some of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> are preparing for bed.
<</if>>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<else>>
	<<set _water to hcItemCanReach("water", (water => water.dirty lt 2))>>
	<<set _waterTainted to hcItemCanReach("water", (waterT => waterT.dirty gte 2))>>
	<<if Time.dayState is "night">>
		지금 청소하면 사람들을 깨울 것이다.
		<br><br>
	<<elseif _water>>
		<<capture _water>>
			<<choreicon "sweep">><<link [[막사를 청소한다 <<hcTimeTaskDisplay>>|Hopeless Cycle Quarters Clean]]>><<hcTimeTaskPass>><<hcSuspicion -3>><<hcWash _water>><<housekeeping 1 1000>><</link>><<ghousekeeping>><<hopelessCycleSus -1>>
		<</capture>>
		<br><br>
	<<else>>
		병영을 청소하려면 물 한 양동이가 필요하다.
		<<if _waterTainted>>
			<span class="teal"><i>깨끗한</i> 물</span>이 담긴 양동이다.
		<</if>>
		<br><br>
	<</if>>
	당신의 침상은 여기에 있다.
	<br>
	<<bedicon>><<link [[당신의 침상|Hopeless Cycle Bunk]]>><</link>>
	<br><br>

	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<b><u>장소:</u></b><br>
	<<templeicon "cloister">><<link [[회랑으로 가는 통로 (0:01)|Hopeless Cycle Cloister]]>><<pass 1>><</link>>
	<br>
	<<getouticon>><<link [[아래층 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Bunk
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "bed">>
<<hopelessCycleEffects>>
당신은 신전 숙소의 침상 옆에 있다. 갑옷과 로브를 걸어 둘 받침대가 있고, 가림막 뒤에는 옷을 갈아입을 작은 공간이 있다.
<br><br>

<<if ["dawn", "day"].includes(Time.dayState)>>
	<<set _noSleep to true>>
	지금은 너무 시끄러워서 잠을 잘 수 없다.
	<br><br>
<</if>>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<else>>
	<<if $worn.upper.name is "chain tunic">>
		<<if !_noSleep>>
			<<if hcItemLitTorch()>>
				<span class="red">불붙은 횃불을 든 채로는 잠들 수 없다.</span>
			<<else>>
				<<bedicon>><<link [[로브로 갈아입고 침대에 들어간다 (0:10)|Hopeless Cycle Bunk Bed]]>><<pass 10>><<hopelessCycleOutfit "robes">><<feetruined>><</link>>
			<</if>>
			<br>
		<</if>>
		<<icon "clothes/monks-habit.png">><<link [[로브로 갈아입는다 (0:10)|Hopeless Cycle Bunk]]>><<pass 10>><<hopelessCycleOutfit "robes">><</link>>
		<br>
	<<else>>
		<<if !_noSleep>>
			<<if hcItemLitTorch()>>
				<span class="red">불붙은 횃불을 든 채로는 잠들 수 없다.</span>
			<<else>>
				<<bedicon>><<link [[침대에 들어간다|Hopeless Cycle Bunk Bed]]>><<feetruined>><</link>>
			<</if>>
			<br>
		<</if>>
		<<set _armourIcon to clone(setup.clothes.upper.find(item => item.name === "chain tunic"))>>
		<<set _armourIcon.colour to "black">><<set _armourIcon.accessory_colour to "white">>
		<span class="clothes-black"><<clothingicon _armourIcon "upper">></span><<link [[갑옷으로 갈아입는다 (0:10)|Hopeless Cycle Bunk]]>><<pass 10>><<tiredness 4>><<hopelessCycleOutfit "armour">><</link>><<gtiredness>>
		<br>
	<</if>>
	<<if $hairtype is "braid right">>
		<<mirroricon>><<link [[땋은 머리를 푼다 (0:05)|Hopeless Cycle Bunk]]>><<pass 5>>
			<<set $hairlength to 400>>
			<<set $hairlengthstage to "chest">>
			<<set $hairtype to "neat">>
			<<set $fringelength to 200>>
			<<set $fringelengthstage to "shoulder">>
			<<set $fringetype to "framed">>
			<<set $hairposition to "back">>
		<</link>>
		<br>
	<<elseif $hairtype isnot "neat">>
		<<mirroricon>><<link [[머리를 정돈한다 (0:05)|Hopeless Cycle Bunk]]>><<pass 5>><<trauma -2>>
			<<set $hairlength to 400>>
			<<set $hairlengthstage to "chest">>
			<<set $hairtype to "neat">>
			<<set $fringelength to 200>>
			<<set $fringelengthstage to "shoulder">>
			<<set $fringetype to "framed">>
			<<set $hairposition to "back">>
		<</link>><<ltrauma>>
		<br>
	<<elseif $hairtype is "neat" and $prisonerEvents.includes("talkHairLet")>>
		<<mirroricon>><<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}【이가】 해 준 방식으로 머리를 땋는다 (0:15)`|Hopeless Cycle Bunk]]>><<pass 15>>
			<<trauma -2>>
			<<set $hairtype to "braid right">>
			<<set $hairposition to "front">>
		<</link>><<ltrauma>>
		<br>
	<</if>>
	<br>

	침대 밑에 물건을 숨겨 둘 수 있다. 들킬 가능성은 낮지만, 들키면 큰 의심을 살 것이다. 당신이 그 침대에서 자고 있는 동안에는 절대 수색당하지 않는다.
	<br>
	<<if $hcItems.some(item => item.type is "sheets" and item.location is "bed") and !$hcChallenge.itemNoHide>>
		<span class="green">숨겨 둔 물건들 앞에 접은 침대보를 놓았다. 이제 그것들을 찾기는 훨씬 더 어려워질 것이다.</span>
	<</if>>
	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
	<br>

	<<templeicon "quarters">><<link [[물러난다|Hopeless Cycle Quarters]]>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Bunk Bed
<<set $outside to 0>><<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set _witchblooms to hcItemCanReach("clutter", w => w.name === "witchblooms" && w.dirty gte 1)>>
<<if _witchblooms>>
	<<if _witchblooms.location is "held">>
		<<set _witchbloomsHeld to true>>
	<<elseif !$hc.daily.witchbloomMessage>>
		<<set $hc.daily.witchbloomMessage to true>>
		잠자리에 들 준비를 하자, <span class="pink">당신의 손이 움찔거린다. 텅 빈 것처럼 느껴진다.</span>
		당신은 꽃을 찾으려고 침대 밑을 살핀다. 이유는 알 수 없지만, 잠든 동안 그것들을 쥐고 있고 싶다.
		어쩌면 그것들이 당신의 순결함을 갈망하는지도 모른다.
		<br><br>

		<<capture _witchblooms>>
			<<link [[그것들을 챙긴다|Hopeless Cycle Bunk Bed]]>><<set _witchblooms.location to "held">><</link>>
			<br>
		<</capture>>
		<<link [[무시한다|Hopeless Cycle Bunk Bed]]>><</link>>
		<br>
		<<exit>>
	<</if>>
<</if>>
<<if $hcItems.some(item => item.location is "held" && item.name isnot "witchblooms")>>
	<<run $hcItems.filter(item => item.location is "held" && item.name isnot "witchblooms").forEach(item => item.location = "bed")>>
	<span class="blue">물건들을 침대 밑에 숨겨 둔 뒤,</span> 밤 기도를 읊는다
	<<if _witchbloomsHeld>><span class="purple">꽃을 두 손 사이에 끼운 채</span><</if>>
	안으로 들어간다.
<<else>>
	당신은 밤 기도를 읊조리고
	<<if _witchbloomsHeld>><span class="purple">꽃을 두 손 사이에 끼운 채</span><</if>>
	침대로 올라간다.
<</if>>
<br>

<<generateSleepLinks "Hopeless Cycle Sleep">>
<<link [[침대에서 나온다|Hopeless Cycle Bunk]]>><<hopelessCycleOutfit "armour">><</link>>

:: Hopeless Cycle Sleep
<<set $outside to 0>><<set _thermoDisable to true>>
<<sleep>><<effects>><<hopelessCycleEffects>><<set $hc.neverLeftDungeon to false>>
<<if _sleepinterrupt>>
	<<if $hc.bloodWake>>
		당신은 침대에서 벌떡 일어난다. 창문으로 붉은 달빛이 스며든다.
	<<elseif $hc.daily.nightmare and $hc.nightBreakIn isnot "passed" and $hc.nightBreakIn isnot "end">>
		You dream of seeing <<print $prisoner.name>> in <<worldFemale 'her' 'his'>> cell. Someone in black robes is approaching <<worldFemale 'her' 'him'>>. <<worldFemale 'She' 'He'>> looks afraid.
		<br><br>

		<span class="red"><<worldFemale 'She' 'He'>> calls to you for help.</span>
		<br><br>

		당신은 침대에서 벌떡 일어난다.
	<<elseif $hc.daily.wake>>
		Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> all get up for the day. It's impossible to sleep with the noise.
		<<if !$hc.daily.sermon and ["dawn","day"].includes(Time.dayState)>>
			<span class="blue">아침 설교를 들으러 회랑으로 가야 한다.</span>
		<</if>>
	<</if>>
	<br><br>

	<<set _witchblooms to hcItemHolding("clutter", w => w.name is "witchblooms")>>
	<<if _witchblooms>>
		<<if _witchblooms.progress and _witchblooms.progress gte 14>>
			<<set _witchblooms.name to "purified witchblooms">>
			<<set _witchblooms.nameText to "마녀의 꽃 <span class='gold'>(정화됨)</span>">>
			<<run delete _witchblooms.dirty>>
			<span class="green">꽃들이 선명하고 생기로 가득하다.</span><<llpurity>>
		<<elseif _witchblooms.progress>>
			<span class="teal">꽃들이 더 건강해 보이지만, 여전히 병든 듯하다.</span><<llpurity>>
		<</if>>
		<br><br>
	<</if>>

	<<link [[일어난다|Hopeless Cycle Bunk]]>><<hopelessCycleOutfit "armour">><</link>>
	<br>
<<elseif $hc.suspicion gte 100>>
	눈을 뜨지만, 여전히 모든 것이 어둡다. <span class="red">머리 위에 무언가가 씌워져 있다.</span> 곧바로 배를 얻어맞고, 침대 밖으로 끌려 나온다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<else>>
	<<if $nightmares gte 1 and $controlled is 0>>
		<<nightmareWake>>
	<<elseif $specialConditionForSpookySleep>>

	<<else>>
		당신은 깊이 잠든다.
	<</if>>
	<<if $stress gte $stressmax>>
		<<set $stress -= 2000>>
		<<trauma 10>>
		<span class="red">잠든 사이 스트레스가 정점에 달했다가 가라앉았지만, 정신 건강을 대가로 치렀다.</span>
		<<lstress>><<gtrauma>>
		<<ruffleHair>>
		<<set $hairtype to "messy">>
		<<set $hairlength to 1000>>
		<<set $hairlengthstage to "feet">>
	<</if>>
	<br><br>

	<<set _witchblooms to hcItemHolding("clutter", w => w.name is "witchblooms")>>
	<<if _witchblooms>>
		<<if _witchblooms.progress and _witchblooms.progress gte 14>>
			<<set _witchblooms.name to "purified witchblooms">>
			<<set _witchblooms.nameText to "마녀의 꽃 <span class='gold'>(정화됨)</span>">>
			<<run delete _witchblooms.dirty>>
			<span class="green">꽃들이 선명하고 생기로 가득하다.</span><<llpurity>>
		<<elseif _witchblooms.progress>>
			<span class="teal">꽃들이 더 건강해 보이지만, 여전히 병든 듯하다.</span><<llpurity>>
		<</if>>
		<br><br>
	<</if>>
	<<if _leak?.includes("bed")>>
		<<set _bucketOutput to _leak.filter(x => x is "bed").length gt 1 ? "buckets" : "bucket">>
		<span class="red">잠든 사이 _bucketOutput에서 물이 새어 나왔다.</span> 누군가 알아차리기 전에 치워 둔다.
		<br><br>
	<</if>>

	<<link [[일어난다|Hopeless Cycle Bunk]]>><<hopelessCycleOutfit "armour">><</link>>
	<br>
<</if>>
<<set $phase to 0>>

:: Hopeless Cycle Quarters Clean
<<set $outside to 0>><<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<<set _water to hcItemCanReach("water", (water => water.dirty lt 2))>>

당신은 병영을 박박 문질러 청소하기 시작한다. 바닥과 몇몇 시트, 더러운 옷가지를 청소한다.
<br><br>

<i><span class="blue">침대 시트는 양동이 안의 물건을 숨기는 데 쓸 수 있다. 안에 침대 시트가 든 양동이는 지하 감옥에 들어갈 때 의심을 사지 않는다.</span></i>
<br><br>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.suspicion gte 100>>
	<span class="red">자루가 머리 위로 씌워지며 모든 것이 어두워진다.</span> 곧바로 복부를 얻어맞아 몸이 접히고, 무릎을 꿇도록 강요당한다.
	<br><br>

	마지막으로 느낀 것은 머리에 가해지는 충격이다.
	<br><br>

	<<link [[다음|Hopeless Cycle Ending E]]>><<pass 4 hours>><<endevent>><</link>>
	<br>
<<elseif $stress gte $stressmax>>
	<<hopelessCyclePassout>>
<<else>>
	<<if Time.dayState is "night">>
		계속 청소하면 사람들이 깨어날 것이다.
		<br>
	<<elseif _hcEvent is "blood">>
		더는 청소할 시간이 없다.
		<br>
	<<elseif _water>>
		<<capture _water>>
			<<link [[`청소를 계속한다 <<hcTimeTaskDisplay>>`|Hopeless Cycle Quarters Clean]]>><<hcTimeTaskPass>><<hcSuspicion -3>><<hcWash _water>><<housekeeping 1 1000>><</link>><<ghousekeeping>><<hopelessCycleSus -1>>
		<</capture>>
		<br>
	<<else>>
		물이 너무 더러워서 계속 청소할 수 없다.
		<br>
	<</if>>

	<<set _loc to hcItemHasFreeHand() ? "held" : "quarters">>
	<<link [[청소는 이쯤 한다|Hopeless Cycle Quarters]]>><<endevent>><</link>>
	<br>
	<<capture _loc>>
		<<link [[침대 시트 몇 장을 훔친다|Hopeless Cycle Quarters]]>><<run hcItemAdd({ type: "sheets", name: "침대 시트", location: _loc, origin: "quarters", dirty: 0, dirtyOnDrop: V.hcChallenge.itemDirty })>><<endevent>><<hcSuspicion 5>><</link>><<hopelessCycleSus 1>>
		<br>
		<<link [[옷가지를 훔친다|Hopeless Cycle Quarters]]>><<run hcItemAdd({ type: "clothes", name: "로브", location: _loc, origin: "quarters", dirty: 0, dirtyOnDrop: V.hcChallenge.itemDirty })>><<endevent>><<hcSuspicion 5>><</link>><<hopelessCycleSus 1>>
		<br>
	<</capture>>
<</if>>

/* Prayer Room */

:: Hopeless Cycle Prayer Room
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "prayerroom">>
<<hopelessCycleEffects>>

<<if _hcEvent is "blood">>
	A heavy hand rests on your shoulder. The Bishop's Hand looms before you. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.handLocation is "prayerroom" and !$hc.daily.prayerWarning and $hcAction is "enter" and Time.hour lte 22 and Time.hour gte 6>>
	<<generateTemple 1>><<person1>>
	당신은 기도실로 다가간다. 당신의 <<sister_npc>> 중 한 명이 당신을 멈춰 세운다. "주교의 손께서 기도 중이십니다."
	<br><br>

	<<link [[그래도 들어간다|Hopeless Cycle Prayer Room]]>><<endevent>><<set $hc.daily.prayerWarning to true>><</link>>
	<br>
	<<link [[떠난다|Hopeless Cycle Temple]]>><<endevent>><</link>>
	<br>
<<else>>
	당신은 작은 육각형 방 안에 있다. 방 가장자리는 어디로도 이어지지 않는 계단으로 둘러싸여 있다. 각 벽에는 저 멀리 위쪽에 창문 하나가 장식되어 있다. 중앙에는 방석이 놓여 있다.
	<br><br>

	공기는 달콤한 향 냄새로 가득하다.
	<br><br>

	<<if $hc.handLocation is "prayerroom">>
		The Bishop's Hand stirs from <<worldMale 'his' 'her'>> trance, but doesn't turn around to face you. "You better have a good reason for disturbing me, <<worldMale 'brother' 'sister'>> Fayne." You're not sure how <<worldMale 'he' 'she'>> knew it was you. <<stress 6>><<gstress>>
		<br><br>

		<<if $prisonerEvents.includes("raped") and !$prisonerEvents.includes("rapedReported")>>
			<<lockicon "unlock">><<link [[형제 중 하나가 더럽혀졌다고 손에게 말한다|Hopeless Cycle Prayer Report]]>><<set $prisonerEvents.pushUnique("rapedReported")>><</link>>
			<br>
		<</if>>
		<<getouticon>><<link [[떠난다 (0:01)|Hopeless Cycle Temple]]>><<hcSuspicion 2>><<pass 1>><</link>><<hopelessCycleSus 1>>
		<br>
	<<else>>
		<<templeicon "pray">><<link [[`명상한다 <<hcTimeTaskDisplay>>`|Hopeless Cycle Prayer]]>><<stress -6>><<willpower 2>><<hcTimeTaskPass>><</link>><<lstress>><<gwillpower>>
		<br><br>

		<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
		<b><u>장소:</u></b><br>
		<<getouticon>><<link [[떠난다 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
		<br>
	<</if>>
<</if>>

<<unset $hcAction>>

:: Hopeless Cycle Prayer
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "prayerroom">>
<<hopelessCycleEffects>>

<<hallucinogen 60>>
당신은 방석에 앉아 기도한다. 향 때문에 몸이 가벼워지고 어지러움을 느낀다. <<ghallucinogens>>
<br><br>

<<if _hcEvent is "blood">>
	The door to the prayer room swings open. The Hand's silhouette looms. "<span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
	<br><br>

	You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
	<br><br>

	<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
	<br>
<<elseif $hc.handLocation is "prayerroom">>
	The door to the prayer room swings open. The Bishop's Hand stands there. "Out," <<worldMale 'he' 'she'>> commands.
	<br><br>
	<<if $prisonerEvents.includes("raped") and !$prisonerEvents.includes("rapedReported")>>
		<<lockicon "unlock">><<link [[형제 중 하나가 더럽혀졌다고 손에게 말한다|Hopeless Cycle Prayer Report]]>><<set $prisonerEvents.pushUnique("rapedReported")>><</link>>
		<br>
	<</if>>
<<else>>
	<<templeicon "pray">><<link [[`명상한다 <<hcTimeTaskDisplay>>`|Hopeless Cycle Prayer]]>><<stress -6>><<willpower 2>><<hcTimeTaskPass>><</link>><<lstress>><<gwillpower>>
	<br><br>

	<div id="hcItems" class="no-numberify"><<hopelessCycleItemLinks>></div>
<</if>>
<<getouticon>><<link [[떠난다 (0:01)|Hopeless Cycle Temple]]>><<pass 1>><</link>>
<br>

:: Hopeless Cycle Prayer Report
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<span class="narration">교도관은 마녀의 모독을 벌하지 않고 넘어갈 수 없었다. 정의는 취사선택할 수 있는 것이 아니었다.</span>
<br><br>

You tell <<worldMale 'him' 'her'>> that one of your <<worldMale 'brothers' 'sisters'>> violated your prisoner. <<worldMale 'He' 'She'>> tenses up.
<br><br>

You stand in deafening silence for a long time, before <<worldMale 'he' 'she'>> finally stands.
<br><br>

"And how, <<worldMale 'brother' 'sister'>>, do you know that?"
<br><br>

당신은 모든 것을 고통스러울 정도로 상세하게 설명한다. 그럴 의도조차 없었다. 당신의 의지와는 상관없이 입에서 말이 흘러나온다.
<br><br>

<<worldMale 'He' 'She'>> seems to get angrier with every word you say, until <<worldMale 'his' 'her'>> shoulders finally fall. <<worldMale 'He' 'She'>> smiles at you. Warmly. It makes you uncomfortable.
<br><br>

"It's hard to lie in a place so close to heaven. Good work, <<worldMale 'brother' 'sister'>>." <<worldMale 'He' 'She'>> laughs, and pats you on the shoulder. "This presents a contamination risk. We will do an emergency inspection. Come." <<worldMale 'He' 'She'>> leads you out of the prayer room, rings the confessional's bell loudly seven times, and walks with you to the cloister. <<hcSuspicion -50>><<hopelessCycleSus -3>>
<br><br>

<<link [[다음|Hopeless Cycle Prayer Report 2]]>><<pass 30>><</link>>
<br>

:: Hopeless Cycle Prayer Report 2
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "cloister">>
<<hopelessCycleEffects>>

Your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>> all line up in front of you and the Bishop's Hand in the cloister.
<br><br>

<<if Time.dayState is "night">>
	그들 중 다수는 하품을 하며, 주교의 손의 시선이 닿을 때까지 자세가 흐트러져 있다.
<<else>>
	그들은 모두 차렷 자세로 서 있다. 많은 이들이 긴장한 듯 보인다.
<</if>>
<br><br>

The Hand whispers in your ear, asking for clarifying details. With each question, some of the crowd are permitted to leave, until there's only six <<worldMale 'monks' 'nuns'>> left.
<br><br>

그들은 각자 정조 검사를 받는다. 그들 중 두 명이 실패한다. 주교의 손이 그들 각각의 어깨를 잡고 당신을 돌아본다. "정말 한 명뿐이었나?" 둘 다 겁에 질린 표정이다.
<br><br>

<<link [[예|Hopeless Cycle Prayer Report 3]]>><<set $phase to 1>><</link>>
<br>
<<link [[아니요|Hopeless Cycle Prayer Report 3]]>><<set $phase to 2>><</link>>
<br>

:: Hopeless Cycle Prayer Report 3
<<set $outside to 0>><<set _thermoDisable to true>><<effects>><<set $bus to "guardhouse">>
<<hopelessCycleEffects>>

<<if $phase is 1>>
	당신은 고개를 끄덕인다.
<<else>>
	당신은 고개를 젓는다.
<</if>>
The Hand huffs. "Then we have no choice." <<worldMale 'He' 'She'>> starts to guide them both to the dungeon. You follow, along with an entire regiment of confessors.
<br><br>

당신은 <<print window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥으로 인도된다. 주교의 손이 두 용의자와 함께 안으로 들어간다. <<print window.KR.gatPersonNameDictKR($prisoner.name).toUpperFirst()>>【은는】 고개를 들고는, 주춤거리며 물러선다.
<br><br>

"마녀." 주교의 손이 내뱉는다. "신실한 자 중 하나가 네 손길에 더럽혀졌다."
<br><br>

<<worldFemale 'She' 'He'>> blinks at <<worldMale 'him' 'her'>>, not seeming to understand <<worldMale 'him' 'her'>>. However, <<worldFemale 'her' 'his'>> eye falls upon the <<worldMale 'monk' 'nun'>> on the right. <<worldFemale 'Her' 'His'>> stare is pointedly hateful. That's enough indication for the Hand.
<br><br>

<<worldMale 'He' 'She'>> shoves the other <<worldMale 'monk' 'nun'>> out of the cell, into the waiting arms of the confessors. "You must be purified," they say. <<worldMale 'He' 'She'>> seems relieved to only be facing the normal punishment.
<br><br>

The guilty <<worldMale 'monk' 'nun'>> sneers, struggling in the Hand's grasp. "This is an outrage. I should not be punished for bringing this whore closer to God!" <<worldMale 'He' 'She'>>'s silenced as the Hand punches <<worldMale 'him' 'her'>> directly in the face, sending <<worldMale 'him' 'her'>> to the ground.
<br><br>

The Hand crouches, looking <<worldMale 'him' 'her'>> in the eyes as <<worldMale 'he' 'she'>> clutches <<worldMale 'his' 'her'>> bleeding nose. "You have transgressed, <<worldMale 'brother' 'sister'>>. You have either given the witch what <<worldFemale 'she' 'he'>> needs to invite the Dark Elk... or have taken that taint into yourself, without sanction, and have become a contamination risk." <<worldMale 'He' 'She'>> rips a pouch from <<worldMale 'his' 'her'>> belt, and dumps powder on the ground in front of the door.
"You will be the vessel for that taint. You will purge. You will repent, and be forgiven." <<worldMale 'He' 'She'>> nods to you, signaling for you to approach.
<br><br>

<<link [[다음|Hopeless Cycle Prayer Report 4]]>><</link>>
<br>

:: Hopeless Cycle Prayer Report 4
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>><<wearProp "whip" "khaki">>
<span class="narration">마녀는 목줄에 묶인 개처럼 다루어졌다.</span>
<br><br>

The Hand holds out a silk cord for you to take. You grab it, wrapping it around <<print $prisoner.name>>'s neck. You've enacted this kind of punishment before. <<worldMale 'He' 'She'>> then exits the cell, locking the door, but remains standing there. Watching.
<br><br>

You look at your prisoner. <<worldFemale 'She' 'He'>> eyes the <<worldMale 'monk' 'nun'>> angrily, <<worldFemale 'her' 'his'>> hands scraping against <<worldFemale 'her' 'his'>> shackles. The Hand licks <<worldMale 'his' 'her'>> lips, and motions for you to unlock <<worldFemale 'her' 'his'>> shackles. You do so. <<worldFemale 'She' 'He'>> falls forwards, <<worldFemale 'her' 'his'>> hands digging into the stone as <<worldFemale 'her' 'his'>> grey eye pierces through the <<worldMale 'monk' 'nun'>>.
<br><br>

<<worldMale 'He' 'She'>> tries to stand. In one swift motion, you unclasp your whip and lash <<worldMale 'him' 'her'>> in the leg. <<worldMale 'He' 'She'>> tumbles back down, and you give <<worldMale 'him' 'her'>> a second lash for good measure.
<br><br>

<<worldMale 'He' 'She'>> pushes <<worldMale 'himself' 'herself'>> back against the wall. "P-please, your grace, have mercy!"
<br><br>

The Hand laughs. "I'm not the one you should be asking." <<print $prisoner.name.toUpperFirst()>> drags <<worldFemale 'herself' 'himself'>> forwards. You walk forwards with <<worldFemale 'her' 'him'>>.
<br><br>

The <<worldMale 'monk' 'nun'>>, the rapist, the defiler, the oathbreaker looks to you, pleading. Your fist clenches around the cord.
<br><br>

<<worldFemale 'She' 'He'>> nearly reaches <<worldMale 'him' 'her'>>, <<worldFemale 'her' 'his'>> left arm and hand becoming black. <<worldFemale 'Her' 'His'>> fingers elongating, sharpening. The antler on <<worldFemale 'her' 'his'>> head pulsing.
<br><br>

<<link [[자비를 보인다|Hopeless Cycle Prayer Report 5]]>><<set $phase to 1>><<pass 15>><</link>>
<br>
<<if $sadism_level gte 2 and ($prisoner.love gte 45 or $prisoner.love gte 30 and $prisonerEvents.includes("comfort"))>>
	<<link [[끈을 놓는다|Hopeless Cycle Ending C]]>><</link>><<note "가학적인" "purple">>
	<br>
<<else>>
	<<insufficientStat "custom" "밧줄을 풀어주기에는" "purple" "가학성이">>
<</if>>

:: Hopeless Cycle Prayer Report 5
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>><<set $hc.daily.enteredDungeon to true>>
<<if $hc.gameOver>>
	<<set $hc.gameOver to false>>
<</if>>
<span class="narration">Despite the <<worldMale 'monk' 'nun'>>'s crime, the gaoler and the witch did not lose themselves. Make no mistake, <<worldMale 'he' 'she'>> was punished, but the punishment did not exceed the crime. Such was the duty of a gaoler.</span>
<br><br>

<<worldFemale 'She' 'He'>> lunges at <<worldMale 'him' 'her'>>. You tighten the cord just enough to force <<worldFemale 'her' 'him'>> to hold back. You have no intention to let <<worldMale 'him' 'her'>> leave unpunished, but you have enough kindness left in your heart to ensure <<worldMale 'he' 'she'>> isn't broken.
<br><br>

<<worldFemale 'She' 'He'>> gets <<worldFemale 'her' 'his'>> hands around <<worldMale 'him' 'her'>>. In <<worldFemale 'her' 'his'>> current state, <<worldFemale 'she' 'he'>>'s strong enough to hold <<worldMale 'him' 'her'>> down, to strike <<worldMale 'him' 'her'>>, to make sure that everything <<worldFemale 'she' 'he'>> does hurts. <<worldMale 'His' 'Her'>> punishment is gruelling. You pull <<worldFemale 'her' 'him'>> back each time you feel <<worldFemale 'she' 'he'>>'s going too far.
<br><br>

After fifteen minutes, you pull <<worldFemale 'her' 'him'>> off of <<worldMale 'him' 'her'>>. The Hand looks pleased.
<br><br>

The confessors re-enter the cell to retrieve the <<worldMale 'monk' 'nun'>>, who sobs and groans in pain. The Hand nods to you. "Continue as you will, <<worldMale 'brother' 'sister'>>." They all leave the dungeon. <<set $hc.handLocation to "prayerroom">>
<br><br>

<<if $prisonerEvents.includes("comfort")>>
	You start to pull <<worldFemale 'her' 'him'>> back to the wall. <<worldFemale 'Her' 'His'>> arms suddenly wrap around you, bringing you to the ground.
	<br><br>

	You struggle, worried that <<worldFemale 'she' 'he'>>'s still seeking further purging. You stop when you realise that <<worldFemale 'she' 'he'>>'s simply embracing you. <<worldFemale 'Her' 'His'>> head presses into your chest, and a warm smile is across <<worldFemale 'her' 'his'>> lips. <<set $prisoner.love += 10>><<hcPrisonerHealth 10>><<gglove>>
	<br><br>

	The usual chill and weakness from <<worldFemale 'her' 'his'>> touch is absent, if only for a moment. <<worldFemale 'She' 'He'>> releases you before it comes back.
<<else>>
	You pull <<print $prisoner.name>> back to the wall and re-secure <<worldFemale 'her' 'his'>> manacles. <<worldFemale 'She' 'He'>> looks satisfied. <<set $prisoner.love += 2>><<hcPrisonerHealth 10>><<hopelessCycleLove 1>>
<</if>>
<br><br>

<<link [[다음|Hopeless Cycle Cell]]>><<endevent>><<set $hc.daily.patrol to true>><<set $prisoner.state to "awake">><</link>>
<br>

:: Hopeless Cycle Passout
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<span class="narration">
	간수가 기절한 후, 많은 물건들이 발견되어 필요에 따라 반환되거나 소각되었다.
	<<if $witchItems>>
		<<unset $witchItems>>
		This included several items in the witch's cell, and on <<worldFemale 'her' 'his'>> person.
	<</if>>
</span>
<br><br>

<<if $bus is "cell">>
	당신은 따뜻함을 느끼며 깨어난다. 무언가 당신 위에 있다.
	<br><br>

	눈을 뜨자, 회색 눈 하나가 이쪽을 빤히 바라보고 있다. <<print window.KR.gatPersonNameDictKR($prisoner.name).toUpperFirst()>>【은는】 재빨리 네게서 떨어져 벽 쪽으로 기어 물러난다.
	<br><br>

	You feel strange, but <<worldFemale 'she' 'he'>> looks a little more healthy. <<purity -200>><<lllpurity>><<hcPrisonerHealth 3>>
	<br><br>

	<<link [[다음|Hopeless Cycle Cell]]>><<endevent>><</link>>
	<br>
<<else>>
	<<set $location to "old_temple">><<set $outside to 1>><<set $bus to "garden">>
	당신은 머리에 물이 쏟아지는 것을 느끼며 깨어난다. 당신은 눈을 뜨고 그 근원을 밀어내려 한다.
	<br><br>

	You look around. You're in the temple's garden, surrounded by some of your <<worldMale 'brothers' 'sisters' 'brothers and sisters'>>. One holds a bucket.
	<<if $hc.suspicionRevealed>>
		"I'm telling you, <<worldMale 'he' 'she'>>'s bewitched!"
		<br><br>

		One of them helps you stand. "We'll have to report this to the bishop, <<worldMale 'brother' 'sister'>>." <<hcSuspicion 15>><<hopelessCycleSus 3>>
	<<else>>
		<<set $hc.suspicionRevealed to true>>
		"<<worldMale 'Brother' 'Sister'>> Fayne, what's going on?" one asks. "This is not like you. We grow concerned."
		<br><br>

		다른 한 명이 끼어든다. "교단 내 일부는 당신이 홀렸다고 두려워하고 있습니다. 당신을 위해서라도, 우리가 틀렸다는 걸 증명하십시오. 곧." 군중이 흩어진다.
		<br><br>

		<span class="narration">The Bishop's Hand and <<worldMale 'his' 'her'>> confessors had been watching the gaoler. Now that <<worldMale 'he' 'she'>> knew this, <<worldMale 'he' 'she'>> would be more aware of what actions would make them suspicious.</span>
	<</if>>
	<br><br>

	<<link [[다음|Hopeless Cycle Garden]]>><<endevent>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Shortcut
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set _comingFrom to "Hopeless Cycle " + $bus.toLocaleUpperFirst()>>
<<set _goingTo to "Hopeless Cycle " + ($bus is "disposal" ? "Forest" : "Disposal")>>

횃불 빛에 의지해 축축한 동굴을 걷는다. 천장이 낮아질 때마다 가끔 몸을 웅크린다.
<<if !$hcChallenge.forestNoShortcut>>
	춥고 불편하지만, 마침내 모습을 드러낸다
	<<if $bus is "disposal">>
		숲 깊은 곳으로.
	<<else>>
		신전의 처리 수로에서.
	<</if>>
	<br><br>

	<<link [[다음|_goingTo]]>><</link>>
<<elseif $hc.shortcutCount is undefined>>
	<<set $hc.shortcutCount to 0>><<set $shortcut to {lost: 0}>>
	춥고 불편하며, 동굴은 거의 순환하는 것처럼 느껴지는 방식으로 구불구불하다. 진전이 있는지 알 수 없다.
	<br><br>

	모퉁이를 돌다가 허공처럼 보이는 것에 머리를 부딪친다. 혼란스러워하며 손을 앞으로 내민다. <span class="blue">유리 벽이 길을 막고 있다.</span> 더 이상 나아갈 수 없다.
	<br><br>

	돌아선다. <span class="red">동굴이 여러 방향으로 갈라진다.</span> 어느 쪽에서 왔는지조차 알 수 없다.
	<br><br>

	<<link [[첫 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 1>><</link>>
	<br>
	<<link [[두 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 2>><</link>>
	<br>
	<<link [[세 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 3>><</link>>
	<br>
	<<link [[네 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 4>><</link>>
	<br>
<<elseif $hc.shortcutCount is 0>>
	춥고 불편하지만, 마침내 모습을 드러낸다...
	<<if $bus is "disposal">>
		신전의 처리 수로에서.
	<<else>>
		숲 깊은 곳에서.
	<</if>>
	<br><br>

	뒤를 돌아본다. 길이 여러 익숙한 방향으로 갈라진다. 유리가 유리에 긁히는 소리가 들린다. <span class="purple">지나가려면 <<= $bus is "forest" ? "처리 수로에서" : "">> 제물을 바쳐야 한다.</span>
	<br><br>

	<<link [[돌아간다|_comingFrom]]>><</link>>
<<else>>
	<<set $hc.shortcutCount-->>
	춥고 불편하지만, 마침내 모습을 드러낸다
	<<if $bus is "disposal">>
		숲 깊은 곳으로.
	<<else>>
		신전의 처리 수로에서.
	<</if>>
	<br><br>

	<<if $hc.shortcutCount gte 1>>
		한 쌍의 눈이 당신을 지켜보는 것이 느껴지지만, 아무 소리도 들리지 않는다. 이 길을 <span class="blue"><<number $hc.shortcutCount>>번 더</span> 여행할 수 있다.
	<<else>>
		한 쌍의 눈이 당신을 지켜보는 것이 느껴지고, 유리가 유리에 긁히는 날카로운 소리가 들린다. <span class="red">더 이상 이 길을 여행할 허가가 없으며,</span> 지나가고 싶다면 다른 제물을 바쳐야 한다.
	<</if>>
	<br><br>

	<<link [[다음|_goingTo]]>><</link>>
<</if>>

:: Hopeless Cycle Shortcut Lost
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>

<span class="narration">
	<<if $phase is 0>>
		The gaoler doubled back along the path <<worldMale 'he' 'she'>> had just walked.
	<<elseif $phase is 10>>
		The gaoler examined the walls. As long as <<worldMale 'he' 'she'>> could see, <<worldMale 'he' 'she'>> could keep track of which paths <<worldMale 'he' 'she'>>'d been down.
	<<else>>
		The gaoler travelled along the <<print ordinalWritten($phase)>> path <<worldMale 'he' 'she'>> saw.
	<</if>>
</span>
<br><br>

<<if $shortcut.lost gte 5>>
	<<pain -2>>
	<<set _goingTo to $bus is "disposal" ? "숲" : "처리 통로">>
	<<set $shortcut.item to $hcItems.filter(item => item.location is "held" and item.type isnot "torch")[0]>>
	<<if $shortcut.item?.type is "container" and $hcItems.filter(x => x.type is "water" and x.location is $shortcut.item.containerID).length>>
		<<set $shortcut.itemName to "bucket of water">>
	<<elseif !$shortcut.item or $shortcut.item.persists>>
		<<set $shortcut.itemName to "roll of bandages">>
	<<else>>
		<<set $shortcut.itemName to hcItemName($shortcut.item)>>
	<</if>>
	또 다른 유리벽에 부딪힌다. 당신은 뒤로 물러나 그 너머를 보려고 한다.
	<br><br>

	아니. 이건 벽이 아니다. 거울이다.
	<br><br>

	당신은 거울을 들여다본다. <<= hcTranslateName($shortcut.itemName)>>【을를】 들고 <span class="orange">불 붙인 횃불</span>을 든 교도관이 당신을 마주 본다.
	거울 속 당신의 모습 뒤로, 가려던 <span class="green"><<= $bus is "forest" ? "처리 통로" : "숲">></span>【이가】 보인다.
	<br><br>

	<<link [[손을 뻗는다|Hopeless Cycle Shortcut Mirror]]>><<set $phase to 0>><</link>>
	<br>
	<<link [[몸을 돌려 _goingTo【으로로】 간다|Hopeless Cycle Shortcut Mirror]]>><<set $phase to 1>><</link>>
	<br>
<<else>>
	<<switch $shortcut.lost>>
		<<case 0>>
			이런 속임수에 대한 소문을 들은 적이 있다. 길이 당신을 거부하는 것은 당신이 그렇다고 믿기 때문이다.
			<br><br>
			당신은 걸으면서 횃불 손잡이로 동굴 벽을 긁는다. 긁히는 소리가 돌 같지 않다.
		<<case 1>>
			어딘지 모를 길에서 무언가 빠르게 덜거덕거리고 쿵쿵거리며 다가오는 소리가 들린다. 당신은 주위로 횃불을 휘둘러보지만, 아무것도 보이지 않는다.
		<<case 2>>
			<span class="red"><<= $hcItems.filter(torch => torch.type is "torch" and torch.state is "lit" and torch.location is "held").length is 1 ? "횃불이 꺼진다!" : "횃불들이 꺼진다!">></span>
			당신은 벽을 더듬어 찾는다. 아무런 표시도 느껴지지 않는다.
			<<run $hcItems.filter(torch => torch.type is "torch" and torch.state is "lit" and torch.location is "held").forEach(torch => {torch.state = "snuffed"})>>

			<<stress 6>><<gstress>>
		<<case 3>>
			당신은 길이 하나뿐이라고 믿으며 계속 나아가려 하지만, 벽에 부딪힌다.
			<<stress 6>><<pain 2>><<gstress>><<gpain>>
		<<case 4>>
			당신은 방향 감각을 잃고 헤매며 달린다. 아무것도 현실 같지 않다.
			<<stress 12>><<ggstress>>
	<</switch>>
	<<set $shortcut.lost++>>
	<br><br>

	앞에 더 많은 길이 갈라져 있다.
	<br><br>

	<<link [[왔던 길로 되돌아가 본다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 0>><</link>>
	<br>
	<<link [[첫 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 1>><</link>>
	<br>
	<<link [[두 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 2>><</link>>
	<br>
	<<link [[세 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 3>><</link>>
	<br>
	<<link [[네 번째 길을 따른다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 4>><</link>>
	<br>
	<<link [[다섯 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 5>><</link>>
	<br>
	<<if $shortcut.lost gte 2>>
		<<link [[여섯 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 6>><</link>>
		<br>
		<<if $shortcut.lost gte 3>>
			<<link [[일곱 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 7>><</link>>
			<br>
			<<if $shortcut.lost gte 4>>
				<<link [[여덟 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 8>><</link>>
				<br>
				<<link [[아홉 번째 길을 따라간다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 9>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
	<<if between($shortcut.lost,1,2)>>
		<<link [[표시가 있는 벽의 길을 찾는다 (0:01)|Hopeless Cycle Shortcut Lost]]>><<pass 1>><<set $phase to 10>><</link>>
	<</if>>
<</if>>

:: Hopeless Cycle Shortcut Mirror
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<set _goingTo to $bus is "disposal" ? "숲" : "처리 통로">>
<<set _comingFrom to $bus is "disposal" ? "처리 통로" : "숲">>
<<set _comingFromLink to "Hopeless Cycle " + $bus.toLocaleUpperFirst()>>
<<set $hcItems.filter(torch => torch.type is "torch" and ["snuffed","burnt"].includes(torch.state) and torch.location is "held")[0].state to "lit">>
<<wearProp "torch">>

<<if $phase is 0>>
	당신은 거울 앞으로 다가간다. 잠시 후, 거울 속 당신의 모습도 똑같이 따라 한다.
<<else>>
	당신은 뒤에 _goingTo【이가】 있기를 바라며 돌아선다. 보이는 것은 어둠 속으로 이어지는 더 많은 길뿐이다. 당신은 다시 돌아선다.
	<br><br>

	거울 속 당신의 모습이 거울 앞으로 다가온다. 잠시 후, 당신도 똑같이 따라 한다.
<</if>>
<br><br>

The reflection holds <<worldMale 'his' 'her'>> lit torch up. Feeling somewhat foolish, you raise your snuffed torch to match the movement.
<br><br>

<span class="green">당신의 횃불에 불이 붙는다.</span>
<br><br>

The reflection turns, letting go of <<worldMale 'his' 'her'>> torch. It remains in midair.
<<if $shortcut.itemName is "bucket of water">>
	<<worldMale 'He' 'She'>> takes <<worldMale 'his' 'her'>> bucket of water and empties it out to the side.
<<else>>
	<<worldMale 'He' 'She'>> takes <<worldMale 'his' 'her'>> <<print $shortcut.itemName>> and throws it to the side, as hard as <<worldMale 'he' 'she'>> can.
<</if>>
After a moment, <<worldMale 'he' 'she'>> picks up <<worldMale 'his' 'her'>> torch, turns around and continues on to the _goingTo.
<br><br>

<span class="blue">거울에 금이 간다.</span> 거울 속 모습이 얼어붙고, 불꽃의 흔들림이 완전히 멈춘다. 끔찍한 소리와 함께 거울이 산산조각 난다. 거울 뒤에는 _comingFrom【이가】 있다.
<br><br>

<span class="purple">공물을 바치지 않으면 지름길을 통과할 수 없다.</span> 처리 통로에 아이템을 버려 접근 권한을 얻으세요. 오염된 아이템은 더 가치 있는 공물로 간주됩니다.
<br><br>

<<link [[다음|_comingFromLink]]>><<unset $shortcut>><</link>>

:: Hopeless Cycle Blood Cell Late
<<set $location to "old_temple">><<set $outside to 0>><<set _thermoDisable to true>><<set $bus to "barracks">>

<<if $worn.upper.name isnot "chain tunic">>
	당신은 병영으로 가서 갑옷으로 갈아입는다.
	<<hopelessCycleOutfit "armour">>
	<br><br>
<</if>>

The Bishop's Hand finds you. "You're late. <span class="red">It's time, <<worldMale 'brother' 'sister'>>.</span> Bring the witch up at once."
<br><br>

You enter the dungeon. There's no one to sanctify you on the way in. You suppose it's pointless since you'll be bringing <<worldFemale 'her' 'him'>> out anyways.
<br><br>

<<link [[`${window.KR.gatPersonNameDictKR($prisoner.name)}의 감옥에 들어간다`|Hopeless Cycle Blood Cell]]>><<endevent>><</link>>
<br>

:: Hopeless Cycle Blood Cell
<<set $location to "old_temple">><<set $outside to 0>><<set _thermoDisable to true>><<set $bus to "cell">>
<<hopelessCycleOutfit "armour">><<canvas-model-override "mouth" "neutral">><<tiredness -12>>
<<run $hcItems.filter(items => items.type isnot "prisoner" and items.location isnot "prisoner").forEach(item => {hcItemRemove(item)})>>

<<if $phase is 1>>
	<<= window.KR.gatPersonNameDictKR($prisoner.name)>>【을를】 내려다본다.
<<elseif $phase is 2>>
	You just keep holding <<worldFemale 'her' 'him'>>. You know it can't last.
<<else>>
	<<= window.KR.gatPersonNameDictKR($prisoner.name)>>의 감옥에 들어간다.
<</if>>
<br><br>

<<if $prisoner.state is "catatonic">>
	<span class="red"><<worldFemale 'She' 'He'>> barely reacts to your presence. <<worldFemale 'She' 'He'>> doesn't even know what's coming in <<worldFemale 'her' 'his'>> catatonic state.</span>
	Perhaps that's for the best. Still, part of you wonders if you should have ensured <<worldFemale 'she' 'he'>> was healthier.
	<br><br>

	<<link [[다음|Hopeless Cycle Blood Pick Up]]>><</link>>
	<br>
<<elseif $prisoner.harmed gte Math.floor($prisoner.love / 6)>>
	<<worldFemale 'She' 'He'>> glares at you, not desiring any of your pity. You both know this is it.
	<br><br>

	You release the chain that holds <<worldFemale 'her' 'his'>> manacles to the wall and pick <<worldFemale 'her' 'him'>> up. <<worldFemale 'She' 'He'>> doesn't struggle, but refuses to look at you.
	<br><br>

	<<link [[다음|Hopeless Cycle Blood Carry]]>><<set $phase to 0>><</link>>
	<br>
<<else>>
	<<worldFemale 'She' 'He'>> looks up to you with worry. You both know this is it.
	<br><br>

	<<if $prisoner.love gte 60>>
		마음속으로 다른 길을 찾아보지만, 아무것도 떠오르지 않는다. 하고 싶지 않지만, 믿음이 그것을 요구한다.
		<br><br>
	<</if>>

	<<if $prisoner.love gte 80 and ($prisonerEvents.includes("kiss") or $prisonerEvents.includesAll("legs", "face", "talkMagic", "talkName", "washHair", "spendNight", "sex"))>>
		<<link [[Give <<worldFemale 'her' 'him'>> your heart|Hopeless Cycle Blood Love]]>><<set $prisoner.love += 10>><</link>><<hopelessCycleLove 3>>
		<br>
	<</if>>
	<<link [[Reassure <<worldFemale 'her' 'him'>>|Hopeless Cycle Blood Comfort]]>><<set $prisoner.love++>><</link>><<hopelessCycleLove 1>>
	<br>
	<<link [[Pick <<worldFemale 'her' 'him'>> up|Hopeless Cycle Blood Pick Up]]>><</link>>
	<br>
<</if>>

:: Hopeless Cycle Blood Love
<<set _thermoDisable to true>>
<<set $prisonerEvents.pushUnique("love")>>

You tell <<worldFemale 'her' 'him'>> that everything will be alright.<br>
You tell <<worldFemale 'her' 'him'>> that <<worldFemale 'she' 'he'>>'ll be redeemed, and that once this is over, you'll still take care of <<worldFemale 'her' 'him'>>.<br>
You tell <<worldFemale 'her' 'him'>> that you won't leave <<worldFemale 'her' 'his'>> side.<br>
You tell <<worldFemale 'her' 'him'>> that you don't care if physical contact with <<worldFemale 'her' 'him'>> drains you.<br>
You tell <<worldFemale 'her' 'him'>> no one is beyond forgiveness, and you've already forgiven <<worldFemale 'her' 'him'>>.<br>
You ask <<worldFemale 'her' 'him'>> to forgive you for the way you treated <<worldFemale 'her' 'him'>> at first. <<worldFemale 'She' 'He'>> nods, taking your hands.
<br><br>

You tell <<worldFemale 'her' 'him'>> that your heart is <<worldFemale 'hers' 'his'>>. <<worldFemale 'She' 'He'>> embraces you and nods into your shoulder.
<br><br>

위로가 되는 거짓말. 둘 다 사실이기를 바라는 거짓말.
<br><br>

적어도 맨 마지막 부분은 진실이었다.
<br><br>

You release the chain that holds <<worldFemale 'her' 'his'>> manacles to the wall and pick <<worldFemale 'her' 'him'>> up. <<worldFemale 'Her' 'His'>> arms wrap around you for stability, and <<worldFemale 'she' 'he'>> tries to hold you as tightly as <<worldFemale 'she' 'he'>> can.
<br><br>

<<link [[다음|Hopeless Cycle Blood Carry]]>><<set $phase to 3>><</link>>
<br>

:: Hopeless Cycle Blood Comfort
<<set _thermoDisable to true>>

You tell <<worldFemale 'her' 'him'>> that everything will be alright. It's a comforting lie, one <<worldFemale 'she' 'he'>> doesn't believe.
<br><br>

You release the chain that holds <<worldFemale 'her' 'his'>> manacles to the wall and pick <<worldFemale 'her' 'him'>> up. <<worldFemale 'She' 'He'>> holds on to you tightly.
<br><br>

<<link [[다음|Hopeless Cycle Blood Carry]]>><<set $phase to 2>><</link>>
<br>

:: Hopeless Cycle Blood Pick Up
<<set _thermoDisable to true>>

You release the chain that holds <<worldFemale 'her' 'his'>> manacles to the wall and pick <<worldFemale 'her' 'him'>> up. <<worldFemale 'She' 'He'>> doesn't struggle.
<br><br>

<<link [[Pick <<worldFemale 'her' 'him'>> up|Hopeless Cycle Blood Carry]]>><<set $phase to 1>><</link>>
<br>

:: Hopeless Cycle Blood Carry
<<set $outside to 0>><<set _thermoDisable to true>><<set $bus to "cloister">>
<<set $hc.forcedMove to true>><<run delete $hc.endingETimer>>
<<canvas-model-override "mouth" "neutral">><<canvas-model-override "eyes_half" true>>
<<canvas-model-override "arm_left" "none">><<canvas-model-override "arm_right" "none">>

<<set _witchClothes to $hcItems.find(clothes => clothes.type is "clothes" and clothes.location is "prisoner")?.name>>
<<hopelessCycleBrandings>>

<<if $prisonerEvents.includes("talkHairBlooms")>>
	<<set $hc.witchHair to "hair-flowers">>
<<elseif $prisonerEvents.includes("talkHair")>>
	<<set $hc.witchHair to "hair-braid">>
<<elseif $prisonerEvents.includes("washHair")>>
	<<set $hc.witchHair to "hair-clean">>
<<else>>
	<<set $hc.witchHair to "hair-dirty">>
<</if>>

<<if $prisoner.state is "catatonic" or $phase lte 1>>
	<<set _left_arm to "left-arm">>
	<<if _witchClothes is "robe">>
		<<set _clothes_left_arm to "robe-left-arm">>
	<</if>>
<<else>>
	<<set _left_arm to "left-arm-alt">>
	<<if _brandings.left_arm>>
		<<run delete _brandings.left_arm>>
	<</if>>
<</if>>

<<if $prisoner.bandagesOn>>
	<<set _bandages to "bandages">>
<</if>>

<<if _witchClothes is "robe">>
	<<set _clothes to "robe">>
<<elseif _witchClothes is "bloodstained sack" or _witchClothes is "torn vegetable sack">>
	<<set _clothes to "sack">>
<</if>>

<<set $follower to {
	name: "witchprisoner",
	base: "base",
	left_arm: _left_arm,
	clothes_left_arm: _clothes_left_arm,
	hair: $hc.witchHair,
	under_clothes: _bandages,
	clothes: _clothes,
	writing_right_cheek: _brandings.right_cheek,
	writing_chest: _brandings.chest,
	writing_left_arm: _brandings.left_arm,
	writing_right_arm: _brandings.right_arm,
	writing_right_shoulder: _brandings.right_shoulder,
	writing_right_thigh: _brandings.right_thigh,
	writing_right_leg: _brandings.right_leg,
	writing_right_foot: _brandings.right_foot
}>>
<<if $hcChallenge.faithBlooms>>
	<<set $follower.hair += "-challenge-faithBlooms">>
<</if>>

<<run Time.timeTravel(new DateTime(1390, 5, 31, 22, 0))>>
<<set Weather.set("clear", true, 1000)>>
<span class="narration">오늘날까지도 신전은 매달 마지막 날을 특별히 중시한다. 이 전통이 언제 시작되었는지는 불분명하지만, 수 세기 동안 이어져 왔다.</span>
<br><br>

You carry <<worldFemale 'her' 'him'>> from the cell, towards the dungeon stairs.
<<if $prisonerEvents.includes("love")>>
