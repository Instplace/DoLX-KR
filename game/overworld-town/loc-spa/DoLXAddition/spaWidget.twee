
:: Widgets VIP Spa [widget]

/* <<waxApply area days>> - Wax "full", "pubis", or "balls"; pauses regrowth for `days`.
Commits $pbwaxShape so only waxed hair keeps the style. */
<<widget "waxApply">>
	<<set _applyArea to _args[0]>>
	<<set _waxDuration to Math.round(_args[1] ?? 24)>>
	<<if _applyArea is "full" or _applyArea is "pubis">>
		<<set $pblevel to 0>>
		<<set $pbgrowth to 0>>
		<<set $pbstrip to $pbwaxShape ?? 0>>
		<<set $pbwax to _waxDuration>>
	<</if>>
	<<if _applyArea is "full" or _applyArea is "balls">>
		<<set $pblevelballs to 0>>
		<<set $pbgrowthballs to 0>>
		<<set $pbwaxballs to _waxDuration>>
	<</if>>
	<<if $pblevel is 0 and $pbstrip is 0 and $pblevelballs is 0>>
		<<set $makeup.pbcolour to 0>>
	<</if>>
<</widget>>

/* Tells the player how long they have before their pubic hair starts growing back. */
<<widget "waxStatus">>
	<<if $pbwax gte 1 or $pbwaxballs gte 1>>
		<<set _waxLeft to Math.max($pbwax ?? 0, $pbwaxballs ?? 0)>>
		<i>왁싱한 피부가 아직 매끈하다. 털은 <span class="green"><<print _waxLeft>>일</span> 동안은 다시 자라기 시작하지 않을 것이다.</i>
		<<if _args[0] isnot "compact">><br><</if>>
		<br>
	<</if>>
<</widget>>

/* Home waxing options. Needs enough length for the wax to grip, and a willpower check to see it through. */
<<widget "waxOptions">>
	<<if !$waxKits or $waxKits lt 1>>
		왁싱 키트가 다 떨어졌다. 화장품 가게에서 더 살 수 있다.
		<br><br>
	<<elseif $pblevel lt 3 and !($player.ballsExist and $pblevelballs gte 3)>>
		털이 아직 너무 짧아서 왁싱할 수 없다. 왁스가 털에 달라붙어 뽑아낼 수 있도록 먼저 더 길게 길러야 한다.
		<br><br>
	<<else>>
		왁싱 키트가 <span class="gold"><<print $waxKits>></span>개 남았다.
		<br><br>
		<<if $pblevel gte 3>>
			<<shavestyleicon 'clean'>><<link [[털 없이 왁싱한다 (0:30)|Wax Pubic Hair]]>><<set $phase2 to "wax">><<set $pbwaxShape to 0>><<set $pbwaxArea to ($player.ballsExist and $pblevelballs gte 3) ? "full" : "pubis">><<set $waxKits to $waxKits - 1>><<pass 30>><</link>><<willpowerdifficulty 200 900>>
			<br>
			<<shavestyleicon 'strip'>><<link [[일자 모양만 남기고 왁싱한다 (0:30)|Wax Pubic Hair]]>><<set $phase2 to "wax">><<set $pbwaxArea to ($player.ballsExist and $pblevelballs gte 3) ? "full" : "pubis">><<set $waxKits to $waxKits - 1>><<set $pbstripName to "neat landing strip">><<set $pbwaxShape to 1>><<pass 30>><</link>><<willpowerdifficulty 200 900>>
			<br>
			<<shavestyleicon 'heart'>><<link [[하트 모양만 남기고 왁싱한다 (0:30)|Wax Pubic Hair]]>><<set $phase2 to "wax">><<set $pbwaxArea to ($player.ballsExist and $pblevelballs gte 3) ? "full" : "pubis">><<set $waxKits to $waxKits - 1>><<set $pbstripName to "cute heart shape">><<set $pbwaxShape to 2>><<pass 30>><</link>><<willpowerdifficulty 200 900>>
			<br>
			<<shavestyleicon 'triangle'>><<link [[삼각형 모양만 남기고 왁싱한다 (0:30)|Wax Pubic Hair]]>><<set $phase2 to "wax">><<set $pbwaxArea to ($player.ballsExist and $pblevelballs gte 3) ? "full" : "pubis">><<set $waxKits to $waxKits - 1>><<set $pbstripName to "neat triangle">><<set $pbwaxShape to 3>><<pass 30>><</link>><<willpowerdifficulty 200 900>>
			<br>
		<</if>>
		<<if $player.ballsExist and $pblevelballs gte 3>>
			<<shavestyleicon 'balls'>><<link [[고환만 왁싱한다 (0:15)|Wax Pubic Hair]]>><<set $phase2 to "wax">><<set $pbwaxArea to "balls">><<set $waxKits to $waxKits - 1>><<pass 15>><</link>><<willpowerdifficulty 200 900>>
			<br>
		<</if>>
		<br>
	<</if>>
<</widget>>
