:: Jewellery Store [exitCheckBypass]
<<set $bus to "jewellerystore">>
<div id="clothingShop-div" class="main-shop-div">
	<<jewelleryShop-main>>
</div>

:: Jewellery Store Widgets [widget]

<<widget "jewelleryShop-main">>
	<<if $tryOn.autoReset isnot false>><<tryOnReset>><</if>><<unset $tempDisable>>
	<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>
	<<set $shopName = "jewellery">>

	당신은 보석 가게 안에 있다. 진열대 위에는 많은 장신구와 보석 세공품이 놓여 있다. 대부분 비싸 보인다.
	<br><br>

	<<if $stress gte $stressmax>>
		<<passoutshop>>
	<<else>>
		<<if Time.hour is 21>>
			폐점 시간이다. 경비원이 모든 사람을 밖으로 몰아내고 있다. <<if $exposed gte 1>>경비원이 이 옷차림을 본다면 얼마나 노출되어 있을지 깨닫고 공황 상태에 빠진다.<</if>>
			<br><br>

			<<if $exposed lte 0>>
				<<highicon>><<link [[밖으로 나간다|High Street]]>><</link>>
				<br>
			<<else>>
				<<ind>><<link [["끝날 때까지 숨는다 (1:00)"|Jewellery Store]]>><<pass 1 hour>><</link>>
			<</if>>
		<<else>>
			<div id="tryonstats-div"><<tryOnStats>></div>
			<<unset $shopListStartCount>>
			<<unset $clothes_choice>>
			<<set $shopPage = 0>>

			<<if Time.dayState is "night">>
				어둠 속에 당신 혼자 있다.
			<</if>>
			
			<br>

			<span>보온성:</span>
			<<warmthscale>>
			<div id="warmth-description">
				<<warmth_description>>
			</div>
			<br><br>
			<<clothingcategoryicon "all">>
			<<link "전체 보기">><<replace "#clothingShop-div">><<AllShop>><</replace>><</link>>
			<br><br>
			<<clothingcategoryicon "neck">>
			<<link "목 장식 보기">><<replace "#clothingShop-div">><<NeckShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "earrings">>
			<<link "귀걸이 보기">><<replace "#clothingShop-div">><<EarringsShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "rings">>
			<<link "반지 보기">><<replace "#clothingShop-div">><<RingsShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "hand">>
			<<link "장갑 보기">><<replace "#clothingShop-div">><<HandsShop>><</replace>><</link>>
			<br><br>
			<<run linkifyDivs('.button-back-to-shop')>>

			<<if Time.dayState is "night" and Time.hour isnot $closinghour and !$weekly.theft.jewelleryStore>>
				<<shopicon "register">><<link [[계산대를 살펴본다|Jewellery Store Register]]>><</link>>
				<br>
			<</if>>

			<br>

			<<if Time.dayState is "night" or $tryOn.value is 0>>
				<<if $tryOn.value gt 0 and Object.values(V.tryOn?.tryingOn).some(slot => slot?.type.includes("heavy"))>>
					<span class="red">착용해 보고 있는 장신구는 너무 무거워서 훔칠 수 없다!</span>
				<<elseif Time.dayState is "night" and $clothingShop.spotted is true and $clothingShop.stolenClothes gt 0>>
					<<getouticon>>
					<<link [[나간다|Jewellery Store Night Guard Found]]>>
						<<shopClothingFilterReset>>
						<<ShowUnderEquip "normal">>
						<<ShowUnderEquip "over">>
						<<buyTryOnClothes "wear" "steal">>
						<<set $tryOn.autoReset to true>>
						<<crimeUp `$tryOn.value / 100` "thievery">>
						<<shopHoodCheck>>
						<<shopCommandoCheck>>
					<</link>>
					<<if $tryOn.value gt 0>>
						<<crime "thievery">>
					<</if>>
					<<if $tryOn.value gt 0>>
						<br>
						<<shopTryOnTrespassPaymentLinks "Shopping Centre Top" "the jewellery">>
					<</if>>
				<<else>>
					<<getouticon>>
					<<link [[떠난다|Shopping Centre Top]]>>
						<<shopClothingFilterReset>>
						<<ShowUnderEquip "normal">>
						<<ShowUnderEquip "over">>
						<<buyTryOnClothes "wear" "steal">>
						<<set $tryOn.autoReset to true>>
						<<crimeUp `$tryOn.value / 100` "thievery">>
						<<shopHoodCheck>>
						<<shopCommandoCheck>>
					<</link>>
					<<if $tryOn.value gt 0>>
						<<crime "thievery">>
					<</if>>
					<<if $tryOn.value gt 0>>
						<br>
						<<shopTryOnTrespassPaymentLinks "Shopping Centre Top" "the jewellery">>
					<</if>>
				<</if>>
				<br><br>
			<<elseif $tryOn.value isnot 0>>
				<<icon "hanger.png">><<link "장신구를 반납한다">><<clothingReset>>
					<<updatesidebarimg>>
					<<updatesidebardescription>>
					<<updateallure>>
					<<updateclothingshop>>
					<<run updateMoment()>>
				<</link>>
				<br>
				<<if $tryOn.value gt 0 and $tryOn.value lte $money>>
					<<sendItemsToDropdown>>
					<<highicon>><<link "장신구를 산다">><<buyTryOnClothes "wear">><<updatesidebarmoney>><<updateclothingshop>><</link>>
					<br>
					<<wardrobeicon>><<link "장신구를 사서 옷장으로 보낸다">>
						<<buyTryOnClothes "wardrobe">>
						<<updatesidebarmoney>>
						<<updatesidebarimg>>
						<<updatesidebardescription>>
						<<updateallure>>
						<<updateclothingshop>>
						<<run updateMoment()>>
					<</link>>
					<br>
				<</if>>
				<<if $tryOn.value gt 0>>
					<<if Object.values(V.tryOn.tryingOn).some(slot => slot?.type.includes("heavy"))>>
						<span class="red">착용해 보고 있는 장신구는 너무 무거워서 훔칠 수 없다!</span>
					<<else>>
						<<getouticon>><<link [[Leave with stolen jewellery|Stolen Jewellery Store Result]]>><<shopClothingFilterReset>><<shopHoodCheck>><<shopCommandoCheck>><</link>><<crime "thievery">>
					<</if>>
					<br>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

:: Jewellery Store Sneak
<<set $outside to 0>><<effects>><<set $lock to 500>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		자물쇠를 딸 수 있을 것 같지만, <span class="blue">팔이 묶여 있지 않다면 말이다.</span>
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">>
		<<link [[딴다 (0:10)|Jewellery Store]]>>
			<<handheldon>><<pass 10>><<crimeUp 15 "trespassing">>
			<<if $clothingShop.ban gt 0 or crimeSumCurrent() gte 50000 or ($clothingShop.rng + 200) gte $skulduggery>>
				<<set $clothingShop.spotted to true>>
			<</if>>
			<<set $clothingShop.rng to random(0,1000)>>
		<</link>><<crime "trespassing">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>

<<getouticon>><<link [[나간다|Shopping Centre Top]]>><<handheldon>><</link>>
<br>
