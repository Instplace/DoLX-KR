:: Bike Depot Lock

<<set $outside to 0>><<effects>><<set $lock to 300>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		자물쇠를 딸 수 있을 것 같지만, <span class="blue">팔이 묶여 있지 않다면 말이다.</span>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>

		<<lockicon "pick">><<link [[딴다 (0:10)|Bike Depot]]>><<pass 10>><<crimeUp 5 "trespassing">><</link>><<crime "trespassing">>
	<</if>>
	<br>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>
<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>

:: Bike Depot
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

당신은 자전거 매장 안에 있다. 자전거 재고가 꽤 많다.
<br><br>
<<if $phase is 5>>
	당신은 수리 키트를 구입했고, 현재 소지량은 <span class="yellow"><<print $bicycle.durability.repair>></span>개가 되었다. <<if $bicycle.durability.repair lt 5>><<print (5 - $bicycle.durability.repair)>>개는 더 들고 다닐 수 있을 것 같다<<else>>더는 들고 다닐 수 없다<</if>>.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 4>>
	<<set _repairAmount to Math.round($bicycle.durability.max / 4)>>
	<<set $bicycle.durability.current to Math.min($bicycle.durability.current + _repairAmount, $bicycle.durability.max)>>
	당신의 자전거는 정비를 받아 사용 가능 시간이 <<print _repairAmount>>분 회복되었다.
	<br><br>
	<<set $phase to 0>><<unset _repairAmount>>
<<elseif $phase is 3>>
	당신의 고급형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 2>>
	당신의 중급형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 1>>
	당신의 기본형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.
	<br><br>
	<<set $phase to 0>>
<</if>>

<<if Time.dayState is "night">>
	어둠 속에 당신 혼자 있다.
	<br><br>
<<elseif $exposed gte 1>>
	당신은 자존심을 지키려고 자전거 거치대 뒤에 숨는다.
	<br><br>
<</if>>

<<if $stress gte $stressmax>>
	<<passoutshop>>
<<else>>
	<<if Time.hour is 21>>
		폐점 시간이다. 경비원이 모든 사람을 밖으로 몰아내고 있다.
		<<if $exposed gte 1>>
			경비원이 이 옷차림을 본다면 얼마나 수치스러울지 깨닫고 공황 상태에 빠진다.
		<</if>>
		<br><br>
		<<if $exposed lte 0>>
			<<highicon>><<link [[밖으로 나간다|High Street]]>><</link>>
			<br>
		<<else>>
			<<ind>><<link [["끝날 때까지 숨는다 (1:00)"|Bike Depot]]>><<pass 1 hour>><</link>>
		<</if>>
	<<else>>
		<<if Time.dayState is "night" and Time.hour isnot 21 and !$weekly.theft.bikeDepot>>
			<<shopicon "register">><<link [[계산대를 살펴본다|Bike Depot Register]]>><</link>>
			<br><br>
		<</if>>
		<<if $exposed lte 0 and Time.dayState is "night" and Time.hour isnot 21>>
			가져가기 전에 자전거 값을 두고 갈 수도 있다.
			<br><br>
			<<if !$bicycle.own or $bicycle.quality lt 3>>
				<<bikeDepotTrespassPayment "a high-end bike" 250000 3 4800>>
			<<else>>
				<span class="black">이미 고급형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<<if !$bicycle.own or $bicycle.quality lt 2>>
				<<bikeDepotTrespassPayment "an intermediate bike" 100000 2 2400>>
			<<elseif $bicycle.quality is 2>>
				<span class="black">이미 중급형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<<if !$bicycle.own>>
				<<bikeDepotTrespassPayment "a basic bike" 50000 1 800>>
			<<elseif $bicycle.quality is 1>>
				<span class="black">이미 기본형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<br>
		<<elseif $exposed lte 0 and Time.dayState isnot "night" and Time.hour isnot 21>>
			<<if !$bicycle.own or $bicycle.quality lt 3>>
				<<if $money gte (setup.inflation ? setup.inflation.price(250000) : 250000)>>
					<<bikeicon>><<link [[고급형 자전거를 구입한다 (<<printprice 250000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 3>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 3>><<set $bicycle.durability.current to 4800>><<set $bicycle.durability.max to 4800>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -250000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">고급형 자전거를 구입할 <<printprice 250000>>【이가】 없다.</span>
				<</if>>
				<br>
			<<else>>
				<span class="black">이미 고급형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<<if !$bicycle.own or $bicycle.quality lt 2>>
				<<if $money gte (setup.inflation ? setup.inflation.price(100000) : 100000)>>
					<<bikeicon>><<link [[중급형 자전거를 구입한다 (<<printprice 100000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 2>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 2>><<set $bicycle.durability.current to 2400>><<set $bicycle.durability.max to 2400>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -100000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">중급형 자전거를 구입할 <<printprice 100000>>【이가】 없다.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 2>>
				<span class="black">이미 중급형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<<if !$bicycle.own>>
				<<if $money gte (setup.inflation ? setup.inflation.price(50000) : 50000)>>
					<<bikeicon>><<link [[기본형 자전거를 구입한다 (<<printprice 50000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 1>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 1>><<set $bicycle.durability.current to 800>><<set $bicycle.durability.max to 800>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -50000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">기본형 자전거를 구입할 <<printprice 50000>>【이가】 없다.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 1>>
				<span class="black">이미 기본형 자전거를 가지고 있다.</span>
				<br>
			<</if>>
			<<if $bicycle.theftEnabled && $bicycle.security lt 0.99>>
				<<bikeicon>><<link [[보안 장비를 둘러본다 (0:05)|Bike Depot Security Gear]]>><<pass 5>><</link>>
				<br>
			<</if>>
			<<if ($bicycle.own && ($bicycle.durability.current lt $bicycle.durability.max))>>
				<<if $bicycle.durability.repair is undefined>><<generate1>><<person1>>
					<<if currentSkillValue('skulduggery') gte 600 || currentSkillValue('science') gte 600>>
						<<set $bicycle.durability.repair to 1>>
						<br>
						계산대 근처에서 서성이던 직원이 당신과 낡은 자전거를 잠시 훑어본다.
						<br><br>
						"공구 한두 개쯤은 다룰 줄 아는 것 같네요. 필요할 때마다 작은 수리는 직접 할 수 있게 키트를 좀 팔아 드릴까요?"
						<br><br>
						<<He>>【은는】 당신이 대답하기도 전에 작은 꾸러미를 건넨다. "이건 서비스로 드리는 거예요. 낭비하지 마세요."
						<br><br>
						<span class="blue">직원들은 당신의 솜씨를 알아보고, 당신에게 공구를 파는 것이 세상에서 가장 큰 실수는 아닐 거라고 판단했다. 그들이 후회하게 만들지는 말자.</span>
					<<else>>
						<br>
						계산대 근처에서 서성이던 <<personsimple>>【이가】 당신과 낡은 자전거를 잠시 훑어본다.
						<br><br>
						<<He>>【은는】 감흥 없는 표정으로 하던 일을 계속한다. <span class="blue">과학을 더 알거나 손재주가 더 좋았다면 감명을 줄 수도 있었을 것이다.</span>
					<</if>>
					<br><br>
					<<endevent>>
				<</if>>
				<<if $money gte (setup.inflation ? setup.inflation.price(35000) : 35000)>>
					<<bikeicon>><<link [[자전거를 수리한다 (<<printprice 35000>> 0:20)|Bike Depot]]>><<pass 20>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -35000 "bikeDepot">><<set $phase to 4>><</link>>
				<<else>>
					<span class="red">자전거를 수리할 <<printprice 35000>>【이가】 없다.</span>
				<</if>>
			<</if>>
			<<if $bicycle.durability.repair isnot undefined>>
				<br>
				<<if $bicycle.durability.repair lt 5>>
					<<if $money gte (setup.inflation ? setup.inflation.price(5000) : 5000)>>
						<<birdicon "tools">><<link [[수리 키트를 구입한다 (<<printprice 5000>> 0:05)|Bike Depot]]>><<pass 5>><<money -5000 "bikeDepot">><<set $bicycle.durability.repair++>><<set $phase to 5>><</link>>
					<<else>>
						<span class="red">수리 키트를 살 <<printprice 5000>>【이가】 없다.</span>
					<</if>>
					<br>
				<</if>>
			<</if>>
			<br>
		<</if>>
		<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Bike Depot Security Gear
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

당신은 보안 장비를 둘러본다.
<br><br>

<<if $bicycle.security lt 0.99>>
	<<if $money gte (setup.inflation ? setup.inflation.price(100000) : 100000)>>
		<<link [[경보기 달린 U형 자물쇠를 구입한다 (<<printprice 100000>>)|Bike Depot]]>><<money -100000 "bikeDepot">><<set $bicycle.security to 0.99>><</link>><<note "도난 방지율 99%">>
	<<else>>
		<span class="red">경보기 달린 U형 자물쇠를 구입할 <<printprice 100000>>【이가】 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.99>>
	이미 경보기 달린 U형 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.8>>
	<<if $money gte (setup.inflation ? setup.inflation.price(75000) : 75000)>>
		<<link [[U형 자물쇠를 구입한다 (<<printprice 75000>>)|Bike Depot]]>><<money -75000 "bikeDepot">><<set $bicycle.security to 0.8>><</link>><<note "도난 방지율 80%">>
	<<else>>
		<span class="red">U형 자물쇠를 구입할 <<printprice 75000>>【이가】 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.8>>
	이미 U형 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.5>>
	<<if $money gte (setup.inflation ? setup.inflation.price(50000) : 50000)>>
		<<link [[강화강 중량 체인 자물쇠를 구입한다 (<<printprice 50000>>)|Bike Depot]]>><<money -50000 "bikeDepot">><<set $bicycle.security to 0.5>><</link>><<note "도난 방지율 50%">>
	<<else>>
		<span class="red">강화강 중량 체인 자물쇠를 구입할 <<printprice 50000>>【이가】 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.5>>
	이미 강화강 중량 체인 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.3>>
	<<if $money gte (setup.inflation ? setup.inflation.price(25000) : 25000)>>
		<<link [[일반 체인 자물쇠를 구입한다 (<<printprice 25000>>)|Bike Depot]]>><<money -25000 "bikeDepot">><<set $bicycle.security to 0.3>><</link>><<note "도난 방지율 30%">>
	<<else>>
		<span class="red">일반 체인 자물쇠를 구입할 <<printprice 25000>>【이가】 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.3>>
	이미 일반 체인 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.1>>
	<<if $money gte (setup.inflation ? setup.inflation.price(10000) : 10000)>>
		<<link [[바퀴 자물쇠를 구입한다 (<<printprice 10000>>)|Bike Depot]]>><<money -10000 "bikeDepot">><<set $bicycle.security to 0.1>><</link>><<note "도난 방지율 10%">>
	<<else>>
		<span class="red">바퀴 자물쇠를 구입할 <<printprice 10000>>【이가】 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.1>>
	이미 바퀴 자물쇠를 가지고 있다.
	<br>
<</if>>
<br>
<<getouticon>><<link [[뒤로|Bike Depot]]>><</link>>

:: Bike Depot Widgets [widget]
<<widget "bikeDepotTrespassPayment">>
	<<set _bikeName to _args[0]>>
	<<set _bikePrice to _args[1]>>
	<<set _bikeLevel to _args[2]>>
	<<set _bikeDurability to _args[3]>>
	<<set _bikeCost to (setup.inflation ? setup.inflation.price(_bikePrice) : _bikePrice)>>
	<<set _bikeExtraBase to Math.ceil(_bikePrice * 1.25)>>
	<<set _bikeExtraCost to (setup.inflation ? setup.inflation.price(_bikeExtraBase) : _bikeExtraBase)>>
	<<capture _bikeName _bikePrice _bikeLevel _bikeDurability>>
		<<if $money gte _bikeCost>>
			<<bikeicon>><<link [["정확한 금액을 두고 간다: " + _bikeName + " (0:05)"|Shop Trespass Payment Result]]>>
				<<pass 5>>
				<<set $phase to _bikeLevel>>
				<<set $bicycle.own to true>><<set $bicycle.stolen to false>>
				<<set $bicycle.quality to _bikeLevel>>
				<<set $bicycle.durability.current to _bikeDurability>><<set $bicycle.durability.max to _bikeDurability>>
				<<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">>
				<<shopTrespassPayment _bikePrice "bikeDepot" false "Bike Depot" _bikeName>>
			<</link>><<crime "trespassing">>
		<<else>>
			<span class="red">_bikeName 값을 정확히 맞춰 두고 갈 돈이 부족하다.</span>
		<</if>>
		<br>
		<<if $money gte _bikeExtraCost>>
			<<bikeicon>><<link [["웃돈을 얹어 두고 간다: " + _bikeName + " (0:05)"|Shop Trespass Payment Result]]>>
				<<pass 5>>
				<<set $phase to _bikeLevel>>
				<<set $bicycle.own to true>><<set $bicycle.stolen to false>>
				<<set $bicycle.quality to _bikeLevel>>
				<<set $bicycle.durability.current to _bikeDurability>><<set $bicycle.durability.max to _bikeDurability>>
				<<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">>
				<<shopTrespassPayment _bikePrice "bikeDepot" true "Bike Depot" _bikeName>>
			<</link>><<crime "trespassing">>
			<br>
		<</if>>
	<</capture>>
<</widget>>
