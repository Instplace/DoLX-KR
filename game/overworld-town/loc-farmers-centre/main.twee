		<</if>>
	<<elseif $factoryUpgrades.distribution is 1>>
		<<if setup.inflation.canAfford(1000000)>>
			<<link [[지역 화물 거점 (<<printprice 1000000>>)|Farmers Centre Upgrades]]>>
				<<money -1000000>>
				<<set $factoryUpgrades.distribution to 2>>
			<</link>>
			<<note "+20% 수량" "green">>
		<<else>>
