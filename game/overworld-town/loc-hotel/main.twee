                    <br><br>
                <</if>>
                <<link [[무시한다|Seaspray Hotel]]>><<endevent>><<set $eventskip to 1>><</link>>
                <br>
            <</addinlineevent>>

            <<addinlineevent "hotel_7" 1>>
                <<generatey1>><<generatey2>><<person1>>
                <<person>>【와과】 <<person2>><<person>>【이가】 계단 밑에서 이야기를 나누고 있다. 당신이 지나가자 목소리를 낮춘다.
                <br><br>

                <<link [[다음|Seaspray Hotel]]>><<endevent>><<set $eventskip to 1>><</link>>
