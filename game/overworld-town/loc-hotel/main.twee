                    <br><br>

                    <<link [[다음|Seaspray Hotel]]>><<endevent>><<set $eventskip to 1>><</link>>
                    <br>
                <</if>>
            <</addinlineevent>>

            <<addinlineevent "hotel_10" 1>>
                <<generate1>><<person1>><<person>>【이가】 당신을 따라오는 것 같다.
                <br><br>

