:: Rent First Robin Fight
<<if $fightstart is 1>>
	<<set $fightstart to 0>>
	<<set $enemyno to 1>>
	<<set $head to "grappled">>
	<<set $leftarm to "grappled">><<set $rightarm to "grappled">><<set $NPCList[1].lefthand to "arms">><<set $NPCList[2].righthand to "arms">>
	<<neutral 1>>

	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
<</if>>

<<effects>><<effectsman>>
<br>
<<person1>>
<<if $combatPhase is "talk">>
	<<switch $timer>>
		<<case 4>>
			베일리가 당신을 쳐다본다.
		<<case 3>>
			베일리가 돌아서서 걸어간다.
		<<case 2>>
			베일리가 복도를 따라 걸어가다 모퉁이를 돌아 시야에서 사라진다.
		<<case 1>>
			베일리가 무언가 말하는 소리가 들리고, <span class="purple">그 뒤로 <<nnpc_gendery "Robin">>의 비명 소리가 들린다</span>.
		<<default>>
			베일리가 <span class="red">로빈의 <<nnpc_his "Robin">> 머리채를 잡고 복도에서 돌아온다</span>.
			<<set $combatPhase to "Robin">><<set $timer to 2>><<set $baileySpoke to 0>>
	<</switch>>
	<br>
	<span class="red"><<person2>><<person>>【와과】 <<person3>><<person>>【이가】 당신을 단단히 붙잡는다.</span>
<<elseif $combatPhase is "Robin">>
	<<if $timer gte 1>>
		<<switch $baileySpoke>>
			<<case 2>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechScreamForHelp is 1 or $speechDemand is 1 or $speechApologiseUnforgiving is 1>>
					"숨 돌릴 생각 마." 베일리가 말한다. "정말로 <<nnpc_him "Robin">>【을를】 구하고 싶다면, 아직 돈을 낼 기회는 있어."
				<<else>>
					"내가 오래전에 말했지." 베일리가 말한다. "내 돈을 가져오든가... 아니면 네놈한테서 어떻게든 가치를 뽑아낼 거라고."
				<</if>>
			<<case 1>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechApologiseUnforgiving is 1>>
					베일리가 <<his>> 눈을 굴린다. "제때 돈을 냈더라면, 지금처럼 울고불고하지 않아도 됐을 텐데."
					<<set $baileySpoke++>>
				<<elseif $speechScreamForHelp is 1 or $speechDemand is 1>>
					"소리 지르면 내가 설득될 것 같아?" 베일리가 비웃는다.
					<<set $baileySpoke++>>
				<<else>>
					"갚을 생각도 없었으면서 애초에 왜 이 약골의 빚을 떠맡았는지 모르겠군." 베일리가 비웃는다.
				<</if>>
			<<default>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechApologiseUnforgiving is 1>>
					베일리가 당신을 비웃는다. "오, 이제 와서 미안하다고? 벌을 받게 생기니까?"
					<<set $baileySpoke++>>
				<<elseif $speechScreamForHelp is 1 or $speechDemand is 1>>
					"닥쳐." 베일리가 당신에게 쏘아붙인다. "네가 대가를 치르지 않았으니, <<nnpc_he "Robin">>【이가】 치르게 될 거다."
					<<set $baileySpoke++>>
				<<else>>
					"알겠어?" 베일리가 로빈을 보며 말한다. "<<pShe "Bailey">>【이가】 대가를 치르지 않았으니, 네가 치르게 될 거다."
				<</if>>
		<</switch>>
		<<if C.npc.Robin.trauma gte 20 or C.npc.Robin.dom lte 30>>
			<<print either("로빈이 눈물 어린 눈으로 당신을 쳐다본다.","로빈이 훌쩍인다.","로빈이 베일리의 손아귀에서 힘없이 버둥거린다.","로빈이 당신에게 손을 뻗는다.")>>
		<<else>>
			<<print either("로빈은 용감한 표정을 짓는다.","로빈이 <<nnpc_his \"Robin\">> 이빨을 악문다.","로빈이 베일리의 손아귀에서 발버둥친다.","로빈이 베일리의 손아귀에서 거의 빠져나올 뻔한다.")>>
		<</if>>
	<<else>>
		"<<nnpc_him "Robin">>【을를】 안전하게 지키고 싶어?" 베일리가 묻는다. "내게 말해. 앞으로는 돈을 내겠다고."
		<<if C.npc.Robin.trauma gte 1 or C.npc.Robin.dom lte 30>>
			로빈이 딸꾹질한다.
		<<else>>
			로빈이 <<nnpc_his "Robin">> 고개를 젓는다.
		<</if>>
		<<set $combatPhase to "pay">><<set $timer to 2>>
	<</if>>
	<br>
	<span class="red"><<person2>><<person>>【와과】 <<person3>><<person>>【이가】 당신을 단단히 붙잡는다.</span>
<<elseif $combatPhase is "pay">>
	<<if $speechPay is 1>>
		"그래, 그거야." 베일리가 비웃는다. "그게 그렇게 어려웠어?" <<He>>【이가】 <<his>> 부하들에게 손짓하자, 그들이 당신의 팔을 놓아준다.
		<<set _fin to 1>>
	<<elseif $speechPay is -1>>
		"이런, 안됐군." 베일리가 비웃는다. "하지만 내가 관대하게 굴어주지. 아직 <<nnpc_him "Robin">>【을를】 구할 수 있어. 그냥 가만히 있어."
		<br>
		로빈이 필사적으로 <<nnpc_his "Robin">> 고개를 젓는다.
		<<set $combatPhase to "still">><<set $timer to 2>>
	<<elseif $timer is 1>>
		베일리가 <<his>> 시계를 확인하는 척한다. "난 바쁜 <<personsimple>>【이】야. 만약 네가 <i>돈을 내지</i> 않는다면, 난 떠나겠어."
		<br>
		<span class="red"><<person2>><<person>>【와과】 <<person3>><<person>>【이가】 당신을 단단히 붙잡는다.</span>
	<<else>>
		"볼일 끝났어." 베일리가 비웃는다. "<<nnpc_him "Robin">> 대신 돈을 낼 생각이 없었다면, 애초에 내 시간을 낭비하지 말았어야지."
		<<set $finish to 1>><<set _fin to 1>>
	<</if>>
<<elseif $combatPhase is "still">>
	<<if _defiance is undefined>>
		"좋아." 베일리가 부하들에게 고개를 끄덕이며 말한다. <<He>>【이가】 당신의 팔을 잡고 있는 부하들에게 고개를 끄덕이자, 그들이 당신을 고아원 밖으로 끌고 나간다.
		<br><br>
		<span class="red">당신이 끌려 나가는 동안 로빈이 눈물을 흘리며 당신의 이름을 외친다.</span>
		<<set _fin to 1>>
	<<elseif $timer is 1>>
		"내 말 들었어?" 베일리가 으르렁거린다. "<<nnpc_he "Robin">>【이가】 당하는 걸 원치 않으면, <i>발버둥치지 마</i>. 그냥 가만히 있어."
		<br>
		<span class="red"><<person2>><<person>>【와과】 <<person3>><<person>>【이가】 당신을 단단히 붙잡는다.</span> <<person2>><<person>>【이가】 더 세게 움켜쥔다.
	<<else>>
		베일리가 얼굴을 찌푸린다. "볼일 끝났어. <<nnpc_him "Robin">> 대신 돈을 낼 생각이 없었다면, 애초에 내 시간을 낭비하지 말았어야지."
		<<set $finish to 1>><<set _fin to 1>>
	<</if>>
<</if>>
<br><br>
<<if _fin isnot 1>>
	<<actionsman>>
<</if>>

<<if $combatPhase is "pay" and $speechPay is 1>>
	<span id="next"><<link [[다음|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "pay">><</link>></span><<nexttext>>
<<elseif $combatPhase is "still" and _defiance is undefined>>
	<span id="next"><<link [[다음|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "still">><</link>></span><<nexttext>>
<<elseif $finish is 1>>
	<span id="next"><<link [[다음|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "finish">><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Rent First Robin Fight]]>><</link>></span><<nexttext>>
<</if>>
<<turnend>>

:: Rent First Robin Fight Finish
<<effects>><<speechresolve>>
<<unset $robinRentEvent>>
<<set _robin to statusCheck("Robin")>>
<<npc Robin 1>><<person1>>

<<if $phase is "pay">>
	베일리가 로빈을 놓아주자, 로빈은 당신에게 달려와 끌어안는다. <<He>>【이가】 가만히 흐느낀다.
	<br><br>
	<<rentpay>>

	베일리가 떠난 후에도 로빈은 계속 당신에게 매달려 있다.
	<<if _robin.trauma gte 40>>
		"나-나는..." <<He>>【이가】 목이 메어 당신을 더 세게 껴안는다.
	<<else>>
		"널 잃는 줄 알았어." 한참 뒤에야 <<he>>【이가】 말한다.
	<</if>>
	<br><br>

	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			당신은 <<his>> 손을 부드럽게 잡고, <<if $robinromance is 1>><<his>> 이마에 위로의 입맞춤을 한다<<else>>다른 쪽 팔로 <<his>> 어깨를 감싼다<</if>>.
		<<case "polite" "flamboyant">>
			당신은 로빈의 손을 두 손 사이에 포개 쓰다듬고, <<if $robinromance is 1>><<his>> 이마에 다정하게 입을 맞춘다<<else>><<his>> 숨소리가 진정될 때까지 <<him>>【을를】 단단히 붙잡아 준다<</if>>.
		<<case "confident" "bratty" "cruel">>
			당신은 먼저 로빈을 꼭 끌어당기고는, <<if $robinromance is 1>><<his>> 얼굴을 살짝 들어 올려 이마에 안심시키는 입맞춤을 한다<<else>><<his>> 어깨에 팔을 두르고 <<him>>【을를】 그대로 붙들어 둔다<</if>>.
		<<default>>
			당신은 <<his>> 손을 부드럽게 잡고, <<if $robinromance is 1>><<him>>의 이마에 달래듯 입을 맞춘다<<else>>다른 쪽 팔로 <<his>> 어깨를 감싸 안으며 다독인다<</if>>.
	<</switch>>
	<<takeHandholdingVirginity "Robin">>
	<br><br>

	로빈은 눈물이 잦아들며 간신히 진정한다.
	<<if _robin.dom gte 30>>
		"더 강해져야 해..." <<he>>【이가】 고개를 저으며 숨죽여 속삭인다.
	<</if>>
	"고마워. 전부 다." <<he>>【이가】 말한다. <<He>>【은는】 마침내 당신을 놓아주고 제 방으로 돌아간다.
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[다음|Orphanage]]>><</link>>
<<elseif $phase is "still">>
	패거리들이 당신을 끌고 간다. 당신을 부르는 로빈의 울음소리가 들린다. <<His>> 울음소리는 고아원을 벗어나자 점차 잦아든다.
	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			발걸음을 뗄 때마다 끝이라는 느낌이 들고, 베일리가 당신을 멈춰 세울 즈음에는 다리에 힘이 풀려 있다.
		<<case "polite" "flamboyant">>
			그 소리에 얼마나 흔들렸는지 베일리가 알아채지 못하게 애쓰지만, 그 노력은 가슴만 더 아프게 할 뿐이다.
		<<case "confident" "bratty" "cruel">>
			걸어 나가는 동안 분노에 매달린다. 당신을 통째로 삼킬 듯한 죄책감보다 짊어지기 쉬우니까.
		<<default>>
			베일리가 당신을 멈춰 세울 즈음, 로빈의 목소리는 멀게 느껴지지만 덜 끔찍하지는 않다.
	<</switch>>
	당신은 베일리와 마주한다.
	<br><br>

	<<npc Bailey 2>><<person2>>
	"자, 이게 그렇게 어려웠나?" 베일리가 당신의 머리에 자루를 씌우고 팔을 묶으며 비웃는다. "네 알량한 친구는 구했군. 이번에는 말이야."
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[다음|Rent Intro]]>><</link>>
<<else>>
	<<robinPunishment "mansion">>
	베일리가 로빈을 끌고 간다. 당신은 패거리들의 손아귀에서 벗어나려 발버둥 치지만, 빠져나올 수 없다.
	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			무력감이 당신을 덮친다.
		<<case "polite" "flamboyant">>
			로빈을 한 번 부르지만, 베일리가 당신이 무너지는 소리를 듣고 싶어 한다는 걸 깨닫고 나머지 말을 삼킨다.
		<<case "confident" "bratty" "cruel">>
			패거리가 욕을 내뱉을 만큼 세게 맞서 싸우지만, 팔의 얼얼함 말고는 아무것도 달라지지 않는다.
		<<default>>
			그들이 떠나는 모습을 지켜보는 것밖에 할 수 없다.
	<</switch>>
	<br><br>

	잠시 후 베일리가 돌아와 당신을 비웃는다. "내가 관대하니까 이번엔 경고로 끝내지. 내 돈 가져와. 안 그러면 다음엔 저 녀석이 대가를 치르게 될 테니까."
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[다음|Orphanage]]>><</link>>
<</if>>

:: Thug Rent
<<set $location to "home">><<effects>>

<<if $phase is "unwilling">>
	잠시 후, 차가 고아원 앞에 멈춘다. "다 왔다. 도망칠 생각은 하지 마. 이미 너무 늦었으니까," <<person1>><<person>>【이가】 말한다.
	<<if $exposed gte 1>>
		<<He>>【은는】 당신의 드러난 몸을 훑어본다. "몸 가려. 구경꾼들이 오해하면 곤란하니까," <<he>>【이가】 말하며 수건을 던져 준다. 당신은 수건을 몸에 두른다.
		<<towelup>>
	<</if>>
	<<switch $event.buffer.length>>
		<<case 1>><<He>>【은는】 당신을 거칠게 차에서 끌어내 고아원 안으로 데려간다.
		<<case 2>><<He>>【은는】 당신을 거칠게 차에서 끌어내고, <<person2>><<person>>【은는】 당신을 바짝 지켜본다. <<He>>【은는】 <<person1>><<person>>【이가】 당신을 현관까지 데려가는 것을 지켜본 뒤 차에 다시 올라탄다.
		<<case 3>><<He>>【은는】 당신을 거칠게 차에서 끌어내고, <<person2>><<person>>【와과】 <<person3>><<person>>【은는】 당신을 바짝 지켜본다. 그들은 <<person1>><<person>>【이가】 당신을 현관까지 데려가는 것을 지켜본 뒤 차에 다시 올라탄다.
	<</switch>>
	<br><br>
	중앙 홀에서 베일리가 당신을 기다리고 있는 것이 보인다.<<if $robinfirstrentfight is 1>> 옆에는 묶여 있는 로빈도 있다.<</if>>
<<elseif $phase is "willing">>
	잠시 후, 차가 고아원 앞에 멈춘다. "다 왔어. 어서 가. <<nnpc_him "Bailey">>【을를】 이미 충분히 기다리게 했으니까," <<person1>><<person>>【이가】 말한다.
	<<if $exposed gte 1>>
		<<He>>【은는】 당신의 드러난 몸을 훑어본다. "그 꼴로 보스 앞에 설 수는 없지." <<he>>【이가】 말하며 수건을 던져 준다. 당신은 수건을 몸에 두른다.
		<<towelup>>
	<</if>>
	<<switch $event.buffer.length>>
		<<case 1>>당신은 차에서 내려 고아원 안으로 인도된다.
		<<case 2>>당신은 차에서 내려 <<person2>><<person>>【이가】 지켜보는 가운데 고아원 안으로 인도된다. 현관에 닿자 <<he>>【은는】 다시 차에 올라탄다.
		<<case 3>>당신은 차에서 내려 <<person2>><<person>>【와과】 <<person3>><<person>>【이가】 지켜보는 가운데 고아원 안으로 인도된다. 현관에 닿자 그들은 다시 차에 올라탄다.
	<</switch>>
	<br><br>
	중앙 홀에서 베일리가 이미 당신을 기다리고 있는 것이 보인다.<<if $robinfirstrentfight is 1>> 옆에는 묶여 있는 로빈도 있다.<</if>>
<<elseif $phase is "unwilling van">>
	잠시 후, 밴이 멈춘다. "도착한 모양이군." <<person1>><<person>>【이가】 전화기를 집어넣으며 말한다. "일어나. 그리고 도망칠 생각은 하지 마. 이미 너무 늦었으니까."
	<<if $exposed gte 1>>
		<<He>>【은는】 당신의 드러난 몸을 훑어본다. "몸 가려. 구경꾼들이 오해하면 곤란하니까," <<he>>【이가】 말하며 수건을 던져 준다. 당신은 수건을 몸에 두른다.
		<<towelup>>
	<</if>>
	<br><br>
	그들 모두 당신을 고아원 문까지 데려가지만, 안으로 들어가는 것은 당신과 <<person>>뿐이다. 중앙 홀에서 베일리가 이미 당신을 기다리고 있는 것이 보인다.<<if $robinfirstrentfight is 1>> 옆에는 묶여 있는 로빈도 있다.<</if>>
<</if>>
<<saveNPC 0 "rent_thug">><<endevent>>

<<if $robinfirstrentfight is 1>>
	<<thugrentduerobin>>
<<else>>
	<<thugrentdue>>
<</if>>

:: Tutorial Bailey
<<set $outside to 1>><<set $location to "town">><<effects>>
<<npc Bailey 1>>

누군가 어깨에 손을 올리는 것이 느껴진다. 돌아보니 베일리다.
<br><br>
"바깥세상에 온 걸 환영한다. 일주일 내내 아무것도 안 한 것에 대해 교훈을 얻었길 바라지." <<he>>【이가】 말한다. "이번 주에는 더 열심히 하길 기대하마. 또 돈을 못 내면 어떻게 되는지 보고 싶지 않을 테니 말이야."
<br><br>
당신은 베일리의 손에 이끌려 침실로 돌아와 홀로 남겨진다.
<br><br>

<<link [[다음|Bedroom]]>><<endevent>><</link>>
:: Widgets Bailey Confiscation [widget]
/* Bailey Confiscation System */

<<widget "baileyConfiscationList">>
	<<set _list to baileyConfiscationParts()>><<if _list.length is 0>>당신의 물건<</if>><<for _p range _list>><<print _p.sep>><<if _p.kind is "furniture">><<if _p.icon>><<furnitureicon _p.icon>> <</if>><<elseif _p.kind is "clothing">><<clothingicon _p.item _p.slot>> <</if>><<print _p.name>><</for>>
<</widget>>

<<widget "baileyConfiscationListFull">>
	<<set _list to baileyConfiscationGrouped()>><<if _list.length is 0>>당신의 물건<</if>><<for _p range _list>><<print _p.sep>><<if _p.count gt 1>><<print _p.count>>× <</if>><<if _p.kind is "furniture">><<if _p.icon>><<furnitureicon _p.icon>> <</if>><<elseif _p.kind is "clothing">><<clothingicon _p.item _p.slot>> <</if>><<print _p.name>><</for>>
<</widget>>

<<widget "baileyRentConfiscation">>
	<<babyRent true>>
	<<set _weekRent to $rentMoney + ($babyRent || 0)>>
	<<set _bundle to baileyConfiscationBundle(_weekRent)>>
	<<if _bundle.items.length is 0>>
		뒤에서 누군가의 손이 당신의 어깨에 얹힌다. <span class="red">베일리다.</span>
		<<if $robinfirstrentfight and ($baileypaychain lt 2 or $rentTime lte -1) and _robinAtOrphanage>>
			<<rentduerobin 0>>
		<<else>>
			<<rentdue 0>>
		<</if>>
	<<else>>
		<<npc Bailey>><<person1>>
		<<run baileyConfiscationApply(_bundle)>>

		고아원에 들어서자 당신의 방 밖 복도에 기대어 서 있는 누군가가 보인다. <span class="red">베일리다.</span>
		<br><br>

		<<him>> 맞은편에서 패거리 몇 명이 당신의 방에서 <<baileyConfiscationList>>【을를】 들고 나오는 것이 보인다. <span class="red">놈들이 당신의 물건을 가져가고 있다!</span> 베일리는 아무렇지도 않다는 듯 그 모습을 지켜본다.
		<br><br>

		"몇 주 동안이나 방세를 떼먹고 있었지." <<he>>【이가】 말한다. "내가 그냥 넘어가 줄 줄 알았나?"
		<br><br>

		패거리들이 당신에게 눈길 한 번 주지 않은 채, 물건들을 챙겨 당신을 지나쳐 가기 시작한다.
		<br><br>

		"내 사무실로 와서 제대로 갚을 시간 일주일 준다. 안 그러면 이 잡동사니들은 전부 전당포에 넘길 테니까." <<He>>【은는】 당신에게서 몸을 돌리며, 귀찮다는 듯 어깨너머로 손을 내젓는다. "내가 다시 널 찾아다니게 만들지 마라."
		<br><br>

		<<set $rentTime to 7>><<set $baileyRefusedToPay to 0>>
		<<link [[싸우지 않는다|Orphanage]]>><<endevent>><</link>>
		<br>
		<<link [[싸운다|Bailey Confiscation Fight]]>><<set $fightstart to 1>><<generateRole 1 0 "thug">><<generateRole 2 0 "thug">><<generateRole 3 0 "thug">><</link>><<dangerousText>>
		<br>
	<</if>>
<</widget>>

<<widget "baileyRentReclaimOption">>
	<<if $bailey_confiscation>>
		<<babyRent true>><<bratTaxCalc>>
		<<set _owed to Math.max(0, $rentMoney + ($babyRent or 0) + $baileyBratTax + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0) - ($baileyDeposit or 0))>>
		<<if (setup.inflation ? setup.inflation.rentPayable() : $money) gte _owed>>
			<<highicon>><<link [[압수당한 물건을 되찾는다|Bailey Rent Reclaim]]>><</link>> (<<printmoney _owed>>)
			<br>
		<<else>>
			<span class="blue">압수당한 물건을 되찾는다 <<printmoney _owed>> (돈이 부족하다)</span>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "baileyConfiscationNotice">>
	<<if $bailey_confiscation_lost is 1>>
		<<set $bailey_confiscation_lost to 0>>
		<span class="red">제때 돈을 갚지 못해 물건을 돌려받지 못했다.</span> <<nnpc_He "Bailey">>【은는】 아마 그것들을 전당포에 넘겼을 것이다.
		<br><br>
	<</if>>
<</widget>>

:: Bailey Rent Reclaim
<<effects>>
<<npc Bailey>><<person1>>
<<set $rentTime to 7>>
<<babyRent>>

<<rentpay>>

<<link [[다음|Orphanage]]>><<endevent>><</link>>

:: Bailey Confiscation Fight
<<if $fightstart is 1>>
	<<set $enemyno to 4>>
	<<set $enemynomax to 4>>
	<<set $fightstart to 0>>
	<<neutral 1>>
	<<maninit>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
	"어떻게든 갚게 해주지." 베일리가 말한다.
	<br><br>
	<<set $phase to 1>>
<</if>>

<<effects>>
<<effectsman>>
<<man>>

<<if $phase is 1>>
	<<set $phase to 2>>
	소란을 듣고 싸움을 구경하러 고아원 아이들이 도착한다.
	<br><br>
<</if>>

<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[다음|Bailey Confiscation Fight Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Bailey Confiscation Fight]]>><</link>></span><<nexttext>>
<</if>>

:: Bailey Confiscation Fight Finish
<<effects>>

<<if $enemypleasure gte $enemypleasuremax>>
	<<ejaculation "short">><<set $baileydefeatedlewd += 1>><<set $baileydefeatedchain += 1>><<earnFeat "Bailey's Trouble Maker">>

	<<person1>>지켜보던 고아 중 하나가 킥킥거린다. 베일리가 범인을 찾으려 돌아보지만, <<him>> 등 뒤에서 다른 아이가 웃는다.
	곧 방 전체가 웃음소리로 가득 찬다. <<He>>【은는】 당신을 돌아본다. "이 빚은 반드시 갚아주지." <<he>>【이가】 내뱉고는 방을 뛰쳐나간다.
	<br><br>

	<<person2>><<person>>【이가】 들고 있던 당신의 물건들을 떨어뜨린다. <<person3>><<person>>【은는】 베일리를 따라 밖으로 나가고, <<person4>><<person>>【이가】 그 뒤를 슬그머니 따라나선다.
	<br><br>

	지켜보던 고아들이 당신의 승리에 크게 환호한다. 아이들은 당신을 도와 물건들을 방 안으로 다시 챙겨 넣는다.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>>
	<br><br>

	<<run baileyConfiscationRestore()>>
	<<clotheson>>
	<<endcombat>>

	<<link [[다음|Bedroom]]>><</link>>
<<elseif $enemyhealth lte 0>>
	<<set $baileydefeated += 1>><<set $baileydefeatedchain += 1>>

	<<person1>><<He>>【은는】 당신의 공격성에 놀라 멍든 곳을 어루만지며 잠시 뒤로 물러선다.
	<<He>>【은는】 복도 주변에 모인 무리를 알아챈다. "이 빚은 반드시 갚아주지. 내 말 똑똑히 기억해 둬." <<He>>【은는】 밖으로 뛰쳐나간다.
	<br><br>

	<<person2>><<person>>【이가】 들고 있던 당신의 물건들을 떨어뜨린다. <<person3>><<person>>【은는】 베일리를 따라 밖으로 나가고, <<person4>><<person>>【이가】 그 뒤를 슬그머니 따라나선다.
	<br><br>

	지켜보던 고아들이 당신의 승리에 크게 환호한다. 아이들은 당신을 도와 물건들을 방 안으로 다시 챙겨 넣는다.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>>
	<br><br>

	<<run baileyConfiscationRestore()>>
	<<clotheson>>
	<<endcombat>>

	<<link [[다음|Bedroom]]>><</link>>
<<else>>
	<<set $baileydefeatedchain to 0>>
	<<unset $bailey_encroach>>

	당신은 너무 다친 나머지 움직이지도 못한 채 바닥에 쓰러진다.
	<<lreb>><<reb -1>>
	<br><br>

	<<set $upperoff to 0>>
	<<set $loweroff to 0>>
	<<set $underloweroff to 0>>
	<<set $underupperoff to 0>>
	<<endcombat>>

	<<link [[다음|Rent Intro]]>><</link>>
<</if>>
<br>

:: Autism Rent Continue
<<if passage() is "Autism Rent Continue">>
	<<effects>><<person1>>
	설명은 마음속에만 담아 둔다. 베일리가 당신의 대답을 기다린다.
	<br><br>
<</if>>
/* The demand's caller may already have cleared this room flag. */
<<set _autismRentRoomBefore to $inRobinsRoom>>
<<set $inRobinsRoom to $autismSpectrum.rentReturn.inRobinsRoom>>
<<include $autismSpectrum.rentReturn.passage>>
<<if _autismRentRoomBefore is undefined>>
	<<unset $inRobinsRoom>>
<<else>>
	<<set $inRobinsRoom to _autismRentRoomBefore>>
<</if>>
<<unset $autismSpectrum.rentReturn>>

:: Autism Rent Due Options
<<set _rentTotal to ($rentMoney + ($babyRent or 0) + $baileyBratTax + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0))>>
<<if ($baileyDeposit or 0) gte _rentTotal or setup.hbsc.canAutoPay("bailey", _rentTotal)>>
	<<rentpay "bank">>
	<<link [[다음|Rent Pay Auto]]>><<set $phase to $_robinWasInRoom>><</link>>
<<else>>
	<<if setup.hbsc.cancelIfShort("bailey", _rentTotal)>>
		<span class="red">당신의 HBSC 자동이체로는 렌트를 감당할 수 없어 취소되었습니다.</span><br>
	<</if>>
	<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
		<<if setup.inflation and setup.inflation.baileyAggressive()>>
			<<baileyGripDemand>>
			<<link [[돈을 낸다|Rent Pay]]>><<set $phase to $_robinWasInRoom>><</link>>
			<br>
			<<if $syndromeBailey isnot true>>
				<<link [[거절한다|Rent Refuse]]>><<def 1>><</link>>
				<br>
			<</if>>
		<<else>>
			<<link [[돈을 낸다|Rent Pay]]>><<set $phase to $_robinWasInRoom>><</link>>
			<br>
			<<link [[거절한다|Rent Refuse]]>><<def 1>><</link>>
			<br>
		<</if>>
		<<if !(setup.inflation and setup.inflation.baileyAggressive()) and $baileyseduced isnot 1>>
			<<if hasSexStat("promiscuity", 2)>>
				<<link [[유혹한다|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 3>><</link>><<promiscuous2>><<gtrauma>>
				<br>
			<<elseif $uncomfortable.prostituting is false>>
				<<set _desperateaction to 1>>
				<<link [[유혹한다|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 12>><<set $desperateaction to _desperateaction>><</link>><<promiscuous2>><<ggtrauma>>
				<br>
			<</if>>
		<</if>>
		/* Keep Stockholm progression available under aggressive rent demands; bank debt still requires money. */
		<<if ($syndromeBaileyBuild gte 1 or $baileydefeated gte 5) and ($syndromeBailey isnot true or !(setup.inflation and setup.inflation.baileyAggressive())) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
			<span class="bailey-red bailey-stockholm"><<link "스스로를 내놓는다" "Bailey Offer Yourself">><</link>></span>
			<br>
		<</if>>
	<<else>>
		<<speechresolve>>
		<<person1>>
		<<switch _speechAttitudeResolved>>
			<<case "bratty">>
				당신은 <<him>>【을를】 노골적으로 반항하듯 쳐다본다. "돈 없어. 있어도 너한테 줄 생각 없고."
			<<case "meek" "shy">>
				고개를 숙인다. 돈을 낼 수 없고, 닥쳐올 일이 두렵다. 하려던 말이 입 밖에 나오기도 전에 목구멍에서 사라진다.
			<<case "polite" "flamboyant">>
				"죄송해요." 당신이 말한다. 하지만 사과는 입술을 떠나자마자 얄팍하게 들린다. "없어요."
			<<case "docile">>
				"저... 없어요." 인정하는 말이 부드럽게 흘러나온다. 더 크게 말하면 상황이 나빠지기라도 할 것처럼. 당신은 곧바로 시선을 내린다.
			<<case "confident">>
				"드릴 돈은 없어요." 당신이 <<his>> 눈을 마주 보며 말한다. "협박해 봤자 달라지지 않아요."
			<<case "cruel">>
				당신은 노골적인 경멸을 담아 <<him>>【을를】 위아래로 훑어본다. "돈 없어. 안됐네. 여기까지 와 놓고 헛걸음이야."
			<<default>>
				"없어요." 당신이 말한다. 가슴이 죄어, 한 마디 한 마디가 필요 이상으로 무겁게 느껴진다.
		<</switch>>
		<br><br>

		<<rentnopay true>>
	<</if>>
<</if>>
<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>

:: Autism Rent Robin Options
<<set _rentTotal to ($rentMoney + ($babyRent or 0) + $baileyBratTax + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0))>>
<<if ($baileyDeposit or 0) gte _rentTotal or setup.hbsc.canAutoPay("bailey", _rentTotal)>>
	<<rentpay "bank">>
	<<link [[다음|Rent Pay Auto]]>><<if $inRobinsRoom>><<set $inRobinsRoom to true>><</if>><</link>>
<<else>>
	<<if setup.hbsc.cancelIfShort("bailey", _rentTotal)>>
		<span class="red">당신의 HBSC 자동이체로는 렌트를 감당할 수 없어 취소되었습니다.</span><br>
	<</if>>
	<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
		<<if setup.inflation and setup.inflation.baileyAggressive()>>
			<<baileyGripDemand>>
			<<if $syndromeBailey isnot true>>
				<<link [[거절한다|Rent Refuse Robin]]>><<def 1>><</link>>
				<br>
				<<if ($syndromeBaileyBuild gte 1 or $baileydefeated gte 5) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
					<span class="bailey-red bailey-stockholm"><<link "스스로를 내놓는다" "Bailey Offer Yourself">><</link>></span>
					<br>
				<</if>>
			<</if>>
			<<if $inRobinsRoom>>
				<<link [[돈을 낸다|Rent Pay Robin]]>><<set $inRobinsRoom to true>><</link>>
			<<else>>
				<<link [[돈을 낸다|Rent Pay Robin]]>><</link>>
			<</if>>
			<br>
		<<else>>
			<<if $inRobinsRoom>>
				<<link [[돈을 낸다|Rent Pay Robin]]>><<set $inRobinsRoom to true>><</link>>
			<<else>>
				<<link [[돈을 낸다|Rent Pay Robin]]>><</link>>
			<</if>>
			<br>
			<<link [[거절한다|Rent Refuse Robin]]>><<def 1>><</link>>
			<br>
			/* Already inside the non-relentless branch; only the bank's claim needs excluding here. */
			<<if ($syndromeBaileyBuild gte 1 or $baileydefeated gte 5) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
				<span class="bailey-red bailey-stockholm"><<link "스스로를 내놓는다" "Bailey Offer Yourself">><</link>></span>
				<br>
			<</if>>
		<</if>>
	<<else>>
		<<set $baileypaychain to 0>>
		<<speechresolve>>
		<<switch _speechAttitudeResolved>>
			<<case "bratty">>
				당신은 <<him>>【을를】 반항하듯 쳐다본다. "돈 없어. 있어도 너한테 줄 생각 없고. 로빈은 이 일에 끌어들이지 마."
			<<case "meek" "shy">>
				고개를 숙인다. 돈을 낼 수 없고 닥쳐올 일이 겁이 난다. "미안해, 로빈."
				<br><br>
				"네, 네 잘못 아니야." 로빈이 끼어든다.
			<<case "polite" "flamboyant">>
				"죄송해요." 당신이 재빨리 말한다. "없어요. 제발, 로빈은 이 일에서 빼 주세요."
				<br><br>
				로빈이 겁에 질려 휘둥그레진 눈으로 당신을 바라본다.
			<<case "docile">>
				"없어요..." 다정함만으로도 베일리의 마음이 누그러질 수 있다는 듯, 작고 진지한 목소리가 나온다. "제발 로빈을 끌어들이지 마세요."
				<br><br>
				로빈이 꿀꺽 침을 삼킨다.
			<<case "confident">>
				"드릴 돈은 없어요." 당신이 말한다. "이건 당신과 나 사이의 일이니까, 로빈은 빼 주세요."
				<br><br>
				로빈은 여전히 겁에 질려 보인다.
			<<case "cruel">>
				당신이 눈을 가늘게 뜬다. "돈 없어. 진짜로 돈 낼 수 있는 사람을 괴롭히고, 로빈은 내버려 둬."
				<br><br>
				베일리의 미소에 로빈이 움찔한다.
			<<default>>
				"없어요." 당신이 말한다. "제발... 로빈은 이 일에서 빼 주세요."
				<br><br>
				로빈은 겁에 질린 듯 보인다.
		<</switch>>
		<br><br>
		"괜찮아." <<he>>【은는】 미소 지으며 말한다. "이미 조치를 취해뒀거든. 저들이 너희 둘에게 뭘 할지는 모르겠지만, 솔직히 신경 안 써."
		<<He>>【은는】 후드와 밧줄 한 뭉치를 꺼낸다. "가만히 있어."
		<br><br>
		<<if isPregnancyEnding()>>
			<<set $phase to 1>><<set $rentPregInterruption to "broke">><<include "Rent Pregnant">>
		<<else>>
			<<link [[굴복한다|Rent Intro]]>><<endevent>><<set $phase to 1>><</link>>
			<br>
			<<if $bus is "hospital">>
				<<link [[싸운다|Rent Hospital Fight Robin]]>><<set $fightstart to 1>><</link>>
				<br>
			<<else>>
				<<link [[싸운다|Rent Robin Fight]]>><<set $fightstart to 1>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<</if>>
<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>
