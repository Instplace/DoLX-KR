		<<if (currentSkillValue('danceskill') + random(0,750)) gte 1100>>
			달려들지만, <span class="green">당신은 간신히 피하고, <<him>>【은는】 머리부터 바닥에 고꾸라진다</span>. 베일리가 잠시 <<him>>【을를】 경멸하듯 바라보다가 일으켜 세운다.
			<<set $enemyhealth -= $enemyhealth / 5>>
		<<else>>
			달려들어 <span class="red">당신의 팔을 붙잡아 꼼짝 못 하게 한다</span>. "얼마나 버티는지 보자." 베일리가 말한다.
			<<set $leftarm to "grappled">><<set $rightarm to "grappled">><<set $NPCList[1].lefthand to "arms">><<set $NPCList[1].righthand to "arms">>
		<</if>>
		<br><br>
	<</if>>
	"너희 중 하나는 저놈 좀 붙잡고 있어." 베일리가 말한다. <<personselect $enemynomax>><<person>>【이가】 고개를 끄덕이고 로빈을 붙잡는 동안,
	베일리는 <<person1>><<his>> 시선을 당신에게 돌린다.
	<<set $phase to 1>>

	<<if _robin.dom gte 80>>
		<<set $timer to 4>>
	<<elseif _robin.dom gte 60>>
		<<set $timer to 3>>
	<<elseif _robin.dom gte 40>>
		<<set $timer to 2>>
	<<else>>
		<<set $timer to 1>>
	<</if>>
<</if>>

<<effects>>
<<effectsman>><<man>>

<<if $phase is 1>>
	<<set $phase to 2>>
	<br><br>
	소란을 듣고 싸움을 구경하러 고아원 아이들이 도착한다.
	<br><br>
<</if>>

<<personselect $enemynomax>>
<<if $timer gt 1>>
	<span class="green">
	<<if $rng gte 81>>
		로빈이 <<nnpc_his "Robin">> 속박 속에서 몸부림친다.
	<<elseif $rng gte 61>>
		로빈이 포기하지 말라고 말한다.
	<<elseif $rng gte 41>>
		로빈이 <<persons>> 발뒤꿈치를 차고 있다.
	<<elseif $rng gte 21>>
		로빈이 <<nnpc_him "Robin">>에 대해 걱정하지 말라고 말한다.
	<<else>>
		로빈이 <<nnpc_him "Robin">>【을를】 잡고 있는 <<persons>> 손을 문다.
	<</if>></span>
<<elseif $timer is 1>>
	<<person>>【이가】 로빈의 목에 <<his>> 팔을 감는다. <span class="red">로빈이 고통에 찬 비명을 지른다.</span>
<<else>>
	<span class="red">
	<<if $rng gte 81>>
		<<person>>【이가】 로빈의 목을 조르고 있다.
	<<elseif $rng gte 61>>
		로빈이 숨 막혀 하는 소리가 들린다.
	<<elseif $rng gte 41>>
		<<person>>【이가】 로빈의 목을 조르면서 로빈의 눈에 침을 뱉는다.
	<<elseif $rng gte 21>>
		로빈이 항복하려 하지만, <<person>>【은는】 힘을 풀지 않는다.
	<<else>>
		<<person>>【이가】 로빈의 목을 조르면서 로빈을 주먹으로 친다.
	<</if>>
	</span>
	<<npcincr Robin trauma 2>><<grtrauma true>>
<</if>>
<br><br>

<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[다음|Rent Robin Fight Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Rent Robin Fight]]>><</link>></span><<nexttext>>
<</if>>

:: Rent Robin Fight Finish
<<effects>>
<<set _robin to statusCheck("Robin")>>

<<if $enemypleasure gte $enemypleasuremax>>
	<<ejaculation "short">><<set $baileydefeatedlewd += 1>><<set $baileydefeatedchain += 1>><<earnFeat "Bailey's Trouble Maker">>

	<<person1>>지켜보던 고아 중 하나가 킥킥거린다. 베일리가 범인을 찾으려 돌아보지만, <<him>> 등 뒤에서 다른 아이가 웃는다.
	곧 방 전체가 웃음소리로 가득 찬다. <<He>>【은는】 당신을 돌아본다. "이 빚은 반드시 갚아주지." <<he>>【이가】 내뱉고는 방을 뛰쳐나간다.
	<br><br>

	<<if $phase2 is "thug">>
		깡패들이 <<him>> 뒤를 따라 슬그머니 빠져나간다.
		<br><br>
	<<elseif $baileydefeatedchain gte 2>>
		<<person2>><<person>>【은는】 <<person1>><<him>> 뒤를 따라 슬그머니 빠져나간다.
		<br><br>
	<</if>>
	당신은 로빈에게 다가가 <<nnpc_his "Robin">> 구속을 풀어준다. <<nnpc_He "Robin">>【은는】 당신을 와락 끌어안는다. "고마워, 나의 영웅!" 당신의 <<if _robin.lust gte 60 and $robinromance is 1>>입술<<else>>빰<</if>>에 가볍게 입을 맞추고는, <<nnpc_he "Robin">>【은는】 자리를 뜬다.
	<br><br>

	고아들은 폭군을 물리친 당신에게 환호한다. <<He>>【은는】 다시 돌아오겠지만, 지금은 일단 무사하다.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>><<npcincr Bailey dom -1>><<ldom "Bailey">><<llthuganger>><<thuganger -2>>
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[다음|Bedroom]]>><</link>>
<<elseif $enemyhealth lte 0>>
	<<set $baileydefeated += 1>><<set $baileydefeatedchain += 1>>

	<<person1>><<He>>【은는】 당신의 공격성에 놀라 멍든 곳을 어루만지며 잠시 뒤로 물러선다.
	<<He>>【은는】 복도 주변에 모인 군중을 알아챈다. "이 빚은 갚아주지. 내 말 명심해." <<He>>【은는】 밖으로 뛰쳐나간다.
	<br><br>

	<<if $phase2 is "thug">>
		깡패들이 <<him>> 뒤를 따라 슬그머니 빠져나간다.
		<br><br>
	<<elseif $baileydefeatedchain gte 2>>
		<<person2>><<person>>【은는】 <<person1>><<him>> 뒤를 따라 슬그머니 빠져나간다.
		<br><br>
	<</if>>
	당신은 로빈에게 걸어가 <<nnpc_his "Robin">> 결박을 풀어준다. <<nnpc_He "Robin">>【은는】 당신을 끌어안으며 말한다. "고마워, 나의 영웅!"
	<br><br>

	<<if _robin.lust gte 60 and $robinromance is 1>>
		당신의 입술에 쪽 소리 나게 입을 맞추고, 로빈은 걸어간다.
	<<else>>
		당신의 뺨에 쪽 소리 나게 입을 맞추고, 로빈은 걸어간다.
	<</if>>
	<br><br>

	베일리가 떠나자 지켜보던 고아들은 짓누르던 무게에서 벗어나, 폭군을 물리친 당신에게 환호한다. <<He>>【은는】 다시 돌아오겠지만, 지금은 일단 무사하다.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>><<npcincr Bailey dom -1>><<ldom "Bailey">><<llthuganger>><<thuganger -2>>
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[다음|Bedroom]]>><</link>>

<<else>>
	<<set $baileydefeatedchain to 0>>
	<<set $baileyRefusedToPay to 0>><<set $baileyBrat to { points: 0, reasons: [] }>><<set $baileyBratTax to 0>>
	<<unset $bailey_encroach>>
	<<if $finish is 1>><<encounterEndViolence>><</if>>
	로빈이 몸부림치지만, 베일리가 <<nnpc_him "Robin">>의 머리를 세게 내리친다. <<nnpc_He "Robin">>【은는】 당신 곁에 쓰러진다.
	<<lreb>><<reb -1>><<npcincr Bailey dom 1>><<gdom "Bailey">>
	<br><br>

	<<set $upperoff to 0>>
	<<set $loweroff to 0>>
	<<set $underloweroff to 0>>
	<<set $underupperoff to 0>>
	<<endcombat>>

	<<link [[다음|Rent Intro]]>><<endevent>><<set $phase to 1>><</link>>
<</if>>

