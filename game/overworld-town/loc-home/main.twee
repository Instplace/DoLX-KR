		<<set _locket_text to "안에는 평화롭게 잠든 검은 늑대의 사진이 들어있다.">>
	<<case "Great Hawk">>
		<<set _locket_text to "안에는 조각상처럼 근엄한 모습의 거대 매 사진이 들어있다.">>
	<<case "Bailey">>
		<<set _locket_text to "사진 속 베일리의 표정은 읽을 수 없다. 이 사진이 언제 찍혔는지도 확실하지 않다.">>
	<<case "Gwylan">>
		<<if $gwylan?.timer?.nobody gte Time.date.timeStamp>>
			<<set _locket_text to "안의 사진은 일그러져 알아볼 수 없다.">>
		<<elseif $hypnosis_traits.devotion gte 4>>
			<<set _locket_text to "그윌란의 매혹적인 미소가 당신을 맞이한다. 사진은 거의 빛나는 것처럼 보인다.">>
		<<else>>
			<<set _locket_text to "그윌란의 밝은 미소가 당신을 맞이한다. <<nnpc_his 'Gwylan'>> 얼굴의 나머지 부분은 흐릿하지만.">>
		<</if>>
	<<case "Poppy">>
		<<set _locket_text to "포피의 사진이 따뜻하고 약간 짓궂은 미소로 당신을 마주 본다.">>
	<<default>>
		<<set _locket_text to "비어 있지만, 사진 한 장을 넣을 공간이 있다.">><<set _noLocketPhoto to true>>
<</switch>>

<<if $options.images>>
	<div class="img-txt">
		<<if $carried.neck.photo>>
			<div id="locket">
				<span>
					<img class="icon infront" @src="'img/ui/locket-'+$carried.neck.colour.replace(' ', '-')+'-photo.png'" style="height:128px; width:128px">
					<img class="icon" @src="'img/ui/locket/'+$carried.neck.photo?.replace(' ', '-').toLowerCase()+'.png'" onerror="this.onerror=null; this.src='img/ui/locket-empty.png';" style="height:128px; width:128px">
				</span>
			</div>
		<<else>>
			<div id="locket">
				<span>
					<img class="icon" @src="'img/ui/locket-'+$carried.neck.colour.replace(' ', '-')+'.png'" style="height:128px; width:128px">
				</span>
			</div>
		<</if>>
		<div id="locket-txt">
			<<if !_noLocketPhoto and C.npc["Ivory Wraith"].love gte 10 and (["haunt", "despair"].includes($wraith.state) or C.npc["Ivory Wraith"].lust gt 10) and $hallucinations gte 1 and ((random(1, 100) is 1) or ($controlled is 0 and random(1, 100) lte 5))>>
				<<fadeText "<span class='wraith'>창백한 형체의 <<wraithEyes>> 시선이 당신을 꿰뚫는다.</span>" "<<print _locket_text>>">>
			<<else>>
				<<print _locket_text>>
			<</if>>
			<br><br>
		</div>
	</div>
<<else>>
	<<if !_noLocketPhoto and C.npc["Ivory Wraith"].love gte 10 and (["haunt", "despair"].includes($wraith.state) or C.npc["Ivory Wraith"].lust gt 10) and $hallucinations gte 1 and ((random(1, 100) is 1) or ($controlled is 0 and random(1, 100) lte 5))>>
		<<fadeText "<span class='wraith'>창백한 형체의 <<wraithEyes>> 시선이 당신을 꿰뚫는다.</span>" "<<print _locket_text>>">>
	<<else>>
		<<print _locket_text>>
	<</if>>
	<br><br>
<</if>>

<<for _npc range setup.NPCNameList>>
	<<capture _npc>>
		<<if $carried.neck.photo != _npc and (isLoveInterest(_npc))>>
			<span @class="'clothes-'+$carried.neck.colour.replace(' ', '-')"><<icon "locket.png">></span>
			<<if $carried.neck.photo>>
				<<link [[`${["Black Wolf", "Great Hawk"].includes(_npc) ? "그 " : ""}${window.KR.gatPersonNameDictKR(_npc)}의 사진으로 교체한다`|Mirror Locket 2]]>><<set $carried.neck.photo to _npc>><</link>>
				<br>
			<<else>>
				<<link [[`${["Black Wolf", "Great Hawk"].includes(_npc) ? "그 " : ""}${window.KR.gatPersonNameDictKR(_npc)}의 사진을 넣는다`|Mirror Locket 2]]>><<set $carried.neck.photo to _npc>><</link>>
				<br>
			<</if>>
		<</if>>
	<</capture>>
<</for>>
<<if $syndromeBailey and $carried.neck.photo isnot "Bailey" and not isLoveInterest("Bailey")>>
	<span @class="'clothes-'+$carried.neck.colour.replace(' ', '-')"><<icon "locket.png">></span>
	<<if $carried.neck.photo>>
		<<link [[사진을 베일리의 사진으로 교체한다|Mirror Locket 2]]>><<set $carried.neck.photo to "Bailey">><</link>>
	<<else>>
		<<link [[베일리의 사진을 넣는다|Mirror Locket 2]]>><<set $carried.neck.photo to "Bailey">><</link>>
	<</if>>
	<br>
<</if>>
<<if $carried.neck.photo>>
	<span @class="'clothes-'+$carried.neck.colour.replace(' ', '-')"><<icon "locket.png">></span><<link [[사진을 뺀다|Mirror Locket 2]]>><<set $phase to $carried.neck.photo>><<unset $carried.neck.photo>><</link>>
	<br>
<</if>>
<br>

<<getouticon>><<link [[뒤로|$passage_mirror]]>><<neckon>><</link>>

:: Mirror Locket 2
<<effects>>

<<switch $carried.neck.photo>>
	<<case "Robin">>
		당신은 행복하게 웃고 있는 로빈의 작은 사진을 넣는다.
	<<case "Whitney">>
		당신은 사악하게 웃고 있는 휘트니의 작은 사진을 넣는다.
	<<case "Kylar">>
		당신은 집착 어린 시선으로 바라보는 카일라의 작은 사진을 넣는다.
	<<case "Eden">>
		당신은 엄하게 찡그린 에덴의 작은 사진을 넣는다.
	<<case "Avery">>
		당신은 무심한 표정의 에이버리의 작은 사진을 넣는다.
	<<case "Alex">>
		당신은 말을 타고 있는 알렉스의 작은 사진을 넣는다.
	<<case "Sydney">>
		당신은 기도하듯 손을 모은 시드니의 작은 사진을 넣는다.
	<<case "Black Wolf">>
		당신은 평화롭게 잠든 검은 늑대의 작은 사진을 넣는다.
	<<case "Great Hawk">>
		당신은 조각상 같은 자세를 취하고 있는 거대 매의 작은 사진을 넣는다.
	<<case "Bailey">>
		당신은 카메라를 쳐다보지 않은 채 한창 걷는 모습이 찍힌 베일리의 작은 사진을 넣는다.
	<<case "Gwylan">>
		<<if $gwylan?.timer?.nobody gte Time.date.timeStamp>>
			당신은 아무도 없는 작은 사진을 넣는다.
		<<elseif $hypnosis_traits.devotion gte 4>>
			당신은 <<nnpc_his "Gwylan">> 손에 벨트 달린 목걸이를 들고 유혹적으로 미소 짓는 그윌란의 작은 사진을 넣는다.
		<<else>>
			당신은 활기차게 손을 흔들며 미소 짓는 그윌란의 작은 사진을 넣는다.
		<</if>>
	<<case "Poppy">>
		당신은 포피가 카메라를 향해 부드럽게 미소 짓고 있는 작은 사진을 끼워 넣는다.
	<<default>>
		<<if ["Black Wolf", "Great Hawk"].includes($phase)>><</if>>$phase의 작은 사진을 빼내자 로켓은 다시 비어 버린다.
<</switch>>
<br><br>

<<link [[다음|Mirror Locket]]>><<endevent>><<neckon>><</link>>

:: Sold
<<set $location to "town">><<set $outside to 0>><<effects>>
<<generate1>><<generate2>><<person1>><<facewear "cloth gag">><<bind>>
흔들려 잠에서 깨어나 보니, 당신은 차 뒷좌석에 누워 있다. 밧줄이 당신의 팔을 등 뒤로, 몸을 의자에 묶고 있다. 입에는 재갈이 물려 있다.
<br><br>
"<<pShes stranger>> 깨어났어." 조수석에 앉은 <<person>>【이가】 말한다.
<br>
"좋아." 운전자인 <<person2>><<person>>【이가】 응답한다. "마침 잘 됐네."
<br><br>
창밖으로는 거의 아무것도 보이지 않는다. 당신의 자세에서는. 오직 하늘과 줄지어 선 가로등뿐이다. 차가 건물 안으로 들어가고, 뒤에서 문이 닫히는 소리가 들린다.
<br><br>
<<link [[다음|Sold 2]]>><</link>>

:: Sold 2
<<effects>>
팔은 여전히 묶여 있지만, 일부 밧줄이 풀어진다. 당신은 평범해 보이는 부엌을 지나 거실로 이끌려 간다. 당신은 소파 위로 밀쳐진다.
<br><br>
"자, 이제." <<person1>><<person>>【이가】 말한다. "널 데려오느라 그 고생을 했는데, 막상 여기 있으니 뭘 해야 할지 모르겠네."
<br>
"그냥 <<phim stranger>>【을를】 강간하면 되지." <<person2>><<person>>【이가】 다른 의자에 기대앉으며 응수한다. "근데 <<pshe stranger>>【이가】 싫다고 <<pverb "does not" "do not" stranger>>안 하면 강간인가?"
<br><br>
그들은 잠시 당신의 운명에 대해 논의한다. 어느 것도 유쾌하게 들리지 않는다.
<br><br>
<<link [[순종적인 몸짓을 한다|Sold Sub]]>><<sub 1>><</link>>
<br>
<<link [[노려본다|Sold Glare]]>><<def 1>><</link>>

:: Sold Sub
<<effects>>
당신은 무릎을 꿇고 앉아 고개를 숙인 채로 있는다. 두 사람이 웃는다.
<br><br>
"적어도 누군가는 마음을 정했네." <<He>>【이가】 앞으로 손을 뻗어 당신의 입에서 재갈을 찢어낸다. "뭐 좋은 생각이라도 있어?"
<br><br>
<<set $worn.face.type.push("broken")>>
<<faceruined>>
<<link [[풀어달라고 부탁한다|Sold Ask]]>><</link>>
<br>
<<link [[협조하겠다고 말한다|Sold Cooperate]]>><</link>>
<br>
<<link [[소리 지른다|Sold Scream]]>><</link>>

:: Sold Glare
<<effects>>
당신은 <<fullGroup>>【을를】 차례로 노려보고, 그들이 다시 쳐다봐도 시선을 피하지 않는다. 두 사람이 웃는다.
<br><br>
"<<pshe stranger>>【이가】 <<pverb "has" "have" stranger>>자기 생각이 좀 있는 것 같네." <<person1>><<person>>【이가】 앞으로 손을 뻗어 당신의 입에서 재갈을 찢어내며 말한다.
<br><br>
<<set $worn.face.type.push("broken")>>
<<faceruined>>
<<link [[풀어달라고 부탁한다|Sold Ask]]>><</link>>
<br>
<<link [[협조하겠다고 말한다|Sold Cooperate]]>><<sub 1>><</link>>
<br>
<<link [[소리 지른다|Sold Scream]]>><</link>>
<br>

:: Sold Ask
<<effects>><<speechresolve>>
<<switch _speechAttitudeResolved>>
	<<case "meek" "shy">>
		"제-제발 풀어주세요." 당신이 말한다. "아무한테도 말 안 할게요. 약속해요."
	<<case "polite" "flamboyant">>
		"제발 풀어 주세요." 당신이 최대한 침착한 어조를 유지하려 애쓰며 말한다. "이럴 필요 없잖아요."
	<<case "docile">>
		"제발... 풀어 주세요. 문제 일으키지 않을게요." 당신이 말한다.
	<<case "confident">>
		"지금 풀어 줘요." 당신이 말한다. "그러는 편이 모두에게 더 좋게 끝나요."
	<<case "cruel">>
		"풀어 주면 네놈들 얼굴은 잊어 줄지도 몰라." 당신이 말한다. "계속 이러면 못 잊어."
	<<case "bratty">>
		"날 풀어주는 게 좋을 거야." 당신이 말한다. "사람들이 날 찾고 있을 테니까."
	<<default>>
		"제발 풀어주세요." 당신이 말한다. "이 일은 잊어버릴게요."
<</switch>>
<br><br>
두 사람은 서로를 보고 웃는다. "우린 널 돈 주고 샀어." <<person1>><<person>>【이가】 말한다. "그리고 우린 돈값을 뽑아낼 거야."
<br>
<<person2>><<person>>【은는】 <<his>> 친구에게 몸을 기울인다. 그들은 잠시 속삭이다가, <<person1>><<person>>【이가】 다시 당신에게로 돌아선다. "좋은 생각이 있어. 널 풀어줄게, 하지만 넌 그걸 위해 일해야 할 거야."
<br><br>
<<link [[다음|Sold Work]]>><</link>>

:: Sold Cooperate
<<effects>><<speechresolve>>
<<switch _speechAttitudeResolved>>
	<<case "meek" "shy">>
		"다-당신들이 시키는 대로 할게요." 당신이 말한다. "그-그냥 다치게만 하지 마세요. 제발요."
	<<case "polite" "flamboyant">>
		"알겠어요." 당신이 말한다. "협조할게요. 거칠게만 굴지 마세요."
	<<case "docile">>
		"시키는 대로 할게요." 당신이 중얼거린다. "제발 때리지 마세요."
	<<case "confident">>
		"좋아요." 당신이 말한다. "협조할 테니 점잖게 가죠."
	<<case "cruel">>
		"하고 싶은 말은 알겠어." 당신이 말한다. "원하는 게 뭔지 말하고, 허세는 그만 부려."
	<<case "bratty">>
		"자." 당신이 말한다. "어떻게 돌아가는지 알아. 장단 맞춰줄 테니, 내 시간 낭비는 그만하자고."
	<<default>>
		"협조할게요." 당신이 말한다. "그냥 부드럽게만 해줘요."
<</switch>>
<br><br>
"머리가 잘 돌아가네." <<person1>><<person>>【이가】 자기 잔에 스카치 한 잔을 따르며 말한다. "지난번 놈보다 낫네."
<br><br>
<<pass 2>>
두 사람은 가끔씩 당신을 힐끗 쳐다보며 몇 분간 속삭인다. 마침내 합의에 이른다. "네게 시킬 일이 좀 있어."
<br><br>
<<link [[다음|Sold Work]]>><</link>>

:: Sold Work
<<effects>>
"난 항상 나만의 <<= playerPronoun() is "m" ? "집사" : playerPronoun() is "f" ? "메이드" : "시종">>【을를】 원했어." <<person1>><<person>>【이가】 말한다. "그러니 넌 몇 시간 동안 우리를 위해 일하게 될 거야. 우리 술을 채워주고, 눈요깃거리가 되어주고. 우리가 원하는 건 뭐든지. 그 대가로, 널 강간하지 않고 풀어줄게."
<br><br>
"우린 그냥 널 강간할 수도 있어." <<person2>><<person>>【이가】 말한다. "그리고 다른 쓰레기들과 함께 널 버리는 거지. 네가 그쪽을 더 선호한다면 말이야."
<br><br>
<<link [[그들의 메이드가 되는 것에 동의한다 (3:00)|Sold Work Accept]]>><<pass 60>><<trauma 6>><<stress 6>><</link>><<gtrauma>><<gstress>>
<br>
<<link [[거절한다|Sold Work Refuse]]>><</link>>

:: Sold Work Accept

<<effects>><<speechresolve>>
<<switch _speechAttitudeResolved>>
	<<case "meek" "shy">>
		"무-무엇이든 시키는 대로 할게요." 당신은 말한다. "어떻게 봉사하면 될까요?"
	<<case "polite" "flamboyant">>
		"그러죠." 당신이 말한다. "필요한 걸 말하면 제가 할게요."
	<<case "docile">>
		"알겠어요." 당신이 중얼거린다. "원하는 대로 할게요."
	<<case "confident">>
		"좋아요." 당신이 말한다. "어디에 서면 되는지 알려 주고 어서 시작해요."
	<<case "cruel">>
		"연극은 집어치워." 당신이 말한다. "정확히 내가 뭘 하면 되는데?"
	<<case "bratty">>
		"알았어요." 당신은 말한다. "제가 뭘 하길 원하죠?"
	<<default>>
		"알겠습니다." 당신은 말한다.
<</switch>>
<br><br>
두 사람은 당신에게 계속 술을 채우게 하고, 필요할 때마다 부엌에서 간식을 가져오게 한다. 당신이 필요 없을 때는 옆에 서 있게 한다. <<if $exposed gte 1>>이렇게 노출된 상태가 아니었으면 좋겠다고 생각한다.<</if>> 그들은 당신을 노골적으로 쳐다보지만, 어쩔 도리가 없다. <<if $exposed gte 1>>팔이 묶여 있어서 몸을 가릴 수도 없다.<</if>>
<br><br>

<<if $settings.footFetishEnabled>>
	<<person2>><<person>>【이가】 <<his>> 잔을 가리킨다. 이번에는 당신이 잔을 채우려고 몸을 숙이자, <<he>>【은는】 당신의 엉덩이를 걷어차 무릎을 꿇게 만든다. 당신이 일어서기도 전에 등 위로 무게가 짓누른다. 그리고 또 하나. "새 발판이 필요했는데," <<he>>【이가】 말한다. "가만히 있는 게 좋을 거야. 발판은 움직이지 않거든."
	<<gtrauma>><<gstress>><<gpain>><<trauma 6>><<stress 6>><<pain 6>>
	<br><br>
	<<link [[견딘다 (1:00)|Sold Work Foot]]>><<pass 60>><<sub 1>><<trauma 6>><<stress 6>><<arousal 4000>><</link>><<gtrauma>><<gstress>><<ggarousal>>
	<br>
	<<link [[너무 굴욕적이다|Sold Work Foot Refuse]]>><<def 1>><</link>>
	<br>
<<else>>
