		<br><br>
	<</if>>
	<<if $christmas is 1 and Time.monthDay is 25 and Time.dayState isnot "night" and $exposed lte 0>>
		<<icon "main-hall-christmas.png">><<link [[크리스마스를 기념한다 (1:00)|Orphanage Christmas]]>><<pass 60>><<trauma -12>><<stress -6>><</link>><<lltrauma>><<lstress>>
		<br>
	<</if>>
	<<gardenicon>><<link [[정원 (0:01)|Garden]]>><<pass 1>><</link>>
	<br><br>
	<<officeicon>><<link [[베일리의 사무실 (0:01)|Bailey's Office]]>><<pass 1>><</link>>
	<br>
	<<if effectiveTransformationLevel("cat") gte 6 and Time.hour gte 7 and Time.hour lte 9 and !$daily.orphanageBaileyPounce>>
		<<officeicon>><<link [[구석에서 베일리를 기다린다 (0:10)|Orphanage Bailey Pounce]]>><<pass 10>><<set $daily.orphanageBaileyPounce to 1>><</link>><<physiquedifficulty 1 2000>><<dancedifficulty 1 2000>>
		<br>
	<</if>>
	<<orphanageWard>>
	<br>
	<<bedroomEntryEvent>>
	<br>
