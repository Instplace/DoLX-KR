:: Bedroom
<<bedclotheson "bed">>
<<set $outside to 0>><<set $location to "home">><<set $bus to "home">><<home_effects>><<effects>><<getTarget true>><<godClothe>>
<<if $punishmentposition isnot 0 and $location isnot "brothel">><<set $punishmentposition to 0>><</if>> /* temporary because wrong cleanup in UB */
<<autism-suspension "Bedroom">>
<<petRunaway>>
당신은 고아원의 침실에 있다.
/* Wallpaper */
<<set _furniture to $furniture.bedroom>>
<<if _furniture.wallpaper>>
	<br>
	<<set _premadeWall to ["vines", "tentacles", "plain-white", "wavy-white", "cowgirls", "cow-girls", "hearts", "trees", "crosses", "starry", "deep sea", "beach", "crabs", "flames", "stained glass", "audience", "bears"].includes(_furniture.wallpaper.name)>>
	<<if _premadeWall>>
		<<set _wallpaper to "wallpaper-" + _furniture.wallpaper.name.replace(/ /g,"-")>>
	<<elseif ['dol', 'degrees of lewdity'].some(e => _furniture.wallpaper.name.toLowerCase().includes(e))>>
		<<set _wallpaper to "wallpaper-dol">>
	<<else>>
		<<set _wallpaper to "wallpaper-custom">>
	<</if>>

	<<furnitureicon _wallpaper>>
	<<switch _furniture.wallpaper.name>>
		<<case "vines">>
			음란한 녹색 덩굴이 벽에서 꿈틀거린다.
			<<if $backgroundTraits.includes("plantlover")>>
				달콤한 넥타르에 대한 생각이 당신의 마음을 괴롭힌다.
			<</if>>
		<<case "tentacles">>
			보라색 촉수가 벽을 따라 미끄러지듯 움직인다.
			<<if (effectiveTransformationLevel("demon") gte 6)>>
				쾌락에 대한 생각이 마음을 스쳐 지나간다.
			<</if>>
		<<case "plain-white">>
			평범한 흰색 벽지가 벽을 덮고 있다.
		<<case "wavy-white">>
			흰색 벽지가 물결무늬로 검은색으로 변한다. 음란한 속뜻이라도 있는 걸까?
		<<case "hearts">>
			분홍색 하트가 벽을 뒤덮고 있다.
		<<case "cowgirls" "cow-girls">>
			카우걸들이 벽 위에서 춤을 춘다.
		<<case "trees">>
			푸른 나무들이 숲에 들어온 듯한 기분을 준다.
		<<case "crosses">>
			황금 십자가가 벽을 뒤덮고 있다.
		<<case "starry">>
			별이 빛나는 은하수가 벽을 뒤덮고 있다.
		<<case "deep sea">>
			깊고 푸른 바다가 당신을 둘러싸고 있다.
		<<case "beach">>
			목가적인 해변 풍경이 벽을 뒤덮고 있다.
		<<case "crabs">>
			귀여운 게 무늬가 벽을 뒤덮고 있다.
		<<case "flames">>
			불꽃이 당신을 둘러싸고 있다. 괜찮다.
		<<case "stained glass">>
			스테인드글라스 무늬가 벽을 뒤덮고 있다.
		<<case "audience">>
			실루엣들이 당신을 둘러싸고 있다. 마치 군중이 지켜보는 것 같다.
		<<case "bears">>
			곰돌이처럼 귀여운 무늬가 벽을 뒤덮고 있다.
		<<default>> /* Custom */
			_furniture.wallpaper.name의 이미지가 벽을 뒤덮고 있다.
			<<if _wallpaper is "wallpaper_dol">>
				왠지 모르게 익숙해 보인다.
			<<elseif _furniture.wallpaper.name.startsWith('&lt;&lt')>>
				<span class="black">부정행위를 들킨 것 같은 기분이 든다.</span>
			<</if>>
	<</switch>>
	<br>
<<else>>
	삭막한 벽이 외부로부터 당신을 보호한다.
	<br>
<</if>>

<<set _desk to Furniture.get('desk', $location)>>
<<set _chair to Furniture.get('chair', $location)>>
<<set _deco to Furniture.get('decoration', $location)>>
<<set _owlplush to Furniture.get('owlplushie', $location)>>
<<set _windowsill to Furniture.get('windowsill', $location)>>
<<set _poster to Furniture.get('poster', $location)>>
<<set _bed to Furniture.get('bed', $location)>>
<<set _wardrobe to Furniture.get('wardrobe', $location)>>
<<set _radio to Furniture.get('radio', $location)>>
<<set _console to Furniture.get('console', $location)>>
<<if $machineVaginalBought isnot undefined or $machineAnalBought isnot undefined>>
	<<set _sexMachine to 1>>
<</if>>

<<if _radio and $bedroomUI.orphanage.radio is true>>
	<<run while (V.weatherObj.keypointsArr.length > 1 && V.weatherObj.keypointsArr[1].timestamp <= (new DateTime(Time.date)).timeStamp) {V.weatherObj.keypointsArr.shift();}>>
	<<furnitureicon _radio.iconFile>>라디오가 지직거린다. "
	<<if V.weatherObj and V.weatherObj.keypointsArr and V.weatherObj.keypointsArr.length gt 1>>
		<<set _forecastDate to new DateTime(V.weatherObj.keypointsArr[1].timestamp)>>
	<<else>>
		<<set _forecastDate to new DateTime(Time.date)>>
	<</if>>
	<<switch Weather.WeatherGeneration.getWeather(_forecastDate).name>>
		<<case "clear">>
			<span class="green">맑은 하늘</span>
		<<case "lightClouds">>
			<span class="orange">약한 흐림</span>
		<<case "lightPrecipitation">>
			<span class="teal">약한 비</span>
		<<case "heavyPrecipitation">>
			<span class="blue">강한 비</span>
		<<case "storm">>
			<span class="lblue">폭풍</span>
		<<case "thunderstorm">>
			<span class="yellow">뇌우</span>
		<<case "heavyClouds">>
			<span class="navy">짙은 흐림</span>
		<<default>>
			<span class="red">오류입니다. 프로스트버그에게 알려 주십시오.</span>
	<</switch>>
	【이가】 예상되는 시각은 <<print window.KR.getMonthKr(_forecastDate.monthName) + " " + _forecastDate.day + "일, ">> <<ampm _forecastDate.hour _forecastDate.minute>>이며, 지금으로부터
	<<if Time.date.compareWith(_forecastDate).days gt 0>>
		<<print Time.date.compareWith(_forecastDate).days>>일 뒤입니다."
	<<elseif Time.date.compareWith(_forecastDate).hours gt 0>>
		<<print Time.date.compareWith(_forecastDate).hours>>시간 <<print Time.date.compareWith(_forecastDate).minutes>>분 뒤입니다."
	<<elseif Time.date.compareWith(_forecastDate).minutes gt 0>>
		<<print Time.date.compareWith(_forecastDate).minutes>>분 뒤입니다."
	<</if>>
	<br>
<</if>>

/* Misc Furniture */
<<deskText "icon">> /* If no desk options (read a book, work on project, etc.) are available, desk and icon appear here */
<<tableText "icon">> /* If no fish tank is available to be placed on an owned table or chairs, table and chairs appear here */

<<if $ltsUsed isnot undefined>>
	<<unset $ltsUsed>>
	당신은 자물쇠 따기 연습 세트를 만지작거린다. <<skulduggerycheck>><<skulduggeryuse>><br>
<</if>>

/* Decorations */
<<if _deco>>
	<<switch _deco.name>>
		<<case "large bear plushie" "large candy pillow">>
			<<furnitureicon _deco.iconFile>>_deco.name【은는】 구석에 놓여 있다.
		<<default>>
			<<furnitureicon _deco.iconFile>>_deco.name【은는】 벽에 걸려 있다.
	<</switch>>
	<br>
<</if>>

<<if _owlplush>>
	<<switch _owlplush.id>>
		<<case "owlplushie">>
			<<set _owlplushNameKr to "부엉이 인형">>
			<<furnitureicon _owlplush.iconFile>><<print _owlplushNameKr>>【은는】 어둠 속에 녹아들 듯 옷장 위에서 내려다보고 있다.
	<</switch>>
	<br>
<</if>>

<<if _windowsill>>
	<<switch _windowsill.name>> /* can be expanded further */
		<<case "ominous jar">> /* unused */
			<<furnitureicon _windowsill.iconFile>> _windowsill.nameCap【은는】 창틀 위에 위협적으로 서 있다.
		<<default>>
			<<furnitureicon _windowsill.iconFile>> _windowsill.name【은는】 창틀에 놓여 있다.
	<</switch>>
	<br>
<</if>>

<<set _shelf to Furniture.get('shelf', $location)>>
	<<if _shelf>>
	<<switch _shelf.name>>
		<<default>>
			<<furnitureicon _shelf.iconFile>>벽에 작은 선반이 하나 놓여 있다.
	<</switch>>
	<br>
	<<else>>
		벽에 약간의 빈 공간이 있다.
		<br>
	<</if>>
<<set _plush to Furniture.get('plush', $location)>>
<<if _plush>>
	<<switch _plush.name>>
		<<case "collection of animal plushes">>
			<<furnitureicon _plush.iconFile>> 작은 여우, 토끼, 고양이, 늑대, 소, 새 인형이 당신을 내려다보고 있다.
		<<case "yellow axolotl plush">>
			<<furnitureicon _plush.iconFile>> 아홀로틀 인형이 말없이 당신을 바라본다.
		<<default>>
			_plush.name【이가】 귀여워 보인다.
	<</switch>>
	<br>
<</if>>

<<whitneyWaterdragonPlushieRoom "bedroom">>


<<if _furniture.poster>>
	<<set _premadePoster to ["cowgirl", "cow_girl", "cat", "puppy"].includes(_furniture.poster.name)>>
	<<set _poster to _premadePoster ? "poster_" + _furniture.poster.name : ['dol', 'degrees of lewdity'].some(e => _furniture.poster.name.toLowerCase().includes(e)) ? "poster_dol" : "poster">>

	<<furnitureicon _poster>>
	<<switch _furniture.poster.name>>
		<<case "cowgirl" "cow_girl">>
			카우걸 포스터가 벽에 걸려 있다.
		<<case "cat">>
			고양이 포스터가 벽에 걸려 있다. 아래에는 "조금만 견뎌!"라고 적혀 있다.
		<<case "puppy">>
			강아지 포스터가 벽에 걸려 있다.
		<<case "blank poster">>
			빈 포스터가 벽에 걸려 있다.
		<<default>> /* Custom */
			_furniture.poster.name 포스터가 벽에 걸려 있다.
			<<if _poster is "poster_dol">>
				이상한 친숙함이 느껴진다.
			<<elseif _furniture.poster.name.startsWith('&lt;&lt;')>>
				<span class="black">부정행위를 들킨 것 같은 기분이 든다.</span>
			<</if>>
	<</switch>>
	<br>
<</if>>

/* Events */
<br>
<<if $robinbed is "yours" and Time.dayState !== "night" and !$possessed>>
	<<unset $robinbed>><<unset $bedGuest>>
	<<npc Robin>><<person1>>로빈이 하품하며 자기 방으로 향한다.<<endevent>>
	<<if Time.hour is 6 and Time.minute lte 20>><<run setRobinLocationOverride("orphanage", 6)>><</if>>
	<br><br>
<</if>>
<<if $unbind is 1>>
	<<unset $unbind>>
	<<if $possessed>>
		당신은 당신의 결박을 내려다본다. 당신이 당기자, 그것들은 당신을 버티지 못하고 부서져 버린다. <<unbind>>
		<br><br>
	<<else>>
		<span class="green">당신은 결박을 <span style="position:relative;top:-5px"><<furnitureicon _desk.iconFile>></span> 책상에 문지른다.</span> 제법 힘이 들지만, 결국 재질이 버티지 못하고 풀려 팔다리가 자유로워진다.
		<br><br>
	<</if>>
<</if>>
<<if $study is 1>>
	<<unset $study>>
	<<if $phase is 1>>
		당신은 과학 교과서를 펼쳐 내용을 읽는다.
	<<elseif $phase is 2>>
		당신은 수학 교과서를 펼쳐 내용을 읽는다.
	<<elseif $phase is 3>>
		당신은 영어 교과서를 펼쳐 내용을 읽는다.
	<<elseif $phase is 4>>
		당신은 역사 교과서를 펼쳐 내용을 읽는다.
	<</if>>
	<<endevent>>
	<br><br>
<</if>>

<<if $nextPassageCheck is "Bedroom">>
	<span class="nextLink"><<link [[달을 바라본다.|Bedroom]]>><</link>></span>
	<br>
<</if>>

<<if $stress gte $stressmax and !$possessed>>
	<<passouthome>>
	<<exit>>
<</if>>

<<if $christmas is 1 and Time.monthDay is 25 and $christmas_robin_visit is undefined and $christmas_robin_gift_received is undefined and Time.dayState isnot "night" and C.npc.Robin.init is 1 and !$possessed>>
	<<set $christmas_robin_visit to true>>
	<<christmas_robin_visit>>
	<<exit>>
<</if>>
<<if $christmas is 1 and !$christmas_wraith>>
	<<rngWraith 1>>
<</if>>

<<if breakableSoftBinding()>>
	<<undobindingsicon>><<link [[결박을 푼다 (0:10)|Bedroom]]>><<set $unbind to 1>><<pass 10>><<unbind>><</link>>
	<br><br>
<</if>>

<<if $worn.face.cursed is 1>>
	<<icon "clothes/gag.png">><<link [[`$worn.face.name【을를】 제거한다 (0:10)`|Bedroom]]>><<pass 10>><<set $worn.face.type.push("broken")>><<faceruined>><</link>>
	<br><br>
<</if>>

<<if $robinpaid is 1 and $robinmissing is 0 and $robinnote isnot 1 and C.npc.Robin.lust gte 10 and C.npc.Robin.love gte 60 and C.npc.Robin.trauma lt 10>>
	<span class="gold">창가에 쪽지가 있다.</span>
	<br>
	<<mysteryicon>><<link [[읽는다|Robin Note]]>><<set $robinnote to 1>><</link>>
	<br><br>
<</if>>

<<if $bedroomUI.orphanage.lock is true>>
	문 잠그기: <<checkbox "$orphanageLocked" 0 1 autocheck>><mouse class="tooltip linkBlue">(?)<span><<if C.npc.Robin.init is 0>>???<<else>>로빈<</if>>【이가】 당신의 잠을 방해하지 못하게 막아 준다.</span></mouse><br>
	창문 잠그기: <<checkbox "$orphanageWindowLocked" 0 1 autocheck>><mouse class="tooltip linkBlue">(?)<span><<if C.npc.Kylar.init is 0>>???<<else>>카일라<</if>>【이가】 당신의 잠을 방해하거나 방에 몰래 들어오지 못하게 막아 준다.</span></mouse><br><br>
<</if>>

/* Desk */
<<deskText "noicon">> /* If project, study, or Christmas options are available, desk location appears here, in line with bed/wardrobe/etc locations */
<br>

/* Blackmailer's Quests while living at Avery's mansion, all of this instead surfaces in Mansion Bedroom. */
<<if !livesInAveryMansion() and $xchange.blackmail.hasMaterial and $xchange.blackmail.cooldown lte 0 and !$xchange.blackmail.activeQuest and !$xchange.blackmail.conclusionPending and $xchange.blackmail.courier isnot "orphanage">>
	/* The selected courier can still deliver first, but an available unread letter must never be hidden from the player's actual home. */
	<<set $xchange.blackmail.courier to "home">>
<</if>>
<<if !livesInAveryMansion() or ($xchange.blackmail.courier is "orphanage" and $xchange.blackmail.hasMaterial and $xchange.blackmail.cooldown lte 0)>>
	<<if $xchange.blackmail.conclusionPending>>
		<span class="gold"><b>NEW!</b></span> <span class="purple">문 옆 바닥에 봉투가 놓여 있다.</span> 밖에서 밀어 넣은 것 같다.
		<br>
		<<icon "ask.png">><<link [[읽는다|Blackmail Conclusion Letter]]>><</link>>
		<br><br>
	<<elseif $xchange.blackmail.activeQuest and $xchange.blackmail.hasReadLetter>>
		책상 위에 봉투가 있다. 이미 내용을 확인했다.
		<br>
		<<icon "ask.png">><<link [[다시 읽는다|Blackmail Reread Letter]]>><</link>>
		<br><br>
	<<elseif ["home","orphanage"].includes($xchange.blackmail.courier) and $xchange.blackmail.hasMaterial and $xchange.blackmail.cooldown lte 0>>
		<span class="gold"><b>NEW!</b></span>
		<<if $xchange.blackmail.intro is 0>>
			문 옆 바닥에 봉투가 놓여 있다.
		<<else>>
			<span class="purple">문 옆 바닥에 봉투가 놓여 있다.</span>
		<</if>>
		밖에서 밀어 넣은 것 같다.
		<<if $xchange.blackmail.courier is "orphanage" and $xchange.blackmail.courierAfk>>
			누가 놓고 갔든, 당신이 나간 사이에 왔다 간 게 분명하다.
		<</if>>
		<br>
		<<icon "ask.gif">><<link [[읽는다|Blackmail Letter]]>><<set $phase to 0>><</link>>
		<br><br>
	<</if>>
<</if>>
<<bankHeistRetryLetter>>

<<if Tamagotchi.robinRescuePending()>>
	<br><br>
	<span class="gold">로빈이 당신의 콘솔 옆에 웅크리고 있다.</span>
	<br>
	<<link [[로빈에게 간다|Robin Console Rescue]]>><</link>>
	<br><br>
<</if>>

창밖에 온도계가 있다. 온도는 <span class="teal"><<print Weather.toSelectedString(Weather.temperature, 0)>></span>라고 표시되어 있다.
<<print setup.WeatherDescriptions.extremeTemperature()>>
<br><br>

<<if _deco>>
	<<if _deco.name is "large bear plushie" and $bedroomUI.orphanage.largeBearPlushie is true>>
		<<furnitureicon _deco.iconFile>><<link [[대형 곰 인형을 끌어안는다 (0:10)|Home Large Bear Plushie Cuddle]]>><<pass 10>><</link>><<ltrauma>><<lstress>>
		<br><br>
	<</if>>
<</if>>

<<autism-stim "Bedroom">>
<<autism-unmask "Bedroom">>
<<autism-focus "Bedroom">>
<<autism-compose "Bedroom">>
<<autism-assessment>>

/* Bed */
당신의 침대가 방의 대부분을 차지하고 있다.
<<if $gwylanSeen?.includes("fox_plushie")>>
	/* ToDo: Gwylan - convert to use furniture system */
	커다란 여우 봉제인형이 추가 베개 역할을 한다.<br>
<</if>>

<<set _bed to Furniture.get('bed', $location)>>
<<if $nextPassageCheck is "Bed">>
	<<if $robinbed is "yours" or $robinbed is "theirs">>
		<span class="nextLink"><<furnitureicon _bed.iconFile>><<link [[로빈.|Bed]]>><</link>></span>
	<<else>>
		<span class="nextLink"><<furnitureicon _bed.iconFile>><<link [[카일라.|Bed]]>><</link>></span>
	<</if>>
	<br>
	<<listsleepoutfits>>
<<elseif !($earSlime.event and $earSlime.noSleep)>>
	<<silently>><<willpowerdifficulty 200 1000>><</silently>>
	<<if ($arousal lt $arousalmax*3/5) or $willpowerSuccess or $orgasmcount gte 1 or $awareness lt 0 or (!$statFreeze and !$hc and $arousalDesensitizedTrait is 1) or (typeof activeInsanityTrait === "function" and activeInsanityTrait())>>
		<br>
		<<furnitureicon _bed.iconFile>><<link [[옷을 벗고 침대에 들어간다|Bed]]>><<undressSleep "bed">><</link>>
		<br>
		<<listsleepoutfits>>
	<<else>>
		<span class="lewd">너무 달아올라 잠들 수 없다. 해결해야 할 욕구가 있다.</span>
		<br>
	<</if>>
<<else>>
	<<if $possessed>>
		<<ind>><span class="purple">머릿속 <<slimeWord>>【은는】 조용하다.</span>
	<<else>>
		<<ind>><span class="red">머릿속 <<slimeWord>>【은는】 잠자리에 들기 전에 <<= window.KR.getEarSlimeOrderKr($earSlime.event)>>기를 원한다.</span>
	<</if>>
	<br>
<</if>>

<<if $bedroomUI.orphanage.masturbation is true and ($awareness gte 0 or $arousal gte 9000)>>
	<<furnitureicon _bed.iconFile>><<link [[침대에서 자위한다|Home Masturbation]]>><<set $masturbationstart to 1>><</link>>
	<br>
<</if>>

<<roomoptions>>
<<safehouseEvents>>
<br>

/* Wardrobe */
<<if _wardrobe is undefined>>
	<<set _wardrobe to Furniture.get("wardrobe", "wardrobe")>>
<</if>>
<<if _wardrobe>>
	당신의 옷은 _wardrobe.name 안에 보관되어 있다.
<</if>>
<br>
<<furnitureicon _wardrobe.iconFile>><<link [[옷장|Wardrobe]]>><</link>>
<br>
/* Fuck machines */
