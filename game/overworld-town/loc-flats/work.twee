	<<set _poppyPatienceOkay to (Array.isArray(T.poppyStatus) and (T.poppyStatus.includes("MidPatience") or T.poppyStatus.includes("HighPatience")))>>
<</if>>

<<if $flats_progress is 1 and random(1, 10) is 10>>
