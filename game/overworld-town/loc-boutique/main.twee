:: Boutique
<<set $bus to "boutiqueshop">>
<div id="clothingShop-div" class="main-shop-div">
	<<luxury_jewelleryShop-main>>
</div>

:: Boutique Widgets [widget]

<<widget "luxury_jewelleryShop-main">>
	<<set $outside to 0>><<set $location to "boutique">><<effects>>
	<<set $shopName = "luxury_jewellery">>

	당신은 다뉴브 가의 부티크 안에 있다.
	<<set $skulduggerydifficulty to 400>><<skulduggerycheck "silent">>
	<<if $skulduggerysuccess is 1 or $transformationParts.traits.sharpEyes isnot "disabled">>
		<<if $fame.social gte 1000 + $fame.business gte 1000 gte 2000>>
			경비원은 당신에게 별로 신경 쓰지 않는다.
		<<elseif $fame.social gte 1000 + $fame.business gte 1000 gte 1000>>
			가끔 경호원의 시선이 당신을 따라오는 것이 느껴진다.
		<<else>>
			감시하는 경비원들의 눈이 당신의 걸음마다 따라온다. 당신은 평범한 손님이 아니다.
		<</if>>
	<<else>>
		<<if $fame.social gte 1000 + $fame.business gte 1000 gte 2000>>
			주변에서 경비원이 보이지 않는다.
		<<elseif $fame.social gte 1000 + $fame.business gte 1000 gte 1000>>
			주변에서 경비원이 보이지 않지만, 가끔 어떤 손님의 시선이 당신을 따라온다.
		<<else>>
			감시당하는 기분이 들지만, 누구인지는 알 수 없다.
		<</if>>
	<</if>>
	<br><br>


	<<if $stress gte $stressmax>>

		<<passoutshop>>
	<<else>>
		<<if Time.hour is $closinghour>>
			폐점 시간이다. 경비원이 모든 사람을 밖으로 몰아내고 있다. <<if $exposed gte 1>>경비원이 이 옷차림을 본다면 얼마나 노출되어 있을지 깨닫고 공황 상태에 빠진다.<</if>>
			<br><br>
		<<else>>
			<<if !Time.openingHours()>>
				어둠 속에 당신 혼자 있다.
				<br><br>
			<</if>>
				<div id="tryonstats-div"><<tryOnStats>></div>
				<<unset $shopListStartCount>>
				<<unset $clothes_choice>>
				<<set $shopPage = 0>>

				<br>

				<span>보온성:</span>
				<<warmthscale>>
				<div id="warmth-description">
					<<warmth_description>>
				</div>
				<br><br>
				<<clothingcategoryicon "all">>
				<<link "전체 보기">><<replace "#clothingShop-div">><<AllShop>><</replace>><</link>>
				<br><br>
				<<clothingcategoryicon "neck">>
				<<link "목 장식 보기">><<replace "#clothingShop-div">><<NeckShop>><</replace>><</link>>
				<br>
				<<clothingcategoryicon "earrings">>
				<<link "귀걸이 보기">><<replace "#clothingShop-div">><<EarringsShop>><</replace>><</link>>
				<br>
				<<clothingcategoryicon "rings">>
				<<link "반지 보기">><<replace "#clothingShop-div">><<RingsShop>><</replace>><</link>>
				<br>
				<<clothingcategoryicon "hand">>
				<<link "장갑 보기">><<replace "#clothingShop-div">><<HandsShop>><</replace>><</link>>
				<br>
				<br><br>
				<<run linkifyDivs('.button-back-to-shop')>>

				<<if Time.dayState is "night" and Time.hour isnot $closinghour and !$weekly.theft.boutique>>
					<<shopicon "register">><<link [[계산대를 살펴본다|Boutique Register]]>><</link>>
					<br>
				<</if>>
		<</if>>
			<<if Time.dayState is "night" or $tryOn.value is 0>>
				<<if $tryOn.value gt 0 and Object.values(V.tryOn?.tryingOn).some(slot => slot?.type.includes("heavy"))>>
					<span class="red">착용해 보고 있는 보석 장신구는 너무 무거워서 훔칠 수 없다!</span>
				<<elseif Time.dayState is "night" and $clothingShop.stolenClothes gt 0>>
					문밖에 경비원이 보인다. <span class="red">그들을 피해 빠져나갈 가능성은 없다.</span>
				<<else>>
					<<getouticon>>
					<<link [[떠난다|Danube Street]]>>
						<<shopClothingFilterReset>>
						<<ShowUnderEquip "normal">>
						<<ShowUnderEquip "over">>
						<<buyTryOnClothes "wear" "steal">>
						<<set $tryOn.autoReset to true>>
						<<shopHoodCheck>>
						<<shopCommandoCheck>>
					<</link>>
					<<if $tryOn.value gt 0>>
						<br>
						<<shopTryOnTrespassPaymentLinks "Danube Street" "보석">>
					<</if>>
				<</if>>
				<br><br>
			<<elseif $tryOn.value isnot 0>>
				<<icon "hanger.png">><<link "보석 장신구를 돌려놓는다">><<clothingReset>>
					<<updatesidebarimg>>
					<<updatesidebardescription>>
					<<updateallure>>
					<<updateclothingshop>>
					<<run updateMoment()>>
				<</link>>
				<br>
				<<if $tryOn.value gt 0 and $tryOn.value lte $money>>
					<<sendItemsToDropdown>>
					<<highicon>><<link "보석 장신구를 산다">><<buyTryOnClothes "wear">><<updatesidebarmoney>><<updateclothingshop>><</link>>
					<br>
					<<wardrobeicon>><<link "보석 장신구를 사서 옷장으로 보낸다">>
						<<buyTryOnClothes "wardrobe">>
						<<updatesidebarmoney>>
						<<updatesidebarimg>>
						<<updatesidebardescription>>
						<<updateallure>>
						<<updateclothingshop>>
						<<run updateMoment()>>
					<</link>>
					<br>
				<</if>>
				<<if $tryOn.value gt 0>>
					<<if Object.values(V.tryOn.tryingOn).some(slot => slot?.type.includes("heavy"))>>
						<span class="red">착용해 보고 있는 보석 장신구는 너무 무거워서 훔칠 수 없다!</span>
					<<else>>
						<<getouticon>><<link [[훔친 보석 장신구를 가지고 나간다|Stolen Jewellery Boutique Result]]>><<shopClothingFilterReset>><<shopHoodCheck>><<shopCommandoCheck>><</link>><<crime "thievery">>
					<</if>>
					<br>
				<</if>>
			<</if>>
		<br>
	<</if>>
<</widget>>

:: Stolen Jewellery Boutique Result
<<effects>>
<<ShowUnderEquip "over">>
<<ShowUnderEquip "normal">>
<<set _theftValue to $tryOn.value>>
<<set _crime to (_theftValue / 50)>>
<<if _crime lt 100>><<set _crime to 100>><</if>>

경비원 몇 명이 당신이 문으로 다가오는 모습을 유심히 지켜본다. 그들을 피해 빠져나갈 방법이 없다는 것을 깨닫고, 당신은 훔친 보석 장신구를 두고 나온다.
<<crimeUp _crime "thievery">>
<<set $weekly.theft.boutique to true>>
<<clothingReset>>

<br><br>
<<link [[다음|Danube Street]]>><<set $tryOn.autoReset to true>><<endevent>><</link>>

:: Boutique Guard

<<set $outside to 1>><<effects>>
부티크는 문을 닫았다. <<openinghours>> 경비원 두 명이 입구 앞에 서서 유심히 지켜보고 있다. 몰래 들어갈 가능성은 없다.
<br><br>

<<getouticon>><<link [[떠난다|Danube Street]]>><<handheldon>><</link>>
