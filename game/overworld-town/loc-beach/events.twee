	<</if>>
	<br><br>

	<<socialiseicon>><<link [[추파를 던진다 (0:05)|Beach Day Encounter]]>><<pass 5>><<set $phase to 2>><</link>><<promiscuous1>>
	<br>
	<<if between(Time.hour, 7, 19) and !Weather.isOvercast and Weather.temperature gte 10>>
		<<cosmeticsicon "sunscreen">><<link [[선크림을 발라준다 (0:03)|Beach Day Encounter Sunscreen 1]]>><<pass 3>><</link>><<promiscuous1>>
		<br>
	<</if>>
	<<if $arousal lt $arousalmax * 3/5 or (!$statFreeze and !$hc and $arousalDesensitizedTrait is 1) or (typeof activeInsanityTrait === "function" and activeInsanityTrait())>>
		<<socialiseicon>><<link [[다정한 대화 (0:10)|Beach Day Encounter]]>><<set $phase to 1>><<pass 10>><<stress -2>><<trauma -1>><</link>><<lstress>><<ltrauma>>
		<br>
		<<getouticon>><<destinationBeach "떠난다">><<endevent>><<set $eventskip to 1>><</destinationBeach>>
		<br>
	<<elseif $willpowerSuccess>>
		<<socialiseicon>><<link [[다정한 대화 (0:10)|Beach Day Encounter]]>><<set $phase to 1>><<pass 10>><<stress -2>><<trauma -1>><<willpowersuccess>><</link>><<lstress>><<ltrauma>>
		<br>
		<<getouticon>><<destinationBeach "Leave">><<endevent>><<set $eventskip to 1>><<willpowersuccess>><</destinationBeach>>
		<br>
	<<else>>
		<span class="lewd">당신은 너무 흥분해서, 머릿속이 온통 섹스뿐이다.</span>
	<</if>>
