	<<unset $xchange.bankHeist.lastObservationDay>><<unset $xchange.bankHeist.heistReady>>
	<<unset $xchange.bankHeist.heistStarted>><<unset $xchange.bankHeist.heistFailureTold>>
	<<unset $xchange.bankHeist.mickeyPrepDay>><<unset $xchange.bankHeist.mickeyPrepDays>>
	<<unset $xchange.bankHeist.hasEarpiece>><<unset $xchange.bankHeist.sneak>>
	<<unset $xchange.bankHeist.failDay>><<unset $xchange.bankHeist.retryLetterRead>>
