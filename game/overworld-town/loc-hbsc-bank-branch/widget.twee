:: Widgets HBSC Bank [widget]

<<widget "hbscOptions">>
	<<if $hbsc.account.level gte 1 and $passage isnot "HBSC Bank Card">>
		<<icon "access-card.png">><<link [[체크카드를 관리한다 (0:02)|HBSC Bank Card]]>><<pass 2>><</link>><br>
	<</if>>
	<<if $passage isnot "HBSC Bank Account">>
		<<if $hbsc.account.level < 1>>
			<<if $id>>
				<<icon "access-card.png">><<link [[HBSC 계좌를 개설한다 (0:02)|HBSC Bank Account]]>><<pass 2>><</link>>
			<<else>>
				<<socialiseicon "ask">><<link [[HBSC 계좌 개설에 대해 묻는다 (0:02)|HBSC Bank Account]]>><<pass 2>><</link>>
			<</if>>
		<<else>>
			<<icon "access-card.png">><<link [[HBSC 계좌를 확인한다 (0:02)|HBSC Bank Account]]>><<pass 2>><</link>>
		<</if>>
		<br>
	<</if>>

	<<if $passage isnot "HBSC Bank Loan" and $passage isnot "HBSC Bank Loan Result">>
		<<shopicon "register">><<link [[돈을 빌리거나 갚는다 (0:02)|HBSC Bank Loan]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $hbsc.account.level >= 1 and $passage isnot "HBSC Bank Deposit" and $passage isnot "HBSC Bank Deposit Confirm" and $passage isnot "HBSC Bank Deposit Result">>
		<<schoolicon "library desk">><<link [[저축 계좌에 현금을 입금한다 (0:02)|HBSC Bank Deposit]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $hbsc.account.level >= 1 and $passage isnot "HBSC Bank Withdraw" and $passage isnot "HBSC Bank Withdraw Confirm" and $passage isnot "HBSC Bank Withdraw Result">>
		<<schoolicon "library desk">><<link [[저축 계좌에서 현금을 인출한다 (0:02)|HBSC Bank Withdraw]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $hbsc.account.level >= 1 and $passage isnot "HBSC Bank Fixed-Term Deposit" and $passage isnot "HBSC Bank Fixed-Term Open" and $passage isnot "HBSC Bank Fixed-Term Source" and $passage isnot "HBSC Bank Fixed-Term Amount" and $passage isnot "HBSC Bank Fixed-Term Confirm" and $passage isnot "HBSC Bank Fixed-Term Open Result" and $passage isnot "HBSC Bank Fixed-Term Manage" and $passage isnot "HBSC Bank Fixed-Term Detail" and $passage isnot "HBSC Bank Fixed-Term Close Result">>
		<<icon "email.png">><<link [[정기 예금을 관리한다 (0:02)|HBSC Bank Fixed-Term Deposit]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $hbsc.account.level >= 1 and $passage isnot "HBSC Bank Standing Orders">>
		<<icon "email.png">><<link [[자동이체를 설정한다 (0:02)|HBSC Bank Standing Orders]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $passage isnot "HBSC Bank Ask Savings Accounts">>
		<<socialiseicon "ask">><<link [[저축 계좌가 어떻게 돌아가는지 묻는다 (0:02)|HBSC Bank Ask Savings Accounts]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<<if $passage isnot "HBSC Bank Ask Fixed-Term Deposits">>
		<<socialiseicon "ask">><<link [[정기 예금이 어떻게 돌아가는지 묻는다 (0:02)|HBSC Bank Ask Fixed-Term Deposits]]>><<pass 2>><</link>>
		<br>
	<</if>>

	<br><<getouticon>><<link [[떠난다|High Street]]>><<endevent>><</link>>
<</widget>>

<<widget "hbscJournal">>
	<<if setup.hbsc and setup.hbsc.ensureState>>
		<<run setup.hbsc.ensureState()>>
		<<set _hbscNoticeSummary to setup.hbsc.summariseNotices($hbsc.notices)>><<set _hbscTermSummary to setup.hbsc.summariseFixedTerms($hbsc.fixedTerms)>><<set _hbscBanDays to setup.hbsc.getBanRemainingDays()>>
		<<set _hbscAutoEnabled to []>>
		<<for _i, _bill range setup.hbsc.AUTOPAY_BILLS>><<if setup.hbsc.isAutoPayEnabled(_bill.id)>><<run _hbscAutoEnabled.push(_bill.label)>><</if>><</for>>
		<<set _hbscAutoCancelled to $hbsc.notices.filter(n => n and n.type is "autoPayCancelled")>>
		<<if $hbsc.account.level >= 1 or _hbscBanDays > 0 or _hbscNoticeSummary.savingsInterestCount > 0 or _hbscNoticeSummary.maturedCount > 0 or _hbscTermSummary.activeCount > 0 or _hbscTermSummary.maturedCount > 0 or _hbscAutoEnabled.length > 0 or _hbscAutoCancelled.length > 0 or ($hbsc.loan and $hbsc.loan.owed > 0)>>
			<hr>
			<h1 class="header gold bold">HBSC 은행</h1>
			<ul class="journal">
				<<if $hbsc.card>><li><<hbscCardStatus>></li><</if>>
				<<if $hbsc.account.level >= 1>>
					<<icon "access-card.png">><span class="gold"><<print setup.hbsc.getTierName($hbsc.account.level)>></span>
					|
					총 저축액: <<printmoney $hbsc.account.deposit>>
				<</if>>
				<<if $hbsc.loan and $hbsc.loan.owed > 0>>
					<li><<shopicon "register">><span class="red">미상환 대출:</span> 갚아야 할 금액이 <<printmoney $hbsc.loan.owed>> 남았습니다.<<if $hbsc.loan.autoRepay>> 게다가 <span class="red">연체</span> 중입니다!<</if>></li>
				<</if>>
				<<if _hbscBanDays > 0>>
					<li>당신은 <span class="red"><<print _hbscBanDays>>일</span> 동안 HBSC 창구 이용이 정지되었습니다.</li>
				<</if>>
				<<if _hbscNoticeSummary.savingsInterestCount > 0 or _hbscNoticeSummary.maturedCount > 0>>
					<li>
						최근 변동
						<<if _hbscNoticeSummary.savingsInterestCount > 0>>
							+<<printmoney _hbscNoticeSummary.savingsInterestTotal>> 저축 이자
						<</if>>
					</li>
				<</if>>
				<<if _hbscTermSummary.activeCount > 0>>
					<li>
						진행 중인 정기 예금이 <span class="gold"><<print _hbscTermSummary.activeCount>></span>건 있고, <<printmoney _hbscTermSummary.activePrincipalTotal>>【을를】 묶어 두었으며
						<<if _hbscTermSummary.nearestDaysRemaining is 0>>
							다음 만기는 <span class="pink">오늘</span>입니다
						<<elseif _hbscTermSummary.nearestDaysRemaining is 1>>
							다음 만기는 <span class="gold">내일</span>입니다
						<<else>>
							다음 만기는 <span class="gold"><<print _hbscTermSummary.nearestDaysRemaining>></span>일 뒤입니다
						<</if>>
					</li>
				<</if>>
				<<if _hbscTermSummary.maturedCount > 0>>
					<li>수령할 수 있는 만기 정기 예금이 <span class="gold"><<print _hbscTermSummary.maturedCount>></span>건 있습니다. 합계 <<printmoney _hbscTermSummary.maturedReadyTotal>></li>
				<</if>>
				<<if _hbscAutoEnabled.length > 0>>
					<li><<icon "email.png">>자동이체로 처리되는 요금: <span class="teal"><<print _hbscAutoEnabled.join(", ")>></span></li>
				<</if>>
				<<if _hbscAutoCancelled.length > 0>>
					<<for _i, _c range _hbscAutoCancelled>>
						<li><span class="red"><<print _c.label>> 자동이체가 해지되었습니다.</span> 저축이 모자랐기 때문입니다.</li>
					<</for>>
				<</if>>
			</ul>
		<</if>>
	<</if>>
<</widget>>

<<widget "hbscStatistics">>
	<<if setup.hbsc and setup.hbsc.ensureState>>
		<<run setup.hbsc.ensureState()>>
		<<set _hbscNoticeSummary to setup.hbsc.summariseNotices($hbsc.notices)>>
		<<set _hbscTermSummary to setup.hbsc.summariseFixedTerms($hbsc.fixedTerms)>>
		<<set _hbscBanDays to setup.hbsc.getBanRemainingDays()>>
		<<set _hbscHasAccount to $hbsc.account.level gte 1>>
		<<if _hbscHasAccount or _hbscBanDays gt 0 or _hbscTermSummary.activeCount gt 0 or _hbscTermSummary.maturedCount gt 0 or _hbscNoticeSummary.savingsInterestCount gt 0 or _hbscNoticeSummary.maturedCount gt 0>>
			<<set _hbscTier to setup.hbsc.getSavingsTier($hbsc.account.level)>>
			<<set _hbscMinBalance to setup.hbsc.getSavingsMinimumBalance($hbsc.account.level)>>
			<<set _hbscRoom to _hbscHasAccount ? setup.hbsc.getDepositRoom($hbsc.account.level, $hbsc.account.deposit) : 0>>
			<<set _hbscQualifies to _hbscHasAccount and $hbsc.account.deposit gt 0 and $hbsc.account.deposit gte _hbscMinBalance>>
			<<set _hbscMissing to _hbscHasAccount ? Math.max(0, _hbscMinBalance - $hbsc.account.deposit) : 0>>
			<<foldout false "_hbscFoldout">>
				<span class="gold">HBSC 은행</span>
				<<if _hbscBanDays gt 0>>
					창구 이용 정지: <span class="red"><<print _hbscBanDays>>일</span>
					<br>
				<</if>>
				<<if _hbscHasAccount>>
					등급: <<print _hbscTier.name>>
					<br>
					저축 잔액: <<printmoney $hbsc.account.deposit>>
					<br>
					남은 예치 한도: <<if Number.isFinite(_hbscRoom)>><<printmoney _hbscRoom>><<else>>무제한<</if>>
					<br>
					저축 금리: 연 <<print _hbscTier.interestAER.toFixed(2)>>% (AER)
					<br>
					이자 지급 기준 잔액: <<if _hbscMinBalance gt 0>><<printmoney _hbscMinBalance>><<else>>없음<</if>>
					<br>
					이번 달 저축 이자 지급 대상: <<print _hbscQualifies ? "예" : "아니요">>
					<<if not _hbscQualifies and _hbscMinBalance gt 0>>
						<br>
						지급 대상이 되기까지 부족한 금액: <<printmoney _hbscMissing>>
					<</if>>
					<br>
					마지막으로 지급된 월 저축 이자: <<if $hbsc.lastSavingsInterest gt 0>><<printmoney $hbsc.lastSavingsInterest>><<else>>없음<</if>>
					<br>
				<</if>>
				지점에서 기다리는 최근 이자 안내: <<print _hbscNoticeSummary.savingsInterestCount>>
				<br>
				지점에서 기다리는 최근 정기 예금 만기 안내: <<print _hbscNoticeSummary.maturedCount>>
				<br>
				진행 중인 정기 예금: <<print _hbscTermSummary.activeCount>>
				<br>
				진행 중인 정기 예금에 묶인 원금: <<printmoney _hbscTermSummary.activePrincipalTotal>>
				<br>
				<<if _hbscTermSummary.nearestDaysRemaining isnot null>>
					가장 가까운 정기 예금 만기: <<print _hbscTermSummary.nearestDaysRemaining>>일
					<br>
				<</if>>
				수령 대기 중인 만기 정기 예금: <<print _hbscTermSummary.maturedCount>>
				<br>
				수령 가능 총액: <<printmoney _hbscTermSummary.maturedReadyTotal>>
			<</foldout>>
		<</if>>
	<</if>>
<</widget>>

<<widget "hbscCardStatus">>
	<<if $hbsc.card>>
		<<switch $hbsc.card.status>>
			<<case "active">>
				체크카드: <<if $hbsc.card.preferred>>카드를 받는 곳에서는 카드로 결제<<else>>현금으로 결제<</if>>.
			<<case "stolen">>
				<span class="red">체크카드를 도난당했습니다.</span> HBSC에서 신고해 비접촉 결제를 막으십시오. 신고하기 전까지 도둑이 7일마다 최대 &pound;<<print $npcStealCardWeeklyLimit ?? 100>>까지 쓸 수 있습니다.
			<<case "blocked">>
				도난당한 카드는 차단되었습니다. HBSC에서 재발급을 신청할 수 있습니다.
			<<case "replacement">>
				<<if Time.days gte $hbsc.card.readyDay>>
					재발급 카드를 HBSC에서 수령할 수 있습니다.
				<<else>>
					재발급 카드는 <<print $hbsc.card.readyDay - Time.days>>일 뒤에 준비됩니다.
				<</if>>
		<</switch>>
		<<if $hbsc.card.losses gt 0>>
			<br>지난 카드 도난으로 발생한 무단 결제: <span class="red"><<printmoney $hbsc.card.losses>></span>.
		<</if>>
	<</if>>
<</widget>>