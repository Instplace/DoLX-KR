:: Widgets Changing Room [widget]

<<widget "changingRoomSetup">>
	<<unset $lastChangingRoom>>
	<<outfitChecks>>
	<<set _changingRoomGenderType to _args[0]>>
	<<set _transChangingRoomGender to $player.gender_appearance>>
	/* For trans players, comfort follows gender identity (their currently used pronouns), not body appearance.
	   Falls back to appearance when identity is neutral/unset, so non-binary or unconfigured saves are unaffected. */
	<<if $background.transgender>>
		<<set _resolvedPronounGender to playerPronoun()>>
		<<if _resolvedPronounGender is "m" or _resolvedPronounGender is "f">>
			<<set _transChangingRoomGender to _resolvedPronounGender>>
		<</if>>
	<</if>>
	<<if ["School Boy Changing Room", "School Girl Changing Room"].includes($passage)>>
		<<if $previousClothes is undefined>><<set $previousClothes to clone($worn)>><</if>>
		<<run (() => {
			const V = State.variables;
			const T = State.temporary;
			const worn = V.worn || {};
			const prev = V.previousClothes || {};
			Object.entries(worn).forEach(([slot, item]) => {
				const curItem = (item && typeof item === "object") ? item : {};
				const prevItem = (prev[slot] && typeof prev[slot] === "object") ? prev[slot] : {};
				const curName = (curItem.name ?? curItem.type ?? "");
				const prevName = (prevItem.name ?? prevItem.type ?? "");
				const curCol  = (curItem.colour ?? "");
				const prevCol = (prevItem.colour ?? "");
				const curAcc  = (curItem.accessory_colour ?? "");
				const prevAcc = (prevItem.accessory_colour ?? "");
				if (curName !== prevName || curCol !== prevCol || curAcc !== prevAcc) {
					if (slot === "upper" || slot === "under_upper") T._justChangedUpperClothes = true;
					if (slot === "lower" || slot === "under_lower") T._justChangedLowerClothes = true;
					T._justChangedClothes = true;
				}
			});
		})()>>
		<<set $previousClothes to clone($worn)>>
	<</if>>

	<<set _stayedInLocker to ["School Boy Changing Room", "School Girl Changing Room", "School Pool Wardrobe"].includes($passagePrev)>>

	<<set _knownHerm to ($schoolrep.herm gte 5 and $player.penisExist and $player.vaginaExist and $changingroomstate isnot "empty")>>
	<<set _knownCrossdress to ($schoolrep.crossdress gte 5 and $changingroomstate isnot "empty")>>
	<<set _studentsKnow to (_knownHerm or _knownCrossdress)>>

	/* Base setup */
	<<if _knownHerm>>
		/* known herm can use either room */
		<<set _allowedToChange to true>>
	<<else>>
		<<set _allowedToChange to [_args[0], "h"].includes(_studentsKnow ? $player.sex : $player.gender_appearance)>>
	<</if>>

	/* Specific changing room overrides */
	<<if _args[0] is "f">>
		<<set _genderChance to 100 - maleChance()>>

		<<if !$daily.school.changingRoomPregnancyFame>><<set $daily.school.changingRoomPregnancyFame to $player.gender_appearance is "m" ? random(500, 1500) : random(200, 1000)>><</if>>
		<<if $fame.pregnancy gte $daily.school.changingRoomPregnancyFame or
			playerBellyVisible() or
			($settings.forcedCrossdressingEnabled and $whitneyCrossdressSwimwear gte 1 and $player.gender_appearance is "f")>>
			<<set _allowedToChange to true>>
		<</if>>
		<<if $daily.school.changingRoomGirlAllowed and $changingroomstate isnot "empty">>
			<<set _studentsKnow to true>>
			<<set _allowedToChange to true>>
		<</if>>
	<<else>>
		<<set _genderChance to maleChance()>>
	<</if>>
	<<if $background.transgender and $schoolrep.transgender is _args[0] and _transChangingRoomGender is _args[0] and $changingroomstate isnot "empty">>
		<<set _studentsKnow to true>>
		<<set _allowedToChange to true>>
	<</if>>

	/* Final override: known herm should never be blocked by crossdress logic */
	<<if _knownHerm>>
		<<set _studentsKnow to true>>
		<<set _allowedToChange to true>>
	<</if>>

	<<set _seenGender to (_studentsKnow ? $player.sex : $player.gender_appearance)>> <!-- If they know you crossdress, they judge you by the body the rumours describe, not by appearance -->
	<<if $background.transgender>>
		/* Trans players: comfort is tied to gender identity, not sex. Same-gender room = home; opposite-gender room = wrong room. */
		<<set _uncomfortable to (_transChangingRoomGender isnot _args[0] and _transChangingRoomGender isnot "h")>>
	<<elseif $backgroundTraits.includes("crossdresser")>>
		/* Crossdresser background: uncomfortable in their birth-sex changing room. Use original sex so X-Change does not reverse this. */
		<<set _uncomfortable to (playerOriginalSex() is _args[0])>>
	<<else>>
		<<set _uncomfortable to false>>
	<</if>>
	<<set _notStartedLesson to Time.hour is 14 and Time.minute lte 5>>
	<<set _finishedLesson to Time.hour is 15 or (Time.hour is 14 and Time.minute gte 58)>>
<</widget>>

<<widget "schoolChangingRoomEmpty">>
	<<if $changingroomstate is "empty" and $poolroomstate isnot "empty">>
		현재는 텅 비어 있지만, 수영장 쪽에서 활동하는 소리가 들린다. <<if $poolroomstate is "own">>수업이 진행 중이다.<</if>>
		<<changingRoomFeelings 1>>
		<br><br>
		<<schoolPoolSwap>>
		<<raidLockers>>
		<<schoolChangingRoomLinks>>
	<<elseif $changingroomstate is "empty">>
		텅 비어 있다.
		<<changingRoomFeelings 2>>
		<br><br>
		<<if ["changingRoom", "party", "rape"].includes($weekly.schoolNightPoolParty) and Time.dayState is "night">>
			<span class="blue">수영장에서 사람들이 대화하는 소리와 물장구치는 소리가 들린다.</span>
			<<if $weekly.schoolNightPoolParty is "changingRoom">>
				<br>
				<<investigateicon>><<link [[Peek inside|School Night Pool Party Peek]]>><</link>>
			<</if>>
			<br><br>
		<</if>>
		<<if $leightonCamerasKnown and Time.dayState is "night" and !$weekly.lockerCamerasSabotaged>>
			<<set $skulduggerydifficulty to 400>>
			<<photographystudioicon>><<link [[Look for Leighton's hidden cameras (0:20)|School Changing Room Cameras]]>><<set $skulduggerydifficulty to 400>><<pass 20>><<skulduggerycheck "silent">><</link>><<skulduggerydifficulty>>
			<br><br>
		<</if>>
		<<schoolChangingRoomLinks>>
	<</if>>
<</widget>>

<<widget "schoolChangingRoomLinks">>
	<<set $wardrobe_location to resolveWardrobeLocation($changingRoomGender is "boys" ? "schoolBoys" : "schoolGirls")>>
	<<if $exposed gte 2 and hasSexStat("exhibitionism", 4) and $poolroomstate isnot "empty">>
		<<swimmingicon>><<link [[수영장으로 들어간다|School Pool]]>><<set $lastChangingRoom to $passage>><<set $justEntered to true>><<unset $previousClothes>><</link>><<if $swimall isnot 1>><<gdelinquency>><</if>>
	<<elseif $exposed gte 2 and $swimall isnot 1 and $poolroomstate isnot "empty">>
		<span class="pink">이런 차림으로는 수영장에 들어갈 수 없다!</span>
	<<elseif $weekly.schoolNightPoolParty is "rape" and Time.dayState is "night">>
		<span class="purple">더 자극하지 않는 편이 좋다.</span>
	<<else>>
		<<swimmingicon>><<link [[수영장으로 들어간다|School Pool]]>><<set $lastChangingRoom to $passage>><<set $justEntered to true>><<unset $previousClothes>><</link>>
	<</if>>
	<br>
	<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and !$hypnosis_traits?.silence>>
		<span class="red">The <<slimeWord>> in your ear refuses to allow you to leave with <<underwearTypeText>> on.</span>
	<<elseif $exhibitionism lte 75 and $exposed gte 1>>
		<span class="pink">이런 차림으로는 나갈 수 없다!</span>
	<<elseif $exposed gte 1>>
		<<getouticon>><<link [[나간다|School Pool Entrance Exhibitionism]]>><<unset $previousClothes>><</link>>
	<<else>>
		<<getouticon>><<link [[나간다|School Pool Entrance]]>>
			<<if $daily.whitney.whitneyCrossdressSwimwear>><<run $daily.whitney.whitneyCrossdressSwimwear.push(`${$changingRoomGender} exit`)>><</if>><<unset $previousClothes>>
		<</link>>
	<</if>>
	<<schoolpoolclothes _store_location>>
	<<lockericon>><<link [[사물함|School Pool Wardrobe]]>><</link>>
	<<exitAll>>
<</widget>>

<<widget "destination_pool">>
	<<if $changingRoomGender is "boys">>
		<<link [[다음|School Boy Changing Room]]>><<endevent>><</link>>
	<<else>>
		<<link [[다음|School Girl Changing Room]]>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "changingRoomFeelings">>
	<<if $schoolrep.crossdress lt 3 and _args[0] is undefined>>
		<<if ($background.transgender and _transChangingRoomGender is _changingRoomGenderType) or (!$background.transgender and $backgroundTraits.includes("crossdresser") and playerOriginalSex() isnot _changingRoomGenderType)>>
			<<if !$daily.school.changingRoomStressRelief>>
				<span class="green">그 사실이 기분 좋게 느껴진다.</span><<lstress>><<stress -3>><<set $daily.school.changingRoomStressRelief to true>>
			<<else>>
			그 사실이 기분 좋게 느껴진다.
			<</if>>
		<<elseif isCrossdressing() and !_uncomfortable>>
			왠지 엉뚱한 짓을 하는 것 같은 기분이 든다.
		<</if>>
	<<elseif _uncomfortable>>
		<br><br>
		<<switch _args[0]>>
			<<case 1>>혼자 있는데도, <<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
			<<case 2>>그럼에도 불구하고, <<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
			<<default>><<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
		<</switch>><<gstress>><<stress 1>>
	<<elseif isCrossdressing()>>
		/* Intentional lack of br */
		<<switch _args[0]>>
			<<case 1>>혼자 있는데도 여기에 있으니 왠지 짓궂은 짓을 하는 기분이 드는 한편, 들키지 않을까 걱정된다.
			<<case 2>>그럼에도 불구하고 여기에 있으니 왠지 짓궂은 기분이 든다.
			<<default>> /* Intentional blank, this one is handled outside the widget */
		<</switch>>
	<</if>>
<</widget>>

<<widget "eventsSchoolChangingRoomsBoys">>
	<<if $daily.school.changingRoomBoyEvent is Time.date.timeStamp or random(0, 100) gte 25>><<exit>><</if>>
	/* These events make use non-widget usages of "he", "his", etc. These are intentional and should not be changed */
	<<cleareventpool>>
	<<if $poolroomstate is "own" and $worn.under_lower.name is "naked" and ($worn.lower.name is "naked" or $worn.lower.name.includes("towel"))>>
		<<if $worn.lower.name.includes("towel")>>
			<<if _genderChance gt 0 and $player.penisExist and !playerChastity("hidden")>>
				<<addinlineevent "schoolChangingRoomBoysEvent">>
					<<if $worn.genitals.name is "chastity parasite" or (!playerChastity("penis") and $parasite.penis.name)>>
						<<set _chastity to "기생충으로 덮인">>
					<<elseif playerChastity("cage")>>
						<<set _chastity to "정조대에 갇힌">>
					<<else>>
						<<set _chastity to "">>
					<</if>>
					급우 중 한 명이 손이 닿지 않는 틈을 타 당신의 허리에서 수건을 낚아채어, 급우들 앞에서 당신의 <<genitals>>【을를】 노출시킨다.
					<<lowerruined true>>
					<<if $player.penissize is 6>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 황급히 몸을 가리는 당신의 <<EZbig>><<if _chastity>>, 하지만 _chastity<</if>> <<EZpenis>>【을를】 보며 저속한 농담을 던진다.
					<<elseif $player.penissize lte 3>>
						The changing room erupts into laughter at your newly exposed <<EZsmall>><<if _chastity>> and _chastity<</if>> <<genitals>>. <<Penisremarkquote>> says one of the <<worldMale 'boys' 'girls'>> as you clasp your hands over your <<EZsmall>> <<EZpenis>> in shame.
						<<status -5>><<lcool>>
					<<else>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 황급히 몸을 가리는 당신의<<if _chastity>> _chastity<</if>> <<EZpenis>>【을를】 보며 저속한 농담을 던진다.
					<</if>>
					<<incgpenisinsecurity>><<trauma 5>><<gtrauma>>
				<</addinlineevent>>
			<</if>>
		<<else>> /* $worn.lower.name is "naked" */
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				<<if _genderChance gt 0 and random(0, 100) gte 75 and $player.penisExist and !playerChastity("hidden")>>
					<<if $worn.genitals.name is "chastity parasite" or (!playerChastity("penis") and $parasite.penis.name)>>
						<<set _chastity to "기생충으로 덮인">>
					<<elseif playerChastity("cage")>>
						<<set _chastity to "정조대에 갇힌">>
					<<else>>
						<<set _chastity to "">>
					<</if>>
					One of your classmates grabs both of your arms and tugs them behind your back as <<worldMale 'he' 'she'>> yells for everyone to look.
					<<if $player.penissize is 6>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 당신의 <<EZbig>><<if _chastity>>, 하지만 _chastity<</if>> <<genitals>>【을를】 보며 저속한 농담을 던진다.
						<br><br>

						Having had their fun, the <<worldMale 'boy' 'girl'>> lets you go, and the room goes back to how it was. You still hear the odd whisper about your unusual size mixed in with the general murmuring between students.
					<<elseif $player.penissize lte 3>>
						새로 드러난 당신의 <<EZsmall>> <<genitals>>【을를】 보고 탈의실이 폭소로 가득 찬다.
						<br><br>

						<<Penisremarkquote>> says one of the <<worldMale 'boys' 'girls'>>, before your arms are released and you quickly clasp your hands over your <<EZsmall>><<if _chastity>> and _chastity<</if>> <<EZpenis>> in shame.
						<<status -5>><<lcool>>
					<<else>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 당신의 <<genitals>>【을를】 보며 저속한 농담을 던진다.
						<br><br>

						Having had their fun, the <<worldMale 'boy' 'girl'>> lets you go, and the room goes back to how it was.
					<</if>>
					<<trauma 5>><<gtrauma>><<incgpenisinsecurity>>
				<<else>>
					One of the <<worldMale 'boys' 'girls'>> whips your naked backside with a towel, and the changing room erupts into laughter. "If you don't want us using your butt for target practise you should <<print ["cover it", "get dressed", "put something over it", "put something on", "put your clothes on"].pluck()>>" says the <<worldMale 'boy' 'girl'>>.
					<<pain 2>><<gpain>>
				<</if>>
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<addinlineevent "schoolChangingRoomBoysEvent">>
		A couple of the more confident <<worldMale 'boys' 'girls'>> are comparing their penis sizes. No one pays you any mind.
		<br><br>
		"<<worldMale 'Dude' 'Girl'>>, nice cock!" You hear one of the <<worldMale 'boys' 'girls'>> across the room compliment a peer. "Who do you think is bigger?" <<worldMale 'He' 'She'>> and <<worldMale 'his' 'her'>> friend <<= either("hold their shafts next to each other and compare lengths", "boast about who's bigger", "brag about how they can satisfy their partners")>>. Eventually they put on their <<if Time.minute gte 45>>clothes and leave the changing room<<else>>swim trunks and head into the pool room<</if>>.
	<</addinlineevent>>
	<<if $settings.maleVictimChance gt 0>>
		<<if _finishedLesson>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				One of the <<worldMale 'guys' 'girls'>> asks around the room to see if anyone has an extra pair of underwear. <<worldMale 'He' 'She'>> claims that someone broke into <<worldMale 'his' 'her'>> locker and took <<worldMale 'his' 'hers'>>. No one offers to help, leaving <<worldMale 'him' 'her'>> to nervously put <<worldMale 'his' 'her'>> shorts on and leave the locker room.
			<</addinlineevent>>
		<</if>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			One of the larger <<worldMale 'boys' 'girls'>> rips a towel away from one of your smaller classmates. The bully <<= either("twists it into a rattail and whips it at the <<worldMale 'boy' 'girl'>>'s naked body", "holds the towel over <<worldMale 'his' 'her'>> head as <<worldMale 'he' 'she'>> mocks the <<worldMale 'boy' 'girl'>>'s size")>>. The smaller <<worldMale 'guy' 'girl'>>'s almost in tears by the time <<worldMale 'he' 'she'>> returns the towel. Thankfully, no one interrupts you as you get changed.
		<</addinlineevent>>
		<<if _notStartedLesson>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				On the other side of the room, a group of popular <<worldMale 'boys' 'girls'>> start picking on a nerdy <<worldMale 'boy' 'girl'>>. They give <<worldMale 'him' 'her'>> a massive wedgie, lifting <<worldMale 'him' 'her'>> off the ground by <<worldMale 'his' 'her'>> underwear. The fabric eventually tears, leaving the nerdy <<worldMale 'boy' 'girl'>> mortified and naked on the cold floor as the others leave the locker room. Thankfully, they leave you alone.
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<if $player.perceived_breastsize gte 3>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			One of the <<worldMale 'boys' 'girls'>> changing nearby looks you over and teases, "If your pecs get any bigger, we may need to make you use the girls' locker room." The others chuckle and smirk.
			<<if $player.sex is "f" and $player.gender_appearance is "f" and isCrossdressing() and !_studentsKnow>>
				그들은 당신이 실제로는 여자라는 사실을 모른다. <<if _uncomfortable>><<gstress>><<stress 1>><</if>>
			<<else>>
				<<stress 5>><<gstress>>
			<</if>>
		<</addinlineevent>>
		<<if _genderChance gt 0>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				<<generatesm1>><<person1>>
				You feel a hand grope your <<breasts>> from behind. Spinning in place, you see a <<person>> with a grin on <<worldMale 'his' 'her'>> face.
				<<endevent>>
				<<if $player.breastsize gte 9>>
					"젠장, 엄청나네! 언젠가 그 슴가를 출렁거리게 만들고 싶단 말이지."
				<<elseif $player.breastsize gte 6>>
					"와우, 가슴이 커다랗네! 언젠가 어떻게 다뤄야 할지 구경하고 싶어."
				<<else>>
					"예쁜 가슴이네. 언젠가 한번 맛보고 싶어!"
				<</if>>
				<<worldMale 'He' 'She'>> gives you a wink
				<<arousal 300 "bottom">>
				<<if $pleasure gte $pleasuremax>>
					마침내 당신을 절정 직전까지 밀어붙인다.
					<<garousal>>
					<br><br>
					<<orgasm>>
					<<set $orgasmcurrent to 0>>
					"Someone's clearly pent up," <<worldMale 'he' 'she'>> laughs.
					<<if $adultshopunlocked and random(1)>>
						"성인용품점에서 마사지기라도 하나 사보라고, 그거 꽤 재밌거든."
					<<else>>
						"네가 풀 수 있도록 도와줄 다른 사람을 찾아보는 게 좋을걸."
					<</if>>
				<<elseif $pleasure gte $pleasuremax / 2>>
					그리고는 몸을 돌려 가버리며, 당신에게 야릇한 흥분을 남긴다. <<garousal>>
				<<else>>
					그리고는 가버리며, 당신을 당황스럽게 만든다. <<garousal>>
				<</if>>
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<if $player.penisExist>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			근처에서 옷을 갈아입던 급우 중 하나가 <<if _bottomless>>당신의 성기<<else>>당신의 <<exposedlower>> 속에 불룩하게 솟아오른 부위<</if>>【을를】 턱짓으로 가리킨다.

			<<if playerChastity("penis")>>
				<<if $worn.genitals.name is "chastity parasite">>
					"Dude, what is that thing? Is it... moving?"
				<<elseif playerChastity("cage")>>
					"Hold on, is that a cage? Who's got you locked up like that?"
				<<else>>
					"Wait, is that a chastity belt? Christ, who did you piss off?"
				<</if>>
			<<elseif $player.penissize gte 5>>
				"시선은 혼자 다 독차지하겠는데!"
			<<elseif $player.penissize gte 3>>
				"제법 묵직한 물건을 가졌네. 재미 좀 보나?"
			<<else>>
				"그 조그마한 걸로 누굴 만족시키기나 하겠어."
			<</if>>
			<br><br>
			<<if playerChastity("penis")>>
				You mumble something noncommittal and keep your eyes on your locker, hoping <<worldMale "he'll" "she'll">> drop it. <<stress 3>><<gstress>>
			<<elseif _uncomfortable>>
				당신은 대충 얼버무리며 최대한 빨리 대화를 끝내려고 애쓴다. <<stress 5>><<gstress>>
