	<<set $_wearingSkirt to (clothingData('lower', $worn.lower, "skirt") is 1)>>
	<<set $_whitneyMadAtUnderwear to _args[1] is "panties" and $_wearingSkirt and !$worn.under_lower.type.includes("naked") and
		($whitneypantiescheck is 1 or ($whitneypantiescheck is 2 and $worn.under_lower.gender isnot "f" and $settings.forcedCrossdressingEnabled))>>
	<<set $_whitneyMadAtSkirt to $settings.forcedCrossdressingEnabled and $whitneyskirtcheck gte 1 and (!$_wearingSkirt or ($worn.lower.reveal lte 200))>>
	<<set $_whitneyMadAtClothes to $settings.forcedCrossdressingEnabled and $whitneyCrossdressSchool gte 1 and _maleClothes.length>>

	<<if $_whitneyMadAtUnderwear or $_whitneyMadAtSkirt or $_whitneyMadAtClothes>>
		<<if _args[0]>>
			<<print _args[0]>>
		<<else>>
			휘트니의 찌푸린 표정에 반응할 새도 없이, <<he>>【이가】 <<his>> 손으로 당신의 손목을 움켜쥔다.
		<</if>>

		<<if _args[1] is "skipFirstComment">>
		<<elseif $_whitneyMadAtSkirt and !$_wearingSkirt>>
			"보여달라는데도 실패하고 내 규칙까지 어겨? 치마는 어따 팔아먹었어."
		<<elseif $_whitneyMadAtUnderwear>>
			<<if $whitneypantiescheck is 1>>
				"난 진심으로 <<if $player.gender_appearance is "f">>팬티<<else>>속옷<</if>>【을를】 입지 말라고 했는데, 내 규칙을 어기는 걸 보여주려는 거냐?"
			<<elseif $whitneypantiescheck is 2 and $worn.under_lower.gender isnot "f">>
				"내 규칙을 어기는 걸 보여주려는 거냐? 난 팬티를 입으라고 했고, 진심이었다고."
			<</if>>
		<<elseif $_whitneyMadAtSkirt>>
			"치마 길이가 존나 길잖아."
			<<set $_skipNextSkirtComment to true>>
		<<else>>
			"내 규칙을 어떻게 깨는지 보여주려는 거냐?"
		<</if>>
		<<if $daily.whitney.punished>><<He>>【은는】 한숨을 쉰다. "대체 몇 번을 말해야 알아처먹을래?"<<npcincr Whitney love -1>><<llove>><</if>>
		<br><br>
		<<He>>【은는】 당신을 복도로 데려가기 위해 계단 쪽으로 질질 끌고 가기 시작한다.
		<<if $_whitneyMadAtClothes>>
			<<He>> sneers, "Did you think I would be blind to the fact you're clearly wearing boys' clothes?"
		<<elseif $_whitneyMadAtSkirt and !$_wearingSkirt>>
			<<He>>【은는】 조소한다. "네가 네 팬티를 얌전히 까 보여주기를 기대하고 있었는데 말이지."
		<<elseif $_whitneyMadAtSkirt and !$_skipNextSkirtComment>>
			<<He>>【은는】 조소한다. "치마 길이가 존나 길잖아."
		<<else>>
			정적은 당신이 복도에 도달할 때까지만 이어진다.
		<</if>>
		<br><br>
		<<whitneyRulePunishment true>>
		<<exitAll>>
	<</if>>
<</widget>>

<<widget "events_school_library_study">>
	<<rng 100>>
	<<if $scienceprojectwon is 1 and $rng gte 91>>
		<<generates1>><<person1>>한 <<person>>【이가】 당신의 테이블에 멈춰 선다. "저기, 너 과학 경진대회에서 우승한 그 <<girl>>, 맞지?"
		<br><br>

		<<if $speech_attitude is "meek">>
			"아, 그렇게 대단한 건 아니었는데..." 당신은 수줍게 고개를 끄덕이며 시선을 피한다.
		<<elseif $speech_attitude is "bratty">>
			당신은 자랑스럽게 공중에 엄지를 치켜세운다. "바로 나야!"
		<<else>>
			"내가 그랬지." 당신은 고개를 끄덕인다. "무슨 일이야?"
		<</if>>
		<br><br>

		그 <<personsimple>>【은는】 미소를 지으며 고개를 끄덕여 화답한다. "대단하다! 네 프로젝트는 정말 잘 연구됐더라, 뭘 해야 할지 제대로 알고 있었어! 나도 너처럼 될 수 있으면 좋을 텐데! 나도 과학 경진대회에 참가했는데, 선생님들은 내 테이블에 와보지도 않으셨어."
		<br><br>

		<<He>>【은는】 한숨을 쉰다. "<<nnpc_title "Leighton">> 교장 선생님조차도. 아마 내가 내세울 만한 성적이 없어서 그런가 봐, 하지만 가끔은 수업에 집중하기가 너무 힘들어! 특히 몇몇 학생들이 계속 나를 만지고 장난을 치거나, 학용품이 계속 사라질 때, 그리고 지각을 좀 많이 해서 벌을 받아야 했을 때—"
		<br><br>

		<<He>>【은는】 몸을 굳히더니, 이내 <<his>> 고개를 젓는다. "...미안, 내가 너무 떠들었네."
		<br><br>

		<<link [[계속 공부한다|Library Study Science Fair]]>><<set $phase to 0>><<stress -4>><</link>><<lstress>>
		<br>
		<<link [[도와준다 (0:10)|Library Study Science Fair]]>><<set $phase to 1>><<pass 10>><<status 6>><</link>><<gcool>>
		<br>
	<<elseif $rng gte 51>>
		<<generatey1>><<generatey2>>당신이 하던 일에 집중하고 있을 때, 한 <<fullGroup>>【이가】 당신을 괴롭히기 시작한다.
		<br><br>

		<<link [[무시한다|School Library Harass]]>><<set $phase to 0>><<trauma 2>><<stress 2>><</link>><<gtrauma>><<gstress>>
		<br>
		<<link [[사서에게 도움을 청한다|School Library Harass]]>><<set $phase to 1>><<status -10>><</link>><<llcool>>
		<br>
		<<if C.npc.Sydney.init is 1 and $sydneySeen.includes("library") and _sydney_location is "library">>
			<<link [[시드니에게 도움을 청한다|School Library Harass]]>><<set $phase to 2>><</link>>
			<br>
		<</if>>
	<<elseif _wraithEvent>>
		얼마 후, 당신은 불안감을 느끼기 시작한다. 당신은 교과서를 책장에 다시 꽂으려고 움직인다.
		<br><br>
		반대편 틈새로 창백한 얼굴이 언뜻 보인다. <<stress 12>><<ggstress>><<trauma 4>><<gtrauma>>
		<br><br>
		<<link [[다음|School Library]]>><<endevent>><</link>>
		<br>
	<<else>>
		<<outfitChecks>>
		<<set _bottom.integrity -= 10>>
		<<if _bottom.integrity lte 0>>
			의자에서 일어나는 순간, 찢어지는 소리가 들린다. 당신의 <<bottoms>>【이가】 <<is _bottom>>책상에 걸렸다. <<= _bottom.plural ? "그것들" : "그것">>【을를】 빼내 보려 하지만, <<= _bottom.plural ? "그것들이" : "그것이">> 몸에서 통째로 뜯겨 나가며 당신의 <<= _bottomUnder?.name || "<<undies>>">>【을를】 드러낸다.
			<<integritycheck no_text>>
			<br><br>
		<<else>>
			의자에서 일어나는 순간, 찢어지는 소리가 들린다. 당신의 <<bottoms>>【이가】 <<is _bottom>>책상에 걸렸다.
			<br><br>
		<</if>>
		<<link [[다음|School Library]]>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>
