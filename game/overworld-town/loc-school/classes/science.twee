<<elseif $headnoinspections isnot 1 and $schoolevent is 2 and $schooleventtimer lte 0 and Time.weekDay isnot 6 and Time.minute lte 30>>
	<<set _xchangedEver to ($xchange isnot undefined && $xchange.everConsumed && !xchangePillPurityActive())>>
	<<set _xchangedNow to (typeof playerIsXChanged === "function" && playerIsXChanged())>>

