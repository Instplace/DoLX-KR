<<elseif $headnoinspections isnot 1 and $schoolevent is 1 and $schooleventtimer lte 0 and Time.weekDay isnot 6 and Time.minute lte 30>>
	<<set _xchangedEver to ($xchange isnot undefined && $xchange.everConsumed && !xchangePillPurityActive())>>
