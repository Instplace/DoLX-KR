:: Widgets MMA Gym Avery Whitney Split Events [widget]
<<widget "mmaGymAveryWhitneyInit">>
	<<if $mmaGymAveryGymStage is undefined>><<set $mmaGymAveryGymStage to 0>><</if>>
	<<if $mmaGymAveryGymPool is undefined>><<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymWhitneyGymStage is undefined>><<set $mmaGymWhitneyGymStage to 0>><</if>>
	<<if $mmaGymWhitneyGymPool is undefined>><<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymAveryWhitneyClashStage is undefined>><<set $mmaGymAveryWhitneyClashStage to 1>><</if>>
	<<if $mmaGymAveryWhitneyClashPool is undefined>><<set $mmaGymAveryWhitneyClashPool to [1, 2]>><</if>>
<</widget>>

<<widget "mmaGymAveryGymAvailable">>
	<<set _mmaAWAveryOk to false>>
	<<if C.npc.Avery isnot undefined and C.npc.Avery.init is 1 and C.npc.Avery.state is "active">>
		<<set _mmaAWAveryOk to true>>
	<</if>>
	<<if $avery_mansion and $avery_fate is undefined>>
		<<set _mmaAWAveryOk to false>>
	<</if>>
	<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
		<<set _mmaAWAveryOk to false>>
	<</if>>
<</widget>>

<<widget "mmaGymWhitneyGymAvailable">>
	<<set _mmaAWWhitneyOk to false>>
	<<if C.npc.Whitney isnot undefined and C.npc.Whitney.init is 1 and C.npc.Whitney.state isnot "dungeon" and C.npc.Whitney.state isnot "pillory" and !isInPark("whitney")>>
		<<set _mmaAWWhitneyOk to true>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryGymResetPool">>
	<<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymAveryGymStage to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymResetPool">>
	<<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymWhitneyGymStage to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashResetPool">>
	<<set $mmaGymAveryWhitneyClashPool to [1, 2]>>
	<<set $mmaGymAveryWhitneyClashStage to 1>>
<</widget>>

<<widget "mmaGymAveryGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "avery">>

	<<if $mmaGymAveryGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymAveryGymStage to 1>>
	<<else>>
		<<if $mmaGymAveryGymPool is undefined or $mmaGymAveryGymPool.length is 0>>
			<<mmaGymAveryGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymAveryGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymAveryGymPool to $mmaGymAveryGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymAveryGymPool.length is 0>>
			<<set $mmaGymAveryGymStage to 1>>
		<<else>>
			<<set $mmaGymAveryGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "whitney">>

	<<if $mmaGymWhitneyGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymWhitneyGymStage to 1>>
	<<else>>
		<<if $mmaGymWhitneyGymPool is undefined or $mmaGymWhitneyGymPool.length is 0>>
			<<mmaGymWhitneyGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymWhitneyGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymWhitneyGymPool to $mmaGymWhitneyGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymWhitneyGymPool.length is 0>>
			<<set $mmaGymWhitneyGymStage to 1>>
		<<else>>
			<<set $mmaGymWhitneyGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymWhitneySeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "clash">>

	<<if $mmaGymAveryWhitneyClashPool is undefined or $mmaGymAveryWhitneyClashPool.length is 0>>
		<<mmaGymAveryWhitneyClashResetPool>>
	<</if>>

	<<set _mmaAWPick to $mmaGymAveryWhitneyClashPool.random()>>
	<<set $mmaGymAWEventCurrent to _mmaAWPick>>
	<<set $mmaGymAveryWhitneyClashPool to $mmaGymAveryWhitneyClashPool.filter(n => n !== _mmaAWPick)>>

	<<if $mmaGymAveryWhitneyClashPool.length is 0>>
		<<set $mmaGymAveryWhitneyClashStage to 1>>
	<<else>>
		<<set $mmaGymAveryWhitneyClashStage += 1>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
	<<set $daily.mmaGymWhitneySeen to 1>>
	<<set $daily.mmaGymAveryWhitneyClashSeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyHook">>
	<<mmaGymAveryWhitneyInit>>
	<<mmaGymAveryGymAvailable>>
	<<mmaGymWhitneyGymAvailable>>
	<<set _mmaAWChoices to []>>

	<<if !$daily.mmaGymAveryWhitneyHook and Time.hour gte 8 and Time.hour lt 21 and $exposed lt 1 and $leftarm isnot "bound" and $rightarm isnot "bound">>
	<<set $daily.mmaGymAveryWhitneyHook to true>>	
		<<if _mmaAWAveryOk and $daily.mmaGymAverySeen isnot 1>>
			<<if $mmaGymAveryGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["avery"])>>
			<</if>>
		<</if>>

		<<if _mmaAWWhitneyOk and $daily.mmaGymWhitneySeen isnot 1>>
			<<if $mmaGymWhitneyGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["whitney"])>>
			<</if>>
		<</if>>

		<<if _mmaAWAveryOk and _mmaAWWhitneyOk and $daily.mmaGymAverySeen isnot 1 and $daily.mmaGymWhitneySeen isnot 1 and $daily.mmaGymAveryWhitneyClashSeen isnot 1 and $mmaGymAveryGymStage isnot 0 and $mmaGymWhitneyGymStage isnot 0>>
			<<if random(1, 100) lte 6>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["clash"])>>
			<</if>>
		<</if>>

		<<if _mmaAWChoices.length gt 0>>
			<<set _mmaAWChoice to _mmaAWChoices.random()>>
			<<if _mmaAWChoice is "avery">>
				<<distracticon "green">><<link [[체육관에서 에이버리를 발견한다 (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "whitney">>
				<<distracticon "green">><<link [[체육관에서 휘트니를 발견한다 (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymWhitneyGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "clash">>
				<<distracticon>><<link [[거울 근처에서 벌어지는 말다툼을 듣는다 (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryWhitneyClashPick>><<pass 5>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryWhitneyClear">>
	<<unset $mmaGymAWEventType>><<unset $mmaGymAWEventCurrent>><<unset $mmaGymAWChoice>><<unset $mmaGymAWChoice2>>
<</widget>>

:: MMA Gym Avery Whitney Event
<<endevent>>
<<set $outside to 0>><<set $location to "mma_gym">><<effects>>
<<speechresolve>>
<<set _mmaAWCustomExit to false>>

<<if $mmaGymAWEventType is "avery">>
	<<npc Avery>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		앞줄에는 새 러닝머신이 밝은 천장 조명 아래 늘어서 있다. 에이버리는 에어컨 송풍구 바로 아래, 가운데 기계를 쓰고 있다.
		경사는 가파르고 벨트는 빠르게 돌아가는데도 <<he>>【은는】 일정한 속도를 유지한다. 흰 수건이 계기판 일부를 덮고 있고, <<his>> 이니셜이 바깥을 향해 있다.
		<br><br>
		당신은 조금 너무 오래 쳐다본다. 에이버리는 벽 거울로 당신을 알아채고는 화면을 두드려 러닝머신 속도를 늦춘 뒤 내려선다. <<He>>【은는】 <<his>> 이마를 닦은 다음, 당신의 얼굴에서 옷과 신발로 시선을 옮긴다.
		<br><br>
		"글쎄요." <<he>>【이가】 옅은 미소를 지으며 말한다. "여기서 당신을 볼 줄은 몰랐네요. 누가 옆문이라도 열어 뒀나요, 아니면 정말로 돈을 내고 들어왔나요?"
		<br><br>
		<<link [[에이버리가 자세를 교정해 주게 둔다 (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "form">><</link>>
		<br>
		<<link [[에이버리에게 체육관이 어떤 것 같은지 묻는다 (0:05)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "status">><</link>>
		<br>
		<<link [[운동하러 왔다고 말한다 (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "train">><</link>>
		<<if C.npc.Avery.love gte 40 or C.npc.Avery.lust gte 10 or ($allure isnot undefined and $allure gte 250)>>
			<br>
			<<link [[에이버리가 조금 더 달리는 것을 지켜본다 (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "watch">><</link>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		에이버리는 케이블 머신 근처에 서 있고, 다른 회원 한 명이 손잡이를 너무 빠르게 당긴다. 웨이트 스택이 반복할 때마다 쾅 하고 제자리로 떨어진다.
		네 번째로 쾅 소리가 난 뒤, 에이버리가 당신을 보며 미소 짓는다.
		<br><br>
		"시끄럽게 한다고 운동이 더 어려워지는 건 아니에요. 보통은 뭘 하는지 모른다는 뜻이죠."
		<<He>>【은는】 다른 회원에게서 고개를 돌려 당신이 기구를 잡은 모습을 살핀다. "좋아요. 뭘 잘못하고 있는지 볼까요."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			"제대로 해 볼게요." 당신이 손잡이를 고쳐 잡으며 말한다.
		<<elseif _speechAttitudeResolved is "docile">>
			"제가 뭘 잘못하고 있는지 알려 주세요." 당신이 기구 쪽으로 더 다가서며 말한다.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"좋아요. 제 자세를 봐도 돼요." 당신이 말한다.
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"아무 문제도 못 찾았다고 실망한 티는 내지 마." 당신이 말한다.
		<<else>>
			"어디 해 봐요." 당신이 손잡이를 더 꽉 쥐며 말한다.
		<</if>>
		<br><br>
		<<link [[에이버리의 지시를 따른다 (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "obey">><</link>>
		<br>
		<<link [[에이버리가 몸에 손대지 못하게 하고 스스로 자세를 고친다 (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "independent">><</link>>
		<br>
		<<link [[에이버리에게 <<himself>>【이나나】 신경 쓰라고 말한다 (0:05)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "snap">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		에이버리는 운동 매트 옆에서 한 손을 벽에 짚고 한쪽 다리를 늘이고 있다. <<He>>【은는】 같은 자세를 유지하고, <<his>> 호흡은 여전히 느리다.
		<br><br>
		거울로 당신을 알아챈 뒤에도 <<he>>【은는】 스트레칭을 계속한다.
		"대부분의 사람은 불쾌한 일을 십 초쯤은 억지로 버틸 수 있어요. 지루한 부분을 십 분 동안 제대로 하는 게 어려운 거죠."
		<br><br>
		<<if C.npc.Avery.dom gte 50>>
			<<He>>【은는】 <<his>> 옆의 빈 매트를 가리킨다. "앉아요. 구경할 거면 스트레칭하는 법쯤은 제대로 배워 두는 게 좋을 테니까요."<<npcincr Avery dom 1>><<gdom>>
		<<else>>
			<<He>>【은는】 다리를 바꿔 같은 스트레칭을 반복한다. <<his>> 허벅지 근육이 떨리기 시작하지만 자세는 흐트러지지 않는다. "사람들이 건너뛰는 부분이 바로 이거예요."<<stress -3>><<lstress>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		에이버리는 웨이트 벤치에 소독제를 뿌리고 앉기 전에 시트를 닦는다. 벤치는 이미 깨끗해 보이지만 <<he>>【은는】 등받이까지 닦는다.
		<br><br>
		근처에서 기다리던 땀에 젖은 단골 하나가 <<him>>【을를】 짜증스럽게 노려본다. 에이버리는 서두르지 않는다.
		<<He>>【은는】 잠시 멈추고 단골의 눈을 마주 본 뒤 차가운 미소를 짓는다. 단골은 포기하고 걸어간다.
		<br><br>
		"공용 기구를 보면 사람에 대해 많은 걸 알 수 있어요." 에이버리가 쓴 종이 타월을 휴지통에 던지며 말한다. "자기 것이 아니게 되는 순간 신경을 끊어 버리거든요."
		<br><br>
		<<He>>【은는】 분무기를 선반에 올려 다른 병들과 줄을 맞춘 뒤 자리에 앉는다. "기본적인 위생이 왜 어려운지 이해가 안 돼요."

	<<elseif $mmaGymAWEventCurrent is 4>>
		<<set _mmaAWCustomExit to true>>
		에이버리는 러닝머신에서 또 한 번 인터벌을 뛰고 있다. 경사는 가파르고, 걸음마다 같은 속도로 내딛는다.
		당신이 기구들 사이를 지나가자 <<he>>【은는】 속도를 빠른 걸음으로 낮추고 <<his>> 물병으로 손을 뻗는다.
		<br><br>
		"그 눈빛 알아요." <<he>>【이가】 말한다. "나를 따라올 수 있을지 궁금한 거죠."<<npcincr Avery dom 1>><<gdom>>
		<br><br>
		<<He>>【은는】 물을 한 모금 마신 뒤 <<his>> 옆의 빈 러닝머신을 가리킨다. "직접 확인해 봐도 좋아요."
		<br><br>
		<<link [[에이버리의 속도에 맞춘다 (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "match">><</link>>
		<br>
		<<link [[에이버리가 속도를 정하게 둔다 (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "follow">><</link>>
		<br>
		<<link [[도전을 거절한다 (0:05)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 5>>
		에이버리는 한 세트를 마치고 두 손가락을 <<his>> 목 옆에 댄 채, 다른 손으로 스마트워치를 확인한다.
		당신은 화면의 숫자가 바뀌는 것을 지켜본다. 에이버리가 알아채고 <<his>> 손을 내린다.
		<br><br>
		"수치를 기록해요." <<he>>【이가】 말한다. "재 보면 발전을 판단하기 쉬워요. 피곤하다는 느낌은 알려 주는 게 거의 없죠."
		<br><br>
		<<if C.npc.Avery.love gte 50>>
			<<He>>【은는】 그래프가 보이도록 손목을 돌린다. "내 심박수는 지난주보다 십이 초 빨리 평소대로 돌아와요."
			<br><br>
			<<He>>【은는】 화면을 다시 보더니 당신에게 옅은 미소를 짓는다.
		<<else>>
			<<He>>【은는】 화면을 당신에게서 돌려 버린다. "대부분의 사람은 운동이 불편해지기 시작하면 그만둬요. 보통 그때부터가 진짜로 쓸모 있는 운동이 시작되는 건데."
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 6>>
		에이버리가 당신 옆 기구로 걸어와 당신의 신발을 내려다본다.
		<<He>>【은는】 몇 초 동안 신발을 살피다가 당신을 돌아본다. "그건 운동화가 아니에요."
		<br><br>
		<<He>>【은는】 <<his>> 신발 앞코로 당신 신발 옆면을 톡 친다. "받쳐 주는 게 거의 없어요. 그걸 신고 계속 운동하면 발목이 아플 거예요. 제대로 된 걸 사요."<<stress 4>><<gstress>>

	<<elseif $mmaGymAWEventCurrent is 7>>
		<<set _mmaAWCustomExit to true>>
		에이버리가 VIP 라운지에서 걸쭉한 녹색 스무디가 담긴 키 큰 컵 두 개를 들고 나온다. <<He>>【은는】 걸어와 하나를 당신에게 내민다.
		<br><br>
		당신이 바로 받지 않자, <<he>>【은는】 당신이 잡을 때까지 차가운 컵을 당신의 손에 눌러 댄다.
		<br><br>
		"단백질, 전해질, 그리고 진짜 음식이에요." <<he>>【이가】 <<his>> 컵에서 한 모금 마시기 전에 말한다. "값싼 시럽은 안 들었으니까, 역겨운 표정은 짓지 말아요."
		<br><br>
		<<link [[음료를 받는다 (0:10)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "accept">><</link>>
		<br>
		<<link [[얼마였는지 묻는다 (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "cost">><</link>>
		<br>
		<<link [[음료를 거절한다 (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 8>>
		에이버리는 로잉 머신을 쓰고 있다. <<He>>【은는】 다리로 밀어내고 손잡이를 <<his>> 갈비뼈까지 당긴 뒤 앞으로 미끄러지며 동작을 반복한다.
		<br><br>
		당신은 근처에 멈춰 선다. 에이버리는 한 번 더 반복한 뒤 손잡이를 내려놓고, 느린 숨을 몇 번 내쉬는 동안 가만히 앉아 있다. 땀이 <<his>> 셔츠 깃을 적셨다.
		<br><br>
		"놀란 표정 짓지 말아요." <<he>>【이가】 <<his>> 이마를 닦으며 말한다. "어려운 일을 전부 남한테 돈 주고 시키는 건 아니니까요."
		<br><br>
		<<if C.npc.Avery.lust gte 50>>
			<<He>>【은는】 <<his>> 팔꿈치를 무릎에 얹고 당신의 몸을 훑어본 뒤, 미소를 띠고 다시 당신의 얼굴을 본다.
			"어떤 건 내가 직접 할 때가 더 즐거워요."<<npcincr Avery lust 3>><<glust>>
		<<else>>
			<<He>>【은는】 손잡이를 다시 잡고 또 한 세트를 시작하며 대화를 끝낸다.
		<</if>>
	<</if>>

<<elseif $mmaGymAWEventType is "whitney">>
	<<npc Whitney>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		프리웨이트 구역은 붐비지만, 가장 큰 거울 근처에는 아무도 서 있지 않다. 휘트니는 아령을 양손에 하나씩 들고 빈 공간 한가운데에 서 있다.
		<br><br>
		<<He>>【은는】 아령 하나를 들어 올리고 살짝 돌아서서 <<his>> 팔과 배를 거울로 살핀다. <<his>> 뒤에 비친 당신의 모습을 알아채자 <<he>>【은는】 재빨리 아령 둘을 내려 고무 매트 위에 떨어뜨린다.
		<<His>> 뺨이 붉어진다. 당신이 아무 말도 하기 전에 <<he>>【은는】 당신 쪽으로 걸어온다.
		<br><br>
		"씨발, 뭘 쳐다보는 거야, <<slut>>【아야】?" 휘트니가 말한다. "너 같은 꼬맹이 새끼들을 여기 들여보내 줄 줄은 몰랐네. 필기라도 하냐?"
		<br><br>
		<<link [[아령을 두고 휘트니를 놀린다 (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "tease">><</link>>
		<br>
		<<link [[휘트니의 몸을 칭찬한다 (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "compliment">><</link>>
		<br>
		<<link [[휘트니에게 벤치 다 썼는지 묻는다 (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "bench">><</link>>
		<br>
		<<link [[못 본 척 시선을 돌린다 (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "ignore">><</link>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		휘트니는 다시 거울 앞에서 무거운 아령 한 쌍으로 컬을 하고 있다. <<He>>【은는】 당신이 다가오는 것을 거울로 알아채고, 들어 올리는 동안에도 계속 당신을 지켜본다.
		<br><br>
		다음 반복의 정점에서 <<he>>【은는】 <<his>> 팔을 더 굽히고 거울 쪽으로 돌려 이두근이 도드라지게 한다.
		<br><br>
		"필요한 거 있어, 아니면 또 침 흘리러 온 거야, 걸레야?" <<he>>【이가】 무게를 내리며 말한다.
		<br><br>
		<<link [[거울이 거의 다 해 주고 있다고 말한다 (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "mirror">><</link>>
		<br>
		<<link [[휘트니에게 컬이 좋아 보인다고 말한다 (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "praise">><</link>>
		<br>
		<<link [[<<his>> 옆에서 직접 아령을 든다 (0:10)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "share">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		휘트니는 거울 바로 앞 매트에서 크런치를 하고 있다. 매번 올라올 때마다 <<he>>【은는】 유리 속 <<his>> 배를 본 뒤에야 다시 어깨를 내린다.
		<br><br>
		스무 번이 지나자 <<he>>【은는】 절반쯤 올라온 채로 멈추고 한 손으로 이마에 흘러내린 머리카락을 밀어 올린다.
		당신이 매트 가장자리 근처로 다가선다. 휘트니가 곧바로 당신을 쳐다본다.
		<br><br>
		"뭐?!" <<he>>【이가】 말한다. "내 횟수 세냐? 씨발 변태 새끼."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			"세, 세던 거 아니야." 당신이 시선을 피하며 말한다.
		<<elseif _speechAttitudeResolved is "docile">>
			"미안. 보고는 있었지만 방해하려던 건 아니었어." 당신이 한 걸음 물러나며 말한다.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"스무 번." 당신이 대답한다. "천만에."
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"박수도 쳐 줘야 해, 아니면 혼자 셀 줄은 알아?" 당신이 묻는다.
		<<else>>
			"스무 번째였어." 당신이 말한다.
		<</if>>
		<br><br>
		<<if C.npc.Whitney.love gte 30>>
			휘트니는 어깨를 매트에 내리고 재빨리 씩 웃는다. "어차피 까먹었어. 네 탓이야."<<npcincr Whitney love 1>><<glove>>
		<<else>>
			휘트니는 뒤로 누워 처음부터 다시 시작하고, 당신이 들을 수 있게 숫자를 하나하나 크게 외친다.
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		<<set _mmaAWCustomExit to true>>
		비어 있는 유일한 웨이트 벤치에는 휘트니의 물건이 널려 있다. <<His>> 수건이 등받이를 덮고, <<his>> 짐 가방이 시트 위에 놓여 있으며, <<his>> 물병은 그 앞 바닥에 있다.
		<br><br>
		휘트니는 벤치를 쓰고 있지 않다. <<He>>【은는】 선반 옆에 서서 물을 마시며, <<his>> 물건에 다가오는 사람을 모두 지켜본다.
		당신이 벤치를 보고 있는 것을 알아채자 <<he>>【은는】 물병을 내리고 시트 앞으로 나선다.
		<br><br>
		"뭐, 불만 있어?" <<he>>【이가】 묻는다.
		<br><br>
		<<link [[휘트니에게 <<his>> 물건을 치우라고 말한다 (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "move">><</link>>
		<br>
		<<link [[벤치를 써도 되는지 묻는다 (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "ask">><</link>>
		<br>
		<<link [[다른 곳을 찾는다 (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "leave">><</link>>

	<<elseif $mmaGymAWEventCurrent is 4>>
		휘트니는 무거운 샌드백 하나를 맨주먹으로 치고 있다.
		<br><br>
		<<He>>【은는】 기술엔 별로 신경 쓰지 않고 강한 펀치를 연달아 날린다. 샌드백은 맞을 때마다 밀려났다가, 다음 펀치가 닿기 전에 <<his>> 쪽으로 돌아온다.
		<br><br>
		휘트니가 당신을 알아채고 멈춘다. <<He>>【은는】 <<his>> 윗입술의 땀을 닦고 샌드백에서 물러난다.
		<br><br>
		"뭐 불만 있냐, 걸레야?" <<he>>【이가】 말한다. "샌드백 좀 잡아 줄래, 아니면 네 낯짝을 대신 칠까?"
		<<if C.npc.Whitney.dom gte 25>>
			<<He>>【은는】 웃으며 당신을 가리킨다. "아니. 한 방이면 넌 바닥에 뻗을 텐데."<<stress 4>><<gstress>>
		<<else>>
			당신은 계속 <<him>>【을를】 쳐다본다. 휘트니는 웃음을 거두고 돌아서서 손목의 끈을 조인다.
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 5>>
		휘트니는 수건을 어깨 위로 던지려 하지만, 젖은 끝이 대신 <<his>> 목덜미를 때린다.
		<<He>>【은는】 움찔하고 목 뒤로 손을 뻗다가 거울 속의 당신을 알아챈다. <<His>> 얼굴이 빨개진다.
		<br><br>
		"한마디라도 해 봐, 걸레야. 무슨 일이 일어나는지 씨발 똑똑히 보게 될 거야." <<he>>【이가】 당신을 가리키며 말한다.
		<br><br>
		<<set _mmaAWWhitneyThreat to false>>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			당신은 입을 가리지만 작은 웃음이 새어 나온다.
			<<set _mmaAWWhitneyThreat to true>>
		<<elseif _speechAttitudeResolved is "docile">>
			"아무 말도 안 했어." 당신이 대답하고는 시선을 돌린다.
			<br><br>
			"그럼 입 닥치고 있어, 그러면 우린 괜찮아." 휘트니가 수건을 <<his>> 짐 가방에 밀어 넣는다. "네 쪼그만 머리에도 눈치는 좀 있나 보네."
			<<npcincr Whitney dom 1>><<gdom>>
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"괜찮아?" 당신이 웃음을 참으며 묻는다.
			<<set _mmaAWWhitneyThreat to true>>
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"잘 던졌네, 멍청아." 당신이 말한다.
			<<set _mmaAWWhitneyThreat to true>>
		<<else>>
			"아파 보이던데." 당신이 미소를 지으며 말한다.
			<<set _mmaAWWhitneyThreat to true>>
		<</if>>
		<<if _mmaAWWhitneyThreat>>
			<br><br>
			"시작하지 마, 안 그러면 진짜 패 버린다." 휘트니가 당신 쪽으로 한 걸음 다가서며 말한다.
		<</if>>
		<<unset _mmaAWWhitneyThreat>>

	<<elseif $mmaGymAWEventCurrent is 6>>
		<<set _mmaAWCustomExit to true>>
		휘트니는 아령 랙 앞에 혼자 있다. <<his>> 평소 친구들은 아무도 근처에 없고, 아무도 <<his>> 운동을 지켜보지 않는다.
		<br><br>
		<<He>>【은는】 랙에서 아령을 너무 급하게 뽑다가 금속 프레임에 부딪친다. 당신이 지나가는 것을 알아채자 <<he>>【은는】 아령을 내려놓고 랙에 기댄다.
		"오늘 체육관 존나 죽었네. 건드릴 만한 놈이 하나도 없어."
		<br><br>
		<<He>>【은는】 당신을 위아래로 훑어보고, <<his>> 웃음이 더 커진다.
		"뭐. 거의 없다는 거지."
		<br><br>
		<<link [[휘트니에게 <<he>>【이가】 외로워 보인다고 말한다 (0:05)|MMA Gym Whitney Alone Finish]]>><<set $mmaGymAWChoice to "lonely">><</link>>
		<br>
		<<link [[휘트니에게 보조를 부탁한다 (0:15)|MMA Gym Whitney Alone Finish]]>><<set $mmaGymAWChoice to "spot">><</link>>
		<br>
		<<link [[계속 걷는다 (0:05)|MMA Gym Whitney Alone Finish]]>><<set $mmaGymAWChoice to "walk">><</link>>

	<<elseif $mmaGymAWEventCurrent is 7>>
		<<set _mmaAWCustomExit to true>>
		휘트니는 자판기 옆 바닥에 한쪽 무릎을 세우고 앉아 있고, <<his>> 손에는 거의 빈 병이 들려 있다.
		당신이 그냥 지나가려 한다. 당신이 비켜 가기도 전에 휘트니가 한쪽 다리를 당신 앞길에 뻗는다.
		<br><br>
		"시원한 물 한 병 가져와, 걸레야." <<he>>【이가】 자판기를 가리키며 말한다.
		<br><br>
		당신은 움직이지 않고 <<him>>【을를】 내려다본다.
		<br><br>
		"뭘 쳐다봐? 물 가져오라고 했잖아! 목말라 죽겠다고, 씨발."
		<<if C.npc.Whitney.love gte 20>>
			<<He>>【은는】 시선을 피하며 <<his>> 목덜미를 긁는다. "너도 한 병 사. 어차피 거기 갈 거잖아, 괜히 이상하게 굴지 말고."<<npcincr Whitney love 1>><<stress -3>><<glove>><<lstress>>
		<<else>>
			<<He>>【은는】 씩 웃는다. "자판기까지 걷는 게 너무 어렵다면 말이 달라지고."<<npcincr Whitney dom 1>><<stress 4>><<gdom>><<gstress>>
		<</if>>
		<br><br>
		<<link [[물을 가져다준다|MMA Gym Whitney Drink Finish]]>><<set $mmaGymAWChoice to "comply">><</link>>
		<br>
		<<link [[거절한다|MMA Gym Whitney Drink Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>
		<br>

	<<elseif $mmaGymAWEventCurrent is 8>>
		휘트니는 거울 앞에 서서 한 팔을 <<his>> 가슴 앞으로 당기고 있다. <<He>>【은는】 거울에 비친 어깨를 지켜보며 그 자세를 유지한다.
		<br><br>
		당신을 알아채자마자 <<he>>【은는】 팔을 내린다. "뭘 쳐다봐, 씨발?"
		<br><br>
		<<He>>【은는】 다른 팔을 잡아 가슴 앞으로 당기며 아무 일도 없었던 척한다.
		<br><br>
		"내가 이러고 있는 거 봤다고 아무한테도 말하지 마." <<he>>【이가】 당신을 쳐다보지 않고 말한다. "스트레칭은 씨발 재미있는 게 아니니까."
		<br><br>
		<<He>>【은는】 스트레칭이 끝날 때까지 팔을 <<his>> 가슴 앞에 둔다.
	<</if>>

<<elseif $mmaGymAWEventType is "clash">>
	<<npc Avery>><<npc Whitney 2>><<person1>>
	<<if $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		휘트니가 유일하게 빈 벤치 위에 축축한 수건을 떨어뜨릴 때 에이버리가 거울 벽에 도착한다.
		휘트니는 벤치 옆에 그대로 서 있다. 에이버리는 <<person2>><<his>><<person1>> 앞에 멈춰 서서 수건을 내려다본다.
		<br><br>
		"수건 치워요. 내가 벤치를 쓸 거니까." 에이버리가 말한다.
		<br><br>
		휘트니가 웃는다. "네가 직접 치워, 돈 많은 새끼야."
		<br><br>
		에이버리의 표정이 얇고 차갑게 굳는다. "당신이 빨래라고 부르는 그 오물에는 손대고 싶지 않군요."
		<br><br>
		<<link [[둘이 엮이기 전에 슬쩍 빠진다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "leave">><<pass 5>><</link>>
		<br>
		<<link [[휘트니에게 에이버리가 먼저였다고 말한다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "avery">><<pass 5>><</link>>
		<br>
		<<link [[에이버리에게 그냥 벤치일 뿐이라고 말한다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "whitney">><<pass 5>><</link>>
	<<else>>
		<<set _mmaAWCustomExit to true>>
		에이버리가 걸어 들어오는데 휘트니가 탈의실 문을 밀고 나온다. 휘트니의 어깨가 에이버리의 팔에 부딪치고, 에이버리가 멈춰 선다.
		<br><br>
		휘트니가 씩 웃으며 돌아선다. "왜, 돈 많은 새끼야? 그거 청구서라도 보낼 거냐?"
		<br><br>
		에이버리는 휘트니가 건드린 소매를 보고 다시 휘트니를 본다. "솔깃하군요. 당신이 감당할 수 있을지는 의문이지만요."
		<br><br>
		사물함 근처의 사람들이 대화를 멈추고 문가에서 비켜선다.
		<br><br>
		<<link [[둘 사이에 끼어든다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "between">><<pass 5>><</link>>
		<br>
		<<link [[말다툼하게 둔다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "watch">><<pass 5>><</link>>
		<br>
		<<link [[엮이기 전에 떠난다 (0:05)|MMA Gym Avery Whitney Clash Finish]]>><<set $mmaGymAWChoice to "leave">><<pass 5>><</link>>
	<</if>>
<</if>>

<<if !_mmaAWCustomExit>>
	<br><br>
	<<link [[다음|MMA Gym]]>><<mmaGymAveryWhitneyClear>><<endevent>><</link>>
<</if>>

:: MMA Gym Avery First Response
<<effects>>
<<if $mmaGymAWChoice is "form">>
	에이버리가 걸어와 당신의 어깨를 가리킨다. "어깨가 너무 올라가 있어요. 운동을 시작하기도 전에 힘을 낭비하고 있네요."
	<br><br>
	<<He>>【은는】 빈 벤치를 가리키며 발을 어디에 둘지 알려 준다. "다시 해 봐요, 이번엔 더 천천히. 속도를 걱정하기 전에 동작부터 제대로 익혀요."
	<br><br>
	당신은 자세를 따라 한다. 에이버리는 첫 번째 반복을 지켜본 뒤, 당신이 두 번째를 시작하기 전에 손을 뻗어 손잡이 위치를 바로잡아 준다.<<gtiredness>><<gstress>><<stress 4>><<tiredness 10>>
	<br><br>
	"그리고 그렇게 기분 나쁜 표정 좀 짓지 말아요." <<he>>【이가】 말한다. "자세를 고쳐 주는 거지, 당신 가족을 모욕하는 게 아니니까요."<<npcincr Avery dom 1>><<gdom>><<pass 10>>
<<elseif $mmaGymAWChoice is "status">>
	당신은 에이버리에게 체육관이 어떤 것 같은지 묻는다.
	<br><br>
	에이버리는 방을 둘러본 뒤 대답한다. "장비는 쓸 만해요. 환기도 괜찮고요. 다만 사생활이 거의 없네요."
	<br><br>
	몇 미터 떨어진 곳에서 누군가 무거운 바벨을 바닥에 떨어뜨리고 크게 끙 소리를 낸다.
	<br><br>
	에이버리는 그쪽을 보고 다시 당신을 본다. "저게 문제예요. 좋은 장비도 쓰는 법을 배우려 하지 않는 사람에겐 소용없죠."<<pass 5>>
<<elseif $mmaGymAWChoice is "watch">>
	에이버리는 당신이 거울로 <<him>>【을를】 보고 있는 걸 알아챈다. 떠나는 대신 <<he>>【은는】 다시 러닝머신에 올라 경사를 두 단계 올린다.
	"쳐다볼 거면 제대로 집중해요. 뭔가 배울지도 모르니까."
	<br><br>
	러닝머신이 빨라진다. 에이버리는 같은 달리기 자세를 유지하지만, 몇 분 뒤 <<his>> 손이 난간을 꽉 쥐고 땀이 <<his>> 셔츠 등판을 적신다.
	<br><br>
	"유산소는 단순해요." 에이버리가 계속 달리며 말한다. "어려운 건 지쳤을 때 자세를 유지하는 거죠. 그때부터 사람들은 변명을 하기 시작해요."<<pass 5>>
<<else>>
	"운동하러?" 에이버리가 되묻는다. <<He>>【은는】 당신을 보고, 방 안의 기구들을 훑어본다.
	"그럼 제대로 해요. 피곤해질 때까지 기구 사이를 돌아다니는 건 계획이 아니에요."
	<br><br>
	에이버리가 <<his>> 러닝머신 화면을 톡 친다. 화면에는 시간별 인터벌, 심박수 목표, 휴식 시간이 표시되어 있다.
	<br><br>
	"난 시작하기 전에 뭘 할지 정해 둬요." <<he>>【이가】 말한다. "그러면 일찍 포기하고 그럴 의도였던 척하기가 더 어려워지니까요."<<npcincr Avery love 1>><<stress -3>><<pass 10>><<glove>><<lstress>>
<</if>>
<br><br>
<<link [[다음|MMA Gym Avery First Offer]]>><</link>>

:: MMA Gym Avery First Offer
<<effects>>
에이버리는 수건을 접고 시계를 확인한 뒤 당신을 돌아본다. <<hes>> 벌써 지루한 듯한 표정이다.
"장비는 엉망이고. 자세는 더 엉망이에요. 탁아소에서도 이보다는 나은 훈련을 봤겠네요."
<br><br>
<<hes>> 당신을 모욕하는 건지 그냥 사실을 말하는 건지 판단하기도 전에, <<he>>【은는】 말을 잇는다.
<br><br>
"여기엔 프리미엄 등급이 있어요. 개인 사물함, 괜찮은 샤워실, 그리고 더 적은 사람... 내가 이용권을 마련해 줄 수 있어요.
한 달 더 즉흥으로 운동하는 걸 지켜보는 것보다는 훨씬 덜 고통스러울 거예요."
<br><br>
후한 제안처럼 들리지만, 에이버리는 그것을 명령처럼 말한다.
<br><br>
"하지만 지금은," <<he>>【이가】 벌써 라운지 쪽으로 걸어가며 말한다. "나랑 같이 라운지에서 스무디를 마실 거예요. 유기농이고,
터무니없이 비싸고, 제대로 된 걸 시키면 그럭저럭 참을 만하죠."
<br><br>
에이버리는 당신의 대답을 기다리지 않는다.
<br><br>
<<link [[라운지에서 에이버리와 함께한다 (0:20)|MMA Gym Avery First End]]>><<set $mmaGymAWChoice2 to "accept">><<pass 20>><</link>>
<br>
<<link [[에이버리의 돈은 필요 없다고 말한다 (0:05)|MMA Gym Avery First End]]>><<set $mmaGymAWChoice2 to "refuse">><<pass 5>><</link>>

:: MMA Gym Avery First End
<<effects>>
<<if $mmaGymAWChoice2 is "accept">>
	라운지는 메인 체육관보다 조용하다. 에이버리는 메뉴를 열어 보지도 않고 음료 두 잔을 주문하고, 음료가 나오자 걸쭉한 녹색 스무디를 당신에게 건넨다.
	<br><br>
	"천천히 마셔요." <<he>>【이가】 말한다. "목이 마르다고 반이나 셔츠에 흘리기엔 너무 비싸니까요."
	<br><br>
	당신은 한 모금 마신다. 에이버리가 당신의 얼굴을 지켜본다. "자판기 쓰레기보다는 낫죠?"
	<br><br>
	놀랍게도, 그렇다.<<ltrauma>><<lstress>><<trauma -3>><<stress -5>>
<<else>>
	<<wearProp "soft drink">>
	"싫어요?" 에이버리가 눈썹을 치켜올리며 되묻는다.
	<br><br>
	<<He>>【은는】 어쨌든 스무디를 사서 당신에게 돌아와 손에 쥐여 준다. "내게 빚진 건 없어요. 마셔요."
	<br><br>
	당신이 그래도 망설이자 <<he>>【은는】 컵을 가리킨다. "먹는 걸 잊어서 하루 종일 지쳐 있는 모습을 보고 싶지 않을 뿐이에요."
	<br><br>
	에이버리가 작고 만족스러운 미소를 짓는다. "불평은 다 마신 다음에 해도 돼요."
	<<gstress>><<stress 4>>
<</if>>
<br><br>
<<link [[다음|MMA Gym]]>><<mmaGymAveryWhitneyClear>><<endevent>><<handheldon>><</link>>

:: MMA Gym Avery Form Finish
<<effects>>
<<if $mmaGymAWChoice is "obey">>
	에이버리가 당신 옆에 서서 엉덩이를 가리킨다. "조금 더 낮춰요. 등은 곧게 펴고."
	<br><br>
	당신은 지시를 따라 다음 반복을 시작한다.
	<br><br>
	"너무 낮게 가고 있어요." <<he>>【이가】 당신이 바닥에 닿기 전에 말한다. "조금 올라와서 그 자세로 버텨요."
	<br><br>
	당신은 세트를 이어 가고, 에이버리는 무릎과 등과 손잡이 쥔 모양을 지켜본다. 마지막 몇 번을 남기고 근육이 아파 오기 시작한다.<<gphysique>><<gtiredness>><<physique 1>><<tiredness 10>>
	<br><br>
	"그게 낫네요." <<he>>【이가】 당신이 끝내자 말한다. "서두르지 않으면 이렇게 되는 거예요."
	<<He>>【은는】 <<his>> 가방에서 깨끗하게 말아 둔 수건을 꺼내 벤치 위, 당신 옆에 놓는다.<<npcincr Avery love 1>><<npcincr Avery dom 1>><<pass 15>><<glove>><<gdom>>
<<elseif $mmaGymAWChoice is "independent">>
	에이버리가 당신 쪽으로 손을 뻗으려 하지만, 당신은 <<he>>【이가】 닿기 전에 발을 옮기고 손잡이를 바로잡는다.
	<br><br>
	<<He>>【은는】 <<his>> 손을 내리고, 당신이 더 천천히 동작을 반복하는 것을 지켜본다. 당신은 세트가 끝날 때까지 동작에만 집중한다.<<athletics 1>><<tiredness 10>><<pass 15>><<gathletics>><<gtiredness>>
	<br><br>
	에이버리가 팔짱을 낀다. "그러니까 알아듣긴 했는데, 내가 몸에 손대는 건 싫었다는 거군요."
	<<He>>【은는】 미소 짓는다. "좋아요. 고집을 부려야 말을 듣는다면, 그 정도는 맞춰 줄 수 있어요."
<<else>>
	당신은 에이버리에게 <<his>> 운동이나 신경 쓰라고 말한다.
	에이버리는 <<his>> 옷을 내려다본 뒤 미소를 띠고 당신을 다시 본다.<<npcincr Avery love -1>><<llove>>
	<br><br>
	"이미 그러고 있어요." <<he>>【이가】 말한다. "그래서 내가 뭘 하는지 아는 거고요."
	<br><br>
	<<He>>【은는】 당신의 발과 어깨를 다시 본 뒤 돌아선다. "무시해도 돼요. 나중에 관절이 불평하겠지만요."
	<<stress 4>><<pass 5>><<gstress>>
<</if>>
<br><br>
<<link [[다음|MMA Gym]]>><<mmaGymAveryWhitneyClear>><<endevent>><</link>>

:: MMA Gym Avery Treadmill Finish
<<effects>>
<<if $mmaGymAWChoice is "match">>
	당신은 빈 러닝머신에 올라 경사와 속도를 에이버리의 것에 맞춘다.
	<br><br>
	첫 1분은 해 볼 만하다. 2분째에는 숨이 가빠진다. 3분째에는 땀이 눈으로 흘러들어, 벨트 앞쪽에 머물려고 보폭을 줄여야 한다.<<gathletics>><<gtiredness>><<gstress>>
	<br><br>
	에이버리가 돌아본다. "아직 따라오고 있어요?"
	<br><br>
	당신은 이마를 닦고 계속 달린다. 에이버리는 몇 초 더 지켜보다가 미소 짓는다.
	<br><br>
	"내가 이기는 게 싫어서 어디까지 밀어붙이는지 지켜보는 건 정말 즐거워요." <<he>>【이가】 말한다.<<npcincr Avery lust 3>><<athletics 1>><<tiredness 12>><<stress 2>><<pass 20>><<glust>>
<<elseif $mmaGymAWChoice is "follow">>
	당신이 에이버리 옆 러닝머신에 올라선다. 시작을 누르기 전에, <<he>>【은는】 손을 뻗어 인터벌 설정을 대신 입력해 준다.
	속도가 오르고, 잠시 느려졌다가, 다시 오른다. 당신의 보폭이 짧아질 때마다 에이버리는 당신의 발을 가리키거나 경사를 올린다.
	<br><br>
	"발뒤꿈치를 제대로 들어요." <<he>>【이가】 말한다. "지친 거지, 걷는 법을 새로 배우는 게 아니잖아요."
	<br><br>
	마지막 인터벌에는 종아리가 아프지만, 타이머가 끝날 때까지 프로그램을 따른다. 벨트가 느려지자 숨이 돌아올 때까지 난간을 붙잡는다.<<gathletics>><<gtiredness>>
	<br><br>
	"무난했어요." 에이버리가 말한다. "너무 지쳐서 따질 힘이 없을 때 지시를 더 잘 따르네요."<<npcincr Avery love 1>><<npcincr Avery dom 1>><<tiredness 15>><<pass 20>><<glove>><<gdom>>
<<else>>
	당신은 거절하고 빈 러닝머신에서 돌아선다.
	<br><br>
	에이버리는 막지 않는다. <<He>>【은는】 <<his>> 기계의 속도를 올리고 계속 달린다.
	몇 분 뒤 러닝머신이 느려진다. 에이버리는 내려와 <<his>> 얼굴을 닦은 뒤 당신 옆을 지나간다.
	<br><br>
	"아마 현명한 선택이었을 거예요." <<he>>【이가】 말한다. "지루하지만 현명하죠. 진짜로 겨루고 싶어지면 말해요."<<pass 5>>
