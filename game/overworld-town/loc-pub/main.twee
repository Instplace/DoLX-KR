				<br>
			<</if>>
			<<if $money gte (setup.inflation ? setup.inflation.price(2000) : 2000)>>
				<<foodicon "beerbottle">><<link [[Drink herbal booze (<<printprice 2000>> 0:05)|Pub]]>><<endevent>><<money -2000 "pubAlcohol">><<set $pubbooze to "herbal">><<pass 5>><<drunk 60>><<hallucinogen 20>><</link>><<gdrunk>><<ghallucinogens>>
				<br>
			<</if>>
		<</if>>
		<<if ($whitney_smoke gte 1 or $loft_whitney gte 1)>>
				<<if $money gte (setup.inflation ? setup.inflation.price(2500) : 2500)>>
					<<smokeicon>><<link [[Buy a pack of cigarettes (<<printprice 2500>> 0:02)|Pub]]>><<endevent>><<money -2500 "pub">><<set $cigarettes to (Number.isFinite($cigarettes) ? $cigarettes : 0) + 5>><<set $cigarettesBought to true>><<pass 2>><</link>>
					<br>
				<<else>>
					<span class="blue">You can't afford a pack of cigarettes (<<printprice 2500>>).</span>
					<br>
				<</if>>
			<</if>>
			<<loitericon>><<link [[Loiter|Loiter]]>><<set $loiterReturnPassage to $passage>><</link>>
		<br>
		<<if $farm>>
			<<if $farm.tower gte 1 and !$farm.tower_guard and !$farm.build_finished.includes("tower 1")>>
				<<investigateicon>><<link [[농장 경비원을 찾는다 (0:30)|Pub Guard]]>><<endevent>><<pass 30>><</link>>
				<br>
			<</if>>
		<</if>>
		<br>
		<<if !($weekly.theft.pub || $weekly.pubMusic)>>
			<<if !$per_npc.pubMusic>>
				<<generate2>><<person2>><<saveNPC 1 pubMusic>><<endevent>>
			<</if>>
			구석에서 음악을 연주하는 <<loadNPC 1 pubMusic>><<person2>><<person>>【이가】 보인다.<br>
			<<birdicon "sing">><<link [[다가간다|Pub Music]]>><<set $pubdrink to 0>><</link>>
			<br><br>
		<</if>>
		<<generate1>><<person1>>혼자 앉아 있는 <<person>>【이가】 보인다.
		<br>
		<<brothelicon>><<link [[Flirt (0:05)|Pub Flirt Intercept]]>><<handheldon>><<if !($weekly.theft.pub || $weekly.pubMusic)>><</if>><<pass 5>><<set $pubdrink to 0>><</link>><<promiscuous1>>
		<br>
		<<investigateicon>><<link [[다른 사람을 찾아본다 (0:01)|Pub]]>><<endevent>><<pass 1>><</link>>
		<br>

		<<if C.npc.Gwylan.state is "scorned">>
			<<if gwylanSchedule() is "pub">>
				<br>
				그윌란이 외진 구석에서 시무룩해 있는 것이 보인다. 아무도 <<nnpc_him "Gwylan">>에게 신경 쓰지 않는 것 같다.
				<br>
				<<socialiseicon>><<link [[다가간다|Gwylan Pub Sulking]]>><<endevent>><</link>>
				<br>
