	<br>
<<else>>
	You don't have the <<printprice 200000>> to afford the Advanced Training Set.
	<br>
<</if>>
<<if $lockpickTrainingSet lt 2 and $money gte (setup.inflation ? setup.inflation.price(100000) : 100000)>>
	<<link [[Buy the Intermediate Training Set (<<printprice 100000>>)|Pub Landry]]>><<endevent>><<set $lockpickTrainingSet to 2>><<money -100000>><</link>><span class="blue">Trains up to C+</span>
	<br>
<<elseif $lockpickTrainingSet lt 2>>
