		<br>
		<<link [[함께 간다|Pub Accost]]>><<set $phase to 1>><</link>>
		<br>
	<<elseif $pub_tf or ((ndef $xchange.pubtimer or $xchange.pubtimer lte 0) and $rng gte 50 and $attractiveness / 100 gte $rng and ($player.gender_appearance is "f" or $xchange.disregardGender))>>
		<<pubapproach>>
	<<else>>
		<<socialiseicon "ask">><<link [[랜드리를 찾는다|Pub Landry]]>><<endevent>><</link>>
		<br>
