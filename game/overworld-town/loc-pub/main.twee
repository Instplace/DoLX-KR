	<<elseif $averyReconcile and $averyReconcile.stage lte 3 and C.npc.Avery.state is "dismissed" and !$weekly.averyReconcileSeen and (Time.dayState is "day" or Time.dayState is "dusk")>>
		<<npc Avery>><<person1>>
		<<set $weekly.averyReconcileSeen to true>>
		You spot a familiar figure at a corner booth. It's Avery, holding court over a half-empty glass,
		<<if $averyReconcile.stage is 0>>
			with a well-dressed <<nnpc_gender "Avery">> hanging on <<his>> every word.
		<<elseif $averyReconcile.stage is 1>>
