:: Pub Approach Widgets [widget]

<<widget "pubapproach">>
	<<set $xchange.pubtimer to random(10,30)>><<set $pubdrink to 0>><<set $pubresist to 1>>
	<<generate1>><<person1>><<set $NPCList[0].skills.security += (1000 - $submissive) / 4>>

	<span class="purple"><<= $pub_tf? "방금 당신이 변하는 모습을 목격한 ": "">><<person>>【이가】 당신에게 다가온다.</span><br>
	<<cheesy-pickup-line>>

	<<unset $pub_tf>>
	<br><br>

	<<willpowerdifficulty 1 1000 "silent">><<set _hasPromiscuity to 0>>
	<<if hasSexStat("promiscuity", 2)>>
		<<set _hasPromiscuity to 1>>
		<<link [[미소 짓는다 (0:10)|Pub Approach Flirt]]>><<pass 10>><<handheldon>><</link>><<promiscuous2>>
	<<else>>
		<span class="blue">화답할 만큼 난잡하지는 않다.</span>
	<</if>>
	<br>
	<<if (($arousal lt $arousalmax * 3/5 or (!$statFreeze and !$hc and $arousalDesensitizedTrait is 1) or (typeof activeInsanityTrait === "function" and activeInsanityTrait())) and effectiveDrunk() lt 240) or !_hasPromiscuity>>
		<<link [[거절한다 (0:01)|Pub Approach Reject]]>><<set $phase to 1>><<pass 1>><</link>>
	<<elseif $willpowerSuccess>>
		<<link [[거절한다 (0:01)|Pub Approach Reject]]>><<set $phase to 1>><<pass 1>><<willpowersuccess>><</link>>
	<<else>>
		<<set $pubresist to 0>>
		<span class="lewd">너무 <<= (!((!$statFreeze and !$hc and $arousalDesensitizedTrait is 1)) and !(typeof activeInsanityTrait === "function" and activeInsanityTrait()) and $arousal gte $arousalmax * 3/5)? "달아올라서" : "취해서">> <<his>> 유혹을 뿌리칠 수 없다.</span>
	<</if>>
	<br>
<</widget>>

