:: Widgets Clothing caption text [widget]

<<widget "clothingCaptionText">>
    <<run window.outfitChecks()>>
    <<if _fullyNaked is false>>
        <<set _clothingCaptionItems to []>>
        <<set _finally to "【을를】 입었습니다.">>
        <<set _text_output to "">>

        <<set _wearing to (_topless ? "<span class='pink'>상의를 탈의한 </span>" : "")>>

        <<if !_overNaked>>
            <<clothingCaptionTextOver>>
        <</if>>

        <<if !_middleNaked>>
            <<clothingCaptionTextMiddle>>
        <</if>>

        <<clothingCaptionTextUnder>>

        <<set _text_output to _wearing>>
        <<if _clothingCaptionItems.length is 1>>
            <<set _text_output += "오직 ">>
            <<set _finally to _finally.replace(" 차림입니다.", "만 걸친 상태입니다.")>>
        <</if>>

		<<set _text_output += formatList(_clothingCaptionItems) + _finally>>
		<<print _text_output>>
		<<clothingCaptionTextGenitals>>
		<<if $worn.handheld.type.includes("rainproof")>>
			<br><br>
		<</if>>
		<<clothingCaptionTextHandheld>>
	<<elseif playerHasButtPlug() or playerHasVibrator() or playerHasWornVaginalDildo()>>
		<<set _insertables to []>>
		<<if playerHasButtPlug()>>
			<<set $_text_output to `${$worn.butt_plug.name}【을를】 착용하고 있습니다.`>>
			<<set _insertables.push(`${$worn.butt_plug.name}`)>>
		<</if>>
		<<if playerHasWornVaginalDildo()>>
			<<set $_a to "">>
			<<set _insertables.push(`<<pussy>> 안의 ${$_a ? "" : ""}${$worn.vaginal_dildo.name}`)>>
		<</if>>
		<<if playerHasVibrator()>>
			<<set _insertables.push($worn.vibrator.name)>>
		<</if>>
		<<print `<<possessedWord '당신'>>【은는】 ${formatList(_insertables)}【을를】 착용하고 있습니다.`>>
		<<clothingCaptionVibratorRemote>>
	<</if>>
	<<clothingCaptionTextNothing>>
	<<if $exposed is 1>>
		<br>
		<<if _exposedLower is 1>>
			<span class="red"><<possessedWord '당신의' 'red'>> 하반신이 공공장소에 나갈 만큼 제대로 가려지지 않았습니다. <<possessedWord '당신' 'red'>>【은는】 알맞은 하의를 입기 전까지 평소처럼 행동할 수 없습니다.</span>
		<<else>>
			<span class="red"><<possessedWord '당신' 'red'>>【은는】 공공장소에 나갈 만큼 제대로 가려지지 않았습니다. 몸을 가리기 전까지 <<possessedWord '당신' 'red'>>【은는】 평소처럼 행동할 수 없습니다.</span>
		<</if>>
	<</if>>
	<<clothingCaptionTextMask>>

    <<if window.checkForExposedClothing()>>
        <br>
        <<clothingCaptionTextStrip>>
    <</if>>
    <<if isHermOrCrossdresser() or ($player.gender_appearance isnot $player.gender and $player.gender isnot "n")>>
        <br>
        <<clothingCaptionTextGender>>
    <</if>>
    <<if playerIsPregnant() and playerAwareTheyArePregnant() and playerBellySize() gt 7 or $bellySizeDebug>>
        <br>
        <<clothingCaptionTextPreggy>>
    <</if>>
	<<if $follower>>
		<!-- lack of line break intentional, line break present in widget -->
		<<clothingCaptionTextFollower>>
    <</if>>
<</widget>>

<<widget "pushClothingCaption">>
    <<set $_wornItem to $worn[_args[0]]>>

	<<set $_wornIntegrity to window.integrityWord($_wornItem,_args[0])>>
	<<set $_wornColour to window.clothesColour($_wornItem)>>
	<<set $_wornItemWord to setup.clothes[_args[0]][clothesIndex(_args[0], $_wornItem)].word>>

    <<set $_output to "">>
    <<if $_wornIntegrity>><<set $_output += " " + $_wornIntegrity>><</if>>
    <<if $_wornColour>><<set $_output += " " + $_wornColour>><</if>>
    <<set $_output += " " + $_wornItem.name>>

    <<set _clothingCaptionItems.push($_output)>>
<</widget>>

<<widget "clothingCaptionTextOver">><<silently>>
	<<if $worn.over_upper.name isnot "naked">>
		<!--Upper and maybe lower-->
		<<pushClothingCaption "over_upper">>
	<</if>>
	<<if $worn.over_lower.name isnot "naked" and !_overOutfit>>
	<!-- Lower, if not outfit -->
		<<pushClothingCaption "over_lower">>
	<</if>>
<</silently>><</widget>>

<<widget "clothingCaptionTextMiddle">><<silently>>
	<<if $worn.upper.name isnot "naked">>
		<!--Upper and maybe lower-->
		<<pushClothingCaption "upper">>
	<</if>>
	<<if $worn.lower.name isnot "naked" and !_middleOutfit>>
		<!-- Lower, if not outfit -->
		<<pushClothingCaption "lower">>
	<</if>>
<</silently>><</widget>>

<<widget "clothingCaptionTextUnder">><<silently>>
	<<set $_exposed to (_overNaked and _middleNaked)>>

	<<if _underNaked>>
		<!--Not wearing-->
		<<if ($worn.over_upper.name isnot "naked" or $worn.upper.name isnot "naked") and
		($worn.over_lower.name isnot "naked" or $worn.lower.name isnot "naked")>>
                <<set _finally to " 차림입니다. <span class='purple'>속에는 아무것도 입지 않은 상태입니다.</span>">>
        <<elseif $worn.over_upper.name is "naked" or $worn.over_lower.name is "naked" or
        $worn.upper.name is "naked" or $worn.lower.name is "naked">>
                <<set _finally to " 차림입니다. <span class='purple'>속옷은 입지 않은 상태입니다.</span>">>
        <</if>>
    <<else>>
        <<if $_exposed>>
                <<set _wearing to "<span class='pink'>" + (_topless ? "상의를 탈의한 " : "")>>
                <<set _finally to " 차림입니다.</span>">>
        <</if>>
		<<if $worn.under_upper.name isnot "naked" and $worn.under_lower.name isnot "naked">>
			<!--Both-->
			<<set _nothingBut to $_exposed and _underOutfit>>

			<<pushClothingCaption "under_upper">>
			<<if !_underOutfit>>
				<<pushClothingCaption "under_lower">>
			<</if>>
		<<elseif $worn.under_upper.name isnot "naked">>
			<!--Upper only-->
			<<pushClothingCaption "under_upper">>

            <<set _nothingBut to $_exposed>>
            <<if !$_exposed and !_bottomless>>
                    <<set _finally to " 차림입니다. <span class='purple'>" + ($player.gender_appearance isnot "m" ? "팬티는" : "속옷은") + " 입지 않은 상태입니다.</span>">>
            <</if>>
		<<elseif $worn.under_lower.name isnot "naked">>
			<!--Lower only-->
			<<set $_pair to ($worn.under_lower.name.last() is "s" ? "" : "<<word under_lower>>")>>
            <<pushClothingCaption "under_lower" $_pair>>

            <<set _nothingBut to $_exposed>>
            <<if !$_exposed and !_topless and $player.breastsize gte 4 and ($player.sex isnot "m" or $backgroundTraits.includes("crossdresser"))>>
                    <<set _finally to " 차림입니다. <span class='purple'>브래지어는 입지 않은 상태입니다.</span>">>
            <</if>>
        <</if>>
    <</if>>
<</silently>><</widget>>

<<widget "clothingCaptionTextHandheld">>
	<<silently>>
	<<if $worn.handheld.name isnot "naked" and !pcAreArmsBound("right") and !_prop>>
		/* Damage word scaled to the item's own max; every damage word starts with a consonant, so it takes "a" */
		<<set _state to integrityWord($worn.handheld, "handheld")>>
		<<set _word to setup.clothes.handheld[clothesIndex("handheld", $worn.handheld)].word>>
		<<if $worn.handheld?.pattern_caption>>
			<<set _article to "">>
			<<set $_text_output to `<<possessedWord '당신'>>【은는】 ${_article ? "" : ""}${_state}${setup.getPatternName($worn.handheld.pattern)} ${$worn.handheld.name}【을를】 들고 있습니다.`>>
		<<else>>
			<<set _article to "">>
			<<set $_text_output to `<<possessedWord '당신'>>【은는】 ${_article ? "" : ""}${_state}${$worn.handheld.name}【을를】 들고 있습니다.`>>
		<</if>>
	<</if>>
	<</silently>>
	<<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "clothingCaptionTextGenitals">><<silently>>
	<<if $worn.genitals.name isnot "naked">>
		<<if _bottomless>>
			<<set $_text_output to " <span class='red'><<possessedWord '당신의' 'red'>> <<clothingCaptionChastityEffect>> <<genitalsintegrity>> $worn.genitals.name<<if playerChastity('anus')>>, 항문 보호대<</if>><<if playerHasButtPlug()>>, $worn.butt_plug.name<</if>><<if playerHasVibrator()>>, $worn.vibrator.name<</if>><<if playerHasWornVaginalDildo()>>, <<pussy>> 안의 $worn.vaginal_dildo.name<</if>>【은는】 <<possessedWord '당신' 'red'>>에게 아무런 위안도 주지 못합니다.</span>">>
		<<else>>
			<<set $_text_output to " <<possessedWord '당신'>>【은는】 <<genitalsword>> <<clothingCaptionChastityEffect>> <<genitalsintegrity>> $worn.genitals.name<<if playerChastity('anus')>>, 항문 보호대<</if>><<if playerHasButtPlug()>>, $worn.butt_plug.name<</if>><<if playerHasVibrator()>>, $worn.vibrator.name<</if>><<if playerHasWornVaginalDildo()>>, <<pussy>> 안의 $worn.vaginal_dildo.name<</if>>【을를】 착용하고 있습니다.">>
		<</if>>
	<<elseif playerHasButtPlug() || playerHasVibrator() || playerHasWornVaginalDildo()>>
		<<set _insertables to []>>
		<<if playerHasButtPlug()>>
			<<set $_text_output to ` ${$worn.butt_plug.name}【을를】 착용하고 있습니다.`>>
			<<set _insertables.push(`${$worn.butt_plug.name}`)>>
		<</if>>
		<<if playerHasVibrator()>>
			<<set _insertables.push($worn.vibrator.name)>>
		<</if>>
		<<if playerHasWornVaginalDildo()>>
			<<set $_a to "">>
			<<set _insertables.push(`<<pussy>> 안의 ${$_a ? "" : ""}${$worn.vaginal_dildo.name}`)>>
		<</if>>
		<<set $_text_output to ` <<possessedWord '당신'>>【은는】 ${formatList(_insertables)}【을를】 착용하고 있습니다.`>>
	<</if>>
	<<if playerChastity() and $worn.genitals.chastityKey and !["player", "vow"].includes($worn.genitals.chastityKey)>>
		<<if $worn.genitals.chastityKeyholder>>
			<<set $_text_output += ` <span class="red">${$worn.genitals.chastityKeyholder is "attacker" ? "가해자" : window.KR.gatPersonNameDictKR($worn.genitals.chastityKeyholder.toUpperFirst())}【이가】 열쇠를 가지고 있습니다.</span>`>>
		<<else>>
			<<set $_text_output += ` <span class="red"><<possessedWord '당신' 'red'>>【은는】 열쇠를 가지고 있지 않습니다.</span>`>>
		<</if>>
	<</if>>
	<<if playerHasVibrator() and !playerHasVibratorRemote()>>
		<<set $_text_output += ` <<clothingCaptionVibratorRemote>>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "clothingCaptionVibratorRemote">>
	<<if playerHasVibrator() and !playerHasVibratorRemote()>>
		<<if ["broken", "lost", "stolen"].includes($worn.vibrator.remote)>>
			<span class="pink"> <<possessedWord '당신' 'pink'>>【은는】 <<possessedWord '당신의' 'pink'>> $worn.vibrator.name 리모컨이 없어서 진동을 조절할 수 없습니다.</span>
		<<else>>
			<span class="pink"> <<print window.KR.gatPersonNameDictKR($worn.vibrator.remote.toUpperFirst())>>【이가】 <<possessedWord '당신의' 'pink'>> $worn.vibrator.name 리모컨을 가지고 있습니다.</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "clothingCaptionTextMask">>
    <<if $worn.face.type.includes("mask")>>
        <br>
        <<faceintegrity>> $worn.face.name【으로로】 정체를 가린 상태입니다.
    <</if>>
<</widget>>

<<widget "clothingCaptionTextNothing">><<silently>>
	<<set $_text_output to "">>
	<<if _fullyNaked>>
		<<if $worn.genitals.name isnot "naked">>
			<<set $_text_output to "<<clothingCaptionChastityEffect>> <<genitalsintegrity>> $worn.genitals.name<<if playerChastity('anus')>>【와과】 애널 정조대<</if>> 때문에 불편한 상태입니다.">>
		<<elseif !playerHasButtPlug() and !playerHasVibrator() and !playerHasWornVaginalDildo()>>
			<<set $_text_output to "완전히 벌거벗은 상태입니다.">>
		<</if>>
	<<elseif _bottomless>>
		<<set $_text_output to "하반신이 완전히 드러나 있습니다.">>
	<</if>>
<</silently>><<if $_text_output>><span class="red"><<print $_text_output>></span><</if>><</widget>>

<<widget "clothingstatecompare">>
    /* One argument, a clothing article whose state you want to compare against its original state. Must be the ENTIRE variable, not .name! */
    /* Returns the difference between the current and base states. Negative means it's pulled down, positive means it's pulled up. */
    /* If the clothing was pulled to the side, this returns 0. It would also return 0 if the current state is the base state. */
    <<set _compare_result to _clothing_levels.indexOf($worn[_args[0]].state) - _clothing_levels.indexOf(setup.clothes[_args[0]][clothesIndex(_args[0],$worn[_args[0]])].state_base)>>
    <<if $worn[_args[0]].state is "totheside">><<set _compare_result to 0>><</if>>
<</widget>>

<<widget "clothingCaptionTextStrip">>
    <<set _captionCount to 0>>
    <<set _clothing_levels to [0,"ankles","knees","thighs","waist","midriff","chest"]>>
    <<clothingCaptionExposed "upper">>
    <<clothingCaptionExposed "lower">>

    /* insert extra newlines after the caption, if there is one, for better style (disabled as adds too many)
	<<if _captionCount gte 1>>
		<br><br>
	<</if>>
	*/
    <<unset _captionCount>>
<</widget>>

<<widget "clothingCaptionExposed">>
    <<set $_clothes to {"naked": [], "wet": [], "up": [], "down": [], "totheside": [], "exposed": []}>>
    <<set $_plural to {"naked": false, "wet": false, "up": false, "down": false, "totheside": false, "exposed": false}>>
    <<set $_isExposed to false>>
    <<set $_revealColour to "purple">>
    <<set $_highestLevelCovered to "">>
    <<set $_clothingRevealType to {}>>
    <<set $_outfitType to _args[0]>>

    /* Find which clothes are failing to cover the player */
    <<for $_i, $_outfitLayer range ["over", "", "under"]>>
        <<set $_clothing to [$_outfitLayer, $_outfitType].filter(Boolean).join("_")>>
        <<set _wetstage to $_outfitLayer + $_outfitType + "wetstage">>
        <<set $_wornClothing to $worn[$_clothing]>>

        <<if $_wornClothing.type.includes("naked")>>
            <<set $_clothingRevealType[$_clothing] to "naked">>
            <<continue>>
        <<elseif $_wornClothing.state isnot setup.clothes[$_clothing][clothesIndex($_clothing,$_wornClothing)].state_base>>
            <<clothingstatecompare $_clothing>>
            <<if _compare_result gte 1>>
                <<set $_clothingRevealType[$_clothing] to "up">>
            <<elseif _compare_result lte -1>>
                <<set $_clothingRevealType[$_clothing] to "down">>
            <<else>>
                <<set $_clothingRevealType[$_clothing] to "totheside">>
            <</if>>
        <<elseif $_wornClothing.exposed is 2>>
            <<set $_clothingRevealType[$_clothing] to "exposed">>
        <<elseif V[_wetstage] gte 3>>
            <<set $_clothingRevealType[$_clothing] to "wet">>
        <<else>>
            <<set $_clothingRevealType[$_clothing] to false>>
            <<set $_highestLevelCovered to $_wornClothing.name>>
            <<break>> /* don't check clothing below the current layer if this layer is blocking visibility */
        <</if>>

        <<set $_revealType to $_clothingRevealType[$_clothing]>>

        <<set $_clothes[$_revealType].pushUnique($_wornClothing.name)>>
        <<set $_plural[$_revealType] to ($_plural[$_revealType] or ($_wornClothing.plural is 1))>>
        <<set $_isExposed to true>>
    <</for>>

    <<if $_isExposed>>
        /* Find which areas are exposed */
        <<if $_highestLevelCovered is "">>
            <<silently>>
            <<if $_outfitType is "upper">>
                <<breasts>><<set $_undertext to _text_output>>
            <<else>>
                <<set $_revealColour to "pink">>
                <<genitals>><<set $_undertext to _text_output>>
            <</if>>
            <</silently>>
        <<else>>
            <<set $_undertext to $_highestLevelCovered>>
        <</if>>

        /* Piece together the caption */
        <<set _output to "">>
        <<for $_type range ["wet", "up", "down", "totheside", "exposed"]>>
            <<if $_clothes[$_type].length lte 0>>
                <<continue>>
            <</if>>
            <<switch $_type>>
                <<case "wet">>          <<set $_verb to " 흠뻑 젖어, ">>
                <<case "exposed">>      <<set $_verb to " 젖혀져, ">>
                <<case "up">>           <<set $_verb to " 걷어 올려져, ">>
                <<case "down">>         <<set $_verb to " 아래로 벗겨져, ">>
                <<case "totheside">>    <<set $_verb to " 옆으로 치워져, ">>
            <</switch>>

            <<if _output isnot "">><<set _output += "그리고 <<possessedWord '당신의'>> ">><</if>>
            <<set _output += formatList($_clothes[$_type]) + "【이가】" + $_verb>>
        <</for>>

        /* Print the caption */
        <<set _captionCount += 1>>
        <br>
        <<possessedWord '당신의'>> _output <span @class="$_revealColour"><<possessedWord '당신의' $_revealColour>> $_undertext【을를】 드러내고 있습니다.</span>
    <</if>>
<</widget>>

<<widget "clothingCaptionTextGender">><<silently>>
	<<set _perceived to perceivedGender()>>
	<<if _perceived is "f">>
		<<if $exposed gte 2 and playerFeelsManlike()>>
			<<set $_text_output to `지금 모습이라면 사람들은 당신을 <<possessedWord '여자로 여길 것입니다.' 'pink'>>`>>
		<<elseif $breastindicator is 1 and $player.perceived_breastsize gt 1 and playerFeelsManlike()>>
			<<set $_text_output to `드러난 가슴 때문에 사람들은 당신을 <<possessedWord '여자로 여길 것입니다.' 'pink'>>`>>
		<<elseif $settings.nudeGenderPerception gte 1 and nudeGenderAppearance() is "m" and playerFeelsGirllike()>>
			<<set $_text_output to `성기를 본 사람들은 당신을 <<possessedWord '남자로 여길 것입니다.' 'pink'>>`>>
		<<elseif playerFeelsManlike()>>
			<<set $_text_output to `지금의 옷차림이라면 사람들은 당신을 <<possessedWord '여자로 여길 것입니다.' 'pink'>>`>>
		<</if>>
	<<elseif _perceived is "m">>
		<<if $exposed gte 2 and playerFeelsGirllike()>>
			<<set $_text_output to `지금 모습이라면 사람들은 당신을 <<possessedWord '남자로 여길 것입니다.' 'pink'>>`>>
		<<elseif $breastindicator is 1 and $player.perceived_breastsize lte 1 and playerFeelsGirllike()>>
			<<set $_text_output to `드러난 납작한 가슴 때문에 사람들은 당신을 <<possessedWord '남자로 여길 것입니다.' 'pink'>>`>>
		<<elseif $settings.nudeGenderPerception gte 1 and nudeGenderAppearance() is "f" and playerFeelsManlike()>>
			<<set $_text_output to `성기를 본 사람들은 당신을 <<possessedWord '여자로 여길 것입니다.' 'pink'>>`>>
		<<elseif playerFeelsGirllike()>>
			<<set $_text_output to `지금의 옷차림이라면 사람들은 당신을 <<possessedWord '남자로 여길 것입니다.' 'pink'>>`>>
		<</if>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

<<widget "clothingCaptionTextPreggy">><<silently>>
    <<if playerBellyVisible()>>
        <<set $_textCol to "pink">>
        <<if _fullyNaked>>
            <<set $_text_output to `아무것도 걸치지 않아 <<bellyDescription "pc">>【이가】 더욱 도드라져 보입니다.`>>
        <<elseif $worn.upper.type.includes("naked") and $worn.over_upper.type.includes("naked")>>
            <<if $worn.under_upper.type.includes("naked")>>
                <<set $_text_output to `상반신이 노출되어 <<bellyDescription "pc">>【이가】 더욱 도드라져 보입니다.`>>
            <<else>>
                <<set $_text_output to `$worn.under_upper.name【은는】 <<bellyDescription "pc">>【을를】 전혀 가리지 못하고 있습니다.`>>
            <</if>>
        <<elseif $worn.upper.type.includes("bellyShow") and $worn.over_upper.type.includes("naked")>>
            <<set $_text_output to `$worn.upper.name【은는】 <<bellyDescription "pc">>【을를】 드러내고 있습니다.`>>
        <<elseif $worn.upper.type.includes("bellyHide") and $worn.over_upper.type.includes("naked")>>
            <<set $_text_output to `<<bellyDescription "pc">>【은는】 너무 커서 $worn.upper.name【으로로】 가려지지 않습니다.`>>
        <<elseif $worn.lower.type.includes("bellyHide") and $worn.over_upper.type.includes("naked")>>
            <<set $_text_output to `<<bellyDescription "pc">>【은는】 너무 커서 $worn.lower.name【으로로】 가려지지 않습니다.`>>
        <<else>>
            <<set $_text_output to `<<bellyDescription "pc">>【이가】 드러나 있습니다.`>>
        <</if>>
    <<else>>
        <<set $_textCol to "blue">>
        <<if $worn.upper.type.includes("bellyHide")>>
            <<set $_text_output to `$worn.upper.name【이가】 <<bellyDescription "pc">>【을를】 가리고 있습니다.`>>
        <<elseif $worn.lower.type.includes("bellyHide")>>
            <<set $_text_output to `$worn.lower.name【이가】 <<bellyDescription "pc">>【을를】 가리고 있습니다.`>>
        <<elseif !$worn.over_upper.type.includes("naked")>>
            <<set $_text_output to `$worn.over_upper.name【이가】 <<bellyDescription "pc">>【을를】 가리고 있습니다.`>>
        <<else>>
            <<set $_text_output to `<<bellyDescription "pc">>【은는】 보이지 않는 상태입니다.`>>
        <</if>>
    <</if>>
<</silently>><<if $_text_output>><span @class=$_textCol><<print $_text_output>></span><</if>><</widget>>

<<widget "clothingCaptionChastityEffect">><<silently>>
    <<if $worn.genitals.name is "chastity parasite">>
        <<if $earSlime.defyCooldown>>
            <<set $_text_output to "압박하는 ">>
        <<elseif $earSlime.vibration and $earSlime.vibration lte 20>>
            <<set $_text_output to "맥동하는 ">>
        <<elseif $earSlime.vibration>>
            <<set $_text_output to "진동하는 ">>
        <</if>>
    <</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "clothingCaptionTextFollower">>
	<<switch $follower.name>>
		<<case "witchprisoner">>
			<br>
			<<= window.KR.gatPersonNameDictKR($prisoner.name)>>【을를】 품에 안고 있습니다.
		<<case "witchstanding">>
			<br>
			<<= window.KR.gatPersonNameDictKR($prisoner.name).toUpperFirst()>>【이가】 옆에 서 있습니다.
		<<default>>
			<<if $debug is 1>><<run console.log("follower " + $follower.name + " has no clothingCaptionTextFollower text!")>><</if>>
	<</switch>>
<</widget>>
