:: Widgets Wardrobe [widget]

<<widget "wardrobewear">>
	<!-- Note: Don't use $_ in this widget, because this widget gets <<replace>>'d into the passage body -->
	<<if $wardrobes[$wardrobe_location] is undefined>>
		<span class="red">옷장 오류가 발생했습니다. 보고해 주세요. 의도한 옷장 대신 기본 옷장이 표시됩니다.</span>
		<br>
		<!--$wardrobe_location should always point to a specific wardrobe inside of $wardrobes-->
		wardrobe_location: <<print $wardrobe_location>>
		<br>
		passage: <<print $passage>>
		<br><br>
		<<wardrobeSelection true>>
	<</if>>
	<<set _selectedWardrobe to selectWardrobe()>>
	<<wardrobeSanityCheck>>
	<<if $clothingShop.stolenClothes gt 0>>
		<<set $clothingShop.stolenClothes to 0>>
		<span class="gold">당신은 상점에서 훔친 옷을 옷장에 넣는다.</span>
		<br>
	<</if>>
	<<if $adultShop isnot undefined and $adultShop.stolenClothes gt 0>>
		<<set $adultShop.stolenClothes to 0>>
		<span class="gold">당신은 성인용품점에서 훔친 옷을 옷장에 넣는다.</span>
		<br>
	<</if>>
	<<if _wearAction is "strip">>
		당신은 옷을 벗는다.
		<br><br>
		<<if $worn.under_lower.type.includes("strap-on")>>
			<<undressKeepSlot $wardrobe_location "under_lower">>
		<<else>>
			<<undress $wardrobe_location>>
		<</if>>
	<</if>>
	<<wearoutfit>>
	<<if $randomWear>>
		<<randomWear>>
	<</if>>
	<<if $repairAll isnot undefined and $repairAll is true>>
		<<unset $repairAll>>
		<<set _repairCount to 0>>
		<<for _key range Object.keys(_selectedWardrobe)>>
			<<if setup.clothes[_key] is undefined or !Array.isArray(_selectedWardrobe[_key]) or _selectedWardrobe[_key].length is 0>>
				<<continue>>
			<</if>>
			<<for _i to 0; _i lt _selectedWardrobe[_key].length; _i++>>
				<<if _selectedWardrobe[_key][_i].integrity lt clothingData(_key, _selectedWardrobe[_key][_i],'integrity_max') and clothingData(_key, _selectedWardrobe[_key][_i],'repairable') isnot false and !clothingData(_key, _selectedWardrobe[_key][_i],'altDamage')>>
					<<set _repairCount += Math.ceil((clothingData(_key, _selectedWardrobe[_key][_i],'integrity_max') - _selectedWardrobe[_key][_i].integrity) / 25)>>
					<<set _selectedWardrobe[_key][_i].integrity = clothingData(_key, _selectedWardrobe[_key][_i],'integrity_max')>>
				<</if>>
			<</for>>
		<</for>>
		<<for _key range Object.keys($worn)>>
			<<if setup.clothes[_key] is undefined or $worn[_key].integrity is undefined>>
				<<continue>>
			<</if>>
			<<if $worn[_key].integrity lt clothingData(_key, $worn[_key],'integrity_max') and clothingData(_key, $worn[_key],'repairable') isnot false and !clothingData(_key, $worn[_key],'altDamage')>>
				<<set _repairCount += Math.ceil((clothingData(_key, $worn[_key], 'integrity_max') - $worn[_key].integrity) / 25)>>
				<<set $worn[_key].integrity = clothingData(_key, $worn[_key],'integrity_max')>>
			<</if>>
		<</for>>
		<<set _timeNeeded to Math.min((10 - (1 * Math.round($housekeeping / 250))) * _repairCount, 120)>>
		<<set _gain to Math.max((6 - (2 * Math.round($housekeeping / 200))) * _repairCount, 2 * _repairCount)>>
		<<housekeeping _gain 1000>>
		<<updatesidebarimg>>
		<<set $DoLPSpools -= _repairCount>>
		<<pass _timeNeeded>>
	<</if>>
	<!-- Every slot the wardrobe can equip from, in the order it works through them. The $wear_<slot> reset at the end of this widget walks the same list, so a slot added here can't be left pending. -->
	<<set _wardrobeEquipSlots to ["over_upper", "over_lower", "upper", "lower", "under_upper", "under_lower", "over_head", "head", "face", "neck", "scarf", "hands", "handheld", "bag", "earrings", "rings", "legs", "feet", "genitals"]>>
	<<set _slimePrevent to ["upper", "lower", "under_upper", "under_lower"]>>
	<<set _towelCheck to ["upper", "lower"]>>
	<<set _equipSkip to {"over_upper":false, "over_lower":false, "upper":false, "lower":false, "under_upper":false, "under_lower":false, "over_head":false, "head":false, "face":false, "neck":false, "scarf":false, "hands":false, "handheld":false, "bag":false, "earrings":false, "rings":false, "legs":false, "feet":false, "genitals":false}>>
	<<set _eIndextemNames to []>>
	<<for _slot range _wardrobeEquipSlots>>
		<<if $equipFromInventory is _slot>>
			<<set _selectedWardrobe to selectWardrobe("inventory")>>
			<<wardrobeSanityCheck>>
			<<unset $equipFromInventory>>
		<<elseif _selectedWardrobe is $wardrobes.inventory>>
			<<set _selectedWardrobe to selectWardrobe()>>
		<</if>>
		<<unset _outfitPieceIds>>
		<<unset _item>>
		<<if _equipSkip[_slot] is true>>
			<<continue>>
		<</if>>
		<<if !Object.keys($worn).includes(_slot)>>
			<<continue>>
		<<else>>
			<<set _wearId to V["wear_"+_slot]>>
		<</if>>
		<<if _wearId is "none">>
			<<continue>>
		<</if>>
		<<if $wardrobeOption is "wear" or ["strip","towel","large_towel"].includes(_wearId)>>
			/*Checks for cursed equip*/
			<<unset _cursedPrevent>>
			<<set _wornOutfitPrimary to $worn[_slot].outfitPrimary>>
			<<if $worn[_slot].cursed is 1 and $worn[_slot].name isnot "naked">>
				당신은 <<print $worn[_slot].name>>【을를】 벗으려 했지만 실패했다. <<cursedtext $worn[_slot].name>>
				<br>
				<<set _cursedPrevent to true>>
			<<elseif $worn[_slot].cursed is 1 and $worn[_slot].name is "naked">>
				/* Self-heal: a bare slot must never stay cursed. Fixes saves where a cursed collar (e.g. Whitney's) was removed without fully resetting the slot, leaving cursed:1 behind. */
				<<set $worn[_slot].cursed to 0>>
			<</if>>
			<<if _wornOutfitPrimary isnot undefined>>
				<<for $_outfitPieceSlot, $_outfitPieceName range _wornOutfitPrimary>>
					<<if $worn[$_outfitPieceSlot].cursed is 1 and $worn[$_outfitPieceSlot].name isnot "naked" and _cursedPrevent isnot true>>
						<<capture $_outfitPieceSlot>>
							<<cursedtext $worn[$_outfitPieceSlot].name>>
						<</capture>>
						<<set _cursedPrevent to true>>
					<<elseif $worn[$_outfitPieceSlot].cursed is 1 and $worn[$_outfitPieceSlot].name is "naked">>
						<<set $worn[$_outfitPieceSlot].cursed to 0>>
					<</if>>
				<</for>>
			<</if>>
			<<if _cursedPrevent is true>>
				<<continue>>
			<</if>>
			/* Strip strap-on */
			<<if $worn[_slot].type.includes("strap-on")>>
				<<set _strap to $player.inventory.sextoys[$worn[_slot].name]?.find(toy => toy.worn)>>
				<<if _strap>>
					<<set _strap.worn to false>>
				<</if>>
				당신은 <<= $worn[_slot].name>>【을를】 벗는다.
				<<set $worn[_slot] to clone(setup.clothes[_slot][0])>>
			<</if>>
			/*Strips equip and puts it in the wardrobe*/
			<<if _wearId is "strip" and $worn[_slot].name isnot "naked">>
				<<if _slot is "genitals" and $worn.genitals.type.includes("chastity") and $worn.genitals.chastityKey is "player" and random(1, 100) lte 10>>
					<<loseChastityControl "broken">>
					<span class="red">열쇠가 자물쇠 안에서 부러졌다. $worn.genitals.name【은는】 꿈쩍도 하지 않는다.</span>
					<br>
					<<continue>>
				<</if>>
				당신은 <<print $worn[_slot].name>>【을를】 벗는다.
				<<generalUndress $wardrobe_location _slot>>
				<br>
				<<if _wornOutfitPrimary isnot undefined>>
					<<for $_outfitPieceSlot, $_outfitPieceName range _wornOutfitPrimary>>
						<<if $_outfitPieceName isnot "broken" and $_outfitPieceName isnot "split" and $worn[$_outfitPieceSlot].name isnot "naked">>
							당신은 <<print $worn[$_outfitPieceSlot].name>>【을를】 벗는다.
							<<generalUndress $wardrobe_location $_outfitPieceSlot>>
						<</if>>
					<</for>>
				<</if>>
				<<continue>>
			<</if>>
			<<unset _wornOutfitPrimary>>
			/*Strips equip, puts it in the wardrobe and equips a towl*/
			<<if _wearId is "towel" and _towelCheck.includes(_slot)>>
				<<generalUndress $wardrobe_location _slot>>
				<<set $worn[_slot] to clone(setup.clothes[_slot].find(c => c.name === (_slot is "upper" ? "towel top" : "towel skirt")))>><<set $worn[_slot].colour to "white">>
				<<if _slot is "upper">>
					당신은 가슴에 수건을 두른다.
				<<else>>
					당신은 허리에 수건을 두른다.
				<</if>>
				<br><br>
				<<continue>>
			<</if>>
			<<if _wearId is "large_towel" and _slot is "upper">>
				<<generalUndress $wardrobe_location "upper">><<generalUndress $wardrobe_location "lower">>
				<<set $worn.upper to clone(setup.clothes.upper.find(item => item.name === "large towel"))>><<set $worn.upper.colour to "white">>
				<<set $worn.lower to clone(setup.clothes.lower.find(item => item.name === "large towel bottom"))>><<set $worn.lower.colour to clone($worn.upper.colour)>>
				당신은 가슴에 큰 수건을 두른다.
				<br><br>
				<<continue>>
			<</if>>
		<</if>>
		/*Find the item to equip*/
		<<if _wearId gte 0>>
			<<set _item to _selectedWardrobe[_slot][_wearId]>>
		<<else>>
			<<continue>>
		<</if>>
		/* $wear_* can point at an index that no longer exists (wardrobe contents changed between the link being drawn and clicked, or a stale index carried over from another wardrobe). Equipping undefined would clone it into $worn[_slot], leaving that slot permanently undefined and breaking every clothing read for the rest of the session. */
		<<if _item is undefined>>
			<<continue>>
		<</if>>
		<<if $wardrobeOption is "wear" and _slot is "earrings" and !$ears_pierced>>
			<span class="red">귀걸이를 하려면 귀를 뚫어야 한다.</span>
			<br>
			<<continue>>
		<</if>>
		/*Prevent equip when preggy*/
		<<if playerBellySize() gte 12 and _item.type.includes("constricting") and $wardrobeOption is "wear">>
			<<if _item.type.includes("chest_bind")>>
				<span class="red">임신한 몸이 너무 예민해서 <<print _item.name>>【을를】 입을 수 없다.</span>
			<<else>>
				<span class="red">당신의 <<bellyDescription "pc">>【이가】 너무 커서 <<print _item.name>>【을를】 입을 수 없다.</span>
			<</if>>
			<br>
			<<continue>>
		<</if>>
		/*Prevent equip when the ear slime doesn't allow it*/
		<<if _slimePrevent.includes(_slot) and $wardrobeOption is "wear" and $earSlime.corruption gte 10 and $hypnosis_traits?.silence isnot 1>>
			<<if $earSlime.forcedCommando isnot undefined and (_slot is "under_lower" or (_item.outfitPrimary and _item.outfitPrimary.under_lower and !["broken","split"].includes(_item.outfitPrimary.under_lower)))>>
				<<if _item.type.includes("naked") or (_earSlimeEnableSwimwear and _item.type.includes("swim")) or (_earSlimeEnableDancewear and _item.type.includes("dance"))>>
				<<elseif $earSlime.forcedCommando gte 0>>
					<span class="red">귓속의 <<slimeWord>>【이가】 노팬티로 다니도록 강요하고 있어 _item.name【을를】 입을 수 없다.</span>
					<br>
					<<continue>>
				<<else>>
					<<run delete $earSlime.forcedCommando>>
				<</if>>
			<<elseif _item.reveal lt earSlimeCorruptionClothes() and (["prison", "asylum"].includes($location) or !_allowSchoolClothes) and !_item.type.includesAny("event")>>
				<span class="red">귓속의 <<slimeWord>>【이가】 허락하지 않아 _item.name【을를】 입을 수 없었다.</span>
				<br>
				<<continue>>
			<<elseif $earSlime.forcedDressing and _item.gender isnot $earSlime.forcedDressing.type and _item.gender isnot "n" and !_item.type.includesAny("event")>>
				<<if $earSlime.forcedDressing.days gt 0>>
					<span class="red">귓속의 <<slimeWord>>【이가】 더 <<print $earSlime.forcedDressing.type is "f" ? "여성스러운" : "남성스러운">> 옷만 허락하고 있어 _item.name【을를】 입을 수 없다.</span>
					<br>
					<<continue>>
				<<else>>
					<<run delete $earSlime.forcedDressing>>
				<</if>>
			<</if>>
		<</if>>
		/*Prevent equip when Hypnosis doesn't allow it*/
		<<if $wardrobeOption is "wear" and hypnosisTrait("crossdressing") gte 2>>
			<<if hypnosisTrait("crossdressing") gte 2 and ((_slot is "under_lower" or (_item.outfitPrimary and _item.outfitPrimary.under_lower and !["broken","split"].includes(_item.outfitPrimary.under_lower))) or (_slot is "under_upper" or (_item.outfitPrimary and _item.outfitPrimary.under_upper and !["broken","split"].includes(_item.outfitPrimary.under_upper)))) and _item.gender is $player.gender and !_item.type.includesAny("event")>>
				<<if _item.type.includes("naked") or (_earSlimeEnableSwimwear and _item.type.includes("swim")) or (_earSlimeEnableDancewear and _item.type.includes("dance"))>>
				<<else>>
					<span class="red">강박 때문에 더 <<print $player.gender is "m" ? "여성스러운" : "남성스러운">> 옷만 입을 수 있어 _item.name【을를】 입을 수 없다.</span>
					<br>
					<<continue>>
				<</if>>
			<<elseif hypnosisTrait("crossdressing") gte 4 and (_item.gender is $player.gender or _item.type.includesAny("chest_bind")) and !_item.type.includesAny("event")>>
				<span class="red">강박 때문에 더 <<print $player.gender is "m" ? "여성스러운" : "남성스러운">> 옷만 입을 수 있어 _item.name【을를】 입을 수 없다.</span>
				<br>
				<<continue>>
			<</if>>
		<</if>>
		/*A penis cage needs a penis to cage*/
		<<if $wardrobeOption is "wear" and _slot is "genitals" and _item.type.includes("cage") and _item.gender is "m" and !$player.penisExist>>
			<span class="red">_item.name에 가둘 자지가 없다.</span>
			<br>
			<<continue>>
		<</if>>
		/*Finds any outfit pieces and records the Ids*/
		<<set _outfitPieceIds to {}>>
		<<if _item.outfitPrimary isnot undefined>>
			<<for $_outfitPieceSlot, $_outfitPieceName range _item.outfitPrimary>>
				<<if $_outfitPieceName is "broken" or $_outfitPieceName is "split">>
					<<continue>>
				<</if>>
				<<for $_outfitPieceId, $_wardrobeItem range _selectedWardrobe[$_outfitPieceSlot]>>
					<<if $_wardrobeItem.name isnot $_outfitPieceName>>
						<<continue>>
					<</if>>
					<<if _item.colour isnot $_wardrobeItem.colour or ($_wardrobeItem.accessory isnot 0 and _item.accessory_colour isnot $_wardrobeItem.accessory_colour) or ($_wardrobeItem.pattern and _item.pattern and $_wardrobeItem.pattern isnot 0 and _item.pattern isnot $_wardrobeItem.pattern)>>
						<<continue>>
					<</if>>
					<<if $_wardrobeItem.outfitSecondary?.[1] isnot _item.name>>
						<<continue>>
					<</if>>
					<<set _matched to 0>>
					<<if $_wardrobeItem.colour isnot "custom" or (_item.colourCustom isnot undefined and _item.colourCustom is $_wardrobeItem.colourCustom)>>
						<<set _matched++>>
					<</if>>
					<<if $_wardrobeItem.accessory is 0 or $_wardrobeItem.accessory_colour isnot "custom" or (_item.accessory_colourCustom isnot undefined and _item.accessory_colourCustom is $_wardrobeItem.accessory_colourCustom)>>
						<<set _matched++>>
					<</if>>
					<<if _matched is 2>>
						<<set _outfitPieceIds[$_outfitPieceSlot] to $_outfitPieceId>>
						<<set _equipSkip[$_outfitPieceSlot] to true>>
						<<break>>
					<</if>>
				<</for>>
			<</for>>
		<</if>>
		<<if $wardrobeOption is "delete">>
			/*Delete the relating items*/
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<set _selectedWardrobe[$_outfitSlot].deleteAt($_outfitId)>>
			<</for>>
			당신은 <<print _item.name>>【을를】 버린다.
			<<if $DoLPSpools isnot undefined>>
				<<set _spoolsGained to 1 + Object.keys(_outfitPieceIds).length>>
				<<set $DoLPSpools += _spoolsGained>>
				그것에서 실패를 <span class="green"><<print _spoolsGained>>개</span> 건진다.
			<</if>>
			<<set _selectedWardrobe[_slot].deleteAt(_wearId)>>
			<br>
		<<elseif $wardrobeOption is "repair" and _item.repairable isnot false and !_item.altDamage>>
			/* One spool per damaged piece */
			<<set _repairSpools to (_item.integrity lt clothingData(_slot,_item,'integrity_max') ? 1 : 0) + Object.entries(_outfitPieceIds).filter(([s, i]) => _selectedWardrobe[s][i].integrity lt clothingData(s,_selectedWardrobe[s][i],'integrity_max')).length>>
			<<if _repairSpools is 0>>
				<<print _item.name>>【은는】 수선할 필요가 없다.
			<<elseif ($DoLPSpools or 0) lt _repairSpools>>
				<<print _item.name>>【을를】 수선하려면 실패가 <span class="red"><<print _repairSpools>>개</span> 필요하다.
			<<else>>
				<<set $DoLPSpools -= _repairSpools>>
				<<set _item.integrity to clothingData(_slot,_item,'integrity_max')>>
				<<set $_timeSpent to 5>>
				/*Repair the relating items*/
				<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
					<<set _selectedWardrobe[$_outfitSlot][$_outfitId].integrity to clothingData($_outfitSlot,_selectedWardrobe[$_outfitSlot][$_outfitId],'integrity_max')>>
					<<set $_timeSpent += 5>>
				<</for>>
				<<pass $_timeSpent>>
				당신은 <<print _item.name>>【을를】 수리한다.
			<</if>>
			<br>
		<<elseif $wardrobeOption is "separateOutfits" and Object.values(_outfitPieceIds).length gt 0>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<set $_secondaryItem to _selectedWardrobe[$_outfitSlot][$_outfitId]>>
				<<set $_secondaryItem.outfitSecondary[1] to "split">>
				<<set $_secondaryItem.one_piece to "split">>

				/* Inherit primary's accessory_colour/pattern for repairs (i.e. overall buttons or hanfu sash) */
				<<inheritOutfitAttributes $_secondaryItem _item>>
				<<set _item.outfitPrimary[$_outfitSlot] to "split">>
			<</for>>
			<<set _item.one_piece to "split">>
			당신은 <<print _item.name>>【을를】 잘라낸다.
			<<pass 10>>
			<br>
		<<elseif $wardrobeOption is "transfer" and _wardrobeTransfer isnot $wardrobe_location and _wardrobeTransfer isnot undefined>>
			<<unset _slotsFull>>
			/*Set the target wardrobe*/
			<<set _wardrobeTransferObject to selectWardrobe(_wardrobeTransfer, "return")>>
			/*Make sure there is enough space*/
			<<if _wardrobeTransferObject[_slot].length gte _wardrobeTransferObject.space or getWardrobeItemCount(_wardrobeTransferObject, true) + 1 + Object.keys(_outfitPieceIds).length gt 3500>>
				<<set _slotsFull to true>>
			<</if>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<if _wardrobeTransferObject[$_outfitSlot].length gte _wardrobeTransferObject.space>>
					<<set _slotsFull to true>>
				<</if>>
			<</for>>

			<<if !_slotsFull>>
				당신은 <<print _item.name>>【을를】 <<print window.KR.getWardrobeNameKr($wardrobes[_wardrobeTransfer].name)>> 보관함으로 옮겼다.
				/*Transfer everything*/
				<<run transferClothing(_slot,_wearId,$wardrobe_location,_wardrobeTransfer, { moveLinkedPieces: false })>>
				<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
					<<run transferClothing($_outfitSlot,$_outfitId,$wardrobe_location,_wardrobeTransfer, { moveLinkedPieces: false })>>
				<</for>>
			<<else>>
				공간이 부족하여 <<print _item.name>>【을를】 <<print window.KR.getWardrobeNameKr($wardrobes[_wardrobeTransfer].name)>> 옷장으로 옮길 수 없었다.
			<</if>>
		<<elseif $wardrobeOption is "wear">>
			/*Equip the relating items*/
			<<generalUndress $wardrobe_location _slot>>
			<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
				<<generalUndress $wardrobe_location $_outfitSlot>>
				<<set $worn[$_outfitSlot] to clone(_selectedWardrobe[$_outfitSlot][$_outfitId])>>
				<<set $worn[$_outfitSlot].lastTaken to $wardrobe_location>>
				<<set _selectedWardrobe[$_outfitSlot].deleteAt($_outfitId)>>
				<<run resetClothingState($_outfitSlot)>>
			<</for>>
			<<set $worn[_slot] to clone(_item)>>
			<<set $worn[_slot].lastTaken to clone($wardrobe_location)>>
			<<run resetClothingState(_slot)>>
			<<set _eIndextemNames.push(_item.name)>>
			<<set _selectedWardrobe[_slot].deleteAt(_wearId)>>
		<</if>>
	<</for>>
	<<if $worn.under_lower.type.includes("naked")>>
		<<set $worn.under_lower.exposedType to "notWorn">>
	<</if>>
	<<if $wardrobeOption is "wear" and _eIndextemNames.length gte 1>>
		당신은 <<print formatList(_eIndextemNames)>>【을를】 입는다.
	<</if>>
	<<if $wardrobeFavoriteRestoreOption isnot undefined>>
		<<set $wardrobeOption to $wardrobeFavoriteRestoreOption>>
	<</if>>
	<<unset $wardrobeFavoriteRestoreOption>>
	<<if _wearAction is "dry">>
		<<dry>>
		당신은 옷의 물기를 짜낸다.
		<<effectswater "liquid">>
		<br><br>
	<</if>>
	<<unset _wearAction>>
	/* Clear every pending request */
	<<for _clearSlot range _wardrobeEquipSlots>>
		<<set V["wear_" + _clearSlot] to "none">>
	<</for>>
	<<set $wear_outfit to "none">>
	<<exposure>>
<</widget>>

<<widget "loadWardrobeOptions">>
	<div onclick="event.stopPropagation()">
		<div class="legend-caption bold gold">설정</div>
		<div>
			<label>
				<<checkbox "$wardrobeDefaults.showTraits" false true autocheck>>
				의류 특성 아이콘 표시.
			</label>
		</div>
		<div>
			<label>
				<<checkbox "$wardrobeDefaults.extraInfo" false true autocheck>>
				'추가 정보'를 기본으로 표시.
			</label>
		</div>
		<<link [[옷장 업데이트|$passage]]>><</link>>
	</div>
<</widget>>

<<widget "wardrobeLegend">>
	<div id="wardrobe-legend" class="shop-legend hidden">
		<div class="legend-caption bold gold">범례</div>
		<br>
		각 항목에는 다음이 이 순서로 표시됩니다.
		<br>
		(색상) 또는 (무늬): 항목의 색상 또는 무늬입니다.
		<br>
		(한 벌): 짝이 되는 하의 슬롯까지 함께 차지하는 세트입니다. <span class="red">(파손)</span>과 <span class="red">(일부 파손)</span>은 세트의 한 조각이 없다는 뜻입니다. <span class="separated-indicator">(분리됨)</span>은 낱개로 잘라 놓았다는 뜻입니다.
		<br>
		(9/10): 내구도(현재/최대)입니다. 닳을수록 해지고, 찢어지고, 너덜너덜해진 것으로 표시됩니다. 내구도가 낮을수록 더 쉽게 찢어집니다.
		<br>
		노출도: 평범함, 단정함, 품위있음, 편안함, 매혹적, 아슬아슬, 음란함. 그 옷이 얼마나 매력적으로 보이게 하는지를 나타냅니다.
		<br>
		<span class="blue">&#9794;</span>와 <span class="pink">&#9792;</span>: 남자용 또는 여자용으로 만든 옷입니다. 표시가 없으면 남녀 공용입니다.
		<br>
		<span class="cold-resist-icon">20</span> 보온 수치입니다. 그 옷이 추위를 얼마나 막아 주는지를 나타냅니다.
		<br>
		특성 아이콘(설정에서 켤 수 있습니다): 마우스를 올리면 어떤 효과가 있는지 볼 수 있습니다.
		<br>
		즐겨찾기: 항목을 즐겨찾기 탭에 고정합니다.
		<br><br>

		<<if $options.images is 1>>
			<div class="legend-2em">
				<img src="img/ui/options.png">
				옷장 설정.
			</div>
			<br>
		<</if>>
		정렬: 키를 클릭하면 목록이 정렬되고, 다시 클릭하면 순서가 뒤집힙니다. 화살표는 마지막으로 쓴 순서를 보여 줍니다.
		<br>
		검색창 옆의 필터 버튼으로 성별, 노출도, 보온성, 특성에 따라 목록을 좁힐 수 있습니다. 검색창은 항목의 이름, 색상, 무늬와 일치하는 것을 찾습니다. 검색과 필터는 모든 탭에 적용되며 옷장을 나가면 초기화됩니다.
		<br><br>

		<div class="legend-warmth">
			보온 지표:
			<br>
			<div class="legend-colour-sample" style="background-color: dodgerblue"></div> - 이 온도에서는 너무 춥습니다
			<br>
			<div class="legend-colour-sample" style="background-color: lightskyblue"></div> - 이 온도에서는 약간 쌀쌀합니다
			<br>
			<div class="legend-colour-sample" style="background-color: lemonchiffon"></div> - 완벽한 온도
			<br>
			<div class="legend-colour-sample" style="background-color: orange"></div> - 이 온도에서는 약간 덥습니다
			<br>
			<div class="legend-colour-sample" style="background-color: orangered"></div> - 이 온도에서는 너무 덥습니다
			<br>
			<div class="legend-icon"><img src="img/ui/clothes/warmth-indicator.png"></div> - 현재 입고 있는 옷의 보온
		</div>
	</div>
<</widget>>

<<widget "loadWardrobeFilters">>
	<div class="filters-div" onclick="event.stopPropagation()">
		<div id="filter-buttons" class="filter-buttons-div">
			<div class="filter-button button-apply div-link">
				<<link "적용 후 닫기">>
					<<set _wardrobeFilter.active to true>>
					<<addclass '#wardrobe-filters' 'hidden'>>
					<<run wardrobeFilterRefresh()>>
				<</link>>
			</div>
			<div class="filter-button button-reset div-link">
				<<link "모두 초기화 후 닫기">>
					<<run wardrobeFilterReset()>>
					<<addclass '#wardrobe-filters' 'hidden'>>
					<<run wardrobeFilterRefresh()>>
				<</link>>
			</div>
			<div class="filter-button button-toggle-traits div-link">
				<<link "모든 특성 선택 / 선택 해제">>
					<<run toggleAllTraitsFilter()>>
				<</link>>
			</div>
		</div>
		<div class="filters">
			<div id="filter-gender" class="filter-block">
				<span class="bold gold">성별</span>
				<label><<checkbox "_wardrobeFilter.gender.female" false true autocheck>> 여성</label>
				<label><<checkbox "_wardrobeFilter.gender.neutral" false true autocheck>> 남녀 공용</label>
				<label><<checkbox "_wardrobeFilter.gender.male" false true autocheck>> 남성</label>
			</div>

			<div id="filter-reveal" class="filter-block">
				<<wardrobeFilterReveal>>
			</div>

			<div id="filter-warmth" class="filter-block">
				<span class="bold gold">보온성</span>
				<div class="filter-warmth-fromto">
					<label>최소 <<numberbox "_wardrobeFilter.warmth.from" _wardrobeFilter.warmth.from>></label>
					<label>최대 <<numberbox "_wardrobeFilter.warmth.to" _wardrobeFilter.warmth.to>></label>
				</div>
			</div>

			<div id="filter-traits" class="filter-block">
				<span class="bold gold">특성</span>
				<div class="traits-list">
					<<set _traitsHere to [...new Set(setup.clothes_all_slots.flatMap(slot => [...(_selectedWardrobe[slot] || []), ...($settings.multipleWardrobes and $worn.bag.type.includes("bookbag") ? $wardrobes.inventory[slot] || [] : []), $worn[slot]]).flatMap(item => item.type || []))].filter(trait => setup.shopDetails[trait]).sort()>>
					<<for _trait range _traitsHere>>
						<<set _traitObj to setup.shopDetails[_trait]>>
						<div class="filters-trait-row">
							<label>
								<<clothingtrait _trait 'display_normal'>>
								<<print '<input type="checkbox" value="' + _trait + '"' + (_wardrobeFilter.traits.includes(_trait) ? ' checked="checked"' : '') + ' onclick="wardrobeFilterToggleTrait(this.value)">'>>
								<<if !_traitObj.desc>>
									<<print _traitObj.name>>
								<<else>>
									<<set _traitDesc to `<span class="black">` + _traitObj.desc + `</span>`>>
									<<set _traitDetails to `<i class="green normal">` + (_traitObj.details isnot "none" ? " " + _traitObj.details : "") + `</i>`>>
									<<set $_tooltip to _traitDesc + "<br>" + _traitDetails>>
									<div class="tooltip-anchor" @tooltip="$_tooltip">
										_traitObj.name
									</div>
								<</if>>
							</label>
						</div>
					<</for>>
				</div>
			</div>
		</div>
	</div>
<</widget>>

<<widget "wardrobeFilterReveal">>
	<span class="bold gold">노출도</span>
	<div class="filter-reveal-fromto">
		<label>최소 <<listbox "_wardrobeFilter.reveal.from" autoselect>><<optionsfrom getFilterRevealOptions('from', _wardrobeFilter)>><</listbox>></label>
		<label>최대 <<listbox "_wardrobeFilter.reveal.to" autoselect>><<optionsfrom getFilterRevealOptions('to', _wardrobeFilter)>><</listbox>></label>
	</div>

	<<run $(() => { $('#filter-reveal select').on('change', (e) => { new Wikifier(null, "<<replace '#filter-reveal'>><<wardrobeFilterReveal>><</replace>>"); }) })>>
<</widget>>


<<widget "wardrobe">>
	<<set _inWardrobe to true>>
	<div id="action-popup">표시되면 안 됩니다.</div>
	<<unset $tempDisable>><<unset $xchange.blackmail.gracePeriod>>

	<<if _wardrobeFilter is undefined>><<run wardrobeFilterReset()>><</if>>
	<<if _wardrobeSearch is undefined>><<set _wardrobeSearch to "">><</if>>

	<!-- Filters, options, legend -->
	<div id="wardrobe-options-div" class="main-shop-div">
		<div id="wardrobe-filters" class="no-click-overlay no-numberify hidden" onclick="$(this).addClass('hidden')">
		</div>
		<div class="wardrobe-legend-button no-numberify div-link">
			<<if $options.images is 1>>
				<<iconUi "help.png">>
			<<else>>
				도움말
			<</if>>
			<<link "">>
				<<toggleclass '#wardrobe-legend' 'hidden'>>
				<<toggleclass '.wardrobe-legend-button' 'active'>>
			<</link>>
		</div>
		<<wardrobeLegend>>
		<div class="wardrobe-options-button no-numberify div-link">
			<<if $options.images is 1>>
				<<iconUi "options.png">>
			<<else>>
				옵션
			<</if>>
			<<link "">>
				<<replace '#shop-options'>><<loadWardrobeOptions>><</replace>>
				<<run linkifyDivs('#shop-options')>>
				<<toggleclass '#shop-options' 'hidden'>>
			<</link>>
		</div>
		<div id="shop-options" class="wardrobe-options no-numberify hidden" onclick="$(this).addClass('hidden')">
		</div>
	</div>
	<<run linkifyDivs('#wardrobe-options-div')>>
	<<run $(document).off('keydown.wardrobeFilters').on('keydown.wardrobeFilters', (e) => { if (e.key === 'Escape') $('#wardrobe-filters').addClass('hidden'); })>>

	<hr>
	<<warmthscale>>
	<div id="warmth-description">
		<<warmth_description>>
	</div>
	<hr>
	<<silently>><<clotheson>><</silently>> /*Fixes perma pulled aside clothes introduced by 0.2.3.0 bug.*/
	<<set _repairCount to 0>>
	<<for _key range Object.keys(_selectedWardrobe)>>
		<<if setup.clothes[_key] is undefined or !Array.isArray(_selectedWardrobe[_key]) or _selectedWardrobe[_key].length is 0>>
			<<continue>>
		<</if>>
		<<for _i to 0; _i lt _selectedWardrobe[_key].length; _i++>>
			<<if _selectedWardrobe[_key][_i].integrity lt clothingData(_key, _selectedWardrobe[_key][_i],'integrity_max') and clothingData(_key, _selectedWardrobe[_key][_i],'repairable') isnot false and !clothingData(_key, _selectedWardrobe[_key][_i],'altDamage')>>
				<<set _repairCount += Math.ceil((clothingData(_key, _selectedWardrobe[_key][_i], 'integrity_max') - _selectedWardrobe[_key][_i].integrity) / 25)>>
			<</if>>
		<</for>>
	<</for>>
	<<for _key range Object.keys($worn)>>
		<<if setup.clothes[_key] is undefined or $worn[_key].integrity is undefined>>
			<<continue>>
		<</if>>
		<<if $worn[_key].integrity lt clothingData(_key, $worn[_key],'integrity_max') and clothingData(_key, $worn[_key],'repairable') isnot false and !clothingData(_key, $worn[_key],'altDamage')>>
			<<set _repairCount += Math.ceil((clothingData(_key, $worn[_key], 'integrity_max') - $worn[_key].integrity) / 25)>>
		<</if>>
	<</for>>
	<<set _timeNeeded to Math.min((10 - (1 * Math.round($housekeeping / 250))) * _repairCount, 120)>>
	<<set _timeString to getTimeString(_timeNeeded)>>
	<div class="wardrobe-quick">
		<div class="wardrobe-action">
			<<link "모두 벗는다">>
				<<set _wearAction to "strip">>
				<<updatewardrobe>>
			<</link>>
		</div>
		<div class="wardrobe-action">
			<<link "무작위로 옷을 입는다">>
				<<set $randomWear to true>>
				<<updatewardrobe>>
			<</link>>
		</div>
		<div class="wardrobe-action">
			<<link "무작위 설정">><<toggleclass "#randomClothingConfigure" "hidden">><</link>>
		</div>
		<<if $overupperwet gte 1 or $overlowerwet gte 1 or $upperwet gte 1 or $lowerwet gte 1 or $underlowerwet gte 1 or $underupperwet gte 1>>
			<div class="wardrobe-action wardrobe-dry">
				<<link "옷을 말린다">>
					<<set _wearAction to "dry">>
					<<updatewardrobe>>
					<<if $overupperwet lt 1 and $overlowerwet lt 1 and $upperwet lt 1 and $lowerwet lt 1 and $underlowerwet lt 1 and $underupperwet lt 1>>
						<<remove ".wardrobe-dry">>
					<</if>>
				<</link>>
			</div>
		<</if>>
		<<if $DoLPSpools isnot undefined and _repairCount gt 0>>
			<div class="wardrobe-action">
				<<if $DoLPSpools gte _repairCount>>
					<<link [["모두 수선한다 (_timeString)"|$passage]]>>
						<<set $repairAll to true>>
						<<updatewardrobe>>
					<</link>><<ghousekeeping 1000>>
				<<else>>
					<span class="red">실패가 모자란다. (보유 $DoLPSpools / 필요 _repairCount)</span>
				<</if>>
			</div>
		<</if>>
		<<if $options.images and ($uncomfortable.underwear or $uncomfortable.nude)>>
			<div class="wardrobe-action">
				<span id="wardrobe-cover" @class="$dontHide ? '' : 'hidden'">
					<<link "몸을 가린다">>
						<<dontHideRevert>>
						<<toggleclass "#wardrobe-cover" "hidden">>
						<<toggleclass "#wardrobe-dontCover" "hidden">>
						<<updatesidebarimg>>
					<</link>>
					</span>
				<span id="wardrobe-dontCover" @class="$dontHide ? 'hidden' : ''">
					<<link "몸을 가리지 않는다">>
						<<dontHideForNow>>
						<<toggleclass "#wardrobe-cover" "hidden">>
						<<toggleclass "#wardrobe-dontCover" "hidden">>
						<<updatesidebarimg>>
					<</link>>
				</span>
			</div>
		<</if>>
	</div>
	
	<div id="randomClothingConfigure" class="hidden">
		<<if $randomEquipConfigure is undefined>>
			<<set $randomEquipConfigure to {face: true, feet: true, head: true, hands: true, legs: true, lower: true, neck: true, under_lower: true, under_upper: true, upper: true}>>
		<</if>>
		<<for _slot range Object.keys($randomEquipConfigure)>>
			<<capture _slot>>
				<<set _slotKr to window.KR.getClothingSlotKr(_slot)>>
				<label><<checkbox "$randomEquipConfigure[_slot]" false true autocheck>> <<print _slotKr>></label><br>
			<</capture>>
		<</for>>
	</div>

	<<wardrobeStorage>>

	<<if $location is "home" or $location is "town">>
		<<if $tailorMonthlyService is "repair" or $tailorMonthlyService is "discard">><br><</if>>
		<<if $tailorMonthlyService is "repair">>
			__옷장 수선 상자__
			<br>
			옷을 수선하기 위해 보낼 수 있는 작은 상자가 있다.
			<br>
			<<link [[손상된 옷을 넣고 보낸다|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "damaged">>
			<</link>>
			<br>
			<<link [[세트를 넣고 보낸다|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "outfits">>
			<</link>>
			<br>
			<<link [[모든 옷을 넣고 보낸다|Wardrobe Repair Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "all">>
			<</link>>
			<br><br>
			<<link [[요청을 취소한다|$passage]]>><<set $tailorMonthlyService to 1>><</link>>
			<br><br>
		<<elseif $tailorMonthlyService is "discard">>
			__옷장 판매 상자__
			옷을 판매하기 위해 보낼 수 있는 작은 상자가 있다.
			<br>
			<<link [[세트를 넣고 보낸다|Wardrobe Sale Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "outfits">>
			<</link>>
			<br>
			<<link [[모든 옷을 넣고 보낸다|Wardrobe Sale Crate]]>>
				<<set $wardrobeReturnLink to $passage>>
				<<set $crateContents to "all">>
			<</link>>
			<br><br>
			<<link [[요청을 취소한다|$passage]]>><<set $tailorMonthlyService to 1>><</link>>
			<br><br>
		<</if>>
		<<if $wardrobeRepair is undefined>>
		<<elseif $wardrobeRepair.timeLeft is 0>>
			재단사에게 보냈던 옷이 수선되어 당신의 옷장에 추가되었다.
			<<wardrobeGetRepairedClothes>>
			<br><br>
		<</if>>
	<</if>>

	<div class="wardrobe-heading">의상 세트</div>
	<div id="listoutfits"><<listoutfits>></div>

	<hr>
	<div class="wardrobe-heading">옷</div>

	<<if ["over_head", "over_upper", "over_lower"].includes($lastWardrobeSlot)>>
		<<set $lastWardrobeSlot to "over">>
	<</if>>
	<<dynamic "wardrobeLinks" "wardrobeLinks">>
	<!-- The search box sits outside #wardrobeList so redrawing the list doesn't take its focus. -->
	<div class="wardrobe-search no-numberify">
		<label>검색: <<textbox "_wardrobeSearch" _wardrobeSearch>></label>
		<<button "초기화">>
			<<set _wardrobeSearch to "">>
			<<run $('#textbox--wardrobesearch').val(''); wardrobeFilterRefresh()>>
		<</button>>
		<button type="button" class="wardrobe-filters-toggle" onclick="wardrobeOpenFilters()">필터<span id="wardrobe-filter-state"><<if _wardrobeFilter.active>> (적용 중)<</if>></span></button>
	</div>
	<<run (() => {
		let timer;
		$(document).off('input.wardrobeSearch').on('input.wardrobeSearch', '#textbox--wardrobesearch', (e) => {
			T.wardrobeSearch = e.target.value;
			clearTimeout(timer);
			timer = setTimeout(wardrobeFilterRefresh, 250);
		});
		$(document).one(':passageinit.wardrobeSearch', () => {
			clearTimeout(timer);
			$(document).off('input.wardrobeSearch keydown.wardrobeFilters change.wardrobeRepeat mousedown.wardrobeActionFlash');
		});
	})()>>
	<<dynamic "wardrobeContents" "wardrobeList">>

	<br>


	<<set $upperoff to 0>>
	<<set $loweroff to 0>>
	<<set $underloweroff to 0>>
	<<set $underupperoff to 0>>
	<<exposure>>

	<!-- Turning Repeat off disarms whatever mode is active straight away, instead of on the next redraw. -->
	<<run $(document).off('change.wardrobeRepeat').on('change.wardrobeRepeat', '.wardrobe-repeat input', (e) => { if (!e.target.checked) { V.wardrobeOption = 'wear'; wardrobeRerenderList(); } })>>

	<!-- Briefly highlights wardrobe links when clicked; handler is namespaced to prevent duplicates on re-render. -->
	<<run $(document).off('mousedown.wardrobeActionFlash').on('mousedown.wardrobeActionFlash', '.wardrobe-action a', (e) => {
		let target = $(e.currentTarget).parent();
		target.addClass('notransition action-flash');
		setTimeout(() => { target.removeClass('notransition action-flash') }, 100);
	})>>
<</widget>>

<<widget "wardrobeContents">>
	<<if _wardrobeFilter.active>>
		<span class="green">현재 필터가 활성화되어 있습니다!</span>
		<<link "초기화">>
			<<run wardrobeFilterReset(); wardrobeFilterRefresh()>>
		<</link>>
		<br><br>
	<</if>>
	<<if $lastWardrobeSlot is "favorites">>
		<<wardrobeFavoritesList>>
	<<elseif $lastWardrobeSlot is "over">>
		<<wardrobeOverList>>
	<<elseif $lastWardrobeSlot is "NewOutfit">>
		<<wardrobeNewOutfit>>
	<<else>>
		<<wardrobeList $lastWardrobeSlot>>
	<</if>>
<</widget>>

<<widget "wardrobeLinks">>
	<<set _wardrobeTabGroups=[
		{ name: '', links: [
			{ id: 'favorites', label: '즐겨찾기' },
		] },
		{ name: '몸', links: [
			{ id: 'over', label: '겉옷', icon: 'over-outfit' },
			{ id: 'upper', label: '상의', icon: 'upper' },
			{ id: 'lower', label: '하의', icon: 'lower' },
			{ id: 'under_upper', label: '속옷 상의', icon: 'under-upper' },
			{ id: 'under_lower', label: '속옷 하의', icon: 'under-lower' },
			{ id: 'genitals', label: '성기', icon: 'genitals' },
		] },
		{ name: '머리와 목', links: [
			{ id: 'head', label: '머리', icon: 'head' },
			{ id: 'face', label: '얼굴', icon: 'face' },
			{ id: 'neck', label: '목', icon: 'neck' },
			{ id: 'scarf', label: '스카프', icon: 'scarf' },
			{ id: 'earrings', label: '귀걸이', icon: 'earrings' },
		] },
		{ name: '기타', links: [
			{ id: 'hands', label: '장갑', icon: 'hand' },
			{ id: 'handheld', label: '휴대품', icon: 'handheld' },
			{ id: 'bag', label: '가방', icon: 'bag' },
			{ id: 'rings', label: '반지', icon: 'rings' },
			{ id: 'legs', label: '다리', icon: 'legs' },
			{ id: 'feet', label: '신발', icon: 'feet' },
		] },
	]>>
	<div class="wardrobe-tabs no-numberify">
	<<for _wardrobeTabGroup range _wardrobeTabGroups>>
		<div class="wardrobe-tabgroup" role="group" @aria-label="_wardrobeTabGroup.name || 'Favorites'">
		<<if _wardrobeTabGroup.name>><span class="wardrobe-tabgroup-name">_wardrobeTabGroup.name</span><</if>>
		<<for _wardrobeLink range _wardrobeTabGroup.links>>
			<button
				type="button"
				@class="'wardrobe-tab' + ($options.images is 1 ? ' wardrobe-tab-icon' : '') + ($lastWardrobeSlot is _wardrobeLink.id ? ' active' : '')"
				@id="Dynamic.eventBinder(_wardrobeLink.id)"
				@title="_wardrobeLink.label"
				@aria-pressed="$lastWardrobeSlot is _wardrobeLink.id ? 'true' : 'false'"
				onclick="(id) => $lastWardrobeSlot = id"
			>
				<<if $options.images is 1>>
					<<if _wardrobeLink.id is "favorites">><<hearticon>><<else>><<clothingcategoryicon _wardrobeLink.icon>><</if>>
				<</if>>
				<span class="wardrobe-tab-label">_wardrobeLink.label</span>
			</button>
		<</for>>
		</div>
	<</for>>
	</div>
<</widget>>

<<widget "wardrobeOverList">>
	<<wardrobeClothingOptions>>
	<<set _overSlots to ["over_head", "over_upper", "over_lower"]>>
	<<set _overItemCount to 0>>
	<<for _overSlot range _overSlots>>
		<<set _overItemCount += _selectedWardrobe[_overSlot].length>>
	<</for>>

	__겉옷__ <i>_overItemCount / <<= _selectedWardrobe.space * _overSlots.length>></i>
	<br>
	현재 착용 중:
	<<set _overEquipped to 0>>
	<<for _overSlot range _overSlots>>
		<<if $worn[_overSlot].name isnot "naked">>
			<<set _overEquipped++>>
			<<capture _overSlot>>
				<<if _overEquipped gt 1>> | <</if>>
				<span class="no-numberify">
					<<clothingicon $worn[_overSlot] _overSlot>><<wearlink_norefresh `$worn[_overSlot].name.toUpperFirst()` "strip" `"wear_" + _overSlot`>>
					(<span class="wardrobe-action"><<wearlink_norefresh "Strip" "strip" `"wear_" + _overSlot`>></span>)
				</span>
			<</capture>>
		<</if>>
	<</for>>
	<<if _overEquipped is 0>>없음<</if>>
	<br>

	<<wardrobeList "over_head" true true>>
	<<wardrobeList "over_upper" true true>>
	<<wardrobeList "over_lower" true true>>
	<div style="clear:both;"></div>
<</widget>>

<<widget "wardrobeClothingOptions">>
	<<if $wardrobeOption is undefined or $wardrobeOption is 0>><<set $wardrobeOption to "wear">><</if>>
	<<if $wardrobeRepeat isnot true or ($wardrobeOption is "repair" and $location isnot "home")>><<set $wardrobeOption to "wear">><</if>>

	<div class="wardrobe-modebar" role="radiogroup" aria-label="What clicking an item does">
		<span class="wardrobe-mode-caption">항목을 클릭하면:</span>
		<label class="wardrobe-mode"><<radiobutton "$wardrobeOption" "wear" autocheck>><span class="wardrobe-mode-label">입기</span></label>
		<<if $sewingKit is 1 and $location is "home">>
			<label class="wardrobe-mode"><<radiobutton "$wardrobeOption" "repair" autocheck>><span class="wardrobe-mode-label">수선하기 (벌당 0:05, 실패 1개)</span></label>
		<</if>>
		<label class="wardrobe-mode"><<radiobutton "$wardrobeOption" "separateOutfits" autocheck>><span class="wardrobe-mode-label">세트 분리하기</span></label>
		<<if $settings.multipleWardrobes and $wardrobes[$wardrobe_location].transfer && Object.values($wardrobes).filter(w => w.unlocked && w.shopSend).length > 1>>
			<span class="wardrobe-mode-transfer">
			<label class="wardrobe-mode"><<radiobutton "$wardrobeOption" "transfer" autocheck>><span class="wardrobe-mode-label">이동할 곳:</span></label>
			<<set _options to {}>>
			<<for _label, _value range $wardrobes>>
				<<if _value.unlocked and _label isnot $wardrobe_location and $wardrobes[_label].shopSend>>
					<<if _value.name is "Mansion Wardrobe" and ["kicked", "fallen"].contains($avery_fate)>>
						<<set _value.name to "보관함">>
					<</if>>
					<<set _options[_value.name] to _label>>
				<</if>>
			<</for>>
			<<listbox "_wardrobeTransfer" autoselect>>
				<<optionsfrom _options>>
			<</listbox>>
			</span>
		<</if>>
		<label class="wardrobe-repeat"><<checkbox "$wardrobeRepeat" false true autocheck>> 동작 반복</label>
		<label class="wardrobe-mode wardrobe-mode-danger"><<radiobutton "$wardrobeOption" "delete" autocheck>><span class="wardrobe-mode-label">버리기</span><em class="wardrobe-danger-note">클릭한 항목을 파괴합니다</em></label>
	</div>

	<<if $wardrobeOption is "delete" and $wardrobeRepeat is true>>
		<h2 class="red">버리기 반복중</h2>
	<</if>>
<</widget>>

<<widget "wardrobeStorage">>
	<details id="wardrobe-storage" class="wardrobe-storage">
		<summary><span id="wardrobe-storage-summary"><<wardrobeStorageSummary>></span></summary>
		<div id="wardrobe-storage-body" class="wardrobe-storage-body"><<wardrobeStorageBody>></div>
	</details>
<</widget>>

<<widget "wardrobeStorageSummary">>
	<<print $wardrobes[$wardrobe_location] ? $wardrobes[$wardrobe_location].name : "Wardrobe">> | <<= getWardrobeItemCount(_selectedWardrobe, true)>> / 3,000
	<span class="wardrobe-storage-hint">보관 및 일괄 작업</span>
<</widget>>

<<widget "wardrobeStorageBody">>
	<<set _homeLocations to $settings.multipleWardrobes ? getAvailableWardrobeHomes().filter(location => $wardrobe_location isnot location) : []>>
	<<if _homeLocations.length gt 0>>
		<div class="wardrobe-storage-group">
			<b>전부 옮기기</b>: 다른 옷장으로 옮깁니다. 자동으로 돌아오는 옷은 3,000개 한도를 넘을 수 있습니다.
			<br>
			<<set _targetWardrobe to "wardrobe">>
			<<set _locationMap = {}>>
			<<run _homeLocations.forEach(key => _locationMap[$wardrobes[key].name] = key)>>
			목적지:
			<<listbox "_targetWardrobe" autoselect>>
				<<optionsfrom _locationMap>>
			<</listbox>>
			<div class="wardrobe-action">
				<<link "이동">>
					<<set _currentWardrobeObj to selectWardrobe($wardrobe_location)>>
					<<set _targetWardrobeObj to selectWardrobe(_targetWardrobe, "return")>>

					<<if getWardrobeItemCount(_targetWardrobeObj, true) + getWardrobeItemCount(_currentWardrobeObj, true) gt 3500>>
						<<replace "#wardrobewear">><span class="red">옷을 전부 옮길 공간이 부족합니다. 목적지는 총 3,000개로 제한됩니다.</span><</replace>>
					<<elseif !Number.isFinite(_targetWardrobeObj.space) or setup.clothes_all_slots.some(slot => (_targetWardrobeObj[slot]?.length || 0) + (_currentWardrobeObj[slot]?.length || 0) > _targetWardrobeObj.space)>>
						<<replace "#wardrobewear">><span class="red">옷을 전부 옮길 공간이 부족합니다. 목적지의 슬롯 중 적어도 하나가 가득 찼습니다. 아무것도 옮겨지지 않았습니다.</span><</replace>>
					<<else>>
						<<for _slot range setup.clothes_all_slots>>
							<<capture _currentWardrobeObj, _slot>>
								<<if !Array.isArray(_currentWardrobeObj[_slot])>><<continue>><</if>>
								<<for _i = _currentWardrobeObj[_slot].length; _i gt 0; _i-->>
									<<if getWardrobeItemCount(_targetWardrobeObj, true) lt 3500 and Number.isFinite(_targetWardrobeObj.space) and (!Array.isArray(_targetWardrobeObj[_slot]) or _targetWardrobeObj[_slot].length lt _targetWardrobeObj.space)>>
										<<run transferClothing(_slot, 0, $wardrobe_location, _targetWardrobe, { moveLinkedPieces: false })>>
									<<else>>
										<<break>>
									<</if>>
								<</for>>
							<</capture>>
						<</for>>
						<<updatewardrobe>>
					<</if>>
				<</link>>
			</div>
		</div>
	<<else>>
		<div class="wardrobe-storage-group">
			<b>전부 옮기기</b>: 다른 옷장으로 옮깁니다.
			<br>
			<span class="grey"><<if !$settings.multipleWardrobes>>여러 옷장이 필요하지만 설정에서 꺼져 있습니다.<<else>>옮겨 갈 다른 옷장이 없습니다.<</if>></span>
		</div>
	<</if>>
	<div class="wardrobe-storage-group wardrobe-danger-zone">
		<b class="red">파괴</b>: 한 슬롯의 모든 항목을 파괴합니다. 되돌릴 수 없습니다.
		<br>
		슬롯:
		<<print '<select id="wardrobe-bulk-slot"><option value="">슬롯을 선택하십시오...</option>' + setup.clothes_all_slots.filter(slot => Array.isArray(_selectedWardrobe[slot])).map(slot => '<option value="' + slot + '">' + slot.replace(/_/g, " ") + '</option>').join("") + '</select>'>>
		<<run setTimeout(() => { const slotSelect = document.getElementById("wardrobe-bulk-slot"); if (slotSelect) slotSelect.selectedIndex = 0; }, 0)>>
		<span id="wardrobe-bulk-discard">
			<<link "모두 파괴...">>
				<<set _discardSlot to (document.getElementById("wardrobe-bulk-slot") ? document.getElementById("wardrobe-bulk-slot").value : "")>>
				<<if _discardSlot is "">>
					<<replace "#wardrobe-bulk-hint">>먼저 슬롯을 선택하십시오.<</replace>>
				<<else>>
					<<capture _discardSlot>>
						<<replace "#wardrobe-bulk-discard">>
							<span class="red"><<= _discardSlot.replace(/_/g, " ")>> 슬롯의 항목 <<= _selectedWardrobe[_discardSlot].length>>개를 즐겨찾기까지 모두 파괴하시겠습니까? 같은 세트의 다른 조각은 불완전한 채로 남습니다.</span>
							<<link "파괴 확인">>
								<<run discardWardrobeSlot(_selectedWardrobe, _discardSlot)>>
								<<updatewardrobe>>
							<</link>> |
							<<link "취소">><<updatewardrobe>><</link>>
						<</replace>>
					<</capture>>
				<</if>>
			<</link>>
		</span>
		<span id="wardrobe-bulk-hint" class="red"></span>
	</div>
<</widget>>

<<widget "wardrobeEquipActions">>
	<<if $worn[_wardrobe_list].name isnot "naked">>
		<span class="wardrobe-action no-numberify"><<wearlink_norefresh "Strip" 'strip'>></span>
	<</if>>
	<<if _wardrobe_list is "upper">>
		<span class="wardrobe-action no-numberify"><<wearlink_norefresh "Large towel" 'large_towel'>></span>
	<</if>>
	<<if _wardrobe_list is "upper" or _wardrobe_list is "lower">>
		<span class="wardrobe-action no-numberify"><<wearlink_norefresh "Towel" 'towel'>></span>
	<</if>>
<</widget>>

<<widget "wardrobeNewOutfit">>
	<br>
	새로운 세트 추가:
	<br>
	이름: <input id="outfitName" type="text" value="사용자 지정" maxlength="30" onfocus="V.tempDisable = true;">
	<br>
	유형:
	<<listbox "$outfit_type">>
		<<option "평상복" 0 selected>>
		<<option "잠옷" "sleep">>
		<<option "수영복" "swim">>
		<<option "교복" "school">>
	<</listbox>>
	<br>
	<label>
		세트에 의상 색상 저장
		<<checkbox "_saveColor" false true autocheck>>
	</label>
	<br>
	<<if $settings.multipleWardrobes>>
		<label>
			이 옷장 전용 세트로 만들기
			<<checkbox "_saveLocation" false true autocheck>>
		</label>
		<br>
	<</if>>
	<<if $savedHairStyles>>
		<div>
			<<set _savedHairStylesKeys to Object.keys($savedHairStyles)>>
			헤어 스타일:
			<<listbox "_hairStyle" autoselect>>
				<<option "설정하지 않음" undefined>>
				<<optionsfrom _savedHairStylesKeys>>
			<</listbox>>
			<mouse class="tooltip linkBlue">(?)<span>'설정하지 않음'을 고르면 의상을 선택할 때 헤어스타일이 바뀌지 않습니다.</span></mouse>
		</div>
	<<else>>
		<div>
			헤어 스타일: 저장된 세트 없음 (거울 확인)
		</div>
	<</if>>
	<div>
		태도:
		<<listbox "_demeanour" autoselect>>
			<<option "설정하지 않음" undefined>>
			<<optionsfrom setup.faceVariantOptions[$facestyle]>>
		<</listbox>>
		<mouse class="tooltip linkBlue">(?)<span>'설정하지 않음'을 고르면 의상을 선택할 때 표정이 바뀌지 않습니다.</span></mouse>
	</div>
	<div>
		기본 표정:
		<<listbox "_defaultSidebarMouth" autoselect>>
			<<option "설정하지 않음" undefined>>
			<<option "미소" "smile">>
			<<option "무표정" "neutral">>
		<</listbox>>
		<mouse class="tooltip linkBlue">(?)<span>'설정하지 않음'을 고르면 의상을 선택할 때 표정이 바뀌지 않습니다.</span></mouse>
	</div>
	<br>
	<div class="wardrobe-action">
		<<link "현재 입은 옷을 새 세트로 추가">>
			<<set $outfit_name to document.getElementById("outfitName").value.replace(/[^a-zA-Z가-힣ㄱ-ㅎㅏ-ㅣ\u4e00-\u9fa5 0-9.!()]+/g,"")>>
			<<set _newOutfit to {
				index: $outfit.length,
				name: $outfit_name,
				type: ["normal"],
				colors: false,
			}>>
			<<set _equip to setup.clothingLayer.all>>
			<<for _slot range _equip>>
				<<set _newOutfit[_slot] to clone($worn[_slot].name)>>
			<</for>>
			<<if $outfit_name is "" or $outfit_name is "Custom" or $outfit_name is "사용자 지정">><<set $outfit_name to "사용자 지정 " + $outfit.length>><</if>>
			<<set _newOutfit.name to $outfit_name>>
			<<if $outfit_type>>
				<<set _newOutfit.type[0] to $outfit_type>>
			<</if>>
			<<if _saveColor>>
				<<set _colors to {}>>
				<<for _slot range _equip>>
					<<set _colors[_slot] to [$worn[_slot].colour, $worn[_slot].accessory_colour]>>
					<<if $worn[_slot].colour is "custom" or $worn[_slot].accessory_colour is "custom">>
						<<run _colors[_slot+"custom"] = [$worn[_slot].colourCustom, $worn[_slot].accessory_colourCustom]>>
					<</if>>
					<<if $worn[_slot].pattern isnot undefined>>
						<<set _colors[_slot].push($worn[_slot].pattern)>>
					<</if>>
				<</for>>
				<<set _newOutfit.colors to _colors>>
			<<else>>
				<<set _newOutfit.colors to false>>
			<</if>>
			<<set _positions to {}>>
			<<for _slot range _equip>>
				<<if $worn[_slot].altposition>>
					<<set _positions[_slot] to $worn[_slot].altposition>>
				<</if>>
				<<if $worn[_slot].altsleeve>>
					<<set _positions.sleeves to $worn[_slot].altsleeve>>
				<</if>>
			<</for>>
			<<if Object.keys(_positions).length > 0>>
				<<set _newOutfit.positions to _positions>>
			<</if>>
			<<if _saveLocation>>
				<<set _newOutfit.location to $wardrobe_location>>
			<</if>>
			<<if _hairStyle>>
				<<set _newOutfit.hairStyle to _hairStyle>>
			<</if>>
			<<if _demeanour>>
				<<set _newOutfit.facevariant to _demeanour>>
			<</if>>
			<<if _defaultSidebarMouth>>
				<<set _newOutfit.defaultSidebarMouth to _defaultSidebarMouth>>
			<</if>>
			<<set $outfit.push(_newOutfit)>>
			<<updatewardrobe "outfits">>
		<</link>>
	</div>
<</widget>>

<<widget "wardrobeintegrity">><<silently>>
	<<set _eIndextem to _args[0]>>
	<<set _eIndexntegrityMax to clothingData(_args[1],_eIndextem,'integrity_max')>>
	<<set _eIndexntegrity to clothingData(_args[1],_eIndextem,'integrity')>>
	<<if _eIndextem.integrity gt (_eIndexntegrityMax * 9 / 10)>>
		<<set $_output to "(_eIndexntegrity/_eIndexntegrityMax)">>
	<<elseif _eIndextem.integrity gt (_eIndexntegrityMax * 5 / 10)>>
		<<set $_output to "<span>(해짐) (_eIndexntegrity/_eIndexntegrityMax)</span>">>
	<<elseif _eIndextem.integrity gt (_eIndexntegrityMax * 2 / 10)>>
		<<set $_output to "<span>(찢어짐) (_eIndexntegrity/_eIndexntegrityMax)</span>">>
	<<else>>
		<<set $_output to "<span>(너덜너덜함) (_eIndexntegrity/_eIndexntegrityMax)</span>">>
	<</if>>
<</silently>><<print $_output>><</widget>>

<<widget "toggleHoodLink">>
	<div class="toggleHoodLink">
		<<link `($worn.upper.hoodposition is "down" ? "후드를 쓴다" : "후드를 벗는다")`>>
			<<toggleHood _args[0]>>
			<<updatesidebarimg>>
			<<if _args[0] isnot "shop" and _args[0] isnot "outside">>
				<<updatewardrobe>>
			<</if>>
			<<run $(".toggleHoodLink .link-internal").html($worn.upper.hoodposition is "down" ? "후드를 쓴다" : "후드를 벗는다")>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleHood">>
	/* If hood is up, put it down and free up the head slot*/
	<<if $worn.upper.hoodposition is "up" and $worn.head.hood is 1 and $worn.upper.outfitPrimary.head is $worn.head.name>>
		<<run delete $worn.upper.outfitPrimary.head>>
		<<set $worn.upper.hoodposition to "down">>
		<<if _args[0] is "shop" and $tryOn.ownedStored.head.name isnot $worn.head.name and !($tryOn.ownedStored.head.outfitSecondary and $tryOn.ownedStored.head.outfitSecondary[1] isnot "broken" and $tryOn.ownedStored.head.outfitSecondary[1] isnot "split")>>
			<<set $worn.head to clone($tryOn.ownedStored.head)>>
		<<else>>
			<<set $worn.head to clone(setup.clothes.head[0])>>
		<</if>>

		<<if _args[0] is "shop" and $tryOn.tryingOn.upper is null>>
			<<updateOwned "upper">>
			<<updateOwned "head">>
		<</if>>

	/* If hood is down, put it back up and remove anything on the head if necessary */
	<<elseif $worn.upper.hoodposition is "down">>
		<<if !$worn.head.cursed>> /* No cursed head items yet, but if one is made, should probably have some popup saying this was prevented */
			<<if $worn.head.outfitSecondary and $worn.head.outfitSecondary[1] isnot "broken" and $worn.head.outfitSecondary[1] isnot "split">>
				<<if $worn.head.hood is 1 and $worn.head.outfitSecondary[1] is $worn.upper.name and
				$worn.head.colour is $worn.upper.colour and $worn.head.accessory_colour is $worn.upper.accessory_colour and
				$worn.head.colourCustom is $worn.upper.colourCustom and $worn.head.accessory_colourCustom is $worn.upper.accessory_colourCustom>>
					<<set $worn.upper.outfitPrimary.head to clone(setup.clothes.upper[$worn.upper.index].outfitPrimary.head)>>
					<<set $worn.upper.hoodposition to "up">>
				<</if>>
			<<else>>
				<<if _args[0] is "shop">> /*If in a shop, make sure the head item is accounted for first*/
					<<if $tryOn.tryingOn.head isnot null>>
						<<shopbuyv2 "head" "return" null>>/*return if trying on*/
					<</if>>
					<<if $tryOn.tryingOn.upper is null and $worn.head.name isnot "naked">>
						<<generalUndress $wardrobe_location "head">>/*send back to wardrobe if already owned*/
					<</if>>
				<<elseif $worn.head.name isnot "naked">>
					<<generalUndress $wardrobe_location "head">>
				<</if>>
				<<set $worn.upper.outfitPrimary.head to clone(setup.clothes.upper[$worn.upper.index].outfitPrimary.head)>>
				<<set $worn.upper.hoodposition to "up">>
				/* re-create the hood using colors from the hoodie */
				<<set $_hoodIndex to setup.clothes.head.findIndex(x => x.name === $worn.upper.outfitPrimary.head)>>
				<<set $worn.head to clone(setup.clothes.head[$_hoodIndex])>>
				<<set $worn.head.colour to $worn.upper.colour>>
				<<if $worn.head.colour is "custom">>
					<<set $worn.head.colourCustom to $worn.upper.colourCustom>>
				<</if>>
				<<set $worn.head.accessory_colour to $worn.upper.accessory_colour>>
				<<if $worn.head.accessory_colour is "custom">>
					<<set $worn.head.accessory_colourCustom to $worn.upper.accessory_colourCustom>>
				<</if>>

				<<if _args[0] is "shop" and $tryOn.tryingOn.upper is null>>
					<<updateOwned "upper">>
				<</if>>
			<</if>>
		<</if>>
	<<elseif $worn.upper.hoodposition is undefined and setup.clothes.upper[$worn.upper.index].hoodposition isnot undefined>>
		<<set $worn.upper.hoodposition to "up">>
	<</if>>
<</widget>>

<<widget "ripClothing">>
	<<set _slot to _args[0]>>
	<<set _ripAmount to _args[1] || 10>>
	<<if $worn[_slot] isnot undefined and clothingData(_slot, $worn[_slot], 'integrity') isnot undefined>>
		<<set $worn[_slot].integrity to Math.max(0, $worn[_slot].integrity - _ripAmount)>>
	<</if>>
<</widget>>

/*
  ripToNextState: compute how many integrity points to remove to move the
  worn item into the next lower visual state (full -> frayed -> torn -> tattered -> destroyed).
  Usage: <<ripToNextState _slot>>
*/
<<widget "ripToNextState">>
	<<set _slot to _args[0]>>
	<<if canTearClothing(_slot, $worn[_slot])>>
		<<set _max to clothingData(_slot, $worn[_slot], 'integrity_max')>>
		<<set _curr to Number($worn[_slot].integrity) || 0>>
		<<set _t90 to (_max / 10) * 9>>
		<<set _t50 to (_max / 10) * 5>>
		<<set _t20 to (_max / 10) * 2>>

		<<if _curr gt _t90>>
			/* currently Full -> go to Frayed (<= 90%) */
			<<set _deduct to Math.ceil(_curr - _t90)>>
		<<elseif _curr gt _t50>>
			/* currently Frayed -> go to Torn (<= 50%) */
			<<set _deduct to Math.ceil(_curr - _t50)>>
		<<elseif _curr gt _t20>>
			/* currently Torn -> go to Tattered (<= 20%) */
			<<set _deduct to Math.ceil(_curr - _t20)>>
		<<elseif _curr gt 0>>
			<<exit>>
		<</if>>

		/* Ensure at least 1 point is removed when _deduct would be 0 but item >0 */
		<<if _deduct lt 1 and _curr gt 0>><<set _deduct to 1>><</if>>

		<<ripClothing _slot _deduct>>
	<</if>>
<</widget>>

<<widget "toggleNeckTuck">>
	<<set _linkOption1 to _args[0] || `Untuck from ${$worn.upper.name}`>>
	<<set _linkOption2 to _args[1] || `Tuck into ${$worn.upper.name}`>>
	<div class="toggleNeckTuck">
		<<link `($neckTucked ? _linkOption1 : _linkOption2)`>>
			<<set $neckTucked to +!$neckTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleNeckTuck .link-internal").html($neckTucked ? _linkOption1 : _linkOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleUpperTuck">>
	<<set _linkOption1 to _args[0] || `상의를 ${$worn.lower.name} 밖으로 뺀다`>>
	<<set _linkOption2 to _args[1] || `상의를 ${$worn.lower.name} 안에 넣는다`>>
	<div class="toggleUpperTuck">
		<<link `($upperTucked ? _linkOption1 : _linkOption2)`>>
			<<set $upperTucked to +!$upperTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleUpperTuck .link-internal").html($upperTucked ? _linkOption1 : _linkOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleLowerTuck">>
	<<set _linkOption1 to _args[0] || `하의를 ${$worn.feet.name} 밖으로 뺀다`>>
	<<set _linkOption2 to _args[1] || `하의를 ${$worn.feet.name} 안에 넣는다`>>
	<div class="toggleLowerTuck">
		<<link `($lowerTucked ? _linkOption1 : _linkOption2)`>>
			<<set $lowerTucked to +!$lowerTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleLowerTuck .link-internal").html($lowerTucked ? _linkOption1 : _linkOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>


<<widget "toggleBellyTuck">>
	<<set _softOption1 to _args[0] || `하의를 아래로 당긴다`>>
	<<set _softOption2 to _args[1] || `하의를 끌어올린다`>>
	<div class="toggleBellyTuck">
		<<link `($bellyTucked ? _softOption1 : _softOption2)`>>
			<<set $bellyTucked to +!$bellyTucked>>
			<<updatesidebarimg>>
			<<run $(".toggleBellyTuck .link-internal").html($bellyTucked ? _softOption1 : _softOption2)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleLeash">>
	<<if ["collar", "free use collar", "leather collar", "spiked collar", "Whitney's collar"].includes($worn.neck.name)>>
		<<link "리드줄을 단다">>
			<<attach_leash true true>>
			<<updatesidebarimg>>
			<<replace "#wardrobeLeash">><<toggleLeash>><</replace>>
		<</link>>
	<<elseif ["collar with leash", "free use collar with leash", "leather collar with leash", "spiked collar with leash", "Whitney's collar with leash"].includes($worn.neck.name)>>
		<<link "리드줄을 뗀다">>
			<<detach_leash true true>>
			<<updatesidebarimg>>
			<<replace "#wardrobeLeash">><<toggleLeash>><</replace>>
		<</link>>
	<</if>>
<</widget>>

<<widget "toggleAltLink">><<silently>>
	<<switch _args[0]>>
		<<case "upper">>
			<<switch $worn.upper.variable>>
				<<case "schoolcardigan">><<set _altLink to ["가디건을 허리에 묶기", "가디건을 정상적으로 입기"]>>
				<<case "waistcoat" "waistcoatlapel" "blazershirt" "fittedblazershirt">><<set _altLink to ["Tuck in", "Untuck"]>>
				<<case "dress" "buttondown" "oversizedbuttondown" "fittedbuttondown" "oversizedfittedbuttondown" "shortsleevebuttonup" "flannel shirt">><<set _altLink to ["Unbutton shirt", "Button up shirt"]>>
				<<case "catsuit">><<set _altLink to ["지퍼 내리기", "지퍼 올리기"]>>
				<<case "kimono" "kimonomini">><<set _altLink to ["느슨하게 풀기", "단단히 조이기"]>>
				<<case "flowy sleeve top" "milkmaid dress">><<set _altLink to ["소매 내리기", "소매 올리기"]>>
				<<case "striped sweater">><<set _altLink to ["소매를 걷어올린다", "소매를 내린다"]>>
				<<case "boilersuit">><<set _altLink to ["지퍼 내리기", "지퍼 올리기"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "over_upper">>
			<<switch $worn.over_upper.variable>>
				<<case "brownleather" "blackleather" "leathercropjacket" "winterjacket">><<set _altLink to ["Zip jacket", "Unzip jacket"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "under_upper">>
			<<switch $worn.under_upper.variable>>
				<<case "ruffled swimsuit">><<set _altLink to ["가디건 벗기", "가디건 입기"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "head">>
			<<switch $worn.head.variable>>
				<<case "bandana hat">><<set _altLink to ["뒤로 묶기", "앞으로 묶기"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "neck">>
			<<switch $worn.neck.variable>>
				<<case "suspenders">><<set _altLink to ["멜빵을 내린다", "멜빵을 제대로 착용한다"]>>
				<<case "tie">><<set _altLink to ["느슨하게 한다", "단단히 맨다"]>>
				<<default>><<exit>>
			<</switch>>
		<<case "face">>
			<<if $worn.face.type.includes("cool") or $worn.face.type.includes("glasses")>>
				<<switch $worn.face.variable>>
					<<case "monocle">><<set _altLink to ["왼쪽 눈을 가린다", "오른쪽 눈을 가린다"]>>
					<<default>><<set _altLink to ["머리 위로 올린다", "제대로 착용한다"]>>
				<</switch>>
			<<else>>
				<<switch $worn.face.variable>>
					<<case "medical eyepatch" "eyepatch" "rose eyepatch" "butterfly eyepatch">><<set _altLink to ["왼쪽 눈을 가린다", "오른쪽 눈을 가린다"]>>
					<<case "plaster">><<set _altLink to ["왼쪽 뺨을 가린다", "오른쪽 뺨을 가린다"]>>
					<<case "swimgoggles">><<set _altLink to ["머리 위로 올린다", "제대로 착용한다"]>>
					<<case "sleeping mask">><<set _altLink to ["야간용으로 착용한다", "주간용으로 착용한다"]>>
					<<default>><<exit>>
				<</switch>>
			<</if>>
		<<case "hands">>
			<<switch $worn.hands.variable>>
				<<default>><<set _altLink to ["오른쪽 손목에 착용한다", "왼쪽 손목에 착용한다"]>>
			<</switch>>
		<<case "legs">>
			<<switch $worn.legs.variable>>
				<<case "kneeplaster">><<set _altLink to ["왼쪽 무릎 가리기", "오른쪽 무릎 가리기"]>>
				<<default>><<exit>>
			<</switch>>
		<<default>><<exit>>
	<</switch>>
	<</silently>>
	<span @class="_args[0]">
		<<capture _args[0] _altLink>>
			<<link `($worn[_args[0]].altposition is "none" ? _altLink[0] : _altLink[1])`>>
				<<toggleAltPosition _args[0]>>
				<<updatesidebarimg>>
				<<if _args[1] is "wardrobe">>
					<<updatewardrobe>>
				<</if>>
				<<run $(".toggleAltLink ." + _args[0] + " .link-internal").html($worn[_args[0]].altposition is "none" ? _altLink[0] : _altLink[1])>>
				<<run Links.generateLinkNumbers($(".passage"))>>
			<</link>>
		<</capture>>
	</span>
<</widget>>

<<widget "toggleAltPosition">>
	/*Changes sprite to an alternate image*/
	<<if $worn[_args[0]].altposition is undefined and setup.clothes[_args[0]][$worn[_args[0]].index].altposition isnot undefined>>
		<<set $worn[_args[0]].altposition to "none">>
	<<else>>
		<<set $worn[_args[0]].altposition to ($worn[_args[0]].altposition is "none" ? "alt" : "none")>>
	<</if>>
<</widget>>

<<widget "toggleAltSleeve">>
	<<set _inDefaultState to _args[0] || "소매를 걷는다">>
	<<set _inAltState to _args[1] || "소매를 내린다">>
	<div class="toggleAltSleeve">
		<<link `($worn.upper.altsleeve is "none" ? _inDefaultState : _inAltState)`>>
			<<set $worn.upper.altsleeve to ($worn.upper.altsleeve is "none" ? "alt" : "none")>>
			<<updatesidebarimg>>
			<<run $(".toggleAltSleeve .link-internal").html($worn.upper.altsleeve is "none" ? _inDefaultState : _inAltState)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
<</widget>>

<<widget "toggleFaceLayer">>
	/*changes z-index */
	<<set _linkOption1 to "머리카락을 앞으로 넘긴다">>
	<<set _linkOption2 to "머리카락을 뒤로 넘긴다">>
	<div class="toggleFaceLayer">
		<<link `($facelayer is "front" ? _linkOption2 : _linkOption1)`>>
			<<set $facelayer to ($facelayer is "front" ? "back" : "front")>>
			<<updatesidebarimg>>
			<<if _args[0] is "wardrobe">>
					<<updatewardrobe>>
			<</if>>
			<<run $(".toggleFaceLayer .link-internal").html($facelayer is "front" ? _linkOption2 : _linkOption1)>>
			<<run Links.generateLinkNumbers($(".passage"))>>
		<</link>>
	</div>
	<br>
<</widget>>

<<widget "repairClothing">>
	<div class="repairClothing">
		<<if _wornItem.integrity lt _wornItemData.integrity_max and _wornItemData.repairable isnot false and !_wornItemData.altDamage>>
			<<if $DoLPSpools gte 1>>
				<<set _timeNeeded to 10 - (1 * Math.round($housekeeping / 250))>>
				<<set _timeString to getTimeString(_timeNeeded)>>
				<<link [["당신의 _wornItem.name【을를】 수선한다 (_timeString)"|$passage]]>>
					<<set $worn[_wardrobe_list].integrity to Math.min($worn[_wardrobe_list].integrity + 25, setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_wornItem)].integrity_max)>>
					<<set _gain to Math.max(6 - (2 * Math.round($housekeeping / 200)), 2)>>
					<<housekeeping _gain 1000>>
					<<updatesidebarimg>>
					<<set $DoLPSpools -= 1>>
					<<pass _timeNeeded>>
				<</link>><<ghousekeeping 1000>>
			<<else>>
				당신의 _wornItem.name【을를】 수선할 실패가 하나도 없다.
			<</if>>
		<</if>>
	</div>
<</widget>>

<<widget "wardrobePageControls">>
	<<set _wardrobePageKey to $wardrobe_location + ":" + _args[0]>>
	<<set _wardrobePages to _wardrobePages || {}>>
	<<set _wardrobePageCount to Math.max(1, Math.ceil(_args[1] / wardrobePageSize))>>
	<<set _wardrobePages[_wardrobePageKey] to Math.clamp(_wardrobePages[_wardrobePageKey] || 0, 0, _wardrobePageCount - 1)>>
	<<set _wardrobePageStart to _wardrobePages[_wardrobePageKey] * wardrobePageSize>>
	<<if _wardrobePageCount gt 1>>
		<div class="wardrobe-pages no-numberify" style="clear:both;">
			<<capture _wardrobePageKey>>
				<<if _wardrobePages[_wardrobePageKey] gt 0>>
					<<link "이전">>
						<<set _wardrobePages[_wardrobePageKey]-->>
						<<if $('#wardrobeList').length>><<replace '#wardrobeList'>><<wardrobeContents>><</replace>>
						<<else>><<replace '#oldWardrobeListDisplay'>><<oldWardrobeListDisplay>><</replace>><</if>>
					<</link>> |
				<</if>>
				페이지 <<= _wardrobePages[_wardrobePageKey] + 1>> / <<= _wardrobePageCount>>
				<<if _wardrobePages[_wardrobePageKey] lt _wardrobePageCount - 1>>
					| <<link "다음">>
						<<set _wardrobePages[_wardrobePageKey]++>>
						<<if $('#wardrobeList').length>><<replace '#wardrobeList'>><<wardrobeContents>><</replace>>
						<<else>><<replace '#oldWardrobeListDisplay'>><<oldWardrobeListDisplay>><</replace>><</if>>
					<</link>>
				<</if>>
			<</capture>>
		</div>
	<</if>>
<</widget>>

<<widget "wardrobeList">>
	<<if !_args[1]>><<wardrobeClothingOptions>><</if>>
	<<set _wardrobe_list to _args[0]>>
	<<set _combinedWardrobeList to _args[2]>>
	<<if !Object.keys($worn).includes(_wardrobe_list)>>
		widget "wardrobeList"에 오류가 발생했습니다. 세이브 데이터를 임의로 수정하지 않았다면 보고해 주세요.
	<<else>>
		<<set _wear to "wear_"+_wardrobe_list>>

		<<if !_combinedWardrobeList>>
		<<set _outfitTypes to setup.clothingLayer.torso_inner>>
		<div class="wardrobe-listhead">
			<span>__<<print _wardrobe_list[0].toUpperCase() + _wardrobe_list.substring(1)>>__ <i>_selectedWardrobe[_wardrobe_list].length / _selectedWardrobe.space</i>
			<<if _wardrobe_list is "upper">>(한 벌 옷은 하의 슬롯도 차지합니다)<</if>>
			<<if _wardrobe_list is "under_upper">>(한 벌 속옷은 속옷 하의 슬롯도 차지합니다)<</if>></span>
			<div class="wardrobe-sort">정렬: <<print wardrobeSortLinks(_wardrobe_list, _outfitTypes.includes(_wardrobe_list))>></div>
		</div>
		<<if $settings.multipleWardrobes>>
			핸드백 안의 항목:
			<<if $worn.bag.type.includes("bookbag")>>
				<span class="gold"><<= getWardrobeItemCount("inventory")>>/<<= $wardrobes.inventory.space>>개</span>
			<<else>>
				착용한 핸드백 없음
			<</if>>
			<br>
		<</if>>
		<<if $worn[_wardrobe_list].name is "naked">>
			<div class="wardrobe-equipped">
				현재 착용 중: 없음
			</div>
		<<else>>
			<div class="wardrobe-equipped">
			현재 착용 중:
			<<set _wornItem to $worn[_wardrobe_list]>>
			<<set _wornItemData to setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_wornItem)]>>
			<<clothingicon _wornItem _wardrobe_list>>
			/* Prefer the worn item's own name: an X-Change reshaped chastity device keeps its catalogue identity, so only the worn copy knows it is now a belt rather than a cage. */
			<<print _wornItem.name_cap ? _wornItem.name_cap : _wornItemData.name_cap>>
			<<if _wornItem.colour and _wornItem.colour isnot 0>>
				<span @class="_wornItem.colour?.replace(' ','-')">
					<<if _wornItem.pattern and ![0, "plain"].includes(_wornItem.pattern) and _wornItemData.pattern_options?.length gt 1>>
						(<<print setup.colourName(_wornItem.colour)>> <<print setup.getPatternName(_wornItem.pattern)>>)
					<<else>>
						(<<print setup.colourName(_wornItem.colour)>>)
					<</if>>
				</span>
			<<elseif _wornItem.pattern and _wornItem.pattern isnot 0 and _wornItemData.pattern_options?.length gt 1>>
				<span @class="_wornItem.pattern?.replace(' ','-')">(<<print setup.getPatternName(_wornItem.pattern)>>)</span>
			<</if>>
			<<if _wornItem.outfitPrimary isnot undefined>>
				<<set _keys to Object.keys(_wornItem.outfitPrimary)>>
				<<set _broken to 0>>
				<<for _j to 0; _j lt _keys.length; _j++>>
					<<if _wornItem.outfitPrimary[_keys[_j]] is "broken">>
						<<set _broken++>>
					<</if>>
				<</for>>
				<<if _broken is 0>>
						<span class="gold">(한 벌)</span>
				<<elseif _broken lt _keys.length>>
						<span class="red">(부분 파손)</span>
				<<else>>
						<span class="red">(파손)</span>
				<</if>>
				<<if _wornItem.one_piece is "split">>
						<span class="separated-indicator">(분리됨)</span>
				<</if>>
			<</if>>
			<<if _wornItem.outfitSecondary isnot undefined>>
				<<if _wornItem.outfitSecondary[1] is "broken">>
					<span class="red">(파손)</span>
				<<else>>
					<span class="gold">(한 벌)</span>
					<<if _wornItem.one_piece is "split">>
						<span class="separated-indicator">(분리됨)</span>
					<</if>>
				<</if>>
			<</if>>
			<<wardrobeintegrity _wornItem _wardrobe_list>>
			|
			<a onclick="document.getElementById('wardrobeItemDetails').classList.toggle('hidden')">추가 정보</a>
			</div>
			<div id="wardrobeItemDetails" @class="$wardrobeDefaults.extraInfo?'':'hidden'">
				<<if _wornItem.gender is "m">>
					<span class="lblue">♂ 소년용 </span>
				<<elseif _wornItem.gender is "f">>
					<span class="pink">♀ 소녀용 </span>
				<</if>>
				<<if ["Whitney's collar", "Whitney's collar with leash"].includes(_wornItem.name)>>
					<<print setup.clothes.neck.find(item => item.name === (_wornItem.cursed ? "Whitney's collar with leash" : "Whitney's collar")).description>>
				<<else>>
					<<print _wornItemData.description>>
				<</if>>
				<br>
				<<print setup.WeatherDescriptions.clothingWarmth(getTrueWarmth(_wornItem))>>
				<br>
				<<print _wornItemData.description>>
				<br><br>
				<<set _temp_choice to $worn[_wardrobe_list]>>
				<<shoptraits>>
			</div>
			<div class="wardrobe-mods">
			<<if $DoLPSpools isnot undefined>>
				<span class="wardrobe-spools"><<shopicon "tailor">> 실패 <span class="green">$DoLPSpools</span>개</span>
				<div class="no-numberify"><<repairClothing>></div>
			<</if>>

			<<if canTearClothing(_wardrobe_list, $worn[_wardrobe_list])>>
				<div class="no-numberify"><<link `$worn[_wardrobe_list].name + "【을를】 찢는다"`>><<ripToNextState _wardrobe_list>><<updatesidebarimg>><<updatewardrobe>><</link>></div>
			<</if>>

			<<if isConnectedToHood(_wardrobe_list)>>
				<!-- If selected item is a hood or selected item has a secondary hood piece -->
				<div class="no-numberify"><<toggleHoodLink>></div>
			<</if>>
			/* <<if $worn.upper.name isnot "naked">>
				<div class="no-numberify"><<toggleNeckTuck>></div>
			<</if>> */
			<<if _wardrobe_list is "upper" and $worn.lower.name isnot "naked" and !_wornItemData.notuck and V.worn.upper.outfitPrimary is undefined>>
				<div class="no-numberify"><<toggleUpperTuck>></div>
			<<elseif _wardrobe_list is "lower" and $worn.feet.name isnot "naked" and !_wornItemData.notuck and !setup.clothes.feet[clothesIndex("feet",$worn.feet)].notuck>>
				<div class="no-numberify"><<toggleLowerTuck>></div>
			<</if>>
			<<if _wardrobe_list is "lower" and $player.bodyshape is "soft" and $worn.lower.name isnot "naked" and (!setup.clothes.lower[clothesIndex("lower",$worn.lower)].outfitSecondary or setup.clothes.lower[clothesIndex("lower",$worn.lower)]?.outfitSecondary[1] isnot $worn.upper.name)>>
				<div class="no-numberify"><<toggleBellyTuck>></div>
			<</if>>
			<<if _wardrobe_list is "upper" and $worn.upper.name isnot "naked" and _wornItemData.altsleeve>>
				<div class="no-numberify toggleAltSleeve"><<toggleAltSleeve>></div>
			<</if>>
			<div class="no-numberify toggleAltLink"><<toggleAltLink _wardrobe_list "wardrobe">></div>
			<<if _wardrobe_list is "neck">>
				<div id="wardrobeLeash" class="no-numberify"><<toggleLeash>></div>
			<</if>>
			<<if _wardrobe_list is "face">>
				<div class="no-numberify toggleAltLink"><<toggleFaceLayer "wardrobe">></div>
			<</if>>
			</div>
		<</if>>
		<</if>>

		<<set _hasHandbag to $worn.bag.type.includes("bookbag")>>
		<<if $settings.multipleWardrobes and _hasHandbag>>
			<div class="wardrobe-grid">
			<<for _i to 0; _i lt $wardrobes.inventory[_wardrobe_list].length; _i++>>
				<<set _item to $wardrobes.inventory[_wardrobe_list][_i]>>
				<<if !wardrobeItemMatches(_item)>>
					<<continue>>
				<</if>>
				<<set _itemData to setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_item)]>>
				<<set _itemOutfitData to _itemData.outfitPrimary>>
				<<if _item.outfitSecondary isnot undefined>>
					<<if _item.outfitSecondary[1] isnot "broken" and _item.outfitSecondary[1] isnot "split">>
						<<continue>>
					<</if>>
				<</if>>

				/*Finds any outfit pieces and records the Ids*/
				<<set _outfitPieceIds to {}>>
				<<if _item.outfitPrimary isnot undefined>>
					<<for $_outfitPieceSlot, $_outfitPieceName range _item.outfitPrimary>>
						<<if $_outfitPieceName is "broken" or $_outfitPieceName is "split">>
							<<continue>>
						<</if>>
						<<for $_outfitPieceId, $_wardrobeItem range $wardrobes.inventory[$_outfitPieceSlot]>>
							<<if $_wardrobeItem.name isnot $_outfitPieceName>>
								<<continue>>
							<</if>>
							<<if _item.colour isnot $_wardrobeItem.colour or ($_wardrobeItem.accessory isnot 0 and _item.accessory_colour isnot $_wardrobeItem.accessory_colour) or ($_wardrobeItem.pattern and _item.pattern and $_wardrobeItem.pattern isnot 0 and _item.pattern isnot $_wardrobeItem.pattern)>>
								<<continue>>
							<</if>>
							<<if $_wardrobeItem.outfitSecondary?.[1] isnot _item.name>>
								<<continue>>
							<</if>>
							<<set _matched to 0>>
							<<if $_wardrobeItem.colour isnot "custom" or (_item.colourCustom isnot undefined and _item.colourCustom is $_wardrobeItem.colourCustom)>>
								<<set _matched++>>
							<</if>>
							<<if $_wardrobeItem.accessory is 0 or $_wardrobeItem.accessory_colour isnot "custom" or (_item.accessory_colourCustom isnot undefined and _item.accessory_colourCustom is $_wardrobeItem.accessory_colourCustom)>>
								<<set _matched++>>
							<</if>>
							<<if _matched is 2>>
								<<set _outfitPieceIds[$_outfitPieceSlot] to $_outfitPieceId>>
								<<break>>
							<</if>>
						<</for>>
					<</for>>
				<</if>>

				<div class="wardrobeItem wardrobe-action no-numberify">
					<div>
						<<clothingicon _item _wardrobe_list>>
						<<wearlink_norefresh _itemData.name_cap _i _wear "inventory">>
						<span class="gold">(핸드백 안)</span>
					</div>

					<div class="small-description">
						<<if _item.colour and _item.colour isnot 0>>
							<span @class="_item.colour?.replace(' ','-') + ' noDivider'">
								<<if _item.pattern and ![0, "plain"].includes(_item.pattern) and _itemData.pattern_options?.length gt 1>>
									(_item.colour _item.pattern)
								<<else>>
									(_item.colour)
								<</if>>
							</span>
						<<elseif _item.pattern and _item.pattern isnot 0 and _itemData.pattern_options?.length gt 1>>
							<span @class="_item.pattern?.replace(' ','-') + ' noDivider'">(_item.pattern)</span>
						<</if>>
						<<if _item.outfitPrimary isnot undefined>>
							<<set _keys to Object.keys(_item.outfitPrimary)>>
							<<set _broken to 0>>
							<<for _j to 0; _j lt _keys.length; _j++>>
								<<if _item.outfitPrimary[_keys[_j]] is "broken">>
									<<set _broken++>>
								<</if>>
							<</for>>
							<<if _broken is 0>>
								<span @class="(!_item.colour || _item.colour === 0? ' noDivider': '')">(한 벌)</span>
							<<elseif _broken lt _keys.length>>
								<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(일부 파손)</span>
							<<else>>
								<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(파손)</span>
							<</if>>
							<<if _item.one_piece is "split">>
								<span @class="'separated-indicator' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(분리됨)</span>
							<</if>>
						<</if>>
						<<if _item.outfitSecondary isnot undefined>>
							<<if _item.one_piece is "split">>
								<span @class="'separated-indicator' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(분리됨)</span>
							<<else>>
								<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(파손)</span>
							<</if>>
						<</if>>
						<<wardrobeintegrity _item _wardrobe_list>>
						<<reveal _item.reveal>>

						<<if _item.gender is "m">>
							<span class="blue noDivider">♂</span>
						<<elseif _item.gender is "f">>
							<span class="pink noDivider">♀</span>
						<<else>>
						<</if>>

						| <span class="cold-resist-icon noDivider"><<print getTrueWarmth(_item)>></span>
						<<if $wardrobeDefaults.showTraits>>
							| <span class="wardrobe-traits noDivider"><<for _n, _trait range _item.type>>
								<<clothingtrait _trait>>
							<</for>></span>
						<</if>>
						| <<wardrobeFavoriteLink _wardrobe_list _item>>
						
						<<unset _slotsFull>>
						/*Set the target wardrobe*/
						<<set _wardrobeTransferObject to selectWardrobe($wardrobe_location)>>
						/*Make sure there is enough space*/
						<<if _wardrobeTransferObject[_wardrobe_list].length gte _wardrobeTransferObject.space or getWardrobeItemCount(_wardrobeTransferObject, true) + 1 + Object.keys(_outfitPieceIds).length gt 3500>>
							<<set _slotsFull to true>>
						<</if>>
						<<if _itemOutfitData>>
							<<for $_outfitSlot, $_outfitId range _itemOutfitData>>
								<<if _wardrobeTransferObject[$_outfitSlot].length gte _wardrobeTransferObject.space>>
									<<set _slotsFull to true>>
								<</if>>
							<</for>>
						<</if>>

						<<if $settings.multipleWardrobes>>
							<<if !_slotsFull>>
								<<capture _wardrobe_list, _i, _outfitPieceIds>>
									<span></span>
									<<link "옷장으로 옮긴다">>
										<<run transferClothing(_wardrobe_list,_i, "inventory",$wardrobe_location, { moveLinkedPieces: false })>>
										<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
											<<run transferClothing($_outfitSlot,$_outfitId, "inventory",$wardrobe_location, { moveLinkedPieces: false })>>
										<</for>>
										<<updatewardrobe>>
									<</link>>
								<</capture>>
							<<else>>
								<span class="gold">옷장이 가득 찼습니다!</span>
							<</if>>
						<</if>>
					</div>
				</div>
			<</for>>
			</div>
		<</if>>

		<<set _wardrobeIndices to _selectedWardrobe[_wardrobe_list].reduce((indices, item, index) => {
			if ((!item.outfitSecondary || ["broken", "split"].includes(item.outfitSecondary[1])) && wardrobeItemMatches(item)) indices.push(index);
			return indices;
		}, [])>>
		<<if !_combinedWardrobeList and wardrobeFilterActive()>>
			<<if _wardrobeIndices.length is 0>>
				검색이나 필터와 일치하는 항목이 없습니다.
			<<else>>
				전체 <<= _selectedWardrobe[_wardrobe_list].filter(item => !item.outfitSecondary || ["broken", "split"].includes(item.outfitSecondary[1])).length>>개 중 _wardrobeIndices.length개를 표시하고 있습니다.
			<</if>>
			<br>
		<</if>>
		<div class="wardrobe-listbar">
			<<wardrobePageControls _wardrobe_list _wardrobeIndices.length>>
			<div class="wardrobe-equip-actions"><<if !_combinedWardrobeList>><<wardrobeEquipActions>><</if>></div>
		</div>
		<div class="wardrobe-grid">
		<<for _i range _wardrobeIndices.slice(_wardrobePageStart, _wardrobePageStart + wardrobePageSize)>>
			<<set _item to _selectedWardrobe[_wardrobe_list][_i]>>
			<<set _itemData to setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_item)]>>
			<<set _itemOutfitData to _itemData.outfitPrimary>>

			/*Finds any outfit pieces and records the Ids*/
			<<set _outfitPieceIds to {}>>
			<<if _item.outfitPrimary isnot undefined>>
				<<for $_outfitPieceSlot, $_outfitPieceName range _item.outfitPrimary>>
					<<if $_outfitPieceName is "broken" or $_outfitPieceName is "split">>
						<<continue>>
					<</if>>
					<<for $_outfitPieceId, $_wardrobeItem range _selectedWardrobe[$_outfitPieceSlot]>>
						<<if $_wardrobeItem.name isnot $_outfitPieceName>>
							<<continue>>
						<</if>>
						<<if _item.colour isnot $_wardrobeItem.colour or ($_wardrobeItem.accessory isnot 0 and _item.accessory_colour isnot $_wardrobeItem.accessory_colour) or ($_wardrobeItem.pattern and _item.pattern and $_wardrobeItem.pattern isnot 0 and _item.pattern isnot $_wardrobeItem.pattern)>>
							<<continue>>
						<</if>>
						<<if $_wardrobeItem.outfitSecondary?.[1] isnot _item.name>>
							<<continue>>
						<</if>>
						<<set _matched to 0>>
						<<if $_wardrobeItem.colour isnot "custom" or (_item.colourCustom isnot undefined and _item.colourCustom is $_wardrobeItem.colourCustom)>>
							<<set _matched++>>
						<</if>>
						<<if $_wardrobeItem.accessory is 0 or $_wardrobeItem.accessory_colour isnot "custom" or (_item.accessory_colourCustom isnot undefined and _item.accessory_colourCustom is $_wardrobeItem.accessory_colourCustom)>>
							<<set _matched++>>
						<</if>>
						<<if _matched is 2>>
							<<set _outfitPieceIds[$_outfitPieceSlot] to $_outfitPieceId>>
							<<break>>
						<</if>>
					<</for>>
				<</for>>
			<</if>>

			<div class="wardrobeItem wardrobe-action no-numberify">
				<div>
					<<clothingicon _item _wardrobe_list>>
					<<wearlink_norefresh _itemData.name_cap _i _wear>>
				</div>

				<div class="small-description">
					<<if _item.colour and _item.colour isnot 0>>
						<span @class="_item.colour?.replace(' ','-') + ' noDivider'">
							<<if _item.pattern and ![0, "plain"].includes(_item.pattern) and _itemData.pattern_options?.length gt 1>>
								(_item.colour _item.pattern)
							<<else>>
								(_item.colour)
							<</if>>
						</span>
					<<elseif _item.pattern and _item.pattern isnot 0 and _itemData.pattern_options?.length gt 1>>
						<span @class="_item.pattern?.replace(' ','-') + ' noDivider'">(_item.pattern)</span>
					<</if>>
					<<if _item.outfitPrimary isnot undefined>>
						<<set _keys to Object.keys(_item.outfitPrimary)>>
						<<set _broken to 0>>
						<<for _j to 0; _j lt _keys.length; _j++>>
							<<if _item.outfitPrimary[_keys[_j]] is "broken">>
								<<set _broken++>>
							<</if>>
						<</for>>
						<<if _broken is 0>>
							<span @class="(!_item.colour || _item.colour === 0? ' noDivider': '')">(한 벌)</span>
						<<elseif _broken lt _keys.length>>
							<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(일부 파손)</span>
						<<else>>
							<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(파손)</span>
						<</if>>
						<<if _item.one_piece is "split">>
							<span @class="'separated-indicator' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(분리됨)</span>
						<</if>>
					<</if>>
					<<if _item.outfitSecondary isnot undefined>>
						<<if _item.one_piece is "split">>
							<span @class="'separated-indicator' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(분리됨)</span>
						<<else>>
							<span @class="'red' + (!_item.colour || _item.colour === 0? ' noDivider': '')">(파손)</span>
						<</if>>
					<</if>>
					<<wardrobeintegrity _item _wardrobe_list>>
					<<reveal _item.reveal>>

					<<if _item.gender is "m">>
						<span class="blue noDivider">♂</span>
					<<elseif _item.gender is "f">>
						<span class="pink noDivider">♀</span>
					<<else>>
					<</if>>

					| <span class="cold-resist-icon noDivider"><<print getTrueWarmth(_item)>></span>
					<<if $wardrobeDefaults.showTraits>>
						| <span class="wardrobe-traits noDivider"><<for _n, _trait range _item.type>>
							<<clothingtrait _trait>>
						<</for>></span>
					<</if>>
					| <<wardrobeFavoriteLink _wardrobe_list _item>>
					
					<<if $settings.multipleWardrobes>>
						<<set _handbagIsFull to getWardrobeItemCount("inventory") gte $wardrobes.inventory.space>>
						<<set _handsAreFull to getWardrobeItemCount("inventory") gte 2>>

						<<if _hasHandbag and !_handbagIsFull>>
							<<capture _wardrobe_list, _i, _outfitPieceIds>>
								<span></span>
								<<link "핸드백으로 옮긴다">>
									<<run transferClothing(_wardrobe_list,_i,$wardrobe_location,"inventory", { moveLinkedPieces: false })>>
									<<for $_outfitSlot, $_outfitId range _outfitPieceIds>>
										<<run transferClothing($_outfitSlot,$_outfitId, $wardrobe_location,"inventory", { moveLinkedPieces: false })>>
									<</for>>
									<<updatewardrobe>>
								<</link>>
							<</capture>>
						<<elseif _hasHandbag and _handbagIsFull>>
							<span class="gold">핸드백이 가득 찼습니다!</span>
						<<else>>
							/* <span class="default-colour">No Handbag Available</span> */
						<</if>>
					<</if>>
				</div>
			</div>
		<</for>>
		</div>
		<<if !_combinedWardrobeList>><div style="clear:both;"></div><</if>>
	<</if>>
<</widget>>

<<widget "wearlink_norefresh">>
	<<capture _args[1] _args[2] _args[3] _wear>>
		<<link _args[0]>>
			<<if _args[2]>>
				<<set V[_args[2]] = _args[1]>>
			<<else>>
				<<set V[_wear] = _args[1]>>
			<</if>>
			<<if _args[3] is "inventory">>
				<<set $equipFromInventory to (_args[2] || _wear).slice(5)>>
			<</if>>
			<<updatewardrobe undefined _args[2]>>
		<</link>>
	<</capture>>
<</widget>>

<<widget "updatewardrobe">>
	<<if window.scrollY > 130>>
		<<run $('#action-popup, #wardrobewear').html(new Wikifier(null, "<<wardrobewear>>").output)>>
		<<run $('#action-popup').css('transform', 'translateY(0)'); setTimeout(() => { $('#action-popup').css('transform', 'translateY(-100%)') }, 3200);>>
	<<else>>
		<<run $('#wardrobewear').html(new Wikifier(null, "<<wardrobewear>>").output)>>
	<</if>>
	<<if _args[0] isnot "noflash">><<run $('#wardrobewear').addClass('notransition flash'); setTimeout(() => { $('#wardrobewear').removeClass('notransition flash') }, 100);>><</if>>
	<<updatesidebarimg>>
	<<updatesidebardescription>>
	<<updateallure>>
	<<updatewarmthscale>>
	<<updatewarmthdescription>>
	<<if _args[0] == "outfits">>
		<<replace "#listoutfits">><<listoutfits>><</replace>>
	<</if>>
	<<silently>><<clotheson>><</silently>>
	<<if $('#wardrobe-storage-body')[0]>>
		<<replace '#wardrobe-storage-summary'>><<wardrobeStorageSummary>><</replace>>
		<<replace '#wardrobe-storage-body'>><<wardrobeStorageBody>><</replace>>
	<</if>>
	<<if $('#wardrobeList')[0]>><<replace '#wardrobeList'>><<wardrobeContents>><</replace>><</if>>
	<<if $('#oldWardrobeListDisplay')[0]>>
		<<if _args[1]>>
			<<set $_slot to _args[1].slice(5)>>
			<<switch $_slot>>
				<<case "upper">>
					<<replace '#clothingBox-upper'>>
						<<oldWardrobeList "upper" "outfits">>
						<<oldWardrobeList "upper" "non-outfits">>
					<</replace>>
					<<replace '#clothingBox-lower'>>
						<<oldWardrobeList "lower">>
					<</replace>>
				<<case "under_upper">>
					<<replace '#clothingBox-under_upper'>>
						<<oldWardrobeList "under_upper" "outfits">>
						<<oldWardrobeList "under_upper" "non-outfits">>
					<</replace>>
					<<replace '#clothingBox-under_lower'>>
						<<oldWardrobeList "under_lower">>
					<</replace>>
				<<default>>
					<<replace `'#clothingBox-' + $_slot`>><<oldWardrobeList $_slot>><</replace>>
			<</switch>>
			<<replace '#wardrobeMinorOptions'>><<oldWardrobeMinorOptions>><</replace>>
		<<else>>
			<<replace '#oldWardrobeListDisplay'>><<oldWardrobeListDisplay>><</replace>>
		<</if>>
	<</if>>
	<<exposure>>
	<<run $('#wardrobeExits').html(new Wikifier(null, "<<wardrobeExits>>").output)>>
	<<numberify ".passage">>
	/* Swapping or removing a bag empties its slots immediately; the personal pocket remains. */
	<<if $pocket>><<run pocketSyncBag()>><</if>>
	<<run updateMoment()>>
<</widget>>

<<widget "oldWardrobeMinorOptions">>
	<div id="wardrobeMinorOptions">
		
		<<if $worn.lower.name isnot "naked" and $worn.upper.outfitPrimary is undefined and !wornSetupClothes("upper").notuck>>
			<<set $_linkOption1 to `${$worn.upper.name}【을를】 밖으로 뺀다`>>
			<<set $_linkOption2 to `${$worn.upper.name}【을를】 ${$worn.lower.name} 안에 넣는다`>>
			<<toggleUpperTuck $_linkOption1 $_linkOption2>>
		<</if>>
		<<if $worn.head.hood>>
			<!-- If selected item is a hood or selected item has a secondary hood piece -->
			<<toggleHoodLink>>
		<</if>>
		<<if ["collar", "free use collar", "leather collar", "spiked collar", "collar with leash", "free use collar with leash", "leather collar with leash", "spiked collar with leash", "Whitney's collar", "Whitney's collar with leash"].includes($worn.neck.name)>>
			<div id="wardrobeLeash" class="no-numberify"><<toggleLeash>></div>
		<</if>>
	</div>
<</widget>>

<<widget "oldWardrobeListDisplay">>
	<<wardrobeClothingOptions>>
	<<oldWardrobeMinorOptions>>
	<br>

	<<oldWardrobeList "over_upper">>
	<<oldWardrobeList "over_lower">>
	<div id="clothingBox-upper">
		<<oldWardrobeList "upper" "outfits">>
		<<oldWardrobeList "upper" "non-outfits">>
	</div>
	<div id="clothingBox-lower">
		<<oldWardrobeList "lower">>
	</div>
	<div id="clothingBox-under_upper">
		<<oldWardrobeList "under_upper" "outfits">>
		<<oldWardrobeList "under_upper" "non-outfits">>
	</div>
	<div id="clothingBox-under_lower">
		<<oldWardrobeList "under_lower">>
	</div>
	<<oldWardrobeList "over_head">>
	<div id="clothingBox-head"><<oldWardrobeList "head">></div>
	<div id="clothingBox-face"><<oldWardrobeList "face">></div>
	<div id="clothingBox-neck"><<oldWardrobeList "neck">></div>
	<div id="clothingBox-hands"><<oldWardrobeList "hands">></div>
	<div id="clothingBox-handheld"><<oldWardrobeList "handheld">></div>
	<<if $ears_pierced is 1>>
		<div id="clothingBox-earrings"><<oldWardrobeList "earrings">></div>
	<</if>>
	<div id="clothingBox-rings"><<oldWardrobeList "rings">></div>
	<div id="clothingBox-legs"><<oldWardrobeList "legs">></div>
	<div id="clothingBox-feet"><<oldWardrobeList "feet">></div>
	<div style="clear:both;"></div>
	<<wardrobeNewOutfit>>
<</widget>>

<<widget "oldWardrobeList">>
	<<set _wardrobe_list to _args[0]>>
	<<set _showType to _args[1]>>
	<<if !Object.keys($worn).includes(_wardrobe_list)>>
		oldWardrobeList 위젯에 오류가 발생했습니다. 수동으로 세이브 데이터를 조작하지 않았다면 보고해 주세요.
	<<else>>
		<<set _wear to "wear_"+_wardrobe_list>>

		<div class="clothingBox">
		<<set _slotKr to window.KR.getClothingSlotKr(_wardrobe_list)>>
		__<<print _slotKr + (_showType is "outfits" ? " 세트" : "")>>__ <i>_selectedWardrobe[_wardrobe_list].length / _selectedWardrobe.space</i>
		<br><br>
		<<set _wardrobeIndices to _selectedWardrobe[_wardrobe_list].reduce((indices, item, index) => {
			if (item.outfitSecondary && !["broken", "split"].includes(item.outfitSecondary[1])) return indices;
			if ((item.outfitPrimary && _showType === "non-outfits") || (!item.outfitPrimary && _showType === "outfits")) return indices;
			indices.push(index);
			return indices;
		}, [])>>
		<<wardrobePageControls `_wardrobe_list + ":" + (_showType || "all")` _wardrobeIndices.length>>
		<div>
		<ul>
		<<if $worn[_wardrobe_list].name isnot "naked">>
			<li class="no-numberify"><<wearlink_norefresh "벗는다" 'strip' _wear>></li>
		<</if>>
		<<if _wardrobe_list is "upper" and _showType is "outfits">>
			<li class="no-numberify"><<wearlink_norefresh "큰 수건" 'large_towel' _wear>></li>
		<</if>>
		<<if (_wardrobe_list is "upper" or _wardrobe_list is "lower") and _showType isnot "outfits">>
			<li class="no-numberify"><<wearlink_norefresh "수건" 'towel' _wear>></li>
		<</if>>
		<<for _i range _wardrobeIndices.slice(_wardrobePageStart, _wardrobePageStart + wardrobePageSize)>>
			<<set _item to _selectedWardrobe[_wardrobe_list][_i]>>
			<li class="no-numberify">/*<<clothingicon _item>>*/<<wearlink_norefresh setup.clothes[_wardrobe_list][clothesIndex(_wardrobe_list,_item)].name_cap _i _wear>>
			<<if _item.colour isnot 0>>
				<span @class="_item.colour?.replace(' ','-')">(<<print setup.colourName(_item.colour)>>)</span>
			<</if>>
			<<wardrobeintegrity _item _wardrobe_list>>
			| <<wardrobeFavoriteLink _wardrobe_list _item>>
			</li>
		<</for>>
		</ul>
		</div></div>
	<</if>>
<</widget>>

<<widget "wardrobeListReorder">>
	<<if _args[0] and _args[1]>>
		<<script>>
			const [slot, orderType, descending] = T.args;
			const items = T.selectedWardrobe[slot];
			const groups = new Map();
			for (const item of items) {
				let value;
				switch (orderType) {
					case "name": value = item.name; break;
					case "color": value = item.colour; break;
					case "integrity": value = item.integrity / clothingData(slot, item, "integrity_max"); break;
					case "warmth": value = getTrueWarmth(item); break;
					case "outfit": value = item.one_piece; break;
					case "lewd": value = item.reveal; break;
					default: continue;
				}
				/* Preserve the old no-reorder guard for values that could not be matched. */
				if (Number.isNaN(value)) continue;
				if (!groups.has(value)) groups.set(value, []);
				groups.get(value).push(item);
			}
			let values = Array.from(groups.keys());
			switch (orderType) {
				case "name":
					values.sort((a, b) => descending ? b.localeCompare(a) : a.localeCompare(b));
					break;
				case "color":
					values.sort((a, b) => descending ? String(b).localeCompare(String(a)) : String(a).localeCompare(String(b)));
					break;
				case "integrity":
				case "warmth":
					values.sort(descending ? (a, b) => a - b : (a, b) => b - a);
					break;
				case "outfit":
					values = descending ? ["broken", "split", 0, 1] : [1, 0, "split", "broken"];
					break;
				case "lewd":
					values.sort(descending ? (a, b) => a - b : (a, b) => b - a);
					break;
			}
			const sorted = values.flatMap(value => groups.get(value) || []);
			if (sorted.length === items.length) T.selectedWardrobe[slot] = sorted;
			if (T.wardrobePages) T.wardrobePages[V.wardrobe_location + ":" + slot] = 0;
		<</script>>
		<<run Dynamic.render()>>
	<</if>>
<</widget>>

<<widget "wardrobeSanityCheck">>
	/*Fixes invisible outfit bottoms caused by bugs in previous versions*/
	<<if $runWardrobeSanityChecker is true>>
		<<set $lastWardrobeSanityCheck to $saveVersions.last()>>
		/*Update _equip as required*/
		<<set _equip to ["lower", "under_lower", "head"]>>
		<<for _slot range _equip>>
			<<set _eIndextemIndex to {}>>
			<<for _eIndex to 0; _eIndex lt _selectedWardrobe[_slot].length; _eIndex++>>
				<<if _selectedWardrobe[_slot][_eIndex].outfitSecondary is undefined>>
					<<continue>>
				<</if>>
				<<if _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] is "broken" or _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] is "split">>
					<<continue>>
				<</if>>

				/*Prep*/
				<<set $_markBroken to true>>
				<<set $_found to false>>
				<<set _eIndextem to _selectedWardrobe[_slot][_eIndex]>>
				<<set $_outfitSecondary to _selectedWardrobe[_slot][_eIndex].outfitSecondary>>
				<<if _eIndextemIndex[$_outfitSecondary[0]] is undefined>>
					<<set _eIndextemIndex[$_outfitSecondary[0]] to []>>
				<</if>>

				/*Look for a primary piece that matches*/
				<<for _iIndex to 0; _iIndex lt _selectedWardrobe[$_outfitSecondary[0]].length; _iIndex++>>
					<<if _selectedWardrobe[$_outfitSecondary[0]][_iIndex].name isnot $_outfitSecondary[1]>>
						<<continue>>
					<</if>>
					<<if _eIndextemIndex[$_outfitSecondary[0]].includes(_iIndex)>>
						<<continue>>
					<</if>>

					<<if _selectedWardrobe[$_outfitSecondary[0]][_iIndex].colour is _eIndextem.colour and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory_colour is _eIndextem.accessory_colour)>>
						<<if _eIndextem.colour isnot "custom" and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _eIndextem.accessory_colour isnot "custom")>>
							<<set $_markBroken to false>>
							<<run _eIndextemIndex[$_outfitSecondary[0]].push(clone(_iIndex))>>
							<<break>>
						<<elseif _eIndextem.colourCustom is _selectedWardrobe[$_outfitSecondary[0]][_iIndex].colourCustom and (_eIndextem.accessory is 0 or _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory is 0 or _eIndextem.accessory_colourCustom is _selectedWardrobe[$_outfitSecondary[0]][_iIndex].accessory_colourCustom)>>
							<<set $_markBroken to false>>
							<<run _eIndextemIndex[$_outfitSecondary[0]].push(clone(_iIndex))>>
							<<break>>
						<</if>>
					<</if>>
				<</for>>
				<<if $_markBroken is true>>
					/*Mark as broken*/
					<<set _selectedWardrobe[_slot][_eIndex].outfitSecondary[1] to "broken">>
					<<set _selectedWardrobe[_slot][_eIndex].one_piece to "broken">>
					<<set _selectedWardrobe[_slot][_eIndex].set to clone(_slot)>>
					<<set _selectedWardrobe[_slot][_eIndex].sanityCheck to true>>
				<</if>>
			<</for>>
		<</for>>
		<<set $runWardrobeSanityChecker to false>>
	<</if>>
<</widget>>

<<widget "wardrobeGetRepairedClothes">>
	<<set _equip to setup.clothingLayer.all>>
	<<set _takenAway to 0>>
	<<for _eIndex to 0; _eIndex lt _equip.length; _eIndex++>>
		<<if $wardrobeRepair[_equip[_eIndex]] is undefined>>
			<<continue>>
		<</if>>
		<<for _iIndex to 0; _iIndex lt $wardrobeRepair[_equip[_eIndex]].length; _iIndex++>>
			<<set _itemStats to $wardrobeRepair[_equip[_eIndex]][_iIndex]>>
			<<if typeof _itemStats is "object" and _itemStats?.length >= 5>>
				/* Players might have old $wardrobeRepair already set before version updated */
				<<set _itemStats to {
					index: _itemStats[0],
					colour: _itemStats[1],
					colourCustom: _itemStats[2],
					accessory_colour: _itemStats[3],
					accessory_colourCustom: _itemStats[4],
					one_piece: _itemStats[5] === true ? "split" : undefined
				}>>
			<</if>>
			<<if _selectedWardrobe[_equip[_eIndex]].length gte _selectedWardrobe.space>>
				<<set _takenAwayCheckitem to setup.clothes[_equip[_eIndex]][_itemStats.index]>>
				<<if _takenAwayCheckitem.one_piece != 1>>
					<<set _takenAway++>>
					<<continue>>
				<</if>>
			<</if>>

			<<sendToWardrobeFromDefault "wardrobe" _equip[_eIndex] `_itemStats.index` `_itemStats.colour` `_itemStats.accessory_colour` `_itemStats.pattern`>>
			<<set _latestWardrobeAddition to _selectedWardrobe[_equip[_eIndex]].last()>>

			<<run Object.entries(_itemStats).forEach(([key, itemStatValue]) => {
				if (!itemStatValue) return;
				switch (key) {
					case "accessory_colour": case "accessory_colourCustom":
						if (!T.latestWardrobeAddition.accessory_colour_sidebar && T.itemStats.one_piece != "split") return;
						break;
					case "index": case "colour": case "pattern":
						return;
						break;
					case "altposition": case "altsleeve":
						if (!T.latestWardrobeAddition[key]) return;
						break;
					case "one_piece":
						if (T.latestWardrobeAddition[key] != 1) return;
						if (itemStatValue === "split") {
							if (T.latestWardrobeAddition.outfitPrimary) {
								Object.keys(T.latestWardrobeAddition.outfitPrimary).forEach((label) => {
									T.latestWardrobeAddition.outfitPrimary[label] = itemStatValue;
								})
							} else if (T.latestWardrobeAddition.outfitSecondary) {
								T.latestWardrobeAddition.outfitSecondary[1] = itemStatValue;
							}
						}
						break;
					case "hoodposition":
						if (!T.latestWardrobeAddition[key]) return;
						if (itemStatValue === "down") {
							delete T.latestWardrobeAddition.outfitPrimary.head;
							delete T.latestWardrobeAddition.outfitPrimary.over_head;
						}
						break;
				}
				T.latestWardrobeAddition[key] = itemStatValue;
			})>>
		<</for>>
	<</for>>
	<<if _takenAway gt 0>>
		<br>
		공간 부족으로 _takenAway개의 물건을 기부했다. 운전기사가 감사를 표한다.
	<</if>>
	<<unset $wardrobeRepair>>
<</widget>>

<<widget "randomWear">>
	<<set $wardrobeOption to "wear">>
	<<set $_equip to []>>
	<<set _equipped to []>>
	<<for $_slot, $_value range $randomEquipConfigure>>
		<<if $worn[$_slot].type.includes("strap-on")>>
			<<continue>>
		<</if>>
		<<if $_value>>
			<<generalUndress $wardrobe_location $_slot>>
			<<run $_equip.push($_slot)>>
		<</if>>
	<</for>>
	<<for $_slot range $_equip>>
		<<if !_equipped.includes($_slot) and $worn[$_slot].name is "naked">>
			<<set _eIndexds to _selectedWardrobe[$_slot].map((item, index) => {
				if (!item.outfitSecondary or item.outfitSecondary[1] is "broken" or item.outfitSecondary[1] is "split") return index;
			}).filter(x => x !== undefined)>>
			<<if _eIndexds.length gt 0>>
				<<set _eIndexd to _eIndexds.random()>>
				<<set $_selectedItem to _selectedWardrobe[$_slot][_eIndexd]>>
					<<run _equipped.pushUnique($_slot)>>
					<<if $_selectedItem.outfitPrimary isnot undefined>>
						<<run Object.entries($_selectedItem.outfitPrimary).forEach((slot,value) => {
							if (value !== "broken" && value !== "split") _equipped.pushUnique(slot)
						})>>
					<</if>>
					<<set V["wear_" + $_slot] to _eIndexd>>
				<<unset _eIndexd>>
			<</if>>
		<</if>>
	<</for>>
	<<unset $randomWear>>
<</widget>>

<<widget "warmth_description">>
	<<print setup.WeatherDescriptions.shop()>>
	<<if !_inWardrobe>>
		<br>
	<</if>>
	현재 당신의 의상 보온성은 <span class="orange"><<print Weather.BodyTemperature.getWarmth()>></span>입니다.
	<<if !_inWardrobe>>
		<br>
	<</if>>

	<<set $_minWarmth to getTargetWarmth(36.4)>>
	<<set $_maxWarmth to getTargetWarmth(37.6)>>
	현재 기온에 쾌적하려면 
	<<if $_minWarmth and $_maxWarmth>>
		<span class="orange"><<print getTargetWarmth(36.5)>></span>에서 <span class="orange"><<print getTargetWarmth(37.5)>></span> 사이의 보온성이 필요합니다.
	<<elseif $_minWarmth>>
		최소 <span class="orange"><<print getTargetWarmth(36.5)>></span>의 보온성이 필요합니다.
	<<elseif $_maxWarmth>>
		최대 <span class="orange"><<print getTargetWarmth(37.5)>></span>의 보온성이 필요합니다.
	<<else>>
		실내에 머물러야 합니다.
	<</if>>
	<<if _inWardrobe>>
		<<set $_warmthNow to Weather.BodyTemperature.getWarmth()>>
		<<if $_minWarmth and getTargetWarmth(36.5) and $_warmthNow lt getTargetWarmth(36.5)>>
			<br><span class="red">쾌적해지려면 보온을 <<print getTargetWarmth(36.5) - $_warmthNow>> 더 높이십시오.</span>
		<<elseif $_maxWarmth and getTargetWarmth(37.5) and $_warmthNow gt getTargetWarmth(37.5)>>
			<br><span class="red">쾌적해지려면 보온을 <<print $_warmthNow - getTargetWarmth(37.5)>> 낮추십시오.</span>
		<</if>>
	<<else>>
		<hr />
	<</if>>
<</widget>>

<<widget "wardrobeSelection">>
	<<set _nativeWardrobe to resolveWardrobeLocation($wardrobe_location)>>
	<<if $forceWardrobeLocation and !$debug and !wardrobeReachableFromHere($forceWardrobeLocation, _nativeWardrobe)>>
		<<unset $forceWardrobeLocation>>
	<</if>>
	<<if $forceWardrobeLocation and $settings.multipleWardrobes and $wardrobes[$wardrobe_location]>>
		<<set $wardrobe_location to $forceWardrobeLocation>>
	<<else>>
		<<set $wardrobe_location to resolveWardrobeLocation($wardrobe_location)>>
	<</if>>
	<<if $debug and $settings.multipleWardrobes and !_args[0]>>
		<div class="no-numberify">디버그:
			<<for _label, _value range $wardrobes>>
				<<if _value.unlocked is undefined>>
				<<elseif $wardrobe_location is _label>>
					<span class="gold"><<print _value.name>></span> |
				<<else>>
					<<capture _label>><<link [[_value.name|$passage]]>><<set $forceWardrobeLocation to _label>><</link>> |<</capture>>
				<</if>>
			<</for>>
		</div>
		<br>
	<<elseif remoteWardrobeAccessAllowed() and !_args[0]>>
		<<wardrobeSwitcher _nativeWardrobe>>
	<</if>>
<</widget>>

/* Lets changing rooms, lockers, and wardrobes access other reachable wardrobes. */
<<widget "wardrobeSwitcher">>
	<<set _wardrobeOptions to accessibleWardrobeOptions(_args[0])>>
	<<if _wardrobeOptions.length gt 1>>
		<div class="no-numberify">옷장:
			<<for _optionIndex, _option range _wardrobeOptions>>
				<<if _optionIndex gt 0>>|<</if>>
				<<if $wardrobe_location is _option.key>>
					<span class="gold"><<print _option.name>></span>
				<<else>>
					<<capture _option>><<link [[_option.name|$passage]]>><<set $forceWardrobeLocation to _option.key>><</link>><</capture>>
				<</if>>
			<</for>>
		</div>
		<br>
	<</if>>
<</widget>>

<<widget "cleanupOnWardrobeExit">>
	<<if $bus is "clothingshop" or $bus is "baitShop">><<set $tryOn.autoReset to true>><</if>>
	<<unset $saveColor>><<unset $wardrobeRepeat>><<unset $tempDisable>><<set $delete_outfit to "none">><<unset $forceWardrobeLocation>><<set $dontHide to false>><<run delete $wardrobeExit>>
<</widget>>

<<widget "wardrobeExits">>
	<!-- Note: Don't use $_ in this widget, because this widget gets <<replace>>'d into the passage body -->
	<!-- this widget doesn't make sense because these links ALWAYS depend on the passage this widget is called from, so there's no reason to make it a widget -->
	<<switch $passage>>
		<<case "Wardrobe">>
			<<link [[옷장을 닫는다|Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Changing Room">>
			<<if $exposed lte 1>>
				<<set _exit to $wardrobeExit or "Beach">>
				<<getouticon>><<link [[떠난다|_exit]]>><<cleanupOnWardrobeExit>><</link>>
			<<elseif hasSexStat("exhibitionism", 5)>>
				<<set _exitSneak to $wardrobeExit or "Beach Changing Room Sneak">>
				<<sneakicon>><<link [[몰래 밖으로 나간다|_exitSneak]]>><<cleanupOnWardrobeExit>><</link>><<exhibitionist5>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Sydney Beach Changing Room">>
			<<set _earSlimeEnableSwimwear to true>>
			<<if $exposed lte 1>>
				<<getouticon>><<link [[떠난다|Sydney Beach Swimsuit]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Sydney Beach Changing Room Leave">>
			<<set _earSlimeEnableSwimwear to true>>
			<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and $hypnosis_traits?.silence isnot 1>>
				<span class="red">귓속의 <<slimeWord>>【이가】 <<underwearTypeText>>【을를】 입은 채로 나가는 것을 허락하지 않는다.</span>
			<<elseif $exposed lte 1>>
				<<getouticon>><<link [[떠난다|Sydney Beach Leave]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Eden Wardrobe">>
			<<if isLoveInterest("Eden") or hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[완료|Eden Cabin]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이렇게 벗은 채로 있을 수는 없다!
			<</if>>
		<<case "Eden Night Wardrobe">>
			<<if isLoveInterest("Eden") or hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[완료|Eden Cabin Bed]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이렇게 벗은 채로 있을 수는 없다!
			<</if>>
		<<case "Asylum Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[완료|Asylum Cell]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이렇게 벗은 채로 있을 수는 없다!
			<</if>>
		<<case "Farm Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[완료|Farm Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이렇게 벗은 채로 있을 수는 없다!
			<</if>>
		<<case "Strip Club Wardrobe">>
			<<if hasSexStat("exhibitionism", 4) or $exposed lte 0 or (hasSexStat("exhibitionism", 2) and $exposed lte 1)>>
				<<link [[물러난다|Strip Club Dressing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Brothel Wardrobe">>
			<<if hasSexStat("exhibitionism", 4) or $exposed lte 0 or (hasSexStat("exhibitionism", 2) and $exposed lte 1)>>
				<<link [[물러난다|Brothel Dressing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Arcology Hotel Wardrobe">>
			<<link [[옷장을 닫는다|Arcology Hotel Room]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Arcology Ship Wardrobe">>
			<<link [[옷장을 닫는다|Arcology Ship Cabin]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Underground Colosseum Locker">>
			<<getouticon>><<link [[떠난다|Underground Colosseum Washroom]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Dance Studio Locker">>
			<<getouticon>><<link [[떠난다|Dance Studio Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Lake Stash">>
			<<getouticon>><<link [[떠난다|Lake Shore]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "MMA Gym Locker">>
			<<getouticon>><<link [[떠난다|MMA Gym Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "School Pool Wardrobe">>
			<<if $changingRoomGender is "boys">>
				<<getouticon>><<link [[떠난다|School Boy Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				<<getouticon>><<link [[떠난다|School Girl Changing Room]]>><<cleanupOnWardrobeExit>><</link>>
			<</if>>
		<<case "Farm Assault Wardrobe">>
			<<if hasSexStat("exhibitionism", 5) or $exposed lte 0 or (hasSexStat("exhibitionism", 4) and $exposed lte 1)>>
				<<link [[완료|Farm Assault Intro]]>><<cleanupOnWardrobeExit>><</link>>
			<<else>>
				이렇게 벗은 채로 있을 수는 없다!
			<</if>>
		<<case "Prison Wardrobe">>
			<<link [[닫는다|Prison Cell]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Temple Wardrobe">>
			<<link [[닫는다|Temple Bunk]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Pirate Wardrobe">>
			<<link [[닫는다|Pirate Bed]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Office Agency Changing Room">>
			<<if $exposed lte 1>>
				<<getouticon>><<link [[떠난다|Office Agency]]>><<cleanupOnWardrobeExit>><</link>>
			<<elseif hasSexStat("exhibitionism", 4)>>
				<<sneakicon>><<link [[몰래 밖으로 나간다|Office Agency Streak]]>><<cleanupOnWardrobeExit>><</link>><<exhibitionist4>>
			<<else>>
				이런 모습으로 나갈 수는 없다!
			<</if>>
		<<case "Bird Tower Wardrobe">>
			<<link [[닫는다|Bird Tower]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Water Dragon Nest Wardrobe">>
			<<link [[상자를 닫는다|Water Dragon Nest]]>><<cleanupOnWardrobeExit>><</link>>
		<<case "Mansion Wardrobe">>
			<<if $avery_party>>
				<<link [[나간다|Mansion Party Quinn Change 2]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<<elseif $phase is 446>>
				<<link [[나간다|Mansion Clothing Wardrobe Exit]]>><<cleanupOnWardrobeExit>><</link>>
			<<elseif $avery_mansion_skyscraper_wardrobe>>
				<<link [[나간다|Mansion Skyscraper Wardrobe Exit]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<<elseif $wardrobe_residential_alleys gte 2>>
				<<if $exposed lte 0>>
					<<link [[나간다|Residential Alleyways]]>><</link>>
					<br>
				<<elseif $exposed is 1 and hasSexStat("exhibitionism", 4)>>
					<<link [[나간다|Residential Mansion Undies]]>><</link>><<exhibitionist4>>
					<br>
				<<elseif $exposed is 2 and hasSexStat("exhibitionism", 5)>>
					<<link [[나간다|Residential Mansion Naked]]>><</link>><<exhibitionist5>>
					<br>
				<<else>>
					이런 옷차림으로는 나갈 수 없다!
				<</if>>
			<<else>>
				<<link [[나간다|Mansion Bedroom]]>><<cleanupOnWardrobeExit>><</link>>
				<br>
			<</if>>
	<</switch>>
	<br><br>
<</widget>>

<<widget "underwearTypeText">><<silently>>
	<<if $worn.under_lower.name is "naked">>
	<<elseif $worn.under_lower.type.includes("swim")>>
		<<set $_text_output to "수영복">>
	<<elseif $worn.under_lower.type.includes("dance")>>
		<<set $_text_output to "댄스복">>
	<<else>>
		<<set $_text_output to "속옷">>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

:: Wardrobe [exitCheckBypass]
<<effects>>
<<set $wardrobe_location to "wardrobe">>
<<wardrobeSelection>>
옷장을 살펴본다.
<br><br>
<div id="wardrobewear"><<wardrobewear>></div>
<div id="wardrobeExits"><<wardrobeExits>></div>
<<if pocketAvailable()>>
	<!-- Serving outfits can be folded up and carried to somebody who could wear one for work. See pocket-outfit.js. -->
	<<if pocketOutfitCarrying()>>
		<<link [[가방 속의 서빙 복장|Pocket Pack Outfit]]>><<set $pocketOutfitReturn to "Wardrobe">><</link>>
		<span class="teal">(<<= pocketOutfitName().toLocaleUpperFirst()>>)</span>
		<br>
	<<elseif pocketOutfitCandidates().length gt 0>>
		<<link [[서빙 복장을 접어 넣는다|Pocket Pack Outfit]]>><<set $pocketOutfitReturn to "Wardrobe">><</link>>
		<br>
	<</if>>
<</if>>

