:: Portal Panties [widget]
/* Written for a bit of fun over a couple of hours, feel free to mod it in or re-work it. Follow the comments to run in the game. Lollipop Scythe */

/* Run at the start of the game and in version update */
<<widget "portalPantiesSetup">>
	<<if $portalPanties is undefined>>
		<<set $portalPanties to {
			toPass: 0,
			totalPassed: 0,
			cooldown: random(300,720),
			state: {
				anus: undefined,
				vagina: undefined,
			},
			ownPenisOrgasms: {
				anus: 0,
				vagina: 0,
			},
			portalPenisOrgasms: {
				anus: 0,
				vagina: 0,
			},
			message: {
				entrance: [],
				imminent: [],
				started: [],
				continued: [],
				disappeared: [],
				resumed: [],
				finished: [],
			}
		}>>
	<</if>>
	<<if $portalPanties.message.resumed is undefined>>
		<<set $portalPanties.message.resumed to []>>
	<</if>>
	<<if $portalPanties.message.entrance is undefined>>
		<<set $portalPanties.message.entrance to []>>
		<<set $portalPanties.message.imminent to []>>
	<</if>>
<</widget>>

/* Place '<<portalPantiesPass $pass>>' within the "pass" widget. */
<<widget "portalPantiesPass">>
	<<if $event or playerChastity("hidden") or def $birth>>/*Prevents it from running during events, if the player has a chastity belt, or during childbirth ($birth exists from the start of labour until the birth resolves)*/
	<<elseif $portalPantiesEnabled and ($worn.under_lower.type.includes("portal") or $xchange.pill.portalEffect)>>
		<<set $portalPanties.totalPassed += _args[0]>>
		<<set _totalToPass to _args[0]>>
		<<for _totalToPass gt 0>>
			<<if $portalPanties.cooldown gte 0 and _args[0] gt 0>>
				<<set $portalPanties.cooldown to Math.clamp($portalPanties.cooldown - _totalToPass, 0, 1440)>>
			<</if>>
			<<set _totalToPass to Math.max(_totalToPass - $portalPanties.cooldown, 0)>>
			<<if ["anus","vagina"].find((location) => $portalPanties.state[location])>>
				<<set $portalPanties.toPass to Math.clamp($portalPanties.toPass + _args[0], 0, 1440)>>
			<</if>>
			<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
			<<if $portalPanties.cooldown lte 0 and !$NPCList[0].name and !$event>>
				/* Attempt to fill a hole */
				<<set $_free to []>>
				<<if !$portalPanties.state.anus>><<run $_free.pushUnique("anus")>><</if>>
				<<if !$portalPanties.state.vagina and $player.vaginaExist>><<run $_free.unshiftUnique("vagina")>><</if>>
				<<if !$_free.length>><<break>><</if>>

				<<set $_playersPPFree to false>>
				/* <<set $_playersPPFree to $player.penisExist and $player.penissize gte 0 and !playerChastity("cage") and !$_penisLocation>> */
				<<set $_toFill to $_free.shift()>>
				<<if $_toFill>>
					<<portalPantiesFillHole $_toFill $_playersPPFree `_totalToPass gt 30? _totalToPass / 10 : 1`>>
				<</if>>
				<<if $portalPanties.state.anus or $portalPanties.state.vagina>>
					/* Sets the cooldown, 1440 is 1 day */
					<<set _frequency to Math.max(0.00001, $xchange.portalFrequency / 100)>>
					<<if between($portalPanties.totalPassed, 0, 1440 * 2 / _frequency)>>
						<<set $portalPanties.cooldown to random(540,720) / _frequency>>
					<<elseif between($portalPanties.totalPassed, 1440 * 2 / _frequency, 1440 * 5 / _frequency)>>
						<<set $portalPanties.cooldown to random(270,540) / _frequency>>
					<<elseif between($portalPanties.totalPassed, 1440 * 5 / _frequency, 1440 * 10 / _frequency)>>
						<<set $portalPanties.cooldown to random(135,270) / _frequency>>
					<<elseif between($portalPanties.totalPassed, 1440 * 10 / _frequency, 1440 * 20 / _frequency) or random(0,1)>>
						<<set $portalPanties.cooldown to random(45,135) / _frequency>>
					<<else>>
						<<set $portalPanties.cooldown to random(15,45) / _frequency>>
					<</if>>
				<</if>>
			<</if>>
			<<if $portalPanties.cooldown lte 0>><<break>><</if>>
		<</for>>
		
	<<else>>
		/*Stop the effect if it should no longer apply */
		<<set $portalPanties.toPass to 0>>
		<<portalPantiesClear "vagina">>
		<<portalPantiesClear "anus">>
	<</if>>
<</widget>>

<<widget "portalPantiesFillHole">>
	<<if !$portalPanties.state[_args[0]]>>
		<<set $portalPanties.state[_args[0]] to {
			owner: _args[1] ? "pc" : "portal",
			size: _args[1] ? $player.penissize : random(3,6),
			timer: _args[1] ? null : random(5,15),
			type: _args[1] ? "human" : "human",
			new: _args[2] gt 3? 0 : Math.ceil(_args[2]),
			tempRemoval: false,
			tempTimer: 0,
		}>>
		<<set $portalPanties.overloaded to _args[2] gt 1>>
	<</if>>
<</widget>>

<<widget "portalPantiesFuck">>
	<<set _arousalIncrease to 0>>
	<<set _toPass to Math.min($portalPanties.toPass, $portalPanties.state[_args[0]]?.timer || 31)>>
	<<set _penisSize to $portalPanties.state[_args[0]] and [3,0].includes($portalPanties.state[_args[0]].new)? _args[1] : 1>>
	<<if $portalPanties.state[_args[0]] and !$portalPanties.state[_args[0]].tempRemoval>>
		<<switch $portalPanties.state[_args[0]].new>>
		<<case 3>>
			<<set _arousalIncrease to 100>>
			<<if $portalPanties.state[_args[0]].timer>>
				<<set $portalPanties.state[_args[0]].timer -= _toPass>>
			<</if>>
			<<set _toPass to Math.max(_toPass, 10)>>
		<<case 1 2>>
			<<set _arousalIncrease to 200>>
		<<case 0>>
			<<set _arousalIncrease to 200>>
			<<if $portalPanties.state[_args[0]].timer>>
				<<set $portalPanties.state[_args[0]].timer -= _toPass>>
			<</if>>
			<<set _toPass to Math.max(_toPass, 1)>>
		<</switch>>
	<<elseif $portalPanties.state[_args[0]] and $portalPanties.state[_args[0]].tempRemoval>>
		<<set $portalPanties.state[_args[0]].tempTimer -= $portalPanties.toPass>>
	<</if>>
	<<penetrationPainCalculate>>
	<<set _toPass to ([1,2].includes($portalPanties.state[_args[0]]?.new)? 1 : _toPass)>>
	<<switch _args[0]>>
		<<case "vagina">>
			<<arousal `_toPass * _args[1] * _arousalIncrease` "vagina">>
		<<case "anus">>
			<<arousal `_toPass * _args[1] * _arousalIncrease` "anus">>
	<</switch>>
<</widget>>

<<widget "portalPantiesClear">>
	<<set $portalPanties.state[_args[0]] to undefined>>
<</widget>>

/* Place '<<portalPantiesDisplay>>' within '<<effects>>' */
<<widget "portalPantiesDisplay">><<if ndef $birth>><<silently>>
	/* The whole portal effect is paused during childbirth ($birth defined), so nothing here may run */
	/*Runs the 'fucking' effect */
	<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<if $player.vaginaExist>>
		<<portalPantiesFuck "vagina" `$_penisLocation === "vagina" ? 2 : 1`>>
	<</if>>
	<<portalPantiesFuck "anus" `$_penisLocation === "anus" ? 2 : 1`>>

	/*Displays the respective message */
	<<if $worn.under_lower.type.includes("portal") or $xchange.pill.portalEffect>>
		<<if $player.vaginaExist>>
			<<portalPantiesDisplayItem "vagina">>
		<</if>>
		<<portalPantiesDisplayItem "anus">>
	<</if>>
	<</silently>><<portalPantiesDisplayMessage>>

	<<set $portalPanties.toPass to 0>>
<</if>><</widget>>

<<widget "portalPantiesDisplayItem">>
	<<if $portalPanties.state[_args[0]]>>
		<<set _relevantWetness to {"vagina":$vaginaWetness, "anus":$anusWetness}[_args[0]]>>
		<<set $_disabled to !!$event or !!$NPCList[0].name>>
		<<if $_disabled and !$portalPanties.state[_args[0]].tempRemoval and $portalPanties.state[_args[0]].new is 0 and (random(1,3) is 1)>>
			<<set $portalPanties.message.disappeared.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].tempRemoval to true>>
			<<set $portalPanties.state[_args[0]].tempTimer to random(1,10)>>
			<<if $debug is 1>><<run console.warn("Disappeared!")>><</if>>
		<<elseif $_disabled>>
			<<if $debug is 1>><<run console.warn("Nothing!")>><</if>>
			/* Nothing */

		<<elseif !$_disabled and $portalPanties.state[_args[0]].tempRemoval and !$portalPanties.state[_args[0]].new and $portalPanties.state[_args[0]].tempTimer lte 0>>
			<<set $portalPanties.message.resumed.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].tempRemoval to false>>
			<<if $debug is 1>><<run console.warn("Resumed!")>><</if>>
		<<elseif $portalPanties.state[_args[0]].new is 1>>
			<<set $portalPanties.message.entrance.push(_args[0])>>
			<<if (_relevantWetness gte (($portalPanties.state[_args[0]].size - 2) * 15) + random(1, 40) or random(1, 2) is 2)>><<set $portalPanties.state[_args[0]].new+=2>><<else>><<set $portalPanties.state[_args[0]].new++>><</if>>
			<<if $debug is 1>><<run console.warn("Entrance!")>><</if>>
		<<elseif $portalPanties.state[_args[0]].new is 2>>
			<<set $portalPanties.message.imminent.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].new++>>
			<<if $debug is 1>><<run console.warn("Imminent!")>><</if>>
		<<elseif $portalPanties.state[_args[0]].new is 3>>
			<<set $portalPanties.message.started.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].new to 0>>
			<<if $debug is 1>><<run console.warn("Started!")>><</if>>
		<<else>>
			<<if $portalPanties.state[_args[0]].owner is "pc">>
				<<set $portalPanties.message.continued.push(_args[0])>>
				<<if $debug is 1>><<run console.warn("Ongoing!")>><</if>>
			<<else>>
				<<if $portalPanties.state[_args[0]].timer lte 0>>
					<<set $portalPanties.message.finished.push(_args[0])>>
					<<if $debug is 1>><<run console.warn("Finished!")>><</if>>
				<<elseif $portalPanties.state[_args[0]].tempTimer lte 0>>
					<<set $portalPanties.message.continued.push(_args[0])>>
					<<if $debug is 1>><<run console.warn("Ongoing!")>><</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "portalPantiesDisplayMessage">>
	<<penetrationPainCalculate>>
	<<set _awareOfPenis to $awareness gte 300>>
	<<set $_entrance to $portalPanties.message.entrance>>
	<<set $_imminent to $portalPanties.message.imminent>>
	<<set $_started to $portalPanties.message.started>>
	<<set $_continued to $portalPanties.message.continued>>
	<<set $_finished to $portalPanties.message.finished>>
	<<set $_disappeared to $portalPanties.message.disappeared>>
	<<set $_resumed to $portalPanties.message.resumed>>
	<<set $_startedPlayerPenis to $_started.find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<set $_continuedPlayerPenis to $_continued.find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>

	<<set _portalArousalLevel to Math.min($portalPanties.state.vagina?.timer || 100, $portalPanties.state.anus?.timer || 100) / 6>>
	<<if _portalArousalLevel gte 4>>
		<<set _animspeed to "mid">>
	<<elseif _portalArousalLevel gte 3>>
		<<set _animspeed to "fast">>
	<<else>>
		<<set _animspeed to "vfast">>
	<</if>>

	<<if $_entrance.length>>
		<span class="purple">
			당신의 <<= formatList($_entrance.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>>【을를】 <<= ["쿡쿡 찌르는","이리저리 건드리는","입 맞추는","핥는"].random()>> 무언가가 느껴진다.
		</span>
		<br>
	<</if>>
	<<if $_imminent.length>>
		<span class="purple">
			침입물<<= $_imminent.length gt 1? "들이" : "이">> 당신의 <<= formatList($_imminent.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>> 안으로 밀고 들어오며 비집고 들어갈 틈을 찾는다.
		</span>
		<span class="red">
			<<= $_imminent.length gt 1? "그것들이" : "그것이">> 곧 파고들려 한다!
		</span>
		<br>
	<</if>>
	<<if $_started.length>>
		<<if $_started.includes("vagina")>><<vaginalstat>><</if>>
		<<if $_started.includes("anus")>><<analstat>><</if>>
		<span class="pink">갑자기
		<<set _portalPenisSize to Math.clamp(($portalPanties.state[$_started[0]].size or 0), 0, 6)>>
		<<if $portalPanties.state[$_started[0]].owner is "portal">>
			<<set _penisSize to ["아주 작은","작은","자그마한","","큰","거대한","괴물 같은"][_portalPenisSize]>>
		<<else>>
			<<set _penisSize to ["아주 작은","작은","자그마한","","큰","커다란","엄청난"][_portalPenisSize]>>
		<</if>>
		<<if _awareOfPenis>>
			<<print ($_started.length gt 1) ? `<<= _portalPenisSize is 3? ["신비한","낯선","정체 모를"].random(): _penisSize>> 자지들` : `<<= _portalPenisSize is 3? ["신비한","낯선","정체 모를"].random() : _penisSize>> 자지`>>
		<<else>>
			<<print ($_started.length gt 1) ? `<<= _portalPenisSize is 3? ["신비한","낯선","정체 모를"].random(): _penisSize>> 물체들` : `<<= _portalPenisSize is 3? ["신비한","낯선","정체 모를"].random() : _penisSize>> 물체`>>
		<</if>>
		【이가】 당신의 <<print formatList($_started.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>>【을를】 <<= ["꿰뚫는","침범하는","유린하는"].random()>> 것이 느껴지고<<if $_startedPlayerPenis>>, 동시에 당신의 자지가 갑자기 <<if _awareOfPenis>><<print ({vagina:"보지",anus:"항문"})[$_penisLocation]>> 안에<<else>>정체 모를 무언가에<</if>> 감싸이는 것도 느껴져<</if>> 당신은 깜짝 놀라 숨을 헐떡인다.</span><span class="lewd"> 갑작스러운 침입에 무릎이 꺾인다.</span><<ggarousal>>
		<br>
	<</if>>
	<<if $_continued.length>>
		<span class="lewd">
		<<if $portalPanties.asleep>>
			<<if $_started.includes("vagina")>><<vaginalstat>><</if>>
			<<if $_started.includes("anus")>><<analstat>><</if>>
			당신은 <<= ($_continued.length gt 1) ? "여러 개의" : "하나의">>
			<<if _awareOfPenis>>
				<<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_continued.length gt 1) ? "들" : "">>
			<<else>>
				<<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 물체<<print ($_continued.length gt 1) ? "들" : "">>
			<</if>>
		<<elseif !$_started.length>>
			<<if _awareOfPenis>>
				그 낯선 <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_continued.length gt 1) ? "들" : "">>
			<<else>>
				그 낯선 <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 물체<<print ($_continued.length gt 1) ? "들" : "">>
			<</if>>
		<<else>>
			<<= $portalPanties.overloaded? `<<= ($_continued.length gt 1) ? "여러" : "한">>` : "그">> 
			<<if _awareOfPenis>>
				<<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_continued.length gt 1) ? "들" : "">>
			<<else>>
				<<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 물체<<print ($_continued.length gt 1) ? "들" : "">>
			<</if>>
		<</if>>
		【이가】 <<= ($_continued.length gt 1) ? "동시에" : "">> <<= ["리드미컬하게","끊임없이","쉬지 않고","미친 듯이","간헐적으로"].random()>> 당신의 <<print formatList($_continued.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>> 안을 <<= ["찔러 대","쑤셔 대","두들겨 대"].random()>><<= $portalPanties.asleep ? "는 것을 느끼며 잠에서 깬다" : "고 있다">><<if $_continuedPlayerPenis>>, 바로 그때 당신의 자지도 <<if _awareOfPenis>><<print ({vagina:"보지",anus:"항문"})[$_penisLocation]>> 안으로<<else>>무언가의 안팎으로<</if>> 억지로 드나들게 된다<</if>>.</span><<garousal>>
		<br>
	<</if>>
	<<if $_finished.length>>
		<<if $_finished.includes("vagina")>><<vaginalejacstat>><</if>>
		<<if $_finished.includes("anus")>><<analejacstat>><</if>>
		<span class="purple">
		<<if _awareOfPenis>>
			<<= $portalPanties.overloaded? `<<= ($_finished.length gt 1) ? "여러" : "한">>` : "그">> <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_finished.length gt 1) ? "들" : "">>
		<<else>>
			<<= $portalPanties.overloaded? `<<= ($_finished.length gt 1) ? "여러" : "한">>` : "그">> <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 물체<<print ($_finished.length gt 1) ? "들" : "">>
		<</if>>
		【이가】 당신 안에서 <<= ($_finished.length gt 1) ? "일제히 " : "">>갑자기 제멋대로 부풀어 오르다가 <<= ["끈적한","진득한","축축한","미끈거리는"].random()>> 정액을 당신의 <<print formatList($_finished.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>> 안에 쏟아낸 뒤 사라진다.</span>
		<br>
		<<for _item range $_finished>>
			<<portalPantiesPortalCum _item>>
		<</for>>
	<</if>>
	<<if $_disappeared.length>>
		<span class="lblue">
		<<if _awareOfPenis>>
			그 <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_disappeared.length gt 1) ? "들" : "">>
		<<else>>
			그 <<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 물체<<print ($_disappeared.length gt 1) ? "들" : "">>
		<</if>>
		【이가】 당신의 <<print formatList($_disappeared.map(l => ({vagina:"보지",anus:"항문"})[l] || l))>> 안에서 <<= ($_disappeared.length gt 1) ? "일제히 " : "">>갑자기 사라진다. 공허함과 묘한 허탈감이 함께 밀려온다.</span>
		<br>
	<</if>>
	<<if $_resumed.length>>
		<span class="purple">
		익숙한 감각이 되살아난다. 그
		<<if _awareOfPenis>>
			<<= ["탐욕스러운","굶주린","침입하는","유린하는","덮쳐 오는"].random()>> 자지<<print ($_resumed.length gt 1) ? "들" : "">>
		<<else>>
