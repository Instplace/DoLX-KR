<<if $settings.pubicHairEnabled and ($pbwax gte 1 or $pbwaxballs gte 1)>>
	<<waxStatus "compact">>
<</if>>
<<if $settings.pubicHairEnabled and ($pblevel gte 2 or $pbstrip gte 1 or $pblevelballs gte 2)>>
	<<bathroomicon "shave">><<link [[음모를 정리한다|Flats Poppy Shave]]>><</link>>
	<br>
<</if>>
<<if $settings.pubicHairEnabled and $waxKits gte 1 and ($pblevel gte 3 or ($player.ballsExist and $pblevelballs gte 3))>>
	<<cosmeticsicon "wax">><<link [[음모를 왁싱한다|Wax Pubic Hair]]>><<set $phase2 to 0>><<set $bathroomExit to "Flats Poppy Bathroom">><</link>>
	<br>
<</if>>
<<pregnancyTest "Flats Poppy Bathroom">>
<br>
<<poppyFlatContents>>
<</if>>

