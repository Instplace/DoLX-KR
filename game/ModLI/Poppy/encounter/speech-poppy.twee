:: Widgets speech-Poppy [widget]
<<widget "speech-poppy">>
	<<set _npc_speech to true>>
	<<speechPool "Poppy" "noMouthAction">>
	<<set _virginityTarget to _args[0] or "Poppy">>
	<<set _poppy to statusCheck("Poppy")>>
	<<set _neckName to "">>
	<<set _poppyStatus to T.poppyStatus or "">>
	<<set _poppyLover to Number($poppyromance) gte 0>>
	<<set _poppyBreeding to $settings.pregnancySpeechEnabled and (playerCanBreedWith("Poppy") or NPCPregnancyPossibleWithPlayer("Poppy"))>>
	<<set _poppyPenisSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _poppyPenisSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _poppySpeech to "">>

	<<if $worn.neck and $worn.neck.name>>
		<<set _neckName to $worn.neck.name>>
	<</if>>

	<<if $speechpillreveal is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpillreveal to 0>>
		<<set _poppySpeech to either(
			`포피의 시선이 당신 손에 쥔 X-체인지 $xchangePillWord 쪽으로 향한다. "그걸로 뭘 할 생각이야, 내 보석?"`,
			`<<He>>【은는】 당신의 X-체인지 $xchangePillWord 쪽을 보다가 당신을 본다. "그냥 말하지 그랬어. 어쩌면 좋다고 했을지도 모르는데."`,
			`포피가 숨죽여 웃는다. "침대에 알약을 가져왔어? 넌 정말 뭐든 다 계획하는구나."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is "herm">>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<set _poppySpeech to either(
			`포피가 <<himself>>【을를】 내려다보며 눈을 깜빡인다. "둘 다? 음. 적응하는 데 시간이 좀 걸리겠네."`,
			`<<He>>【은는】 새 몸을 손으로 쓸어내리고, 꼬리가 살랑거린다. "하나만 못 고르겠어서 둘 다 줬어? 욕심쟁이."`,
			`포피가 떨리는 웃음을 흘린다. "급식소에서 누가 물어보면, 이건 네 아이디어였던 거야."`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<set _poppySpeech to either(
			`포피가 달라진 자기 몸을 잠시 바라보다가 당신을 보며 씩 웃는다. "그러니까 이런 모습이 네 취향이구나. 기억해 둘게."`,
			`<<He>>【은는】 손가락을 쥐었다 펴 보고 새로운 무게감을 가늠해 본다. "흠. 나쁘지 않네. 어떻게 다 돌아가는지 네가 알려 줘야겠어."`,
			`포피의 꼬리가 당신의 다리를 휘감는다. "먼저 말해 줬으면 좋았잖아, 자기야. 이제 책임져야 해."`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>

	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is _virginityTarget) or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is _virginityTarget)>>
		<<addSpeechLine "virginity">>
		<<if _poppyPenisSize gte 5 and $speechVaginaVirgin is 1>>
			<<set _poppySpeech to either(
				`<<He>>【은는】 멈추고, 당신의 숨이 가라앉을 때까지 머리카락을 쓰다듬는다. "처음인데, 하필 나라니. 천천히, 내 보석. 밤새 시간은 충분해."`,
				`포피가 가만히 있다가 당신의 이마에 입을 맞춘다. "숨 쉬어. 난 어디 안 가, 너도 마찬가지고."`
			)>>
		<<else>>
			<<set _poppySpeech to either(
				`<<He>>【은는】 숨을 들이켜다가 씩 웃는다. "나를 위해 아껴 둔 거야? 영광인데, 자기야."`,
				`포피가 굳어 버린다. "말을 안 했잖아... 알았으면 초라도 켜 놨을 텐데."`,
				`<<He>>【은는】 당신의 목에 대고 부드럽게 웃는다. "나는 첫 경험들이 전부 엉망이었거든. 네 첫 경험이 마음 써 주는 사람이랑이라 다행이야."`
			)>>
		<</if>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 3>><<gglust>>
		<<if _poppy and _poppy.love gte 40>>
			<<npcincr Poppy love 5>><<gglove>>
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is _virginityTarget>>
		<<addSpeechLine "virginity">>
		<<set _poppySpeech to either(
			`<<He>>【은는】 몸을 떨며, 너무 기뻐 보이지 않으려는 듯 미소 짓는다. "넌 놀라운 구석이 참 많네, 내 보석."`,
			`포피가 당신의 골반께를 천천히 원을 그리며 문지른다. "날 위해 힘 빼. 긴장하면 더 힘들어질 뿐이야."`,
			`<<He>>【은는】 당신 위로 몸을 숙이고, 꼬리가 당신의 등을 스친다. "너무 힘들면 말해 줘. 진심이야."`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 2>><<gglust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is _virginityTarget>>
		<<addSpeechLine "virginity">>
		<<set _poppySpeech to either(
			`<<He>>【은는】 엄지로 당신의 뺨을 쓸어 준다. "좋아. 계속해. 이러고 있는 네 모습이 사랑스러워."`,
			`포피가 당신의 얼굴에서 머리카락을 쓸어 넘겨 준다. "천천히 해. 점수 매기는 사람 없으니까."`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 2>><<gglust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is _virginityTarget>>
		<<addSpeechLine "virginity">>
		<<set _poppySpeech to either(
			`<<He>>【은는】 눈을 깜빡이다가 부드럽게 웃는다. "첫 키스도 나랑 한 거야? 자꾸 소유욕이 생기잖아."`,
			`포피가 손끝으로 당신의 입술을 짚는다. "그게 처음이었어? 그럼 다음 키스는 보람 있게 만들어야겠네."`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy love 3>><<gglove>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
		<<set _poppySpeech to either(
			`포피의 눈썹이 올라간다. "둘 다? 어머, 나한테 비밀이 있었네."`,
			`<<He>>【은는】 숨기지 않는 관심으로 당신을 훑어본다. "그렇군. 그럼 가지고 놀 게 훨씬 많아지네."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
		<<set _poppySpeech to either(
			`포피가 잠시 멈췄다가 미소 짓는다. "그 안에 이런 게 있을 줄은 몰랐네. 불만은 없어."`,
			`<<He>>【은는】 고개를 갸웃한다. "옷 참 예쁘게 입네. 안에 뭐가 있든 내가 신경 쓸 거라고 생각했어?"`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressDisappointed is 1>>
		<<addSpeechLine "reveal">>
		<<set _poppySpeech to either(
			`포피가 눈을 깜빡이다가 어깨를 으쓱한다. "아. 음, 다른 걸 기대하긴 했는데, 그래도 넌 너니까."`,
			`<<He>>【은는】 "흠" 하고 소리를 낸다. "예상과는 다르네. 적응하면 되지. 난 늘 그래 왔으니까."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechLINameDrop is 1>>
		<<addSpeechLine "namedrop">>
		<<set $speechLINameDrop to 0>>
		<<switch _loveInterest>>
			<<case "Whitney">>
				<<He>>【은는】 눈을 가늘게 뜬다. "휘트니? 정말? 지금 네가 생각하는 게 그 애야?"<<npcincr Poppy patience -1>><<lpatience>>
			<<case "Gwylan">>
				<<He>>【은는】 얼굴을 찡그린다. "그 목줄 마녀? 흠. <<nnpc_hes "Gwylan">> 안목은 있나 보네."
			<<case "Robin">>
				<<He>>【은는】 흠, 하고 소리를 내지만 미소가 굳어진다. "로빈은 착해 보이던데. 그래도 난 네가 내 이름을 말해 줬으면 좋겠어."
			<<case "Kylar">>
				<<He>>【은는】 몸이 뻣뻣하게 굳는다. "카일라. 그래. 나랑 있을 땐 그 사람 얘기는 하지 말자."<<npcincr Poppy lust -15>><<lllust>><<npcincr Poppy patience -1>><<lpatience>>
			<<case "Avery">>
				<<He>>【은는】 짧고 날카롭게 웃는다. "에이버리? 조심해, 내 보석. 나도 경쟁심이 생길지 몰라."<<npcincr Poppy lust 2>><<gglust>>
			<<case "Eden">>
				<<He>>【은는】 고개를 갸웃한다. "에덴? 넌 참 별난 곳에서 골칫거리를 찾아내."
			<<case "Bailey">>
				<<set _poppySpeech to either(
					`<<He>>【은는】 움직임을 완전히 멈춘다. "내 침대에 누워서 베일리 이름을 입에 올려? <<nnpc_He "Bailey">>【은는】 아무도 돌봐 주지 않을 때 날 돌봐 줬어. 감히 <<nnpc_him "Bailey">>【을를】 침실 농담거리로 만들 생각은 하지 마."`,
					`포피의 미소가 사라진다. "베일리라니. 진심이야?" <<He>>【은는】 당신의 턱을 붙잡는다. "이 일에 <<nnpc_him "Bailey">>【을를】 끌어들이지 마. <<nnpc_He "Bailey">>【은는】 네가 아는 것보다 훨씬 많은 걸 나한테 해 줬어. 나랑 있는 동안 <<nnpc_him "Bailey">>【을를】 조롱하게 두진 않을 거야."`,
					`<<He>>【은는】 물러나 당신을 빤히 쳐다본다. "그 이름을 또 그런 식으로 말하면 화나는 상대는 네가 될 거야."`
				)>>
				<<print _poppySpeech>><<npcincr Poppy lust -15>><<lllust>><<npcincr Poppy patience -2>><<lpatience>>
			<<case "Sydney">>
				<<He>>【은는】 조금 슬프게 미소 짓는다. "꼬마 시드니? 나도 한때는 <<nnpc_him "Sydney">>【와과】 같았어. <<nnpc_him "Sydney">>한테 다정하게 대해 줘."
			<<case "Black Wolf" "Great Hawk">>
				<<He>>【은는】 코를 찡그린다. "난 이미 반은 짐승이잖아, 자기야. 그걸로는 부족해?"
			<<default>>
				<<He>>【은는】 더 가까이 붙는다. "누구를 생각하고 있든, 그만해. 나랑 여기 있어, 내 보석."
		<</switch>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
		<<set $speechNoticeSexToy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<set _poppySpeech to either(
			`<<He>>【은는】 당신의 $_sexToy 쪽을 보며 미소 짓는다. "장난감까지 쓰는 거야? 정말 날 응석받이로 만들려는 거네."`,
			`포피가 손가락으로 당신의 $_sexToy 쪽을 톡 건드린다. "그거 씻었어? 걱정돼서 묻는 거야."`,
			`<<He>>【이가】 웃는다. "지원군까지 데려왔네. 기분 나빠해야 해, 감탄해야 해?"`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 2>><<gglust>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechcondomremoved>>
		<<addSpeechLine "condomRemoved">>
		<<if _poppyBreeding>>
			<<set _poppySpeech to either(
				`포피가 당신이 콘돔을 옆으로 던지는 것을 보고 아주 조용해진다. "무슨 일이 생길 수 있는지 알잖아. 정말 괜찮아, 내 보석?"`,
				`<<He>>【은는】 머뭇거리다가 씩 웃는다. "콘돔 없이? 아주 용감하거나 아주 어리석거나 둘 중 하나네. 난 둘 다 좋아."`,
				`<<He>>【은는】 당신의 턱을 붙잡는다. "새끼들이 생기면 너 혼자 키우게 두지 않을 거야. 알고 있지?"`
			)>>
		<<else>>
			<<set _poppySpeech to either(
				`콘돔이 바닥에 떨어지자 포피가 눈썹을 치켜올린다. "성급하기도 하지, 우리."`,
				`<<He>>【이가】 웃는다. "알았어, 알았어. 우리 사이에 아무것도 없네. 이제 만족해?"`,
				`<<He>>【은는】 그것이 날아가는 것을 지켜보다가 미소 지으며 고개를 젓는다. "일주일 뒤에 침대 밑에서 발견하겠네."`
			)>>
		<</if>>
		<<print _poppySpeech>>
		<<if $speechcondomremoved is "sabotaged">>
			<span class="blue"><<He>>【은는】 콘돔이 이미 망가져 있었다는 말은 하지 않는다.</span>
		<</if>>
		<<npcincr Poppy lust 5>><<gglust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLegLock is 1>>
		<<addSpeechLine "legLock">>
		<<if _poppyBreeding>>
			<<set _poppySpeech to either(
				`당신의 다리가 <<him>>【을를】 휘감자 포피가 숨을 멈칫한다. "그렇게 붙잡으면 난 안 빼."`,
				`<<He>>【은는】 숨 가쁘게 웃는다. "내 보석한테 붙잡히다니. 정말 날 안에 두고 싶은 거지?"`
			)>>
		<<else>>
			<<set _poppySpeech to either(
				`당신의 다리가 <<him>>【을를】 감싸자 포피가 씩 웃는다. "잡혔네. 어차피 어디 갈 생각도 없었어."`,
				`<<He>>【은는】 당신의 품에 몸을 기댄다. "오늘따라 달라붙네. 난 괜찮아."`
			)>>
		<</if>>
		<<print _poppySpeech>>
		<<npcincr Poppy lust 5>><<gglust>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechscratch is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechscratch to 0>>
		<<if _poppyLover>>
			<<set _poppySpeech to either(
				`포피가 할퀸 자국에 숨을 쉭 들이켜다가 웃는다. "발톱이야, 자기야? 좋아, 대신 나중에 네가 연고 발라 줘."`,
				`<<He>>【은는】 팔에 난 붉은 줄들을 바라본다. "내일 급식소에서 반팔을 입어야 한다는 거 알고 있어?"`
			)>>
			<<npcincr Poppy lust 3>><<glust>>
		<<else>>
			<<set _poppySpeech to either(
				`포피가 할큄에 움찔 물러난다. "하지 마. 할퀴는 건 이제 지긋지긋해."`,
				`<<He>>【은는】 당신의 손목을 붙잡는다. "진정해. 쫓기는 게 어떤 건지 알아. 여기서까지 그런 기분을 들게 하지 마."`
			)>>
			<<npcincr Poppy patience -1>><<lpatience>>
		<</if>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechPlayerHits to 0>>
		<<set _poppySpeech to either(
			`포피가 당신이 때린 곳을 문지른다. "아야. 그만하라고 하고 싶었으면 말로 해도 되잖아."`,
			`<<He>>【은는】 화가 났다기보다 상처받은 얼굴로 당신을 바라본다. "내가 뭐 잘못했어?"`
		)>>
		<<print _poppySpeech>>
		<<npcincr Poppy patience -1>><<lpatience>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAskRough is 1>>
		<<addSpeechLine "askRough">>
		<<set $speechAskRough to 0>>
		<<set _poppySpeech to either(
			`포피가 웃는다. "더 거칠게? 정말이야? 널 위해서 봐주고 있었는데."`,
			`<<He>>【은는】 당신의 골반을 쥔 손에 힘을 준다. "그렇게 예쁘게 부탁했으니까."`,
			`<<His>> 눈이 장난스럽게 가늘어진다. "내일 앉지도 못하게 됐다고 나한테 울면서 오지 마."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlead is 1 and $consensual is 1>>
		<<addSpeechLine "plead">>
		<<set _poppySpeech to either(
			`포피가 곧바로 속도를 늦춘다. "너무 버거워? 알았어. 필요한 게 뭔지 말해 줘."`,
			`<<He>>【은는】 움직임을 멈추고 당신의 얼굴을 감싼다. "저기, 저기. 듣고 있어."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechMoan is 1 and random(1, 2) is 1>>
		<<addSpeechLine "moan">>
		<<set _poppySpeech to either(
			`포피가 씩 웃는다. "더 크게. 이웃들은 벌써 우리 사이를 다 알아."`,
			`<<He>>【은는】 당신의 귀를 살짝 깨문다. "다시 말해 봐. 듣는 거 좋아."`,
			`포피의 꼬리가 시트 위를 탁탁 친다. "너 때문에 내 이름도 잊겠어."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>

	<<if $combatgoal is "strip" and $rng lte 25>>
		<<addSpeechLine "strip">>
		<<set _poppySpeech to either(
			`포피가 당신의 옷을 잡아당긴다. "이거 귀엽긴 한데, 방해돼."`,
			`<<He>>【은는】 습관처럼 당신의 옷을 팔에 걸쳐 갠다. "자. 이제 제대로 보이네."`,
			`포피가 단추 하나를 풀어낸다. "가만히 있어. 찢진 않을 거야. 어차피 내가 꿰매야 하니까."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>

	<<if $speechExposeGenitals is 1 and playerChastity()>>
		<<addSpeechLine "expose">>
		<<set _poppySpeech to either(
			`포피가 당신의 <<printChastity>> 쪽을 보고 얼굴을 찌푸린다. "누가 너한테 그걸 채웠어? 베일리라면 알아야겠어."`,
			`<<He>>【은는】 당신의 <<printChastity>> 위를 톡 두드린다. "네가 원해서 한 건 아닌 것 같네. 벗겨 줄까?"`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>

	<<if !($speechSaidLines?.Poppy or []).some(entry => entry.category is "chastity") and $worn.neck and ($worn.neck.collared is 1 or _neckName is "familiar collar" or _neckName.includes("Whitney's collar"))>>
		<<addSpeechLine "chastity">>

			<<if _neckName.includes("Whitney's collar")>>
				<<if typeof $poppyromance is "number" and $poppyromance gte 0>>
					<<He>>【은는】 당신이 하고 있는 목줄을 알아보고 묘한 표정을 짓는다. "휘트니의... 장난감?" <<He>>【이가】 비난 섞인 어조로 묻는다. "진짜야..."
					<br><br>
					포피가 주머니에 손을 넣어 주머니칼을 꺼낸다. 손목을 한 번 휙 꺾자 목줄이 끊어진다.
					<br><br>
					<<He>>【은는】 목줄을 홱 잡아당겨 벗겨 내 주머니에 쑤셔 넣는다. "다시는 그거 하지 마. 알아들었어?"
					<<run V.worn.neck = clone(setup.clothes.neck.find(c => c.name === "naked") || setup.clothes.neck[0])>>
					<<npcincr Poppy patience -2>><<lpatience>>
				<<else>>
					<<He>>【은는】 당신이 하고 있는 목줄을 알아보고 묘한 표정을 짓는다. "휘트니의... 장난감?" <<He>>【이가】 비난 섞인 어조로 묻는다. "네가 그런 취향인 줄도, 그 문제아랑 그렇게 가까운 줄도 몰랐네. 네가 행복하다면 뭐, 어쩔 수 없지."
					<br><br>
					포피가 주머니에 손을 넣어 주머니칼을 꺼낸다. 손목을 한 번 휙 꺾자 목줄이 끊어진다. <<He>>【은는】 목줄을 홱 잡아당겨 벗겨 내 주머니에 쑤셔 넣는다. "다시는 그거 하지 마. 알아들었어?"
					<<run V.worn.neck = clone(setup.clothes.neck.find(c => c.name === "naked") || setup.clothes.neck[0])>>
					<<npcincr Poppy patience -2>><<lpatience>>
				<</if>>

			<<elseif _poppyStatus.includes("LowPatience")>>
				<<He>>【은는】 당신 목의 목줄을 노려보며 확연히 불쾌해한다. <<He>>【은는】 이를 악물고 주먹을 쥔다. 당장이라도 달려들 것 같지만, 끝내 그러지는 않는다.
				<br>
				포피가 코웃음을 치며 눈을 굴리고 시선을 돌린다.
				<<npcincr Poppy patience -6>>
				<<if C.npc.Poppy and C.npc.Poppy.patience gte 0>>
					<<lllpatience>>
				<<else>>
					<<ggganger>>
				<</if>>

			<<elseif _neckName is "familiar collar">>
				<<if typeof $poppyromance is "number" and $poppyromance gte 0>>
					<<He>>【은는】 당신이 하고 있는 사역마 목줄을 알아본다. "그 목줄... 우리 집에 올 때는 그윌란한테 풀어 달라고 말해 줄 수 있어? 그럼 기쁠 것 같아."<<npcincr Poppy patience -2>><<lpatience>>
				<<else>>
					<<He>>【은는】 당신이 하고 있는 사역마 목줄을 알아본다. "어! 그윌란의 사역마야? 잘됐네. 나도 전에 <<nnpc_him "Gwylan">>【와과】 마주친 적이 있어. <<nnpc_Hes "Gwylan">> 꽤 괜찮은 사람이더라."
				<</if>>

			<<else>>
				<<He>>【은는】 당신이 하고 있는 목줄을 알아보고 묘한 표정을 짓는다. "네가 그런 취향인 줄은 몰랐네." <<He>>【은는】 어색하게나마 억지로 미소를 짓는다.
			<</if>>

		<</addSpeechLine>>
	<</if>>

	<<if $speechMouthPenetrated is 1 and random(1, 3) is 1>>
		<<addSpeechLine "oral">>
		<<if _poppyPenisSize gte 5>>
			<<set _poppySpeech to either(
				`포피의 손이 당신의 머리카락 속에 내려앉지만 밀어붙이지는 않는다. "억지로 하지 마. 코로 숨 쉬어."`,
				`<<He>>【은는】 걱정스럽게 살짝 인상을 쓰고 당신을 지켜본다. "너무 힘들어? 언제든 멈춰도 돼."`
			)>>
		<<else>>
			<<set _poppySpeech to either(
				`포피가 한숨을 쉬며 뒤로 몸을 기댄다. "음. 점점 잘하네."`,
				`<<He>>【은는】 당신의 머리카락 사이로 손가락을 빗어 넘긴다. "날 올려다봐. 그래, 그 표정이 보고 싶었어."`,
				`포피의 꼬리가 나른하게 흔들린다. "서두를 것 없어, 내 보석. 경치를 즐기고 있으니까."`
			)>>
		<</if>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if ($speechVaginaPenetrated is 1 or $speechAnusPenetrated is 1) and random(1, 3) is 1>>
		<<addSpeechLine "penetrated">>
		<<if _poppyPenisSize gte 5>>
			<<set _poppySpeech to either(
				`포피가 당신이 적응할 수 있게 가만히 있는다. "알아. 알아. 그냥 숨 쉬어."`,
				`<<He>>【은는】 당신의 어깨에 입을 맞춘다. "날 정말 잘 받아들이네. 천천히, 자."`
			)>>
		<<elseif _poppyBreeding>>
			<<set _poppySpeech to either(
				`포피가 이마를 당신의 이마에 맞댄다. "계속 이렇게 하면 어떻게 될지 알지?"`,
				`<<He>>【은는】 당신의 목에 대고 웃는다. "우리가 좋은 가족이 될 수 있을까? 아직은 대답하지 마."`
			)>>
		<<else>>
			<<set _poppySpeech to either(
				`포피가 숨을 멈칫한다. "너무 좋아. 감히 멈추지 마."`,
				`<<He>>【은는】 당신의 얼굴에서 머리카락 한 가닥을 쓸어 넘긴다. "거기 있었네. 하루 종일 이 순간을 기다렸어."`,
				`포피가 씩 웃는다. "내가 지금 어디 있는지 알면 베일리가 길길이 날뛸 거야."`
			)>>
		<</if>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if ($speechHandjobPenis is 1 or $speechHandjobVagina is 1) and random(1, 3) is 1>>
		<<addSpeechLine "touch">>
		<<set _poppySpeech to either(
			`포피가 콧노래를 흥얼거린다. "손이 따뜻하네. 거기 그대로 둬."`,
			`<<He>>【은는】 당신의 손을 붙잡아 이끈다. "조금만 더 천천히. 그래, 거기."`,
			`포피가 몸을 비튼다. "내가 어디가 간지러운지 정확히 알고 있지, 그렇지?"`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerOrgasm is 1 and random(1, 2) is 1>>
		<<addSpeechLine "playerOrgasm">>
		<<set _poppySpeech to either(
			`포피가 당신의 땀에 젖은 이마에 입을 맞춘다. "자. 좋지 않았어?"`,
			`<<He>>【은는】 당신이 몸을 떠는 것을 보며 부드럽게 웃는다. "어머, 이 모습 좀 봐. 내 보석이 완전히 흐트러졌네."`,
			`포피가 당신이 가라앉는 동안 등을 쓰다듬는다. "천천히 해. 내가 있잖아."`
		)>>
		<<print _poppySpeech>>
		<</addSpeechLine>>
	<</if>>

	<<if _silent isnot 1>>
		<<addSpeechLine "idle">>
			<<set $poppysexcycle to $poppysexcycle or 0>>
			<<switch $poppysexcycle>>
				<<case 0>>
					"너랑 이러는 거 정말 좋아. 너무 좋아." <<he>>【이가】 속삭인다.
				<<case 1>>
					"네가 내는 소리, 귀여워." <<he>>【이가】 씩 웃으며 말한다.
				<<case 2>>
					"여기가 네가 제일 좋은 곳이야, 자기야?" <<he>>【이가】 묻는다.
				<<case 3>>
					"아침까지도 계속할 수 있겠어." <<he>>【이가】 숨을 헐떡이며, 즐거운 듯 말한다.
				<<case 4>>
					<<if !$settings.pregnancySpeechEnabled>>
						"네 옆에서 눈 뜨는 거, 익숙해질 수 있을 것 같아." <<he>>【이가】 말한다.
					<<elseif $awarelevel gte 5>>
						"우리한테 아기 여우가 생기면, 너만큼 귀여웠으면 좋겠어." <<he>>【이가】 말한다.
					<<else>>
						"우리한테 아기가 생기면, 너만큼 귀여웠으면 좋겠어." <<he>>【이가】 말한다.
					<</if>>
				<<case 5>>
					"곁에 있어, 내 보석. 네 반응 하나하나 다 느끼고 싶어." <<he>>【이가】 속삭인다.
				<<case 6>>
					"이제 너한테서 내 향수 냄새가 나." <<he>>【이가】 당신의 목에 코를 비비며 말한다. "좋아."
				<<case 7>>
					"지금은 아무도 나한테 뭘 해 달라고 하지 않네." <<he>>【이가】 한숨을 쉰다. "너만 빼고. 너는 괜찮아."
				<<case 8>>
					"예전엔 이게 죄라고 생각했어." <<he>>【이가】 비스듬한 미소를 지으며 말한다. "타락한 건 후회 안 해."
				<<case 9>>
					"급식소 사람들한테는 이거 말하지 마." <<he>>【이가】 말한다. "평생 놀림당할 테니까."
				<<case 10>>
					"꼬리가 제멋대로 날뛰네. 신경 쓰지 마." <<he>>【이가】 웃는다.
				<<default>>
					"이게 멈추지 않았으면 좋겠어." <<he>>【이가】 숨을 내쉬며 말한다.
			<</switch>>
			<<set $poppysexcycle to ($poppysexcycle + 1) % 12>>
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "idle">>
			아... 읏! <<he>>【이가】 헐떡인다.
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>
