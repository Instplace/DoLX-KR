:: Bailey Seen Widget [widget]
<<widget "baileySeenAdd">><<set $baileySeen.pushUnique(_args[0])>><</widget>>

<<widget "homeeventbaileypilled">>
	<<endevent>>
	<<npc Bailey>><<person1>>
	<<switch random(1, 3)>>
		<<case 1>>
			베일리의 사무실 문이 살짝 열려 있다. 틈새로 <<baileyTitleNarration>>【이가】 책상 뒤 작은 거울 앞에 서 있는 모습이 보인다. 장부는 잊은 채 한쪽 팔에 끼워져 있다.
			<<He>>【은는】 몸을 살짝 한쪽으로, 다시 반대쪽으로 돌리며, 돈이 될 만한 것이라면 무엇에든 보내는 그 무덤덤하고 값을 매기는 눈초리로 낯선 몸을 살핀다.
			<br><br>
			<<His>> 눈이 거울 속에서 당신의 눈과 마주친다. "집세는 아직 안 냈어." 돌아보지도 않고 <<he>>【이가】 말한다. 문이 닫힌다.
		<<case 2>>
			베일리가 홀의 탁자 앞에 서서 지폐 뭉치를 세고 있다. 중간쯤에서 <<he>>【이가】 멈춘다.
			<<He>>【은는】 손가락을 펼쳐 쥐었다 폈다 하고, 새 외투에 길들이는 사람처럼 어깨를 돌린다. 그러고는 멈췄던 바로 그 자리부터 아까보다 빠르게 다시 센다.
			<br><br>
			새 몸에 대해 베일리가 어떤 결론을 내리고 있든, <<he>>【은는】 그것을 입 밖에 내지 않는다.
		<<case 3>>
			<<generateyv2>>저만치 앞에서 베일리가 <<person2>><<person>>【을를】 불러 세워 지시를 내린다.
			흘러나온 목소리는 이곳 사람들이 두려워하며 자란 그 목소리가 아니어서, <<person>>【은는】 한동안 눈만 끔벅인다.
			<br><br>
			<<person1>>베일리는 그 소리를 가늠해 보는 듯 잠시 멈춘다. 이내 <<he>>【이가】 더 무미건조하게 같은 명령을 되풀이하자, <<person2>><<person>>【은는】 허둥지둥 따른다.
			<<person1>>미소라고 하기엔 모자란 무언가가 베일리의 얼굴을 스친다. 새 목소리도 충분히 먹힌다.
	<</switch>>
	<br><br>
	<<link [[다음|Orphanage]]>><<endevent>><</link>>
	<br>
<</widget>>


:: Bailey Kiss Virginity Widget [widget]

/* Bailey taking the PC's first kiss. Elated at Stockholm 3+, mortified otherwise.
Renders nothing if the kiss virginity is already gone. */
<<widget "baileyKissVirginity">>
	<<takeNPCVirginity "Bailey" "kiss" "pc">>
	<<if $player.virginity.kiss is true>>
		<br><br>
		<<if $syndromeBaileyBuild gte 3>>
			<span class="pink">베일리가 당신의 첫 키스를 가져가자 기쁨에 들뜬다.</span><<arousal 500>><<garousal>>
		<<else>>
			<span class="red">베일리가 당신의 첫 키스를 가져가 수치스러운 기분이 든다.</span><<arousal 100>><<garousal>><<stress 6>><<gstress>><<trauma 6>><<gtrauma>>
		<</if>>
		<<takeVirginity "Bailey" "kiss">>
	<</if>>
<</widget>>

/* Bailey taking the PC's first handhold. Elated at Stockholm 1+, mortified otherwise.
Renders nothing if the handholding virginity is already gone.
Call sites own their own spacing. */
/* Pass false where the surrounding passage already takes the virginity itself. */
<<widget "baileyHandholdText">>
	<<set _first to _args[0] isnot false>>
	<<if $syndromeBaileyBuild gte 1>>
		<span class="lewd">베일리의 손을 <<if _first>>처음으로 <</if>>잡고 있자니 기쁨에 들뜬다.</span><<arousal 500>><<garousal>>
	<<else>>
		<span class="red">베일리의 손을 <<if _first>>처음으로 <</if>>잡고 있자니 수치스럽다.</span><<stress 40>><<ggstress>>
	<</if>>
<</widget>>

<<widget "baileyHandholdVirginity">>
	<<takeNPCVirginity "Bailey" "handholding" "pc">>
	<<if $player.virginity.handholding is true>>
		<<baileyHandholdText>>
		<<if /glove|mitten/.test($worn.hands.name)>>
			<span class="blue">$worn.hands.name【을를】 끼고 있어서 <<nnpc_his "Bailey">> 살갗이 닿는 감촉이 제대로 느껴지지 않는다. 첫 경험으로 치지 않는다.</span>
		<<else>>
			<<takeVirginity "Bailey" "handholding">>
			<<if $innocencestate is 1>>
				<br><br><span class="red">잠깐... 손을 잡으면 아기가 생기는 거 아니었나? 공포가 파도처럼 밀려온다.</span><<stress 25>><<gstress>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>


:: Bailey Brat Tax [widget]

/* Weekly Brat Tax. Accrue with <<baileyBrat N "reason">> */

<<widget "baileyBrat">>
	<<set _bratBefore to $baileyBrat.points>>
	<<set $baileyBrat.points to Math.clamp($baileyBrat.points + _args[0], 0, 20)>>
	<<run $baileyBrat.reasons.pushUnique(_args[1])>>
	<<set _bratGained to ($baileyBrat.points - _bratBefore) * Math.floor($rentMoney / 10)>>
	<<gbrattax _bratGained>>
<</widget>>

/* $baileyBratTax = points * 1/10 of current rent. Call beside <<babyRent>>. */
<<widget "bratTaxCalc">><<set $baileyBratTax to $baileyBrat.points * Math.floor($rentMoney / 10)>><</widget>>

<<widget "bratTaxDisplay">><<bratTaxCalc>><<if $baileyBratTax>><<print _args[0]>><<printmoney $baileyBratTax _args[2]>><<print _args[1]>><</if>><</widget>>

<<widget "baileyOfferSettleRent">>
	/* Recompute rather than trusting $baileyBratTax: not every path in announces the tax first. */
	<<bratTaxCalc>>
	<<set _loanSurcharge to (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0)>>
	<<set _offerRentDue to $rentMoney + ($babyRent or 0) + $baileyBratTax + _loanSurcharge>>
	<<set _offerDeposit to Math.min(Math.max($baileyDeposit or 0, 0), _offerRentDue)>>
	<<set _offerCashDue to _offerRentDue - _offerDeposit>>
	<<set _offerCashBefore to $money>>
	<<if $money lt _offerCashDue>><<baileyBankDraw `_offerCashDue - $money`>><</if>>
	<<if $money gt _offerCashBefore>><br><br><</if>>
	<<set _offerRentPaid to $money gte _offerCashDue>>
	<<if _offerRentPaid>>
		<<set $baileyDeposit -= _offerDeposit>>
		<<if _offerCashDue gt 0>><<money `-_offerCashDue` "baileyRent">><</if>>
	<</if>>
	<<set $baileydefeatedchain to 0>>
	/* Only wipe the arrears if the money actually changed hands. */
	<<if _offerRentPaid>>
		<<set $baileyBrat to { points: 0, reasons: [] }>><<set $baileyBratTax to 0>>
		<<set $baileyRefusedToPay to 0>>
		<<set $baileyRefusedToPayTotal to $baileyRefusedToPayTotal lt _offerRentDue ? 0 : $baileyRefusedToPayTotal - _offerRentDue>>
		<<if $bailey_confiscation>><<run baileyConfiscationRestore()>><</if>>
		<<if _loanSurcharge gt 0>><<run setup.hbsc.collectLoanFromRent(_loanSurcharge)>><</if>>
		<<if setup.inflation and setup.inflation.advanceRentPressure>><<run setup.inflation.advanceRentPressure()>><</if>>
		<<set $rentMoney to [10000,30000,50000,70000,100000,150000,200000][Math.clamp($rentStage,1,6)]>>
		<<rentmod>>
		<<set $rentStage += 1>>
	<</if>>
	<<unset $bailey_encroach>>
<</widget>>

<<widget "bratReasonList">>
	<<set _phrases to ($baileyBrat ? $baileyBrat.reasons : []).map(function (r) {
		var him = C.npc.Bailey.pronoun === "m" ? "him" : "her";
		var his = C.npc.Bailey.pronoun === "m" ? "his" : "her";
		switch (r) {
			case "papers":  return "신분증을 훔치려 한 일";
			case "bill":    return "베일리에게 저녁값을 내게 한 일";
			case "chair":   return "베일리의 의자에서 자위하다 들킨 일";
			case "whitney_desk": return "베일리의 책상 위에서 휘트니와 놀아난 일";
			case "stoodup": return "베일리에게 데이트를 신청해 놓고 바람맞힌 일";
			case "gala_steal": return "베일리의 파티에서 도둑질하다 들킨 일";
			case "gala_scene": return "베일리의 파티에서 소란을 피운 일";
			case "gala_expose": return "베일리의 파티에서 베일리의 정체를 폭로하려 한 일";
			case "seducebeat": return "베일리를 유혹해 놓고 두들겨 팬 일";
			case "vent_blame": return "자기 문제를 베일리 탓으로 돌린 일";
			case "vent_fight": return "베일리를 두들겨 패고 달아난 일";
			case "monogamy_refused": return "의무를 이행하겠다고 동의해 놓고 거부한 일";
			case "pounce": return "베일리의 집 복도에서 베일리를 덮친 일";
			default:        return r;
		}
	})>>
	<<print formatList(_phrases, "and")>>
<</widget>>

:: Bailey Combat Widgets [widget]

<<widget "bodywriting_npc_bailey">>
	<<if $npc.includes("Bailey") and $NPCList and $NPCList[0] and $NPCList[0].fullDescription>>
		<<set $_text_output to "">>
		<<set _bwEntry to $skin[_args[0]]>>
		<<set _bwOwner to (_bwEntry && _bwEntry.owner) ? _bwEntry.owner : "">>
		<<if !_bwOwner>>
			<<set _bwExisting to Object.values($skin).find(s => s && s.owner === "Bailey")>>
			<<if _bwExisting and !(_bwExisting.writing and _bwExisting.writing.startsWith("£"))>>
				<<set _bwOwner to "Bailey">>
				<<set _bwEntry to _bwExisting>>
			<</if>>
		<</if>>

		<<if _bwOwner is "Bailey">>
			<<if $syndromeBailey>><<set $_text_output to `<<He>> has a fierce look in <<his>> eyes. "That's right. Mine."`>>
			<<elseif C.npc.Bailey.dom gte 70>><<set $_strings to [
					`<<He>>【이가】 으르렁거린다. "그걸 또 누가 봤지?"`,
					`<<He>>【이가】 으르렁거린다. "<<goodGirl>>."`,
					`<<His>> 눈이 타오른다. "내 거야."`,
				]>><<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
			<<elseif C.npc.Bailey.dom lte 30>><<set $_text_output to `<<He>> scoffs. "Don't you forget it."`>>
			<<else>><<set $_strings to [
					`<<He>>【이가】 중얼거린다. "네 자리에 있군."`,
					`<<He>>【이가】 엄지로 그것을 문지른다. "그거 씻어내지 마."`,
					`<<He>>【은는】 아무 말도 하지 않는다. 만족한 얼굴이다.`,
					`<<He>>【이가】 숨을 내쉰다. "누구 것인지는 아는군."`,
				]>><<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
			<</if>>

		<<elseif _bwOwner is "Robin">>
			<<if $syndromeBailey>>
				<<set $_text_output to `<<His>> eyes darken. "Maybe I should sell <<nnpc_him "Robin">> somewhere you can't find <<nnpc_him "Robin">>."`>>
			<<else>>
				<<set $_strings to [
					`<<He>>【이가】 비웃는다. "그 쓸모없는 꼬맹이는 널 못 구해."`,
					`<<He>>【이가】 낄낄거린다. "좋은 생각이야. 둘을 묶어 팔면 두 배는 쳐줄 테니까."`,
					`<<He>>【이가】 낄낄거린다. "<<nnpc_him "Robin">>【을를】 계속 데려와. <<nnpc_him "Robin">>한테도 쓸 데를 찾아 줄 테니까."`,
				]>>
				<<if C.npc.Bailey.dom lte 30>>
					<<run $_strings.push(`<<He>> sneers. "Useless. Both of you."`)>>
				<</if>>
				<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
			<</if>>

		<<elseif _bwOwner is "Eden">>
			<<if $syndromeBailey>>
				<<set $_strings to [
					`<<He>>【이가】 아플 만큼 세게 표식을 움켜쥐고 으르렁거린다. "<<nnpc_his "Eden">> 이름을 네 몸에서 지워."`,
					`<<He>>【이가】 엄지로 에덴의 표식을 천천히 훑는다. 이어 손톱이 파고든다. "없애."`,
				]>>
				<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
			<<else>>
				<<set $_strings to [
					`<<He>>【이가】 으르렁거린다. "<<nnpc_He "Eden">>【은는】 사람보다 나무를 택했어. 너보다도. 모두보다도."`,
					`<<His>> 손가락이 표식이 새겨진 살갗을 움켜쥔다. "<<nnpc_He "Eden">>【은는】 아무것도 가질 자격이 없어."`,
				]>>
				<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
			<</if>>

		<<elseif _bwOwner is "Sydney">>
			<<set $_text_output to `<<He>> sneers. "Your little saint isn't here."`>>

		<<elseif _bwOwner is "Avery">>
			<<if $avery_mansion>>
				<<set $_text_output to `<<He>> smirks. "<<nnpc_He "Avery">> paid and still needs to write <<nnpc_his "Avery">> name on it?"`>>
			<<else>>
				<<set $_text_output to `<<His>> lip curls. <<His>> fingers dig painfully into the mark.`>>
			<</if>>

		<<elseif _bwOwner is "Alex">>
			<<set $_text_output to `<<He>> scoffs. "That idiot farmer? At least cattle know their place."`>>

		<<elseif _bwOwner is "Whitney">>
			<<set $_strings to [
				`<<He>>【이가】 낄낄거린다. "<<nnpc_him "Whitney">>【이가】 계속 그런 척하게 내버려 두지."`,
				`<<He>>【이가】 숨을 내쉰다. "그 꼬맹이는 널 감당 못 해."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>

		<<elseif _bwOwner is "Kylar">>
			<<set $_text_output to `<<He>> reads it. "Obsessive little shit."`>>

		<<elseif _bwOwner is "Remy">>
			<<set $_text_output to `<<He>> sneers at the mark with disgust. "Looks like Remy got <<nnpc_his "Remy">> money's worth."`>>

		<<elseif _bwOwner is "Gwylan">>
			<<set $_text_output to `<<He>> traces the mark. "<<nnpc_He "Gwylan">> can take what <<nnpc_he "Gwylan">> wants from your head. I'll take what I want from the rest of you."`>>

		<<elseif _bwOwner is "rape">>
			<<set $_strings to [
				`<<He>>【이가】 입술을 비튼다. "아깝군."`,
				`<<He>>【이가】 입술을 비튼다. "몸을 쓰레기처럼 내던지다니. 한심하군."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>

		<<elseif _bwOwner is "prostitution">>
			<<set _bpLooks     to (Math.min($beauty || 0, $beautymax || 10000) / ($beautymax || 10000) + Math.min($allure || 0, 8000) / 8000) / 2>>
			<<set _bpSeduction to Math.min($seductionskill || 0, 10000) / 10000>>
			<<set _bpPhysique  to Math.min($physique || 0, $physiquesize || 12000) / ($physiquesize || 12000)>>
			<<set _bpSchool    to Math.min(($maths||0)+($english||0)+($science||0)+($history||0), 4000) / 4000>>
			<<set _bpSkuld     to Math.min($skulduggery || 0, 1000) / 1000>>
			<<set _bpRaw to (_bpLooks*3000) + (_bpSeduction*2000) + (_bpPhysique*1000) + (_bpSchool*500) + (_bpSkuld*500)>>
			<<set _baileyPrice to Math.max(5, Math.min(1000, Math.floor((_bpRaw / 7000) * 1000 / 5) * 5))>>
			<<set _oldDegree to _bwEntry.degree || 0>>
			<<add_bodywriting _args[0] "baileys_asset" _args[1]>>
			<<set $skin[_args[0]].writing to "£" + _baileyPrice>>
			<<set $skin[_args[0]].degree to _baileyPrice * 10>>
			<<if $syndromeBailey>>
				<<set $skin[_args[0]].special to "prostitution">>
			<</if>>
			<<bodywriting_finalisation _args[0]>>
			<<if (_baileyPrice * 10) gt _oldDegree>>
				<<set $_strings to [
					`<<He>>【이가】 옛 가격을 코웃음 치며 줄로 긋는다. "틀렸어." <<He>>【은는】 새 숫자를 적는다. "넌 그보다 값어치가 나가."`,
					`<<He>>【이가】 표식을 줄로 긋는다. "이걸 쓴 놈은 자기가 뭘 가졌는지도 몰라." <<He>>【은는】 자기 값을 직접 적는다.`,
				]>>
			<<elseif (_baileyPrice * 10) lt _oldDegree>>
				<<set $_strings to [
					`<<He>>【이가】 숫자를 보고 비웃는다. "값을 너무 쳐줬군." <<He>>【은는】 줄을 긋고 더 낮은 숫자를 적는다.`,
					`<<He>>【이가】 코웃음 치며 표식을 줄로 긋는다. "자만하는군." <<He>>【은는】 자기 감정가를 적는다.`,
				]>>
			<<else>>
				<<set $_strings to [
					`<<He>>【이가】 옛 가격을 읽는다. 그래도 줄로 긋고, 같은 숫자를 자기 손으로 다시 적는다.`,
				]>>
			<</if>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>

		<<elseif _bwEntry && _bwEntry.owner>>
			<<set $_strings to [
				`<<He>>【이가】 그것을 훑어본다. "정말 아꼈으면 널 돈 주고 샀겠지."`,
				`<<He>>【은는】 그것을 힐끗 보고, 이어 당신을 본다. "싸구려군."`,
				`<<He>>【은는】 시큰둥한 표정이다. "그쪽은 한 푼도 안 들였겠군."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>

		<</if>>

		<<if $_text_output>>
			<<print $_text_output>>
		<<else>>
			/* PC is unmarked, so Bailey writes a price tag based on their stats. */
			<<set _bpLooks     to (Math.min($beauty || 0, $beautymax || 10000) / ($beautymax || 10000) + Math.min($allure || 0, 8000) / 8000) / 2>>
			<<set _bpSeduction to Math.min($seductionskill || 0, 10000) / 10000>>
			<<set _bpPhysique  to Math.min($physique || 0, $physiquesize || 12000) / ($physiquesize || 12000)>>
			<<set _bpSchool    to Math.min(($maths||0)+($english||0)+($science||0)+($history||0), 4000) / 4000>>
			<<set _bpSkuld     to Math.min($skulduggery || 0, 1000) / 1000>>
			<<set _bpRaw to (_bpLooks*3000) + (_bpSeduction*2000) + (_bpPhysique*1000) + (_bpSchool*500) + (_bpSkuld*500)>>
			<<set _baileyPrice to Math.max(5, Math.min(1000, Math.floor((_bpRaw / 7000) * 1000 / 5) * 5))>>
			<<add_bodywriting _args[0] "baileys_asset" _args[1]>>
			<<set $skin[_args[0]].writing to "£" + _baileyPrice>>
			<<set $skin[_args[0]].degree to _baileyPrice * 10>>
			<<if $syndromeBailey>>
				<<set $skin[_args[0]].special to "prostitution">>
			<</if>>
			<<bodywriting_finalisation _args[0]>>
			<<if _baileyPrice gte 800>><<set $_strings to [
					`"좋아." <<He>>【은는】 만족한 얼굴이다.`,
					`"가능성만큼은 해냈군." <<He>>【은는】 만족한 얼굴이다.`,
				]>><<print $_strings[random(0, $_strings.length - 1)]>>
			<<elseif _baileyPrice gte 500>><<set $_strings to [
					`"나쁘지 않군." <<he>>【이가】 말한다. "지금으로선."`,
					`"더 나쁠 수도 있었지."`,
					`"아직 더 오를 여지가 있어."`,
				]>><<print $_strings[random(0, $_strings.length - 1)]>>
			<<elseif _baileyPrice gte 200>><<set $_strings to [
					`<<He>>【이가】 어깨를 으쓱한다. "더 싼 값에도 팔아 봤어."`,
					`"어중간하군."`,
				]>><<print $_strings[random(0, $_strings.length - 1)]>>
			<<else>><<if C.npc.Bailey.dom lte 30>>"쓸모없군." <<He>>【이가】 펜 뚜껑을 닫는다.<<else>>"실망스럽군." <<He>>【이가】 펜 뚜껑을 닫는다.<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>


:: Bailey TF Reaction [widget]
<<widget "baileyTF">>
	<<if $weekly.baileyTfSeen isnot true and $rentTime gt 0 and random(1,5) is 1>><<set $weekly.baileyTfSeen to true>>
		<<if $NPCList[0] and $NPCList[0].fullDescription is "Bailey">><<person1>><<else>><<endevent>><<npc Bailey>><<person1>><<set _baileyTFOwnsSlot to true>><</if>>
		베일리가 복도를 걸어가고 있는데, <<he>>【이가】 당신을 본다.
		<<if Transformations.chimeraFull("melusine")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<He>>【이가】 걸음을 멈춘다. <<His>> 눈이 당신의 뿔과 날개, 머리 위의 빛을 훑는다. <<He>>【은는】 코로 천천히 숨을 들이쉰다. "이 바닥에서 이십 년을 굴렀지만 너 같은 건 본 적이 없어." <<He>>【은는】 당신에게 손도 대지 않고 비켜 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【이가】 걸음을 멈추고 빤히 쳐다본다. <<His>> 입이 벌어졌다가 닫힌다. <<He>>【은는】 당신을 크게 돌아 지나가며 뒤도 돌아보지 않는다.
			<<else>>
				<<He>>【이가】 걷다 말고 멈춰 서서 한참 동안 당신을 쳐다본다. "그걸 어떻게 해야 할지 모르겠군." <<he>>【이가】 말한다. <<He>>【은는】 당신을 돌아서 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.chimeraFull("ryuujin")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 뿔에서 후광으로 옮겨 간다. "용과 천사." <<he>>【이가】 말한다. "어느 쪽이든 돈을 낼 놈이 있겠지. 둘 다는 욕심이야." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 뿔을, 이어 후광을 보더니 고개를 젓는다. "하나만 골라." 부딪치듯 지나간다.
			<<else>>
				<<His>> 눈이 당신의 뿔과 후광 사이를 오간다. <<He>>【은는】 아무 말 없이, 굳이 그럴 필요가 없는데도 바싹 붙어 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.chimeraFull("bakunawa")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 뿔에 머문다. <<He>>【은는】 손을 뻗어 뿔 하나를 엄지로 쓸어 본다. "용에 악마라. 살 놈은 몇 안 되지만, 하나같이 값은 후하게 쳐주지." <<He>>【은는】 손을 놓고 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 뿔과 꼬리를 보고 뒤로 물러선다. "나한테 가까이 오지 마." 지나가는 동안 <<he>>【은는】 맞은편 벽에 바싹 붙어 걷는다.
			<<else>>
				<<He>>【은는】 한참 동안 당신의 뿔을 쳐다본다. <<His>> 턱이 굳는다. 아무 말 없이 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.chimeraFull("seraphim")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 날개를, 그 전부를 따라 훑는다. <<He>>【은는】 두 손가락으로 깃털 하나를 바로잡는다. "누구한테도 이렇게까지는 필요 없어." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 날개를 쏘아본다. "뭐라도 쳐서 넘어뜨리겠군." 밀치며 지나가다 어깨로 날개 하나를 스친다.<<gpain>><<pain 4>>
			<<else>>
				<<He>>【은는】 당신의 날개를 보고 멈춰 선다. 날개를 세어 보고는 계속 걸으며 당신의 어깨를 부딪치고 간다.
			<</if>>
			<br><br>

		<<elseif Transformations.chimeraFull("kitsune")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 꼬리를 하나하나 따라간다. "여우로군." <<he>>【이가】 말한다. "그런데 이제 네가 더 많아졌네." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【이가】 당신의 꼬리들을 보고 입술을 비튼다. "하나도 이미 많았어." 부딪치듯 지나간다.
			<<else>>
				<<He>>【은는】 멈춰 서서 당신의 꼬리들을 본다. 날카롭게 숨을 내쉬고는 부딪치듯 지나가며 계속 걷는다.
			<</if>>
			<br><br>

		<<elseif Transformations.chimeraFull("okami")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 눈이 당신의 늑대 귀에서 날개로 옮겨 간다. <<He>>【은는】 손을 뻗어 당신의 고개를 한쪽으로 기울이고 귀 하나를 살핀다. "바쁘게 지냈군." <<He>>【은는】 손을 놓고 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 귀를, 이어 날개를 본다. "날개 달린 떠돌이도 떠돌이일 뿐이야." 스치듯 지나간다.
			<<else>>
				<<He>>【은는】 당신의 귀와 날개를 본다. 표정은 여전히 무덤덤하다. 지나가며 당신의 어깨를 툭 친다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("waterdragon", "horns") or Transformations.partActive("waterdragon", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 눈이 당신의 뿔에서 멈춘다. <<He>>【은는】 뿔 하나를 두 손가락으로 쥐고 빛에 비춰 보려는 듯 당신의 고개를 돌린다. "부두에 너 같은 걸 찾는 남자가 하나 있어." <<He>>【은는】 손을 놓고 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【이가】 당신의 뿔을 힐끗 보고 비웃는다. "그거 어디다 들이대는지 조심해." 어깨로 밀치며 지나간다.
			<<else>>
				<<He>>【은는】 당신의 뿔을 본다. "벽 긁지 마." <<he>>【이가】 말한다. 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("wolf", "ears") and Transformations.partActive("wolf", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 늑대 귀에 오래 머문다. <<He>>【은는】 손을 뻗어 당신의 고개를 한쪽으로 기울이고 귀 하나를 살핀다. 감정하는 듯 "흠" 하고 낮게 소리를 내더니 손을 놓고 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 늑대 귀를 쏘아본다. 손가락으로 귀 하나를 튕긴다. "떠돌이 개 같군." 스치듯 지나간다.
			<<else>>
				<<He>>【은는】 멈춰 서서 당신의 늑대 귀 하나를 두 손가락으로 쓸어 본다. 감정하는 듯 "흠" 하고 낮게 소리를 낸 뒤 손을 놓고, 떠나며 당신의 어깨를 부딪치고 간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("cat", "ears") and Transformations.partActive("cat", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<He>>【은는】 당신 뒤에서 흔들리는 고양이 꼬리를 지켜본다. 표정은 읽을 수 없다. "어울리는군. 넌 늘 두 발로 떨어지니까." <<He>>【은는】 스치듯 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 고양이 꼬리를 움켜쥐고 힘껏 잡아당긴다. 손을 놓고 어깨로 밀치며 지나가면서 손을 바지에 닦는다.<<gpain>><<pain 4>>
			<<else>>
				<<He>>【은는】 흔들리는 고양이 꼬리를 지켜본다. "야옹이 한 마리에 큰돈을 낼 사람을 하나 알지." 어깨로 밀치며 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("cow", "ears") and Transformations.partActive("cow", "tail") and Transformations.partActive("cow", "horns")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 젖소 뿔에서 젖소 꼬리로 내려간다. "젖소는 수요가 많지. 운 좋은 줄 알아." <<He>>【은는】 스치듯 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【이가】 당신의 젖소 뿔을 힐끗 보고 비웃는다. "한심하군." 부딪치듯 지나간다.
			<<else>>
				<<He>>【은는】 비웃으며 당신의 젖소 꼬리를 빤히 본다. 지나가면서 당신의 어깨를 툭 친다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("bird", "wings") and Transformations.partActive("bird", "tail") and Transformations.partActive("bird", "plumage")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 날개 선을 따라간다. <<He>>【은는】 비뚤어진 깃털 하나를 바로잡는다. "누군가 널 새장에 가두려 들겠군." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신 어깨에서 빠진 깃털 하나를 집어 살펴보다가 바닥에 떨어뜨린다. "그거 주워." 복도를 따라 어깨로 밀치며 지나간다.
			<<else>>
				<<He>>【은는】 멈춰 서서 깃털 하나를 손가락으로 쓸어 본다. <<His>> 표정은 무덤덤하다. "조심해. 누가 날개를 잘라 버리고 싶어 할 수도 있어." 지나가며 당신의 어깨를 툭 친다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("fox", "ears") and Transformations.partActive("fox", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<He>>【은는】 당신의 여우 귀를 보고, 이어 당신을 본다. <<His>> 눈 뒤로 무언가가 스친다. "여우라." <<he>>【이가】 비웃는다. "여우는 이제 질릴 만큼 질렸어." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<His>> 입술이 당신의 여우 귀를 보고 비틀린다. "잘됐군. 한 마리 더 늘었어." 부딪치듯 지나간다.
			<<else>>
				<<He>>【은는】 당신의 여우 귀를 보고 걷다 말고 멈춘다. 날카롭게 숨을 내쉬고는 부딪치듯 지나가며 계속 걷는다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("bear", "ears") and Transformations.partActive("bear", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 곰 귀를 훑고 어깨에서 멈춘다. <<He>>【은는】 웬일로 당신을 밀치고 지나가지 않고 비켜서 돌아간다. "허튼 생각 마." <<He>>【은는】 계속 걷는다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 곰 귀를 본다. "안 그래도 충분히 먹잖아." 어깨로 밀치며 지나간다.
			<<else>>
				<<He>>【은는】 당신의 곰 귀를 보고, 이어 당신 뒤의 문틀을 본다. 아무 말 없이 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("bunny", "ears") and Transformations.partActive("bunny", "tail")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 눈이 당신의 토끼 귀에 가 닿는다. <<He>>【은는】 귀 하나를 잡아 머리에 납작하게 접어 눌렀다가 다시 튕겨 오르게 놓는다. "싸구려 의상에 비싼 입맛이군." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신의 토끼 귀 하나를 움켜쥐고 당신이 손을 따라 몸을 숙일 때까지 잡아당긴다. "토끼는 잡아먹히는 거야." 손을 놓고 부딪치듯 지나간다.<<gpain>><<pain 4>>
			<<else>>
				<<He>>【은는】 당신의 토끼 귀를 본다. "토끼처럼 새끼 쳐대면 쫓겨나." <<he>>【이가】 말한다. 지나가며 당신의 어깨를 툭 친다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("fallenAngel", "wings")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 어두워진 날개를 따라간다. <<He>>【은는】 검게 변한 깃털 하나를 엄지로 느리고 의도적으로 쓸어 본다. "흠집 난 물건은 싸게 팔리지." <<He>>【은는】 깃털을 놓는다. "제대로 된 사는 놈을 알고 있다면 모를까." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<His>> 입술이 당신의 어두워진 날개를 보고 비틀린다. "너한텐 쓸 만한 게 그거 하나 있었는데." <<He>>【은는】 당신 어깨의 검은 깃털을 튕겨 낸다. "이제 아니군." 어깨로 밀치며 지나간다.
			<<else>>
				<<His>> 눈이 당신의 날개에서 후광으로 옮겨 간다. <<He>>【은는】 굳은 표정으로 희미한 빛을 한참 쳐다본다. "멍청한 새끼." 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("angel", "wings") and Transformations.partActive("angel", "halo")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<He>>【은는】 당신의 후광을, 이어 날개를 바라본다. 두 손가락으로 깃털을 바로잡아 준다. "눈에 띄겠군." <<He>>【은는】 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<His>> 눈이 당신의 후광에서 날개로 옮겨 간다. <<He>>【은는】 날개를 노려보다가 복도를 따라 부딪치듯 지나간다.
			<<else>>
				<<He>>【은는】 당신의 후광을 매섭게 노려본다. "그거 벗어. 우스꽝스러워 보여." 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif Transformations.partActive("demon", "horns")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 당신의 뿔에 머문다. <<He>>【은는】 손을 뻗어 손가락 마디로 뿔 하나를 툭 두드린다. "어울리는군." <<He>>【은는】 손을 내리고 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<His>> 눈이 비웃음과 함께 당신의 뿔로 쏠린다. "딱 맞네." 어깨로 밀치며 지나간다.
			<<else>>
				<<His>> 눈이 당신의 뿔로 쏠린다. <<His>> 입가가 씰룩인다. "잘 어울려." 스치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif $worn.neck.name is "Bailey's collar">>
			<<His>> 눈이 당신의 목줄에 닿는다. <<He>>【은는】 또 하나의 목줄처럼 당신의 목을 손으로 감싸쥐고 미소 짓는다. "좋아. 잃어버리지 마." 당신을 놓고 부딪치듯 지나간다.
			<br><br>

		<<elseif $worn.neck.collared is 1>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 눈이 리드줄에 닿는다. <<He>>【은는】 무덤덤한 표정으로 한참 동안 당신의 눈을 마주 본다. 손을 올려 당신의 목줄을 따라 쓸어 본다. "누가 널 자기 거라고 생각하는 모양이군." <<He>>【은는】 떠나면서 부딪치듯 지나간다.
			<<elseif C.npc.Bailey.dom lte 30>>
				<<His>> 시선이 리드줄로 내려간다. <<He>>【은는】 그것을 움켜쥐고 주먹에 한 바퀴 감아 홱 잡아당겨 당신을 앞으로 비틀거리게 한다. "벌써 누가 길을 들여놨군. 잘됐어." 리드줄을 놓고 부딪치듯 지나간다.<<gpain>><<pain 4>>
			<<else>>
				<<His>> 눈이 리드줄로 내려간다. <<He>>【은는】 손을 뻗어 당신을 <<him>> 쪽으로 잡아당겨 비틀거리게 한다. 그러고는 손을 놓고 부딪치듯 지나간다.
			<</if>>
			<br><br>

		<<elseif $beauty gte ($beautymax / 7) * 6>>
			<<if C.npc.Bailey.dom gte 70>>
				<<His>> 시선이 느릿하고 신중하게 당신을 훑는다. "값이 나가는 물건이군, 안 그래?" <<he>>【이가】 말하고는 부딪치듯 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<elseif C.npc.Bailey.dom lte 30>>
				<<He>>【은는】 당신을 위아래로 훑어본다. "꾸미면 괜찮군. 아직 더 뽑아낼 게 있겠어." 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<<else>>
				<<His>> 눈이 당신에게 오래 머문다. <<His>> 턱이 굳더니 어깨로 밀치며 지나간다.<<if $syndromeBaileyBuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
			<</if>>
			<br><br>

		<<else>>
			<<if $baileydefeatedchain gte 1>>
				<<He>>【이가】 당신을 보고 비웃는다. "<<rentday>>. 이번엔 제때 내는 게 좋을 거야, 이 꼬마 새끼야." 부딪치듯 지나간다.
			<<elseif $money gte $rentMoney + ($babyRent || 0) + $baileyBratTax>>
				<<He>>【은는】 웃지만 눈은 웃지 않는다. "<<rentday>>. 잊지 마." 부딪치듯 지나간다.
			<<else>>
				<<He>>【은는】 당신을 흘끗 본다. "<<rentday>>. 어떻게 구하든 상관 안 해, 꼬맹이." 부딪치듯 지나간다.
			<</if>>
			<br><br>
		<</if>>
		<<if _baileyTFOwnsSlot>><<endevent>><</if>>
	<</if>>
<</widget>>
