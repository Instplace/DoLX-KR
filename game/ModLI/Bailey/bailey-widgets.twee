/* ══════════════════════════════════════════════════════
LOTUS COLLAR ART PICKER
The dropdown fills itself from window.baileyCollarRegistry.
To add a new collar, just add it to that registry in rbe.js.
══════════════════════════════════════════════════════ */
:: Lotus Collar Picker Widgets [widget nobr]

<<widget "lotus_listbox">>
	/* Build the dropdown as raw HTML so options can be grouped by pack (SugarCube's <<listbox>> can't group).
	A handler in rbe.js saves the choice to $baileyCollarArt and redraws the sidebar. */
	<<script>>
		var reg = window.baileyCollarRegistry || [];
		var hasCustom = !!(window.baileyCollarImages && window.baileyCollarImages.custom);
		var current = (State.variables.baileyCollarArt) || "reiyu_goose";

		/* Group the registry entries by pack, keeping their original order. */
		var groups = [];
		var seen = {};
		reg.forEach(function (e) {
			var p = e.pack || "Other";
			if (!seen[p]) { seen[p] = []; groups.push([p, seen[p]]); }
			seen[p].push(e);
		});

		var html = '<select class="macro-listbox">';
		groups.forEach(function (pair) {
			html += '<optgroup label="' + pair[0] + '">';
			pair[1].forEach(function (e) {
				var sel = (e.key === current) ? ' selected' : '';
				html += '<option value="' + e.key + '"' + sel + '>' + e.label + '</option>';
			});
			html += '</optgroup>';
		});
		if (hasCustom) {
			html += '<optgroup label="Your Upload">';
			var sel = (current === "custom") ? ' selected' : '';
			html += '<option value="custom"' + sel + '>직접 올린 이미지</option>';
			html += '</optgroup>';
		}
		html += '</select>';
		$(this.output).append(html);
	<</script>>
<</widget>>

<<widget "lotus_collar_buttons">>
	<span class="custom-collar-btn no-numberify"><<button "직접 올리기...">><<script>>window.baileyCollarUpload();<</script>><</button>></span>
	<<if window.baileyCollarImages && window.baileyCollarImages.custom>>
		<span style="font-size: 1.2em;"> | </span>
		<span class="custom-collar-btn no-numberify"><<button "올린 이미지 제거">><<script>>window.baileyCollarRemoveCustom();<</script>><</button>></span>
	<</if>>
<</widget>>

:: Bailey Title Widget [widget]
<<widget "baileyTitle">><<silently>>
		<<if $baileyTitle and $baileyTitle isnot "Bailey">>
			<<set _btOut to $baileyTitle>>
		<<else>>
			<<set _btOut to "Bailey">>
		<</if>>
	<</silently>><<print _btOut>><</widget>>

/* Same as baileyTitle but capitalised, for the start of a sentence. */
<<widget "BaileyTitle">><<silently>>
		<<if $baileyTitle and $baileyTitle isnot "Bailey">>
			<<set _btOut to $baileyTitle.charAt(0).toUpperCase() + $baileyTitle.slice(1)>>
		<<else>>
			<<set _btOut to "Bailey">>
		<</if>>
	<</silently>><<print _btOut>><</widget>>

<<widget "baileySafeWord">><<print $baileySafeWord>><</widget>>

<<widget "BaileySafeWord">><<print $baileySafeWord.charAt(0).toUpperCase() + $baileySafeWord.slice(1)>><</widget>>

<<widget "baileySafeWordLine">>당신은 안전어를 사용한다. "<span class="purple"><<BaileySafeWord>></span>."<</widget>>

<<widget "baileySafeWordClean">><<set $baileySafeWord to $baileySafeWord.replace(/[^\p{L}\p{N} \u0027\-]/gu, "").trim() || "Marshmallow">><</widget>>

<<widget "baileyTitleClean">><<set $baileyTitle to String($baileyTitle).replace(/[<>]/g, "").trim().slice(0, 15) || "Bailey">><</widget>>

/* Narration version: only prints the title once one other than "Bailey" is chosen. */
<<widget "baileyTitleNarration">><<silently>>
		<<if $syndromeBailey and $baileyTitle isnot "Bailey">>
			<<set _btOut to $baileyTitle>>
		<<else>>
			<<set _btOut to "Bailey">>
		<</if>>
	<</silently>><<print _btOut>><</widget>>


