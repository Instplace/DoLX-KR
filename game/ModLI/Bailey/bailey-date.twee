/*
 * Bailey date system.
 * "Spend time with Bailey" menu only appears when Stockholm >= 1 and rent is current ($rentTime > 0).
 */

:: Bailey Date Menu
<<effects>><<speechresolve>>
<<endevent>><<npc Bailey>><<person1>>
/* Bailey prices his time against what rent tops out at, so the tiers stay
proportional when a player scales rent up or down. */
<<set _spankPrice to baileyPrice("spank")>>
<<set _shortPrice to baileyPrice("short")>>
<<set _mediumPrice to baileyPrice("medium")>>
<<set _allNightPrice to baileyPrice("allNight")>>

<<if $rentTime lte 0>> /* should be inaccessible */
	<<He>>【은는】 당신이 정신이라도 놓았냐는 듯한 눈으로 쳐다본다.
	<br><br>
	"내 시간을 돈 주고 사겠다고?" <<He>>【은는】 의자에 등을 기댄다. "먼저 갚을 것부터 갚아."
	<br><br>
	<<link [[뒤로|Orphanage]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
		"저, 저는 함께 시간을 보내고 싶어요." 당신이 <<him>>에게 말하며 가만히 서 있지 못하고 꼼지락거린다. "저, 저 돈 낼 수 있어요."
	<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
		"시간을 좀 내 주셨으면 해요." 당신이 말한다. "평소 받으시는 만큼 드릴게요."
	<<elseif _speechAttitudeResolved is "docile">>
		당신은 책상 위에 돈을 올려놓는다. "함께 시간을 보내고 싶어요. 허락해 주신다면요."
	<<elseif _speechAttitudeResolved is "confident">>
		"시간을 좀 내 주세요." 당신이 말한다. "얼마인지 말해 봐요."
	<<elseif _speechAttitudeResolved is "bratty">>
		"나랑 시간 보내." 당신이 요구한다. "돈은 낼 테니까."
	<<elseif _speechAttitudeResolved is "cruel">>
		"네 시간에도 여기 있는 다른 모든 것처럼 값이 있잖아." 당신이 말한다. "불러 봐."
	<<else>>
		"돈을 내면 저와 시간을 보내 주실 건가요?" 당신이 묻는다.
	<</if>>
	<br><br>
	<<if $baileyDateShort gte 3>>
		베일리는 장부에 무언가를 적는다. <<He>>【은는】 놀란 기색이 없다. "내놔."
	<<elseif $baileyDateShort gte 1>>
		베일리는 장부에 무언가를 적는다. 한참 뒤, <<he>>【이가】 펜을 내려놓고 당신을 쳐다본다. "또? 처음에 돈 낭비한 걸로는 부족했나?"
	<<else>>
		베일리는 장부에 무언가를 적는다. 한참 뒤, <<he>>【이가】 펜을 내려놓고 당신을 쳐다본다.
		<br><br>
		"진심이었군." <<he>>【이가】 코웃음 친다.
	<</if>>
	<br><br>

	/* Food Gift */
	<<if $syndromeBaileyBuild gt 1 and C.npc.Bailey and canGiftFood("Bailey")>>
		<<skinicon "give">><<link [[베일리에게 식사를 가져다준다|Bailey Gifts List]]>><</link>>
		<br>
		<br>
	<</if>>

	/* Strap-on Gift */
	<<if C.npc.Bailey.sextoys>>
		<<for _key range Object.keys(C.npc.Bailey.sextoys).filter(t => C.npc.Bailey.sextoys[t][0].gift_state === "held" && checkIfNPCHasCategorySextoy("Bailey","strap-on").length <= 5)>>
			<<set _toy to C.npc.Bailey.sextoys[_key][0]>>
			<<set _icon to `sex-toys/${_toy.name.replace(/ /g, "-")}.png`>>
			<span @class="`clothes-${_toy.colour}`"><<icon _icon>></span>
			<<capture _toy>>
				<<link [[베일리에게 _toy.colour _toy.name【을를】 선물한다|Bailey Gift Strap-on]]>><<set $baileyGiftToy to _toy.name>><</link>>
			<</capture>>
			<br>
		<</for>>
	<</if>>

	/* Spanking*/
	<<if $daily.baileySpankingProper>>
		<span class="blue">"<<printprice _spankPrice>> 있어요. 엉덩이를 제대로 때려 주세요." (오늘은 이미 부탁했다.)</span>
		<br>
	<<elseif setup.inflation.canAfford(_spankPrice, "baileySpank")>>
		<<link [["<<printprice _spankPrice>> 있어요. 엉덩이를 제대로 때려 주세요." (0:10)|Bailey Spanking Proper Entry]]>><</link>>
		<br>
	<<else>>
		<span class="blue">"<<printprice _spankPrice>> 있어요. 엉덩이를 제대로 때려 주세요." (돈이 부족하다.)</span>
		<br>
	<</if>>

	/* Short Date */
	<<if $daily.baileyDate>>
		<span class="blue">"<<printprice _shortPrice>> 있어요. 저를 데려가 주세요." (오늘은 이미 베일리와 시간을 보냈다.)</span>
		<br>
	<<elseif setup.inflation.canAfford(_shortPrice, "baileyDate")>>
		<<link [["<<printprice _shortPrice>> 있어요. 저를 데려가 주세요." (1:00)|Bailey Date Short]]>><<money `-_shortPrice` "baileyDate">><<pass 5>><<set $daily.baileyDate to 1>><</link>>
		<br>
	<<else>>
		<span class="blue">"<<printprice _shortPrice>> 있어요. 저를 데려가 주세요." (돈이 부족하다.)</span>
		<br>
	<</if>>

	/* Medium Date, requires short date done */
	<<if $baileyDateShort gte 1>>
		<<if $baileyDateScheduled>>
			<span class="blue">"<<printprice _mediumPrice>> 있어요. 저녁을 사 드릴게요." (오늘 밤에 이미 데이트가 예약되어 있다.)</span>
			<br>
		<<elseif $daily.baileyDate>>
			<span class="blue">"<<printprice _mediumPrice>> 있어요. 저녁을 사 드릴게요." (오늘은 이미 베일리와 시간을 보냈다.)</span>
			<br>
		<<elseif Time.hour gte 19>>
			<span class="blue">"<<printprice _mediumPrice>> 있어요. 저녁을 사 드릴게요." (오늘 밤 저녁 예약을 잡기에는 너무 늦었다. 아침에 부탁하자.)</span>
			<br>
		<<elseif setup.inflation.canAfford(_mediumPrice, "baileyDate")>>
			<<link [["<<printprice _mediumPrice>> 있어요. 저녁을 사 드릴게요." (0:05)|Bailey Date Medium Schedule]]>><<pass 5>><<money `-_mediumPrice` "baileyDate">><<set $daily.baileyDate to 1>><</link>>
			<br>
		<<else>>
			<span class="blue">"<<printprice _mediumPrice>> 있어요. 저녁을 사 드릴게요." (돈이 부족하다.)</span>
			<br>
		<</if>>
	<</if>>

	/* All Night Date, requires Medium date done */
	<<if $baileyDateMedium gte 1>>
		<<if $baileyDateAllNightScheduled>>
			<span class="blue">"<<printprice _allNightPrice>> 있어요. 밤을 함께 보내고 싶어요." (오늘 밤에 이미 데이트가 예약되어 있다.)</span>
			<br>
		<<elseif $daily.baileyDate>>
			<span class="blue">"<<printprice _allNightPrice>> 있어요. 밤을 함께 보내고 싶어요." (오늘은 이미 베일리와 시간을 보냈다.)</span>
			<br>
		<<elseif Time.hour gte 19>>
			<span class="blue">"<<printprice _allNightPrice>> 있어요. 밤을 함께 보내고 싶어요." (오늘 밤 예약을 잡기에는 너무 늦었다. 아침에 부탁하자.)</span>
			<br>
		<<elseif setup.inflation.canAfford(_allNightPrice, "baileyDate")>>
			<<link [["<<printprice _allNightPrice>> 있어요. 밤을 함께 보내고 싶어요." (0:15)|Bailey Date All Night Schedule]]>><<pass 15>><<money `-_allNightPrice` "baileyDate">><<set $daily.baileyDate to 1>><</link>>
			<br>
		<<else>>
			<span class="blue">"<<printprice _allNightPrice>> 있어요. 밤을 함께 보내고 싶어요." (돈이 부족하다.)</span>
			<br>
		<</if>>
	<</if>>

	/* Cat Ears */
	<br>
	<<set _catprice to baileyPrice("catEars") + 500>>
	<<if setup.inflation.canAfford(_catprice, "catEars")>>
		<<if !$baileyCatEars>>
			<<link [["<<printprice _catprice>>【을를】 드릴 테니 고양이 귀를 달아 주세요." (0:05)|Bailey Cat Ears]]>><<pass 5>><</link>>
		<<else>>
			<<link [["<<printprice _catprice>>【을를】 드릴 테니 고양이 귀를 다시 달아 주세요." (0:05)|Bailey Cat Ears]]>><<pass 5>><</link>>
		<</if>>
		<br>
	<<else>>
		<<if !$baileyCatEars>>
			<span class="blue">"<<printprice _catprice>>【을를】 드릴 테니 고양이 귀를 달아 주세요." (돈이 부족하다.)</span>
		<<else>>
			<span class="blue">"<<printprice _catprice>>【을를】 드릴 테니 고양이 귀를 다시 달아 주세요." (돈이 부족하다.)</span>
		<</if>>
		<br>
	<</if>>

	/* Change what you call Bailey */
	<<if $syndromeBailey>>
		<br>
		<<socialiseicon>><<link [[<<him>>【을를】 부르는 호칭을 바꾼다|Bailey Title Choose]]>><<set $baileyTitleFrom to "date_menu">><</link>>
		<br>
	<</if>>

	<br>
	<<link [[뒤로|Orphanage]]>><<endevent>><</link>>
	<br>
<</if>>


/* Short date: 50% of Bailey's max rent. */

:: Bailey Date Short
<<pass 10>><<effects>>
<<endevent>><<npc Bailey>><<person1>>
<<set $baileyDateShort += 1>>

당신은 <<him>>에게 돈을 내민다.
<br><br>

베일리는 돈을 받아 세어 본 뒤 재킷 주머니에 접어 넣는다.
<br><br>

"그럼 가지." <<he>>【이가】 말한다. "난 할 일이 있어."
<br><br>

<<if C.npc.Bailey.dom gte 70>>
	<<He>>【은는】 빠르게 걷지만, 당신은 <<his>> 걸음을 간신히 따라간다.
<<elseif C.npc.Bailey.dom gte 30>>
	<<He>>【은는】 당신을 돌아보지도 않고 몇 걸음 앞서 걷는다. 당신은 따라가려고 애쓴다.
<<else>>
	<<He>>【은는】 빠르게 걷고 돌아보지도 않는다. 당신은 비틀거리며 <<him>>【을를】 쫓아간다.
<</if>>
<br><br>

<<link [[다음|Bailey Date Short Arrive]]>><</link>>
<br>


:: Bailey Date Short Arrive
<<effects>>
<<person1>>
<<set $baileyDateShortStole to false>><<set $baileyDateShortLeaned to false>><<set $baileyDateShortListened to false>><<set $baileyDateShortIntimidated to false>>

베일리는 당신을 마을 서쪽의 수상쩍은 간판 없는 건물로 데려간다. <<He>>【이가】 문을 밀어 보자 열린다.
<br><br>

<<generateNPC 2 a>><<person2>>안에서 <<personsimple>>【이가】 기다리고 있다. <<He>>【은는】 베일리를 올려다보고, 이어서 당신을 쳐다본다.
<br><br>

"이 애는 누구지?" <<he>>【이가】 묻는다.
<br><br>

<<person1>>
<<if $syndromeBailey>>
	"내 거야." 베일리가 말한다.
<<else>>
	"내 사람 중 하나야." 베일리가 말한다.
<</if>>
<br><br>

당신은 주위를 둘러본다. 일종의 심문실 같다. <<He>>【은는】 <<person2>><<personsimple>>의 맞은편에 앉는다. 탁자 주위에는 의자가 두 개뿐이다.
<br><br>

<<link [[베일리 옆에 선다|Bailey Date Short Arrive Stand]]>><</link>>
<br>
<<link [[베일리 옆에 무릎을 꿇는다|Bailey Date Short Arrive Kneel]]>><</link>>
<br>
<<link [[방 건너편에서 지켜본다|Bailey Date Short Arrive Watch]]>><</link>>
<br>


:: Bailey Date Short Arrive Stand
<<effects>><<speechresolve>>
<<person1>>
<<set $phase to "stand">>

<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
	당신은 조용히 걸어가 베일리 곁에 선다. 뭔가 잘못하고 있는 건 아닐까 걱정하며 몸을 꼼지락거린다.
<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
	당신은 옷매무새를 가다듬으며 방을 가로질러 베일리 곁에 자리를 잡는다.
<<elseif _speechAttitudeResolved is "docile">>
	<<he>>【이가】 손짓하자마자 당신은 베일리 곁으로 가서, 손을 앞에 가만히 모으고 기다린다.
<<elseif _speechAttitudeResolved is "confident">>
	당신은 베일리 곁에 자리를 잡고 발을 단단히 딛고 서서 방 안을 둘러본다.
<<elseif _speechAttitudeResolved is "bratty">>
	당신은 팔짱을 끼고 베일리 곁에 선다. 누군가 이쪽을 힐끗 보면, 상대가 고개를 돌릴 때까지 턱을 치켜든다.
<<elseif _speechAttitudeResolved is "cruel">>
	당신은 베일리 곁에 서서, 가장 가까이 있는 구경꾼이 시선을 돌릴 때까지 방 건너편을 노려본다.
<<else>>
	당신은 방을 가로질러 베일리 곁에 선다. 시선이 방 안을 훑는다.
<</if>>
<br><br>

베일리는 당신을 쳐다보지 않는다.
<br><br>

<<person2>>베일리 맞은편에 앉은 <<personsimple>>【이가】 계속 떠들어 댄다. 지불금에 관한 이야기 같다.
<br><br>

<<link [[다음|Bailey Date Short Meeting]]>><</link>>
<br>


:: Bailey Date Short Arrive Kneel
<<effects>>
<<person1>>
<<set $phase to "kneel">>

당신은 방을 가로질러 베일리의 다리 옆에 무릎을 꿇는다.
<br><br>

<<if $syndromeBailey>>
	<<He>>【은는】 당신을 쳐다보지 않지만, <<his>> 손이 당신의 머리 위에 얹힌다.<<npcincr Bailey lust 1>><<glust "Bailey">>
<<else>>
	베일리는 당신을 한 번 내려다보고는 다시 하던 대화로 돌아간다.<<npcincr Bailey lust 1>><<glust "Bailey">>
<</if>>
<br><br>

<<person2>>베일리 맞은편에 앉은 <<personsimple>>【이가】 계속 떠들어 댄다. 지불금에 관한 이야기 같다.
<br><br>

<<link [[다음|Bailey Date Short Meeting]]>><</link>>
<br>


:: Bailey Date Short Arrive Watch
<<effects>>
<<person1>>
<<set $phase to "watch">>

당신은 방 건너편에서 베일리와 <<person2>><<personsimple>>【이가】 나누는 이야기를 듣는다.
<br><br>

<<person2>><<personsimple>>【은는】 불안해 보인다. <<person1>>베일리는 여느 때처럼 흔들림이 없다.
<br><br>

둘은 너무 모호하게 말해서 정확히 무슨 이야기인지 알 수 없다. "지불금"에 관한 이야기라는 것만 어렴풋이 알아듣는다.
<br><br>

<<link [[다음|Bailey Date Short Men]]>><</link>>
<br>


:: Bailey Date Short Meeting
<<effects>>
<<person1>>

<<person2>><<personsimple>>【이가】 탁자 위에 서류철을 올려놓는다. 회의가 시작된다.
<br><br>

<<set $skulduggerydifficulty to 500>><<link [[훔칠 만한 것을 찾는다|Bailey Date Short Steal]]>><<set $skulduggerydifficulty to 500>><</link>><<skulduggerydifficulty>>
<br>
<<set $skulduggerydifficulty to 300>><<link [[회의 내용을 엿듣는다|Bailey Date Short Listen]]>><<set $skulduggerydifficulty to 300>><</link>><<skulduggerydifficulty>>
<br>
<<link [[탁자에 기댄다|Bailey Date Short Lean]]>><</link>><<seductiondifficulty>>
<br>
<<link [[위협한다|Bailey Date Short Intimidate]]>><</link>><<physiquedifficulty 200 600>>
<br>
<<link [[조용히 있는다|Bailey Date Short Quiet]]>><</link>>
<br>


:: Bailey Date Short Steal
<<effects>>
<<person1>>
<<skulduggerycheck "silent">>

<<if $skulduggerysuccess is 1>>
	<<if $phase is "kneel">>
		<<person2>><<personsimple>>【이가】 탁자에 서류를 내려놓는다. 맨 위에 베일리의 이름이 찍혀 있다. <span class="green">당신이 있는 자리에서도 서류 가장자리에는 손이 닿는다. 당신은 서류를 천천히 끌어당겨 바닥에 대고 접는다.</span>
	<<else>>
		<<person2>><<personsimple>>【이가】 탁자에 서류를 내려놓는다. 맨 위에 베일리의 이름이 찍혀 있다. <span class="green"><<person2>><<personssimple>> 시선이 베일리 쪽을 향한 틈에 당신은 서류를 탁자 가장자리로 미끄러뜨려 손바닥 안에 한 번 접어 쥔다.</span>
	<</if>>
	<br><br>

	<<person1>>베일리는 눈치챈다. <<He>>【은는】 아무 말도 하지 않는다.
	<br><br>

	<<set $baileyDateShortStole to true>>
<<else>>
	<<if $phase is "kneel">>
		<span class="red">당신의 손이 종이를 스치며 큰 소리를 낸다.</span> <<person2>><<personsimple>>【이가】 당신을 내려다본다. <<He>>【은는】 서류를 탁자 가장자리에서 끌어당긴다.
	<<else>>
		<span class="red"><<person2>><<personssimple>> 시선이 당신의 손으로 떨어진다.</span> <<person2>><<personsimple>>【이가】 아무 말 없이 서류를 탁자 위로 도로 끌어당긴다.
	<</if>>
	<br><br>

	베일리가 당신을 노려본다.<<npcincr Bailey love -1>><<llove "Bailey">>
<</if>>
<br><br>

<<link [[다음|Bailey Date Short Men]]>><</link>>
<br>


:: Bailey Date Short Listen
<<effects>><<speechresolve>>
<<person1>>
<<skulduggerycheck "silent">>

당신은 베일리와 <<person2>><<personsimple>>【이가】 사업 이야기를 나누는 것을 듣는다. 두 사람은 너무 모호하게 말해서 이해할 수 없다. 어느 순간 베일리가 <<nnpc_him "Bailey">>에게 건네진 서류를 훑어본다. <<person2>><<personsimple>>【은는】 초조해 보인다.
<br><br>

<<if $skulduggerysuccess is 1>>
	<span class="green"><<person2>><<personsimple>>【이가】 <<him>> 뒤의 문을 몇 번이나 힐끗거리는 것이 보인다. 베일리는 알아채지 못한 듯하다.</span>
	<br><br>

	<<person1>>
	<<if $phase is "kneel">>
