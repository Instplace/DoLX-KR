		<<elseif $uncomfortable.prostituting is false>>
			<<link [[유혹한다|Rent Seduce]]>><<trauma 12>><<set $desperateaction to 1>><</link>><<promiscuous2>><<ggtrauma>>
			<br>
		<</if>>
	<</if>>
