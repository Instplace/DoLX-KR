:: Bailey Expansion Credits [widget]
/* I tidy up the credit and, uh, using it as addition mod credit. Sorry and thanks! */
<<widget "BaileyExpansionCredits">>
	<div class="credits-content credits-mods">
		<div class="credit-hero">
			<span class="credit-hero-icon" aria-hidden="true">&#9881;</span>
			<div><span>통합된 모드</span><strong>제작자와 기여자</strong></div>
		</div>
		<section class="credit-section">
			<h2><span aria-hidden="true">&#9881;</span> 베일리 확장 모드</h2>
			<div class="credit-grid">
				<div class="credit-row"><span>제작자</span><strong>Reiyu GuiGui</strong></div>
				<div class="credit-row"><span>버전</span><strong>
				<a href="https://gitgud.io/reiyu/reiyusbaileyexpandedmod">0.6.3.3</a></strong></div>
				<div class="credit-row"><span>링크</span>
					<div class="credit-links">
						<a href="https://dolmodding.miraheze.org/wiki/Reiyu%27s_Bailey_Expansion_Mod">RBE의 돌모딩 위키 페이지</a>
						<a href="https://tumblr.com/dokidokibailey">Reiyu의 Tumblr</a>
						<a href="https://archiveofourown.org/users/ReiyuGuiGui">Reiyu의 Ao3</a>
					</div>
				</div>
			</div>
		</section>
		<div class="credit-columns">
			<section class="credit-section">
				<h2><span aria-hidden="true">&#10022;</span> 모드 연애 대상: 포피 (OPIUM)</h2>
				<div class="credit-grid">
					<div class="credit-row"><span>총괄 작가</span><strong>Toaster</strong></div>
					<div class="credit-row"><span>총괄 개발자</span><strong>the developer</strong></div>
					<div class="credit-row"><span>아티스트</span><strong>Kmagi</strong></div>
					<div class="credit-row"><span>아티스트</span><strong>Lore&#95;potato</strong></div>
					<div class="credit-row"><span>공동 작가</span><strong>Sakura</strong></div>
					<div class="credit-row"><span>베타 리더</span><strong>Tom</strong></div>
					<div class="credit-row"><span>기여자</span><strong>Sei/Karl Sendis</strong></div>
				</div>
			</section>
			<section class="credit-section">
				<h2><span aria-hidden="true">&#10022;</span> 그 밖의 통합 모드</h2>
				<div class="credit-grid">
					<div class="credit-row"><span>더 진한 염색 헤어 모드</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>원혼 추가 모드</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>커스텀 메이크업</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>현실적인 출산</span><strong>Psayne</strong></div>
					<div class="credit-row"><span>마법 동물원</span><strong>Grimace &amp; Zerolefox</strong></div>
					<div class="credit-row"><span>페이퍼돌+</span><strong>YazawaHY</strong></div>
					<div class="credit-row"><span>HGP 헤어 마스크</span><strong>Llynkurin</strong></div>
				</div>
			</section>
		</div>
		<section class="credit-section">
			<h2><span aria-hidden="true">&#10022;</span> 변이 제작진</h2>
			<div class="credit-columns">
				<details class="credit-details" open>
					<summary><span>수룡 변이</span></summary>
					<div class="credit-grid">
						<div class="credit-row"><span class="teal">제작자</span><strong>NovaCyber</strong></div>
						<div class="credit-row"><span class="teal">개발자</span><strong>Isari &amp; the developer</strong></div>
						<div class="credit-row"><span class="teal">아트</span><strong>Sam Storiez</strong></div>
						<div class="credit-row"><span class="teal">기본 멜뤼진 날개</span><strong>Zero&#95;Otherian</strong></div>
						<div class="credit-row"><span class="teal">거위 수컷 아트</span><strong>Mad.W.D</strong></div>
						<div class="credit-row"><span class="teal">키메라 변이 멜뤼진 거위 암컷 아트</span><strong>Axos (set) &amp; Cici (wings)</strong></div>
						<div class="credit-row"><span class="teal">수정</span><strong>Bec &amp; the developer</strong></div>
					</div>
				</details>
				<div>
					<details class="credit-details" open>
						<summary><span>바니 변이</span></summary>
						<div class="credit-grid">
							<div class="credit-row"><span class="pink">제작자</span><strong><a href="https://ko-fi.com/pro_penlicker">WinterPeach</a></strong></div>
							<div class="credit-row"><span class="pink">스프라이트 제작</span><strong>Pinzya, Mellows, Phreia</strong></div>
							<div class="credit-row"><span class="pink">특별 감사</span><strong>Frostberg &amp; purepersona&#95;moon</strong></div>
						</div>
					</details>
					<details class="credit-details" open>
						<summary><span>고양이 키메라 변이</span></summary>
						<div class="credit-grid">
							<div class="credit-row"><span class="purple">개발자</span><strong>the developer</strong></div>
							<div class="credit-row"><span class="purple">기본 캣시 아트</span><strong>FoxIsASalmon!?</strong></div>
							<div class="credit-row"><span class="purple">작가</span><strong>Cappy &amp; the developer</strong></div>
						</div>
					</details>
				</div>
			</div>
		</section>
	</div>
<</widget>>
