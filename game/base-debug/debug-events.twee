:: Widgets Debug Event [widget]
<!-- Any widget with the goal to bug-purge events goes here.
	Since I didn't find an appropriate file to put this in, I decided to make my own.
	Feel free to delete this comment at leisure. -->
<<widget "checkEventNPC">>
	<<set _eventBeastContext to ($monster is 1 or $beastGroupFight is 1 or $combatTrain isnot undefined)>>
	<<set _eventSlotTaken to (EventSystem.isSlotTaken(_args[0]) and !EventSystem.Disable)>>

	/* Beast-context slot reuse: the NPC data is about to be overwritten by generateNPC,
	   so we only need to retire the OLD event-buffer entry for this slot.  This prevents
	   duplicate entries (old + new) which cause EventSystem.validate() to fail.
	   We do NOT clear the NPC itself, generateNPC will overwrite it properly. */
	<<if _eventSlotTaken and _eventBeastContext>>
		<<if $event isnot undefined and $event.buffer isnot undefined>>
			<<for _evtCleanI to $event.buffer.length - 1; _evtCleanI gte 0; _evtCleanI-->>
				<<if $event.buffer[_evtCleanI] and $event.buffer[_evtCleanI].slot is _args[0]>>
					<<run $event.buffer.splice(_evtCleanI, 1)>>
				<</if>>
			<</for>>
		<</if>>
	<</if>>

	/* Non-beast slot collision, or NPC count exceeds hard cap (gt 6, not gte 6;
	   having exactly 6 beast NPCs is a valid state, e.g. pound encounters). */
	<<if (_eventSlotTaken and !_eventBeastContext) or ($enemynomax gt 6 or $enemyno gt 6)>>
		<<if $eventDebugHistory is undefined>><<set $eventDebugHistory to []>><</if>>
		<<set _eventReason to []>>
		<<if ($enemynomax gt 6 or $enemyno gt 6)>><<run _eventReason.push("too many NPCs before regeneration")>><</if>>
		<<if _eventSlotTaken and !_eventBeastContext>><<run _eventReason.push("slot collision before regeneration")>><</if>>
		<<set _eventDebugEntry to {slot: _args[0], reason: _eventReason.join("; "), detectedIn: $passage, detectedAt: $timeStamp, lastgenerated: $lastgenerated}>>
		<<if $event isnot undefined and $event.buffer isnot undefined>>
			<<for _eventHistI = 0; _eventHistI lt $event.buffer.length; _eventHistI++>>
				<<if $event.buffer[_eventHistI] and $event.buffer[_eventHistI].slot is _args[0]>>
					<<set _eventDebugEntry to clone($event.buffer[_eventHistI])>>
					<<set _eventDebugEntry.reason to _eventReason.join("; ")>>
					<<set _eventDebugEntry.detectedIn to $passage>>
					<<set _eventDebugEntry.detectedAt to $timeStamp>>
					<<set _eventDebugEntry.lastgenerated to $lastgenerated>>
					<<break>>
				<</if>>
			<</for>>
		<</if>>
		<<run $eventDebugHistory.push(_eventDebugEntry)>>
		<<if $eventDebugHistory.length gt 25>>
			<<run $eventDebugHistory.splice(0, $eventDebugHistory.length - 25)>>
		<</if>>
		<<set $endeventerror to $lastgenerated>>
		<<clearsinglenpc _args[0]>>
		<<run EventSystem.pop(_args[0])>>
		<!-- <<endevent phaseless>> -->
	<</if>>
	<<set $lastgenerated to $passage>>
<</widget>>

<<widget "eventExtraInfo">>
	<!-- Setup useful variables -->
	<<set $_passages to []>>
	<<if $event isnot undefined and $event.buffer isnot undefined>>
		<<for $_passageI = 0; $_passageI lt $event.buffer.length; $_passageI++>>
			<<set $_eventPassageEntry to $event.buffer[$_passageI]>>
			<<if $_eventPassageEntry and $_eventPassageEntry.area and $_eventPassageEntry.area[0]>>
				<<run $_passages.pushUnique($_eventPassageEntry.area[0])>>
			<</if>>
		<</for>>
	<</if>>
	<<set _eventValidationFailed to (EventSystem.any() and !EventSystem.validate())>>
	<!-- Recalculate this when the overlay opens.
	The caption is rendered before the passage body, so its temporary value can predate NPC generation on the current passage. -->
	<<unset _eventAlertMajorArea>>
	<<set _event0 to EventSystem.has(0) ? EventSystem.get(0) : undefined>>
	<<if !_eventValidationFailed and _event0 and _event0.area and _event0.area[0] is $passage>>
		<<set _eventAlertMajorArea to false>>
	<<elseif !_eventValidationFailed and EventSystem.any() and setup.majorAreas.includes($passage)>>
		<<set _eventAlertMajorArea to true>>
	<</if>>
	<<unset _eventreason>>
	<!-- Liveness comes from isLiveNPC() in event-debug.js so this overlay and EventSystem.validate() can never disagree. 
	Cleared slots are still truthy objects, so a presence-only or type-only check produces false positives on every cleanly-ended encounter. -->
	<<set _liveNpcCount to (Array.isArray($NPCList) ? $NPCList.filter(npc => isLiveNPC(npc)).length : 0)>>

	<h3>지역 정보</h3>

	<br>
	Tracked passages: <<print $_passages.length gt 0 ? $_passages.join(", ") : "None">>
	<br>

	<<if _eventValidationFailed>>
		<span class="red">EventSystem.validate() failed. The live event buffer and the current NPC state disagree.</span><br>
		<span class="yellow">This usually means a stale entry, a slot remap mismatch, or an uncleared event entry survived longer than it should have.</span>
		<<set _eventreason to true>>
	<<elseif _eventAlertMajorArea is true>>
		<span class="red">당신은 주요 지역에 있습니다. 즉 NPC가 탈출했습니다!</span>
		<<if $cheatsEnabled is true>>
			방금 치트를 사용했다면 이 메시지를 무시하세요. 그렇지 않다면, <span class="red">이것을 제보해 주세요!</span>
		<<else>>
			<span class="red">이것을 제보해 주세요!</span>
		<</if>>
		<<set _eventreason to true>>
	<<elseif _eventAlertMajorArea is false>>
		<span class="green">This NPC was defined in this passage.</span>
		<<set _eventreason to true>>
	<<else>>
		<<if $passage.includes("Street Stalk")>>
			<span class="green">당신은 스토킹당하고 있습니다. 대개 모든 것이 정상적으로 작동하고 있다는 뜻입니다.</span>
			<<set _eventreason to true>>
		<</if>>
		<<if $event isnot undefined>>
			<<if $_passages.includes($passage)>>
				<span class="green">당신은 NPC가 생성된 패시지에 있습니다.</span>
				<<set _eventreason to true>>
			<<else>>
				<<set _eventSubpassageMatch to false>>
				<<for $_p = 0; $_p lt $_passages.length; $_p++>>
					<<if $passage.includes($_passages[$_p])>>
						<<set _eventSubpassageMatch to true>>
						<<break>>
					<</if>>
				<</for>>
				<<if _eventSubpassageMatch>>
					<span class="green">당신은 NPC가 생성된 서브패시지에 있습니다. 대개 이들이 아직 사용 중이라는 뜻입니다.</span>
					<<set _eventreason to true>>
				<</if>>
			<</if>>
		<<else>>
			<span class="yellow">당신은 이벤트 중이 아닙니다.</span>
			<br>
		<</if>>
	<</if>>
	<<if !_eventreason>>
		<<if _liveNpcCount is 0>>
			<span class="green">No live NPCs are present. Remaining NPC list slots are empty padding from the last cleanup. Nothing needs clearing.</span>
		<<else>>
			<span class="yellow">어느 시점에서 생성된 NPC가 정리되지 않았을 수 있습니다. 해당 NPC는 여전히 사용 중일 수 있습니다. 활성화되지 않아야 한다고 생각된다면 제보해 주세요. 제보해야 할지 확신이 서지 않는다면 주요 지역(예: 거리/골목/야외)으로 가서 다시 확인하세요.</span>
		<</if>>
	<</if>>
	<br><br>
	<h3>NPC 정보</h3>
	<br>
	$enemyno 명의 NPC<<if $enemyno gt 1>>들이<<else>>【이가】<</if>> 현재 활성화되어 있습니다. 최대: $enemynomax. 해당 내역:<br><br>

	<div class="debug-event-container">
	<<for $_i to 0; $_i lt $NPCList.length; $_i++>>
		<<set $_npc to $NPCList[$_i]>>
		<<unset $_eventNPC>>
		<!-- Cleared slots are still truthy objects, so treating them as live here produced "Live NPC exists, but no valid event buffer entry" on every cleanly-ended encounter. -->
		<<set $_npcIsLive to isLiveNPC($_npc)>>
		<<if $event isnot undefined and $event.buffer isnot undefined>>
			<<for $_slotSearch = 0; $_slotSearch lt $event.buffer.length; $_slotSearch++>>
				<<if $event.buffer[$_slotSearch] and $event.buffer[$_slotSearch].slot is $_i>>
					<<set $_eventNPC to $event.buffer[$_slotSearch]>>
					<<break>>
				<</if>>
			<</for>>
		<</if>>
		<<if $_npcIsLive and $_eventNPC isnot undefined and $_eventNPC.area and $_eventNPC.area[0] isnot undefined and $_eventNPC.time isnot undefined>>
			<<set $_time to new DateTime($_eventNPC.time + V.startDate)>>
			<div class="debug-event-item debug-event-success">
				ID: $_i | $_npc.fullDescription<br>
				생물학적 성: $_npc.gender | 젠더: <<print KR.getPronounKr("man", $_npc.pronouns.man)>><br>
				설명: $_npc.description<<if $_npc.role>> | 역할: $_npc.role<</if>><br>
				출처: <<print $_eventNPC.area[0]>>, 시각: <<ampm $_time.getHours() $_time.getMinutes()>>.<br>
			</div>
		<<elseif $_npcIsLive>>
			<div class="debug-event-item debug-event-empty">
				ID: $_i | $_npc.fullDescription<br>
				<span class="yellow">Live NPC exists, but no valid event buffer entry is linked to this slot.</span>
			</div>
		<<else>>
			<div class="debug-event-item debug-event-empty">
				NPC 번호: $_i
			</div>
		<</if>>
	<</for>>
	</div>

	<<if $event isnot undefined and $event.buffer isnot undefined>>
		<br>추가 디버깅:<br>
		<<for $_i to 0; $_i lt $event.buffer.length; $_i++>>
			<<set $_eventNPC to $event.buffer[$_i]>>
			<<if $_eventNPC is undefined or $_eventNPC.slot is undefined or $_eventNPC.area is undefined or $_eventNPC.area[0] is undefined or $_eventNPC.time is undefined>>
				<div class="debug-event-item debug-event-empty">
					Event buffer index $_i is malformed.
					<<if $_eventNPC isnot undefined and $_eventNPC.slot isnot undefined>><br>Slot: <<print $_eventNPC.slot>><</if>>
				</div>
			<<else>>
				<<set $_time to new DateTime($_eventNPC.time + V.startDate)>>
				<<set $_widgetStack to $_eventNPC.area.length gt 1 ? $_eventNPC.area.slice(1) : []>>
				<<set $_legalBeastEvent to ($_widgetStack.includes("beastNEWinit") or $_widgetStack.includes("beastTrainGenerate") or $_widgetStack.includes("combatTrainAdvance"))>>
				<<if $NPCList[$_eventNPC.slot] and $NPCList[$_eventNPC.slot].fullDescription>>
					<<print $NPCList[$_eventNPC.slot].fullDescription>><br>
				<<else>>
					No description.<br>
				<</if>>
				<<if !isLiveNPC($NPCList[$_eventNPC.slot])>>
					<span class="red">This event entry points to slot <<print $_eventNPC.slot>>, but no live NPC exists there right now.</span><br>
				<</if>>
				패시지 <<print $_eventNPC.area[0]>>에서 <<ampm $_time.getHours() $_time.getMinutes()>>에 정의됨.<br>
				<<if $_eventNPC.area.length gt 1>>
					위젯 스택:
					<<for $_iStack = 0; $_iStack lt $_widgetStack.length; $_iStack++>>
						<<print "<<$_widgetStack[$_iStack]>>">><<if $_iStack isnot $_widgetStack.length - 1>>, <</if>>
					<</for>>
					<br>
					<<if $_legalBeastEvent>>
						<span class="green">Recognized beast-train lifecycle entry.</span><br>
					<</if>>
				<</if>>
				<<unset _eventnumberinpassage>>
				<<for $_j to 0; $_j lt $event.buffer.length; $_j++>>
					<<set $_eventNPC2 to $event.buffer[$_j]>>
					<<if $_eventNPC2 and $_eventNPC2.area and $_eventNPC2.area[0] isnot undefined and $_i isnot $_j and $_eventNPC.area[0] is $_eventNPC2.area[0]>>
						<<if _eventnumberinpassage is undefined>>
							<<set _eventnumberinpassage to 0>>
						<</if>>
						<<set _eventnumberinpassage += 1>>
					<</if>>
				<</for>>
				<<if _eventnumberinpassage isnot undefined>>
					<<print _eventnumberinpassage>> 명의 다른 NPC<<if _eventnumberinpassage isnot 1>>들<</if>>도 패시지 <<print $_eventNPC.area[0]>>에서 정의되었습니다.<br>
					<<unset _eventnumberinpassage>>
				<</if>>
				$$NPCList의 슬롯 <<print $_eventNPC.slot>>에 설정됨.<br>
				<<for $_j to 0; $_j lt $event.buffer.length; $_j++>>
					<<set $_eventNPC2 to $event.buffer[$_j]>>
					<<if $_eventNPC2 and $_eventNPC2.slot isnot undefined and $_i isnot $_j and $_eventNPC.slot is $_eventNPC2.slot>>
						<<if !$_legalBeastEvent>>
							<span class="red">Two live event entries are pointing at slot <<print $_eventNPC.slot>>.</span><br>
						<<else>>
							<span class="green">이 슬롯 재사용은 알려진 짐승 열차 재로드 경로와 일치합니다.</span><br>
						<</if>>
						<<break>>
					<</if>>
				<</for>>
				<br>
			<</if>>
		<</for>>
		페이즈: $phase
	<</if>>

	<<if $eventDebugHistory and $eventDebugHistory.length gt 0>>
		<br>
		<h3>Recent event debug history</h3>
		<<set _eventHistoryStart to Math.max(0, $eventDebugHistory.length - 6)>>
		<<for $_histI = _eventHistoryStart; $_histI lt $eventDebugHistory.length; $_histI++>>
			<<set $_histEntry to $eventDebugHistory[$_histI]>>
			<<if $_histEntry>>
				<<set $_histPassage to $_histEntry.area and $_histEntry.area.length gt 0 ? $_histEntry.area[0] : "Unknown">>
				<<set $_histTime to $_histEntry.detectedAt isnot undefined ? new DateTime($_histEntry.detectedAt + V.startDate) : 0>>
				<div class="debug-event-item debug-event-empty">
					Slot: <<print $_histEntry.slot>> | <<print $_histEntry.reason ? $_histEntry.reason : "Recorded debug entry">><br>
					Source: <<print $_histPassage>><<if $_histEntry.detectedIn isnot undefined>> | Detected in: <<print $_histEntry.detectedIn>><</if>><br>
					<<if $_histTime>>
						Detected at: <<ampm $_histTime.getHours() $_histTime.getMinutes()>><br>
					<</if>>
				</div>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

:: Foodstuff Prop Debug
<div class="gold">음식 소품 테스터</div>
<<set _foodstuffKeys to Object.keys(setup.foodstuff)>>
<<set _foodstuffKeys.sort()>>

<table class="customisable_table">
	<thead>
		<tr>
			<th>Icon</th>
			<th>Foodstuff</th>
			<th>Action</th>
		</tr>
	</thead>
	<tbody>
		<<for _i to 0; _i lt _foodstuffKeys.length; _i++>>
			<<set _foodstuffKey to _foodstuffKeys[_i]>>
			<<set _foodstuff to setup.foodstuff[_foodstuffKey]>>
			<tr>
				<td>
					<<foodstufficon _foodstuffKey>>
				</td>
				<td><<print _foodstuffKey>></td>
				<td>
					<<capture _foodstuffKey>>
						<<button _foodstuffKey>>
							<<wearProp _foodstuffKey>>
							<<updatesidebarimg>>
						<</button>>
					<</capture>>
				</td>
			</tr>
		<</for>>
	</tbody>
</table>
<br>
<<link [[Back Home|Bedroom]]>><</link>>

:: Caught Fish Prop Debug
<div class="gold">포획한 물고기 소품 테스터</div>
<<set _fishKeys to Object.keys(setup.fishing.lootTables.fish)>>
<<set _fishKeys.sort()>>

<table class="customisable_table">
	<tbody>
		<<for _i to 0; _i lt _fishKeys.length; _i++>>
			<<set _fishKey to _fishKeys[_i]>>
			<tr>
				<td>
					<<icon setup.fishing.lootTables.fish[_fishKey].icon>>
				</td>
				<td><<print _fishKey>></td>
				<td>
					<<capture _fishKey>>
						<<button _fishKey>>
							<<set _fishPropName to `caught_${_fishKey}`>>
								<<wearProp _fishPropName>>
							<<updatesidebarimg>>
						<</button>>
					<</capture>>
				</td>
			</tr>
		<</for>>
	</tbody>
</table>

