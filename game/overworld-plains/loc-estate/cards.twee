		<br>
	<<else>>
		<<if C.npc.Wren.pronoun is "f">>
			<span class="blue">치마 벗기: 더 높은 대담함 필요.</span>
		<<else>>
			<span class="blue">바지 벗기: 더 높은 대담함 필요.</span>
		<</if>>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.cars isnot 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 7>>
		<<link [[레미의 차를 망가뜨린다 (0:10)|Estate Cards Cars]]>><<pass 10>><<farm_aggro -15>><<set $estate.cards.cars to 1>><<set $estate.cards.daring -= 1>><</link>><<llaggro>><<ldaring>>
		<br>
	<<else>>
		<span class="blue">레미의 차 망가뜨리기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.window isnot 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 7>>
		<<link [[저택 창문을 깬다 (0:10)|Estate Cards Window]]>><<pass 10>><<estate_chaos 20>><<set $estate.cards.window to 1>><<set $estate.cards.daring -= 1>><</link>><<ggchaos>><<ldaring>>
		<br>
	<<else>>
		<span class="blue">저택 창문 깨기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.wren_top isnot 1 and $estate.cards.wren_under_top is 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 7>>
		<<if C.npc.Wren.pronoun is "f">>
			<<link [[브래지어를 벗는다|Estate Cards Under Top]]>><<set $estate.cards.daring += 2>><<set $estate.cards.wren_under_top to 0>><<arousal 600>><</link>><<ggdaring>><<garousal>>
		<<else>>
			<<link [[조끼를 벗는다|Estate Cards Under Top]]>><<set $estate.cards.daring += 2>><<set $estate.cards.wren_under_top to 0>><<arousal 600>><</link>><<ggdaring>><<garousal>>
		<</if>>
		<br>
	<<else>>
		<<if C.npc.Wren.pronoun is "f">>
			<span class="blue">브래지어 벗기: 더 높은 대담함 필요.</span>
		<<else>>
			<span class="blue">조끼 벗기: 더 높은 대담함 필요.</span>
		<</if>>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.cattle isnot 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 9>>
		<<link [[가축을 풀어준다 (0:10)|Estate Cards Cattle]]>><<pass 10>><<estate_chaos 20>><<set $estate.cards.cattle to 1>><<set $estate.cards.daring -= 1>><</link>><<ggchaos>><<ldaring>>
		<br>
	<<else>>
		<span class="blue">가축 풀어주기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.wren_bottoms isnot 1 and $estate.cards.wren_under_bottoms is 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 9>>
		<<if C.npc.Wren.pronoun is "f">>
			<<link [[팬티를 벗는다|Estate Cards Under Bottoms]]>><<set $estate.cards.daring += 2>><<set $estate.cards.wren_under_bottoms to 0>><<arousal 600>><</link>><<ggdaring>><<garousal>>
		<<else>>
			<<link [[브리프를 벗는다|Estate Cards Under Bottoms]]>><<set $estate.cards.daring += 2>><<set $estate.cards.wren_under_bottoms to 0>><<arousal 600>><</link>><<ggdaring>><<garousal>>
		<</if>>
		<br>
	<<else>>
		<<if C.npc.Wren.pronoun is "f">>
			<span class="blue">팬티 벗기: 더 높은 대담함 필요.</span>
		<<else>>
			<span class="blue">브리프 벗기: 더 높은 대담함 필요.</span>
		<</if>>
		<br>
	<</if>>
<</if>>

<<if $estate.cards.fire isnot 1>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 11>>
		<<link [[불을 지른다 (0:10)|Estate Cards Fire]]>><<pass 10>><<farm_aggro -30>><<estate_chaos 50>><<set $estate.cards.fire to 1>><</link>><<garousal>><<lllaggro>><<gggchaos>>
		<br>
	<<elseif _favoursRemaining is 1>>
		<!-- if this is the very last favour remaining, but daring is low - we let the player know about this option,
			 so that they realise they've mismanaged the daring and need to increase it again so that they can get all favours
			 we do not show this option if they haven't gotten all other favours first, though
		-->
		<span class="blue">불 지르기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<<if $xchange.remyChoicePill and !$wrenStealReversal>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 11>>
		<<link [[레미의 리버설 알약을 훔친다|Estate Cards Reversal]]>><<set $wrenStealReversal to true>><<set $estate.cards.daring -= 1>><<unset $xchange.remyChoicePill>><</link>><<ldaring>>
		<br>
	<<else>>
		<!-- always show the player this is an option they can build up to
		 -->
		<span class="blue">레미의 리버설 알약 훔치기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<<if $wrenBetReversal>>
	<<set _favoursRemaining += 1>>
	<<if $estate.cards.daring gte 11>>
		<<link [[리버설 알약을 요구한다|Estate Cards Reversal]]>><<set $estate.cards.daring -= 1>><</link>><<ldaring>>
		<br>
	<<else>>
		<!-- always show the player this is an option they can build up to
		 -->
		<span class="blue">리버설 알약 요구하기: 더 높은 대담함 필요.</span>
		<br>
	<</if>>
<</if>>

<!-- we could allow the player to announce victory earlier, too, but it makes sense to require ALL dares to be completed -->
<!-- we could also ignore the ones where we get Wren to get more daring with no actual benefit for us
	 since PC doesn't particularly care about Wren's state of undress
	 however, I figured I'll count them too since Wren being undressed definitely plays a role in them feeling defeated when the PC leaves -->
<<if _favoursRemaining is 0>>
	<i>더 이상 생각나는 소원이 없다는 것을 깨닫는다. 승리를 선언하여 게임을 끝낼 수 있다.</i>
	<<if $estate.cards.confiscatedClothes?.length gt 0>>
		<br>
		<span class="gold">렌이 패배감을 느껴 당신의 옷을 돌려주는 것을 고려할지도 모른다.</span>
	<</if>>
	<br>
	<<link [[승리를 선언한다|Estate Cards Player Victory]]>><<npcincr Wren dom -5>><</link>><<lldom>>
	<br>
<<else>>
	<span class="blue">먼저 다른 모든 소원을 요청해야 승리를 선언할 수 있습니다.</span>
<</if>>

:: Estate Cards Player Victory
<<effects>><<set $outside to 0>>
<<speechresolve>>

<<person1>>
<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
	"저-저는 이미 생각했던 모든 부탁을 다 했어요." 당신은 말한다.
<<elseif _speechAttitudeResolved is "docile">>
	"원하던 건 이미 다 부탁한 것 같아요." 당신이 조용히 말한다. "그러니... 이게 끝인가요?"
<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
	"더는 부탁할 게 없어요." 당신이 말한다. "그럼 게임은 끝난 건가요?"
<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "special")>>
	"당신에게서 원하는 건 전부 얻었어요." 당신은 히죽 웃으며 말한다. "아주 쪽쪽 빨아먹었죠. 게임은 끝났어요."
<<elseif _speechAttitudeResolved is "cruel">>
	"이 게임에서 짜낼 수 있는 건 다 짜냈어." 당신이 말한다. "이제 끝이야."
<<else>>
	"더는 부탁할 게 없어요. 그럼 게임은 끝난 건가요?" 당신은 말한다.
<</if>>

<br><br>

렌은 놀라서 <<his>> 눈썹을 치켜올린다. 당신의 말이 <<him>>의 허를 찌른 것 같다.
<br><br>
<<card_pot_collected>>

<<set $estate_cards_end to "pc_won">>

<<if $estate.cards.confiscatedClothes?.length gt 0>>
	<span class="gold">평소 같았으면 렌은 자신만만해서 당신의 옷을 돌려줄 생각조차 하지 않았겠지만, 지금이 기회일지도 모른다.</span>
	<br><br>

	<<link [[옷을 돌려달라고 말한다|Estate Cards Rebuy Clothing]]>><</link>>
	<br>
	<<link [[옷을 두고 떠난다|Estate Cards Player Victory Leave]]>><</link>>
<<else>>
	<<link [[떠난다|Estate Cards Player Victory Leave]]>><</link>>
<</if>>
<br>

:: Estate Cards Player Victory Leave
<<effects>>

"그래?" 렌이 말한다. <<his>> 얼굴에서 놀란 기색이 사라지고, 평소의 느긋한 미소가 돌아왔다.
<br><br>

"음, 우리가 막지는 않을게." <<he>>【이가】 말한다. "다시 게임하고 싶어지면, 어디로 와야 하는지 알지?"
<br><br>

<<if $estate.cards.confiscatedClothes?.length gt 0>>
	당신은 빼앗긴 옷을 남겨둔 채 밖으로 걸어 나간다.
<<else>>
	당신은 밖으로 걸어 나간다.
<</if>>
<<if $exposed gte 2>>
	산들바람에 몸이 떨린다.
<</if>>

<<estate_cards_finish>>
<br><br>

<<link [[다음|Estate]]>><<endevent>><</link>>

:: Estate Cards Rebuy Clothing
<<effects>><<set $outside to 0>>
<<speechresolve>>

<<he>>【이가】 무언가 말하기 전에, 당신은 말을 잇는다.
<br><br>

<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
	"마지막 부탁으로, 제, 제 옷 좀 돌려주실 수 있을까요?" 당신은 말한다.
<<elseif _speechAttitudeResolved is "docile">>
	"괜찮다면... 마지막 부탁으로 제 옷을 돌려받고 싶어요." 당신이 말한다.
<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
	"아직 마지막 부탁이 하나 남아 있어요." 당신이 말한다. "그걸로 제 옷을 돌려받고 싶어요."
<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "special")>>
	"마지막으로 하나 더 부탁할 게 있어... 내 옷, 돌려줘." 당신이 말한다. "내가 이미 이겼으니까, 그게 공평하잖아."
<<elseif _speechAttitudeResolved is "cruel">>
	"내 옷 돌려줘." 당신이 말한다. "충분히 재미 봤잖아."
<<else>>
	"마지막으로 부탁할 게 하나 있는데, 그걸로 제 옷을 돌려받고 싶어요." 당신은 말한다.
<</if>>

<br><br>
<<card_clothes_rebuy_calculate>>
<!-- calculates $estate.cards.clothesRebuyTerms -->

<<set _s1 to $estate.cards.confiscatedClothes.length gt 1 ? "이 넝마들?" : "이 넝마?">>
<<set _s2 to $estate.cards.confiscatedClothes.length gt 1 ? "옷더미" : "옷가지">>

<<person1>>
<<if $estate.cards.clothesRebuyTerms.price gt 0>>
	렌은 <<his>> 부하 중 한 명 옆에 놓인 _s2【을를】 나른하게 쳐다본다.
	<br><br>
<<else>>
	"_s1" 렌은 <<his>> 부하 중 한 명 옆에 놓인 _s2【을를】 살피며 말한다.
	<br><br>
<</if>>

<<His>> 얼굴이 환해지더니, <<his>> 눈에 교활한 빛이 번뜩이는 게 보인다. 잠시 숙고한 후, <<he>>【은는】 당신을 다시 쳐다본다.
<br><br>

<<link [[다음|Estate Cards Rebuy Clothing 2]]>><</link>>

:: Estate Cards Rebuy Clothing 2
<<effects>><<set $outside to 0>>

<<set _s1 to pluralise($estate.cards.confiscatedClothes.length, "기념품", "기념품")>>

<<if $estate.cards.clothesRebuyTerms.price gt 0>>
	<<set _s2 to $estate.cards.confiscatedClothes.length gt 1 ? "전부" : "그것">>
	"물론, 우리의 기념품을 돌려줄 수 있지. <<printmoney $estate.cards.clothesRebuyTerms.price>>라는 저렴한 가격에 말이야." 렌이 말한다. "_s2【을를】 다시 사는 것보다 훨씬 싼 거니까, 내가 관대하게 구는 거라고."
	<br><br>

	"하지만 그렇게 좋은 제안은 대가를 치러야 하는 법이지." 렌이 말한다. "내 친구들도 좀 즐길 자격이 있다고 생각하는데."
	<br><br>

	"네 입으로 저들을 만족시켜주면," <<he>>【이가】 말을 잇는다, "그 달콤한 거래를 하게 해주지."
	<br><br>
<<else>>
	"물론, 우리의 기념품을 돌려줄 수 있지." 렌이 말한다. "있잖아, 돈은 받지도 않을게."
	<br><br>

	"하지만 그런 선물은 대가를 치러야 하는 법이지." 렌이 말한다. "내 친구들도 좀 즐길 자격이 있다고 생각하는데."
	<br><br>

	"네 입으로 저들을 만족시켜주면," <<he>>【이가】 말을 잇는다, "다시 돌려받을 수 있을 거야."
	<br><br>
<</if>>

<<cards_oral_options>>

:: Estate Blackjack Lose
<<effects>><<set $outside to 0>>
<<blackjackEnd "loss">>
<<blackjackStart "Blackjack Finish">>

<<set $estate.cards.exposure to 3>>

<<blackjackResultText false>>
<<blackjackPostGameBettingResult false>>
<<cards_tease_result false>>

<<switch $estate.cards.desire>>
<<case "xchange_pink">>
	<<set _cards_desire to "xchange_pink">>
	"우리를 기다리게 하지 마. 난 참을성 있는 <<nnpc_gender "Wren">>【이가】 아니거든."
<<case "xchange_blue">>
	<<set _cards_desire to "xchange_blue">>
	"우리를 기다리게 하지 마. 난 참을성 있는 <<nnpc_gender "Wren">>【이가】 아니거든."
<<case "over_upper">>
	<<set _cards_desire to "strip">>
	<<cards_strip_text>>

	<<if $worn.over_upper.set is $worn.over_lower.set>>
		<<if $worn.upper.type.includes("naked") and $worn.lower.type.includes("naked")>>
			<<if $worn.under_upper.type.includes("naked") and $worn.under_upper.type.includes("naked")>>
				<br><br>
				<<set $estate.cards.exposure to 5>>
				<span class="pink">그들은 당신이 속옷도 없이 알몸이라는 사실을 모른다.</span>
			<<elseif $worn.under_upper.type.includes("naked") and ($player.sex is "f" or $player.gender_appearance is "f")>>
				<br><br>
				<<set $estate.cards.exposure to 4>>
				<span class="purple">그들은 당신이 상의를 입지 않았다는 사실을 모른다.</span>
			<<elseif $worn.under_lower.type.includes("naked")>>
				<br><br>
				<<set $estate.cards.exposure to 5>>
				<span class="pink">그들은 당신이 하의를 입지 않았다는 사실을 모른다.</span>
			<<else>>

			<</if>>
		<<elseif $worn.upper.type.includes("naked")>>
			<br><br>
			<<if $worn.under_upper.type.includes("naked") and ($player.sex is "f" or $player.gender_appearance is "f")>>
				<<set $estate.cards.exposure to 4>>
				<span class="purple">그들은 당신이 상의를 입지 않았다는 사실을 모른다.</span>
			<<else>>
				<<set $estate.cards.exposure to 3>>
				<span class="blue">그들은 당신이 속에 속옷만 입고 있다는 사실을 모른다.</span>
			<</if>>
		<<elseif $worn.lower.type.includes("naked")>>
			<br><br>
			<<if $worn.under_lower.type.includes("naked")>>
				<<set $estate.cards.exposure to 5>>
				<span class="pink">그들은 당신이 하의를 입지 않았다는 사실을 모른다.</span>
			<<else>>
				<<set $estate.cards.exposure to 3>>
				<span class="blue">그들은 당신이 속옷 위에 아무것도 걸치지 않았다는 사실을 모른다.</span>
			<</if>>
		<<else>>

		<</if>>
	<<else>>
		<<if $worn.upper.type.includes("naked")>>
			<br><br>
			<<if $worn.under_upper.type.includes("naked") and ($player.sex is "f" or $player.gender_appearance is "f")>>
				<<set $estate.cards.exposure to 4>>
				<span class="purple">그들은 당신이 상의를 입지 않았다는 사실을 모른다.</span>
			<<elseif $player.sex is "f" or $player.gender_appearance is "f">>
				<<set $estate.cards.exposure to 3>>
				<span class="blue">그들은 당신이 속에 속옷만 입고 있다는 사실을 모른다.</span>
			<</if>>
		<<else>>

		<</if>>
	<</if>>
<<case "over_lower">>
	<<set _cards_desire to "strip">>
	<<cards_strip_text>>
	<<if $worn.lower.type.includes("naked")>>
		<br><br>
		<<if $worn.under_lower.type.includes("naked")>>
			<<set $estate.cards.exposure to 5>>
			<span class="pink">그들은 당신이 하의를 입지 않았다는 사실을 모른다.</span>
		<<else>>
			<<set $estate.cards.exposure to 3>>
			<span class="blue">그들은 당신이 속에 속옷만 입고 있다는 사실을 모른다.</span>
		<</if>>
	<<else>>

	<</if>>
<<case "upper">>
	<<set _cards_desire to "strip">>
	<<cards_strip_text>>
	<<if $worn.upper.set is $worn.lower.set>>
		<<if $worn.under_upper.type.includes("naked") and $worn.under_lower.type.includes("naked")>>
			<br><br>
			<<set $estate.cards.exposure to 5>>
			<span class="pink">그들은 당신이 속옷도 없이 알몸이라는 사실을 모른다.</span>
		<<elseif $worn.under_upper.type.includes("naked") and ($player.sex is "f" and $player.gender_appearance is "f")>>
			<br><br>
			<<set $estate.cards.exposure to 4>>
			<span class="purple">그들은 당신이 상의를 입지 않았다는 사실을 모른다.</span>
		<<elseif $worn.under_lower.type.includes("naked")>>
			<br><br>
			<<set $estate.cards.exposure to 5>>
			<span class="pink">그들은 당신이 하의를 입지 않았다는 사실을 모른다.</span>
		<<else>>

		<</if>>
	<<else>>
		<<if $worn.under_upper.type.includes("naked") and ($player.gender_appearance is "f" or $player.sex is "f")>>
			<br><br>
			<<set $estate.cards.exposure to 4>>
			<span class="purple">그들은 당신이 상의를 입지 않았다는 사실을 모른다.</span>
		<<else>>

		<</if>>
	<</if>>
<<case "lower">>
	<<set _cards_desire to "strip">>
	<<cards_strip_text>>
	<<if $worn.under_lower.type.includes("naked")>>
