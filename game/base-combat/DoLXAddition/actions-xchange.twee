:: Combat Actions XChange Widgets [widget]
    <<widget "combat-apply-spike">>
        /* _args[0]: "anal" when the pill was pushed into the anus instead of swallowed. */
        <<set _spikeAnal to (_args[0] is "anal")>>
        <<set _isPure to false>>
        <<if !playerIsXChanged() and $xchange isnot undefined and ($xchange.combatPillingPureRatio !== undefined ? $xchange.combatPillingPureRatio : 0) gte 1>>
            <<set _pureRatio to ($xchange.combatPillingPureRatio !== undefined ? $xchange.combatPillingPureRatio : 0)>>
            <<set _isPure to (random(1, 100) lte _pureRatio)>>
        <</if>>

        <<if !playerMayBeSpiked()>>
            /* Carrying, or spiking switched off, since the pill was drawn. The dose still goes down, it just can't take hold. */
            <<if xchangeTherapyActive()>>
                /* The widget applies nothing here and prints the treatment's own line, so it doesn't need saying twice. */
                <<xchange-random-spike>>
            <<else>>
                <<if _spikeAnal>>
                    <br>알약이 몸속에서 녹아내리지만 <span class="blue">아무 일도 일어나지 않는다</span>. 어떤 효과가 있었든, 당신의 몸에는 듣지 않는다.<br><br>
                <<else>>
                    <br><span class="blue">알약을 삼키지만 아무 일도 일어나지 않는다</span>. 어떤 효과가 있었든, 당신의 몸에는 듣지 않는다.<br><br>
                <</if>>
            <</if>>
        <<elseif _isPure>>
            /* Clean Pink/Blue pill that the same as one from the Hospital. Picked by body sex: the assailant grabs whichever pill actually works on what's between your legs. */
            <<if $player.sex is "m">>
                <<xchange-pink 1>>
            <<else>>
                <<xchange-blue 1>>
            <</if>>
            <<if _spikeAnal>>
                <br>약국에서 파는 <span class="blue">평범한 X-체인지 알약</span> 같은 느낌이다. 다만 잘못된 곳으로 먹었을 뿐이다.<br><br>
            <<else>>
                <br>약국에서 파는 <span class="blue">평범한 X-체인지 알약</span> 같은 맛이다.<br><br>
            <</if>>
        <<else>>
            /* Suspicious pill: random extras (and side effects, if the toggle is on; handled inside xchange-random-spike). */
            <<xchange-random-spike "suppress">>
            <<if $xchange isnot undefined and ($xchange.spikeSideEffectsEnabled !== undefined ? $xchange.spikeSideEffectsEnabled : 1)>>
                <<if _spikeAnal>>
                    <br><span class="pink">알약이 타는 듯 뜨겁다.</span> 엉덩이 안쪽에서 녹아내리자 곧 피부가 아파오기 시작한다. 그 알약에 뭐가 들었든, 평범한 X-체인지 한 알 이상이었다.<<gstress>><<stress 4>><<gpain>><<pain 3>><br><br>
                <<else>>
                    <br>알약은 입안에 쓴맛을 남기고, 삼키는 순간 <span class="pink">목을 태운다</span>. 곧 피부가 아파오기 시작한다. 그 알약에 뭐가 들었든, 평범한 X-체인지 한 알 이상이었다.<<gstress>><<stress 4>><<gpain>><<pain 3>><br><br>
                <</if>>
            <<else>>
                <<if _spikeAnal>>
                    <br>알약은 평범한 X-체인지 알약과 느낌이 다르지만, <span class="pink">무엇이 더해졌는지는 알 수 없다</span>.<<trauma 3>><<gtrauma>><br><br>
                <<else>>
                    <br>알약은 평범한 X-체인지 알약과 맛이 다르지만, <span class="pink">무엇이 더해졌는지는 알 수 없다</span>.<<trauma 3>><<gtrauma>><br><br>
                <</if>>
            <</if>>
        <</if>>
        <<set $playerWasSpikedInEncounter to 1>>
    <</widget>>

    <<widget "combat-hand-on-xchange-pill">>
        <<set _hand to _args[0]>>
        <<set _rng to random(1, 100)>>
        <<set _assholeIsExposed to $worn.under_lower.type.includes("naked")>>
        /* Beast-type assailants have no clothes to pocket a pill in, and only monster people can talk. */
        <<set _pillNoPockets to ($enemytype is "beast")>>
        <<set _pillNoSpeech to (_pillNoPockets and $NPCList[_n]?.monster isnot "monster")>>

        <<if $playerWasSpikedInEncounter>>
            <<if _pillNoPockets>>
                당신이 이미 알약을 삼켰으니 더는 필요 없다는 듯, <<he>>【이가】 <span class="blue">자기 알약을 바닥에 떨어뜨린다</span>.
            <<else>>
                당신이 이미 알약을 삼켰으니 더는 필요 없다는 듯, <<he>>【이가】 <span class="blue">자기 알약을 주머니에 넣는다</span>.
            <</if>>
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
        <<elseif _rng gte 96>>
            <<if _pillNoPockets>>
                <<He>>【은는】 <span class="blue">마음을 바꿔</span> 알약을 떨어뜨린다.
            <<else>>
                <<He>>【은는】 <span class="blue">마음을 바꿔</span> 알약을 도로 주머니에 넣는다.
            <</if>>
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
        <<elseif $worn.face.type.includes("face_covering") or $worn.face.type.includes("gag")>>
            <<if _pillNoSpeech>>
                <<He>>【은는】 당신의 $worn.face.name【을를】 더듬으며 치워내려고 잡아당긴다. <<if $worn.face.integrity - 10 lte 0>><span class="purple">찢어지면서 벗겨진다.</span><</if>>
            <<else>>
                <<He>>【은는】 당신의 $worn.face.name【을를】 쳐다본다. "그게 방해되잖아. 벗어." <<he>>【은는】 그것을 힘껏 잡아당긴다. <<if $worn.face.integrity - 10 lte 0>><span class="purple">찢어지면서 벗겨진다.</span><</if>>
            <</if>>
            <<damageFaceCover 10>>
        <<elseif $mouthuse is 0>>
            <<if $rng gte 33>>
                <<if _pillNoSpeech>>
                    <<= either(
                        `<<He>>【은는】 알약을 당신의 입술에 갖다 대지만 <span class="purple">입술은 굳게 닫혀 있다</span>.`,
                        `<<He>>【은는】 알약을 당신의 입에 밀어 넣으려 한다. <span class="purple">당신은 입을 다문 채 버틴다</span>.`,
                        `<<He>>【은는】 알약을 당신의 얼굴에 눌러 대며 <span class="purple">입을 열기를 기다린다</span>.`
                    )>>
                <<else>>
                    <<= either(
                        `<<He>>【은는】 <span class="purple">알약을 얼굴 앞에 들이대며</span> 놀려댄다. "네 그 귀여운 엉덩이가 어떻게 될지 궁금한걸."`,
                        `<<He>>【은는】 알약을 억지로 당신의 입에 밀어 넣으려 하지만 <span class="purple">당신의 입술은 꽉 닫혀 있다</span>.`,
                        `<<He>>【은는】 알약을 당신의 입에 억지로 밀어 넣지만 <span class="purple">당신은 뱉어낸다</span>. "자꾸 힘들게 만들지 마, 이 <<bitch>>【아야】!"`,
                        `<<He>>【은는】 <span class="purple">손에 쥔 알약을 만지작거린다</span>. "너 같은 <<girls>>【이가】 이거 먹으면 걸레가 된다더라."`,
                        `<<He>>【은는】 알약을 당신의 입술에 대고 <span class="purple">입을 열도록 구슬린다</span>. "자, 어서... 진짜 기분 좋아질 거야. 약속할게."`,
                        `<<He>>【은는】 씩 웃으며 <span class="purple">알약으로 당신의 아랫입술을 톡톡 두드린다</span>. "이게 네 안에 들어가면, 네 몸이 어떻게 변하는지 보여주고 싶어서 애걸하게 될걸."`,
                        `<<He>>【은는】 <span class="purple">손가락 사이로 알약을 굴리며</span> 낮게 웃는다. "이거 먹고 나면 꽤 예뻐지겠는걸. 더 부드럽고, 더 음란하고, 더 쉽게."`,
                        `<<He>>【은는】 <span class="purple">알약을 당신의 입에 눌러 대며 비웃는다</span>. "그 앙다문 입 좀 풀어. 어차피 언젠간 삼키게 될 거고, 그러면 네가 어떤 장난감이 되는지 보게 되겠지."`
                    )>>
                <</if>>
            <<else>>
                /* forced pilling */
                <span class="pink"><<He>>【은는】 자기 알약을 당신의 목구멍 속으로 밀어 넣는다.</span>
                <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                <<combat-apply-spike>>
            <</if>>
        <<elseif $anususe is 0 and !playerChastity("anus")>>
            /* forced pilling */
            당신이 입을 닫고 지키는 데 정신이 팔렸다고 확신하고, <<he>>【은는】 대신 뒤쪽을 노린다. 눈 깜짝할 새에 <span class="pink">알약이 당신의 항문 안으로 쑥 들어간다</span>.
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
            <<combat-apply-spike "anal">>
        
        <<else>>
            <<if $mouthuse is "righthand" or $mouthuse is "lefthand">>
                <<if $mouthuse is "righthand">>
                    <<selectNpcWithPartInPosition "hand" "mouth">>
                <<else>>
                    <<selectNpcWithPartInPosition "lefthand" "mouth">>
                <</if>>
                <<if $NPCList[_n] is _npc>>
                    <<if $rng gte 66>>
                        <<if _pillNoSpeech>>
                                <<= either(
                                    `<<He>>【은는】 알약을 당신의 입술에 갖다 대지만 <span class="purple">입술은 굳게 닫혀 있다</span>.`,
                                    `<<He>>【은는】 알약을 당신의 입에 밀어 넣으려 한다. <span class="purple">당신은 입을 다문 채 버틴다</span>.`
                                )>>
                        <<else>>
                                <<= either(
                                    `<<He>>【은는】 <span class="purple">알약을 얼굴 앞에 들이대며</span> 놀려댄다. "네 그 귀여운 엉덩이가 어떻게 될지 궁금한걸."`,
                                    `<<He>>【은는】 알약을 억지로 당신의 입에 밀어 넣으려 하지만 <span class="purple">당신의 입술은 꽉 닫혀 있다</span>.`,
                                    `<<He>>【은는】 알약을 당신의 입에 억지로 밀어 넣지만 <span class="purple">당신은 뱉어낸다</span>. "자꾸 힘들게 만들지 마, 이 <<bitch>>【아야】!"`,
                                    `<<He>>【은는】 <span class="purple">손에 쥔 알약을 만지작거린다</span>. "너 같은 <<girls>>【이가】 이거 먹으면 걸레가 된다더라."`,
                                    `<<He>>【은는】 알약을 당신의 입술에 대고 <span class="purple">입을 열도록 구슬린다</span>. "자, 어서... 진짜 기분 좋아질 거야. 약속할게.`
                                )>>
                        <</if>>
                    <<elseif $anususe is 0 and !playerChastity("anus") and $rng gt 33>>
                        /* forced pilling */
                        당신이 입을 닫고 지키는 데 정신이 팔렸다고 확신하고, <<he>>【은는】 대신 뒤쪽을 노린다. 눈 깜짝할 새에 <span class="pink">알약이 당신의 항문 안으로 쑥 들어간다</span>.
                        <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                        <<combat-apply-spike "anal">>
                    <<else>>
                        /* forced pilling */
                        <span class="pink"><<He>>【은는】 자기 알약을 당신의 목구멍 속으로 밀어 넣는다.</span>
                        <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                        <<combat-apply-spike>>
                    <</if>>
                <<else>>
                    <<He>>【은는】 손에 든 알약을 만지작거리며 <span class="purple">먹일 기회를 노린다</span>.
                <</if>>
            <<else>>
                <<He>>【은는】 손에 든 알약을 만지작거리며 <span class="purple">먹일 기회를 노린다</span>.
            <</if>>
        <</if>>
        <<if $xchange._combatRecalcPending>>
            <<set $xchange._combatRecalcPending to false>>
        <</if>>

    <</widget>>

    <<widget "combat-pill-selection">>
        <<set _hand to _args[0]>>
        <<combat-set-hand-target _hand "xchange_pill">>
        /* This NPC's single carried pill is now in their hand. 
        Mark as no longer in pocket so that whacking or using it doesn't get re-rolled into another from nowhere. */
        <<if $NPCList[_n] isnot undefined>>
            <<set $NPCList[_n]._hasCombatPill to false>>
        <</if>>
    <</widget>>

    <<widget "leftpillwhack">>
        <<if $lefttarget isnot "self">>
            <<if $NPCList[$lefttarget].lefthand is "xchange_pill" or $NPCList[$lefttarget].righthand is "xchange_pill">>
                <<set _leftaction["Whack the pill away"] to "pillwhack">>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "rightpillwhack">>
        <<if $righttarget isnot "self">>
            <<if $NPCList[$righttarget].lefthand is "xchange_pill" or $NPCList[$righttarget].righthand is "xchange_pill">>
                <<set _rightaction["Whack the pill away"] to "pillwhack">>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectspillwhack">>
        <<if $leftaction is "pillwhack">>
            <<set $leftaction to 0>>
            <<personselect $lefttarget>>
            <<set $_target to $NPCList[$lefttarget]>>
            <<if $whackRandom and random(1,5) lte 2>>
                <<personselect $lefttarget>><<persons>> 손에서 알약을 <span class="brat">쳐내지 못한다</span>.
                <<brat 5 $lefttarget>>
            <<else>>
                <<if $_target>>
                    <<if $_target.lefthand is "xchange_pill">>
                        <<combat-reset-hand "left">>
                    <<elseif $_target.righthand is "xchange_pill">>
                        <<combat-reset-hand "right">>
                    <</if>>
                <</if>>
                당신은 <<personselect $lefttarget>><<combatpersons>> 손에서 알약을 쳐낸다. <<He>>【은는】 주먹을 꽉 쥔다.
                <<brat 10 $lefttarget>>
            <</if>>
        <</if>>

        <<if $rightaction is "pillwhack">>
            <<set $rightaction to 0>>
            <<personselect $righttarget>>
            <<set $_target to $NPCList[$righttarget]>>
            <<if $whackRandom and random(1,5) lte 2>>
                <<personselect $righttarget>><<persons>> 손에서 알약을 <span class="brat">쳐내지 못한다</span>.
                <<brat 5 $righttarget>>
            <<else>>
                <<if $_target>>
                    <<if $_target.lefthand is "xchange_pill">>
                        <<combat-reset-hand "left">>
                    <<elseif $_target.righthand is "xchange_pill">>
                        <<combat-reset-hand "right">>
                    <</if>>
                <</if>>
                당신은 <<personselect $righttarget>><<combatpersons>> 손에서 알약을 쳐낸다. <<He>>【은는】 주먹을 꽉 쥔다.
                <<brat 10 $righttarget>>
            <</if>>
        <</if>>
    <</widget>>