:: XChange NPC Targeted Actions Widgets [widget]

    <<widget "pickupXchangePill">>
        <<if $enemytype is "man">>
            <<set $_hand to _args[0]>>
            <<set $_pills to window.listUniqueCarriedXchangePills()>>

            <<if $_hand is "left" and ($lefttarget isnot "self" or $options.targetYourself is false or _targetnumber is 1)>>
                <<if $_pills.length gt 0>>
                    <<set _pillsLeft to {}>>

                    <<run $_pills.forEach(pill => {
                        if ($currentXchangePillRight is undefined or pill.name isnot $currentXchangePillRight.name){
                            _pillsLeft[pill.name] = pill;
                        }
                    })>>
                    <<if Object.keys(_pillsLeft).length gte 1>>
                        <<set _leftaction["Pick up pill:"] to "pickupXchangePill">>
                    <</if>>
                <</if>>
            <</if>>

            <<if $_hand is "right" and ($righttarget isnot "self" or $options.targetYourself is false or _targetnumber is 1)>>
                <<if $_pills.length gt 0>>
                    <<set _pillsRight to {}>>

                    <<run $_pills.forEach(pill => {
                        if ($currentXchangePillLeft is undefined or pill.name isnot $currentXchangePillLeft.name){
                            _pillsRight[pill.name] = pill;
                        }
                    })>>
                    <<if Object.keys(_pillsRight).length gte 1>>
                        <<set _rightaction["Pick up pill:"] to "pickupXchangePill">>
                    <</if>>
                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "heldXchangePill">>
        <<if _args[0] isnot undefined>>
            <<if _args[0] is "left">>
                /* rest */
                <<set _leftaction["Rest"] to "heldXchangePill">>

                /* Drop pill */
                <<set _leftaction["Pocket your pill"] to "dropXchangePill">>

                /* Pill the targeted NPC (non-pillable named NPCs slap it away on resolve) */
                <<if $lefttarget isnot undefined and $lefttarget isnot "self">>
                    <<set _actiontext to ($npcpillingasked is $lefttarget ? "Pill ": "Attempt to pill ")+$NPCList[$lefttarget].pronouns.him>>
                    <<set _leftaction[_actiontext] to "xchangePillOther">>
                <</if>>

                /* Pill yourself */
                <<if !playerIsXChanged() and ($lefttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
                    <<set _leftaction["Pill yourself"] to "xchangePillSelf">>
                <</if>>
            <</if>>

            <<if _args[0] is "right">>
                /* rest */
                <<set _rightaction["Rest"] to "heldXchangePill">>

                /* Drop pill */
                <<set _rightaction["Pocket your pill"] to "dropXchangePill">>

                /* Pill the targeted NPC (non-pillable named NPCs slap it away on resolve) */
                <<if $righttarget isnot undefined and $righttarget isnot "self">>
                    <<set _actiontext to ($npcpillingasked is $righttarget ? "Pill ": "Attempt to pill ")+$NPCList[$righttarget].pronouns.him>>
                    <<set _rightaction[_actiontext] to "xchangePillOther">>
                <</if>>

                /* Pill yourself */
                <<if !playerIsXChanged() and ($righttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
                    <<set _rightaction["Pill yourself"] to "xchangePillSelf">>
                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsPickupXchangePill">>
        /* Start with a pill on hand: Before combat do this: <<set $leftarm to "heldXchangePill">><<set $currentXchangePillLeft to clone(setup.pills[0])>> */
        /* That will effectively mimic this widget so that a player starts combat holding a pill */
        <<if $leftaction is "pickupXchangePill" and $rightaction is "pickupXchangePill" and $selectedXchangePillRight.name is $selectedXchangePillLeft.name>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to "heldXchangePill">>
                <<set $currentXchangePillRight to $selectedXchangePillRight>><<set $xchangePillReveal to 1>>
                당신은 $currentXchangePillRight.name 알약을 꺼내 오른손에 쥔다.
        <<else>>
            <<if $leftaction is "pickupXchangePill" and $selectedXchangePillLeft>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to "heldXchangePill">>
                <<set $currentXchangePillLeft to $selectedXchangePillLeft>><<set $xchangePillReveal to 1>>
                당신은 왼손으로 $currentXchangePillLeft.name 알약을 꺼낸다.
            <</if>>
            <<if $rightaction is "pickupXchangePill" and $selectedXchangePillRight>>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to "heldXchangePill">>
                <<set $currentXchangePillRight to $selectedXchangePillRight>><<set $xchangePillReveal to 1>>
                당신은 오른손으로 $currentXchangePillRight.name 알약을 꺼낸다.
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsDropXchangePill">>
        <<if $leftaction is "dropXchangePill" and $rightaction is "dropXchangePill">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
            당신은 알약들을 주머니에 넣는다.
            <<unset $currentXchangePillLeft>><<unset $currentXchangePillRight>>
        <<else>>
            <<if $leftaction is "dropXchangePill">>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                당신은 왼손에 든 $currentXchangePillLeft.name 알약을 주머니에 넣는다.
                <<unset $currentXchangePillLeft>>
            <</if>>
            <<if $rightaction is "dropXchangePill">>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                당신은 오른손에 든 $currentXchangePillRight.name 알약을 주머니에 넣는다.
                <<unset $currentXchangePillRight>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "xchange-pilled-descriptor">><<set _t to _args[0]>><<set _pilledHerm to !!($NPCList[_t].xchange and $NPCList[_t].xchange.hermEffect)>><<if ["Whitney","Robin","Kylar","Sydney","Bailey","Gwylan","Poppy"].includes($NPCList[_t].fullDescription)>><<set $speechpill to (_pilledHerm ? "herm" : 1)>><</if>><<= ($NPCList[_t].teen ? $NPCList[_t].pronouns.boy : $NPCList[_t].pronouns.man) + (_pilledHerm ? " sporting both a stiff cock and a needy pussy" : "")>><</widget>>

    <<widget "xchange-pilled-subject">><<set _sn to $NPCList[_args[0]]>><<if $NPCNameList.includes(_sn.fullDescription) or _sn.name is _sn.fullDescription>><<= _sn.fullDescription>><<else>>예전의 <<= _sn.fullDescription>><</if>><</widget>>

    <<widget "xchange-raul-pill-flavour">>
        <<if $statFreeze and $NPCList[_args[0]] and $NPCList[_args[0]].fullDescription is "Raul">>
            교본에는 이런 내용이 하나도 없다. 상상하고 있는 건 당신 쪽이니, <span class="purple">라울은 어쨌든 변한다</span>.
        <</if>>
    <</widget>>

    <<widget "xchange-pilled-fury">>
        <<set _ft to _args[0]>>
        <<if $NPCList[_ft].fullDescription is "Bailey">>
            <<personselect _ft>>
            <br><br>
            변화가 가라앉자 베일리가 꼼짝도 하지 않는다. <<He>>【은는】 <<his>> 낯선 몸을 천천히 한 번 내려다보고, 피해를 헤아리는 듯한 눈으로 다시 당신을 올려다본다. 짜증 난 베일리는 본 적 있다. 화난 베일리도 본 적 있다. 이런 모습은 처음이다.
            <<set _furyFreeHand to ($NPCList[_ft].lefthand is 0 ? "lefthand" : ($NPCList[_ft].righthand is 0 ? "righthand" : 0))>>
            <<set _furyCanChoke to $settings.asphyxiaLevel gte 1 and $nochoke isnot 1 and $neckuse isnot "hand" and !($worn.neck.name is "familiar collar" and $worn.neck.cursed is 1)>>
            <<if _furyFreeHand and _furyCanChoke>>
                "네가 방금 뭘 잃었는지 알기나 해?" <<His>> 손이 <span class="red">당신의 목을 홱 낚아채 조인다</span>. "이 값은 한 푼도 빠짐없이 네 가죽에서 받아내겠다."
                <<set $NPCList[_ft][_furyFreeHand] to "throat">><<set $neckuse to "hand">><<violence 4>>
            <<elseif _furyFreeHand>>
                <<He>>【은는】 당신의 머리카락을 한 움큼 움켜쥐고 <span class="red">머리를 뒤로 홱 젖힌다</span>. <<his>> 얼굴이 당신의 얼굴 바로 앞까지 다가온다. "이 대가는 치르게 될 거다. 이자까지 쳐서."
                <<set $NPCList[_ft][_furyFreeHand] to "hair">><<set $speechHair to 1>><<violence 3>>
            <<else>>
                <<He>>【은는】 <span class="red">머리채를 잡아 머리를 뒤로 젖힌다</span>, 눈물이 맺힐 만큼 세게. "이 대가는 치르게 될 거다. 한 시간 한 시간 전부."
                <<violence 3>>
            <</if>>
            <<set $enemyanger += 60>><<set $enemytrust -= 40>>
        <</if>>
    <</widget>>

    /* The pill fails to land. Two reasons, in order:
    - $statFreeze: a flashback, vision or dream. The scene already went the way it went, so the pill
      does nothing and the NPC has no reaction to give. Raul is exempt (see npcXchangePillable).
    - Otherwise a named NPC who refuses on their own account, and is angered by the attempt.
    _args[0] = "left"/"right" hand, _args[1] = target index. Resets the holding hand and unsets the held pill. */
    <<widget "xchange-pill-slap">>
        <<set _slapHand to _args[0]>><<set _slapTarget to _args[1]>><<set _slapFrozen to !!$statFreeze>>
        <<if _slapHand is "left">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<unset $currentXchangePillLeft>>
        <<else>>
            <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>><<unset $currentXchangePillRight>>
        <</if>>
        <<if _slapFrozen>>
            <<personselect _slapTarget>>
            당신은 <<his>> 입에 알약을 억지로 밀어 넣는다. <span class="purple">아무 일도 일어나지 않는다</span>. 이 모든 것은 현실이 아니고, 알약이 작용할 실체도 없다.
        <<elseif $NPCList[_slapTarget].fullDescription is "Whitney">>
            휘트니의 손이 홱 올라와 <span class="red">알약을 당신의 손아귀에서 완전히 쳐낸다</span>. "나한테 그딴 수작이 통할 줄 알아, 걸레야? 어림도 없어, 씨발."
            <<set $enemyanger += 50>><<set $enemytrust -= 30>>
        <<else>>
            <<= $NPCList[_slapTarget].fullDescription>>【이가】 사납게 으르렁거리며 <span class="red">당신 손에서 알약을 쳐낸다</span>. "그딴 거 치워!"
            <<set $enemyanger += 50>><<set $enemytrust -= 30>>
        <</if>>
    <</widget>>

    <<widget "effectsUseXchangePill">>
        <<if $leftaction is "xchangePillSelf" and $rightaction is "xchangePillSelf">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
            당신은 알약들을 삼키고 <span class="purple">변화에 몸을 맡긴다.</span>
            <<run $currentXchangePillLeft.effects.forEach(effect => {
                Wikifier.wikifyEval(effect);
            })>>
            <<run $currentXchangePillRight.effects.forEach(effect => {
                Wikifier.wikifyEval(effect);
            })>>
            <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
            <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
            <<unset $currentXchangePillLeft>><<unset $currentXchangePillRight>>
        <<else>>
            <<if $leftaction is "xchangePillSelf">>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                당신은 왼손에 든 $currentXchangePillLeft.name 알약을 삼키고 <span class="purple">변화에 몸을 맡긴다.</span>
                <<run $currentXchangePillLeft.effects.forEach(effect => {
                    Wikifier.wikifyEval(effect);
                })>>
                <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
                <<unset $currentXchangePillLeft>>
            <</if>>
            <<if $rightaction is "xchangePillSelf">>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                당신은 오른손에 든 $currentXchangePillRight.name 알약을 삼키고 <span class="purple">변화에 몸을 맡긴다.</span>
                <<run $currentXchangePillRight.effects.forEach(effect => {
                    Wikifier.wikifyEval(effect);
                })>>
                <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
                <<unset $currentXchangePillRight>>
            <</if>>
        <</if>>

        <<if $leftaction is "xchangePillOther">>
            <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
            <<if $npcpillingasked is $lefttarget>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                당신이 <<= KR.getPronounKr("him", $NPCList[$lefttarget].pronouns.him)>>에게 알약을 내밀자, <<= KR.getPronounKr("he", $NPCList[$lefttarget].pronouns.he)>>【이가】 <span class="lewd">입을 벌려</span> 당신이 먹여 주도록 내버려 둔다.
                변화는 순식간이다. <<xchange-pilled-subject $lefttarget>>【은는】 이제 한낱
                <<npc-select-xchange-target $lefttarget>>
                <<run $currentXchangePillLeft.npcEffects.forEach(npcEffect => {
                    Wikifier.wikifyEval(npcEffect);
                })>>
                <<xchange-pilled-descriptor $lefttarget>>.
                <<xchange-pilled-fury $lefttarget>>
                <<xchange-raul-pill-flavour $lefttarget>>
                <<unset $currentXchangePillLeft>>

            <<elseif not npcXchangePillable($lefttarget)>>
                <<xchange-pill-slap "left" $lefttarget>>

            <<else>>
                당신은<<= (!$NPCNameList.includes($NPCList[$lefttarget].fullDescription) and $NPCList[$lefttarget].name isnot $NPCList[$lefttarget].fullDescription) ? " 그":"">> $NPCList[$lefttarget].fullDescription에게 몸을 던지고, 한참 실랑이를 벌인 끝에

                <<set _physiquemin to ($NPCList[$lefttarget].skills.athletics - ($enemyhealthmax - $enemyhealth) * ($NPCList[$lefttarget].skills.athletics/$enemyhealthmax)) * 16>>
                <<set _physiquemax to 15000 - ($enemyhealthmax - $enemyhealth) * ($NPCList[$lefttarget].skills.athletics/$enemyhealthmax) * 16>>
                <<silently>><<physiquedifficulty _physiquemin _physiquemax>><</silently>>

                <<if $physiqueSuccess>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    <<= KR.getPronounKr("him", $NPCList[$lefttarget].pronouns.him)>>【을를】 제압하는 데 성공해 <span class="green"><<= KR.getPronounKr("his", $NPCList[$lefttarget].pronouns.his)>> 입에 알약을 밀어 넣어</span> 억지로 삼키게 한다.
                    변화는 순식간이다. <<xchange-pilled-subject $lefttarget>>【은는】 이제 한낱
                    <<npc-select-xchange-target $lefttarget>>
                    <<run $currentXchangePillLeft.npcEffects.forEach(npcEffect => {
                        Wikifier.wikifyEval(npcEffect);
                    })>>
                    <<xchange-pilled-descriptor $lefttarget>>.
                    <<xchange-pilled-fury $lefttarget>>
                    <<xchange-raul-pill-flavour $lefttarget>>
                    <<unset $currentXchangePillLeft>>

                <<elseif !playerIsXChanged() and playerMayBeSpiked()>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    <<= KR.getPronounKr("he", $NPCList[$lefttarget].pronouns.he)>>【이가】 당신을 제압하고 알약을 빼앗아 <span class="red">억지로 목구멍에 밀어 넣는다</span>.
                    <<run $currentXchangePillLeft.effects.forEach(effect => {
                        Wikifier.wikifyEval(effect);
                    })>>
                    <<unset $currentXchangePillLeft>>

                <<else>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    <<= KR.getPronounKr("he", $NPCList[$lefttarget].pronouns.he)>>【이가】 <span class="brat">당신의 손에서 알약을 쳐낸다</span>.
                    <<unset $currentXchangePillLeft>>

                <</if>>
            <</if>>
            
        <</if>>
        <<if $rightaction is "xchangePillOther">>
            <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
            <<if $npcpillingasked is $righttarget>>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                당신이 <<= KR.getPronounKr("him", $NPCList[$righttarget].pronouns.him)>>에게 알약을 내밀자, <<= KR.getPronounKr("he", $NPCList[$righttarget].pronouns.he)>>【이가】 <span class="lewd">입을 벌려</span> 당신이 먹여 주도록 내버려 둔다.
                변화는 순식간이다. <<xchange-pilled-subject $righttarget>>【은는】 이제 한낱
                <<npc-select-xchange-target $righttarget>>
                <<run $currentXchangePillRight.npcEffects.forEach(npcEffect => {
                    Wikifier.wikifyEval(npcEffect);
                })>>
                <<xchange-pilled-descriptor $righttarget>>.
                <<xchange-pilled-fury $righttarget>>
                <<xchange-raul-pill-flavour $righttarget>>
                <<unset $currentXchangePillRight>>

            <<elseif not npcXchangePillable($righttarget)>>
                <<xchange-pill-slap "right" $righttarget>>

            <<else>>
                당신은<<= (!$NPCNameList.includes($NPCList[$righttarget].fullDescription) and $NPCList[$righttarget].name isnot $NPCList[$righttarget].fullDescription) ? " 그":"">> $NPCList[$righttarget].fullDescription에게 몸을 던지고, 한참 실랑이를 벌인 끝에

                <<set _physiquemin to ($NPCList[$righttarget].skills.athletics - ($enemyhealthmax - $enemyhealth) * ($NPCList[$righttarget].skills.athletics/$enemyhealthmax)) * 16>>
                <<set _physiquemax to 15000 - ($enemyhealthmax - $enemyhealth) * ($NPCList[$righttarget].skills.athletics/$enemyhealthmax) * 16>>
                <<silently>><<physiquedifficulty _physiquemin _physiquemax>><</silently>>

                <<if $physiqueSuccess>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    <<= KR.getPronounKr("him", $NPCList[$righttarget].pronouns.him)>>【을를】 제압하는 데 성공해 <span class="green"><<= KR.getPronounKr("his", $NPCList[$righttarget].pronouns.his)>> 입에 알약을 밀어 넣어</span> 억지로 삼키게 한다.
                    변화는 순식간이다. <<xchange-pilled-subject $righttarget>>【은는】 이제 한낱
                    <<npc-select-xchange-target $righttarget>>
                    <<run $currentXchangePillRight.npcEffects.forEach(npcEffect => {
                        Wikifier.wikifyEval(npcEffect);
                    })>>
                    <<xchange-pilled-descriptor $righttarget>>.
                    <<xchange-pilled-fury $righttarget>>
                    <<xchange-raul-pill-flavour $righttarget>>
                    <<unset $currentXchangePillRight>>

                <<elseif !playerIsXChanged() and playerMayBeSpiked()>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    <<= KR.getPronounKr("he", $NPCList[$righttarget].pronouns.he)>>【이가】 당신을 제압하고 알약을 빼앗아 <span class="red">억지로 목구멍에 밀어 넣는다</span>.
                    <<run $currentXchangePillRight.effects.forEach(effect => {
                        Wikifier.wikifyEval(effect);
                    })>>
                    <<unset $currentXchangePillRight>>

                <<else>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    <<= KR.getPronounKr("he", $NPCList[$righttarget].pronouns.he)>>【이가】 <span class="brat">당신의 손에서 알약을 쳐낸다</span>.
                    <<unset $currentXchangePillRight>>

                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsAskNpcXchangePill">>
        <<if $mouthaction is "ask" and $askAction is "askXchangePill">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $asphyxiaLvl gte 2>>
				<<wheeze "알약을 먹이게 해 달라고 부탁">>
			<<else>>
				<<set $mouthactiondefault to "rest">>
                <<brat 5 demanding>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>><<unset $askAction>>
                당신은 <<him>>에게 알약을 먹이게 해 달라고 부탁한다.

                <<if $NPCList[$mouthtarget].fullDescription is "Whitney" and npcXchangePillable($mouthtarget)>>
                    <<set $npcpillingasked to $mouthtarget>><<He_Short>>【은는】 씩 웃으며 고개를 뒤로 젖힌다. <span class="green">재미있다는 듯 입을 벌려 받아들인다</span>.
                    <span class="gold">이제 저항 없이 <<him>>에게 알약을 먹일 수 있다.</span>

                <<elseif $role is "islander" and (!$islander_language or $islander_language lt 100)>>
                    <span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 그것을 <<if $enemyno gte 2>>무시한다<<else>>무시한다<</if>>.

                <<elseif $combatgoal is "strip">>
                    "<span class="pink">싫어</span>," <<if $enemyno gte 2>>그들이 웃는다<<else>><<he>>【이가】 웃는다<</if>>. <<if !playerIsXChanged()>>"오히려 내가 너한테 알약을 먹여야겠는데."<<else>>"꿈도 꾸지 마."<</if>>
                    
                <<elseif npcXchangePillable($mouthtarget) and combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription)>>
                    <<set $npcpillingasked to $mouthtarget>><span class="green"><<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다.</span>
                    <span class="gold">이제 저항 없이 <<him>>에게 알약을 먹일 수 있다.</span>

                <<elseif $enemyanger gte $enemyangermax * (2/5)>>
                    <<His>> 대답이 숨 한 번 쉴 새 없이 돌아온다. "<span class="red">멍청한 걸레</span> 주제에, 네가 뭘 부탁할 처지인 줄 알아?"

                <<else>> 
                    <<He>>【은는】 잠시 생각하는 듯 뜸을 들인다. <span class="red">"아니, 그건 별로 내키지 않는데."</span>
                
                <</if>>
			<</if>>
		<</if>>
    <</widget>>

    /* Reaction when the player reveals/brandishes an X-Change pill in combat.
       Called from init.twee when $xchangePillReveal is set. Mirrors the sextoy-reveal
       Uses $xchangePillWord (a story var) so the text survives the deferred event pool. */
    <<widget "npc-reaction-pill">>
        <<set $xchangePillWord to ($rightarm is "heldXchangePill" and $leftarm is "heldXchangePill" ? "알약" : "알약")>>

        <<if $enemyno gte 2>>
            <<set $speechPillState to $speechPillState or either("curious", "aroused", "wary", "angry")>>
            <<cleareventpool>>
            <<switch $speechPillState>>
                <<case "curious">>
                    <<addinlineevent>>그들이 당신 손에 든 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 숨김없는 호기심으로 바라본다.<</addinlineevent>>
                    <<addinlineevent>>그들이 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>에 흥미를 느끼고 자기들끼리 수군거린다.<</addinlineevent>>
                <<case "aroused">>
                    <<addinlineevent>>그들이 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 보고 씩 웃는다. 그 발상에 들떠 있다.<<set $enemyarousal += 40>><</addinlineevent>>
                <<case "wary">>
                    <<addinlineevent 0.5>>그들이 몸을 굳히고 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 경계하며 살핀다.<<set $enemytrust -= 30>><</addinlineevent>>
                <<default>>
                    <<addinlineevent 0.5>>그들이 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>에서 움찔 물러난다. "그거 우리한테서 치워!"<<set $enemyanger += 40>><<set $enemytrust -= 30>><</addinlineevent>>
            <</switch>>
            <<runeventpool>>
        <<elseif $NPCList[0] and npcXchangePillable(0) and ["Whitney", "Robin", "Kylar", "Sydney", "Bailey", "Gwylan", "Poppy"].includes($NPCList[0].fullDescription)>>
            /* Pillable named NPCs voice their own reaction in their speech file. */
            <<set $speechpillreveal to 1>>
        <<elseif $NPCList[0] and $NPCNameList.includes($NPCList[0].fullDescription)>>
            /* Named but not pillable (incl. Whitney when love/dom fails): they want nothing to do with it. */
            <<cleareventpool>>
            <<addinlineevent>><<He>>【은는】 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 알아보고 코웃음을 친다. "그걸 나한테 쓸 생각은 하지도 마."<<set $enemyanger += 20>><<set $enemytrust -= 20>><</addinlineevent>>
            <<runeventpool>>
        <<else>>
            <<set $speechPillState to $speechPillState or either("curious", "aroused", "wary", "angry")>>
            <<cleareventpool>>
            <<switch $speechPillState>>
                <<case "curious">>
                    <<addinlineevent>><<He>>【은는】 당신 손에 든 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 호기심 어린 눈으로 바라본다.<</addinlineevent>>
                    <<addinlineevent>><<He>>【은는】 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 살피며 무슨 속셈인지 가늠해 본다.<</addinlineevent>>
                <<case "aroused">>
                    <<addinlineevent>>당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 보자 <<His>> 숨이 가빠진다. 앞으로 벌어질 일에 들뜬 모양이다.<<set $enemyarousal += 50>><</addinlineevent>>
                    <<addinlineevent>><<He>>【은는】 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 보며 입술을 핥는다. "그거 재미있겠는데."<<set $enemyarousal += 40>><</addinlineevent>>
                <<case "wary">>
                    <<addinlineevent 0.5>><<He>>【은는】 당신의 속셈을 알 수 없다는 듯 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 경계하며 바라본다.<<set $enemytrust -= 30>><</addinlineevent>>
                <<default>>
                    <<addinlineevent 0.5>><<He>>【은는】 당신의 X-체인지 <<= $xchangePillWord is "pills" ? "알약들" : "알약">>【을를】 노려본다. "그거 나한테서 치워."<<set $enemyanger += 40>><<set $enemytrust -= 30>><</addinlineevent>>
            <</switch>>
            <<runeventpool>>
        <</if>>
    <</widget>>

<!--
Shared knot reaction. Prints the "locked together" narration plus a personality or situation-flavoured line for the NPC the player is knotted inside.
_args[0] = hole the knot caught in ("vagina" or "anus").
_args[1] = NPC index (defaults to the currently selected _n).
Callers must guard on playerIsXChanged() and $xchange.pill.alphaEffect and $player.penisExist. The widget also requires the encounter knot state, so an NPC orgasm cannot swell the player's knot by itself.
-->
<<widget "alphaKnotDialogue">>
	<!-- Print at most once per render: the speech path (on the player's orgasm) and the ejaculation path (on the NPC's) can both reach here in the same turn. -->
	<<if $alphaKnotSwollen and not _alphaKnotNarrated>>
	<<set _alphaKnotNarrated to true>>
	<<set _akHole to _args[0] is "vagina" ? "vagina" : "anus">>
	<<set _akIdx to _args[1] isnot undefined ? _args[1] : _n>>
	<<personselect _akIdx>>
	<!-- Resolve which reaction bank to use: named NPC, then situational encounter, else generic. -->
	<<if $NPCList[_akIdx] and setup.NPCNameList.includes($NPCList[_akIdx].fullDescription)>>
		<<set _knotKey to $NPCList[_akIdx].fullDescription>>
	<<elseif $NPCList[_akIdx] and $NPCList[_akIdx].type is "plant">>
		<<set _knotKey to "plant">>
	<<elseif $position is "wall" and ($walltype is "pillory" or $walltype is "cleanpillory")>>
		<<set _knotKey to "pillory">>
	<<elseif $position is "wall">>
		<<set _knotKey to "wall">>
	<<elseif $punishmentposition is "gloryhole" or $gloryhole>>
		<<set _knotKey to "gloryhole">>
	<<else>>
		<<set _knotKey to "">>
	<</if>>
	<!-- Opening narration. The plant has no pussy/ass to speak of, so it gets its own line. -->
	<<if _knotKey is "plant">>
		식물의 살집 있는 구멍이 당신의 자지 밑동에 부풀어 오른 혹을 꽉 물고 놓아주지 않는다.
	<<else>>
		<<He>>【은는】 당신의 혹이 부풀어 <<if _akHole is "vagina">><<his>> 보지<<else>><<his>> 엉덩이<</if>> 안에 걸리자 몸을 움찔 굳히고, 두 사람은 그대로 맞물려 버린다.
	<</if>>
	<<switch _knotKey>>
	<<case "Whitney">>
		<<print [
			`휘트니의 눈이 휘둥그레지더니, <<he>>【이가】 숨 가쁜 웃음을 터뜨린다. "뭐야 이거? 이게 뭐... 으윽—! 안에서 뭔가 방금 커졌잖아, 걸레야."`,
			`<<He>>【은는】 숨을 헐떡이면서도 웃음을 참지 못하고 몸을 비튼다. "내 안에 박혀 있으면 네가 주도권을 쥔 줄 알아? 귀엽네. 아—!"`,
			`<<He>>【은는】 혹이 부풀어 오르자 <<his>> 이를 악문다. "으윽—! 좋아, 그럼 계속 박혀 있어. 그만큼 가까이서 후회하게 해줄 수 있다는 뜻이니까."`,
			`<<He>>【은는】 당신의 등을 할퀴며 숨이 턱까지 차오른 채 웃고 있다. "너... 하! 진짜로 혹을 박은 거야? 배짱 한번 좋네, <<slut>>【아야】. 천천히 갚아 주지."`,
			`<<He>>【은는】 부푼 혹에 맞춰 몸을 흔들며 턱을 굳힌다. "그래, 이게 네 수작이네. 날 붙들어 두고 여기 가둬 놓겠다는 거지. 거의 마음에 드는데. 거의."`
		][random(0, 4)]>>
	<<case "Kylar">>
		<<print [
			`카일라가 헉 숨을 들이켜며 당신을 붙든다. "내 안에서 부풀고 있어! 우릴 하나로 묶고 있는 거야. 절-절대 빼지 마. 날 네 걸로 표시해줘. 난 네 거야."`,
			`<<He>>【은는】 몸을 거세게 떤다. "네 움찔거림이 하나하나 다 느껴져. 이게 사랑이지, 그렇지? 네가 나한테 혹을 박았어. 나한테. 이제 내 모든 게 네 거야."`,
			`카일라가 기쁨에 흐느끼며 혹 위로 몸을 비벼 내린다. "날 임신시켜줘, 가득 채워줘! 마지막 한 방울까지 내 것이 될 때까지는 절대 빼지 마."`,
			`카일라의 온몸이 당신을 감싸며 조여 오고, <<his>> 뺨 위로 기쁨의 눈물이 흐른다. "우리 붙어 버렸어. 정말로 붙어 버렸어. 원래 이래야 하는 거야! 너랑 나, 하나로 이어져서, 다른 사람은 영원히 없어."`,
			`<<He>>【은는】 당신의 목덜미에 얼굴을 파묻는다. "안쪽에서부터 날 네 걸로 만들었어. 네가 얼마나 놓아주지 않는지 정확히 느껴져. 영-영원히 이대로 붙잡아 줘."`
		][random(0, 4)]>>
	<<case "Robin">>
		<<print [
			`로빈이 훌쩍인다. "커, 커지고 있어...! 못—으응! 안 빠지는 거지, 그렇지? 제, 제발 살살 해줘..."`,
			`<<He>>【은는】 얼굴이 새빨개져 헐떡인다. "세상에, 우리—우리 붙어버렸어. 어, 어떡해야 할지 모르겠어, 그냥... 지나갈 때까지 안아줄래?"`,
			`로빈이 <<his>> 얼굴을 당신에게 파묻는다. "너무 벅차... 놓지만 마, 알았지? 이, 이렇게 있는 동안 네가 안아주면 안심이 돼."`,
			`<<He>>【은는】 작게 꺅 소리를 내더니 조용해지며 달라붙는다. "우, 우리 이제 계속 붙어 있어야 해? ...괜찮아. 너라면."`
		][random(0, 3)]>>
	<<case "Sydney">>
		<<print [
			`시드니가 눈을 크게 뜨고 숨을 들이켠다. "부풀고 있어, 움직일 수가 없어요...? 이, 이게 뭐죠? 하느님 용서하세요, 이렇게 갇혀 있는 게 왜 이렇게..."`,
			`<<He>>【은는】 공포와 더 따뜻한 무언가 사이에서 찢긴 채 몸을 떤다. "우리, 붙어 버렸어요. 이러면 안 돼요. 이건—으응! 왜 멈추길 바랄 수가 없는 걸까요?"`,
			`시드니의 숨결이 끊어진 기도에 걸린다. "밀어내야 해요, 밀어내야 하는데—아, 하지만 당신이 이렇게 깊이 박혀 있어서, 하늘이시여, 떠나지 않았으면 좋겠어요."`,
			`<<He>>【은는】 귀까지 붉어져 두 손을 속절없이 파닥인다. "안 빠져요... 우린 이어져서 떨어질 수 없어요, 둘 다 어쩔 수 없다면 그게 죄가 되는 걸까요?"`
		][random(0, 3)]>>
	<<case "Eden">>
		<<print [
			`에덴이 혹이 걸리자 낮게 으르렁거린다. "사냥감한테도 이빨이 있었군. 날 묶어 두겠다고? 대담하네."`,
			`<<He>>【은는】 이를 드러내고 씩 웃는다. "이제 붙었네, 도시 쥐새끼. 좋아. 둘 다 아무 데도 못 가."`,
			`에덴이 당신의 골반을 붙잡아 끌어당기며 야만스러운 웃음을 더 크게 짓는다. "늑대 안에 제 발로 갇혔네, 꼬마야. 일부러 그런 거겠지. 좋아."`,
			`<<He>>【은는】 만족스러운 듯 당신의 귓가에 콧김을 내뿜는다. "이제 도망치고 싶어도 못 가겠지. 난 이런 상대가 좋아. 자리 잡고 있어."`
		][random(0, 3)]>>
	<<case "Alex">>
		<<print [
			`알렉스가 작게 숨을 들이켜더니 당신을 진정시킨다. "천천히—앗! 우리 붙은 거지? 괜찮아. 같이 기다리면 돼."`,
			`<<He>>【은는】 얼굴을 붉히지만 부드럽게 웃는다. "이건... 꽤 대단한걸. 걱정 마, 서두를 거 없잖아. 내가 안고 있을게."`,
			`<<He>>【은는】 당신 둘레에 자리를 잡으며 관자놀이에 천천히 입을 맞춘다. "이제 숨 쉬고 가까이 붙어 있는 것 말고는 할 게 없네. 난 그게 딱 좋아."`
		][random(0, 2)]>>
	<<case "Leighton">>
		<<print [
			`<<He>>【은는】 몸이 굳으며 평정이 무너진다. "이런... 실로 추잡하군. 우리를 짐승처럼 한데 묶어 놓다니. 으윽—! 그렇게 만족스러운 얼굴 하지 마라!"`,
			`레이튼이 <<his>> 코로 날카롭게 숨을 내쉰다. "이건 극히 이례적인 일이다. 이제 내가 그냥 자리를 뜰 수 없다는 건 알겠지."`,
			`레이튼이 신중하게 숨을 고르며 <<his>> 뺨이 붉게 달아오른다. "이 일은 누구에게도 한마디 하지 마라. 알겠나? ...그리고 나 때문에 멈추지는 마라."`
		][random(0, 2)]>>
	<<case "Gwylan">>
		<<print [
			`그윌란이 천천히 숨을 내쉰다. "아. 이게 그 혹이로군. 대담하네. 한동안 여기 있게 생겼어."`,
			`<<He>>【은는】 서두르는 기색 없이 낮게 웃는다. "붙었다는 거지? 버둥거려 봐야 소용없어. 순리대로 흘러가게 두렴."`,
			`그윌란이 낮고 즐거운 콧노래를 흥얼거리며 뒤로 기대앉는다. "자. 이제 둘 다 매인 몸이야. 이보다 긴 기다림도 견뎌 봤단다..."`
		][random(0, 2)]>>
	<<case "Avery">>
		<<print [
			`에이버리의 미소가 흔들린다. "너—하! 꽤 문자 그대로 나한테 붙어 버렸군. 건방지기도 하지."`,
			`<<He>>【은는】 숨을 몰아쉬며 한쪽 눈썹을 치켜올린다. "날 이 자리에 묶어 두겠다고? 확실히 돈값은 하는 방법이군."`,
			`에이버리가 <<his>> 코로 숨을 내쉰다. "이래서야 떠나기가 영 어렵게 됐군. 그게 노린 거겠지."`
		][random(0, 2)]>>
	<<case "Morgan">>
		<<print [
			`모건이 숨을 가쁘게 내쉬며 달콤하게 속삭인다. "그래, 바로 그거야! 아, <<mummy>>는 네가 부풀어 오르는 게 느껴진단다. 있어야 할 자리에 꼭 붙어 있구나. 착한 <<charles>>."`,
			`<<He>>【은는】 몽롱하게 미소 짓는다. "이제 <<mummy>>한테 붙어 있어. 떠나려고 해도 못 떠나. 이게 훨씬 좋지 않니?"`,
			`모건이 두 다리로 당신을 감싸 안에 가둬 둔다. "쉿. 꿈틀거리지 마. <<Mummy>>는 네가 있어야 할 자리에 꽉 잠겨 있는 매 순간을 다 느끼고 싶단다."`
		][random(0, 2)]>>
	<<case "Zephyr">>
		<<print [
			`제퍼가 헐떡이면서도 낮게 휘파람을 분다. "하—! 대단한 물건이군. 날 꽉 묶어 놨어. 감탄했다."`,
			`<<He>>【은는】 이를 악문 채 씩 웃는다. "으윽—나쁘지 않군, <<lass>>【아야】. 내가 싫든 좋든 같이 열을 식히게 됐네."`,
			`제퍼가 가슴을 들썩이며 웃음을 흘린다. "대단한 마무리군. 이번엔 항복도 못 해... 그 혹이 풀릴 때까지 시계는 계속 돌아가. 지구력 훈련이라고 해 두지."`
		][random(0, 2)]>>
	<<case "Harper">>
		<<print [
			`하퍼의 숨이 잠시 걸리지만 <<his>> 어조는 여전히 차분하다. "흥미롭군요, 혹이 걸리는 반응이라니. 우리가 맞물린 것 같습니다. 지속 시간을 기록해 두겠습니다."`,
			`<<He>>【은는】 숨을 내쉰다. "불수의적 정체 현상이군요. 놀랍습니다. 가만히 계십시오. 이 현상의 깨끗한 자료를 얻고 싶습니다."`,
			`하퍼의 침착함이 무너진다. "맞물림 반사가 문헌에서 말하는 것보다 강하군요. 가라앉을 때까지는... 그저 꼼꼼하게 지켜보는 수밖에 없겠습니다."`
		][random(0, 2)]>>
	<<case "Bailey">>
		<<print [
			`베일리가 끙 소리를 낸다. "이게 대체...?! 네가 내 안에 처박혔잖아. 으윽. 이건 네 빚에서 까겠다."`,
			`<<He>>【은는】 헐떡임 사이로 비웃는다. "묶였다 이거지? 좋아. 어차피 내가 말하기 전엔 어디도 못 갔어."`,
			`베일리가 웃음을 터뜨린다. "꼴 좀 봐라, 제 빌어먹을 자지로 나한테 묶여 있네. 네가 이제까지 보인 것 중 제일 믿음직한 모습이군."`
		][random(0, 2)]>>
	<<case "gloryhole">>
		<<print [
			`당신의 혹이 구멍 속에 봉인되자 칸막이 너머에서 놀란 목소리가 새어 나온다. "이... 이게 뭐야? 박혀서 안 빠져!"`,
			`혹이 너무 굵게 부풀어 빠져나올 수 없게 되자, 벽 반대편에서 손가락들이 허둥지둥 긁어댄다. 저 뒤에 있는 누구든 어디로도 갈 수 없다.`,
			`반대편의 몸이 움찔하더니 굳는다. 글로리홀 너머에서 당신의 혹에 완전히 걸려 버렸다.`
		][random(0, 2)]>>
	<<case "wall">>
		<<print [
			`벽 너머에서 먹먹한 목소리가 겁에 질려 올라온다. "안... 왜 안 빠지는 거야?!" <<He>>【은는】 칸막이에 몸을 비틀지만 완전히 박혀 있다.`,
			`당신의 혹이 <<him>>【을를】 단단히 붙들자 <<he>>【은는】 벽 반대편에서 주먹으로 쾅쾅 두드린다. "놔줘! 대체 무슨 짓을 한 거야?!"`
		][random(0, 1)]>>
	<<case "pillory">>
		<<print [
			`<<He>>【은는】 당신의 자지에서 몸을 일으키려 하지만 혹이 <<him>>【을를】 붙들고 있어 그러지 못한다. "안 빠져! 형틀에 묶인 건 너면서 날 가두다니!"`,
			`<<He>>【은는】 형틀에 갇힌 바로 그 사람의 혹에 단단히 걸려 어쩔 줄 모르고 버둥댄다. "이건 창피하네. 우리 둘 다, 아무래도."`
		][random(0, 1)]>>
	<<case "plant">>
		<<print [
			`덩굴이 꿈틀거리며 더 단단히 감겨들고, 그것은 서두를 기색 없이 당신 둘레에서 느리게 맥동한다.`,
			`구멍이 고동치며 조여 들어 당신의 자지를 안에 가두고, 수액에 젖은 촉수들이 두 사람을 단단히 붙들고 있다.`
		][random(0, 1)]>>
	<<default>>
		<<if $enemyanger lte 40>>
			"조심해... 부풀어 오르는 게 느껴져."
		<<elseif $enemyanger lte 100>>
			"내 안에 박혀 버렸잖아!"
		<<else>>
			"그렇다고 거기 계속 있어도 된다고 생각하지 마."
		<</if>>
	<</switch>>
	<!-- NPCs that support a lust stat gain 3 lust from being knotted. Situational/unnamed targets aren't whitelisted, so they're skipped. -->
	<<if _knotKey and setup.lustWhitelist.includes(_knotKey)>>
		<<npcincr _knotKey lust 3>>
	<</if>>
	<</if>>
<</widget>>
