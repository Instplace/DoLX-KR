	<<print either(
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>> 끝에 <<oraltext>> 입을 맞춘다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>> 끝에 입술을 <<oraltext>> 스친다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>> 머리에 <<oraltext>> 키스한다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>> 끝에 <<oraltext>> 천천히 입맞춤을 남긴다."
	)>>
	<<if $NPCList[$mouthtarget].type is "plant">>
		<span class="pink">당신은 혀로 달콤한 넥타르를 핥아먹는다.</span>
		<<nectarfed 8>>
	<</if>>
<</widget>>

<<widget "actionspenislick">>
	<<print either(
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 <<oraltext>> 핥는다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 따라 혀를 <<oraltext>> 훑는다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 <<oraltext>> 핥아먹는다.",
		"당신은 <<their _args[0]>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 혀로 <<oraltext>> 애태운다."
	)>>
	<<if $NPCList[$mouthtarget].type is "plant">>
		<span class="pink">당신은 혀로 달콤한 넥타르를 핥아먹는다.</span>
		<<nectarfed 8>>
	<</if>>
<</widget>>

<<widget "actionspenissuck">>
	<<if $enemytype is "beast">>
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<= [
				"<<beasttype>>【이가】 맹렬하게 박아대는 동안, 당신은 입을 침범한 자지를 <<oraltext>> 빤다.",
				"<<beasttype>>【이가】 사납게 입에 자지를 내리꽂는 동안, 당신은 <<oraltext>> 계속 빤다.",
				"<<beasttype>>【이가】 야수 같은 급박함으로 찔러 대는 동안, 당신은 입을 채운 자지를 <<oraltext>> 주무른다."
			].random()>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<= [
				"<<beasttype>>【이가】 흥분해서 당신의 얼굴에 허리를 비벼대는 동안, 당신은 입을 침범한 자지를 <<oraltext>> 빤다.",
				"<<beasttype>>【이가】 열심히 당신의 얼굴에 허리를 튕기는 동안, 당신은 입술로 자지를 <<oraltext>> 감싼 채 놓지 않는다.",
				"<<beasttype>>【이가】 흥분을 키우며 몸을 비벼대는 동안, 당신은 입 속의 자지를 <<oraltext>> 빤다."
			].random()>>
		<<else>>
			<<= [
				"당신은 입을 꿰뚫는 자지를 <<oraltext>> 빤다.",
				"당신은 입 속의 자지에 입술을 <<oraltext>> 놀린다.",
				"당신은 입을 채운 자지를 따라 <<oraltext>> 머리를 오르내린다."
			].random()>>
		<</if>>
	<<else>>
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<= [
				"<<theowner>>【이가】 당신을 향해 허리를 밀어붙이는 동안, 당신은 입을 침범한 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 빤다.",
				"<<theowner>>【이가】 당신의 입술 사이로 파고드는 동안, 당신은 입 속의 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 계속 빤다.",
				"<<theowner>>【이가】 당신을 향해 앞으로 밀어붙이는 동안, 당신은 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 더 깊이 받아들인다."
			].random()>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<= [
				"<<theowner>>【이가】 당신에게 몸을 비비는 동안, 당신은 입을 침범한 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 빤다.",
				"<<theowner>>【이가】 당신의 얼굴에 몸을 문지르는 동안, 당신은 입술로 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 감싼 채 놓지 않는다.",
				"<<theowner>>【이가】 열심히 당신에게 몸을 움직이는 동안, 당신은 입 속의 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 주무른다."
			].random()>>
		<<else>>
			<<= [
				"당신은 입을 꿰뚫는 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 <<oraltext>> 빤다.",
				"당신은 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 입으로 <<oraltext>> 주무른다.",
				"당신은 <<= npcHasStrapon($mouthtarget) ? '페니스 밴드' : '자지'>>【을를】 입술로 <<oraltext>> 감싼 채 놓지 않는다."
			].random()>>
		<</if>>
	<</if>>
	<<if $NPCList[$mouthtarget].type is "plant">>
		<span class="pink">달콤한 넥타르가 입 안으로 뚝뚝 떨어진다.</span>
		<<nectarfed 12>>
	<</if>>
<</widget>>

<<widget "actionspussylick">>
	<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
		<<= [
			"<<theowner>>【이가】 당신에게 몸을 비비는 동안, 당신은 입에 눌린 보지를 <<oraltext>> 핥는다.",
			"<<theowner>>【이가】 더 세게 짓누르는 동안, 당신은 입 위의 보지를 가로질러 혀를 <<oraltext>> 훑는다.",
			"<<theowner>>【이가】 집요하게 당신에게 밀어붙이는 동안, 당신은 입을 틀어막은 보지를 <<oraltext>> 핥아먹는다."
		].random()>>
	<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
		<<= [
			"<<theowner>>【이가】 당신에게 몸을 문지르는 동안, 당신은 입에 눌린 보지를 <<oraltext>> 핥는다.",
			"<<theowner>>【이가】 흥분해서 당신에게 몸을 움직이는 동안, 당신은 얼굴 위의 보지를 혀로 <<oraltext>> 주무른다.",
			"<<theowner>>【이가】 당신의 입에 몸을 비비는 동안, 당신은 입술에 닿은 보지를 <<oraltext>> 애태운다."
		].random()>>
	<<else>>
		<<= [
			"당신은 입에 눌린 보지를 <<oraltext>> 핥는다.",
			"당신은 입을 틀어막은 보지를 <<oraltext>> 핥아먹는다.",
			"당신은 입술 위에 놓인 보지를 혀로 <<oraltext>> 애태운다."
		].random()>>
	<</if>>
	<<if $NPCList[$mouthtarget].type is "plant">>
		<span class="pink">당신은 혀로 달콤한 넥타르를 핥아먹는다.</span>
		<<nectarfed 8>>
	<</if>>
<</widget>>

<<widget "actionsoraledge">>
	<<if $pleasure gte ($pleasuremax / 5) * 4>>
		당신은 입술을 파르르 떨며 <<oraltext>>
	<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
		당신은 신음을 억누르며 <<oraltext>>
	<<else>>
		당신은 <<oraltext>>
	<</if>>

	<<if $mouthuse.includes("penis")>>
		<<if $mouthstate is "imminent">>
			<<print either(
				"입술로 <<his>> <<= window.KR.getPenisDescKr($NPCList[$mouthtarget].penisdesc)>>【을를】 애태우며,",
				"<<his>> 기둥의 밑동에 혀를 굴리며,",
				"느리게 핥다가 날카롭게 핥기를 번갈아 가며,",
			"혀로 놀리듯 원을 그리며,"
			)>>
		<<else>>
			<<print either(
				"<<his>> 자지를 물고 빠는 속도를 다양하게 변화시키며,",
				"혀로 <<his>> 허리짓을 늦추며,",
				"입술을 오므려 <<his>> 기둥을 감싸며,",
			"혀로 <<his>> 길이를 따라 훑으며,"
			)>>
		<</if>>
	<<else>>
		<<print either(
			"느리게 핥다가 날카롭게 핥기를 번갈아 가며,",
			"<<his>> 클리토리스에 혀를 갖다 대며,",
			"<<his>> 클리토리스에 숨을 불어넣으며,",
			"혀를 놀리듯 <<his>> 주름 위로 튕기며,"
		)>>
	<</if>>

	<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
		<<print either(
			"절정의 문턱에서 <<him>>【을를】 멈춰 세운다.",
			"해방감을 <<his>> 손이 닿지 않는 곳에서 흔들어 댄다.",
			"<<his>> 갈망하는 몸을 고문한다.",
			"애타게 꿈틀대는 모든 움직임을 당신 뜻대로 쥐고 있다."
		)>>
	<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
		<<print either(
			"절정을 맞이하도록 천천히 <<him>>【을를】 달랜다.",
			"<<his>> 흥분이 부풀어 오르게 내버려 둔다.",
			"<<him>>【을를】 애타게 만든다.",
			"애타는 떨림 하나하나를 길게 끌어낸다."
		)>>
	<<else>>
		<<print either(
			"<<his>> 흥분을 통제한다.",
			"<<his>> 흥분을 억제한다.",
			"쾌락을 휘젓는다.",
			"<<his>> 커져 가는 욕구를 가지고 논다."
		)>>
	<</if>>
<</widget>>

<<widget "actionsAnalLick">>
	<<print either(
		"당신은 입에 눌린 엉덩이 골을 따라 <<oraltext>> 핥아 올리고 내린다",
		"당신은 입에 눌린 항문에 혀를 <<oraltext>> 집어넣는다",
		"당신은 입에 걸쳐진 항문을 혀로 <<oraltext>> 희롱한다",
		"당신은 입에 걸쳐진 항문을 혀로 <<oraltext>> 핥는다",
		"당신은 얼굴에 눌린 엉덩이 골을 따라 혀를 <<oraltext>> 움직인다",
		"당신은 입에 짓눌린 엉덩이 위로 혀를 쓸어 올린다"
	)>>
	<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
		그러자 <<theowner>>【은는】 반응하듯 천천히 당신의 얼굴에 엉덩이를 비빈다.
	<</if>>
<</widget>>

<<widget "actionsAnalKiss">>
	<<print either(
		"당신은 얼굴을 짓누르는 엉덩이 한쪽에 입 맞춘다.",
		"당신은 입에 눌린 엉덩이 골에 입 맞추기 시작한다.",
		"당신은 입을 짓누르는 항문에 입 맞춘다.",
		"당신은 입 위에 얹힌 항문에 연달아 입 맞춘다.",
		"당신은 얼굴을 누르는 엉덩이 골에 거듭 입 맞춘다.",
		"당신은 입 위에 얹힌 엉덩이를 따라 오래 머무는 입맞춤을 이어 간다."
	)>>
<</widget>>

<<widget "actionskissback">>
	<<personselect $mouthtarget>>
	<<if $mouthstate is "kissentrance">>
		<<print either(
			"당신은 <<hers>>의 입술에 입술을 부드럽게 스친다.",
			"당신은 <<his>> 입술에 부드러운 키스로 응한다.",
			"당신은 <<hers>>의 입술에 입술을 살며시 누른다."
		)>>
		<<if $player.virginity.kiss is true>>
			<<set $speechKissVirgin to 1>>
		<</if>>
		<<if $NPCList[$mouthtarget].mouth is "kissentrance">>
			<<if $npcrow.includes($mouthtarget)>>
				<<takeKissVirginityNamed `$npc[$npcrow.indexOf($mouthtarget)]` true>>
			<<else>>
				<<takeKissVirginity $NPCList[$mouthtarget]>>
			<</if>>
			<<if _pcKissVirginityTaken>>
				<br><br>
			<</if>>
		<</if>>
	<<elseif $mouthstate is "kissimminent">>
		<<if $pleasure lte $pleasuremax / 5>>
			<<print either(
				"당신은 부드럽게 <<him>>에게 키스로 답한다.",
				"당신은 머뭇거리는 부드러움으로 키스에 답한다.",
				"당신은 <<his>> 키스에 부드럽게 화답한다."
			)>>
		<<elseif $pleasure lte ($pleasuremax / 5) * 4>>
			<<print either(
				"당신은 <<him>>에게 키스로 답하며 입술로 <<his>> 입술을 벌린다.",
				"당신은 입술로 <<his>> 입술을 벌리고 더 열렬히 키스로 답한다.",
				"당신은 <<his>> 입에 입을 맞추며 키스에 입을 연다."
			)>>
		<<else>>
			<<print either(
				"당신은 <<him>>에게 키스로 답하며 혀로 <<his>> 입술을 벌린다.",
				"당신은 굶주린 듯 혀를 휘감으며 키스에 답한다.",
				"당신은 키스를 깊게 하며 혀로 <<his>> 입을 애태운다."
			)>>
		<</if>>
		<<if $NPCList[$mouthtarget].type is "plant">>
			<span class="pink">달콤한 넥타르가 <<his>> 혀에서 떨어져 당신의 입을 채운다.</span>
			<<nectarfed 20>>
		<</if>>
	<<elseif $mouthstate is "kiss">>
		<<print either(
			"당신은 <<him>>에게 키스로 답하며 혀로 <<his>> 혀를 어루만진다.",
			"당신은 더 깊은 키스를 주고받고, 당신의 혀가 <<his>> 혀에 스친다.",
			"당신은 열렬히 키스에 답하며 혀로 <<his>> 혀를 애태운다."
		)>>
		<<if $NPCList[$mouthtarget].type is "plant">>
			<span class="pink">달콤한 넥타르가 <<his>> 혀에서 떨어져 당신의 입을 채운다.</span>
			<<nectarfed 20>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionshandbite">>
	<<personselect $mouthtarget>>
	<<if $transformationParts.traits.fangs isnot "disabled">>
		<<print either(
			"당신의 송곳니가 상대의 손을 찢고 파고든다.",
			"당신의 송곳니가 상대의 손 깊숙이 박힌다.",
			"당신은 송곳니로 상대의 손을 물어뜯는다.",
			"당신은 송곳니를 상대의 손에 박아 넣는다.",
			"당신은 송곳니로 상대의 손에 구멍을 낸다.",
			"당신의 송곳니가 <<his>> 손을 꽉 문다.",
		)>>
	<<else>>
		<<print either(
			"당신은 입을 틀어막은 손을 문다.",
			"당신은 입을 틀어막은 손을 갉아문다.",
			"당신은 상대의 손에 이를 박아 넣는다.",
			"당신은 상대의 손을 꽉 깨문다.",
			"당신은 이로 상대의 손을 으스러질 듯 깨문다.",
			"당신은 입을 막은 손을 콱 깨문다.",
		)>>
	<</if>>
<</widget>>

<<widget "actionscheekrub">>
	<<if $enemytype is "beast">>
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<= [
				"<<beasttype>>【이가】 맹렬하게 박아대는 동안, 당신은 엉덩이 사이에 자지를 끼고 <<bottomtext>> 비빈다.",
				"<<beasttype>>【이가】 세게 몸을 밀어붙이는 동안, 당신은 엉덩이 사이에 자지를 <<bottomtext>> 쥐어짠다.",
				"<<beasttype>>【이가】 야수 같은 급박함으로 허리를 튕기는 동안, 당신은 엉덩이 사이에서 자지를 <<bottomtext>> 주무른다."
			].random()>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<= [
				"<<beasttype>>【이가】 흥분해서 맞받아 허리를 놀리는 동안, 당신은 엉덩이 사이에 자지를 끼고 <<bottomtext>> 비빈다.",
				"<<beasttype>>【이가】 열심히 당신에게 몸을 비벼대는 동안, 당신은 엉덩이 사이에 자지를 가둔 채 <<bottomtext>> 놓지 않는다.",
				"<<beasttype>>【이가】 흥분을 키우며 당신 위에서 허리를 놀리는 동안, 당신은 엉덩이를 자지 위로 <<bottomtext>> 미끄러뜨린다."
			].random()>>
		<<else>>
			<<= [
				"당신은 엉덩이 사이에 자지를 끼고 <<bottomtext>> 비빈다.",
				"당신은 엉덩이 사이에 자지를 <<bottomtext>> 쥐어짠다.",
				"당신은 엉덩이로 자지를 감싸고 <<bottomtext>> 주무른다."
			].random()>>
		<</if>>
	<<else>>
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<= [
