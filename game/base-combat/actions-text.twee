									<<case 0>> "_Anonymous의 _dick【은는】 정말 짜릿해!"
									<<case 1>> "_Anonymous의 _dick【은는】 완전 꼴려!"
									<<case 2>> "_Anonymous의 _dick【은는】 정말 재밌어!"
								<</switch>>
						<<elseif $pleasure lte ($pleasuremax / 5) * 3>>
								<<switch random(0,3)>>
									<<case 0>> "_anonymous의 _dick【이가】 이렇게 기분 좋을 줄 누가 알았겠어?"
									<<case 1>> "이거 정말 기분 좋아!"
									<<case 2>> "난 _anonymous의 _dick【이가】 좋아!"
									<<case 3>> "계-계속... 그-그렇게... 해-해 줘!"
								<</switch>>
						<<else>>
							<<switch random(0,2)>>
								<<case 0>> "가-가기... 일보 직전이야!"
								<<case 1>> "거의... 그 _dick... 너-너무 좋아... 거의 가버릴 것 같아!"
								<<case 2>> "가버릴 것 같아!"
							<</switch>>
						<</if>>
					<<else>>
						<<if $pleasure lte $pleasuremax / 5>>
							<<if _speechAttitudeBase is "meek">>
								<<switch random(0,3)>>
									<<case 0>> "난 널 기쁘게 해주러 왔어."
									<<case 1>> "널 기분 좋게 만들어 줄게."
									<<case 2>> "널 섬길게."
									<<case 3>> "널 즐겁게 해주는 게 좋아."
								<</switch>>
							<<elseif _speechAttitudeBase is "bratty">>
								<<switch random(0,2)>>
									<<case 0>> "바로 내가 필요한 거야."
									<<case 1>> "정말 좋은 장난감이야!"
									<<case 2>> "이건 전부 내 거야."
								<</switch>>
							<<else>>
								<<switch random(0,1)>>
									<<case 0>> "내가 널 돌봐줄게."
									<<case 1>> "널 돌봐줄게."
								<</switch>>
							<</if>>
						<<elseif $pleasure lte ($pleasuremax / 5) * 2>>
							<<switch random(0,2)>>
								<<case 0>> "글로리홀은 정말 흥분돼!"
								<<case 1>> "글로리홀은 정말 흥분돼!"
								<<case 2>> "글로리홀은 정말 재밌어!"
							<</switch>>
						<<elseif $pleasure lte ($pleasuremax / 5) * 3>>
							<<switch random(0,3)>>
								<<case 0>> "글로리홀이 이렇게 기분 좋을 줄 누가 알았겠어?"
								<<case 1>> "이거 정말 기분 좋아!"
								<<case 2>> "이 글로리홀이 좋아!"
								<<case 3>> "계-계속... 그-그렇게... 해-해줘!"
							<</switch>>
						<<else>>
							<<switch random(0,2)>>
								<<case 0>> "거의... 가-가기... 일보 직전이야!"
								<<case 1>> "거의... 너-너무 좋아... 거-거의 가버릴 것 같아!"
								<<case 2>> "가버릴 것 같아!"
							<</switch>>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $pleasure lte $pleasuremax / 5 and not $gloryhole>>
					<<switch random(1,3)>>
						<<case 1>> "네가 날 이상하게 만들어."
						<<case 2>> "날 돌봐줄래?"
						<<case 3>> "넌 정말 강해!"
					<</switch>>
				<<elseif $pleasure lte ($pleasuremax / 5) * 3>>
					"네가 날 이상하게 만들어. 멈추지 마."
				<<else>>
					"머, 멈추지... 마..."
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionschoke">>
	당신은 <<voice "moan">>.
	<<if $NPCList[0].fullDescription is "Gwylan" and $rng gte 51>>
		"내 숨을 빼앗아 줘, 그윌란."
	<<elseif $awarelevel gte 2 or $choketrait is 1>>
		<<set _daddy to $enemyno is 1 and ["m", "f"].includes($NPCList[0].pronoun) and random(1, 4) is 1>>
		<<set _daddyText to ($NPCList[0].pronoun is "m" ? "daddy" : "mummy")>>
		<<print either(
			'"목 졸라줘' + (_daddy ? ', ' + _daddyText : '') + '."',
			'"내 목을 손으로 감싸줘' + (_daddy ? ', ' + _daddyText : '') + '."',
			'"더' + (_daddy ? ', ' + _daddyText : '') + '! 더 세게 졸라줘!"',
			'"' + (_daddy ? _daddyText.toUpperFirst() + ', ' : '') + '네가 내 목을 졸라줬으면 좋겠어."',
			'"제발, 내 목을 졸라줘!"',
			'"내 목을 움켜쥐어' + (_daddy ? ', ' + _daddyText : '') + '."',
			'"내 목을 쥔 손에 힘을 줘."'
		)>>
	<<else>>
		<<print either(
			'"내 목에 손을 올려 줄래?"',
			'"제발, 내 목을 잡아줘."',
			'"제발, 내 목에 손을 올려줘."',
			'"지난번에 목을 졸렸을 때 기분이 묘했어. 한 번 더 해줄래?"',
			'"내 목을 잡아줄래? 그 느낌을 다시 느끼고 싶어."',
			'"제발, 여기에 손을 올려줘."',
			'"여기를 잡아줘. 이상한데, 기분 좋아."'
		)>>
	<</if>>
<</widget>>

<<widget "actionsdemand">>
	<<checkforloveinterests>>

	<<if $robinRentEvent is 1 and ["Robin","pay","still"].includes($combatPhase)>>
		당신은 <<voice "demand">>.
		<<switch random(1,5)>>
			<<case 1>>
				"당장 로빈을 놔줘!"
			<<case 2>>
				"<<nnpc_him "Robin">>【을를】 놔줘, 베일리!"
			<<case 3>>
				"네가 <<nnpc_him "Robin">>【을를】 데려가게 두지 않을 거야!"
			<<case 4>>
				"나한테서 떨어져! 로빈을 돕게 해줘!"
			<<case 5>>
				<<if isLoveInterest("Robin")>>
					"다시는 <<nnpc_him "Robin">>에게 손대지 마!"
				<<else>>
					"감히 <<nnpc_him "Robin">>【을를】 다치게 하지 마!"
				<</if>>
		<</switch>>

	<<elseif $enemytype is "beast">>
		당신은 <<voice "demand">>.
		<<if _loveInterest is "Eden" and $location is "forest" and random(0,100) lte 15>>
			<<switch random(0,1)>>
				<<case 0>> "이 짓을 한 대가로 널 산 채로 껍질 벗길 사람을 내가 알아!"
				<<case 1>> "에덴이 네 가죽을 벗겨갈 거야, 이 저주받을 <<beasttype>>놈아."
