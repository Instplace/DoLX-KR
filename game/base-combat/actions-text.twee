:: Widgets Actions Text [widget]
<<widget "actionsmouththighrub">>
	<<if $enemytype is "beast">>
		<<if $enemyanger gte (($enemyangermax / 5) * 2)>>
			<<= [
				`당신은 허벅지를 <<beasttypes>> 입에 <<thightext>> 눌러 녀석을 막아낸다. 녀석은 당신이 원하는 것보다 조금 더 세게 깨문다. 혹시 당신을 먹이로 생각하는 건 아닐까 싶다.`,
				`당신은 <<beasttypes>> 턱 사이에 허벅지를 <<thightext>> 쑤셔 넣어 녀석을 막는다. 깨무는 힘이 느껴지자 녀석이 딴생각을 품은 건 아닐까 싶다.`,
				`당신은 허벅지를 <<beasttypes>> 입에 <<thightext>> 억지로 밀어 넣어 녀석의 입을 묶어 둔다. 이빨이 불편할 만큼 조금 세게 다물린다.`
			].random()>>
		<<else>>
			<<= [
				`당신은 허벅지를 <<beasttypes>> 입에 <<thightext>> 눌러 녀석을 막아낸다.`,
				`당신은 허벅지를 <<beasttypes>> 입에 <<thightext>> 갖다 대어 녀석의 입을 묶어 둔다.`,
				`당신은 허벅지를 방벽 삼아 <<beasttypes>> 주둥이를 <<thightext>> 계속 바쁘게 한다.`
			].random()>>
		<</if>>
	<<else>>
		<<if $pleasure gte ($pleasuremax / 5) * 4>>
			<<if $pain gte 40>>
				<<= [
					`당신은 떨리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 밀착시킨다.`,
					`당신은 떨리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 갖다 댄다.`,
					`당신은 떨리는 허벅지로 <<their _args[0]>> 입술을 <<thightext>> 계속 누른다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 파들거리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 밀착시킨다.`,
					`당신은 파들거리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 대고 있는다.`,
					`당신은 허벅지를 <<their _args[0]>> 입술에 <<thightext>> 댄 채 파들파들 떤다.`
				].random()>>
			<</if>>
		<<else>>
			<<if $pain gte 40>>
				<<= [
					`당신은 벌벌 떨리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 밀착시킨다.`,
					`당신은 벌벌 떨리는 허벅지를 <<their _args[0]>> 입에 <<thightext>> 대고 있는다.`,
					`당신은 허벅지가 벌벌 떨리지만 <<their _args[0]>> 입술에 <<thightext>> 단단히 받쳐 둔다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 허벅지를 <<their _args[0]>> 입에 <<thightext>> 밀착시킨다.`,
					`당신은 허벅지를 <<their _args[0]>> 입에 <<thightext>> 대고 있는다.`,
					`당신은 허벅지를 <<their _args[0]>> 입술에 <<thightext>> 얹어 둔 채 입술을 계속 바쁘게 한다.`
				].random()>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsothermouthpenistease">>
	<<if $enemytype is "beast">>
		<<if $pleasure gte ($pleasuremax / 5) * 4>>
			<<if $pain gte 40>>
				<<= [
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 조심스럽게 문지른다.`,
					`당신은 <<penis>>【을를】 <<beasttypes>> 혀 위로 <<peniletext>> 조심스럽게 훑는다.`,
					`당신은 <<penis>>【을를】 <<beasttypes>> 혀 위에서 <<peniletext>> 조심스레 움직인다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 문지른다.`,
					`당신은 <<penis>>【을를】 <<beasttypes>> 혀를 따라 <<peniletext>> 훑는다.`,
					`당신은 <<penis>>【을를】 <<beasttypes>> 혀 위에서 <<peniletext>> 움직인다.`
				].random()>>
			<</if>>
		<<else>>
			<<if $pain gte 40>>
				<<= [
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 조심스럽게 찌른다.`,
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 조심스레 슬쩍 건드린다.`,
					`당신은 <<penis>>의 끝으로 <<beasttypes>> 혀를 <<peniletext>> 조심스럽게 놀린다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 찌른다.`,
					`당신은 <<penis>>【으로로】 <<beasttypes>> 혀를 <<peniletext>> 슬쩍 건드린다.`,
					`당신은 <<penis>>의 끝으로 <<beasttypes>> 혀를 <<peniletext>> 놀린다.`
				].random()>>
			<</if>>
		<</if>>
	<<else>>
		<<if $pleasure gte ($pleasuremax / 5) * 4>>
			<<if $pain gte 40>>
				<<= [
					`당신은 <<penis>>【을를】 <<their _args[0]>> 혀에 <<peniletext>> 문지른다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 혀에 <<peniletext>> 훑는다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 혀 위에서 <<peniletext>> 움직인다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 <<penis>>【을를】 <<their _args[0]>> 혀에 <<peniletext>> 찰싹 때린다.`,
					`당신은 <<penis>>【으로로】 <<their _args[0]>> 혀를 <<peniletext>> 톡톡 친다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 혀에 <<peniletext>> 스치듯 문지른다.`
				].random()>>
			<</if>>
		<<else>>
			<<if $pain gte 40>>
				<<= [
					`당신은 <<penis>>【을를】 <<their _args[0]>> 뺨에 <<peniletext>> 문지른다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 뺨 위로 <<peniletext>> 훑는다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 뺨에 <<peniletext>> 갖다 댄다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 <<penis>>【을를】 <<their _args[0]>> 뺨에 <<peniletext>> 찰싹 때린다.`,
					`당신은 <<penis>>【으로로】 <<their _args[0]>> 뺨을 <<peniletext>> 톡톡 친다.`,
					`당신은 <<penis>>【을를】 <<their _args[0]>> 뺨을 따라 <<peniletext>> 스치듯 문지른다.`
				].random()>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

