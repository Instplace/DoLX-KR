<!-- Ideally, the parameters here should be replaced when the way the Great Hawk is generated changes. -->
<<widget "hawkText">><<silently>>
	<<if resolveIfNamedBeastIsMonster("greathawk")>>
		<<set _text_output to "하피">>
	<<else>>
		<<set _text_output to "매">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "checkforloveinterests">>
	<<set _loveInterest to Object.values($loveInterest).filter(li => li isnot "None").random()>>
<</widget>>

<<widget "speechvoice">>
	<<if _speechVoice is "plead">>
		<<voice "plead">>
	<<elseif _speechVoice is "demand">>
		<<voice "demand">>
	<<else>>
		<<voice "moan">>
	<</if>>
<</widget>>

<<widget "askrough">>
	<<speechresolve>>
	당신은 더 거칠게 다뤄달라고 <<speechvoice>>.

	<<if _speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 때려요. 난 맞아야 해요."
			<<case 1>> "나를 때려. 당신의 <<bitch>>【으로로】 만들어줘."
			<<case 2>> "내 분수를 가르쳐주세요."
			<<case 3>> "날 쓰레기처럼 다뤄."
			<<case 4>> "내가 꽥꽥대게 만들어줘."
			<<case 5>> "날 엉망으로 만들어."
			<<default>> "날 쓸모없는 돼지 취급해줘."
		<</switch>>
	<<elseif _speechAttitudeResolved is "polite">>
		<<switch $speechcycle>>
			<<case 0>> "제발 더 세게 때려 주세요."
			<<case 1>> "제발 저를 때려 주세요. 당신의 <<bitch>>【으로로】 만들어 주세요."
			<<case 2>> "제발 제 분수를 가르쳐 주세요."
			<<case 3>> "제발 저를 쓰레기처럼 다뤄 주세요."
			<<case 4>> "제발 제가 꽥꽥대게 만들어 주세요."
			<<case 5>> "제발 저를 엉망으로 만들어 주세요."
			<<default>> "제발 저를 쓸모없는 돼지처럼 다뤄 주세요."
		<</switch>>
	<<elseif _speechAttitudeResolved is "docile">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 때려. 난 견딜 수 있어."
			<<case 1>> "때려. 다 받아낼게."
			<<case 2>> "내 분수를 가르쳐주세요."
			<<case 3>> "날 쓰레기처럼 다뤄. 불평 안 할게."
			<<case 4>> "널 위해 꽥꽥대게 만들어줘."
			<<case 5>> "날 엉망으로 만들어. 얌전히 있을게."
			<<default>> "날 쓸모없는 돼지 취급해줘. 다 받아낼게."
		<</switch>>
	<<elseif _speechAttitudeResolved is "flamboyant">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 때려줘, 자기야."
			<<case 1>> "제발 날 때려줘. 날 네 <<bitch>>【으로로】 만들어줘."
			<<case 2>> "제발 내 분수를 가르쳐줘."
			<<case 3>> "제발 날 쓰레기처럼 다뤄줘."
			<<case 4>> "제발 날 꽥꽥대게 만들어줘, 자기야."
			<<case 5>> "제발 날 엉망으로 만들어줘."
			<<default>> "제발 날 쓸모없는 돼지 취급해줘, 자기야."
		<</switch>>
	<<elseif _speechAttitudeResolved is "bratty">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 치라고, 겁쟁이 새끼야."
			<<case 1>> "그게 다야?"
			<<case 2>> "가장 세게 때려봐."
			<<case 3>> "어디 한번 날 망가뜨려 봐."
			<<case 4>> "이게 최선이야?"
			<<case 5>> "때려보라고. 아니면 기운이 빠졌어?"
