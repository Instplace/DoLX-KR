		<</switch>>
	<</if>>
<</widget>>

<<widget "actionsothermouthanusescape">>
	<<if $enemytype is "beast">>
		<<if $enemyanger lte 20>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">골반을 비틀어, 녀석이 당신의 안을 뚫고 들어오기 전에 <<bottom>>【을를】 <<beasttypes>> 입에서 떼어낸다.</span> 하지만 녀석은 포기하지 않는다.
				<<case 1>><span class="blue">당신은 허리를 비틀어, 녀석이 달라붙기 전에 당신의 <<bottom>>【을를】 <<beasttypes>> 입에서 간신히 피한다.</span> 하지만 녀석은 포기하지 않는다.
			<</switch>>
		<<elseif $enemyanger lte 100>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">골반을 비틀어, 짐승이 당신의 안을 뚫고 들어오기 전에 쉴 새 없이 파고드는 그것에게서 <<bottom>>【을를】 떼어낸다.</span> 녀석은 좌절감에 으르렁거린다.
				<<case 1>><span class="blue">당신은 허리를 확 비틀어, 짐승의 끈질긴 입이 닿지 않는 곳으로 당신의 <<bottom>>【을를】 피한다.</span> 녀석은 좌절감에 으르렁거린다.
			<</switch>>
		<<else>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">골반을 비틀어, 짐승이 당신의 안을 뚫고 들어오기 전에 야만적으로 파고드는 그것에게서 <<bottom>>【을를】 떼어낸다.</span>
				<<case 1>><span class="blue">당신은 허리를 홱 빼, 짐승의 야만적인 아가리에서 당신의 <<bottom>>【을를】 끌어낸다.</span>
			<</switch>>
		<</if>>
	<<else>>
		<<if $pain lte 20>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">골반을 비틀어, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 떼어낸다.</span>
				<<case 1>><span class="blue">당신은 허리를 뒤로 빼, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 멀찍이 둔다.</span>
			<</switch>>
		<<elseif $pain lte 60>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">골반을 비틀어, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 떼어낸다.</span>
				<<case 1>><span class="blue">당신은 허리를 뒤로 당겨, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 빼낸다.</span>
			<</switch>>
		<<else>>
			<<switch random(0,1)>>
				<<case 0>><span class="blue">필사적으로 골반을 비틀어, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 떼어낸다.</span>
				<<case 1>><span class="blue">당신은 필사적으로 허리를 확 비틀어, 당신의 <<bottom>>【을를】 <<their _args[0]>> 입에서 떼어낸다.</span>
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionspenisstroke">>
	<<if $enemytype is "beast">>
		<<switch random(0,1)>>
			<<case 0>>당신은 조심스럽게 짐승의 자지를 쓰다듬는다.
			<<case 1>>당신은 짐승의 자지를 따라 조심스럽게 쓰다듬는다.
		<</switch>>
	<<else>>
		<<if _args[1] isnot undefined>>
			<<set $_target to "two">>
		<<elseif _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
		<<if $consensual is 1>>
			<<if $pleasure lte ($pleasuremax / 5) * 3>>
				<<switch random(0,1)>>
					<<case 0>>당신은 손을 뻗어 <<someones $_target>> 자지를 부드럽게 쓰다듬는다.
					<<case 1>>당신은 손을 뻗어 <<someones $_target>> 자지를 따라 부드럽게 쓰다듬는다.
				<</switch>>
			<<else>>
				<<switch random(0,1)>>
					<<case 0>>당신은 갈급하게 손을 뻗어 <<someones $_target>> 자지를 쓰다듬는다.
					<<case 1>>당신은 갈급하게 <<someones $_target>> 자지를 움켜쥐고 그 길이를 따라 쓰다듬는다.
				<</switch>>
			<</if>>
		<<else>>
			<<switch random(0,1)>>
				<<case 0>>당신은 조심스럽게 <<someones $_target>> 자지를 문지른다.
				<<case 1>>당신은 조심스레 <<someones $_target>> 자지를 쓰다듬는다.
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsStroke">>
	<<if _args.length lte 0>>
		<<error {
			message	: "Missing parameters for <<actionsStroke>> ",
			source	: "Called from: " + Utils.GetStack()
		}>>
	<</if>>
	<<if $enemytype is "beast">>
		<<= either(
			"당신은 <<beasttype>>의 머리를 쓰다듬는다.",
			"당신은 멍하니 <<beasttype>>의 머리를 쓰다듬는다.",
			"당신은 손을 뻗어 <<beasttype>>의 머리를 쓰다듬는다."
		)>>
	<<else>>
		<<if $pleasure gte $pleasuremax * 4/5>>
			<<= either(
				"욕망에 사로잡혀, 당신은 <<handtext>> 주무르는 손길로",
				"욕정에 홀린 듯, 당신은 <<handtext>> 주무르는 손길로",
				"숨을 쉴 때마다 깊은 한숨을 내쉬며, 당신은 <<handtext>> 주무르는 손길로",
				"갈증으로 몸이 타오르듯, 당신은 <<handtext>> 어루만지는 손길로"
			)>><<set _desire to 1>>
		<<elseif $pleasure gte $pleasuremax * 2/5>>
			<<= either(
				"점점 그 행위에 빠져들며, 당신은 <<handtext>> 주무르는 손길로",
				"점점 커지는 열의로, 당신은 <<handtext>> 주무르는 손길로",
				"서서히 열기를 더해 가며, 당신은 <<handtext>> 주무르는 손길로",
				"차오르는 허기로, 당신은 <<handtext>> 어루만지는 손길로"
			)>><<set _desire to 1>>
		<<else>>
			<<set _desire to 0>>
			<<= either(
				"당신은 <<handtext>> 쓰다듬는 손길로",
				"당신은 <<handtext>> 어루만지는 손길로",
				"당신은 <<handtext>> 두 손을 미끄러뜨려"
			)>>
		<</if>>
		<<if _args.length is 2 and _args[0] isnot _args[1]>>
			<<= either(
				"<<personselect _args[0]>><<persons>> 몸과 <<personselect _args[1]>><<persons>> 몸을 각각 한 손으로 어루만진다",
				"<<personselect _args[0]>><<persons>> 몸과 <<personselect _args[1]>><<persons>> 몸을 한 손에 하나씩 어루만진다",
				"두 몸을 한꺼번에, 한 손은 이쪽에 한 손은 저쪽에 두고 어루만진다"
			)>><<if random(0,1) and _desire>>. 그러면서 가끔 가슴과 엉덩이에 오래 머물기도 한다<</if>>.
		<<elseif $enemyno lte 1>>
			<<= either(
				"<<personselect _args[0]>><<his>> 몸을 어루만진다",
				"<<personselect _args[0]>><<his>> 몸 위로 손을 미끄러뜨린다",
				"<<personselect _args[0]>><<his>> 몸을 따라 손을 움직인다"
			)>><<if random(0,1) and _desire>>. 그러면서 <<his>> 가슴과 엉덩이에 가끔 오래 머물며 살결을 더듬기도 한다<</if>>.
		<<else>>
			<<= either(
				"<<personselect _args[0]>><<persons>> 몸을 어루만진다",
				"<<personselect _args[0]>><<persons>> 몸 위로 손을 미끄러뜨린다",
				"<<personselect _args[0]>><<persons>> 몸을 따라 손을 움직인다"
			)>><<if random(0,1) and _desire>>. 그러면서 <<his>> 가슴과 엉덩이에 가끔 오래 머물며 살결을 더듬기도 한다<</if>>.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionshit">>
	<<if _args[0] is "both">>
		<<set _hand to "양 손">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _hand to "손">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 때리려 하지만 녀석이",
					"당신은 _hand【을를】 <<beasttype>>에게 휘두르지만 녀석이"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<beasttype>>【을를】 때리려 하지만 녀석이",
					"이를 악물고 고통을 참으며, 당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 치려 하지만 녀석이"
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 <<beasttype>>에게 마구 팔을 휘두르려 하지만 녀석이",
