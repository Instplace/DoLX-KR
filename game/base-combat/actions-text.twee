				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때리려 하지만 상대가",
					"당신은 _hand【을를】 <<someone $_target>>에게 휘두르지만 상대가"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때리려 하지만 상대가",
					"억지로 고통을 참으며, 당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 후려치려 하지만 상대가"
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 자기방어를 위해 마구 팔을 휘두르려 하지만 상대가",
					"겁에 질려 아파하면서, 당신은 자기방어를 위해 마구 팔을 휘두르지만 상대가"
				)>>
			<</if>>
		<</if>>
		<<if $combatExtended.enemyCounterSuccess is 2>>
			<span class="red">반격한다</span>
		<<elseif $combatExtended.enemyDodgeSuccess is 2>>
			<span class="red">피한다</span>
		<<elseif $combatExtended.enemyCounterSuccess is 1>>
			<span class="red">일부 반격한다</span>
		<<else>>
			<span class="blue">일부 피한다</span>
		<</if>>.
	<<else>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.",
					"당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 철썩 때린다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.",
					"이를 악물고 고통을 참으며, 당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질려, 당신은 <<beasttype>>에게 마구 팔을 휘두른다.",
					"겁에 질려, 당신은 <<beasttype>>에게 마구 팔을 휘두른다."
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.",
					"당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 철썩 때린다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.",
					"고통을 뚫고, 당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 후려친다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질려, 당신은 자기방어를 위해 마구 팔을 휘두른다.",
					"겁에 질려, 당신은 자기방어를 위해 마구 팔을 휘두른다."
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

