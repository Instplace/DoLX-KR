		<<= [`<span class="blue">골반을 틀어 <<bottom>>【을를】 <<their>> <<= $_penises>>에서 떼어낸다.</span>`,`<span class="blue">허리를 비틀어 <<bottom>>【을를】 <<their>> <<= $_penises>>에서 빼낸다.</span>`,`<span class="blue"><<bottom>>【을를】 <<their>> <<= $_penises>>에서 멀찍이 비켜 놓는다.</span>`].random()>>
	<<elseif $pain lte 60>>
		<<= [`<span class="blue">골반을 틀어 <<bottom>>【을를】 <<their>> <<= $_penises>>에서 떼어낸다.</span>`,`<span class="blue">허리를 홱 돌려 <<bottom>>【을를】 <<their>> <<= $_penises>>에서 떼어낸다.</span>`,`<span class="blue">골반을 비틀어 <<their>> <<= $_penises>>【이가】 <<bottom>>에 닿지 못하게 막는다.</span>`].random()>>
	<<else>>
