<<widget "actionsguard">>
	<<if _args[0] is "both">>
		<<set _arm to "양팔">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _arm to "팔">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if currentSkillValue('physique') gte ($physiquesize / 7) * 5>>
		<<= either(
			"근육을 팽팽히 긴장시키며 재빨리 _arm【을를】 들어, 당신은 방어 자세를 취한다.",
			"당신은 _arm【을를】 홱 들어 올려 단단한 방어 자세 뒤로 몸을 숨긴다.",
			"능숙하고 재빠르게, 당신은 _arm【을를】 들어 올려 견고한 방어 자세를 취한다."
		)>>
	<<elseif currentSkillValue('physique') gte ($physiquesize / 7) * 3>>
		<<= either(
			"_arm【을를】 들어, 당신은 방어 자세를 취한다.",
			"당신은 _arm【을를】 몸 앞으로 들어 올린다.",
			"당신은 _arm【을를】 들어 올려 방어 자세를 잡는다."
		)>>
	<<elseif currentSkillValue('physique') gte ($physiquesize / 7) * 2>>
		<<= either(
			"_arm【을를】 들어, 당신은 허술하게 방어 자세를 취한다.",
			"당신은 간신히 _arm【을를】 들어 올려 불안한 방어 자세를 만든다.",
			"당신은 _arm【을를】 들어 올리지만 방어 자세가 허술해 보인다."
		)>>
	<<else>>
		<<= either(
			"당신은 _arm【을를】 힘없이 들어 간신히 방어 자세를 취한다.",
			"당신의 _arm【이가】 느릿느릿 올라와 힘없는 방어 자세만 겨우 만든다.",
			"당신은 _arm【을를】 앞으로 들어 올리지만, 방어는 거의 되지 않는다."
		)>>
	<</if>>
<</widget>>

<<widget "actionsfeint">>
	<<if _args[0] is "both">>
		<<set _hand to "양손">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _hand to "손">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 페인트 동작을 시도하지만 <<beasttype>>【이가】",
					"당신은 <<beasttype>> 쪽으로 한쪽을 속이는 동작을 취하지만, 녀석이"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 페인트 동작을 시도하지만 <<beasttype>>【이가】",
					"당신은 이를 악물고 고통을 참으며 <<beasttype>>【을를】 향해 페인트 동작을 취하지만, 녀석이"
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 필사적으로 페인트 동작을 시도하지만 <<beasttype>>【이가】",
					"필사적으로, 당신은 <<beasttype>>【을를】 향해 떨리는 페인트 동작을 취하지만, 녀석이"
				)>>
			<</if>>
			<<= either("속지 않고", "넘어가지 않고")>>
		<<else>>
			<<if $pain lte 20>>
				<<= either("당신은 페인트 동작을 시도하지만", "당신은 속임 동작을 취하지만")>>
			<<elseif $pain lte 60>>
				<<= either("당신은 고통을 이겨내고 페인트 동작을 시도하지만", "당신은 이를 악물고 고통을 참으며 페인트 동작을 시도하지만")>>
			<<else>>
				<<= either("고통과 공포에 질린 채, 당신은 필사적으로 페인트 동작을 시도하지만", "절박하고 아픈 몸으로, 당신은 페인트 동작을 시도하지만")>>
			<</if>>
			<<= either("그들은 속지 않고", "그들은 넘어가지 않고")>>
		<</if>>
		<<if $combatExtended.enemyCounterSuccess is 2>>
			<span class="red">반격한다</span>
		<<elseif $combatExtended.enemyDodgeSuccess is 2>>
			<span class="red">피한다</span>
		<<elseif $combatExtended.enemyCounterSuccess is 1>>
			<span class="red">일부 반격한다</span>
		<<else>>
			<span class="blue">일부 피한다</span>
		<</if>>.
	<<else>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 페인트 동작을 건 뒤, _hand【을를】 휘둘러 <<beasttype>>의 다른 곳을 때린다.",
					"당신은 <<beasttype>>【을를】 한쪽으로 유인한 뒤, _hand【으로로】 다른 곳을 스치듯 친다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 페인트 동작을 건 뒤, _hand【을를】 휘둘러 <<beasttype>>의 다른 곳을 때린다.",
					"고통을 견디며, 당신은 그럴듯하게 페인트 동작을 걸고 다른 각도에서 _hand【으로로】 <<beasttype>>【을를】 친다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 필사적으로 페인트 동작을 건 뒤 _hand【을를】 휘둘러 <<beasttype>>의 다른 곳을 때린다.",
					"필사적으로, 당신은 어설프게 페인트 동작을 걸지만 용케 _hand【으로로】 <<beasttype>>의 다른 곳을 맞힌다."
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 페인트 동작을 건 뒤, _hand【을를】 휘둘러 <<someone $_target>>의 다른 곳을 때린다.",
					"당신은 <<someone $_target>>의 균형을 무너뜨린 뒤, _hand【으로로】 다른 곳을 친다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 페인트 동작을 건 뒤, _hand【을를】 휘둘러 <<someone $_target>>의 다른 곳을 때린다.",
					"고통을 견디며, 당신은 그럴듯하게 페인트 동작을 걸고 _hand【으로로】 <<someone $_target>>의 다른 곳을 스치듯 친다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 페인트 동작을 건 뒤 _hand【을를】 휘둘러 <<someone $_target>>의 다른 곳을 때린다.",
					"필사적으로, 당신은 페인트 동작을 던지고 용케 _hand【으로로】 <<someone $_target>>의 다른 곳을 맞힌다."
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionshookpunch">>
	<<if _args[0] is "both">>
		<<set _hand to "양 주먹">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _hand to "주먹">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 훅 펀치를 날리려 몸을 젖히지만, <<beasttype>>【이가】",
					"당신은 <<beasttype>>【을를】 향해 훅을 휘두르지만, 녀석이"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 <<beasttype>>에게 훅 펀치를 날리려 하지만 녀석이",
					"고통을 이를 악물고 참으며, 당신은 <<beasttype>>【을를】 향해 훅을 휘두르지만, 녀석이"
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 <<beasttype>>에게 필사적으로 훅 펀치를 날리지만 녀석이",
					"필사적으로, 당신은 <<beasttype>>【을를】 향해 마구잡이 훅을 휘두르지만, 녀석이"
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 <<someone $_target>>에게 훅 펀치를 날리려 몸을 젖히지만 상대가",
					"당신은 <<someone $_target>>【을를】 향해 훅을 휘두르지만 상대가"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 <<someone $_target>>에게 훅 펀치를 날리려 하지만 상대가",
					"고통을 견디며, 당신은 <<someone $_target>>【을를】 향해 훅을 휘두르지만 상대가"
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 필사적으로 훅 펀치를 날리지만 상대가",
					"필사적으로, 당신은 마구잡이 훅을 휘두르지만 상대가"
				)>>
			<</if>>
		<</if>>
		<<if $combatExtended.enemyCounterSuccess is 2>>
			<span class="red">반격한다</span>
		<<elseif $combatExtended.enemyDodgeSuccess is 2>>
			<span class="red">그것을 예상하고 피한다</span>
		<<elseif $combatExtended.enemyCounterSuccess is 1>>
			<span class="red">일부 반격한다</span>
		<<else>>
			<span class="blue">피하지만 그래도 주먹에 스친다</span>
		<</if>>.
	<<else>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<beasttype>>에게 지독한 훅을 먹인다.",
					"당신의 _hand【이가】 날카로운 훅으로 <<beasttype>>【을를】 후려친다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<beasttype>>에게 훅 펀치를 날린다.",
					"당신은 이를 악물고 고통을 참으며 _hand【으로로】 <<beasttype>>에게 훅을 꽂아 넣는다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 <<beasttype>>에게 필사적인 훅을 적중시킨다.",
					"필사적으로, 당신은 거친 훅으로 <<beasttype>>【을를】 스치듯 가격한다."
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.",
					"당신의 훅이 <<someone $_target>>에게 꽂힌다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<someone $_target>>에게 훅 펀치를 날린다.",
					"고통을 견디며, 당신은 _hand【으로로】 <<someone $_target>>에게 훅을 꽂아 넣는다."
				)>>
			<<else>>
				<<= either(
					"고통과 공포에 질린 채, 당신은 필사적인 훅을 적중시킨다.",
					"필사적으로, 당신은 거친 훅을 꽂아 넣는다."
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsclitstroke">>
	<<if $consensual is 1>>
		<<if $pleasure lte ($pleasuremax / 5) * 3>>
			<<= either(
				"당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 쓰다듬는다.",
				"당신은 손끝으로 <<their _args[0]>> 클리토리스를 <<handtext>> 애태운다.",
				"당신은 손가락 사이에 <<their _args[0]>> 클리토리스를 끼우고 <<handtext>> 섬세하게 주무른다."
			)>>
		<<else>>
			<<= either(
				"흥분해서, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 애무한다.",
				"열렬히, 당신은 손끝으로 <<their _args[0]>> 클리토리스를 <<handtext>> 문지른다.",
				"굶주린 듯, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 만지작거린다."
			)>>
		<</if>>
	<<else>>
		<<= either(
			"달래 보려는 듯, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 쓰다듬는다.",
			"<<him>>【을를】 진정시키려는 듯, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 문지른다.",
			"당신은 조심스럽게 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 애태운다."
		)>>
	<</if>>
<</widget>>

<<widget "actionshandedge">>
	<<if $pleasure gte ($pleasuremax / 5) * 4>>
		<<print either(
			"가만히 있기는 힘들지만, 당신은 <<handtext>>",
			"떨리는 손으로, 당신은 <<handtext>>",
			"당신이 <<handtext>> 움직이자 손이 경련한다",
			"가까스로 자신을 억누르며, 당신은 <<handtext>>",
			"욕구에 몸을 떨며, 당신은 <<handtext>>"
		)>>
	<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
		<<print either(
			"당신이 <<handtext>> 움직이자 따뜻함이 팔 위로 퍼진다",
			"달아오르는 열기에도 불구하고, 당신은 <<handtext>>",
			"당신은 손을 안정시키고 <<handtext>>",
			"몸속에서 열기가 차오르는 가운데, 당신은 <<handtext>>",
			"당신은 조심스럽게 자제력을 유지하며 <<handtext>>"
		)>>
	<<else>>
		당신은 <<handtext>>
	<</if>>

	<<if _args[1].includes("penis")>>
		<<print either(
			"손가락으로 <<his>> 기둥을 꼬집는다,",
			"<<his>> 사타구니 주위를 손가락으로 훑는다,",
			"<<his>> 자지 끝을 엄지손가락으로 문지른다,",
			"손가락으로 <<his>> 기둥을 놀리듯 스치며,",
			"<<his>> 자지의 민감한 끝을 빙글빙글 훑으며,"
		)>>
	<<else>>
		<<print either(
			"손가락으로 <<his>> 입술을 누른다,",
			"<<his>> 음순 주위를 손가락으로 훑는다,",
			"<<his>> 클리토리스에 손바닥을 부드럽게 댄다,",
			"<<his>> 클리토리스 둘레에 놀리듯 원을 그린다,",
			"손끝으로 <<his>> 입술을 가볍게 훑으며,"
		)>>
	<</if>>

	<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
		<<print either(
			"<<him>>【을를】 절정 직전에 붙잡아 둔다.",
			"<<his>> 손이 닿지 않는 곳에서 해방감을 흔들어 보인다.",
			"<<his>> 갈망하는 몸을 고문한다.",
			"절정을 감질나게 코앞에 붙들어 둔다.",
			"마지막 순간에 <<him>>에게 해방을 허락하지 않는다."
		)>>
	<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
		<<print either(
			"천천히 <<him>>【을를】 절정으로 이끈다.",
			"<<his>> 흥분이 부풀어 오르게 둔다.",
			"<<him>>【을를】 애타게 만든다.",
			"<<his>> 욕구를 길게 끌어낸다.",
			"<<him>>【을를】 절정 직전으로 몰아간다."
		)>>
	<<else>>
		<<print either(
			"<<his>> 흥분을 조절한다.",
			"<<his>> 흥분을 억제한다.",
			"쾌락을 휘젓는다.",
			"꾸준한 욱신거림을 쌓아 올린다.",
			"<<him>>【을를】 기대감으로 팽팽하게 만든다."
		)>>
	<</if>>
<</widget>>

<<widget "actionskick">>
	<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 <<beasttype>>【을를】 걷어차려 하지만 녀석이",
					"당신은 <<beasttype>>【을를】 향해 발길질을 날리지만 녀석이"
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 <<beasttype>>【을를】 걷어차서 떼어내려 하지만 녀석이",
					"고통을 참으며, 당신은 <<beasttype>>【을를】 물리치려 걷어차지만, 녀석이"
				)>>
			<<else>>
				<<= either(
					"당신은 필사적으로 <<beasttype>>【을를】 걷어차서 떼어내려 하지만 녀석이",
					"공황 속에서, 당신은 허둥지둥 <<beasttype>>【을를】 향해 발길질을 날리지만 녀석이"
				)>>
			<</if>>
		<<else>>
			<<if $leftarm is "grappled" or $rightarm is "grappled">>
				<<= either(
					"당신은 공격자의 손아귀에 저항하며, 정강이를 걷어차 몸을 비틀어 빠져나오려 하지만 상대가",
					"공격자의 손아귀에 붙잡힌 채, 당신은 몸을 비틀어 빠져나오려 발을 휘두르지만 상대가"
				)>>
			<<else>>
				<<if $pain lte 20>>
					<<= either(
						"반항적으로, 당신은 발로 후려치려 하지만 상대가",
						"당신은 상대를 향해 발길질을 날리지만, 상대가"
					)>>
				<<elseif $pain lte 60>>
					<<= either(
						"다쳤어도, 당신은 발로 후려치려 하지만 상대가",
						"고통에 몸이 둔해졌지만, 당신은 그래도 상대에게 발길질을 하고 상대가"
					)>>
				<<else>>
					<<= either(
						"당신은 절박하게 후려치려 하지만 상대가",
						"절박한 나머지, 당신은 발길질을 내던지지만 상대가"
					)>>
				<</if>>
			<</if>>
		<</if>>
		<<if $combatExtended.enemyCounterSuccess is 2>>
			<span class="red">반격한다</span>
		<<elseif $combatExtended.enemyDodgeSuccess is 2>>
			<span class="red">피한다</span>
		<<elseif $combatExtended.enemyCounterSuccess is 1>>
			<span class="red">일부 반격한다</span>
		<<else>>
			<span class="blue">일부 피한다</span>
		<</if>>.
	<<else>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					"당신은 <<beasttype>>【을를】 걷어찬다.",
					"당신의 발이 <<beasttype>>에게 둔탁하게 꽂힌다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"당신은 <<beasttype>>【을를】 걷어차서 떼어내려 한다.",
					"이를 악물고 고통을 참으며, 당신은 <<beasttype>>【을를】 밀어내려 걷어찬다."
				)>>
			<<else>>
				<<= either(
					"당신은 필사적으로 <<beasttype>>【을를】 걷어차서 떼어내려 한다.",
					"공황 속에서, 당신은 <<beasttype>>【을를】 향해 발을 내지른다."
				)>>
			<</if>>
		<<else>>
			<<if $leftarm is "grappled" or $rightarm is "grappled">>
				<<= either(
					"당신은 공격자의 손아귀에 저항하며, 정강이를 걷어차면서 몸을 비틀어 빠져나오려 한다.",
					"공격자의 손아귀에 갇힌 채, 당신은 몸을 비틀어 빠져나오려 발을 휘두른다."
				)>>
			<<else>>
				<<if $pain lte 20>>
					<<= either(
						"반항적으로, 당신은 발로 후려친다.",
						"당신은 날카로운 발길질을 내지른다."
					)>>
				<<elseif $pain lte 60>>
					<<= either(
						"다쳤지만, 당신은 발로 후려친다.",
						"고통에 얼굴을 찡그리면서도, 당신은 발길질을 한다."
					)>>
				<<else>>
					<<= either(
						"당신은 절박하게 후려친다.",
						"절박하게, 당신은 공격자를 향해 발을 내던진다."
					)>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsdodge">>
	<<if $enemytype is "beast">>
		<<if $pain lte 20>>
			<<= either(
				"당신은 가볍게 발을 놀린다.",
				"당신은 민첩하게 움직이며, 빠져나갈 준비를 한다.",
				"당신은 가볍게 움직이며, 피할 틈을 노린다."
			)>>
		<<elseif $pain lte 60>>
			<<= either(
				"당신은 <<beasttype>>에게서 멀어지려 한다.",
				"아픔을 견디며, 당신은 <<beasttype>>【와과】의 거리를 유지하려 한다.",
				"당신은 발디딤을 지키며 <<beasttype>>에게서 슬금슬금 물러난다."
			)>>
		<<else>>
			<<= either(
				"당신은 필사적으로 <<beasttype>>에게서 벗어나려 한다.",
				"공황 속에서, 당신은 <<beasttype>>에게서 떨어지려 허둥댄다.",
				"당신은 비틀거리며 물러서고, 필사적으로 <<beasttype>>【을를】 피하려 한다."
			)>>
		<</if>>
	<<else>>
		<<if $leftarm is "grappled" or $rightarm is "grappled">>
			<<= either(
				"당신은 공격자의 손아귀에 저항하며, 피할 수 있도록 발을 단단히 디뎌 버틸 곳을 찾는다.",
				"꽉 붙잡힌 채, 당신은 발을 버티고 피할 수 있을 만큼의 지렛대를 얻으려 애쓴다.",
				"당신은 공격자의 손아귀와 씨름하며, 피할 만한 틈을 찾으려 한다."
			)>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					"당신은 가볍게 발을 놀린다.",
					"당신은 민첩하게 움직일 준비를 한다.",
					"당신은 발디딤을 고쳐 잡으며, 피할 준비를 한다."
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					"다쳤지만, 당신은 가볍게 발을 놀리려 애쓴다.",
					"당신은 얼굴을 찡그리지만, 할 수 있는 한 가볍게 계속 움직인다.",
					"고통에 몸이 둔해졌지만, 당신은 그래도 민첩함을 유지하려 한다."
				)>>
			<<else>>
				<<= either(
					"당신은 필사적으로 허둥댄다.",
					"당신은 비틀거리고 허둥대며, 손이 닿지 않는 곳에 머물려 한다.",
					"필사적으로, 당신은 몸을 던져 회피 동작을 취한다."
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

