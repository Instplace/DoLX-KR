	<<else>>
		<<set _text_output to "매">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "checkforloveinterests">>
	<<set _loveInterest to Object.values($loveInterest).filter(li => li isnot "None").random()>>
<</widget>>

<<widget "speechvoice">>
	<<if _speechVoice is "plead">>
		<<voice "plead">>
	<<elseif _speechVoice is "demand">>
		<<voice "demand">>
	<<else>>
		<<voice "moan">>
	<</if>>
<</widget>>

<<widget "askrough">>
	<<speechresolve>>
	You <<speechvoice>> for rougher treatment.

	<<if _speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 때려요. 난 맞아야 해요."
			<<case 1>> "나를 때려. 당신의 <<bitch>>【으로로】 만들어줘."
			<<case 2>> "내 분수를 가르쳐주세요."
			<<case 3>> "날 쓰레기처럼 다뤄."
			<<case 4>> "내가 꽥꽥대게 만들어줘."
			<<case 5>> "날 엉망으로 만들어."
			<<default>> "날 쓸모없는 돼지 취급해줘."
		<</switch>>
	<<elseif _speechAttitudeResolved is "polite">>
		<<switch $speechcycle>>
			<<case 0>> "Please hit me harder."
			<<case 1>> "Please beat me. Make me your <<bitch>>."
			<<case 2>> "Please show me my place."
			<<case 3>> "Please treat me like dirt."
			<<case 4>> "Please make me squeal."
			<<case 5>> "Please fuck me up."
			<<default>> "Please treat me like the worthless pig I am."
		<</switch>>
	<<elseif _speechAttitudeResolved is "docile">>
		<<switch $speechcycle>>
			<<case 0>> "Hit me harder. I can take it."
			<<case 1>> "Beat me. I'll take it."
			<<case 2>> "내 분수를 가르쳐주세요."
			<<case 3>> "Treat me like dirt. I won't complain."
			<<case 4>> "Make me squeal for you."
			<<case 5>> "Fuck me up. I'll be good."
			<<default>> "Treat me like the worthless pig I am. I'll take it."
		<</switch>>
	<<elseif _speechAttitudeResolved is "flamboyant">>
		<<switch $speechcycle>>
			<<case 0>> "Please hit me harder, darling."
			<<case 1>> "Please beat me. Make me your <<bitch>>."
			<<case 2>> "Please show me my place."
			<<case 3>> "Please treat me like dirt."
			<<case 4>> "Please make me squeal, darling."
			<<case 5>> "Please fuck me up."
			<<default>> "Please treat me like the worthless pig I am, darling."
		<</switch>>
	<<elseif _speechAttitudeResolved is "bratty">>
		<<switch $speechcycle>>
			<<case 0>> "더 세게 치라고, 겁쟁이 새끼야."
			<<case 1>> "그게 다야?"
			<<case 2>> "가장 세게 때려봐."
			<<case 3>> "어디 한번 날 망가뜨려 봐."
			<<case 4>> "이게 최선이야?"
			<<case 5>> "때려보라고. 아니면 기운이 빠졌어?"
			<<default>> "더 세게 때려, 안 그럼 내가 널 팰 거니까."
		<</switch>>
	<<elseif _speechAttitudeResolved is "cruel">>
		<<switch $speechcycle>>
			<<case 0>> "Hit me harder, worm."
			<<case 1>> "Beat me properly."
			<<case 2>> "가장 세게 때려봐."
			<<case 3>> "Fuck me up. Earn it."
			<<case 4>> "This all you've got? Pathetic."
			<<case 5>> "때려보라고. 아니면 기운이 빠졌어?"
