<<widget "actionsanusdoubleedging">>
	/* State 1 is out of sync, state 2 is in sync */
	<<if setup.npcPenis($anustarget) is "anusdouble" and setup.npcPenis($anusdoubletarget) is "anusdouble">>
		<<set _dap to 2>>
	<<else>>
		<<set _dap to 1>>
	<</if>>
	<<if $anusaction is "doubleimminent">>
		<<if $pleasure gte ($pleasuremax / 5) * 4>>
			절정에 가까워지자, 당신은 부분적으로 본능에 이끌려 그들의 흥분을 조절하기 위해 자지에 대고 <<analtext>> 비빈다.
		<<elseif $pleasure gte ($pleasuremax / 5) * 2 or $consensual is 1>>
			당신은 그들의 흥분을 조절하기 위해 자지에 대고 <<analtext>> 비빈다.
		<<else>>
			당신은 불편함을 줄이려 애쓰며, 그들의 흥분을 조절하기 위해 자지에 대고 <<analtext>> 비빈다.
		<</if>>
	<<else>>
		<<if _dap is 2>>
			<<if $enemytype is "beast">>
				/* Beasts are only encountered individually. This is futureproofing */
				<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
					<<= [
						`<<beasttype>>【이가】 당신의 항문을 잔혹하게 쑤셔댄다.`,
						`<<beasttype>>【이가】 당신의 항문을 잔인하게 들락날락 쑤셔댄다.`,
						`<<beasttype>>【이가】 당신의 항문을 사납게 거듭 파고든다.`,
						`<<beasttype>>【이가】 사정없이 당신의 항문 속으로 힘껏 쑤셔 넣는다.`,
					].random()>>
				<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
					<<= [
						`<<beasttype>>【이가】 당신의 항문을 무자비하게 박아댄다.`,
						`<<beasttype>>【이가】 쉴 새 없는 찌르기로 당신의 항문을 두들긴다.`,
						`<<beasttype>>【이가】 쉬지 않고 당신의 항문을 계속 박아댄다.`,
						`<<beasttype>>【이가】 당신의 항문을 거칠게 몇 번이고 파고든다.`,
					].random()>>
				<<else>>
					<<= [
						`<<beasttype>>【이가】 당신의 항문을 규칙적으로 유린한다.`,
						`<<beasttype>>【이가】 일정한 리듬으로 찌르며 당신의 항문을 꾸준히 공략한다.`,
						`<<beasttype>>【이가】 일정한 리듬으로 당신의 항문 속에 쑤셔 넣는다.`,
						`<<beasttype>>【이가】 절제된 움직임으로 당신의 항문을 계속 유린한다.`,
					].random()>>
				<</if>>
			<<else>>
				<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
					<<= [
						`당신의 항문이 두 자지에 의해 가차 없이 유린당한다.`,
						`두 자지가 가차 없이 당신의 항문을 유린한다.`,
						`당신의 항문이 두 자지에 의해 동시에 거칠게 유린당한다.`,
						`두 자지가 사정없이 당신의 항문 속으로 파고든다.`,
					].random()>>
				<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
					<<= [
						`당신의 항문이 두 자지에 의해 무자비하게 박힌다.`,
						`두 자지가 당신의 항문을 무자비하게 박아댄다.`,
						`당신의 항문이 두 자지의 끝없는 박음질을 견딘다.`,
						`두 자지가 묵직한 찌르기로 당신의 항문을 계속 두들긴다.`,
					].random()>>
				<<else>>
					<<= [
						`당신의 항문이 두 자지의 반복적인 삽입에 굴복한다.`,
						`두 자지가 굴복한 당신의 항문 속으로 계속 밀고 들어온다.`,
						`당신의 항문이 두 자지의 꾸준한 침입에 길을 내준다.`,
						`두 자지가 반복되는 찌르기로 당신의 항문을 계속 벌려 놓는다.`,
