<<widget "actionsanusdoublethrust">>
	/* State 1 is out of sync, state 2 is in sync */
	<<if setup.npcPenis($anustarget) is "anusdouble" and setup.npcPenis($anusdoubletarget) is "anusdouble">>
		<<set _dap to 2>>
	<<else>>
		<<set _dap to 1>>
	<</if>>
	<<if $enemytype is "beast">>
		/* Beasts are only encountered individually. This is futureproofing */
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<if $pleasure gte ($pleasuremax / 5) * 4>>
				<<= [`<<beasttype>>【이가】 당신의 항문을 사납게 들락날락하며 두들긴다.`,`<<beasttype>>【이가】 당신의 항문을 잔혹하게 피스톤처럼 들락거린다.`,`<<beasttype>>【이가】 쉴 새 없는 찌르기로 당신의 항문을 난타한다.`,`<<beasttype>>【이가】 당신의 항문을 거듭 세게 파고든다.`].random()>> 당신은 본능에 이끌려 절정에 다가가며 <<analtext>> 뒤로 밀어붙인다.
			<<elseif $pleasure gte ($pleasuremax / 5) * 2 or $consensual is 1>>
				<<= [`<<beasttype>>【이가】 당신의 항문을 사납게 들락날락하며 두들긴다.`,`<<beasttype>>【이가】 당신의 항문을 잔혹하게 피스톤처럼 들락거린다.`,`<<beasttype>>【이가】 쉴 새 없는 찌르기로 당신의 항문을 난타한다.`,`<<beasttype>>【이가】 당신의 항문을 거듭 세게 파고든다.`].random()>> 당신은 녀석의 움직임에 맞서 <<analtext>> 뒤로 밀어붙인다.
			<<else>>
				<<= [`<<beasttype>>【이가】 당신의 항문을 사납게 들락날락하며 두들긴다.`,`<<beasttype>>【이가】 당신의 항문을 잔혹하게 피스톤처럼 들락거린다.`,`<<beasttype>>【이가】 쉴 새 없는 찌르기로 당신의 항문을 난타한다.`,`<<beasttype>>【이가】 당신의 항문을 거듭 세게 파고든다.`].random()>> 당신은 불편함을 줄이려 녀석의 움직임에 맞춰 <<analtext>> 몸을 움직인다.
			<</if>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<if $pleasure gte ($pleasuremax / 5) * 4>>
				<<= [`<<beasttype>>【이가】 당신의 항문을 쉴 새 없이 박아댄다.`,`<<beasttype>>【이가】 사정없이 당신의 항문 속으로 힘껏 쑤셔 넣는다.`,`<<beasttype>>【이가】 멈추지 않고 당신의 항문을 계속 박아댄다.`,`<<beasttype>>【이가】 흉포하게 당신의 항문을 거듭 파고든다.`].random()>> 당신은 본능에 이끌려 절정에 다가가며 <<analtext>> 뒤로 밀어붙인다.
