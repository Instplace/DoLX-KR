<<widget "actionsshaftrub">>
	<<if $enemytype is "beast">>
		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<= [
				`당신은 <<he>>【이가】 맹렬하게 허리짓하는 동안, <<his>> 자지를 손에 쥐고 <<handtext>> 버틴다.`,
				`당신은 <<he>>【이가】 정신없이 손 안으로 허리를 들이받는 동안, <<his>> 자지를 손에 가둔 채 <<handtext>> 붙들고 있다.`,
				`당신은 <<he>>【이가】 열에 들떠 당신의 손에 허리를 찔러 넣는 동안, <<his>> 자지를 <<handtext>> 움켜쥔다.`
			].random()>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<= [
				`당신은 <<he>>【이가】 허리짓하는 동안, 자지를 손에 쥐고 <<handtext>> 버틴다.`,
				`당신은 <<he>>【이가】 당신의 손에 허리를 찔러 넣는 동안, 자지를 손아귀에 둔 채 <<handtext>> 붙든다.`,
				`당신은 <<he>>【이가】 밀어붙이는 동안, 손으로 자지를 <<handtext>> 이끈다.`
			].random()>>
		<<else>>
			<<= [
				`당신은 자지를 손에 쥐고 <<handtext>> 문지른다.`,
				`당신은 자지를 손아귀에 둔 채 기둥을 <<handtext>> 문지른다.`,
				`당신은 손으로 자지를 <<handtext>> 주무른다.`
			].random()>>
		<</if>>
	<<else>>
		<<if $consensual is 1>>
			<<if $pleasure lte ($pleasuremax / 5) * 3>>
				<<= [
					`당신은 <<their _args[0]>> 자지를 손에 단단히 쥐고 기둥을 <<handtext>> 쓰다듬고 어루만진다.`,
					`당신은 <<their _args[0]>> 자지를 단단히 붙든 채 기둥을 <<handtext>> 쓰다듬는다.`,
					`당신은 <<their _args[0]>> 자지를 가만히 붙들고 손으로 기둥을 <<handtext>> 주무른다.`
				].random()>>
			<<else>>
				<<= [
					`당신은 <<their _args[0]>> 기둥을 손에 쥐고 <<handtext>> 문지른다.`,
					`당신은 손안의 <<their _args[0]>> 기둥을 <<handtext>> 쓰다듬는다.`,
					`당신은 손으로 <<their _args[0]>> 기둥을 <<handtext>> 계속 문지른다.`
				].random()>>
			<</if>>
		<<else>>
			<<= [
				`당신은 손으로 <<their _args[0]>> 자지를 <<handtext>> 붙들어 두고, 손가락으로 기둥을 주무른다.`,
				`당신은 <<their _args[0]>> 자지를 손안에서 <<handtext>> 쉴 틈 없이 만지며, 손가락으로 기둥을 문지른다.`,
				`당신은 손가락으로 <<their _args[0]>> 기둥을 <<handtext>> 주무르며, 자지가 계속 정신을 못 차리게 만든다.`
			].random()>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsvaginaescape">>
	<<if $enemytype is "beast">>
		<<if $enemyanger lte 20>>
			<<= [
				`<span class="blue">골반을 비틀어, 짐승이 당신의 안을 뚫고 들어오기 전에 녀석의 더듬는 움직임에서 <<pussy>>【을를】 떼어낸다.</span> 하지만 녀석은 포기하지 않는다.`,
				`<span class="blue">허리를 비틀어, 짐승이 들어오기 전에 녀석의 더듬는 움직임에서 <<pussy>>【을를】 끌어당긴다.</span> 하지만 녀석은 포기하지 않는다.`,
				`<span class="blue">골반을 옆으로 빼서, 짐승의 더듬는 움직임이 <<pussy>>에 닿지 못하게 한다.</span> 하지만 녀석은 포기하지 않는다.`
			].random()>>
		<<elseif $enemyanger lte 100>>
			<<= [
				`<span class="blue">골반을 비틀어, 짐승이 당신의 안을 뚫고 들어오기 전에 쉴 새 없이 파고드는 그것에게서 <<pussy>>【을를】 떼어낸다.</span> 녀석은 좌절감에 으르렁거린다.`,
				`<span class="blue">허리를 비틀어, 쉴 새 없이 파고드는 짐승에게서 <<pussy>>【을를】 끌어낸다.</span> 녀석은 좌절감에 으르렁거린다.`,
				`<span class="blue">골반을 홱 틀어 <<pussy>>【을를】 짐승이 닿지 않는 곳으로 피한다.</span> 녀석은 좌절감에 으르렁거린다.`
			].random()>>
		<<else>>
			<<= [
				`<span class="blue">골반을 비틀어, 짐승이 당신의 안을 뚫고 들어오기 전에 야만적으로 파고드는 그것에게서 <<pussy>>【을를】 떼어낸다.</span> <<if $settings.pregnancySpeechEnabled>>임신시키려던<<else>>따먹으려던<</if>> 시도가 막히자, 녀석은 분노하며 어떻게든 다시 당신을 붙잡으려 발악한다.`,
				`<span class="blue">골반을 거칠게 비틀어, 야만적으로 파고드는 짐승에게서 <<pussy>>【을를】 끌어낸다.</span> <<if $settings.pregnancySpeechEnabled>>임신시키려던<<else>>따먹으려던<</if>> 시도가 막히자, 녀석은 분노하며 어떻게든 다시 당신을 붙잡으려 발악한다.`,
				`<span class="blue">필사적으로 <<pussy>>【을를】 짐승의 야만적인 쑤심에서 비껴 둔다.</span> <<if $settings.pregnancySpeechEnabled>>임신시키려던<<else>>따먹으려던<</if>> 시도가 막히자, 녀석은 분노하며 어떻게든 다시 당신을 붙잡으려 발악한다.`
			].random()>>
		<</if>>
	<<else>>
		<<if $pain lte 20>>
			<<= [`<span class="blue">골반을 틀어 <<pussy>>【을를】 <<their _args[0]>> 자지에서 떼어낸다.</span>`,`<span class="blue">허리를 비틀어 <<pussy>>【을를】 <<their _args[0]>> 자지에서 빼낸다.</span>`,`<span class="blue"><<pussy>>【을를】 <<their _args[0]>> 자지가 향하는 길에서 비켜 놓는다.</span>`].random()>>
		<<elseif $pain lte 60>>
			<<= [`<span class="blue">골반을 틀어 <<pussy>>【을를】 <<their _args[0]>> 자지에서 떼어낸다.</span>`,`<span class="blue">허리를 홱 돌려 <<pussy>>【을를】 <<their _args[0]>> 자지에서 떼어낸다.</span>`,`<span class="blue">골반을 비틀어 <<their _args[0]>> 자지가 <<pussy>>에 닿지 못하게 막는다.</span>`].random()>>
		<<else>>
			<<= [`<span class="blue">다급하게 골반을 틀어 <<pussy>>【을를】 <<their _args[0]>> 자지에서 떼어낸다.</span>`,`<span class="blue">필사적으로 허리를 홱 비틀어 <<pussy>>【을를】 <<their _args[0]>> 자지에서 떼어낸다.</span>`,`<span class="blue">다급한 나머지 <<pussy>>【을를】 <<their _args[0]>> 자지에서 멀찍이 피한다.</span>`].random()>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsvaginadoubleescape">>
	<<set $_penises to "자지">>
	<<if npcHasStrapon($vaginatarget) and npcHasStrapon($vaginadoubletarget)>>
		<<set $_penises to "페니스 밴드">>
	<<elseif npcHasStrapon($vaginatarget) and !npcHasStrapon($vaginadoubletarget) or !npcHasStrapon($vaginatarget) and npcHasStrapon($vaginadoubletarget)>>
		<<set $_penises to "자지">>
	<</if>>
	<<if $pain lte 20>>
