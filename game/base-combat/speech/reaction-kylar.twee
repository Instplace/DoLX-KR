:: Widgets reaction-Kylar [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-kylar-plead">>
	<<addSpeechLine "plead">>
		"카일라... 날 사랑하는 줄 알았는데..."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-kylar-demand">>
	<<addSpeechLine "demand">>
		"지금 네 헛소리 들어줄 기분 아니야, 카일라."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-kylar-moan">>
	<<addSpeechLine "moan">>
		"내게 필요한 건 오직 너뿐이야, 카일라."
	<</addSpeechLine>>
<</widget>>
