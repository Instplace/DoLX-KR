:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
	<<set _npc_speech to true>>
	<<if !$baileyUniqueComments>>
		<<set $baileyUniqueComments to []>>
	<</if>>
	<<if C.npc.Bailey.dom lte 30>>
		<<set $_stringsPre to "<<He>> mocks. ">>
	<<elseif $enemyanger gte 80>>
		<<set $_stringsPre to "<<He>> hisses. ">>
	<<elseif $enemyanger gte 50>>
		<<set $_stringsPre to "<<He>> snarls. ">>
	<<else>>
		<<set $_stringsPre to "<<He>> snickers. ">>
	<</if>>
	<<speechPool "Bailey" "noMouthAction">>
	<<if $speechpillreveal is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechpillreveal to 0>><<set $enemyanger += 20>><<set $enemytrust -= 20>>
		<<speechLine>>
			<<He>>【은는】 당신 손에 든 X-체인지 알약을 보고 그대로 굳는다. "그거 치워. 그걸 쓰려다간 무슨 일이 벌어질지 감당 못 할 거다."
		<<speechLine>>
			<<His>> 시선이 X-체인지 알약으로 향했다가 다시 당신의 얼굴로 돌아온다. "다음 행동은 아주 신중하게 생각해. 손해는 청구되니까."
		<<speechLine>>
			"그게 날 겁먹게 만들 거라고 생각하나?" <<He>>【은는】 당신의 X-체인지 알약 쪽으로 턱짓한다. "여기서 네가 하는 모든 짓은 네 장부에 올라가. 그러면 지금까지 네가 진 어떤 빚보다 더 큰 값을 치르게 될 거다."
		<</addSpeechLine>>
	<<elseif $speechpill is "herm">>
		<<addSpeechLine "reveal">>
			<<set $speechpill to 0>>
		<<speechLine>>
			<<He>>【은는】 <<his>> 어울리지 않는 새 신체를 내려다보고 인상을 쓴 뒤 다시 당신을 본다. "둘 다. 둘 다를 줬군. 몸 두 개 분의 불편을 값으로 청구하겠다."
		<<speechLine>>
			<<He>>【은는】 <<his>> 어울리지 않는 새 신체를 내려다보고 인상을 쓴 뒤 다시 당신을 본다. "우쭐대지 마. 물건은 물건이야. 전부 쓸 데를 찾아낼 테니까."
		<<speechLine>>
			<<He>>【은는】 <<his>> 어울리지 않는 새 신체를 내려다보고 인상을 쓴 뒤 다시 당신을 본다. "이게 얼마짜리인지 계산이 끝나면, 차액은 네가 낼 거다."
		<</addSpeechLine>>
	<<elseif $speechpill is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechpill to 0>>
		<<speechLine>>
			<<He>>【은는】 <<his>> 낯선 손가락을 쥐었다 폈다 한다. <<hes>> 주문한 적도 없는 도구를 시험해 보는 것 같다. "그만 쳐다봐. 안에 있는 건 여전히 나고, 넌 여전히 내게 빚이 있어."
		<<speechLine>>
			<<He>>【은는】 <<his>> 낯선 손가락을 쥐었다 폈다 한다. <<hes>> 주문한 적도 없는 도구를 시험해 보는 것 같다. "몸은 몸일 뿐이야. 이쪽은 이문이 남을지도 모르지. 그렇다고 네가 용서받은 건 아니다."
		<<speechLine>>
			<<He>>【은는】 <<his>> 낯선 손가락을 쥐었다 폈다 한다. <<hes>> 주문한 적도 없는 도구를 시험해 보는 것 같다. "이 꼴로 보내는 시간은 한 시간마다 네 청구서에 올라간다. 빨리 풀리기나 빌어."
		<</addSpeechLine>>
	<<elseif $encounterDialogue is "baileyFlatFight">>
		<<baileyFlatFightSpeech>>
	<<else>>
		<<baileyBaseSpeech>>
	<</if>>
	<<speechSay>>
<</widget>>

<<widget "baileyBaseSpeech">>
	<<set $_baileyPenetratorSize to ((window.C && C.npc && C.npc.Bailey && Number.isFinite(Number(C.npc.Bailey.penissize))) ? Number(C.npc.Bailey.penissize) : 0)>>
	<<set $_baileyColossalPenetrator to $_baileyPenetratorSize gte 5>>
	<<if ($speechFallenTransform is 1)>>
		<<if $syndromeBailey>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 알 수 없는 표정으로 당신이 부서지는 모습을 지켜본다. "몇 조각으로 부서지든 상관없어." <<He>>【은는】 당신의 부서진 후광을 바라본다. "조각 하나하나가 전부 내 거야."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 알 수 없는 표정으로 당신이 부서지는 모습을 지켜본다. "됐다." <<He>>【은는】 당신의 부서진 후광을 바라본다. "언젠가는 부서질 수밖에 없었지. 이제야 값어치가 좀 나가는군."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 알 수 없는 표정으로 당신이 부서지는 모습을 지켜본다. "타락했나 보군?" <<He>>【이가】 당신의 부서진 후광을 바라보며 조롱한다. "넌 어차피 결국 여기로 올 팔자였어."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 알 수 없는 표정으로 당신이 부서지는 모습을 지켜본다. "좋아. 그건 널 붙잡고 있었을 뿐이야." <<He>>【은는】 당신의 부서진 후광을 바라본다. "이렇게 하면 더 많이 벌 수 있겠군."
			<</addSpeechLine>>
		<</if>>
	<<elseif (($speechPenisVirgin is 1) and $player.virginity.penile is "Bailey") or (($speechVaginaVirgin is 1) and $player.virginity.vaginal is "Bailey")>>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"너무 심하게 망가지면 내 돈이 날아간다."
			<<speechLine>>
				<<print $_stringsPre>>"빚이 전부 수금되면 어떻게 되는지 이제 알겠지."
			<</addSpeechLine>>
			<<if $consensual isnot 1>>
				<<addSpeechLine "virginity">>
				<<speechLine>>
					<<print $_stringsPre>>"아직 숨 쉬고 있나? 그래야지. 흠집 난 물건은 팔기 더 어려우니까."
				<</addSpeechLine>>
			<</if>>
		<<elseif $syndromeBailey>>
			<<addSpeechLine "virginity">>
				"날 위해 남겨 둔 거지, 안 그래?" <<he>>【이가】 이미 알고 있었다는 듯 말한다. "<<goodGirl>>. 처음부터 내 것이 될 거라는 걸 알고 있었군."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 천천히 숨을 내쉰다. "이제 내 거야."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<He>>【이가】 조롱한다. "젠장. 네 값어치가 방금 좀 떨어졌군."
			<<speechLine>>
				<<print $_stringsPre>>"넌 그거 하나 쓸모밖에 없어, 이 하찮은 창녀야."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<He>>【은는】 한숨을 쉰다. "아깝군. 더 받아낼 수 있었는데."
			<<speechLine>>
				<<print $_stringsPre>>"자. 네 장부에 올릴 게 하나 더 생겼군."
			<<speechLine>>
				<<print $_stringsPre>>"내가 받을 건 받아낸다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechAnusVirgin is 1) and $player.virginity.anal is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"기절하면 일이 귀찮아진다."
			<<speechLine>>
				<<print $_stringsPre>>"그래, 그거야. 받아들여. 손실 처리하게 만들지 마라."
			<</addSpeechLine>>
			<<if $consensual isnot 1>>
				<<addSpeechLine "virginity">>
				<<speechLine>>
					<<print $_stringsPre>>"멈출 때를 아는 나한테 고마워해야 할 거다. 대부분의 구매자는 그러지 않으니까."
				<</addSpeechLine>>
			<</if>>
		<<elseif $syndromeBailey>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 숨을 내쉰다. "네 모든 곳이 내 거야. 모든 구멍도. 모든 소리도. 내 거야."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 입을 연다. "받아들이는 법을 배우게 될 거다." <<He>>【은는】 속도를 늦추지 않는다. "시간은 많으니까."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<print $_stringsPre>>"이렇게 조이면 좀 더 자주 대줘야 할 거 아냐. 네가 뭐라도 되는 줄 알아?"
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"긴장 풀어. 곧 익숙해질 거야."
			<<speechLine>>
				<<print $_stringsPre>>"좁군. 그래도 값어치는 있어."
			<<speechLine>>
				<<print $_stringsPre>>"노려보지 마. 지불이 밀린 건 너니까."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNPCAnusVirgin>>
		<<if C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 흔들림 없는 눈으로 당신을 바라본다. "기억해, 내가 허락한 거다."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 비웃는다. "한 마디도 하지 마."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechOralVirgin is 1) and $player.virginity.oral is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"너무 심하게 숨 막혀 하면 처음부터 다시 해야 한다."
			<<speechLine>>
				<<print $_stringsPre>>"더 크게 벌려. 넌 연약해 보이라고 돈 받는 게 아니야."
			<<speechLine>>
				<<print $_stringsPre>>"나한테서 눈 떼지 마. 네가 듣고 있는지 알아야겠으니까."
			<</addSpeechLine>>
		<<elseif $syndromeBailey>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 입을 연다. "넌 이걸 잘하게 될 거다." <<He>>【은는】 잠시 말을 멈춘다. "날 위해서."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				"맛이 어때?" <<He>>【은는】 당신이 대답하게 두지 않는다. 그저 당신을 쓸 뿐이다. "질리지도 않는 모양이군."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<print $_stringsPre>>"닥치고 그거나 물고 컥컥대, 이 새끼야."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"이상한 생각 마. 얌전히 받아들여."
			<<speechLine>>
				<<print $_stringsPre>>"긴장 풀어. 곧 익숙해질 거야."
			<<speechLine>>
				<<print $_stringsPre>>"배우게 될 거야. 다들 그러니까."
			<<speechLine>>
				<<print $_stringsPre>>"다음엔 망설임을 줄여. 시간은 돈이다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechKissVirgin is 1) and $player.virginity.kiss is "Bailey">>
		<<if $syndromeBailey>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 킥킥거린다. "내 거야. 이건 처음부터 내 것이 될 운명이었어."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 입을 연다. "다시." <<He>>【은는】 기다린다. "입을 더 벌려."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				"우쭐대지 마." <<he>>【이가】 비웃는다. "아무 의미도 없었어."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				"처음이냐?" <<He>>【이가】 킥킥거린다. "입 쓰는 법을 더 배우게 될 거다."
			<<speechLine>>
				<<print $_stringsPre>>"놀랐냐? 조만간 키스 더 잘하는 법을 배우게 될 거다."
			<<speechLine>>
				<<print $_stringsPre>>"그런 눈으로 보지 마. 그냥 키스였어."
			<<speechLine>>
				<<print $_stringsPre>>"이제 내가 선물이라도 준 것처럼 굴지 마."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechPepperSpray is 1)>>
		<<if C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "pepperSpray">>
				<<He>>【이가】 고통에 뒤로 물러나며 으르렁거린다. "이 대가는 치르게 될 거다, 이 새끼야."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "pepperSpray">>
				<<He>>【이가】 고통에 뒤로 물러나며 으르렁거린다. "이 대가는 치르게 될 거다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechLINameDrop is 1)>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if $syndromeBailey and !$baileyUniqueComments.includes("namedropRobin")>>
					<<addSpeechLine "namedrop">>
						<<set $baileyUniqueComments.pushUnique("namedropRobin")>>
						<<His>> 눈이 어두워진다. "어쩌면 <<nnpc_him "Robin">>【을를】 네가 찾을 수 없는 곳에 팔아 버려야겠군."
					<</addSpeechLine>>
				<<elseif C.npc.Robin.dom gte 60>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"너 덕분에 그 꼬맹이도 제법 배짱이 생겼더군." <<He>>【은는】 코웃음을 친다. "애석하게도 <<nnpc_hes "Robin">> 널 구하러 오지 않겠지만 말이야."
					<</addSpeechLine>>
				<<elseif $robinpaid is 1 and $robinStand?.selfSufficient isnot 1>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"네가 빚을 대신 갚아줬는데도 <<nnpc_he 'Robin'>>【은는】 구경조차 못 하는 꼴이라니."
					<</addSpeechLine>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"너 덕분에 그 고아 녀석도 제법 배짱이 생겼더군. 애석하게도 <<nnpc_he 'Robin'>>【이가】 널 구해주진 않겠지만 말이야."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"그 쓸모없는 꼬맹이는 널 구해주지 못해."
					<<speechLine>>
						<<print $_stringsPre>>"그 고아 녀석이 뭘 할 수 있을 것 같냐? 내가 그만둘 때까지 징징대기라도 할까?"
					<<speechLine>>
						<<print $_stringsPre>>"로빈은 네가 진 빚을 갚을 수 없어. 감상으로 빚이 청산되진 않아."
					<<speechLine>>
						<<print $_stringsPre>>"로빈이 널 되찾고 싶다면, <<nnpc_he "Robin">>【이가】 현금을 가져와야지."
					<</addSpeechLine>>
				<</if>>
			<<case "Eden">>
				<<if $syndromeBailey and !$baileyUniqueComments.includes("namedropEden")>>
					<<addSpeechLine "namedrop">>
						<<set $baileyUniqueComments.pushUnique("namedropEden")>>
						"<<nnpc_his "Eden">> 이름을 입에 올리지 마."
					<</addSpeechLine>>
				<<elseif C.npc.Bailey.dom gte 70>>
					<<addSpeechLine "namedrop">>
						"그 이름을 다시 말해 봐. 무슨 일이 생기는지 보게 될 거다."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"계속 이런 식이면 <<nnpc_him 'Eden'>>에게 다시 보내버릴 거다."
					<<speechLine>>
						<<print $_stringsPre>>"그 은둔자한테도 <<nnpc_his "Eden">> 기회가 있었어."
					<<speechLine>>
						<<print $_stringsPre>>"<<nnpc_He "Eden">>【은는】 도망쳤어. 넌 아직 여기 있고."
					<<speechLine>>
						<<print $_stringsPre>>"에덴은 널 감당할 수 없었어."
					<<speechLine>>
						<<print $_stringsPre>>"에덴은 숲이 모든 걸 감춰 준다고 생각하지. 그렇지 않아."
					<</addSpeechLine>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
				<<speechLine>>
					<<print $_stringsPre>>"짐승 새끼들은 살처분 당하지만, 넌 몸을 굴려야 할 거다."
				<<speechLine>>
					<<print $_stringsPre>>"누가 먼저 값을 치르기 전엔 그 짐승 놈을 내 재산 근처에 얼씬도 못 하게 해."
				<</addSpeechLine>>
				<<if $consensual isnot 1>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"사람들은 네가 짐승 새끼랑 <<if $player.penisExist>>떡치는<<else>>박히는<</if>> 꼴을 보려고 기꺼이 웃돈을 낼 거다."
