		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "playerOrgasm">>
			<<speechLine>>
				"고맙게 여기길 바란다." <<He>>【이가】 한숨을 쉰다. "언젠가는 그렇게 되겠지."
			<<speechLine>>
				"나를 기억할 만한 기념품이다." <<He>>【이가】 낄낄 웃는다. "잊지 못할 거다."
			<<speechLine>>
				"이걸 네 떠나는 선물이라고 해 두지." <<He>>【이가】 비웃는다. "또 필요해지면 돌아와."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "playerOrgasm">>
			<<speechLine>>
				<<print $_stringsPre>>"욕심 많은 꼬맹이군. 고맙다고 해."
			<<speechLine>>
				<<print $_stringsPre>>"고마워하길 바란다, 이 꼬맹이 새끼야."
			<<speechLine>>
				<<print $_stringsPre>>"쌌나? 한심하군."
			<</addSpeechLine>>
		<<else>>
			<<switch $speechorgasmcount>>
				<<case 2>>
					<<addSpeechLine "playerOrgasm">>
						<<He>>【이가】 낄낄거리며 당신이 절정에 달하는 모습을 재미있다는 듯 지켜본다.
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "playerOrgasm">>
						<<He>>【이가】 낄낄거린다. "<<goodGirl>>. 전부 쏟아 내."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "playerOrgasm">>
						<<He>>【이가】 낄낄거린다. "더 나올 게 있다는 거 알아, 꼬맹이."
					<</addSpeechLine>>
				<<case 5>>
					<<addSpeechLine "playerOrgasm">>
						<<He>>【이가】 낄낄거린다. "그래. 끝났나?"
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "playerOrgasm">>
					<<speechLine>>
						<<print $_stringsPre>>"감사하게 여기길 바란다."
					<<speechLine>>
						<<print $_stringsPre>>"나를 기억하게 만들 기념품이다."
					<<speechLine>>
						<<print $_stringsPre>>"이걸 네 떠나는 선물이라고 해 두지."
					<<speechLine>>
						<<print $_stringsPre>>"벌써? 아직 안 끝났다."
					<<speechLine>>
						<<print $_stringsPre>>"그렇지. 참을 수가 없었지, 안 그래?"
					<</addSpeechLine>>
			<</switch>>
		<</if>>
	<</if>>
	<<if $enemypleasure gte ($enemypleasuremax * 0.7)>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<He>>【이가】 숨을 날카롭게 내쉰다. <<His>> 리듬이 흐트러진다.
		<<speechLine>>
			<<He>>【은는】 아무 말도 하지 않는다. <<His>> 숨소리가 달라진다.
		<<speechLine>>
			<<He>>【이가】 조용해진다. <<His>> 턱에 힘이 들어간다.
		<</addSpeechLine>>
		<<if C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "idle" 3>>
			<<speechLine>>
				"그래." <<He>>【이가】 쉰 목소리로 말한다. "받아."
			<<speechLine>>
				<<He>>【은는】 아무 말도 하지 않는다. <<His>> 눈이 이글거린다.
			<</addSpeechLine>>
		<</if>>
		<<if $syndromeBailey and $baileyTitle isnot "Bailey" and !$baileyUniqueComments.includes("arousalHigh")>>
			<<addSpeechLine "idle" 3>>
				<<set $baileyUniqueComments.pushUnique("arousalHigh")>>
				"그래." <<He>>【이가】 쉰 목소리로 말한다. "<<baileyTitle>>【이가】 알아서 해 주지."
			<</addSpeechLine>>
		<</if>>
	<<elseif $enemyanger lte 60>>
		<<if $hairlength gte 600 and !$baileyUniqueComments.includes("longHair") and $consensual isnot 1>>
			<<addSpeechLine "idle" 3>>
				<<set $baileyUniqueComments.pushUnique("longHair")>>
				<<print $_stringsPre>>"머리는 계속 길렀나? 이런 걸 좋아할 놈을 알지."
			<</addSpeechLine>>
		<</if>>
		<<if ($player.breastsize gte 8 or $player.penissize gte 5) and !$baileyUniqueComments.includes("cow") and $consensual isnot 1>>
			<<addSpeechLine "idle" 3>>
				<<set $baileyUniqueComments.pushUnique("cow")>>
				<<if effectiveTransformationLevel("cow") gte 6>>
					<<print $_stringsPre>>"요즘은 젖소가 비싼 값에 팔린다는 거 알 거다."
				<<else>>
					<<print $_stringsPre>>"너 같은 몸을 웃돈 주고 사려는 놈들도 있다는 거 알겠지."
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $hairlength gte 600 and $consensual isnot 1>>
			<<addSpeechLine "idle" 2>>
			<<speechLine>>
				<<print $_stringsPre>>"긴 머리는 사진이 잘 받지. 쓸모가 있어."
			<<speechLine>>
				<<print $_stringsPre>>"전에 네 머리 같은 걸 찾는 사람이 있었지. 선금까지 냈어."
			<</addSpeechLine>>
		<</if>>
		<<if ($athletics gte 750 or $physique gte $physiquesize * 0.75) and !$baileyUniqueComments.includes("strong") and $consensual isnot 1>>
			<<addSpeechLine "idle" 3>>
				<<set $baileyUniqueComments.pushUnique("strong")>>
				<<print $_stringsPre>>"체력이 좋군. 마음에 들어. 거칠게 반항하는 걸 돈 주고 볼 놈들도 있거든."
			<</addSpeechLine>>
		<</if>>
		<<if ($athletics gte 750 or $physique gte $physiquesize * 0.75) and $consensual isnot 1>>
			<<addSpeechLine "idle" 2>>
			<<speechLine>>
				<<print $_stringsPre>>"근육이 좋군. 그러면 네 값이 유지돼."
			<<speechLine>>
				<<print $_stringsPre>>"발버둥 칠 만큼은 튼튼하다 이거군. 그런 걸 좋아하는 손님도 있지."
			<</addSpeechLine>>
		<</if>>
		<<if $arousal gte ($arousalmax * 0.7) and !$baileyUniqueComments.includes("aroused")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<addSpeechLine "idle" 3>>
					<<set $baileyUniqueComments.pushUnique("aroused")>>
					<<print $_stringsPre>>"이게 필요한 거지. 내가 처리해 주마."
				<</addSpeechLine>>
			<<elseif $consensual isnot 1>>
				<<addSpeechLine "idle" 1.5>>
					<<set $baileyUniqueComments.pushUnique("aroused")>>
				<<speechLine>>
					<<print $_stringsPre>>"표정 좋군. 네가 그렇게 달아올라 헐떡이는 꼴을 보려고 큰돈을 낼 놈들이 많을 거다."
				<<speechLine>>
					<<print $_stringsPre>>"카메라를 가져왔어야 했는데. 네 프로필 사진으로 쓰면 딱 좋겠군."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if ($leftEyeColour is "green" or $leftEyeColour is "lime green") and !$baileyUniqueComments.includes("eyes")>>
			<<addSpeechLine "idle" 3>>
				<<set $baileyUniqueComments.pushUnique("eyes")>>
				<<His>> 눈이 당신의 눈을 너무 오래 살핀다. "녹색 눈이라. 드문데." <<He>>【이가】 시선을 돌린다.
			<</addSpeechLine>>
		<</if>>
		<<if $skin.left_bottom.writing is "cattle brand" and !$baileyUniqueComments.includes("brand")>>
			<<if C.npc.Bailey.dom gte 70>>
				<<addSpeechLine "idle" 3>>
					<<set $baileyUniqueComments.pushUnique("brand")>>
					<<He>>【이가】 당신의 엉덩이에 찍힌 낙인을 본다. <<He>>【이가】 숨을 내쉰다. "돌아왔군."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "idle" 3>>
					<<set $baileyUniqueComments.pushUnique("brand")>>
					<<He>>【이가】 당신의 엉덩이에 찍힌 낙인을 본다. <<He>>【이가】 숨을 내쉰다. "적어도 낸 돈값은 했군."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $worn.neck.name is "Bailey's collar" and !$baileyUniqueComments.includes("collar")>>
			<<addSpeechLine "idle" 1.5>>
				<<set $baileyUniqueComments.pushUnique("collar")>>
			<<speechLine>>
				<<He>>【이가】 당신의 연꽃 목걸이를 훑어본다. "잃어버리지 않았군. 좋아."
			<<speechLine>>
				<<He>>【이가】 당신의 연꽃 목걸이를 훑어본다. "<<goodGirl>>."
			<</addSpeechLine>>
		<</if>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<print $_stringsPre>>"가만히 있어. 둘 다 시간 낭비일 뿐이다."
		<<speechLine>>
			<<print $_stringsPre>>"가만히 있어라. 거의 다 끝나가니까."
		<<speechLine>>
			<<print $_stringsPre>>"그래, 그렇게. 속에 쌓인 건 다 털어 내."
		<<speechLine>>
			<<print $_stringsPre>>"넌 항상 제일 다루기 힘든 녀석이었지. 너도 알고 있길 바란다."
		<<speechLine>>
			<<print $_stringsPre>>"이제 내 말 들을 마음이 생겼나?"
		<<speechLine>>
			<<print $_stringsPre>>"배우는 속도가 빠르군. 좋아."
		<<speechLine>>
			<<print $_stringsPre>>"가만히 있어."
		<<speechLine>>
			<<print $_stringsPre>>"불필요하게 힘 빼지 마라."
		<<speechLine>>
			<<print $_stringsPre>>"긴장 풀어. 평소처럼 내가 알아서 처리할 테니."
		<<speechLine>>
			<<print $_stringsPre>>"넌 늘 그중 제일 잘생긴 <<print either("새끼","꼬맹이","<<bitch>>")>>【이었였】지."
		<<speechLine>>
			<<print $_stringsPre>>"이러는 게 훨씬 편할 거다. 날 믿어."
		<<speechLine>>
			<<print $_stringsPre>>"넌 장부에 약한 놈이었지. 내가 처리하마."
		<<speechLine>>
			<<print $_stringsPre>>"날 믿든가 말든가. 결과는 같으니까."
		<<speechLine>>
			<<print $_stringsPre>>"말귀 알아듣게 굴어. 말귀 밝은 놈이 내 시간을 덜 먹어."
		<<speechLine>>
			<<print $_stringsPre>>"가만히 있으면 간단하게 끝난다."
		<<speechLine>>
			<<print $_stringsPre>>"가만히 서 있어. 상태가 어떤지 확인해야겠어."
		<<speechLine>>
			<<print $_stringsPre>>"네가 날 얼마나 골치 아프게 했는지 보자."
		<<speechLine>>
			<<print $_stringsPre>>"몸이 널 배신할 때가 다루기 제일 쉽군."
		<</addSpeechLine>>
		<<if $consensual isnot 1>>
			<<addSpeechLine "idle">>
			<<speechLine>>
				<<print $_stringsPre>>"놀란 척 마. 네 값어치는 정확히 알고 있으니까."
			<<speechLine>>
				<<print $_stringsPre>>"낯익은 얼굴에 사람들이 얼마나 쓰는지 알면 놀랄 거다."
			<<speechLine>>
				<<print $_stringsPre>>"꼴 좀 봐. 거의 프리미엄 매물이군."
			<<speechLine>>
				<<print $_stringsPre>>"까다로운 구매자도 있지. 넌 운이 좋은 건지 나쁜 건지."
			<<speechLine>>
				<<print $_stringsPre>>"그게 팔리는 얼굴이다. 망치지 않게 조심해."
			<</addSpeechLine>>
		<</if>>
	<<else>>
		<<if $enemyanger lte 70 and $consensual isnot 1>>
			<<addSpeechLine "idle">>
				<<print $_stringsPre>>"가기 전에 물건 상태 좀 확인해 봐야겠군."
			<</addSpeechLine>>
		<</if>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<print $_stringsPre>>"왜 꼭 스스로 일을 꼬이게 만드는 거냐?"
		<<speechLine>>
			<<print $_stringsPre>>"가만히 있으라고 했을 텐데."
		<<speechLine>>
			<<print $_stringsPre>>"너 때문에 우리 둘 다 힘들어지잖아."
		<<speechLine>>
			<<print $_stringsPre>>"네가 선택한 거다."
		<<speechLine>>
			<<print $_stringsPre>>"이제 내 말 들을 마음이 생겼나?"
		<<speechLine>>
			<<print $_stringsPre>>"계속 발악해봐. 그 끝이 어딘지 똑똑히 보여줄 테니."
		<<speechLine>>
			<<print $_stringsPre>>"얌전히 굴었으면 진작에 끝났을 일이다."
		<<speechLine>>
			<<print $_stringsPre>>"그만 꿈틀대. 넌 아무 데도 못 가니까."
		<</addSpeechLine>>
		<<if $consensual isnot 1>>
			<<addSpeechLine "idle">>
			<<speechLine>>
				<<print $_stringsPre>>"널 비싼 값에 사겠다는 호구 새끼가 있거든."
			<<speechLine>>
				<<print $_stringsPre>>"넌 나랑 같이 가는 거다, 잔말 마."
			<<speechLine>>
				<<print $_stringsPre>>"이 성가신 상황을 만든 값도 청구하마."
			<<speechLine>>
				<<print $_stringsPre>>"입만 다물고 있으면 꽤 값을 받을 거다."
			<<speechLine>>
				<<print $_stringsPre>>"누군가 널 원한다는 것만으로도 감사해라."
			<<speechLine>>
				<<print $_stringsPre>>"네가 움직일 때마다 내 돈이 깎인단 말이다."
			<<speechLine>>
				<<print $_stringsPre>>"네가 반항하는 매 초마다 네 빚이 늘어날 거다."
			<<speechLine>>
				<<print $_stringsPre>>"계속 발악하면 손해 본 건 네 장부에 올리겠다."
			<<speechLine>>
				<<print $_stringsPre>>"벌써 누가 널 찾았어. 그 사람을 실망시키게 만들지 마."
			<<speechLine>>
				<<print $_stringsPre>>"발버둥 치지 마. 네 값만 깎아 먹고 있어."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $arousal gte 9500 and $consensual isnot 1>>
		<<addSpeechLine "idle" 3>>
		<<speechLine>>
			<<print $_stringsPre>>"표정 좋군. 네가 그렇게 달아올라 헐떡이는 꼴을 보려고 큰돈을 낼 놈들이 많을 거다."
		<<speechLine>>
			<<print $_stringsPre>>"카메라를 가져왔어야 했는데. 네 프로필 사진으로 쓰면 딱 좋겠군."
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "baileyFlatFightSpeech">>
	<<if ($speechStruggle is 1)>>
		<<addSpeechLine "struggle">>
		<<speechLine>>
			<<print $_stringsPre>>"계속 발버둥 쳐, 꼬맹이."
		<<speechLine>>
			<<print $_stringsPre>>"그게 다야? 더 세게 꿈틀대 봐."
		<<speechLine>>
			<<print $_stringsPre>>"해 봐. 기운이 다 빠질 때까지."
		<<speechLine>>
			<<print $_stringsPre>>"넌 아무 데도 못 간다."
		<<speechLine>>
			<<print $_stringsPre>>"그것보단 더 잘해야 할 거다."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechPlayerBeaten is 1)>>
		<<addSpeechLine "playerBeaten">>
		<<speechLine>>
			<<print $_stringsPre>>"받아."
		<<speechLine>>
			<<print $_stringsPre>>"집중해."
		<<speechLine>>
			<<print $_stringsPre>>"이보다 심한 것도 견뎠잖아."
		<</addSpeechLine>>
		<<if $physique gte $physiquesize * 0.75>>
			<<addSpeechLine "playerBeaten" 3>>
				<<print $_stringsPre>>"이 정도는 버틸 만큼 세다는 거 알아."
			<</addSpeechLine>>
		<</if>>
		<<if $masochism_level gte 1>>
			<<addSpeechLine "playerBeaten" 3>>
				<<print $_stringsPre>>"제 분수를 알게 되는 걸 좋아한다는 거 알아, 꼬맹이."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechPlayerHits is 1)>>
		<<addSpeechLine "playerHits">>
		<<speechLine>>
			<<print $_stringsPre>>"깔끔하게 맞았군."
		<<speechLine>>
			<<print $_stringsPre>>"그래, 그거야."
		<<speechLine>>
			<<print $_stringsPre>>"그래야지."
		<</addSpeechLine>>
		<<if $physique gte $physiquesize * 0.75>>
			<<addSpeechLine "playerHits" 3>>
				<<print $_stringsPre>>"그보다 세게 칠 수 있잖아."
			<</addSpeechLine>>
		<</if>>
		<<if $sadism_level gte 1>>
			<<addSpeechLine "playerHits" 3>>
				<<print $_stringsPre>>"이러면서 느낀다는 거 알아, 이 뻔뻔한 꼬맹이 새끼야."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechPlead is 1)>>
		<<addSpeechLine "plead">>
		<<speechLine>>
			<<print $_stringsPre>>"말로는 못 구해."
		<<speechLine>>
			<<print $_stringsPre>>"아직 안 끝났다."
		<<speechLine>>
			<<print $_stringsPre>>"계속 빌어. 달라지는 건 없으니까."
		<</addSpeechLine>>
		<<if $baileySafeWordEncounter>>
			<<addSpeechLine "plead">>
				<<print $_stringsPre>>"그 말을 알잖아. 진심이면 써."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechArms is 1)>>
		<<addSpeechLine "arms">>
		<<speechLine>>
			<<print $_stringsPre>>"엎드려 있어."
		<<speechLine>>
			<<print $_stringsPre>>"마음껏 날뛰어 봐."
		<<speechLine>>
			<<print $_stringsPre>>"이건 못 빠져나가."
		<<speechLine>>
			<<print $_stringsPre>>"이번엔 어떻게 빠져나가나 보자."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechSpank is 1)>>
		<<addSpeechLine "spank">>
		<<speechLine>>
			<<print $_stringsPre>>"더 세게? 좋아."
		<<speechLine>>
			<<print $_stringsPre>>"도움이 되면 세어 봐."
		<<speechLine>>
			<<print $_stringsPre>>"이번엔 배우려나."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechScreamForHelp is 1)>>
		<<addSpeechLine "screamForHelp">>
		<<speechLine>>
			<<print $_stringsPre>>"여기엔 우리뿐이야, 꼬맹이."
		<<speechLine>>
			<<print $_stringsPre>>"아무도 안 온다."
		<<speechLine>>
			<<print $_stringsPre>>"좋아. 비명을 질러. 그럴듯하게."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechApologiseUnforgiving is 1)>>
		<<addSpeechLine "apologise">>
		<<speechLine>>
			<<print $_stringsPre>>"됐다."
		<<speechLine>>
			<<print $_stringsPre>>"미안하지 않다는 거 알아."
		<<speechLine>>
			"네 사과 따위는 필요 없다, 꼬맹이." <<he>>【이가】 쉭쉭거린다. "더 열심히 하란 말이다."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechHair is 1)>>
		<<addSpeechLine "hair">>
		<<speechLine>>
			<<He>>【이가】 당신의 머리채를 뒤로 잡아당긴다. "눈 들어."
		<<speechLine>>
			<<He>>【이가】 당신의 머리채를 잡아 뒤로 끌어당긴다. "어딜 가려고?"
		<<speechLine>>
			<<He>>【이가】 당신의 머리카락을 주먹에 감는다. "이리 와."
		<</addSpeechLine>>
	<</if>>
	<<if ($speechStripStruggle is 1)>>
		<<addSpeechLine "struggle">>
		<<speechLine>>
			<<print $_stringsPre>>"숨을 데가 줄었군."
		<<speechLine>>
			<<print $_stringsPre>>"네 무덤만 더 파고 있어."
		<<speechLine>>
			<<print $_stringsPre>>"마음껏 발버둥 쳐. 달라지는 건 없으니까."
		<</addSpeechLine>>
	<</if>>
	<<if $enemyanger gt 100>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<print $_stringsPre>>"욕심 많은 꼬맹이."
		<<speechLine>>
			<<print $_stringsPre>>"이 꼬맹이 새끼가."
		<<speechLine>>
			<<print $_stringsPre>>"넌 언제 그만둬야 하는지를 몰라."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<print $_stringsPre>>"그래, 됐다. 다 쏟아 내."
		<<speechLine>>
			<<print $_stringsPre>>"더 나올 게 있다는 거 알아, 꼬맹이."
		<<speechLine>>
			<<print $_stringsPre>>"이 정도는 견딜 수 있어."
		<</addSpeechLine>>
	<</if>>
	<<if $enemyhealth gte $enemyhealthmax * 0.75>>
		<<addSpeechLine "idle" 3>>
		<<speechLine>>
			<<print $_stringsPre>>"따라와."
		<<speechLine>>
			<<print $_stringsPre>>"자, 어서. 기다리고 있다."
		<<speechLine>>
			<<print $_stringsPre>>"어서? 밤새 기다릴 시간은 없어."
		<<speechLine>>
			<<print $_stringsPre>>"그보다는 잘할 수 있잖아."
		<<speechLine>>
			<<print $_stringsPre>>"해 봐, 꼬맹이. 뭘 할 수 있는지 보여 봐."
		<</addSpeechLine>>
	<<elseif $enemyhealth lte $enemyhealthmax * 0.4>>
		<<addSpeechLine "idle" 3>>
		<<speechLine>>
			<<Hes>> 말이 없어졌다. 당신은 <<him>>【이가】 이렇게 신이 난 모습을 거의 본 적이 없다.
		<<speechLine>>
			<<Hes>> 말이 없어졌다. <<His>> 눈이 무언가 사나운 것으로 이글거린다.
		<<speechLine>>
			<<Hes>> 말이 없어졌지만, <<his>> 얼굴에 떠오른 비웃음을 알아볼 수 있다.
		<</addSpeechLine>>
	<</if>>
	<<if $pain gte 60>>
		<<addSpeechLine "idle" 3>>
			<<He>>【이가】 눈물 어린 당신의 얼굴을 시큰둥하게 쳐다본다.
		<<speechLine>>
			"나약한 꼬맹이 새끼."
		<<speechLine>>
			"이보다는 강하잖아."
		<<speechLine>>
			"벌써 끝났다고 하진 마."
		<<speechLine>>
			"견딜 수 있다고 생각했더니 말이야."
		<</addSpeechLine>>
		<<speechresolve>>
		<<if _speechAttitudeResolved is "bratty">>
			<<addSpeechLine "idle" 3>>
				<<He>>【이가】 눈물 어린 당신의 얼굴을 시큰둥하게 쳐다본다. "그렇게 큰소리치더니."
			<</addSpeechLine>>
		<</if>>
	<</if>>
<</widget>>
