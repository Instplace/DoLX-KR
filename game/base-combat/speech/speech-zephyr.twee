:: Widgets speech-Zephyr [widget]
<<widget "speech-zephyr">>
	<<set _npc_speech to true>>
	<<if $possessed>>
		<<if $control gte $controlmax>>
			<<He>>【이가】 콧방귀를 뀐다. "이제 가봐라. 그리고 <<phim "Zephyr">>【을를】 가만히 내버려 둬."
		<<elseif $npcspeechcycle is 0>>
			<<He>>【이가】 망원경을 잠시 눈에 갖다 대더니 치워버린다.
		<<else>>
			<<He>>【은는】 말없이 당신을 빤히 바라본다.
		<</if>>
	<<else>>
		<<set _zephyrPenisSize to 0>>
		<<if def _n and $NPCList and $NPCList[_n] and $NPCList[_n].penissize>>
			<<set _zephyrPenisSize to $NPCList[_n].penissize>>
		<<elseif C.npc and C.npc.Zephyr and C.npc.Zephyr.penissize>>
			<<set _zephyrPenisSize to C.npc.Zephyr.penissize>>
		<</if>>
		<<speechPool "Zephyr">>
		<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Zephyr") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Zephyr")>>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 낮게 웃는다. "아직 숨 쉬고 있어? 그 거대한 게 널 두 동강 낼 줄 알았는데."
					<<speechLine>>
						【이가】 낮게 휘파람을 분다. "아직 숨 쉬고 있어? 내 전리품이 두 동강 났나 했는데."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 씩 웃는다. "하. 생각보다 잘 버텼네."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 피식 웃는다. "그 표정은 못 숨겨. 한 치도 빠짐없이 다 느꼈지."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 <<his>> 혀를 찬다. "첫 경험인데 고작 그걸로 벌벌 떨게 된 거냐?"
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 피식 웃는다. "이게 네가 처음 맛본 나라는 거군. 그렇게 멍한 얼굴은 하지 마."
					<<speechLine>>
						【이가】 씩 웃는다. "바다에서 첫 경험 하나가 사라졌군. 그렇게 놀란 표정 짓지 마, <<lass>>【아야】."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 당신이 숨을 헐떡이며 버티는 걸 지켜본다. <<his>> 눈에 즐거운 기색이 역력하다. "그래, 그렇게. 일어서려 하기 전에 파도가 가라앉게 둬."
					<<speechLine>>
						【이가】 당신을 부축한다. "하마터면 가라앉을 뻔했어. 내가 다시 움직이기 전에 숨 쉬어."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 만족스러운 숨을 내쉰다. "첫 항해치고 거친 물살이었지. 살아남았군."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 피식 웃는다. "그건 쉽게 못 잊을걸."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 코웃음 친다. "거기가 처음이었다고? 놀라운 녀석이군."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 <<his>> 고개를 갸웃한다. "첫 번째 점령 완료."
					<<speechLine>>
						【이가】 낄낄 웃는다. "그 표정을 보니 미지의 바다를 찾아낸 모양이군."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechOralVirgin is 1 and $player.virginity.oral is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 웃는다. "하마터면 빠져 죽을 뻔했지? 숨 쉴 수 있을 때 쉬어."
					<<speechLine>>
						【이가】 엄지로 당신의 턱선을 쓸어내린다. "저 크기를 감당하다니 용감한 입이군. 깨물지만 않으면 뱃사람다운 솜씨였다고 해 주지."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 씩 웃는다. "깨물면 후회하게 만들어 주지."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 엄지로 당신의 입술을 훑는다. "첫 시도치고는 나쁘지 않아."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>>【이가】 눈썹을 치켜올린다. "처음이라고? 하. 더 허둥댈 줄 알았는데."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						【이가】 피식 웃는다. "이 맛을 기억해 둬. 다음에 알아볼 테니."
					<<speechLine>>
						【이가】 웃는다. "입으로는 처음이라고? 그럼 이빨 조심해, <<lass>>【아야】."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Zephyr">>
			<<addSpeechLine "virginity">>
				<<He>>
			<<speechLine>>
				【이가】 멈칫하더니 씩 웃는다. "첫 키스라고? 해적한테 건네기엔 위험한 물건이군."
			<<speechLine>>
				【이가】 미소 짓는다. "첫 키스라, 응? 해적이 더 고약한 것도 훔쳐 봤지만 이렇게 달콤한 건 드물었어."
			<</addSpeechLine>>
		<</if>>
		<<if $speechLINameDrop>>
			<<switch _loveInterest>>
				<<case "Gwylan">>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 말한다.
					<<speechLine>>
						"하! 꼬맹이 갈매기는 어때?"
					<<speechLine>>
						"꼬맹이 갈매기! <<nnpc_He "Gwylan">>【이가】 아직도 네 뒤를 팔랑팔랑 따라다니냐?"
					<</addSpeechLine>>
				<<case "Black Wolf">>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 껄껄 웃는다.
					<<speechLine>>
						"오, 흥미로운 얘기가 잔뜩 있군 그래."
					<<speechLine>>
						"내가 같이 항해해 본 어떤 선원들보다도 네가 더 기묘한 얘기를 갖고 있군."
					<</addSpeechLine>>
				<<case "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>>
					<<speechLine>>
						【이가】 껄껄 웃는다. "오, 흥미로운 얘기가 잔뜩 있군 그래."
					<<speechLine>>
						【이가】 웃는다. "높은 곳을 노리나? 발톱 조심하라고."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 피식 웃는다. "육지의 애인이냐, 바다의 심장이냐. 하나만 골라."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechNoticeSexToy is 1>>
			<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<addSpeechLine "sexToy">>
				<<He>>【이가】 당신의 _sexToy【을를】 보고 비뚜름하게 웃는다.
			<<speechLine>>
				"장비를 직접 챙겨 왔다고? 세심하군."
			<<speechLine>>
				"혼자 놀 작정이냐?"
			<<speechLine>>
				"그걸 어디다 흔드는지 조심해. 해적은 쓸 만한 건 훔치거든."
			<<speechLine>>
				"귀여운 장난감이군. 쓰는 법은 알고 있길 바라."
			<<speechLine>>
				"자기 보물을 직접 가져왔다고? 대담하군."
			<</addSpeechLine>>
		<</if>>
		<<if $speechChastity is 1>>
			<<if $worn.genitals.name is "chastity parasite">>
				<<addSpeechLine "chastity">>
					<<He>>【이가】 얼굴을 찡그리며 기생충을 쳐다본다. "저주받은 것 같은 물건이군. 부럽다고는 못 하겠어, <<lass>>【아야】."
				<</addSpeechLine>>
			<<elseif $worn.genitals.name isnot "naked">>
				<<addSpeechLine "chastity">>
					<<He>>【이가】 당신의 정조대 앞쪽을 톡 두드린다. "잠긴 화물이라, 응? 누가 도둑을 걱정했나 보군."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "chastity">>
					<<He>>【이가】 피식 웃는다. "자물쇠도 없어? 해적들 곁에서 용감한 선택이군."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<addSpeechLine "idle">>
			<<if $worn.upper.exposed gte 2 or $worn.lower.exposed gte 2>>
				<<He>>【이가】 당신을 위아래로 훑어본다. "바다에서 그렇게 맨살을 드러내고 다니면 반란이 일어나겠어."
			<<elseif $worn.upper.name isnot "naked" or $worn.lower.name isnot "naked">>
				<<He>>【이가】 당신의 차림새를 슬쩍 훑어본다. "딱 정돈된 꼴은 아니지만, 그만하면 쓸 만해."
			<<else>>
				<<He>>【이가】 웃는다. "짐을 가볍게 하고 여행하는 방법 중 하나로군."
			<</if>>
		<</addSpeechLine>>
		<<speechSay>>
	<</if>>
<</widget>>
