					<<He>> runs <<his>> fingers over your $worn.over_upper.name. "Layered up, are we? Sensible, but not very helpful right now."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.upper.name isnot "naked" and $worn.upper.name isnot "chain tunic" and !$worn.upper.type.includes("holy")>>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> smooths a wrinkle from your $worn.upper.name. "I do like this on you. It would look better on the floor, but still."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.under_upper isnot undefined and $worn.under_upper.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> tugs lightly at your $worn.under_upper.name. "You hid this away as though I wouldn't notice. How cute."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.over_lower isnot undefined and $worn.over_lower.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> hooks a finger under your $worn.over_lower.name. "Another barrier. I admire the optimism."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.lower.name isnot "naked" and $worn.lower.state isnot "waist">>
