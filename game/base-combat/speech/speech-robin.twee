			<<speechLine>>
				"이거 왠지 좀 부끄러운 느낌인데." <<he>>【이가】 <<= either("숨을 헐떡인다", "놀란 듯 말한다")>>.
			<</addSpeechLine>>
		<</if>>
		/* X-Change and mod-only lines. Vanilla lines for the same triggers stay above. */
		<<if $speechpillreveal is 1>>
