:: Widgets speech-Alex [widget]
<<widget "speech-alex">>
	<<set _npc_speech to true>>
	<<set _alexPartner to ($alex_countdown is undefined and $farm_stage gte 7)>>
	<<speechPool "Alex">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Alex") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Alex")>>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"나랑 처음이야? 좋게 해줄게, 파트너."
			<<speechLine>>
				"좋은 기억으로 남게 해줄게."
			<<speechLine>>
				"큰 믿음이네. 헛되이 하진 않을게."
			<<speechLine>>
				"처음이라, 응? 그럼 조심할게. 대신 날 잊게 두진 않을 거야."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"처음이야? 오, 좋은데! 보람 있게 해줄게."
			<<speechLine>>
				"처음이라고? 그럼 내가 시키는 대로 하고 서두르지 마."
			<<speechLine>>
				"내가 더 열심히 할 테니까, 너도 따라와야 해."
			<<speechLine>>
				"그럼 더 특별하네."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 조금 긴장한 채 미소 짓는다.
			<<speechLine>>
				"처음이야? 알았어. 천천히 하자."
			<<speechLine>>
				"내게 큰 걸 주는 거네. 잘해줄게."
			<<speechLine>>
				"멈춰야 하면 말해. 진심이야."
			<<speechLine>>
				"그럼 처음이네. 내가 잘해줄 수 있으면 좋겠다."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"처음이야? 잊지 못하게 각별히 신경 써줄게."
			<<speechLine>>
				"처음이라고? 그럼 엉망으로 만들지 말자."
			<<speechLine>>
				"조심해서 할게. 약속해."
			<<speechLine>>
				"특별한 일이네. 받을 자격이 있게 노력할게."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"차분하게 할게."
			<<speechLine>>
				"나한테 집중해, 파트너. 천천히 하자."
			<<speechLine>>
				"내가 곁에 있어. 서두를 것 없어."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"꽉 조이네. 가만히 있고 내게 맡겨."
			<<speechLine>>
				"날 밀어내지 않으면 금방 익숙해질 거야."
			<<speechLine>>
				"아무한테도 말 안 해. 하지만 그 표정은 기억해 둘 거야."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 침을 꿀꺽 삼킨다.
			<<speechLine>>
				"확실해? 알았어. 조심할게."
			<<speechLine>>
				"이게 처음이야? 그럼 천천히 가자."
			<<speechLine>>
				"너무 힘들면 말해. 아프게 하고 싶진 않아."
			<<speechLine>>
				"그래. 그럼 천천히, 차분하게 가자."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다. "조이는데. 네 엉덩이를 쓰게 해줬다는 건 아무한테도 말 안 할게."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"입으로 하는 건 처음이야? 그럼 조심해. 이빨은 안 돼."
			<<speechLine>>
				"걱정 마. 완벽할 필요 없어, 내가 알려줄게."
			<<speechLine>>
				"천천히 해. 뭐가 좋은지 내가 알려줄게."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 씩 웃는다.
			<<speechLine>>
				"이렇게 입을 써본 적은 없지? 이빨만 안 닿게 조심해."
			<<speechLine>>
				"이빨 조심하면 나도 너무 움직이지 않도록 해볼게."
			<<speechLine>>
				"처음이야? 그럼 잘 듣고 깨물지 마."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 얼굴을 붉힌다.
			<<speechLine>>
				"서두를 필요 없어. 조심하기만 해."
			<<speechLine>>
				"처음이야? 괜찮아. 같이 알아가 보자."
			<<speechLine>>
				"천천히 해. 널 믿어."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"이빨만 조심하면 괜찮을 거야."
			<<speechLine>>
				"그렇게 걱정스러운 얼굴 할 거 없어. 천천히 시작해."
			<<speechLine>>
				"금방 요령이 생길 거야."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"첫 키스도 이거였어? 놀랄 일투성이네, 파트너."
			<<speechLine>>
				"달콤하네..."
			<<speechLine>>
				"첫 키스라고? 그럼 나라서 다행이네."
			<<speechLine>>
				"도시 <<girls>>【은는】 귀엽지만, 너도 만만치 않은 말썽꾼이야."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 씩 웃는다.
			<<speechLine>>
				"도시 <<girls>>【은는】 참 귀엽단 말이지."
			<<speechLine>>
				"첫 키스? 티가 너무 났어."
			<<speechLine>>
				"귀엽네. 숨 쉬는 법도 잊을 뻔했잖아."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 부드럽게 미소 짓는다.
			<<speechLine>>
				"그게 처음이었어? 괜찮았으면 좋겠다."
			<<speechLine>>
				"긴장한 것 같더라. 귀여웠어."
			<<speechLine>>
				"첫 키스라고? 그럼 나 운이 좋네."
			<<speechLine>>
				"좋았어. 좋은 정도가 아니라, 정말로."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다. "첫 키스라고? 그건 잊지 못할 거야."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechLINameDrop>>
		<<if _alexPartner>>
			<<switch _loveInterest>>
				<<case "Bailey">>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 멈칫한다. "베일리? 그 재수 없는 인간?"
					<</addSpeechLine>>
				<<case "Black Wolf">>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 어깨를 늘어뜨린다.
					<<speechLine>>
						"늑대랑 양다리를 걸친 거야? 술이 더 필요하겠어..."
					<<speechLine>>
						"늑대라고? 뭐라고 따져야 할지도 모르겠다."
					<<speechLine>>
						"제발 농담이라고 말해줘."
					<<speechLine>>
						"내가 동물이랑 일하긴 해도, 동물이랑 사귀지는 않아."
					<</addSpeechLine>>
				<<case "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 노려본다.
					<<speechLine>>
						"황무지에서 뇌라도 파먹힌 거냐? 거긴 얼쩡거리지 마."
					<<speechLine>>
						"황무지는 이미 충분히 위험해, 파트너. 널 해칠 이유를 더 주지 마."
					<<speechLine>>
						"그걸 이해해 보려면 술이 한 잔 더 필요하겠어..."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 노려본다.
					<<speechLine>>
						"양다리를 걸쳤어?"
					<<speechLine>>
						"그게 누구든, 지금은 그 이름 듣고 싶지 않아."
					<<speechLine>>
						"우리 사이엔 솔직한 뭔가가 있다고 생각했는데, 파트너."
					<<speechLine>>
						"분명히 말해. 내가 네 파트너야, 아니야?"
					<</addSpeechLine>>
			<</switch>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Black Wolf" "Great Hawk">>
					<<addSpeechLine "namedrop">>
						"<<print either("한 잔 너무 마신 것 같네.", "아니. 그걸 듣고 넘길 만큼 취하진 않았어.", "오늘 밤 헛소리는 이만하면 충분해.", "내가 잘못 들은 걸로 칠래.")>>" <<he>>【이가】 말한다.
					<<speechLine>>
						"말도 안 되는 소리 하네."
					<<speechLine>>
						"동물은 데이트 상대로 안 쳐."
					<<speechLine>>
						"상상하게 만들지 마."
					<<speechLine>>
						"마을 얘기는 날이 갈수록 이상해지네."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						"<<print either("한 잔 너무 마신 것 같네.", "그건 듣고 싶었는지 잘 모르겠다.", "그래. 이름이구나, 그럼.", "분위기 깨는 데는 선수네.")>>" <<he>>【이가】 <<his>> 이마를 짚으며 말한다.
					<</addSpeechLine>>
			<</switch>>
		<</if>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<if C.npc.Alex.dom gte 30>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>>【이가】 쏘아붙인다.
			<<speechLine>>
				"어이. 나한테 그러지 마."
			<<speechLine>>
				"윽. 동물도 이보다는 예의 바르게 걷어찼어."
			<<speechLine>>
				"맞는 건 참아도, 무례는 못 참아."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>>【은는】 움찔한다.
			<<speechLine>>
				"방금 그건 왜 그런 거야?"
			<<speechLine>>
				"이봐. 진정해. 화나게 하려던 건 아니야."
			<<speechLine>>
				"조심해 줘. 아팠어."
			<<speechLine>>
				"알았어. 무슨 말인지 알겠어."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>>【은는】 맞은 곳을 문지른다.
			<<speechLine>>
				"아야. 손이 맵네."
			<<speechLine>>
				"그게 추파였다면 연습이 필요하겠다."
			<<speechLine>>
				"알았어. 뜻은 전달됐어."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<if _alexPartner>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【은는】 숨을 내쉰다.
			<<speechLine>>
				"진정해, 파트너."
			<<speechLine>>
				"나를 봐."
			<<speechLine>>
				"천천히 해. 시간은 많아."
			<<speechLine>>
				"그래, 그거야. 잘하고 있어."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【은는】 씩 웃는다.
			<<speechLine>>
				"그게 낫네, 파트너. 말을 들으니까 더 쉽지?"
			<<speechLine>>
				"이빨은 안 돼."
			<<speechLine>>
				"하는 동안 날 봐."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【은는】 몸을 떤다.
			<<speechLine>>
				"네 입을 거칠게 다루고 싶진 않아."
			<<speechLine>>
				"천천히 해줘. 서두르면 못 버텨."
			<<speechLine>>
				"생각보다 잘하네."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【은는】 숨을 내뱉는다.
			<<speechLine>>
				"살살 하는 거지?"
			<<speechLine>>
				"이빨 조심하고 계속해."
			<<speechLine>>
				"잘하고 있어."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<if C.npc.Alex.dom gte 30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>><<He>>【은는】 당신의 $_sexToy【을를】 보고 씩 웃는다.
			<<speechLine>>
				"이제 좀 되는데."
			<<speechLine>>
				"귀여운 장난감이네. 쓸 줄은 알아야 할 텐데."
			<<speechLine>>
				"도시에선 고작 그게 최선이야?"
			<<speechLine>>
				"도우미를 데려왔어? 따라올 수 있으면 좋겠네."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>><<He>>【은는】 당신의 $_sexToy【을를】 보고 머뭇거린다.
			<<speechLine>>
				"알았어. 네 판단을 믿을게."
			<<speechLine>>
				"그걸 어떻게 쓰는지 알고 있길 바라."
			<<speechLine>>
				"넌 항상 어떻게 해야 재밌는지 잘 아네."
			<<speechLine>>
				"네가 원한다면, 나는 좋아."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>><<He>>【은는】 당신의 $_sexToy【을를】 보고 미소 짓는다.
			<<speechLine>>
				"네 생각, 마음에 들어."
			<<speechLine>>
				"거친 밤이 될 것 같네."
			<<speechLine>>
				"도시에선 이런 게 잘 팔리나 보지."
			<<speechLine>>
				"네 농기구까지 직접 챙겨 올 줄은 몰랐는데."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAskRough is 1>>
		<<if _alexPartner>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>>【은는】 당신을 살피듯 바라본다.
			<<speechLine>>
				"더 거칠게? 너무 버거우면 말해, 파트너."
			<<speechLine>>
				"거칠게 할 순 있어. 그래도 널 살필 거야."
			<<speechLine>>
				"알았어. 그럼 나한테 꽉 매달려."
			<<speechLine>>
				"원한다면 해줄게. 대신 쉬어야 하면 고집부리지 마."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>>【은는】 씩 웃는다.
			<<speechLine>>
				"더 거칠게? 정말? 나 힘쓰는 일로 먹고사는 사람이야."
			<<speechLine>>
				"아프게 하고 싶진 않아. 아프면 말해."
			<<speechLine>>
				"좋아. 그럼 따라와 봐."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>>【은는】 머뭇거린다.
			<<speechLine>>
				"더 거칠게? 확실하다면 해볼 수는 있어."
			<<speechLine>>
				"알았어. 그냥... 너무 심하면 말해줘."
			<<speechLine>>
				"최선을 다할게. 내가 형편없어도 웃지 마."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>>【은는】 낮게 웃는다. "더 거칠게? 좋아, 하지만 경고 안 했다고는 하지 마."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechChastity is 1>>
		<<if playerChastity()>>
			<<if _alexPartner>>
				<<addSpeechLine "chastity">>
					<<set $speechChastity to 0>><<He>>【은는】 자물쇠를 바라본다.
				<<speechLine>>
					"잠겨 있네, 파트너? 열쇠를 쥔 사람이 널 제대로 대해주면 좋겠다."
				<<speechLine>>
					"불편해 보이는데. 그러고 있어도 괜찮아?"
				<<speechLine>>
					"사고 안 치게 막아주긴 하겠네."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "chastity">>
					<<set $speechChastity to 0>><<He>>【은는】 자물쇠를 바라본다.
				<<speechLine>>
					"잠겨 있는 거야? 사고 안 치는 방법으론 그것도 하나지."
				<<speechLine>>
					"꽉 조여 보이네. 괜찮게 버티고 있어?"
				<<speechLine>>
					"그럼 누가 널 단단히 휘어잡고 있나 보네."
				<</addSpeechLine>>
			<</if>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "chastity">>
				<<set $speechChastity to 0>><<He>>【은는】 입꼬리를 올린다.
			<<speechLine>>
				"잠깐 갇혀 있는 것도 너한테 도움이 될지도 몰라."
			<<speechLine>>
				"내버려 두면 사고를 충분히 치잖아."
			<<speechLine>>
				"자물쇠가 인내심을 가르쳐 줄지도 모르지."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "chastity">>
				<<set $speechChastity to 0>><<He>>【은는】 어깨를 으쓱한다.
			<<speechLine>>
				"그쪽은 잘 모른다고 해야겠지만, 배울 수는 있어."
			<<speechLine>>
				"내가 쓰던 장비는 아니지만, 도시 사람들은 별난 걸 좋아하니까."
			<<speechLine>>
				"그걸 위한 자물쇠라고? 허. 쓸모는 있겠네."
			<<speechLine>>
				"그게 네 취향이라면 뭐라 안 할게."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<speechSay>>
<</widget>>
