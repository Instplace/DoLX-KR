:: Widgets reaction-Gwylan [widget]

<<widget "reaction-gwylan-kiss">>
	<<gwylanKiss>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

<<widget "reaction-gwylan-kissDeep">>
	<<gwylanKiss 1>>
	<<if _pcKissVirginityTaken>>
		<br><br>
	<</if>>
<</widget>>

/* PC lines (plead / demand / moan). */

<<widget "pc-line-gwylan-plead">>
	<<if $abomination is 1>>
		<<addSpeechLine "plead">>
			"그윌란, 돌아와! 나 무서워!"
		<</addSpeechLine>>
	<<elseif $hypnosis_traits.devotion gte 1 or $combat_hypnosis>>
		<<addSpeechLine "plead">>
			"그윌란, 제발, 머리가 어떻게 된 것 같아!"
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "plead">>
			"그윌란, 제발, 기분이 이상해!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-gwylan-demand">>
	<<if $abomination is 1>>
		<<addSpeechLine "demand">>
			"그윌란, 거기 있는 거 알아! 정신 차려!"
		<</addSpeechLine>>
	<<elseif $hypnosis_traits.devotion gte 4 or $combat_hypnosis>>
		<<addSpeechLine "demand">>
			"그윌란, 그만해! 내 머릿속에서 나가!"
		<</addSpeechLine>>
	<<elseif $gwylanSeen.includes("romance")>>
		<<addSpeechLine "demand">>
			"그윌란, 그만해! 약속했잖아!"
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "demand">>
			"그윌란, 그만해!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-gwylan-moan">>
	<<addSpeechLine "moan">>
		"나 홀린 것 같아."
	<</addSpeechLine>>
<</widget>>
