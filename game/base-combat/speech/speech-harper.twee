:: Widgets speech-Harper [widget]
<<widget "speech-harper">>
	<<set _npc_speech to true>>
	<<set _harperPenetratorSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _harperPenetratorSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _harperColossalPenetrator to _harperPenetratorSize gte 5>>
	<<speechPool "Harper">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Harper") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Harper")>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 당신의 얼굴을 유심히 살핀다.
			<<speechLine>>
				"동공이 크게 풀렸군요. 호흡이 얕습니다. 의식을 유지해 주세요. 반응을 봐야 하니까요."
			<<speechLine>>
				"당신의 몸이 침입을 거부하려고 애쓰고 있습니다. 정상이에요. 흥미로운 건 그 시도가 실패하고 있다는 점이죠."
			<<speechLine>>
				"극단적인 확장, 급성 충격 반응, 그런데도 의식 소실은 없군요. 좋습니다. 계속 숨 쉬세요."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"조금 아플 뿐입니다."
			<<speechLine>>
				"가만히 계세요. 혈압을 확인해야 합니다."
			<<speechLine>>
				"첫 삽입 기록. 평가하는 동안 긴장하지 않도록 해 보세요."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Harper">>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 집중한 눈으로 당신을 지켜본다.
			<<speechLine>>
				"심한 항문 확장. 턱이 굳고, 맥박이 빠르고, 호흡이 불안정합니다. 정신 붙드세요."
			<<speechLine>>
				"거의 압도당했다고요? 좋습니다. 당신의 한계가 정확히 어디인지 알고 싶군요."
			<<speechLine>>
				"기절하지 마세요. 너무 일찍 늘어지면 전체 반응을 평가할 수 없습니다."
			<</addSpeechLine>>
		<<elseif $player.sex is "f">>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"좌약을 투여하겠습니다. 부디 긴장을 풀어 주세요."
			<<speechLine>>
				"근육이 긴장하면 더 힘들어져요. 제대로 검사할 수 있게 해 주세요."
			<<speechLine>>
				"약간의 압박은 예상된 일입니다. 제가 관찰해야 하는 건 당신의 반응이에요."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"전립선 검사를 받을 때가 지났군요. 부디 긴장을 풀어 주세요."
			<<speechLine>>
				"꿈틀거리지 마세요. 전립선을 평가하기 더 어려워집니다."
			<<speechLine>>
				"자. 직접 압박입니다. 생각하기 어려워지면 말해 주세요."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Harper">>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 당신의 턱을 들어 올린다.
			<<speechLine>>
				"기도 반응이 최우선입니다."
			<<speechLine>>
				"턱의 긴장이 벌써 보이는군요. 흥미롭습니다. 할 수 있는 만큼 크게 벌리세요."
			<<speechLine>>
				"편하게 받아들이기엔 너무 크군요. 그래서 당신의 노력이 더욱 참고가 됩니다."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 미소 짓는다.
			<<speechLine>>
				"'아' 해 보세요..."
			<<speechLine>>
				"크게 벌리세요. 목구멍을 잘 봐야 합니다."
			<<speechLine>>
				"이빨 조심하세요. 이건 검진입니다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Harper">>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 미소 짓는다.
		<<speechLine>>
			"환자를 대하는 제 태도는 어떤가요?"
		<<speechLine>>
			"키스 하나에 맥박이 올랐군요. 사랑스럽습니다."
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechHermAroused to 0>><<He>>【이가】 흥미롭다는 듯 당신을 바라본다.
		<<speechLine>>
			"두 세트 모두군요. 흔치 않지만, 이 마을에서 전례가 없진 않습니다."
		<<speechLine>>
			"복합적인 양상이군요. 더 긴 검사가 필요하겠습니다."
		<<speechLine>>
			"흥미로운 해부학적 구조네요. 그렇게 긴장한 표정은 짓지 마세요."
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechCrossdressAroused to 0>><<He>>【이가】 <<his>> 안경을 고쳐 쓴다.
		<<speechLine>>
			"겉모습과 해부학적 구조가 항상 일치하는 건 아닙니다. 새삼스러운 일도 아니고요."
		<<speechLine>>
			"기록해 두죠. 옷보다 보여지는 것에 대한 당신의 반응이 더 흥미롭군요."
		<<speechLine>>
			"불안한 반응이군요. 수치심인가요, 흥분인가요, 아니면 둘 다인가요?"
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop>>
		<<switch _loveInterest>>
			<<case "Gwylan">>
				<<addSpeechLine "namedrop">>
					<<He>>【이가】 말한다.
				<<speechLine>>
					"흥미롭군요. 환각에 그런 이름을 붙이다니, 상상력이 아주 건강하시네요."
				<<speechLine>>
					"아직도 그 망상에 매달리고 있나요? 관찰을 늘려야겠군요."
				<</addSpeechLine>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 고개를 젓는다.
				<<speechLine>>
					"말씀드렸다시피, 그런 동물은 존재하지 않습니다."
				<<speechLine>>
					"짐승에 대한 집착. 기록해 두죠. 통제된 환경에서 이야기해 봐야겠습니다."
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 고개를 끄덕인다.
				<<speechLine>>
					"이전의 애착이군요. 기록해 두겠습니다."
				<<speechLine>>
					"차트에 올릴 또 하나의 이름이군요. 그 이야기는 나중에 다시 하죠."
				<<speechLine>>
					"정서적 복잡성이군요. 언젠가는 늘 드러나죠."
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if $speechscratch is 1>>
		<<if $enemyanger gte 80>>
			<<addSpeechLine "playerHits">>
				<<set $speechscratch to 0>><<set $enemyanger += 20>><<set $enemytrust -= 35>><<He>>【이가】 긁힌 자국에서 당신에게로 시선을 옮긴다.
			<<speechLine>>
				"환자의 공격성이 격화되고 있군요. 더 단단한 구속이 필요하겠습니다."
			<<speechLine>>
				"안전하게 검사하기 어려워지고 있어요. 제가 바로잡겠습니다."
			<<speechLine>>
				"흥미롭군요. 저에게는 통증 반응, 당신에게는 공황 반응. 어느 쪽이 더 오래가는지 보죠."
			<<speechLine>>
				"담당 의사를 할퀴는 건 판단이 좋지 않군요. 기록해 두겠습니다."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "playerHits">>
				<<set $speechscratch to 0>><<set $enemyanger += 10>><<set $enemytrust -= 20>><<He>>【이가】 붉은 선을 만지고는 흥미롭게 당신의 얼굴을 지켜본다.
			<<speechLine>>
				"반사적 공격성. 예측 가능하군요."
			<<speechLine>>
				"방어적 행동 기록. 계속하기 전에 이를 고려해야겠습니다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<addSpeechLine "playerHits">>
			<<set $speechPlayerHits to 0>><<He>>【이가】 자국을 만지고 미소 짓는다.
		<<speechLine>>
			"통증 반응은 정상이군요. 좋습니다."
		<<speechLine>>
			"반사적 공격성. 다소 예측 가능하지만, 유용하군요."
		<<speechLine>>
			"겁먹으면 더 세게 때리는군요. 기억해 두겠습니다."
		<</addSpeechLine>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【은는】 당신의 목구멍이 <<him>>【을를】 감싸고 움직이는 모습을 지켜본다.
			<<speechLine>>
				"구역 반사가 훌륭하게 저항하고 있군요."
			<<speechLine>>
				"그 크기라면 실수할 여유가 거의 없죠."
			<<speechLine>>
				"예외적인 긴장 상태입니다. 제가 관찰하는 동안 그 자세를 유지하세요."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>>【이가】 부드럽게 말한다.
			<<speechLine>>
				"턱의 힘을 빼세요. 훨씬 좋아졌어요."
			<<speechLine>>
				"구역 반사가 길들여지고 있군요."
			<<speechLine>>
				"많이 나아졌습니다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
			<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>><<He>>【이가】 당신의 $_sexToy【을를】 보고 미소 짓는다.
		<<speechLine>>
			"자가 치료인가요? 적극적이시군요."
		<<speechLine>>
			"그걸 더 가까이 가져오세요. 크기를 제대로 고르셨는지 보고 싶군요."
		<<speechLine>>
			"흥미로운 장비군요. 그것도 검사의 일부로 삼을 수 있겠습니다."
		<</addSpeechLine>>
	<</if>>
	<<if $speechExposeGenitals is 1 and playerChastity()>>
		<<addSpeechLine "expose">>
			<<set $speechExposeGenitals to 0>><<He>>【이가】 당신의 <<printChastity>>【을를】 살핀다.
		<<speechLine>>
			"구속 장치 확인. 부기나 감각 저하, 혹은 잘못된 판단은 없나요?"
		<<speechLine>>
			"불편해 보이는군요. 다행히 불편함은 측정할 수 있습니다."
		<<speechLine>>
			"깔끔한 처치군요. 누가 처방했나요?"
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaPenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "penetrated">>
				<<He>>【이가】 당신의 거친 숨소리 너머로 말한다.
			<<speechLine>>
				"극심한 압박인데도 반응은 유지되고 있군요. 좋습니다."
			<<speechLine>>
				"예상보다 몸이 빨리 적응하고 있어요."
			<<speechLine>>
				"그 표정이 당신의 차트보다 더 많은 걸 말해 주는군요."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "penetrated">>
				<<He>>【이가】 침착하게 당신을 관찰한다.
			<<speechLine>>
				"호흡이 불규칙합니다. 엉덩이 반응이 좋군요. 잘하고 계세요."
			<<speechLine>>
				"배의 힘을 빼세요. 필요 이상으로 힘들게 만들고 있어요."
			<<speechLine>>
				"말하지 않으셔도 그 반응은 아주 명확합니다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusPenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "penetrated">>
				<<He>>【이가】 <<his>> 목소리를 낮춘다.
			<<speechLine>>
				"심한 압박, 다리 떨림, 얕은 호흡. 깨어 계세요."
			<<speechLine>>
				"한계가 가깝군요. 그 한계가 움직이는지 보고 싶습니다."
			<<speechLine>>
				"위험한 양을 받아들이고 계시네요. 임상적으로 인상적입니다."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "penetrated">>
				<<He>>【이가】 말한다.
			<<speechLine>>
				"조이지 마세요. 검사가 덜 정확해집니다."
			<<speechLine>>
				"그 반응은 정확히 제가 예상한 대로입니다."
			<<speechLine>>
				"조이는 반응이지만, 다룰 만합니다."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechPlayerOrgasm is 1 and random(1, 3) is 1>>
		<<addSpeechLine "playerOrgasm">>
			<<He>>【은는】 흥미롭게 당신의 반응을 지켜본다.
		<<speechLine>>
			"절정 반응 기록."
		<<speechLine>>
			"자, 그렇죠. 당신의 말보다 훨씬 읽기 쉽군요."
		<<speechLine>>
			"명확한 결과군요. 깔끔한 데이터는 정말 좋아합니다."
		<</addSpeechLine>>
	<</if>>
	<<addSpeechLine "idle">>
		<<He>>【이가】 숨을 내쉬고는 절제된 미소를 지어 보인다.
	<<speechLine>>
		"첫 접촉 기록. 기술은 개선이 필요하지만, 결과는 유망하군요."
	<<speechLine>>
		"흥미롭군요. 제 맥박이 예상보다 높습니다."
	<<speechLine>>
		"조금 서툴지만 임상적으로 유용합니다. 계속하세요."
	<</addSpeechLine>>
	<<speechSay>>
<</widget>>
