:: Widgets speech-Whitney [widget]
<<widget "speech-whitney">>
	<<set _npc_speech to true>>
	<<set _whitneyPenisSize to ($NPCList[_n] && $NPCList[_n].penissize !== undefined) ? $NPCList[_n].penissize : (C.npc?.Whitney?.penissize || 0)>>
	<<set _whitney to $NPCList.find(npc => npc.fullDescription === "Whitney")>>
	<<if !$whitneyUniqueComments>>
		<<set $whitneyUniqueComments to []>>
	<</if>>
	<<speechPool "Whitney">>
	<<if $speechFallenTransform is 1>>
		<<if $consensual is 0 and $audiencepresent gte 1>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 당신이 무너지는 걸 보고 말을 잃지만, 곧 웃음을 터뜨린다. "그런 표정 짓지 마! 너도 이게 좋잖아, 안 그래?"
			<</addSpeechLine>>
		<<elseif $consensual is 0>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 웃기 시작하다가, 당신이 무너지는 걸 보고 이내 얼굴을 찡그린다. "그딴 짓 그만둬. 지금 너 존나 소름 끼쳐, 걸레야."
			<</addSpeechLine>>
		<<elseif $consensual is 1>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 웃기 시작하다가, 당신이 무너지는 걸 보고 입을 다물고 불안한 눈길을 힐끔거린다. "...야. 야!"
			<</addSpeechLine>>
		<</if>>
	<<else>>
		<<if $player.virginity.vaginal is "Whitney" and $speechVaginaVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 비웃는다. "이제 처녀란 소리는 못 듣겠네. 넌 이제 내 천박한 걸레년이야."
			<</addSpeechLine>>
		<</if>>
		<<if $player.virginity.penile is "Whitney" and $speechPenisVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 웃는다. "두고 봐, 걸레야. 내가 네 첫 번째가 되어 줄 거고, 네가 겪어 본 것 중에 최고일 거야!"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $player.virginity.anal is "Whitney">>
		<<if $speechAnusVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 크게 웃는다. "여긴 안 된다 이거냐? 네가 뒈질 듯이 꽥꽥거리는 소릴 듣고 싶다고, <<bitch>>【아야】!"
			<</addSpeechLine>>
		<</if>>
		<<if $consensual is 1>>
			<<if $speechAnusVirgin>>
				<<addSpeechLine "virginity">>
