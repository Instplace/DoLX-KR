:: Widgets speech-Leighton [widget]
<<widget "speech-leighton">>
	<<set _npc_speech to true>>
	<<set _leightonSize to 0>>
	<<if def _n and $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _leightonSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _leightonColossal to _leightonSize gte 5>>
	<<speechPool "Leighton">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Leighton") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Leighton")>>
		<<addSpeechLine "virginity">>
			<<if $speechVaginaVirgin is 1 and _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "아직 의식이 있나? 좋다. 그 정도면 적당한 진전이라고 해 두지. 다만 네 기술은 시급히 바로잡아야겠군."
			<<else>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("만족스럽기엔 한참 멀었다. 더 나아지도록 다시 나를 찾아오라.", "형편없는 첫 시도지만, 고칠 수 없을 정도는 아니군.", "가능성은 있다. 아주 조금이지만, 다룰 만큼은 된다.", "그걸 받아들일 만하다고 하려면 훨씬 더 연습해야 한다.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Leighton">>
		<<addSpeechLine "virginity">>
			<<if _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "불가능하게 느껴진다는 건 안다. 하지만 규율이란 불편할 때도 해내는 것이다."
			<<else>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("훈련이 아주 많이 필요하겠군.", "서툴렀다. 배울 때까지 반복해야겠어.", "어려운 수업이지만, 분명 네게 필요했던 수업이다.", "그렇게 충격받은 표정 짓지 마라. 엄격한 지도가 필요할 수밖에 없었으니까.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Leighton">>
		<<addSpeechLine "virginity">>
			<<if _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "나는 숨 막혀 하는 공황이 아니라 복종을 기대한다. 제대로 벌려라."
			<<else>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("기술이 부족하군... 아직은.", "자세가 형편없다. 계속 연습해라.", "그보다는 잘할 수 있다. 증명해 보이길 기대한다.", "그 입도 나머지 몸처럼 규율이 필요하군.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Leighton">>
		<<addSpeechLine "virginity">>
			<<He>>【이가】 비릿하게 웃는다. "<<print either("첫 경험치고는 나쁘지 않군.", "조금 열성적이었지 않나? 걱정 마라, 알아챘으니.", "거의 봐줄 만했다. 거의.", "그게 아무 의미도 없었던 척해도 좋다. 그래야 얌전히 구는 데 도움이 된다면.")>>"
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop is 1>>
		<<addSpeechLine "namedrop">>
			<<set $speechLINameDrop to 0>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>>【이가】 씨익 웃는다. "다른 학생이라? <<nnpc_him "Robin">>도 내 사무실로 한번 불러야겠군."
				<<case "Kylar">>
					<<He>>【이가】 눈살을 찌푸린다. "<<print either("카일라? 많은 게 설명되는군.", "또 카일라인가. 네 기준이 그렇게 형편없다는 걸 알았어야 했는데.", "그 집착하는 불쌍한 녀석 말이냐? 넌 문제를 모으는 재주가 있군.")>>"
				<<case "Whitney">>
					<<He>>【이가】 눈살을 찌푸린다. "<<print either("너랑 그 불량배? 놀랍지도 않군.", "휘트니? 그렇겠지. 천박함은 천박함을 끌어당기는 법이다.", "그 불량배가 네게 끔찍한 버릇을 가르쳤군. 내가 바로잡아 주마.")>>"
				<<case "Bailey">>
					<<He>>【이가】 눈살을 찌푸린다. "베일리? 다음 서신을 주고받을 때 <<nnpc_him "Bailey">>에게 이 일을 물어봐야겠군."
				<<case "Sydney">>
					<<if $sydneySeen.includes("spank")>>
						<<if random(1, 2) is 1>>
							<<He>>【이가】 씨익 웃는다. "시드니? 다음번엔 내 사무실에서 <<nnpc_his "Sydney">> 체벌을 해야겠군."
						<<else>>
							<<He>>【이가】 미소 짓는다. "시드니는 내 사무실이 얼마나 쓸모 있는지 이미 배웠다. 너희 둘 다 한 번 더 수업이 필요할지도 모르겠군."
						<</if>>
					<<else>>
						<<if random(1, 2) is 1>>
							<<He>>【이가】 씨익 웃는다. "시드니? 조만간 그 녀석도 내 방에 부를 작정이다."
						<<else>>
							<<He>>【이가】 미소 짓는다. "시드니는 개인 면담이 한참 밀려 있다. 네가 방금 그걸 상기시켜 준 셈이군."
						<</if>>
					<</if>>
				<<case "Black Wolf" "Great Hawk">>
					<<He>>【이가】 눈살을 찌푸린다. "<<print either("짐승이라고? 추가 훈육이 필요하겠군.", "그건 연애가 아니다. 자제력이 완전히 결여됐다는 증거일 뿐이다.", "알겠다. 네 교정은 내가 생각했던 것보다 더 철저해야겠군.")>>"
				<<default>>
					<<He>>【이가】 비릿하게 웃는다. "<<print either("모르는 이름이군. 어차피 사적인 일이다.", "또 방해물인가? 지겹군.", "그게 누구든, 네게 절제를 충분히 가르치지 못한 게 분명하군.", "애착은 간직해도 좋다. 여기선 도움이 안 될 테니.")>>"
			<</switch>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<addSpeechLine "playerHits">>
			<<set $speechPlayerHits to 0>>
			<<He>>【이가】 크게 소리 내어 웃는다. "<<print either("이제야 말을 듣고 얌전해지려나!", "좋다. 말이 통하지 않을 때는 고통이 훌륭한 스승이지.", "드디어 네 주의를 끌었군.", "노려보지 마라. 더 죄지은 얼굴로 보이니까.")>>"
		<</addSpeechLine>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<addSpeechLine "oral">>
			<<set $speechMouthPenetrated to 0>>
			<<if _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "날 실망시키지 마라."
			<<else>>
				<<He>>【이가】 미소 짓는다. "<<print either("착하게 굴었으니 보상이다.", "그렇지. 입이 바쁠 때가 훨씬 낫군.", "배우는 동안 나를 보고 있어라.", "노력이 따르는 침묵은 너한테 어울리는군.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
			<<set $speechNoticeSexToy to 0>>
			<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<He>>【이가】 당신의 $_sexToy【을를】 보고 비릿하게 웃는다. "<<print either("그걸로 한두 가지는 가르쳐 줄 수 있다.", "감독 없이 연습할 생각인가? 무책임하군.", "그걸 내 사무실로 가져와라. 사용을 허락해 줄지도 모른다.", "적어도 이제야 주도성을 보이는군.")>>"
		<</addSpeechLine>>
	<</if>>
	<<if $speechAskRough is 1>>
		<<addSpeechLine "askRough">>
			<<set $speechAskRough to 0>>
			<<He>>【이가】 비릿하게 웃는다. "<<print either("더 엄한 훈육을 청하나? 솔직하군.", "거칠게 원하나? 그럼 내가 제대로 바로잡을 때 징징대지 마라.", "그런 요청은 내 사무실에서 하는 것이다.")>>"
		<</addSpeechLine>>
	<</if>>
	<<if $speechChastity is 1>>
		<<addSpeechLine "chastity">>
			<<set $speechChastity to 0>>
			<<if playerChastity()>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("잠겨 있나?", "현명한 조치군. 안 그러면 분명 믿을 수 없을 테니.")>>"
			<<else>>
				<<He>>【이가】 미소 짓는다. "더 엄격히 통제해야겠다고 생각해 봐야겠군. 넌 감독을 자초하는군."
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaPenetrated is 1 or $speechVagina is 1>>
		<<addSpeechLine "penetrated">>
			<<set $speechVaginaPenetrated to 0>>
			<<set $speechVagina to 0>>
			<<if _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "너무 벅차냐? 아니다. 넌 이 수업을 견딜 수 있다. 증명해 봐라."
			<<else>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("진정해라. 꿈틀댄다고 성적이 오르진 않는다.", "지도를 받아들이는 법을 배우고 있군.", "가만히 있으면 이걸 진전이라고 해 줄 수도 있다.", "그렇게 소란 피울 필요 없다. 잘 해내고 있으니.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusPenetrated is 1 or $speechAnus is 1>>
		<<addSpeechLine "penetrated">>
			<<set $speechAnusPenetrated to 0>>
			<<set $speechAnus to 0>>
			<<if _leightonColossal>>
				<<He>>【이가】 미소 짓는다. "그 표정이 어울리는군. 충격, 노력, 그리고 마침내 네 수업의 규모에 대한 약간의 존중."
			<<else>>
				<<He>>【이가】 비릿하게 웃는다. "<<print either("적응하게 될 거다. 불평한다고 실패하는 건 아니다.", "어려운 수업이지만, 어려움이 인격을 만든다.", "관심을 원했지. 이제 내 관심을 받고 있다.")>>"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechscratch is 1>>
		<<addSpeechLine "playerHits">>
			<<set $speechscratch to 0>>
			<<if $enemyanger gte 80>>
				<<print either(
					`<<He>>【이가】 움직임을 멈추고 싸늘한 분노로 긁힌 자국을 응시한다. "실수였다. 방금 네 처지를 훨씬 악화시켰다."`,
					`<<He>>【이가】 자국을 만지고는 매서운 눈으로 당신을 쏘아본다. "이젠 폭력인가? 좋다. 그렇다면 더는 점잖게 바로잡을 필요가 없군."`,
					`<<He>>【이가】 턱에 힘을 준 채 천천히 숨을 들이쉰다. "이 수업이 끝나기 전에 그걸 후회하게 될 거다."`,
					`<<He>>【이가】 붉은 선을 보며 목소리를 낮춘다. "나는 참고 있었다. 넌 그걸 약함으로 착각했군."`
				)>>
				<<set $enemyanger += 25>><<set $enemytrust -= 50>>
			<<else>>
				<<print either(
					`<<He>>【이가】 긁힌 자국을 보고 눈살을 찌푸린다. "발톱을 세워? 규율도 없군. 당장 바로잡아 주마."`,
					`<<He>>【이가】 자국을 살피고, 짜증으로 <<his>> 표정이 날카로워진다. "그건 더 엄한 벌을 청하는 초대다."`,
					`<<He>>【이가】 당신의 손목을 붙잡고 눈을 가늘게 뜬다. "또 그러면 이 수업을 훨씬 불편하게 만들어 주마."`,
					`<<He>>【이가】 <<his>> 혀를 찬다. "성질, 폭력, 그리고 형편없는 판단력. 더 가혹한 훈육이 필요하다는 근거를 꽤 열심히 쌓는군."`
				)>>
				<<set $enemyanger += 15>><<set $enemytrust -= 30>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerOrgasm is 1>>
		<<addSpeechLine "playerOrgasm">>
			<<set $speechPlayerOrgasm to 0>>
			<<He>>【이가】 비릿하게 웃는다. "<<print either("품위 없군. 정신 좀 차리려 해 봐라.", "지저분하지만 교훈적이군.", "자. 예의범절은 몰라도 열의는 눈에 띄게 나아졌군.", "그렇게 빨리 자제력을 잃고도 칭찬을 기대하진 않겠지.")>>"
		<</addSpeechLine>>
	<</if>>
	<<addSpeechLine "idle">>
		<<if random(1, 6) is 1>>
			<<He>>【이가】 눈살을 찌푸린다. "<<print either("눈은 앞으로. 같은 말을 반복하는 건 싫다.", "얌전히 굴면 이건 사적인 교정으로 남을 수도 있다.", "관용을 구할 근거로는 형편없군.", "규율은 대부분의 멍청이에게 낭비다. 네가 그중 하나임을 증명하지는 마라.", "그보다는 나은 자세를 기대한다.", "그래서 감독이 필요한 거다.")>>"
		<<else>>
			<<print [
				`<<He>>【이가】 <<his>> 혀를 찬다. "경직되고, 서투르고, 너무 시끄럽군. 바로잡아 주마."`,
				`<<He>>【이가】 눈썹을 치켜올린다. "기술을 다듬어야겠군. 다행히 나는 훌륭한 교사다."`,
				`<<He>>【이가】 값을 매기듯 당신을 훑어본다. "거친 첫 시도군. 다듬을 수는 있겠다."`,
				`<<He>>【이가】 비릿하게 웃는다. "봐라. 너는 몰라도 네 몸은 지도를 이해하는군."`,
				`<<He>>【이가】 당신을 유심히 지켜본다. "그 반응이면 됐다. 침착함은 차차 다듬어 보지."`,
				`<<He>>【이가】 음, 하고 낮게 소리 낸다. "그 조급함 밑에 가능성이 묻혀 있을지도 모르겠군."`
			][random(0,5)]>>
		<</if>>
	<</addSpeechLine>>
	<<speechSay>>
<</widget>>
