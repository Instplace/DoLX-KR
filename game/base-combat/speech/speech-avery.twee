					<<addSpeechLine "apologise">>
					<<speechLine>>
						"그 좆같은 입 다물어," <<he>>【이가】 씩씩거린다. "그쯤 했으면 됐어."
					<<speechLine>>
						"정말 미안했다면 애초에 그런 짓은 안 했겠지, 이 <<= either("<<bitch>>","<<bastard>>","<<cunt>>")>>【아야】."
					<</addSpeechLine>>
				<</if>>
			<</if>>
		<</if>>

		<<if !$consensual>>
			<<if $speechApologiseUnforgiving>>
