:: Widgets reaction-Bailey [widget]

<<widget "pc-line-bailey-moan">>
	<<addPairedSpeechLine "Bailey" "moan">>
		<<pcLine>>"<<baileyTitle>>의 것을 가져가세요."
	<<npcLine>>
		<<if baileyStraying()>>
			<<print $_stringsPre>>"애초에 네가 내줄 수 있는 게 아니었어."
		<<elseif $baileyMonogamous>>
			<<print $_stringsPre>>"넌 언제나 내 것이었어."
		<<elseif $syndromeBailey>>
			<<print $_stringsPre>>"이미 내 것인 걸 내놓겠다는 거네."
		<<else>>
			<<print $_stringsPre>><<print either(
				`"네 허락은 필요 없어, 꼬맹이."`,
				`"받아낼 건 받아낼 거다."`
			)>>
		<</if>>
	<</addPairedSpeechLine>>
	<<addPairedSpeechLine "Bailey" "moan">>
		<<pcLine>>"제가 얼마나 값어치가 있는지 보여 주세요, <<baileyTitle>>."
	<<npcLine>>
		<<if baileyStraying()>>
			<<print $_stringsPre>>"가장 높은 값을 부르는 놈한테 물어봐."
		<<elseif $baileyMonogamous>>
			<<print $_stringsPre>>"곁에 둘 만큼은 돼."
		<<else>>
			<<print $_stringsPre>>"먼저 곁에 둘 가치가 있다는 걸 보여 봐."
		<</if>>
	<</addPairedSpeechLine>>
	<<if $syndromeBailey>>
		<<addPairedSpeechLine "Bailey" "moan">>
			<<pcLine>><<print either(`"저는 <<baileyTitle>>의 것이에요. 언제나 그랬어요."`, `"언제나 <<baileyTitle>>뿐이었어요."`)>>
		<<npcLine>>
			<<print $_stringsPre>><<print either(
				`"증명해 봐."`,
				`"알고 있어."`,
				`"따라잡고 있군. 좋아."`
			)>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>
