:: Widgets speech-Morgan [widget]
<<widget "speech-morgan">>
	<<set _npc_speech to true>>
	<<set _morganPenisSize to 0>>
	<<if C.npc.Morgan and C.npc.Morgan.penissize>>
		<<set _morganPenisSize to C.npc.Morgan.penissize>>
	<<elseif def _n and $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _morganPenisSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _morganColossalPenis to _morganPenisSize gte 5>>
	<<if $possessed>>
		<<switch random(1,13)>>
			<<case 1>>
				<<He>>【이가】 포효한다. "네가 <<phim "Morgan">>【을를】 다치게 두지 않겠다!"
			<<case 2>>
				<<He>>【이가】 애원한다. "이겨내, <<charles>>! 저항하라고!"
			<<case 3>>
				<<He>>【이가】 침을 뱉듯 말한다. "안개 속으로 돌아가!"
			<<case 4>>
				<<He>>【이가】 노려본다. "나가. <<phim "Morgan">>에게서 떨어져!"
			<<case 5>>
				<<He>>【이가】 노려본다. "네가 무너져가는 게 다 보여."
			<<case 6>>
				<<He>>【이가】 쉿쉿거린다. "두 번 말하게 하지 마라."
			<<case 7>>
				<<He>>【이가】 알 수 없는 비명을 지른다.
			<<case 8>>
				<<He>>【이가】 당신과 눈을 맞추며 안심하라는 듯 고개를 끄덕인다.
			<<case 9>>
				<<He>>【이가】 숨죽여 중얼거린다.
			<<case 10>>
				<<He>>【이가】 고개를 가로젓는다. "너는 추락할 거다. 추락하고 다시는 일어나지 못해."
			<<case 11>>
				<<He>>【이가】 이를 드러낸다. "넌 냄새가 이상해. 소리도 이상하고. <<phim "Morgan">>【을를】 놓아라."
			<<case 12>>
				<<He>>【이가】 목구멍 깊은 곳에서 낮게 으르렁거린다. "안개는 부서진다. 몸도 부서진다. 네가 먼저 부서질 거다."
			<<case 13>>
				<<He>>【이가】 속삭인다. "내 목소리를 잘 들어, <<charles>>. 그걸 따라 돌아와."
		<</switch>>
	<<else>>
		<<speechPool "Morgan">>
		<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Morgan") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Morgan")>>
			<<addSpeechLine "virginity">>
			<<if _morganColossalPenis>>
				<<print [
					`모건이 당신을 붙잡아 가만히 둔 채 갑자기 진지해진다. "숨 쉬렴, <<charles>>. <<Mummy>>【이가】 그 크기에 네가 통째로 삼켜지게 두지 않을 거란다."`,
					`<<He>>【이가】 미소 짓는다. "아직 나랑 같이 있니? 내가 제일 아끼는 살아 있는 걸 부러뜨릴까 봐 걱정했단다."`,
					`모건이 당신의 뺨을 쓰다듬는다. "가엾기도 하지."`,
					`<<He>>【이가】 천천히 숨을 내쉰다. "서두르지 마. 엄청나게 큰 걸 받아냈구나. <<mummy>>【은는】 아주 자랑스럽단다."`
				][random(0,3)]>>
			<<else>>
				<<print [
					`<<He>>【이가】 미소 짓는다. "다시 네 처음이 된 것 같네. 이거 어떻게 한 거야, <<charles>>?"`,
					`모건이 기쁜 듯 고개를 갸웃한다. "<<mummy>>【와과】의 처음이라니. 근사하게 들리지 않니?"`,
					`<<He>>【이가】 부드럽게 웃는다. "넌 정말 따뜻했어. 그렇게 긴장하고. 그 순간을 통째로 먹어 치울 수도 있었단다."`,
					`모건이 당신의 얼굴을 감싸 쥔다. "자. 이제 그 기억은 우리 거란다."`
				][random(0,3)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Morgan">>
			<<addSpeechLine "virginity">>
			<<if _morganColossalPenis>>
				<<print [
					`<<He>>【이가】 당신에게서 한 손을 떼지 않는다. "첫 경험치고는 잔인한 크기였어. 가만히 있으렴. <<mummy>>【이가】 네 몸이 아직 멀쩡한지 확인해 볼게."`,
					`여전히 웃고 있지만 모건의 얼굴에 걱정이 번지기 시작한다. "알아, 알아. 불가능할 것 같았지. 하지만 정말 잘했단다, <<charles>>."`,
					`모건이 당신의 등을 쓸어내린다. "하마터면 내 밑에서 사라져 버릴 뻔했어. <<Mummy>>【이가】 다 봤단다."`
				][random(0,2)]>>
			<<else>>
				<<print [
					`<<He>>【이가】 미소 짓는다. "<<charles>>【아야】, 내가 네 다른 처음까지 가져가게 생겼구나! 멋지지 않니?"`,
					`모건이 흡족한 듯 흥얼거린다. "<<mummy>>한테 또 하나의 처음이구나. 날 너무 오냐오냐해 주는걸."`,
					`<<He>>【이가】 바싹 몸을 기댄다. "앉을 때마다 그게 생각날 거야."`,
					`모건이 부드럽게 웃는다. "수줍기도 해라. 이제 유령에 시달리는 데는 익숙해졌을 줄 알았는데."`
				][random(0,3)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechOralVirgin is 1 and $player.virginity.oral is "Morgan">>
			<<addSpeechLine "virginity">>
			<<if _morganColossalPenis>>
				<<print [
					`모건이 당신의 머리카락 사이로 손가락을 밀어 넣는다. "천천히. 더 크게. 그래, 그렇지, <<charles>>. 자존심 때문에 숨 막히게 하지는 마렴."`,
					`<<He>>【이가】 당신이 애쓰는 모습을 즐겁게 지켜본다. "가여운 입. 죽은 이들이 얼마나 탐욕스러울 수 있는지 <<Mummy>>【이가】 미리 말해 줬어야 했는데."`,
					`모건이 숨을 멈칫한다. "천천히. 배우기엔 끔찍한 크기지, 그렇지?"`,
					`<<He>>【이가】 당신의 뺨을 감싼다. "숨이 필요하면 쉬렴. 난 네가 부서지는 게 아니라 나한테 홀리길 바라는 거란다."`
				][random(0,3)]>>
			<<else>>
				<<print [
					`<<He>>【이가】 미소 짓는다. "어떻게 하는지 다 까먹은 거야?"`,
					`모건이 흡족한 한숨을 쉰다. "이빨 조심하렴, 귀여운 것. <<Mummy>>【은는】 예민하단다."`,
					`<<He>>【이가】 고개를 갸웃한다. "네 입은 기억보다 따뜻하구나."`,
					`모건이 당신의 머리카락을 쓰다듬는다. "그래, 거기 있었구나. 아주 잘 배우고 있어."`
				][random(0,3)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Morgan">>
			<<addSpeechLine "virginity">>
			<<print [
				`<<He>>【이가】 미소 짓는다. "내 맛도 기억 못하는 거야?"`,
				`모건이 당신의 입술 가까이에서 머뭇거린다. "첫 키스라고? 오, <<charles>>, 감상적인 우리 아기."`,
				`<<He>>【이가】 부드럽게 웃는다. "그걸 <<mummy>>한테 줬구나. 어쩜 그렇게 로맨틱할까."`
			][random(0,2)]>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechLINameDrop is 1>>
			<<addSpeechLine "namedrop">>
			<<set $speechLINameDrop to 0>>
			<<switch _loveInterest>>
				<<default>>
					<<He>>【이가】 으르렁거린다. "<<charles>>【아야】, 넌 이 <<mummy>>의 것이란다!"
			<</switch>>
			<</addSpeechLine>>
		<</if>>
		<<if ($NPCList[_n].vagina is "feet" or $NPCList[_n].penis is "feet") and random(1, 10) is 1 and $settings.footFetishEnabled>>
			<<addSpeechLine "footjob">>
			<<print [
				`<<He>>【이가】 신음을 흘린다. "아, <<charles>>, 네 발...!"`,
				`모건이 몸을 떤다. "발까지 따뜻하구나. 너무하잖니."`,
				`<<He>>【이가】 간절한 소리를 내며 더 바싹 붙는다. "계속 움직여 줘."`,
				`모건이 숨 가쁘게 웃는다. "<<Mummy>>【이가】 이렇게나 좋을 줄은 몰랐단다."`
			][random(0,3)]>> /* I hate you I hate you I hate you */
			<</addSpeechLine>>
		<</if>>
		<<if $speechNoticeSexToy is 1>>
			<<addSpeechLine "sexToy">>
			<<set $speechNoticeSexToy to 0>>
			<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 말한다. "` + [
				`<<charles>>【아야】, 저건 뭐야?`,
				`<<mummy>>【을를】 질투하게 만들려는 거니?`,
				`뻔뻔하구나.`,
				`그거 조심하렴. 예의라곤 없는 물건이거든.`
			][random(0,3)] + `"`>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechAskRough is 1>>
			<<addSpeechLine "askRough">>
			<<print [
				`모건이 천천히 미소 짓는다. "더 거칠게?"`,
				`<<He>>【이가】 당신의 뺨을 쓰다듬는다. "예쁘게 부탁해 보렴, <<charles>>."`,
				`모건이 흥얼거린다. "거칠게도 해 줄 수 있고, 부드럽게도 해 줄 수 있단다. 언제 바꿀지 고르는 게 재미지."`
			][random(0,2)]>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechChastity is 1>>
			<<addSpeechLine "chastity">>
			<<print [
				`모건이 당신의 정조대를 유심히 살핀다. "갇혀 있니? <<mummy>>【이가】 쳐다보면 아프니?"`,
				`<<He>>【이가】 손가락 하나로 당신의 정조대를 톡 두드린다. "누가 철이 들어서 널 잘 가둬 놨구나."`,
				`모건이 미소 짓는다. "케이지도 결국 욕망을 위한 작은 집일 뿐이란다."`,
				`<<He>>【이가】 속삭인다. "잠겨 있든 아니든, <<charles>>, 난 여전히 널 꿈틀거리게 만들 수 있단다."`
			][random(0,3)]>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechVaginaPenetrated is 1 or $speechVagina is 1>>
			<<addSpeechLine "penetrated">>
			<<set $speechVaginaPenetrated to 0>>
			<<set $speechVagina to 0>>
			<<if _morganColossalPenis>>
				<<print [
					`모건이 당신을 붙들어 안정시킨다. "끔찍한 크기라는 거 알아. <<mummy>>【이가】 이끌어 줄 테니 따라오렴."`,
					`<<He>>【이가】 당신의 얼굴을 유심히 살핀다. "아직 정신 있니, <<charles>>? 그게 네 숨을 다 빼앗게 두지 마렴."`,
					`모건의 목소리가 그르렁거리듯 낮아진다. "그래, 그거야."`,
					`<<He>>【이가】 신음한다. "그렇게 큰 걸 물고 이렇게 꽉 조이다니. 정말 무모하구나."`
				][random(0,3)]>>
			<<else>>
				<<print [
					`<<He>>【이가】 미소 짓는다. "거기 있었구나, <<charles>>. <<mummy>>【이가】 널 느끼게 해 주렴."`,
					`모건이 당신의 귀에 대고 한숨을 쉰다. "산 몸은 뭔가를 원할 때 정말 시끄럽구나."`,
					`<<He>>【이가】 중얼거린다. "이제 와서 내게서 멀어지지 마렴."`
				][random(0,2)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechAnusPenetrated is 1 or $speechAnus is 1>>
			<<addSpeechLine "penetrated">>
			<<set $speechAnusPenetrated to 0>>
			<<set $speechAnus to 0>>
			<<if _morganColossalPenis>>
				<<print [
					`모건이 당신을 끌어안는다. "그 크기는 조급함을 용서하지 않는단다."`,
					`<<He>>【이가】 숨을 내쉰다. "가엾은 <<charles>>."`,
					`모건이 당신의 등을 쓸어내린다. "<<mummy>>【이가】 다시 움직이기 전에 숨을 쉬렴."`,
					`<<He>>【이가】 미소 짓는다. "너무 버겁니? 내 밑에서 사라지기 전에 말하렴."`
				][random(0,3)]>>
			<<else>>
				<<print [
					`모건이 부드럽고 흡족한 웃음을 흘린다. "그 구멍은 수줍음이 많구나. <<Mummy>>【은는】 수줍은 걸 좋아한단다."`,
					`<<He>>【이가】 중얼거린다. "자. 보렴? 날 위해 자리를 만들 수 있잖니."`,
					`모건의 눈이 반짝인다. "작은 떨림 하나하나가 다 느껴져."`,
					`<<He>>【이가】 흥얼거린다. "조이는구나, <<charles>>."`
				][random(0,3)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechMouthPenetrated is 1>>
			<<addSpeechLine "oral">>
			<<set $speechMouthPenetrated to 0>>
			<<if _morganColossalPenis>>
				<<print [
					`<<He>>【이가】 벌어지는 당신의 입을 미소 띤 얼굴로 지켜본다. "침묵마저 컥컥거리게 만들 크기구나."`,
					`모건이 속삭인다. "턱이 벌리는 법을 기억해 내게 하렴."`,
					`<<He>>【이가】 몸을 떤다. "조심하렴, <<charles>>. <<mummy>>【은는】 네 입이 망가지길 바라는 거지, 부서지길 바라는 게 아니란다."`
				][random(0,2)]>>
			<<else>>
				<<print [
					`모건이 당신의 머리카락을 쓰다듬는다. "좋아. <<mummy>>【을를】 위해 혀를 따뜻하게 하렴."`,
					`<<He>>【이가】 한숨을 쉰다. "이렇게 이상한 일을 하기엔 참 보드라운 입이구나."`,
					`모건이 당신의 뺨을 톡톡 두드린다. "위를 보렴. 네가 배우는 모습을 보고 싶구나."`,
					`<<He>>【이가】 미소 짓는다. "그래. 결국 기억하는구나."`
				][random(0,3)]>>
			<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechPlayerOrgasm is 1>>
			<<addSpeechLine "playerOrgasm">>
			<<print [
				`<<He>>【이가】 미소 짓는다. "엉망이 된 우리 <<charles>>. <<Mummy>>【이가】 다 봤단다."`,
				`모건이 몸을 기울인다. "그게 후련함이었니, 아니면 굴복이었니?"`,
				`<<He>>【이가】 숨죽여 웃는다. "또? 싫니? 네 얼굴은 어쩌면 좋다고 하는데."`
			][random(0,2)]>>
			<</addSpeechLine>>
		<</if>>
		<<addSpeechLine "idle">>
		<<if random(1,5) is 1>>
			<<print [
				`모건이 숨죽여 음정 없는 작은 자장가를 흥얼거린다.`,
				`모건이 중얼거린다. "아직 따뜻하니, <<charles>>?"`,
				`<<He>>【이가】 애정 어린 눈으로 당신을 바라본다.`,
				`모건이 속삭인다. "<<Mummy>>【이가】 바로 여기 있단다."`
			][random(0,3)]>>
		<<else>>
		<</if>>
		<</addSpeechLine>>
		<<speechSay>>
	<</if>>
<</widget>>