:: Widgets speech-Eden [widget]
<<widget "speech-eden">>
	<<set _npc_speech to true>>
	<<set _edenSpeech to "">>
	<<set _edenVirginityName to "Eden">>
	<<set _edenPenetratorSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _edenPenetratorSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _edenColossalPenetrator to _edenPenetratorSize gte 5>>
	<<speechPool "Eden">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is _edenVirginityName) or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is _edenVirginityName)>>
		<<addSpeechLine "virginity">>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`에덴의 목소리가 낮아진다. "숨 쉬어. 네가 기절하면 멈출 거고, 그건 우리 둘 다 원하지 않잖아."`,
				`<<He>>【이가】 당신을 조심스럽게 붙들어 가만히 둔다. "너무 커? 알아. 그러니까 다치기 전에 힘을 빼야 해."`,
				`에덴이 당신의 얼굴을 유심히 지켜본다. "누가 널 차지했는지 정확히 기억해 두길 바라."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>>【이가】 말한다. "네 첫 경험이 느껴졌어. 참을 수가 없었어. 널 가져야 했어."`,
				`에덴이 더 가까이 붙는다. "이제 그 마을 놈들은 아무도 이걸 못 가져가."`,
				`<<He>>【이가】 거칠게 숨을 내쉰다. "내 거야. 들려? 내 거라고."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is _edenVirginityName>>
		<<addSpeechLine "virginity">>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`<<He>>【이가】 당신의 귓가에서 으르렁거린다. "제일 힘든 건 끝났어. 정신 붙들어. 늘어지기만 해 봐."`,
				`에덴의 손아귀에 힘이 들어간다. "덫에 걸린 토끼처럼 떨고 있잖아."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>>【이가】 말한다. "지금은 아프다는 거 알아, 하지만 곧 익숙해질 거야."`,
				`에덴이 당신의 옆구리를 쓰다듬는다. "버티면 더 아파질 뿐이야."`,
				`<<He>>【이가】 으르렁거린다. "들어가게 해 줘. 견딜 수 있을 만큼 단련시켜 줄 테니까."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is _edenVirginityName>>
		<<addSpeechLine "virginity">>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`에덴이 당신의 머리카락을 움켜쥐었다가, <<his>> 손에서 힘을 푼다. "목구멍엔 너무 벅차지. 코로 숨 쉬어, 당황하지 말고."`,
				`<<He>>【이가】 당신을 내려다본다. "젠장. 받아들이기엔 너무 많은가 보군. 그럼 천천히."`,
				`에덴의 목소리가 거칠어진다. "벌릴 수 있는 만큼 벌려. 나머지는 내가 알아서 할게."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>>【이가】 말한다. "젠장, 느낌 좋은데. 앞으로 자주 해야겠어."`,
				`에덴이 이 사이로 숨을 내쉰다. "네 자리가 어딘지 배워 가고 있군."`,
				`<<He>>【이가】 당신의 머리카락을 쓰다듬는다. "그래, 그렇게. 징징대느라 숨 낭비하지 마."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is _edenVirginityName>>
		<<addSpeechLine "virginity">>
		<<set _edenSpeech to either(
			`<<He>>【이가】 말한다. "어땠어? 난 아직 끝난 게 아니지만."`,
			`에덴이 가까이 머문다. "첫 키스야? 좋아. 마을 놈들이 전부 가져가진 못했군."`,
			`<<He>>【이가】 엄지로 당신의 입술을 쓸어 만진다. "부드럽네. 익숙해질 것 같아."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechHermAroused to 0>>
		<<set _edenSpeech to either(
			`<<He>>【이가】 낮게 으르렁거린다. "네가 뭐든 상관없어. 네 냄새는 아니까."`,
			`에덴의 눈빛이 날카로워진다. "쓸모 있는 몸이군. 쓸 줄 알면 위험하기도 하고."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechCrossdressAroused to 0>>
		<<set _edenSpeech to either(
			`에덴이 당신의 옷을 잡아당긴다. "네가 뭔지 숨기려는 거야, 아니면 나한테 뭘 보여 주려는 거야?"`,
			`<<He>>【이가】 코웃음을 친다. "천 쪼가리로는 날 못 속여. 그 안에 뭐가 있는지 아니까."`,
			`에덴의 눈이 당신을 훑는다. "입고 싶은 대로 입어. 약점이야 어차피 다 찾아낼 테니까."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop is 1>>
		<<addSpeechLine "namedrop">>
		<<set $speechLINameDrop to 0>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<set _edenSpeech to either(
					`<<He>>【이가】 말한다. "저건 기회만 오면 널 갈기갈기 찢어 놓을 거야. 가까이 가지 마."`,
					`에덴이 으르렁거린다. "짐승이 널 신경 쓸 것 같아? 걔네는 배고픈 것만 신경 써."`
				)>>
			<<case "Bailey">>
				<<set _edenSpeech to either(
					`<<He>>【이가】 으르렁거린다. "베일리? 넌 <<nnpc_him "Bailey">>【이가】 아니라 나한테 속해 있어."`,
					`에덴의 손아귀에 힘이 들어간다. "그놈은 널 소유한 게 아니야. 내가 먼저 찾았어."`
				)>>
			<<case "Gwylan">>
				<<set _edenSpeech to either(
					`<<He>>【이가】 굳어 버린다. "그 망할 마녀가 널 나한테서 훔쳐 가려는 거야, 그것도?!"`,
					`에덴이 당신을 더 꽉 붙든다. "그 망할 마녀는 <<nnpc_his "Gwylan">> 속임수나 계속 부리라고 해. 넌 내 앞에서 사라지지 못해."`
				)>>
			<<default>>
				<<set _edenSpeech to either(
					`<<He>>【이가】 말한다. "그게 누구든, 잊어." <<He>>【은는】 상처 입은 듯한 목소리다.`,
					`에덴이 조용해진다. "또 다른 마을 이름이군. 널 여기 붙잡아 둘 또 하나의 이유야."`,
					`<<He>>【이가】 으르렁거린다. "이름 따위 상관없어. 어차피 다 쫓아낼 수 있으니까."`
				)>>
		<</switch>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechscratch is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<set _edenSpeech to either(
				`에덴이 긁힌 자국을 보자 무언가 사나운 것이 <<his>> 얼굴에 번진다. <<He>>【이가】 둘 다 숨 쉴 틈도 없이 당신을 바닥에 내리꽂는다. "할퀴지. 마. 나를."`,
				`<<He>>【은는】 자국에 움찔하더니, 공포가 분노로 날카로워지며 덮쳐 든다. "손 떼. 손 떼라고!"`,
				`에덴은 붉은 선들을 이빨 자국이라도 되는 듯 쳐다본다. <<His>> 목소리가 갈라진다. "그렇게 덤비지 말라고 했잖아."`,
				`잠깐 동안 에덴은 전혀 다른 곳을 보는 눈이 된다. 그러다 <<he>>【이가】 당신을 세게 붙잡는다. "발톱은 안 돼. 너한테는 안 돼."`
			)>>
			<<npcincr Eden love -10>><<llllove>><<npcincr Eden dom -2>><<ldom>><<pain 6>><<ggpain>><<set $enemytrust -= 50>><<set $enemyanger += 25>>
		<<else>>
			<<set _edenSpeech to either(
				`에덴이 긁힌 자국에 움찔하고, 분노가 덮어 버리기 전에 공포가 <<his>> 얼굴을 스친다. "그러지 마."`,
				`<<He>>【이가】 너무 빠르게 당신의 손목을 붙잡고, 거칠게 숨을 쉰다. "발톱을 세워? 내가 정신을 놓게 만들려는 거야?"`,
				`에덴이 붉은 선들을 바라보는데, 한순간 <<he>>【이가】 쫓기는 사람처럼 보인다. 그러더니 <<his>> 손아귀에 힘이 들어간다. "나쁜 생각이야."`,
				`<<He>>【이가】 긁힌 자국에 움찔한다. "늑대는 피를 원할 때 할퀴지. 널 그런 식으로 생각하게 만들지 마."`,
				`에덴이 당신의 손을 자기 몸에서 떼어 눌러 붙잡는다. "안 돼. 나한테 발톱 세울 수는 없어."`
			)>>
			<<npcincr Eden love -10>><<llllove>><<npcincr Eden dom -1>><<ldom>><<pain 6>><<ggpain>><<set $enemytrust -= 35>><<set $enemyanger += 15>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechPlayerHits to 0>>
		<<set _edenSpeech to either(
			`에덴이 일격을 받아내고 씩 웃는다. "그래. 내가 보고 싶던 게 그 이빨이야."`,
			`<<He>>【이가】 손등으로 입을 훔친다. "진심이면 더 세게 때려."`,
			`에덴의 눈이 반짝인다. "좋아. 아직 무력하진 않군."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<addSpeechLine "oral">>
		<<set $speechMouthPenetrated to 0>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`에덴의 손이 당신의 머리카락 속에서 멈춘다. "그 크기는 당황하면 널 숨 막히게 할 거야."`,
				`<<He>>【이가】 낮게 으르렁거린다. "목구멍이 좁아. 다치기 전에 천천히 해."`,
				`에덴이 버둥거리는 당신을 지켜본다. "입에 넣기엔 위험한 크기지, 길 잃은 꼬마."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`에덴이 거칠게 숨을 쉰다. "턱에 힘 빼."`,
				`<<He>>【이가】 당신의 머리카락을 쓰다듬는다. "그래, 그렇게. 내 모양을 익혀."`,
				`에덴이 거친 웃음을 흘린다. "이빨 조심해."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
		<<set $speechNoticeSexToy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<set _edenSpeech to either(
			`에덴이 당신의 $_sexToy【을를】 본다. "그런 장난감은 필요 없어." <<he>>【이가】 말한다. "오히려 방해될 수도 있지."`,
			`에덴이 당신의 $_sexToy【을를】 보고 코웃음을 친다. "마을 쓰레기군."`,
			`<<He>>【이가】 당신의 $_sexToy【을를】 훑어본다. "그걸 가져온 게 날 질투하게 하려는 거라면, 성공했어."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechExposeGenitals is 1 and playerChastity()>>
		<<addSpeechLine "expose">>
		<<set $speechExposeGenitals to 0>>
		<<set _edenSpeech to either(
			`에덴이 당신의 <<printChastity>>【을를】 찌푸린 얼굴로 살핀다. "누가 널 잠갔어?"`,
			`<<He>>【이가】 당신의 <<printChastity>>에 손가락을 건다. "덫 같군. 내 게 아닌 덫은 싫어."`,
			`에덴의 목소리가 낮아진다. "누가 허락도 없이 그걸 채웠다면, 이름을 대."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaPenetrated is 1 and random(1, 4) is 1>>
		<<addSpeechLine "penetrated">>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`에덴이 당신을 안는다. "네 몸이 받아들이고 싶어 하는 것보다 많지만, 넌 받아들이고 있어."`,
				`<<He>>【이가】 당신의 목덜미에 대고 으르렁거린다. "너무 깊어? 좋아. 내가 얼마나 닿는지 기억해 둬."`,
				`에덴의 손길이 조심스러워진다. "정신 잃지 마."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`에덴이 당신의 귓가에 바싹 대고 말한다. "네 몸이랑 싸우지 마."`,
				`<<He>>【이가】 으르렁거린다. "그래, 그렇게. 숲이 네 소리를 듣게 해."`,
				`에덴의 손에 힘이 들어간다. "넌 내 밑에 있을 때 제일 안전해."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusPenetrated is 1 and random(1, 4) is 1>>
		<<addSpeechLine "penetrated">>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`에덴이 당신의 반응에 숨이 멎는다. "방금 한계를 넘을 뻔했어. 가만히 있어."`,
				`<<He>>【이가】 으르렁거린다. "조이지 마. 이 크기에선 그게 더 힘들어질 뿐이야."`,
				`에덴이 당신을 짓눌러 붙들고 있다. "엄청 떨고 있잖아."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`에덴이 당신의 어깨에 대고 숨을 쉰다. "도망치지 마."`,
				`<<He>>【이가】 끙 소리를 낸다. "좁아. 위험해. 내 거야."`,
				`에덴의 목소리가 거칠어진다. "나한테 익숙해질 거야. 내가 그렇게 만들 테니까."`
			)>>
		<</if>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerOrgasm is 1 and random(1, 3) is 1>>
		<<addSpeechLine "playerOrgasm">>
		<<set _edenSpeech to either(
			`에덴이 낮게 으르렁거린다. "내가 너한테서 원했던 게 그거야."`,
			`<<He>>【이가】 당신의 얼굴을 지켜본다. "그래, 거기 있네. 마을 가면은 이제 없어."`,
			`에덴의 손아귀가 풀린다. "숨 돌려. 난 아직 널 사냥하는 중이야."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<if random(1, 5) is 1>>
		<<addSpeechLine "idle">>
		<<set _edenSpeech to either(
			`에덴이 오두막 가까이 헤매 든 먹잇감을 보듯 당신을 지켜본다. "아직도 도망칠 생각이야?"`,
			`<<He>>【이가】 조용히 말한다. "숲이 듣고 있어. 너무 겁먹은 소리는 내지 않도록 해."`,
			`에덴의 눈이 당신 위를 훑는다. "넌 마을에 있을 때보다 여기서 훨씬 안전해."`,
			`<<He>>【이가】 헉 하고 숨을 들이켠다. "곁에 있어. 끌고 온 건 나눠 갖지 않아."`
		)>>
		<<print _edenSpeech>>
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
	<<if $daily.eden.huntCaught gte 1>>
		<<switch $daily.eden.huntCaught>>
			<<case 1>> "누가 감히 널 건드려?" 에덴이 으르렁거린다.
			<<case 2>> "넌 내 거야." 에덴이 쏘아붙인다.
			<<case 3>> "넌 내 거다." 에덴이 말한다. "나만의 것."
			<<case 4>> "너한테 이럴 수 있는 건 나뿐이야." 에덴이 말한다.
			<<case 5>> "누구든 네 몸에 손을 댄다면," 에덴이 말한다. "다 죽은 목숨이다."
			<<case 6>> "오직 나만이 널 이렇게 안을 수 있다." 에덴이 속을 끓이며 말한다.
			<<case 7>> "말해." 에덴이 으르렁거린다. "넌 내 거라고."
			<<case 8>> "넌 내 소유다." 에덴이 말한다. "나만의 소유."
			<<case 9>> "네 주인이 누군지 잊지 마." 에덴이 말한다.
			<<case 10>> "네 머리카락 한 올까지도 다 내 거다." 에덴이 으르렁거린다.
		<</switch>>
		<<set $daily.eden.huntCaught to ($daily.eden.huntCaught + 1) % 11>>
		<<unset _noNameComment>>
	<</if>>
	<<if $daily.eden.robinCrash gte 1>>
		<<switch $daily.eden.robinCrash>>
			<<case 1>> "<<nnpc_He "Robin">> 따위가 널 지킬 순 없다." 에덴이 으르렁거린다.
			<<case 2>> "오직 나만이 널 지킨다." 에덴이 말한다.
			<<case 3>> "너를 먹여 살리는 건 나다." 에덴이 말한다.
			<<case 4>> "널 돌보는 건 나라고," 에덴이 소리친다.
			<<case 5>> "<<nnpc_He "Robin">>【이가】 마을에서 널 구해낸 게 아냐," 에덴이 코웃음 친다. "내가 구했지."
			<<case 6>> "내겐 너뿐이다." 에덴이 말한다.
			<<case 7>> "그리고 넌 나만 있으면 된다." 에덴이 말한다.
			<<case 8>> "다른 놈들은 그저 소음에 불과해." 에덴이 말한다.
			<<case 9>> "절대 널 놓아주지 않겠다." 에덴이 말한다.
			<<case 10>> "너는 오직 내 거다." 에덴이 으르렁거린다. "다른 놈들은 머릿속에서 완전히 지워주마."
		<</switch>>
		<<set $daily.eden.robinCrash to ($daily.eden.robinCrash + 1) % 11>>
		<<unset _noNameComment>>
	<</if>>
<</widget>>
