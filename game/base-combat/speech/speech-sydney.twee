:: Widgets speech-SYDNEY [widget]
<<widget "speech-sydney">>
	<<set _npc_speech to true>>
	<<set _sydney to statusCheck("Sydney")>><<rng>>
	<<set _playerColossalPenetrator to ($player.penissize or 0) gte 5>>
	<<set _sydneyColossalPenetrator to (_sydney.penissize or 0) gte 5>>
	<<if !$sydneyUniqueComments>>
		<<set $sydneyUniqueComments to []>>
	<</if>>
	<<speechPool "Sydney">>
	<<if $speechNPCPenisVirgin or $speechNPCVaginaVirgin>>
		<<addSpeechLine "virginity">>
			<<if $speechPenisVirgin is 1 or $speechVaginaVirgin is 1 or $speechAnusVirgin is 1>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<if $sydneySeen.includes("corruptroom")>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 신음한다. "네가 나를 망가뜨리는 기분이 매번 더 좋아져. 우린 이제 영원히 서로의 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 신음한다. "네가 해냈어. 드디어 나를 더럽혔어. 우린 이제 영원히 서로의 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<<else>>
					<<if $templePromised is "Sydney">>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 헐떡인다. "우리... 우리가 해냈어... 나 너무 행복해..." <<He>>【은는】 당신을 꽉 끌어안는다. "이건 우리가 영원히 묶였다는 뜻이지... 그렇지?" <<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 헐떡인다. "이러면 안 되는데... 어째서 이렇게 행복한 기분이 드는 거지...?" <<He>>【은는】 당신을 꽉 끌어안는다. "이건 우리가 영원히 묶였다는 뜻이지... 그렇지?" <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<</if>>
			<<else>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<if $sydneySeen.includes("corruptroom")>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 신음한다. "네가 나를 망가뜨리는 기분이 매번 더 좋아져. 난 이제 영원히 네 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 신음한다. "네가 해냈어. 드디어 나를 더럽혔어. 우린 이제 영원히 서로의 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<<else>>
					<<if $templePromised is "Sydney">>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 헐떡인다. "우리... 우리가 해냈어... 나 너무 행복해..." <<He>>【은는】 당신을 꽉 끌어안는다. "내가 네 첫 번째가 아니더라도... 이건 우리가 영원히 묶였다는 뜻이지... 그렇지?" <<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 당신을 향해 순수한 환희에 찬 표정을 지으며 헐떡인다. "이러면 안 되는데... 어째서 이렇게 행복한 기분이 드는 거지...?" <<He>>【은는】 당신을 꽉 끌어안는다. "내가 네 마지막이라면, 첫 번째가 아니어도 괜찮아!" <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNPCAnusVirgin>>
		<<addSpeechLine "virginity">>
			<<if $speechPenisVirgin is 1>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<He>>【은는】 신음한다. "너도 이거 처음이지, 그렇지? 느려지지 마. 제발!" <<He>>【은는】 <<his>> 다리로 당신을 감싼다.
				<<else>>
					<<He>>【은는】 헐떡인다. "우, 우리 아직 순결한 거 확실해...? 기분이... 너무 좋은데..." <<He>>【은는】 당신을 꽉 끌어안는다.
				<</if>>
			<<else>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<He>>【은는】 신음한다. "와, 이런 기분일 줄은 정말 몰랐어... 계속해줘!" <<He>>【은는】 <<his>> 다리로 당신을 감싼다.
				<<else>>
					<<He>>【은는】 헐떡인다. "나, 나 아직 순결한 거 확실해...? 기분이... 너무 좋은데..." <<He>>【은는】 당신을 꽉 끌어안는다.
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin>>
		<<addSpeechLine "virginity">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 신음하며 당신의 머리에 손을 얹는다. "이거 처음 하는 거지, 그렇지? 정말 잘하고 있어."
			<<else>>
				<<He>>【은는】 헐떡인다. "이, 이거 처음 하느—" <<He>>【은는】 <<his>> 입을 손으로 틀어막아 더 이상의 음탕한 소리를 참는다.
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNPCKissVirgin>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 당신을 애정 어린 시선으로 바라본다. "내 첫 키스였어..." <<he>>【이가】 꺄르륵 웃는다.
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<if _sydney.gender is "h">>
					<<He>>【은는】 헐떡인다. "와! <<nnpc_Mum "Sirris">>【이가】 나한테 항상 특별하다고 말했었는데, 너도 둘 다 가지고 있구나!"
				<<else>>
					<<He>>【은는】 헐떡인다. "와! <<nnpc_Mum "Sirris">>【은는】 그게 가능하다고 절대 말 안 해줬는데."
				<</if>>
			<<else>>
				<<if _sydney.gender is "h">>
					<<He>>【은는】 헐떡인다. "너... 둘 다 있어? 나만 그런 줄 알았어!"
				<<else>>
					<<He>>【은는】 헐떡인다. "두... 둘 다? 그게 가능한 건 줄 몰랐어!"
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 헐떡인다. "여태까지, 네가 <<pcSex>>【이었였】단 말이야? 음, 그래도 내 마음은 변하지 않아."
			<<else>>
				<<He>>【은는】 헐떡인다. "네가... <<pcSex>>라고? 그-그래도 괜찮아! 나는 너를 조금도 다르게 생각하지 않아!"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $sydneyromance is 1 and $speechLINameDrop>>
		<<switch _loveInterest>>
			<<case "Bailey">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 멈칫한다. "베일리? 네 보호자잖아? 그건... 그건 옳지 않아."
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 기겁한다. "도... 동물? 뭐라고?"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<case "Whitney">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 기겁한다. "그... <<nnpc_him "Whitney">> 말이야?!"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<case "Robin" "Kylar">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 얼어붙는다. "난... 너희가 그냥 친구인 줄 알았어. 그 말은...?"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 얼어붙는다. "누... 누구? 누구야?!"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<addSpeechLine "sexToy">>
			<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 바라보며 씩 웃는다. "<<print either("아, 너랑 그걸 같이 써보는 것보다 좋은 건 없을 거야.","그거 할인할 때 산 거지, 그렇지?")>>"
			<<elseif _sydneyStatus.includes("pure")>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 바라보고 얼굴을 붉힌다. "<<print either("아, 그거 <<nnpc_mum Sirris>>의 가게에서 파는 거야!","...그건 어떻게 쓰는 거야?")>>"
			<<else>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 바라보고 얼굴을 붉힌다. "이러면 안 될 것 같은데, 멈추고 싶지 않아."
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerOrgasm>>
		<<addSpeechLine "playerOrgasm">>
			<<if $speechSpank is 1>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<He>>【은는】 혼란스러운 표정으로 당신을 내려다본다. "이건 고통스러워야 하는 건데, 뭐... 이게 뭐야?" <<npcincr Sydney purity -2>><<lspurity>>
					<<case "corrupt" "corruptLust">>
						<<He>>【은는】 당신에게 미소 지으며 꺄르륵 웃는다. "네가 발버둥치며 괴로워하는 걸 보니까 더 좋아." <<npcincr Sydney purity -2>><<lspurity>>
					<<default>>
						당신이 절정에 달하자 <<He>>【은는】 당황과 혼란이 섞인 표정으로 당신을 바라본다. <<npcincr Sydney purity -2>><<lspurity>>
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<if $sydneySeen.includes("player climax")>>
							<<He>>【은는】 당신에게 미소 지으며 꺄르륵 웃는다. "내... 내가 해냈어! 내가 너를..." <<npcincr Sydney purity -2>><<lspurity>>
						<<else>>
							<<His>> 눈이 휘둥그레진다. "괜-괜찮아? 덜덜 떨고 있잖아!" 당신이 대답으로 간신히 고개를 끄덕이자 <<he>>【은는】 안도한다. <<npcincr Sydney purity -5>><<llspurity>>
						<</if>>
					<<case "corrupt" "corruptLust">>
						<<He>>【은는】 당신에게 미소 지으며 꺄르륵 웃는다. "이제, 내 차례야." <<npcincr Sydney purity -2>><<lspurity>>
					<<default>>
						당신이 벌벌 떠는 동안 <<He>>【은는】 애정을 담아 당신에게 매달린다. <<npcincr Sydney purity -2>><<lspurity>>
				<</switch>>
			<</if>>
			<<set $sydneySeen.pushUnique("player climax")>>
		<</addSpeechLine>>
	<</if>>
	<<if playerChastity() and !$sydneySeen.includes("chastity") and $speechExposeGenitals>>
		<<addSpeechLine "expose">>
			<<if $worn.genitals.name is "chastity parasite">>
				<!-- +corruption/-purity but never +lust -->
				당신의 <<printChastity>>【을를】 보자 <<His>> 눈썹이 놀라움으로 치켜 올라간다. <<set _lustincrdisplay to 1>><<set _lustincr to 1>><<npcincr Sydney purity -2>><<lspurity>>
			<<else>>
				당신의 <<printChastity>>【을를】 보자 <<His>> 눈썹이 놀라움으로 치켜 올라간다. <<npcincr Sydney purity 2>><<gspurity>>
			<</if>>
			<<set $sydneySeen.pushUnique("chastity")>>
			<<set $sydneyUniqueComments.pushUnique("chastity")>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechSpank>>
		<<addSpeechLine "spank">>
			<<if $speechMoan is 1>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<print either(
							`<<He>>【은는】 얼굴을 붉힌다. "이-이건 벌이잖아!"`,
							`<<He>>【은는】 얼굴을 붉힌다. "이해를 못 하겠네, 내가 벌을 제대로 못 주고 있는 거야?"`,
							`<<He>>【은는】 얼굴을 붉힌다. "너 혹시... 이걸 즐기는 거야?" <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
					<<case "corrupt" "corruptLust">>
						<<print either(
							`<<He>>【은는】 씩 웃는다. "네가 이런 거 좋아하는 줄 알았어." <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 씩 웃는다. "나쁜 <<girls>>【은는】 벌을 받아야지. 네가 나쁘게 구는 게 너무 좋아." <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 씩 웃는다. "네 신음 소리를 맛보고 싶어. 널 더 자주 때려줘야겠어." <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
					<<default>>
						<<print either(
							`<<He>>【은는】 입을 삐죽 내민다. "이건 훈육이란 말이야, 알아?"`,
							`<<He>>【은는】 얼굴을 붉힌다. "너 혹시... 이걸 즐기는 거야?" <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 얼굴을 붉힌다. "이건 벌이란 말이야! 그렇게 신음 소리 내지 마!" <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "내가 하든지, 아니면 <<nnpc_title "Leighton">>【이가】 하든지 둘 중 하나야, 그러니까 제발 협조해!"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "어떻게 감히 신성한 장소를 더럽혀!?"
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "누구도 훈육에서 예외일 순 없어!"
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "가만히 있어! 제대로 배워야 하니까!"
						<<else>>
							<<He>>【은는】 말한다. "아프면 기억에 잘 남을 거야! 벌을 받아들여!"
						<</if>>
					<<case "corrupt" "corruptLust">>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "<<nnpc_title "Leighton">>【이가】 하는 것보다는 내가 하는 게 낫겠지?"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "넌 신성한 곳을 더럽혔어. 내가 대신 널 더럽혀줄까."
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "너 이거 분명 즐기고 있는 거지."
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "이렇게 하니까 화나? 나한테 똑같이 하게 해줄지도 모르지."
						<<else>>
							<<He>>【은는】 말한다. "네가 이 고통을 즐길 때까지 멈추지 않을 거야."
						<</if>>
					<<default>>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "내가 하든지, 아니면 <<nnpc_title "Leighton">>【이가】 하든지 둘 중 하나야, 그러니까 제발 협조해!"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "어떻게 감히 신성한 장소를 더럽혀!?"
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "오해하지 마, 이건 순전히 훈육의 일환이니까."
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "그냥 말 잘 들었으면 이런 짓 안 해도 되잖아, 난 널 아프게 하고 싶지 않아."
						<<else>>
							<<He>>【은는】 말한다. "조던한테 훈육에 대해 좀 배웠어, 이제 네가 배울 차례야."
						<</if>>
				<</switch>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechApologise>>
		<<addSpeechLine "apologise">>
			<<switch _sydneyStatus>>
