:: Widgets speech-Kylar [widget]
<<widget "speech-kylar">>
	<<set _npc_speech to true>>
	<<set _kylar to statusCheck("Kylar")>>
	<<set _kylarPenisSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _kylarPenisSize to $NPCList[_n].penissize>>
	<<elseif C.npc.Kylar and C.npc.Kylar.penissize isnot undefined>>
		<<set _kylarPenisSize to C.npc.Kylar.penissize>>
	<</if>>

	<<speechPool "Kylar">>
	<<if $speechpillreveal is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpillreveal to 0>>
		<<print [
			`Kylar's eyes lock onto the X-Change $xchangePillWord in your hand, shining. "Is that for me? You'd change me? I'd take anything you gave me."`,
			`"You want to reshape me?" Kylar breathes, staring at your X-Change $xchangePillWord. "Yes. Anything, as long as it's what you want."`,
			`Kylar trembles with anticipation at the sight of your X-Change $xchangePillWord. "Do it. Make me into whatever you need me to be."`
		][random(0,2)]>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is "herm">>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<print [
			`Kylar shudders, running trembling hands over <<his>> new body. "Now there's even more of me for you. Every part, all yours."`,
			`<<His>> eyes gleam feverishly. "You made me... complete. However you want me, whenever you want me."`,
			`"Both? You gave me both?" Kylar's breath catches. "You really do think about me as much as I think about you."`
		][random(0,2)]>>
		<<npcincr Kylar lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<print [
			`Kylar gazes at <<his>> changed body with adoration. "If this is the shape you want me in, then this is what I am. Anything for you."`,
			`"You reshaped me," Kylar breathes, eyes shining. "I'd let you do anything. I'm yours to mould."`,
			`<<He>> clutches at you. "I don't care what I am, as long as I'm yours. Thank you. Thankyouthankyou."`
		][random(0,2)]>>
		<<npcincr Kylar lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaVirgin is 1 and $player.virginity.vaginal is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if _kylarPenisSize gte 5>>
			<<He>> gasps, eyes wet and shining. "I didn't mean to hurt you. I just... I couldn't stop once we were finally together."
		<<else>>
			<<He>> gasps. "You were a virgin too. We were meant for each other."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPenisVirgin is 1 and $player.virginity.penile is "Kylar">>
		<<addSpeechLine "virginity">>
		<<He>> gasps. "You saved this for me. I knew it. I knew we were meant to be each other's first."
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if $player.vaginaExist and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "이러면 애는 못 만들겠지만, 널 참을 수 없었어."
		<<elseif !$player.vaginaExist and _kylar.gender is "m" and knowsAboutAnyPregnancy("pc","Kylar") and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "그래서 전에 임신했던 거야? 그래도 처음이었는데!"
		<<elseif _kylarPenisSize gte 5>>
			<<He>> trembles. "You're shaking so much. Please don't break. Please, please don't break before we're done."
		<<else>>
			<<He>>【이가】 헐떡인다. "네 모든 부분, 가장 깊은 곳까지 다 느끼고 싶어!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if _kylarPenisSize gte 5>>
			<<He>> strokes your cheek with shaking fingers. "Careful. Slowly. I dreamt about this, but I don't want you choking because of me."
		<<else>>
			<<He>>【이가】 숨을 몰아쉰다. "드디어 네가 내 가장 은밀한 곳에 키스해주고 있어. 내 꿈에서처럼!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Kylar">>
		<<addSpeechLine "virginity">>
		<<He>>【이가】 숨을 거칠게 쉰다. "사랑해사랑해사랑해!!!"
		<<set $kylarSeen.pushUnique("saidLove")>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1 and $settings.pregnancySpeechEnabled>>
		<<addSpeechLine "reveal">>
		<<if _kylar.gender is "h">>
			<<He>>【이가】 숨을 헐떡인다. "아. 난 네가... 그런 줄 알았어." <<He>>【이가】 씨익 웃으며 머리를 가로젓는다. "뭐 어때! 우린 여전히 가족을 만들 수 있어...!"
		<<elseif $player.penisExist>>
			<<He>>【이가】 헐떡인다. "네가 날 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "네가 날 임신시킬 수 있어...!"
		<<else>>
			<<He>>【이가】 헐떡인다. "내가 널 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "내가 널 임신시킬 수 있어...!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressDisappointed is 1>>
		<<addSpeechLine "reveal">>
		<<if !$player.vaginaExist and knowsAboutAnyPregnancy("pc","Kylar")>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 갑자기 들떠서 말한다. "그래도 전에 임신했었잖아? 흐음, 그럼 아직 희망이 있네."
		<<else>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 머리를 흔든다. "괘-괜찮아. 우린 언제든 입양하면 돼."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
		<<if _kylar.gender is "h" and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "너한테 둘 다 있어...? 나처럼...? 우리는 엄청 많은 아이들을 만들 수 있을 거야... 완벽해..."
		<<else>>
			<<He>>【이가】 헐떡인다. "둘 다 있어...? 네가 이것보다 더 완벽할 수 있을 줄 몰랐는데..."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop is 1>>
		<<addSpeechLine "namedrop">>
		<<set $speechLINameDrop to 0>>
		<<if _loveInterest is "Black Wolf" or _loveInterest is "Great Hawk">>
			<<His>> 눈이 가늘어진다. "나도 짐승처럼 할 수 있어. 똑똑히 봐!"
		<<elseif random(1, 100) lte 50>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>>【이가】 으르렁거린다. "로빈은 나만큼 널 챙겨줄 수 없어!"
				<<case "Whitney">>
					<<He>>【이가】 멈칫한다. "휘... 휘트니는 날 못 막아!"
				<<case "Sydney">>
					<<He>>【이가】 으르렁거린다. "시드니는 나만큼 널 잘 몰라!"
					<<set $kylarSeen.pushUnique("sydneyWriting")>>
				<<case "Bailey">>
					<<He>> freezes. "W-Why would you want <<nnpc_him "Bailey">> over me?"
				<<default>>
					<<He>>【이가】 멈칫한다. "누구... 얘기하는 거야...?"
			<</switch>>
		<<else>>
			<<He>>【이가】 굳어버린다. "걔넨 필요 없어! 넌 나만 있으면 돼!"
		<</if>>
		<<npcincr Kylar rage 10>><<ggksuspicion>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
		<<set $speechNoticeSexToy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<if !$player.penisExist and $NPCList[0] and $NPCList[0].vagina isnot "none" and random(0,2) isnot 0>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`U-Use it. Please, use me, use it.`, `It's a sign of our love, right?`, `If it helps you feel closer to me, then it's ours.`][random(0,2)] + `"`>>
		<<elseif ($player.penisExist or ($NPCList[0] and $NPCList[0].penis isnot "none")) and random(0,2) isnot 0>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`What... am I doing wrong...?`, `If it makes you happy, my love, but...`, `You don't need that when I'm right here.`][random(0,2)] + `"`>>
		<<else>>
			<<He>>【이가】 당신의 $_sexToy【을를】 보고 입을 삐죽 내민다. "나로는 부족해?"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechcondomremoved>>
		<<addSpeechLine "condomRemoved">>
		<<set $_condomWasFake to $speechcondomremoved is "sabotaged">>
		<<set $speechcondomremoved to 0>>
		<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or NPCPregnancyPossibleWithPlayer("Kylar"))>>
			<<print either(
				`<<He>> watches you remove the condom, then takes a quick breath. "You want me without it too. You want me to come inside you."`,
				`<<His>> eyes follow your hand as you pull the condom off. "Yes. Take it off. I want to come inside you. I want you to get pregnant."`,
				`<<He>> looks at the condom after you throw it aside, then quickly looks back at you. Tears gather in <<his>> eyes. "You're really letting me do it without one. You're really letting me..."`
			)>>
		<<else>>
			<<print either(
				`<<He>> watches you remove the condom, then takes a quick breath. "Nothing between us. That's how it should be."`,
				`<<His>> eyes follow your hand as you pull the condom off. "You don't want me wearing it either. I knew it."`,
				`<<He>> looks at the condom after you throw it aside, then smiles at you. "Good... You took it off. Good, good, good."`
			)>>
		<</if>>
		<<if $_condomWasFake>>
			<span class="blue"><<He>> says nothing about the condom already being damaged and unable to protect you.</span>
		<</if>>
		<<npcincr Kylar lust 10>><<gglust>><<set $enemytrust += 10>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLegLock is 1>>
		<<addSpeechLine "legLock">>
		<<set $speechLegLock to 0>>
		<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or NPCPregnancyPossibleWithPlayer("Kylar"))>>
			<<print either(
				`<<He>> feels your legs tighten around <<him>> and stops moving for a second. Then <<he>> pushes <<his>> hips closer against you. "You're holding me here. You want me to come inside you."`,
				`<<He>> takes a sharp breath when your legs close around <<him>>, stopping <<him>> from pulling away. "Don't let go until it's done. Keep me inside when I come."`,
				`<<His>> body shakes as you hold <<him>> against you. "You want me to come inside you. You want to risk getting pregnant too..."`
			)>>
		<<else>>
			<<print either(
				`<<He>> feels your legs tighten around <<him>> and stops moving for a second. Then <<he>> pushes <<his>> hips closer against you. "You're holding me here. You don't want me to pull out."`,
				`<<He>> takes a sharp breath when your legs close around <<him>>, stopping <<him>> from pulling away. "Hold me there, please. Don't let me move away."`,
				`<<His>> body shakes as you keep <<him>> between your legs. "You're stopping me from pulling away. Y-You. You want me to stay inside."`
			)>>
		<</if>>
		<<npcincr Kylar lust 10>><<gglust>><<set $enemytrust += 10>>
		<br>
		<</addSpeechLine>>
	<</if>>
	<<if $speechscratch is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<print either(
				`<<He>> stares at the scratches, breathing turning ragged. "You marked me. You marked me. Fine. Fine, I'll mark you too."`,
				`<<He>> touches the red lines and starts to laugh. "You did it first. Don't cry when I do it back."`,
				`<<He>> presses <<his>> fingers to the marks, eyes wide. "You want proof? Is that it? I'll give you proof. I'll give you so much proof."`,
				`<<He>> trembles, staring at the scratches. "Mine. Yours. Mine. Yours. You can't take it back now."`
			)>>
			<<npcincr Kylar lust 10>><<glust>><<set $enemytrust -= 15>><<set $enemyanger += 5>>
		<<elseif _loveInterest is "Kylar">>
			<<print either(
				`<<He>> looks at the scratches as if you've kissed <<him>>. "You marked me... you really marked me."`,
				`<<He>> shivers, touching the red lines with a dreamy smile. "That's yours. That's where you touched me. Everyone will know."`,
				`<<He>> stares at the marks, eyes shining. "You wanted to leave something on me. You did. You did."`,
				`<<He>> laughs under <<his>> breath, almost crying. "I knew it. I knew you wanted me to belong to you too."`
			)>>
			<<npcincr Kylar lust 10>><<gglust>><<npcincr Kylar love 5>><<gglove>><<set $enemytrust += 15>><<set $enemyanger -= 5>>
		<<else>>
			<<print either(
				`<<He>> freezes at the scratches, then smiles too wide. "You marked me. You marked me. You can't pretend that means nothing."`,
				`<<He>> rubs the red lines with shaking fingers. "That's yours now. I'm yours now. That's how this works, right?"`,
				`<<He>> stares at the marks, face flushing. "You touched me so hard it stayed. That's not nothing. That's not nothing."`,
				`<<He>> lets out a breathless laugh. "If you get to mark me, I get to mark you. That's fair. That's love."`
			)>>
			<<npcincr Kylar lust 8>><<gglust>><<set $enemytrust += 5>><<set $enemyanger -= 10>>
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $combatgoal is "strip" and $rng lte 25>>
		<<addSpeechLine "strip">>
		<<if $enemyanger gte 80>>
			<<print `<<He>> tugs at your clothes with frantic hands. "` + [`Stop hiding from me. I know what you look like underneath.`, `These keep getting between us. I hate them.`, `You don't need anything else. You have me.`][random(0,2)] + `"`>>
		<<else>>
			<<print `<<He>> fusses with your clothes, face flushed. "` + [`I just want to see you. Only me.`, `You look so pretty when you stop covering up.`, `Don't be shy. I already know you're perfect.`][random(0,2)] + `"`>>
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if _silent isnot 1>>
		<<addSpeechLine "idle">>
		<<set $kylarsexcycle to $kylarsexcycle or 0>>
		<<switch $kylarsexcycle>>
			<<case 0>>
				<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or (!$genderknown.includes("Kylar") and perceivedGender() is "f"))>>
					<<He>>【이가】 당신의 귓가에 속삭인다. "우리 아기를 아주 많이 가질 거야."
				<<else>>
					"우리 아기를 아주 많이 입양할 거야." <<he>>【이가】 말한다.
				<</if>>
			<<case 1>>
				<<print `"You'll be the best <<pmummy "Kylar">> ever," <<he>> says.`>>
			<<case 2>>
				"정말 야하다니까," <<he>>【이가】 말한다. "우리 아직 결혼도 안 했는데!"
			<<case 3>>
				"내 기운을 쏙 빼놓아줘." <<he>>【이가】 말한다. "그리고 멈추지 마."
			<<case 4>>
				<<print `"널 쳐다본 다른 ${$pronoun is "m" ? "개자식들" : "창년들"} 따위 전부 잊어버릴 때까지 몇 번이고 다시 할 거야." <<he>>【이가】 말한다.`>>
			<<case 5>>
				"네가 영원히 생각하는 건 나뿐일 거야." <<he>>【이가】 말한다.
			<<case 6>>
				"모두 다 나쁜 놈들이야." <<he>>【이가】 말한다. "너 빼고. 넌 완벽해."
			<<case 7>>
				"이러니까 안심돼." <<he>>【이가】 말한다. "영원히 끝나지 않았으면 좋겠어."
			<<case 8>>
				"I...l-love you," <<he>> says.
				<<set $kylarSeen.pushUnique("saidLove")>>
			<<case 9>>
				"You made that sound just for me, didn't you?" <<he>> asks, smiling too wide.
			<<case 10>>
				"Don't think about anyone else," <<he>> whispers.
			<<case 11>>
				"I know every face you make," <<he>> says. "This one's my favourite."
			<<case 12>>
				"If you wanted me to stop staring, you shouldn't have been so beautiful," <<he>> says.
			<<case 13>>
				"We should run away after this," <<he>> says. "Somewhere quiet. Somewhere locked."
			<<case 14>>
				"Say my name," <<he>> pleads. "I need to hear it."
			<<default>>
				"넌 정말 음탕하고 야해. 전부 내 거야." <<he>>【이가】 말한다.
		<</switch>>
		<<set $kylarsexcycle to ($kylarsexcycle + 1) % 16>> <!-- increase by one, and reset to 0 if it hits 16 -->
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>
