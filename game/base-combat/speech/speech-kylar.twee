:: Widgets speech-Kylar [widget]
<<widget "speech-kylar">>
	<<set _npc_speech to true>>
	<<set _kylar to statusCheck("Kylar")>>
	<<set _kylarPenisSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _kylarPenisSize to $NPCList[_n].penissize>>
	<<elseif C.npc.Kylar and C.npc.Kylar.penissize isnot undefined>>
		<<set _kylarPenisSize to C.npc.Kylar.penissize>>
	<</if>>

	<<speechPool "Kylar">>
	<<if $speechpillreveal is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpillreveal to 0>>
		<<print [
			`카일라가 당신 손에 든 X-체인지 $xchangePillWord【을를】 뚫어지게 쳐다본다. 눈이 반짝인다. "그거 나 주려는 거야? 날 바꿔 주려고? 네가 주는 거라면 뭐든 받을게."`,
			`"날 다시 빚고 싶어?" 카일라가 당신의 X-체인지 $xchangePillWord【을를】 응시하며 숨을 내쉰다. "좋아. 뭐든, 네가 원하는 거라면."`,
			`카일라는 당신의 X-체인지 $xchangePillWord【을를】 보고 기대감에 몸을 떤다. "해 줘. 네게 필요한 뭐든 되게 만들어 줘."`
		][random(0,2)]>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is "herm">>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<print [
			`카일라가 몸서리치며 떨리는 손으로 <<his>> 새 몸을 쓸어내린다. "이제 널 위한 내가 더 많아졌어. 모든 부분이 전부 네 거야."`,
			`<<His>> 눈이 열에 들뜬 듯 번뜩인다. "네가 날... 완전하게 만들었어. 어떻게든, 언제든 원하는 대로 해."`,
			`"둘 다? 나한테 둘 다 줬어?" 카일라의 숨이 멎는다. "너도 정말 내가 널 생각하는 만큼 나를 생각하는구나."`
		][random(0,2)]>>
		<<npcincr Kylar lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechpill is 1>>
		<<addSpeechLine "reveal">>
		<<set $speechpill to 0>>
		<<print [
			`카일라가 달라진 <<his>> 몸을 숭배하듯 바라본다. "네가 원하는 모양이 이거라면, 난 이거야. 널 위해서라면 뭐든."`,
			`"네가 날 다시 빚었어." 카일라가 눈을 반짝이며 숨을 내쉰다. "뭐든 하게 놔둘 거야. 난 네가 빚는 대로야."`,
			`<<He>>【이가】 당신에게 매달린다. "내가 뭐든 상관없어, 네 거라면. 고마워. 고마워고마워고마워."`
		][random(0,2)]>>
		<<npcincr Kylar lust 5>><<glust>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaVirgin is 1 and $player.virginity.vaginal is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if _kylarPenisSize gte 5>>
			<<He>>【이가】 헐떡이고, 젖은 눈이 반짝인다. "아프게 하려던 게 아니야. 그냥... 우리가 드디어 함께하니까 멈출 수가 없었어."
		<<else>>
			<<He>>【이가】 헐떡인다. "너도 처음이었구나. 우린 서로를 위한 사이였어."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPenisVirgin is 1 and $player.virginity.penile is "Kylar">>
		<<addSpeechLine "virginity">>
		<<He>>【이가】 헐떡인다. "날 위해 아껴 둔 거구나. 알고 있었어. 우리가 서로의 처음이 될 운명이라는 걸 알고 있었어."
		<</addSpeechLine>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if $player.vaginaExist and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "이러면 애는 못 만들겠지만, 널 참을 수 없었어."
		<<elseif !$player.vaginaExist and _kylar.gender is "m" and knowsAboutAnyPregnancy("pc","Kylar") and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "그래서 전에 임신했던 거야? 그래도 처음이었는데!"
		<<elseif _kylarPenisSize gte 5>>
			<<He>>【이가】 떨고 있다. "너무 떨고 있어. 부서지지 마. 제발, 제발 우리가 끝내기 전엔 부서지지 마."
		<<else>>
			<<He>>【이가】 헐떡인다. "네 모든 부분, 가장 깊은 곳까지 다 느끼고 싶어!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Kylar">>
		<<addSpeechLine "virginity">>
		<<if _kylarPenisSize gte 5>>
			<<He>>【이가】 떨리는 손가락으로 당신의 뺨을 쓰다듬는다. "조심해. 천천히. 이걸 꿈꿔 왔지만, 나 때문에 네가 숨 막히는 건 싫어."
		<<else>>
			<<He>>【이가】 숨을 몰아쉰다. "드디어 네가 내 가장 은밀한 곳에 키스해주고 있어. 내 꿈에서처럼!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Kylar">>
		<<addSpeechLine "virginity">>
		<<He>>【이가】 숨을 거칠게 쉰다. "사랑해사랑해사랑해!!!"
		<<set $kylarSeen.pushUnique("saidLove")>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1 and $settings.pregnancySpeechEnabled>>
		<<addSpeechLine "reveal">>
		<<if _kylar.gender is "h">>
			<<He>>【이가】 숨을 헐떡인다. "아. 난 네가... 그런 줄 알았어." <<He>>【이가】 씨익 웃으며 머리를 가로젓는다. "뭐 어때! 우린 여전히 가족을 만들 수 있어...!"
		<<elseif $player.penisExist>>
			<<He>>【이가】 헐떡인다. "네가 날 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "네가 날 임신시킬 수 있어...!"
		<<else>>
			<<He>>【이가】 헐떡인다. "내가 널 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "내가 널 임신시킬 수 있어...!"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressDisappointed is 1>>
		<<addSpeechLine "reveal">>
		<<if !$player.vaginaExist and knowsAboutAnyPregnancy("pc","Kylar")>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 갑자기 들떠서 말한다. "그래도 전에 임신했었잖아? 흐음, 그럼 아직 희망이 있네."
		<<else>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 머리를 흔든다. "괘-괜찮아. 우린 언제든 입양하면 돼."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
		<<if _kylar.gender is "h" and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "너한테 둘 다 있어...? 나처럼...? 우리는 엄청 많은 아이들을 만들 수 있을 거야... 완벽해..."
		<<else>>
			<<He>>【이가】 헐떡인다. "둘 다 있어...? 네가 이것보다 더 완벽할 수 있을 줄 몰랐는데..."
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop is 1>>
		<<addSpeechLine "namedrop">>
		<<set $speechLINameDrop to 0>>
		<<if _loveInterest is "Black Wolf" or _loveInterest is "Great Hawk">>
			<<His>> 눈이 가늘어진다. "나도 짐승처럼 할 수 있어. 똑똑히 봐!"
		<<elseif random(1, 100) lte 50>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>>【이가】 으르렁거린다. "로빈은 나만큼 널 챙겨줄 수 없어!"
				<<case "Whitney">>
					<<He>>【이가】 멈칫한다. "휘... 휘트니는 날 못 막아!"
				<<case "Sydney">>
					<<He>>【이가】 으르렁거린다. "시드니는 나만큼 널 잘 몰라!"
					<<set $kylarSeen.pushUnique("sydneyWriting")>>
				<<case "Bailey">>
					<<He>>【이가】 굳어 버린다. "왜-왜 나 말고 <<nnpc_him "Bailey">>【을를】 원하는 거야?"
				<<default>>
					<<He>>【이가】 멈칫한다. "누구... 얘기하는 거야...?"
			<</switch>>
		<<else>>
			<<He>>【이가】 굳어버린다. "걔넨 필요 없어! 넌 나만 있으면 돼!"
		<</if>>
		<<npcincr Kylar rage 10>><<ggksuspicion>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
		<<set $speechNoticeSexToy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<if !$player.penisExist and $NPCList[0] and $NPCList[0].vagina isnot "none" and random(0,2) isnot 0>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 말한다. "` + [`써-써 줘. 제발, 날 써 줘, 그걸 써 줘.`, `우리 사랑의 증표지, 맞지?`, `나랑 더 가까워진 기분이 든다면, 그건 우리 거야.`][random(0,2)] + `"`>>
		<<elseif ($player.penisExist or ($NPCList[0] and $NPCList[0].penis isnot "none")) and random(0,2) isnot 0>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 말한다. "` + [`내가... 뭘 잘못하고 있는 거야...?`, `네가 행복해진다면 좋아, 내 사랑, 하지만...`, `내가 바로 여기 있는데 그건 필요 없잖아.`][random(0,2)] + `"`>>
		<<else>>
			<<He>>【이가】 당신의 $_sexToy【을를】 보고 입을 삐죽 내민다. "나로는 부족해?"
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechcondomremoved>>
		<<addSpeechLine "condomRemoved">>
		<<set $_condomWasFake to $speechcondomremoved is "sabotaged">>
		<<set $speechcondomremoved to 0>>
		<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or NPCPregnancyPossibleWithPlayer("Kylar"))>>
			<<print either(
				`<<He>>【이가】 당신이 콘돔을 벗기는 걸 지켜보다가 짧게 숨을 들이쉰다. "너도 그거 없이 날 원하는 거구나. 내가 네 안에 싸길 바라는 거구나."`,
				`<<His>> 눈이 콘돔을 벗겨 내는 당신의 손을 따라간다. "그래. 벗어. 네 안에 싸고 싶어. 네가 임신했으면 좋겠어."`,
				`<<He>>【은는】 당신이 콘돔을 옆으로 던진 뒤 그것을 쳐다보다가 곧장 다시 당신을 본다. <<his>> 눈에 눈물이 고인다. "정말 그거 없이 하게 해 주는 거야. 정말로 하게 해 주는 거야..."`
			)>>
		<<else>>
			<<print either(
				`<<He>>【이가】 당신이 콘돔을 벗기는 걸 지켜보다가 짧게 숨을 들이쉰다. "우리 사이에 아무것도 없어야지. 그래야 맞아."`,
				`<<His>> 눈이 콘돔을 벗겨 내는 당신의 손을 따라간다. "너도 내가 그걸 끼는 게 싫구나. 알고 있었어."`,
				`<<He>>【이가】 당신이 콘돔을 옆으로 던진 뒤 그것을 쳐다보다가 당신에게 미소 짓는다. "좋아... 벗었네. 좋아, 좋아, 좋아."`
			)>>
		<</if>>
		<<if $_condomWasFake>>
			<span class="blue"><<He>>【은는】 콘돔이 이미 망가져서 당신을 지켜 주지 못한다는 사실에 대해 아무 말도 하지 않는다.</span>
		<</if>>
		<<npcincr Kylar lust 10>><<gglust>><<set $enemytrust += 10>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLegLock is 1>>
		<<addSpeechLine "legLock">>
		<<set $speechLegLock to 0>>
		<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or NPCPregnancyPossibleWithPlayer("Kylar"))>>
			<<print either(
				`<<He>>【은는】 당신의 다리가 <<him>>【을를】 조여 오는 걸 느끼고 잠시 움직임을 멈춘다. 그러다 <<he>>【이가】 <<his>> 허리를 당신 쪽으로 더 바짝 밀어붙인다. "나를 여기 붙잡고 있네. 내가 네 안에 싸길 바라는 거야."`,
				`<<He>>【은는】 당신의 다리가 <<him>>【을를】 감싸 물러나지 못하게 하자 날카롭게 숨을 들이쉰다. "끝날 때까지 놓지 마. 쌀 때 날 안에 붙잡아 둬."`,
				`<<His>> 몸이 떨린다, 당신이 <<him>>【을를】 몸에 붙들고 놓아주지 않아서. "내가 네 안에 싸길 바라는구나. 임신할 위험까지 감수하고 싶은 거구나..."`
			)>>
		<<else>>
			<<print either(
				`<<He>>【은는】 당신의 다리가 <<him>>【을를】 조여 오는 걸 느끼고 잠시 움직임을 멈춘다. 그러다 <<he>>【이가】 <<his>> 허리를 당신 쪽으로 더 바짝 밀어붙인다. "나를 여기 붙잡고 있네. 빼는 게 싫은 거구나."`,
				`<<He>>【은는】 당신의 다리가 <<him>>【을를】 감싸 물러나지 못하게 하자 날카롭게 숨을 들이쉰다. "거기 붙잡아 줘, 제발. 내가 물러나지 못하게 해 줘."`,
				`<<His>> 몸이 떨린다, 당신이 <<him>>【을를】 다리 사이에 가둬 두고 있어서. "내가 빠지지 못하게 막고 있어. 너-너. 내가 안에 있길 바라는 거야."`
			)>>
		<</if>>
		<<npcincr Kylar lust 10>><<gglust>><<set $enemytrust += 10>>
		<br>
		<</addSpeechLine>>
	<</if>>
	<<if $speechscratch is 1>>
		<<addSpeechLine "playerHits">>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<print either(
				`<<He>>【이가】 긁힌 자국을 응시하고, 숨이 거칠어진다. "네가 날 표시했어. 날 표시했어. 좋아. 좋아, 나도 널 표시할게."`,
				`<<He>>【이가】 붉은 선을 만지더니 웃기 시작한다. "네가 먼저 했어. 내가 갚아 줄 때 울지 마."`,
				`<<He>>【이가】 눈을 크게 뜬 채 자국에 <<his>> 손가락을 누른다. "증거를 원해? 그런 거야? 줄게, 증거. 엄청 많이 줄게."`,
				`<<He>>【이가】 긁힌 자국을 응시하며 떤다. "내 거. 네 거. 내 거. 네 거. 이젠 되돌릴 수 없어."`
			)>>
			<<npcincr Kylar lust 10>><<glust>><<set $enemytrust -= 15>><<set $enemyanger += 5>>
		<<elseif _loveInterest is "Kylar">>
			<<print either(
				`<<He>>【은는】 당신이 입맞춤이라도 해 준 것처럼 긁힌 자국을 바라본다. "날 표시했어... 정말로 날 표시했어."`,
				`<<He>>【이가】 몸을 떨며 몽롱한 미소로 붉은 선을 만진다. "이건 네 거야. 네가 날 만진 곳이야. 모두가 알게 될 거야."`,
				`<<He>>【이가】 눈을 반짝이며 자국을 응시한다. "나한테 뭔가 남기고 싶었구나. 남겼어. 남겼어."`,
				`<<He>>【이가】 숨죽여 웃는다, 거의 울 것처럼. "알고 있었어. 너도 내가 네 거가 되길 바란다는 걸 알고 있었어."`
			)>>
			<<npcincr Kylar lust 10>><<gglust>><<npcincr Kylar love 5>><<gglove>><<set $enemytrust += 15>><<set $enemyanger -= 5>>
		<<else>>
			<<print either(
				`<<He>>【이가】 긁힌 자국 앞에서 굳어 버렸다가, 지나치게 크게 웃는다. "날 표시했어. 날 표시했어. 그게 아무 의미도 없다고는 못 해."`,
				`<<He>>【이가】 떨리는 손가락으로 붉은 선을 문지른다. "이건 이제 네 거야. 나도 이제 네 거야. 이렇게 되는 거 맞지?"`,
				`<<He>>【이가】 얼굴을 붉히며 자국을 응시한다. "네가 날 너무 세게 만져서 남았어. 그건 아무것도 아닌 게 아니야. 아무것도 아닌 게 아니라고."`,
				`<<He>>【이가】 숨 가쁜 웃음을 흘린다. "네가 날 표시했으면 나도 널 표시해도 되지. 공평해. 이게 사랑이야."`
			)>>
			<<npcincr Kylar lust 8>><<gglust>><<set $enemytrust += 5>><<set $enemyanger -= 10>>
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $combatgoal is "strip" and $rng lte 25>>
		<<addSpeechLine "strip">>
		<<if $enemyanger gte 80>>
			<<print `<<He>>【이가】 다급한 손길로 당신의 옷을 잡아당긴다. "` + [`나한테서 숨지 마. 그 밑이 어떻게 생겼는지 다 알아.`, `이것들이 자꾸 우리 사이를 가로막아. 싫어.`, `다른 건 필요 없어. 넌 나만 있으면 돼.`][random(0,2)] + `"`>>
		<<else>>
			<<print `<<He>>【이가】 얼굴을 붉힌 채 당신의 옷을 만지작거린다. "` + [`그냥 널 보고 싶어. 나만.`, `가리는 걸 그만두면 정말 예뻐 보여.`, `부끄러워하지 마. 네가 완벽하다는 거 이미 알아.`][random(0,2)] + `"`>>
		<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if _silent isnot 1>>
		<<addSpeechLine "idle">>
		<<set $kylarsexcycle to $kylarsexcycle or 0>>
		<<switch $kylarsexcycle>>
			<<case 0>>
				<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or (!$genderknown.includes("Kylar") and perceivedGender() is "f"))>>
					<<He>>【이가】 당신의 귓가에 속삭인다. "우리 아기를 아주 많이 가질 거야."
				<<else>>
					"우리 아기를 아주 많이 입양할 거야." <<he>>【이가】 말한다.
				<</if>>
			<<case 1>>
				<<print `"넌 세상에서 최고의 <<pmummy "Kylar">>【이가】 될 거야." <<he>>【이가】 말한다.`>>
			<<case 2>>
				"정말 야하다니까," <<he>>【이가】 말한다. "우리 아직 결혼도 안 했는데!"
			<<case 3>>
				"내 기운을 쏙 빼놓아줘." <<he>>【이가】 말한다. "그리고 멈추지 마."
			<<case 4>>
				<<print `"널 쳐다본 다른 ${$pronoun is "m" ? "개자식들" : "창년들"} 따위 전부 잊어버릴 때까지 몇 번이고 다시 할 거야." <<he>>【이가】 말한다.`>>
			<<case 5>>
				"네가 영원히 생각하는 건 나뿐일 거야." <<he>>【이가】 말한다.
			<<case 6>>
				"모두 다 나쁜 놈들이야." <<he>>【이가】 말한다. "너 빼고. 넌 완벽해."
			<<case 7>>
				"이러니까 안심돼." <<he>>【이가】 말한다. "영원히 끝나지 않았으면 좋겠어."
			<<case 8>>
				"사...사-사랑해." <<he>>【이가】 말한다.
				<<set $kylarSeen.pushUnique("saidLove")>>
			<<case 9>>
				"그 소리, 나만을 위해 낸 거지, 그렇지?" <<he>>【이가】 지나치게 크게 웃으며 묻는다.
			<<case 10>>
				"다른 사람은 생각하지 마." <<he>>【이가】 속삭인다.
			<<case 11>>
				"네가 짓는 표정은 전부 알아." <<he>>【이가】 말한다. "이 표정이 제일 좋아."
			<<case 12>>
				"내가 쳐다보는 걸 멈추길 바랐다면, 그렇게 예쁘면 안 됐어." <<he>>【이가】 말한다.
			<<case 13>>
				"이거 끝나면 같이 도망가자." <<he>>【이가】 말한다. "조용한 곳으로. 잠겨 있는 곳으로."
			<<case 14>>
				"내 이름을 불러 줘." <<he>>【이가】 애원한다. "듣고 싶어."
			<<default>>
				"넌 정말 음탕하고 야해. 전부 내 거야." <<he>>【이가】 말한다.
		<</switch>>
		<<set $kylarsexcycle to ($kylarsexcycle + 1) % 16>> <!-- increase by one, and reset to 0 if it hits 16 -->
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>
