		<<case "Great Hawk">> <<set $_isLoveInterest to ($syndromebird is 1)>>
		<<case "Alex">>       <<set $_isLoveInterest to ($farm_stage gte 7 and $alex_countdown is undefined)>>
		<<case "Gwylan">>     <<set $_isLoveInterest to ($gwylanSeen?.includes("romance"))>>
		<<case "Poppy">>      <<set $_isLoveInterest to ($poppyromance gte 1)>>
		<<default>>           <<run $NPCNameList.includes(_args[0]) ? $_isLoveInterest = false : Errors.report("wrong argument passed to takeKissVirginityNamed: ", _args)>>
	<</switch>>

	<<set $_isConsensual to _args[1] or ($consensual is 1)>>

	<<if $_isLoveInterest>>
		<<set $_kissType to ($_isConsensual ? "loveInterest" : "loveRape")>>
	<<else>>
		<<set $_kissType to ($_isConsensual ? "consensual" : "rape")>>
	<</if>>
	<<takeKissVirginity _args[0] $_kissType>>
<</widget>>

/* Argument 0 is the npc, argument 1 is their virginity. */
<<widget "takeNPCVirginity">>
	<<set $_npcId to _args[0]>>
	<<set $_vType to _args[1]>>
	<!-- if the first argument is a name, find which npc has that name, else assume it is an index. -->
	<<if typeof $_npcId is "string">>
		<<set $_npcId to $NPCList.findIndex(npc => npc.fullDescription === $_npcId)>>
	<</if>>
	<<if $_npcId isnot undefined and $_npcId gte 0>>
		<<set $_npc to $NPCList[$_npcId]>>
		<<set $_straponvirginityIgnore to ($_vType is "penile" and npcHasStrapon($_npcId))>>
	<</if>>

	<<if $_npc and $_vType and $_npc.virginity and $_npc.virginity[$_vType] and ($wraith.mimic isnot $_npc.fullDescription) and !$_straponvirginityIgnore>>
		<<if ($_vType is "vaginal" or $_vType is "penile") and ($_npc.virginity.temple is true or $_npc.virginity.temple is 1) and $templePromised isnot $_npc.fullDescription>>
			<<set $_npc.virginity.temple to false>>
			<<if !$activeNightmare and $NPCNameList.indexOf($_npc.fullDescription) isnot -1>>
				<<set $NPCName[$NPCNameList.indexOf($_npc.fullDescription)].virginity.temple to false>>
			<</if>>
		<</if>>

		/* note: virginity must be exactly equal to true; only true means that they still have their virginity. */
		<<if $_npc.virginity[$_vType] is true>>
			<<personselect $_npcId>>
			<<set $_npc.virginity[$_vType] to "player">>
			<<switch $_vType>>
				<<case "vaginal">>
					<<set $speechNPCVaginaVirgin to 1>>
					<span class="pink">처녀막이 찢어지고, 순결이 영원히 사라지는 것이 느껴진다.</span>
					<<if effectiveTransformationLevel("demon") gte 6>>
						<span class="lewd"><<him>>【을를】 더럽히고 당신의 불순함을 퍼뜨린다는 사실에 비할 데 없는 쾌감이 솟구친다.</span>
						<<stress -50>><<trauma -50>><<lllstress>><<llltrauma>>
					<</if>>
					<<arousal 2000>><<ggarousal>>
					<br>
				<<case "penile">>
					<<set $speechNPCPenisVirgin to 1>>
					<span class="pink">포피가 귀두에서 벗겨지고, 동정이 영원히 사라지는 것이 느껴진다.</span>
					<<if effectiveTransformationLevel("demon") gte 6>>
						<span class="lewd"><<him>>【을를】 더럽히고 당신의 불순함을 퍼뜨린다는 사실에 비할 데 없는 쾌감이 솟구친다.</span>
						<<stress -50>><<trauma -50>><<lllstress>><<llltrauma>>
					<</if>>
					<<arousal 2000>><<ggarousal>>
					<br>
				<<case "anal">>
					<<set $speechNPCAnusVirgin to 1>>
					<span class="pink">조이는 느낌이 강하다. 아마 <<him>>에게는 이런 짓이 처음일 것이다.</span>
					<<arousal 2000>><<ggarousal>>
					<br>
				<<case "oral">>
					<<set $speechNPCOralVirgin to 1>>
					<span class="pink"><<He>>【은는】 이런 맛일 줄은 예상하지 못했다는 듯 깜짝 놀란 표정이다. 아마 이번이 첫 경험일 것이다.</span>
					<<arousal 1500>><<ggarousal>>
					<br>
				<<case "kiss">>
					<<set $speechNPCKissVirgin to 1>>
					<<set _npcKissVirginTemp to 1>>
				<<case "handholding">>
					<<set $speechNPCHandholdingVirgin to 1>>
					<span class="green">손이 꽉 쥐어지고, <<he>>【은는】 약간 긴장한 기색을 보인다.</span>
				<<default>>
			<</switch>>

			<<if $activeNightmare>>
				<<if $_npc.fullDescription is "Sydney" and ($_vType is "vaginal" or $_vType is "penile")>>
					<<displayFeatFake "Sydney the Pure Hearted">>
				<</if>>
			<<else>>
				<<if $NPCNameList.includes($_npc.fullDescription)>>
					<<run $virginTaken[$_vType].pushUnique($_npc.fullDescription)>>
				<<else>>
					/* non-named npcs' descriptions are not unique. ~15kb of uncompressed save bloat per 1000 virginities taken. acceptable until npc rework */
					<<run $virginTaken[$_vType].push($_npc.fullDescription)>>
				<</if>>
				<<set $_i to $NPCNameList.indexOf($_npc.fullDescription)>>
				<<if $_i isnot -1>>
					<<if $_npc.fullDescription is "Sydney" and ($_vType is "vaginal" or $_vType is "penile")>>
						<<earnFeat "Sydney the Pure Hearted">>
					<</if>>
					<<set $NPCName[$_i].virginity to $_npc.virginity>>
					<<if !$NPCName[$_i].virginityDetails>>
						<<set $NPCName[$_i].virginityDetails to {}>>
					<</if>>
					<<set $NPCName[$_i].virginityDetails[$_vType] to {
						timestamp: Time.date.timeStamp,
						taker: "pc",
						passage: $passage,
					}>>
					<<if $combat>>
						<<set $NPCName[$_i].virginityDetails[$_vType].consensual to !!$consensual>>
						<<set $NPCName[$_i].virginityDetails[$_vType].position to $position>>
					<<elseif _npcConsensualOverride isnot undefined>>
						<<set $NPCName[$_i].virginityDetails[$_vType].consensual to _npcConsensualOverride>>
						<<unset _npcConsensualOverride>>
					<</if>>
					<<if $_vType is "penile">>
						<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisSize to $NPCName[$_i].penissize>>
						<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisdesc to $NPCName[$_i].penisdesc>>
					<<elseif ["vaginal", "anal", "oral"].includes($_vType)>>
						<<if playerHasStrapon() or $player.penisExist>>
							<<set $NPCName[$_i].virginityDetails[$_vType].playerPenisSize to playerPenisSize()>>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>


<<widget "NPCVirginityTakenByOther">>
	<!-- Argument 0 is the npc, argument1 is the virginity, argument 2 is the thing taking the virginity -->
	<!-- example usage: <<NPCVirginityTakenByOther "Robin" "vaginal" $NPCList[0].fullDescription>> -->
	<!-- example usage: <<NPCVirginityTakenByOther 0 "anal" $tentacles[$tentacleindex].fullDesc>> -->
	<<set $_npcId to _args[0]>>
	<<set $_vType to _args[1]>>
	<<set $_takerDesc to _args[2]>>
	<<set _npcVirgin to {}>>
	<!-- if the first argument is a name, find which npc has that name, else assume it is an index. -->
	<<if typeof $_npcId is "string">>
		<<set $_npc to $NPCList.find(npc => npc.fullDescription === $_npcId)>>
		<<if $_npc is undefined>>
			<<set $_npc to $NPCName.find(npc => npc.description === $_npcId)>>
			<<set $_isNamedOnly to ($_npc isnot undefined)>>
		<</if>>
	<<elseif $_npcId isnot undefined>>
		<<set $_npc to $NPCList[$_npcId]>>
	<</if>>

	<<if $_npc and $_npc.strapon and $_npc.strapon.state is "worn">>
		<<set $_straponvirginityIgnore to ($_vType is "penile")>>
	<</if>>

	<<if $_npc and $_vType and $_npc.virginity and $_npc.virginity[$_vType] is true>>
		<!-- note: virginity must be exactly equal to true; only true means that they still have their virginity. -->
		<!-- note: NTR is never going to be a thing, but we record this bc it might be useful to remember HOW an npc's virginity was lost, and to what. beast/tentacle/etc -->
		<<set $_npc.virginity[$_vType] to $_takerDesc>>
		<<if !$_npc.virginityDetails>>
			<<set $_npc.virginityDetails to {}>>
		<</if>>
		<<set $_npc.virginityDetails[$_vType] to {
			timestamp: Time.date.timeStamp,
			taker: $_takerDesc,
			passage: $passage,
		}>>
		<<if $combat>>
			<<set $_npc.virginityDetails[$_vType].consensual to !!$consensual>>
			<<set $_npc.virginityDetails[$_vType].position to $position>>
		<</if>>
		<<set $_takerNpc to undefined>>
		<<set $_npcIndex to $NPCNameList.indexOf($_takerDesc)>>
		<<if $_npcIndex isnot -1>>
			<<set $_takerNpc to $NPCName[$_npcIndex]>>
		<<else>>
			<<run $NPCList.forEach(npc => {if (npc && npc.fullDescription === $_takerDesc) $_takerNpc = npc;})>>
		<</if>>
		<<if $_takerNpc>>
			<<set $_takerPenetratorDesc to $_takerNpc.penisdesc or "penis">>
			<<if $_takerNpc.strapon and $_takerNpc.strapon.state is "worn">>
				<<switch $_takerNpc.penissize>>
					<<case 6>>
						<<set $_takerPenetratorDesc to "monstrous strap-on">>
					<<case 5>>
						<<set $_takerPenetratorDesc to "colossal strap-on">>
					<<case 4>>
						<<set $_takerPenetratorDesc to "huge strap-on">>
					<<case 3>>
						<<set $_takerPenetratorDesc to "thick strap-on">>
					<<case 1>>
						<<set $_takerPenetratorDesc to "small strap-on">>
					<<default>>
						<<set $_takerPenetratorDesc to "strap-on">>
				<</switch>>
			<</if>>
		<</if>>
		<<if $_vType is "penile">>
			<<set $_npc.virginityDetails[$_vType].npcPenisSize to $_npc.penissize>>
			<<set $_npc.virginityDetails[$_vType].npcPenisdesc to $_npc.penisdesc>>
		<<elseif ["vaginal", "anal", "oral"].includes($_vType)>>
			<<if $_takerNpc>>
				<<set $_npc.virginityDetails[$_vType].npcPenisSize to $_takerNpc.penissize>>
				<<set $_npc.virginityDetails[$_vType].npcPenisdesc to $_takerPenetratorDesc>>
			<</if>>
		<</if>>

		<!-- if the npc is named, this will find and update their entry in $NPCName -->
		<<if !$_isNamedOnly>>
			<<set $_i to $NPCNameList.indexOf($_npc.fullDescription)>>
			<<if $_i isnot -1>>
				<<set $NPCName[$_i].virginity to $_npc.virginity>>
				<<set $NPCName[$_i].virginityDetails ||= {}>>

				<!-- Doubled up due to the way this widget works -->
				<<set $NPCName[$_i].virginityDetails[$_vType] to {
					timestamp: Time.date.timeStamp,
					taker: $_takerDesc,
					passage: $passage,
				}>>
				<<if $combat>>
					<<set $NPCName[$_i].virginityDetails[$_vType].consensual to !!$consensual>>
					<<set $NPCName[$_i].virginityDetails[$_vType].position to $position>>
				<</if>>
				<<if $_vType is "penile">>
					<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisSize to $NPCName[$_i].penissize>>
					<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisdesc to $NPCName[$_i].penisdesc>>
				<<elseif ["vaginal", "anal", "oral"].includes($_vType)>>
					<<if $debug is 1>><<run console.log($_takerDesc)>><</if>>
					<<if $_takerNpc>>
						<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisSize to $_takerNpc.penissize>>
						<<set $NPCName[$_i].virginityDetails[$_vType].npcPenisdesc to $_takerPenetratorDesc>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>

		<!-- temporary variables to use for scenes. -->
		<<set _npcVirgin[$_vType] to true>>
	<</if>>
<</widget>>

<<widget "setupMidOrgasm">>
	<<if $finish isnot 1 and ($setupMidOrgasm is true or $combatExtended.reverseRapeStart is 1 or $combatExtended.consensualStart is 1) and $enemypleasure gte $enemypleasuremax>>
		<<set _midOrgasm to false>>
		<<if !$npcOrgasmState or typeof $npcOrgasmState isnot "object" or Array.isArray($npcOrgasmState)>>
			<<set $npcOrgasmState to {}>>
		<</if>>

		/* Beast trains are sequential solo encounters unless Beast Gangbangs is enabled. */
		<<set _groupMultiOrgasmBlocked to $multiOrgasmGroupDisable is 1 and $enemynomax gt 1 and ($enemytype isnot "beast" or $beastGroupFight is 1)>>
		<<if !_groupMultiOrgasmBlocked>>
			<<for _n to 0; _n lt Math.min($enemynomax, $NPCList.length); _n++>>
				<<if $NPCList[_n] and $NPCList[_n].active is "active" and $NPCList[_n].stance isnot "defeated">>
					<<set _npcOrgasmState to $npcOrgasmState[_n]>>
					<<if _npcOrgasmState and _npcOrgasmState.max isnot undefined and _npcOrgasmState.count isnot undefined>>
						<<if _npcOrgasmState.max gt _npcOrgasmState.count>>
							<<set _npcOrgasmState.count to _npcOrgasmState.count + 1>>
						<</if>>
						<<if _npcOrgasmState.count lt _npcOrgasmState.max or $combatExtended.reverseRapeStart is 1 or $combatExtended.consensualStart is 1>>
							<<set _midOrgasm to true>>
						<</if>>
					<<elseif $combatExtended.reverseRapeStart is 1 or $combatExtended.consensualStart is 1>>
						<<set _midOrgasm to true>>
					<</if>>
				<</if>>
			<</for>>
		<</if>>

		<<if _midOrgasm is true>>
			/* <<set $enemyarousal to $enemyarousalmax * (0.2 + Math.random() * 0.3)>> */
			<<set $enemypleasure to Math.floor($enemypleasuremax * (0.2 + Math.random() * 0.3))>>
			<<set $finish to 0>>
			<<set $ejaculatingMid to true>>
		<</if>>
	<</if>>
<</widget>>

<<widget "combatTrainAdvance">>/* Advances sequential beast trains. Group fights keep their original NPC slots and skip the train reload lifecycle. */
	<<if $beastGroupFight is 0>>
		<<if $combatTrain.orgasmStates and $npcOrgasmState and $npcOrgasmState[0]>>
			<<set $combatTrain.orgasmStates[$combatTrain.active] to clone($npcOrgasmState[0])>>
		<</if>>
		<<if !$ejaculatingMid>>
			<<clearnpc>>
		<</if>>
		<<if $combatTrain.length gt 0>>
			<<set $combatTrain.length-->>
			<<set $combatTrain.active += 1>>
			<<loadNPC 0 `"beast_" + $combatTrain.active`>>
			<<if $combatTrain.orgasmStates and $combatTrain.orgasmStates[$combatTrain.active]>>
				<<set $npcOrgasmState[0] to clone($combatTrain.orgasmStates[$combatTrain.active])>>
			<</if>>
			/* Sync event buffer: retire old entry for slot 0, push fresh one for the
			   beast we just loaded.  Without this, validate() sees the old NPC's entry
			   but slot 0 now holds a different beast → mismatch → false error. */
			<<if $event isnot undefined and $event.buffer isnot undefined>>
				<<for _evtTrainI to $event.buffer.length - 1; _evtTrainI gte 0; _evtTrainI-->>
					<<if $event.buffer[_evtTrainI] and $event.buffer[_evtTrainI].slot is 0>>
						<<run $event.buffer.splice(_evtTrainI, 1)>>
					<</if>>
				<</for>>
			<</if>>
			<<run EventSystem.push($passage, 0, $timeStamp)>>
			<<if $NPCList[0].monster is "monster">>
				<<set $monster to 1>>
			<<else>>
				<<set $monster to 0>>
			<</if>>
			<!-- since we're not calling <<combatinit>>, re-init the first npc here -->
			<<if $NPCList[0].penis is "none" and $player.penisExist>>
				<<set $position to "missionary">>
			<<else>>
				<<set $position to ["doggy", "doggy", "doggy", "doggy", "missionary"].random()>>
			<</if>>
			<<if $NPCList[0].stance isnot "defeated">>
				<<set $NPCList[0].active to "active">>
			<</if>>
			<<resetLastOptions>>
			<<wetnessCalculate>>
		<<else>>
			<<for _e_n to 0; _e_n lt $combatTrain.total_length + 1; _e_n++>>
				<<loadNPC _e_n `"beast_" + _e_n`>>
				<<if $combatTrain.orgasmStates and $combatTrain.orgasmStates[_e_n]>>
					<<set $npcOrgasmState[_e_n] to clone($combatTrain.orgasmStates[_e_n])>>
				<</if>>
				/* Sync event buffer for each reloaded beast slot */
				<<if $event isnot undefined and $event.buffer isnot undefined>>
					<<for _evtReloadI to $event.buffer.length - 1; _evtReloadI gte 0; _evtReloadI-->>
						<<if $event.buffer[_evtReloadI] and $event.buffer[_evtReloadI].slot is _e_n>>
							<<run $event.buffer.splice(_evtReloadI, 1)>>
						<</if>>
					<</for>>
				<</if>>
				<<run EventSystem.push($passage, _e_n, $timeStamp)>>
				<<if !$ejaculatingMid>>
					<<clearNPC `"beast_" + _e_n`>>
				<</if>>
			<</for>>
		<</if>>
	<</if>>
	<<if $combatExtended.reverseRapeStart is 1>>
		<<set $consensual to 0>>
		<<set $combatExtended.reverseRapeStart to 0>>
		<<set $combatExtended.standingFightStart to 1>>
	<</if>>
	<<if $finish is 1>>
		<<set $enemyhealth to 1>>
		<<set $enemyarousal to 0>>
		<<set $enemypleasure to 0>>
	<</if>>
	<<set $active_enemy to 0>>
	<<unset $hypnosis_deviancy_check>>
	<<unset $otherFilled>>
	<<unset $leglocktarget>>
<</widget>>

<<widget "beastTrainGenerate">>/* Records encounter metadata. Sequential fights also save each beast and load the first into slot 0. */
	<<set _enemyno to $enemyno - 1>>
	<<set $combatTrain to {
		length: _enemyno,
		total_length: _enemyno,
		active: 0,
		pronouns: [],
		monsters: [],
		beastTypes: [],
		orgasmStates: clone($npcOrgasmState || {})
	}>>
	<<for _e_n to 0; _e_n lt $enemyno; _e_n++>>
		<<if $beastGroupFight is 0>><<saveNPC _e_n `"beast_" + _e_n`>><</if>>
		<<set $combatTrain.beastTypes.push($NPCList[_e_n].type)>>
		<<set $combatTrain.pronouns.push($NPCList[_e_n].pronoun)>>
		<<set $combatTrain.monsters.push($NPCList[_e_n].monster)>>
	<</for>>
	<<if $beastGroupFight is 0>>
		<<clearnpc>>
		<<loadNPC 0 beast_0>>
		<<if $combatTrain.orgasmStates[0]>>
			<<set $npcOrgasmState[0] to clone($combatTrain.orgasmStates[0])>>
		<</if>>
		/* Sync event buffer: after clearnpc + loadNPC the buffer is stale.
		   Clear any leftover entries for slot 0, then register the loaded beast. */
		<<if $event isnot undefined and $event.buffer isnot undefined>>
			<<for _evtGenI to $event.buffer.length - 1; _evtGenI gte 0; _evtGenI-->>
				<<if $event.buffer[_evtGenI] and $event.buffer[_evtGenI].slot is 0>>
					<<run $event.buffer.splice(_evtGenI, 1)>>
				<</if>>
			<</for>>
		<</if>>
		<<run EventSystem.push($passage, 0, $timeStamp)>>
	<</if>>
<</widget>>

/* Cannot remove as it is used in combat logic */
<<widget "leg_position">>
	<<set $_parts to [$anususe, $vaginause, $chestuse, $mouthuse]>>
	<<if ["left_thigh", "right_thigh"].includes($machine?.tattoo?.use)>>
		<<set _leg_position to "up">>
	<<elseif $_parts.includes("penis") or $_parts.includes(1)>>
		<<set _leg_position to "up">>
	<<else>>
		<<set _leg_position to "down">>
	<</if>>
<</widget>>

/* Should ideally only be used if you're sure one npc is in this position */
/* Selects the NPC that has the given body part (chest, mouth, vagina) set to the given value */
/* Useful when you know one of them is in a given position by looking at the PC, but aren't sure which */
<<widget "selectNpcWithPartInPosition">>
	<<if _args[0] and _args[1]>>
		<<set $_part to _args[0]>>
		<<set $_position to _args[1]>>
		<<unset _npc>>
		<<for _j = 0; _j lt $enemynomax; _j++>>
			<<if !$NPCList[_j]>>
				/* Skip empty slot */
			<<elseif $_part is "hand" and ($NPCList[_j]["lefthand"] is $_position or $NPCList[_j]["righthand"] is $_position)>>
				<<personselect _j>>
				<<set _npc to $NPCList[_j]>>
				<<break>>
			<<elseif $NPCList[_j][$_part] is $_position>>
				<<personselect _j>>
				<<set _npc to $NPCList[_j]>>
				<<break>>
			<<elseif ["leftarm","rightarm"].includes($_position) and $NPCList[_j][$_part] is "botharm">>
				/* Using both hands stores the genital as "botharm", while each arm still stores the genital itself, so matching "leftarm" fails. */
				<<personselect _j>>
				<<set _npc to $NPCList[_j]>>
				<<break>>
			<</if>>
		<</for>>
		<<if _npc is undefined>>
			/* No NPC is in this position, so don't use _j after it passes the NPC list. Keep the current NPC if valid, otherwise use the first available one. */
			<div class="error-view"><span>selectNpcWithPartInPosition: <<= $passage>>에서 [<<= $_position>>] 위치에 [<<= $_part>>] 부위를 가진 NPC가 없습니다. 복구를 위해 대상을 다시 지정합니다. 이전 장면이 오래된 위치 추적 정보를 남겨 둔 것으로 보입니다. 반복되면 세이브를 내보내 제보해 주십시오.</span></div>
			<<if !$NPCList[$index] or !$NPCList[$index].pronoun>>
				<<set _fallbackSlot to -1>>
				<<for _k = 0; _k lt $enemynomax; _k++>>
					<<if $NPCList[_k] and $NPCList[_k].pronoun>>
						<<set _fallbackSlot to _k>>
						<<break>>
					<</if>>
				<</for>>
				<<if _fallbackSlot gte 0>>
					<<personselect _fallbackSlot>>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<run throw new Error("selectNpcWithPartInPosition used with incorrect number of variables (or one is undefined)")>>
	<</if>>
<</widget>>

<<widget "selectNpcWithPartInPositionAnus">>
	<<if _args[0]>>
		<<unset _npc>>
		<<for _j = 0; _j lt $enemynomax; _j++>>
			<<if $NPCList[_j] and ($NPCList[_j].penis is _args[0] or $NPCList[_j].vagina is _args[0])>>
				<<personselect _j>>
				<<set _npc to $NPCList[_j]>>
				<<break>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "cover_end">>
	<<if $enemypleasure gte $enemypleasuremax>>
		<<exit>>
	<</if>>
	<<if $leftarm is "vagina" or $rightarm is "vagina">>
		<<set $vaginause to 0>>
	<<elseif $leftarm is "coverpenis" or $rightarm is "coverpenis">>
		<<set $penisuse to 0>>
	<<elseif $leftarm is "anus" or $rightarm is "anus">>
		<<set $anususe to 0>>
	<<elseif $leftarm is "face" or $rightarm is "face">>
		<<set $face to 0>>
	<</if>>
<</widget>>

/* args[0] - 0-5 for npc, or "player", args[1] fo article (the, it, etc)*/
<<widget "condomDesc">><<silently>>
	<<if _args[1] is "it">>
		<<set _text_output to "그것">>
	<<elseif _args[0] isnot "player" and !between(_args[0], 0, 5)>>
		<<run Errors.report("Bad arguments for <<condomDesc>> ", "args: " + JSON.stringify(_args) + "; stack: " + Utils.GetStack())>>
		<span class="error"><<print "Bad arguments for condomDesc. args: " + JSON.stringify(_args) + "; stack: " + Utils.GetStack()>></span>
	<<else>>
		<<set $_condomArticle to (_args[1] ? _args[1] : "a")>>
		<<set $_condom to (_args[0] ? _args[0] : 0)>>
		<<set _text_output to $_condomArticle>>
		<<if $_condom is "player" and $player.condom>>
			<<set $_condomDesc to clone($player.condom)>>
		<<elseif $NPCList[$_condom] and $NPCList[$_condom].condom>>
			<<set $_condomDesc to clone($NPCList[$_condom].condom)>>
		<<else>>
			<<set _text_output to "오류: 콘돔 정보 없음">>
		<</if>>
		<<set $_colourName to setup.colourName($_condomDesc.colour)>>
		<<if $_condomArticle is "a">>
			<<set _text_output to $_colourName + " ">>
		<<elseif $_condomArticle is "the">>
			<<set _text_output to "그 " + $_colourName + " ">>
		<<else>>
			<<set _text_output to $_colourName + " ">>
		<</if>>
		<<if $_condomDesc.source is "damagedVending">>
			<<set _text_output += "worn-looking ">>
		<<elseif $_condomDesc.type isnot "plain">>
			<<set _text_output += $_condomDesc.type + " ">>
		<</if>>
		<<set _text_output += "콘돔">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

/* args[0] - 0-5 for npc, args[1] "player" if the npc is equipping it on the player */
<<widget "equipNPCCondom">>
	<<set $_condomnpc to (_args[0] ? _args[0] : 0)>>
	<<if $NPCList[$_condomnpc].condom>>
		<<if _args[1] is "player">>
			<<set $player.condom to clone($NPCList[$_condomnpc].condom)>>
			<<set $player.condom.worn to true>>
			<<run delete $player.condom.willUse>>
			<<set $NPCList[$_condomnpc].condom to false>>
		<<else>>
			<<set $NPCList[$_condomnpc].condom.worn to true>>
		<</if>>
		<<set $NPCList[$_condomnpc].condomAsk to true>>
	<<else>>
		<span class="red">오류: NPC 콘돔 $_condomnpc【이가】 정의되지 않았습니다.</span>
	<</if>>
<</widget>>

/* args[0] - 0-5 for npc, args[1] "player" if the npc is removing it from the player */
<<widget "removeNPCCondom">>
	<<set $_condomnpc to (_args[0] ? _args[0] : 0)>>
	<<if _args[1] is "player">>
		<<set $player.condom to false>>
	<<else>>
		<<set $NPCList[$_condomnpc].condom to false>>
	<</if>>
<</widget>>

/* Automatic condom break roll for NPC slot args[0]'s condom and for the player's condom while inside that NPC. */
<<widget "condomBreakCheck">>
	<<set _cbNpc to $NPCList[_args[0]]>>
	<<if condomState(_args[0]) is "worn" and ["vagina", "anus", "vaginadouble", "anusdouble"].includes(_cbNpc.penis) and random(1, 100) lte $settings.npcCondomBreakChance>>
		<<set _cbNpc.condom.state to "defective">>
		<<personselect _args[0]>>
		<span class="lewd"><<combatpersons>> <<npcPenisSimple _args[0]>>에 씌워진 콘돔이 찢어진다.</span>
	<</if>>
	<<if condomState("player") is "worn" and (_cbNpc.vagina is "penis" or _cbNpc.vagina is "otheranus" or _cbNpc.penis is "otheranus") and random(1, 100) lte $settings.playerCondomBreakChance>>
		<<set $player.condom.state to "defective">>
		<span class="lewd">콘돔 끝이 찢어져 벌어지는 것이 느껴진다.</span>
	<</if>>
<</widget>>

/* For the player equipping their own condom on themselves */
<<widget "equipPlayerCondom">>
	<<set $_damagedCondom to _args[0] is "damaged" or _args[0] is true>>
	<<if $_damagedCondom and ($damagedCondoms || 0) gt 0>>
		<<set $damagedCondoms -= 1>>
	<</if>>
	<<set $_condomState to "normal">>
	<<if $_damagedCondom>>
		<<set $_condomState to "defective">>
		<<if random(1, 5) is 1>><<set $_condomState to "sabotaged">><</if>>
	<<elseif random(0,100) gt 98>>
		<<set $_condomState to "defective">>
	<</if>>
	<<set $player.condom to {
		state: $_condomState,
		type: "plain",
		colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
		worn: true
	}>>
	<<if $_damagedCondom>>
		<<set $player.condom.source to "damagedVending">>
		<span class="red">포장이 닳고 바래 보인다.</span>
	<</if>>
	<<set $condoms -= 1>>
<</widget>>

/* For the player removing any condom from themselves */
<<widget "removePlayerCondom">>
	<<set $player.condom to false>>
<</widget>>

<<widget "giveNPCCondom">>
	<<set $_condomnpc to (_args[0] ? _args[0] : 0)>>
	<<if $NPCList[$_condomnpc].condom>>
		<span class="red">오류: NPC 콘돔 $_condomnpc【이가】 기존 콘돔과 겹쳤습니다.</span>
	<<else>>
		<<set $_damagedCondom to _args[1] is "damaged" or _args[1] is true>>
		<<if $_damagedCondom and ($damagedCondoms || 0) gt 0>>
			<<set $damagedCondoms -= 1>>
		<</if>>
		<<set $_condomState to "normal">>
		<<if $_damagedCondom>>
			<<set $_condomState to "defective">>
			<<if random(1, 5) is 1>><<set $_condomState to "sabotaged">><</if>>
		<<elseif random(0,100) gt 98>>
			<<set $_condomState to "defective">>
		<</if>>
		<<set $NPCList[$_condomnpc].condom to {
			willUse: true,
			state: $_condomState,
			type: "plain",
			colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
			worn: false
		}>>
		<<if $_damagedCondom>>
			<<set $NPCList[$_condomnpc].condom.source to "damagedVending">>
			<span class="red">포장이 닳고 바래 보인다.</span>
		<</if>>
		<<set $condoms -= 1>>
		<<set $NPCList[$_condomnpc].condomCanGive to false>>
		<<npcCondomEquipImmediate $_condomnpc "it">>
	<</if>>
<</widget>>

<<widget "npcCondomEquipImmediate">>
	<<set $_condomnpc to (_args[0] ? _args[0] : 0)>>
	<<set $_condomArticle to (_args[1] ? _args[1] : 0)>>
	<<if $NPCList[$_condomnpc].condom?.willUse>>
		/*Your penis*/
		<<if $penisstate is "entrance" or $penisstate is "imminent" or $penisstate is "otheranusentrance" or $penisstate is "otheranusimminent">>
			<<if ($NPCList[$_condomnpc].vagina.toString().includes("penis") or $NPCList[$_condomnpc].penis.toString().includes("otheranus")) and !$player.condom and $parasite.penis.name is undefined>>
				<<personselect $_condomnpc>>
				<<if playerChastity("penis")>>
					<<He>>【은는】 당신의 자지에 콘돔을 씌우려 하지만, 당신의 $worn.genitals.name 위로 잘 씌워지지 않는 것 같다. <span class="red"><<He>>【은는】 빠르게 포기한다.</span>
					<<set $NPCList[$_condomnpc].condom.willUse to false>>
				<<else>>
					<span class="green"><<He_Short>>【이가】 당신의 자지 위에 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운다.</span>
					<<equipNPCCondom $_condomnpc "player">>
				<</if>>
			<</if>>
		<</if>>
		<<if $penisstate is "penetrated">>
			<<if $NPCList[$_condomnpc].vagina is "penis" and !$player.condom and $parasite.penis.name is undefined>>
				<<personselect $_condomnpc>>
				<span class="green"><<He_Short>>【이가】 당신의 자지를 보지에서 잠시 빼내어 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운 뒤, 다시 집어넣는다.</span>
				<<equipNPCCondom $_condomnpc "player">>
			<</if>>
		<</if>>
		<<if $penisstate is "otheranus">>
			<<if $NPCList[$_condomnpc].penis is "otheranus" and !$player.condom and $parasite.penis.name is undefined>>
				<<personselect $_condomnpc>>
				<span class="green"><<He_Short>>【이가】 당신의 자지를 항문에서 잠시 빼내어 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운 뒤, 다시 집어넣는다.</span>
				<<equipNPCCondom $_condomnpc "player">>
			<</if>>
		<</if>>
		/*Their penis*/
		<<if $vaginastate is "entrance" or $vaginastate is "imminent">>
			<<if ($NPCList[$_condomnpc].penis is "vaginaentrance" or $NPCList[$_condomnpc].penis is "vaginaimminent") and $NPCList[$_condomnpc].condom.worn is false and !npcHasStrapon($_condomnpc)>>
				<<personselect $_condomnpc>>
				<<if $NPCList[$_condomnpc].chastity.penis.includes("chastity")>>
					<<He>>【은는】 콘돔을 씌우려 하지만, $NPCList[$_condomnpc].chastity.penis 위로 잘 씌워지지 않는 것 같다. <span class="red"><<He>>【은는】 빠르게 포기한다.</span>
					<<set $NPCList[$_condomnpc].condom.willUse to false>>
				<<else>>
					<span class="green"><<He_Short>>【이가】 자기 자지 위에 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운다.</span>
					<<equipNPCCondom $_condomnpc>>
				<</if>>
			<</if>>
		<</if>>
		<<if $vaginastate is "penetrated">>
			<<if $NPCList[$_condomnpc].penis is "vagina" and $NPCList[$_condomnpc].condom.worn is false and !npcHasStrapon($_condomnpc)>>
				<<personselect $_condomnpc>>
				<span class="green"><<person>>【이가】 자기 자지를 당신의 보지에서 잠시 빼내어 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운 뒤, 다시 집어넣는다.</span>
				<<equipNPCCondom $_condomnpc>>
			<</if>>
		<</if>>
		<<if $anusstate is "entrance" or $anusstate is "imminent">>
			<<if ($NPCList[$_condomnpc].penis is "anusentrance" or $NPCList[$_condomnpc].penis is "anusimminent") and $NPCList[$_condomnpc].condom.worn is false and !npcHasStrapon($_condomnpc)>>
				<<personselect $_condomnpc>>
				<span class="green"><<person>>【이가】 자기 자지 위에 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운다.</span>
				<<equipNPCCondom $_condomnpc>>
			<</if>>
		<</if>>
		<<if $anusstate is "penetrated">>
			<<if $NPCList[$_condomnpc].penis is "anus" and $NPCList[$_condomnpc].condom.worn is false and !npcHasStrapon($_condomnpc)>>
				<<personselect $_condomnpc>>
				<span class="green"><<person>>【이가】 자기 자지를 당신의 항문에서 잠시 빼내어 <<condomDesc $_condomnpc $_condomArticle>>【을를】 씌운 뒤, 다시 집어넣는다.</span>
				<<equipNPCCondom $_condomnpc>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "combat-dislodge-vaginal-dildo">>
	<<if playerHasWornVaginalDildo() and (["penis", "penisdouble", "machine", "tentacle"].includes($vaginause) or ["entrance", "imminent", "penetrated", "doubleentrance", "doubleimminent", "doublepenetrated"].includes($vaginastate))>>
		<<set $worn.vaginal_dildo.state to "removed">>
