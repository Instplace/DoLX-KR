		<<case "Sydney">>     <<set $_isLoveInterest to ($sydneyromance is 1)>>
		<<case "Eden">>       <<set $_isLoveInterest to ($syndromeeden is 1)>>
		<<case "Avery">>      <<set $_isLoveInterest to ($auriga_artefact)>>
