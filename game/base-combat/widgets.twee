:: Widgets Combat [widget]

<<widget "countBrokenVows">>
	<<if $brokenVowCount is undefined>>
		/* Instanciating the object */
		<<set $brokenVowCount to Object.fromEntries(V.NPCNameList.map(k => [k.split(" ").join(""), 0]))>>
		/* Undefined is for unnamed npcs and beasts */
		<<set $brokenVowCount.Undefined to 0>>
	<</if>>
	<<if _args[0] in $brokenVowCount>>
		<<set $brokenVowCount[_args[0]] += 1>>
	<<else>>
		<<set $brokenVowCount.Undefined += 1>>
	<</if>>
<</widget>>

<<widget "takeVirginity">>
	<<if Array.isArray(_args[0])>>
		/* Array of NPCList index's, should only be used for double penetration */
		<<set $_npc to $NPCList[_args[0][0]]>>
		<<set $_npc2 to $NPCList[_args[0][1]]>>
		<<if $_npc?.fullDescription and $_npc2?.fullDescription>>
			<<set $_taker to `${$_npc.fullDescription} and ${$_npc2.fullDescription}`>>
		<</if>>
	<</if>>
	<<if !$_taker>>
		<<set $_taker to _args[0]>>
		<<set $_npcIndex to $NPCNameList.indexOf($_taker)>>
		<<if $_npcIndex isnot -1>>
			<<set $_npc to $NPCName[$_npcIndex]>>
		<<else>>
			<<run $NPCList.forEach(npc => {
				if (npc && npc.fullDescription === $_taker) $_npc = npc;
			})>>
		<</if>>
	<</if>>
	<<if _args[1]>>
		<<set _lostThisTurn to (_args[1] is "vaginal" and _vaginalLostThisTurn) or (_args[1] is "anal" and _analLostThisTurn) or (_args[1] is "oral" and _oralLostThisTurn)>>
		<<if _lostThisTurn and $player.virginity[_args[1]] isnot true and $_taker isnot undefined and $_taker isnot 0>>
			<<set _previousTaker to $player.virginity[_args[1]]>>
			<<set _previousTakerText to _previousTaker ? String(_previousTaker) : "">>
			<<if !_virginityTakersThisTurn>>
				<<set _virginityTakersThisTurn to {}>>
			<</if>>
			<<if !_virginityTakersThisTurn[_args[1]]>>
				<<set _virginityTakersThisTurn[_args[1]] to _previousTakerText ? [_previousTakerText] : []>>
			<</if>>
			<<set _alreadyCredited to _virginityTakersThisTurn[_args[1]].includes($_taker)>>
			<<if !_alreadyCredited>>
				<<if _previousTakerText>>
					<<set $player.virginity[_args[1]] to `${_previousTakerText} and ${$_taker}`>>
				<<else>>
					<<set $player.virginity[_args[1]] to $_taker>>
				<</if>>
				<<if $player.virginityDetails and $player.virginityDetails[_args[1]]>>
					<<set $player.virginityDetails[_args[1]].taker to $player.virginity[_args[1]]>>
					<<if $_npc and ["vaginal", "anal", "oral"].includes(_args[1]) and !$player.virginityDetails[_args[1]].npcPenisSize2>>
						<<set _npcPenetratorDesc2 to $_npc.penisdesc or "penis">>
						<<if $_npc.strapon and $_npc.strapon.state is "worn">>
							<<switch $_npc.penissize>>
								<<case 6>>
									<<set _npcPenetratorDesc2 to "monstrous strap-on">>
								<<case 5>>
									<<set _npcPenetratorDesc2 to "colossal strap-on">>
								<<case 4>>
									<<set _npcPenetratorDesc2 to "huge strap-on">>
								<<case 3>>
									<<set _npcPenetratorDesc2 to "thick strap-on">>
								<<case 1>>
									<<set _npcPenetratorDesc2 to "small strap-on">>
								<<default>>
									<<set _npcPenetratorDesc2 to "strap-on">>
							<</switch>>
						<</if>>
						<<set $player.virginityDetails[_args[1]].npcPenisSize2 to $_npc.penissize>>
						<<set $player.virginityDetails[_args[1]].npcPenisdesc2 to _npcPenetratorDesc2>>
					<</if>>
				<</if>>
				<<run _virginityTakersThisTurn[_args[1]].push($_taker)>>
			<</if>>
		<</if>>
		<<if _args[1] is "penile" and playerHasStrapon()>>
			<!-- Do nothing -->
		<<else>>
			<<if $player.virginity[_args[1]] is true>>
				<<if $activeNightmare or ($wraith.mimic is $_taker)>>
					<<switch $_taker>>
						<<case "Robin">><<displayFeatFake "Robin the Lover">>
						<<case "Kylar">><<displayFeatFake "Kylar the Obsessed">>
						<<case "Eden">><<displayFeatFake "Eden the Lonely">>
						<<case "Whitney">><<displayFeatFake "Whitney the Tsundere">>
						<<case "Avery">><<displayFeatFake "Avery the Moneybags">>
						<<case "Leighton">><<displayFeatFake "Leighton the Shady">>
						<<case "Alex">><<displayFeatFake "Alex the Robust">>
						<<case "Great Hawk">><<displayFeatFake "Great Hawk the Terror">><<displayFeatFake "Mate for life">>
						<<case "Wren">><<displayFeatFake "Wren the Sly">>
						<<case "Black Wolf">><<displayFeatFake "Great Wolf the Alpha">>
						<<case "Harper">><<displayFeatFake "Harper the Hypnotist">>
						<<case "Morgan">><<displayFeatFake "Morgan the Lost">>
						<<case "Bailey">><<displayFeatFake "Bailey the 'caretaker'">>
						<<case "Zephyr">><<displayFeatFake "Zephyr the captain">>
						<<case "Gwylan">><<displayFeatFake "Gwylan the Bewitching">>
						<<case "Poppy">><<displayFeatFake "Poppy's Jewel">>
					<</switch>>
					<<if !$activeNightmare>>
						<<set $_taker to "Ivory Wraith">>
					<</if>>
				<<elseif _args[1] is "vaginal" or _args[1] is "penile">>
					<<if Array.isArray(_args[0])>>
						<<awardVirginityFeat $NPCList[_args[0][0]].fullDescription>>
						<<awardVirginityFeat $NPCList[_args[0][1]].fullDescription>>
					<<else>>
						<<awardVirginityFeat $_taker>>
					<</if>>
				<</if>>

				<<if !$player.virginityDetails>>
					<<set $player.virginityDetails to {}>>
				<</if>>
				<<set $player.virginityDetails[_args[1]] to {
					timestamp: Time.date.timeStamp,
					taker: $_taker,
					passage: $passage,
				}>>
				/* Heat overrode the player's actions on the turn it was taken: consensual or not, the choice wasn't theirs. */
				<<if $xchange?.heat?.controlActive>>
					<<set $player.virginityDetails[_args[1]].heatControlled to true>>
				<</if>>
				<<if _consensualOverride isnot undefined>>
					<<set $player.virginityDetails[_args[1]].consensual to _consensualOverride>>
					<<unset _consensualOverride>>
				<<elseif $combat>>
					<<set $player.virginityDetails[_args[1]].consensual to !!$consensual>>
					<<set $player.virginityDetails[_args[1]].position to $position>>
				<</if>>
				<<if _args[1] is "penile">>
					<<set $player.virginityDetails[_args[1]].playerPenisSize to $player.penissize>>
				<<elseif ["vaginal", "anal", "oral"].includes(_args[1])>>
					<<if $_npc>>
						<<set $_npcPenetratorDesc to $_npc.penisdesc or "penis">>
						<<if $_npc.strapon and $_npc.strapon.state is "worn">>
							<<switch $_npc.penissize>>
								<<case 6>>
									<<set $_npcPenetratorDesc to "monstrous strap-on">>
								<<case 5>>
									<<set $_npcPenetratorDesc to "colossal strap-on">>
								<<case 4>>
									<<set $_npcPenetratorDesc to "huge strap-on">>
								<<case 3>>
									<<set $_npcPenetratorDesc to "thick strap-on">>
								<<case 1>>
									<<set $_npcPenetratorDesc to "small strap-on">>
								<<default>>
									<<set $_npcPenetratorDesc to "strap-on">>
							<</switch>>
						<</if>>
						<<set $player.virginityDetails[_args[1]].npcPenisSize to $_npc.penissize>>
						<<set $player.virginityDetails[_args[1]].npcPenisdesc to $_npcPenetratorDesc>>
					<</if>>
					<<if $_npc2>>
						<<set $_npcPenetratorDesc2 to $_npc2.penisdesc or "penis">>
						<<if $_npc2.strapon and $_npc2.strapon.state is "worn">>
							<<switch $_npc2.penissize>>
								<<case 6>>
									<<set $_npcPenetratorDesc2 to "monstrous strap-on">>
								<<case 5>>
									<<set $_npcPenetratorDesc2 to "colossal strap-on">>
								<<case 4>>
									<<set $_npcPenetratorDesc2 to "huge strap-on">>
								<<case 3>>
									<<set $_npcPenetratorDesc2 to "thick strap-on">>
								<<case 1>>
									<<set $_npcPenetratorDesc2 to "small strap-on">>
								<<default>>
									<<set $_npcPenetratorDesc2 to "strap-on">>
							<</switch>>
						<</if>>
						<<set $player.virginityDetails[_args[1]].npcPenisSize2 to $_npc2.penissize>>
						<<set $player.virginityDetails[_args[1]].npcPenisdesc2 to $_npcPenetratorDesc2>>
					<</if>>
					<<if !$player.virginityDetails[_args[1]].npcPenisSize>>
						<<if $tentacles>>
							<<run Object.values($tentacles).forEach(tentacle => {
								if (tentacle && tentacle.fullDesc === $_taker && tentacle.size !== undefined) $player.virginityDetails[_args[1]].tentacleSize = tentacle.size;
							})>>
						<</if>>
					<</if>>
				<</if>>

				<<if $_taker isnot undefined and $_taker isnot 0>>
					<<set $player.virginity[_args[1]] to $_taker>>
					<<if ["vaginal", "anal", "oral"].includes(_args[1])>>
						<<if !_virginityTakersThisTurn>>
							<<set _virginityTakersThisTurn to {}>>
						<</if>>
						<<set _virginityTakersThisTurn[_args[1]] to [$_taker]>>
					<</if>>
					<<if $ironmanmode is true and $passage != "Loveth">>
						<<run ironmanAutoSave()>>
					<</if>>
				<<else>>
					<<set $player.virginity[_args[1]] to false>>
				<</if>>
				<!-- virgin purity loss -->
				<<set _tempXChangedPurity to typeof playerInTemporaryXChangeBody === "function" and playerInTemporaryXChangeBody()>>
				<<if !_tempXChangedPurity>>
					<<switch _args[1]>>
						<<case "vaginal" "penile">>
							<<if $templePromised isnot $_taker>>
								<<purity -50>>
							<</if>>
						<<case "anal">><<purity -25>>
						<<case "oral">><<purity -25>>
						<<case "handholding">><<purity -10>>
						<<case "kiss">><<purity -10>>
					<</switch>>
				<</if>>
				<<if !$activeNightmare and setup.playerVirginitiesTakenBySameNamedNpc($_taker)>>
					<<earnFeat "Monogamous">>
				<</if>>
			<</if>>
			<<run _trueBodyOK = typeof playerInTemporaryXChangeBody === "function" ? !playerInTemporaryXChangeBody() : true; >>
			<<if ($player.virginity.temple is true or $player.virginity.temple is 1)
				and (_args[1] is "vaginal" or _args[1] is "penile")
				and $templePromised isnot $_taker
				and _trueBodyOK>>
				<<set $virginityProtected to false>>
				<<set $player.virginity.temple to $_taker>>
				<<countBrokenVows $_taker>>
				<<set $speechTempleVirgin to 1>>
			<</if>>
			<<run if (!V.statFreeze && typeof setup !== "undefined" && typeof setup.xChangeRecordActiveBodyVirginity === "function") setup.xChangeRecordActiveBodyVirginity()>>
		<</if>>
	<</if>>
<</widget>>

<<widget "awardVirginityFeat">>
	<<switch _args[0]>>
		<<case "Robin">><<earnFeat "Robin the Lover">>
		<<case "Kylar">><<earnFeat "Kylar the Obsessed">>
		<<case "Eden">><<earnFeat "Eden the Lonely">>
		<<case "Whitney">><<earnFeat "Whitney the Tsundere">>
		<<case "Avery">><<earnFeat "Avery the Moneybags">>
		<<case "Leighton">><<earnFeat "Leighton the Shady">>
		<<case "Alex">><<earnFeat "Alex the Robust">>
		<<case "Great Hawk">><<earnFeat "Great Hawk the Terror">><<earnFeat "Mate for life">>
		<<case "Wren">><<earnFeat "Wren the Sly">>
		<<case "Black Wolf">><<earnFeat "Great Wolf the Alpha">>
		<<case "Harper">><<earnFeat "Harper the Hypnotist">>
		<<case "Morgan">><<earnFeat "Morgan the Lost">>
		<<case "Gwylan">><<earnFeat "Gwylan the Bewitching">>
		<<case "Bailey">><<earnFeat "Bailey the 'caretaker'">>
		<<case "Zephyr">><<earnFeat "Zephyr the captain">>
		<<case "Poppy">><<earnFeat "Poppy's Jewel">>
	<</switch>>
<</widget>>

<<widget "takeTempleVirginity">>
	<<if _args[1]>>
		<<if _args[1] is "penile" and playerHasStrapon()>>
			<!-- Do nothing -->
		<<else>>
			<<run _trueBodyOK = typeof playerInTemporaryXChangeBody === "function" ? !playerInTemporaryXChangeBody() : true; >>
			<<set _templeLostThisTurn to (_args[1] is "vaginal" and _vaginalLostThisTurn)>>
			<<if _templeLostThisTurn and $player.virginity.temple and $player.virginity.temple isnot true and $player.virginity.temple isnot 1 and $templePromised isnot _args[0] and _args[0] isnot undefined and _args[0] isnot 0 and _trueBodyOK>>
				<<set _previousTempleTaker to $player.virginity.temple>>
				<<set _previousTempleTakerText to _previousTempleTaker ? String(_previousTempleTaker) : "">>
				<<if !_templeTakersThisTurn>>
					<<set _templeTakersThisTurn to {}>>
				<</if>>
				<<if !_templeTakersThisTurn[_args[1]]>>
					<<set _templeTakersThisTurn[_args[1]] to _previousTempleTakerText ? [_previousTempleTakerText] : []>>
				<</if>>
				<<set _alreadyTempleCredited to _templeTakersThisTurn[_args[1]].includes(_args[0])>>
				<<if !_alreadyTempleCredited>>
					<<set $player.virginity.temple to `${_previousTempleTakerText} and ${_args[0]}`>>
					<<run _templeTakersThisTurn[_args[1]].push(_args[0])>>
				<</if>>
			<</if>>
			<<if ($player.virginity.temple is true or $player.virginity.temple is 1)
				and (_args[1] is "vaginal" or _args[1] is "penile")
				and $templePromised isnot _args[0]
				and _trueBodyOK>>
				<<set $virginityProtected to false>>
				<<set $player.virginity.temple to _args[0]>>
				<<countBrokenVows _args[0]>>
				<<set $speechTempleVirgin to 1>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "takeHandholdingVirginity">>
	<<if typeof _args[0] === 'string' or _args[0] instanceof String>>
		<<set $_fullDescription to _args[0]>>
		<<if C.npc[_args[0]]>>
			<<set $_type to C.npc[_args[0]].type>>
		<<else>>
			<<set $_type to _args[2]>>
		<</if>>
	<<else>>
		<<set $_fullDescription to _args[0].fullDescription>>
		<<set $_type to _args[0].type>>
	<</if>>
	<!-- Read $_type here: nested widgets below reuse the name. Silly pregnancy mode only, a no-op otherwise. -->
	<<sillyInseminate "hand" $_fullDescription $_type>>

	<<switch _args[1]>>
		<<case "romantic" "consensual">>
			<<set _npcConsensualOverride to true>>
		<<case "rape">>
			<<set _npcConsensualOverride to true>>
	<</switch>>
	<<takeNPCVirginity $_fullDescription "handholding" "pc">>
	<<unset _npcConsensualOverride>>

	<<set $_handsCovered to /glove|mitten/.test($worn.hands.name)>>

	<<if $player.virginity.handholding is true>>
		<<switch _args[1]>>
			<<case "romantic">>
				<span class="lewd">이런 낭만적인 손잡기에는 익숙하지 않다.</span><<arousal 2000>><<ggarousal>>
				<<set _consensualOverride to true>>
			<<case "rape">>
				<span class="red">강제로 손이 잡힌 상태라 끔찍한 기분이 든다.</span><<stress 40>><<ggstress>>
				<<set _consensualOverride to false>>
			<<case "consensual">>
				<span class="green">손을 잡히니 기분이 좋다.</span><<lltrauma>><<trauma -18>>
				<<set _consensualOverride to true>>
			<<case "tentacle">>
				<<set $_handTentacle to _args[2] or "tentacle">>
				<span class="lewd">$_handTentacle【이가】 당신의 손을 잡았다는 말을 다른 사람들이 믿어주기나 할지, 또 뭐라고 할지 궁금해진다.</span><<arousal 1000>>
			<<default>>
				<<if $_fullDescription is "Bailey">>
					<<baileyHandholdText false>>
				<<else>>
					<span class="blue">친하지 않은 사람과 손을 잡자니 긴장된다.</span><<stress 20>><<gstress>>
				<</if>>
		<</switch>>
		<<if _args[3]>><br><br><</if>>
		<<if $_handsCovered>>
			<span class="blue">$worn.hands.name【을를】 끼고 있어서 상대의 피부가 제대로 느껴지지 않는다. 첫 경험으로 치지 않는다.</span>
		<<else>>
			<<takeVirginity $_fullDescription "handholding">>
			<<if $innocencestate is 1>>
				<br><br><span class="red">잠깐... 손을 잡으면 아기가 생기는 거 아니었나? 공황이 파도처럼 밀려온다.</span><<stress 25>><<gstress>>
			<</if>>
		<</if>>
	<</if>>
	<<if !$combat>><<fetishPregnancyImg>><</if>>
<</widget>>

