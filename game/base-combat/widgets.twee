			당신의 $worn.vaginal_dildo.name【이가】 <<pussy>>에서 밀려 나와 바닥에 덜커덕 떨어진다. <span class="lewd">기계가 들어올 자리가 비워진다.</span>
		<<elseif $vaginause is "tentacle">>
			촉수가 당신의 $worn.vaginal_dildo.name【을를】 휘감더니 <span class="lewd"><<pussy>>에서 잡아 빼 옆으로 던져버린다.</span>
		<<else>>
			당신의 $worn.vaginal_dildo.name【이가】 <<pussy>>에서 홱 뽑혀 옆으로 내던져진다. <span class="lewd">당신은 벌어진 채 그대로 드러난다.</span>
		<</if>>
		<br><br>
	<</if>>
<</widget>>

<<widget "pickupSexToy">>
	<<if $consensual is 1 and hasSexStat("promiscuity", 3) and $enemytype is "man">>
		<<set $_hand to _args[0]>>
		<<set $_items to window.listUniqueCarriedSextoys()>>

		<<if $_hand is "left" and ($lefttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
			<<if $_items.length gt 0>>
				<<set _itemsLeft to {}>>

				<<run $_items.forEach(item => {
					if (($currentSexToyRight === undefined || item.name !== $currentSexToyRight.name) && item.type.includesAny("dildo", "stroker") && !item.worn) {
						_itemsLeft[item.namecap] = item;
					}
				})>>
				<<if Object.keys(_itemsLeft).length gte 1>>
					<<set _leftaction["장난감 잡기"] to "pickupSexToy">>
				<</if>>
			<</if>>
		<</if>>

		<<if $_hand is "right" and ($righttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
			<<if $_items>>
				<<set _itemsRight to {}>>

				<<run $_items.forEach(item => {
					if (($currentSexToyLeft === undefined || item.name !== $currentSexToyLeft.name) && item.type.includesAny("dildo", "stroker") && !item.worn) {
						_itemsRight[item.namecap] = item;
					}
				})>>
				<<if Object.keys(_itemsRight).length gte 1>>
					<<set _rightaction["장난감 잡기"] to "pickupSexToy">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "andButtPlug">><<silently>>
	<<set _text_output to (playerHasButtPlug() ? " 【와과】 $worn.butt_plug.name" : "")>>
<</silently>><<print _text_output>><</widget>>
<<widget "alongsideButtPlug">><<silently>>
    <<set $_alongside to either("곁에서", "아랑곳하지 않고", "옆으로 밀어내며")>>
    <<set _text_output to (playerHasButtPlug() ? ", " + $_alongside + " 당신의 " + $worn.butt_plug.name : "")>>
<</silently>><<print _text_output>><</widget>>

<<widget "combatExtendedCheck">>
	<<set _dodgeChance to 0>>
	<<set _passiveDodgeSuccess to 0>>
	<<set _activeDodgeSuccess to 0>>
	<<set _counterChance to 0>>
	<<set _counterSuccess to 0>>
	<<set _check1 to 100>>
	<<set _activeDodgeTargetMatches to _args[0] is $combatExtended.activeDodgingTarget>>
	<<set $combatExtended.counterSuccess to 0>>
	<<set $combatExtended.dodgeSuccess to 0>>
	<<if $combatExtended.enemyFeinting is 1 and random(100) gte 33>>
		<<set _check1 += 50>>
	<</if>>
	<<set _check2 to _check1 * 0.8>>
	<<set _dancedodge to Math.round(currentSkillValue('danceskill') / 40)>>
	/* Frames between the standard steps used to fall through this ladder's exact-match branches and collect the tiny-body bonus */
	<<set _bodyDodgeChance to bodySizeDodgeModifier()>>
	<<if $combatExtended.brawlingToggle is 1>>
		<<set _brawlingDodgeChance to (combatExtendedSkillValue('brawling') * $enemyno * ($enemyno / 16)) / 100>>
	<<else>>
		<<set _brawlingDodgeChance to 0>>
	<</if>>
	/* Mastery traits. See masteryDodgeBonus() in mastery-traits.js. */
	<<set _masteryDodgeChance to masteryDodgeBonus()>>
	/* Keen ears */
	<<if $stalk and effectiveTransformationLevel("cat") gte 6 and $NPCList[0] and ["Eden", "Gwylan", "Black Wolf"].includes($NPCList[0].fullDescription)>>
		<<set _masteryDodgeChance += 8>>
	<</if>>
	/* A cat sith's ill omen */
	<<if $illOmen is 2>>
		/* A combat processor corrects for part of the bad luck. */
		<<set _masteryDodgeChance += (setup.arcology.cyberAny("processor") ? 5 : 10)>>
	<</if>>
	/* Small bodies evade, large bodies tank. See bodySizeDodgeCaps() in koztools.js. */
	<<set _sizeDodgeCaps to bodySizeDodgeCaps()>>
	<<if $combatExtended.passiveDodging is 1>>
		<<set _dodgeChance = Math.round(_dancedodge + _bodyDodgeChance + _brawlingDodgeChance + _masteryDodgeChance)>>
		/* High combat stats should remain valuable without making incoming attacks automatic misses. */
		<<if _dodgeChance gt _sizeDodgeCaps.soft>>
			<<set _dodgeChance to Math.round(_sizeDodgeCaps.soft + ((_dodgeChance - _sizeDodgeCaps.soft) * 0.25))>>
		<</if>>
		<<if $combatExtended.uncappedDodgeChance is 0>>
			<<set _dodgeChance to Math.clamp(_dodgeChance, 0, Math.min($combatExtended.dodgeChanceCap, _sizeDodgeCaps.hard))>>
		<</if>>
		<<if $combatExtended.stabilityLost is 1>>
			<<set _dodgeChance = Math.round(_dodgeChance / 2)>>
		<</if>>
		<<if _dodgeChance gte random(_check1)>>
			<<set _passiveDodgeSuccess to 2>>
		<<elseif _dodgeChance gte random(_check2)>>
			<<set _passiveDodgeSuccess to 1>>
		<<else>>
			<<set _passiveDodgeSuccess to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.activeDodgingActive is 1 and _activeDodgeTargetMatches>>
		<<set _dodgeChance = Math.round((_dancedodge + _bodyDodgeChance + _brawlingDodgeChance + _masteryDodgeChance) * 2)>>
		<<if _dodgeChance gt _sizeDodgeCaps.soft>>
			<<set _dodgeChance to Math.round(_sizeDodgeCaps.soft + ((_dodgeChance - _sizeDodgeCaps.soft) * 0.25))>>
		<</if>>
		<<if $combatExtended.uncappedDodgeChance is 0>>
			<<set _dodgeChance to Math.clamp(_dodgeChance, 0, Math.min($combatExtended.dodgeChanceCap, _sizeDodgeCaps.hard))>>
		<</if>>
		<<if $combatExtended.stabilityLost is 1>>
			<<set _dodgeChance = Math.round(_dodgeChance / 2)>>
		<</if>>
		<<if _dodgeChance gte random(_check1)>>
			<<set _activeDodgeSuccess to 2>>
		<<elseif _dodgeChance gte random(_check2)>>
			<<set _activeDodgeSuccess to 1>>
		<<else>>
			<<set _activeDodgeSuccess to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.countering is 1>>
		/* Countering is limited to one attack per guarding hand each turn. Attacks beyond that fall through to dodging. */
		<<if $combatExtended.counteringActive gte 1 and ($combatExtended.counterCharges ?? 0) gte 1>>
			<<set _counterChance to 100 * ((0.25 * (1 * ($skulduggery / 1000))) * $combatExtended.counteringActive)>>
			<<if $combatExtended.stabilityLost is 1>>
				<<set _counterChance = Math.round(_counterChance / 2)>>
			<</if>>
			/* Facing a crowd, there is less room to read and turn a single attacker's blow. */
			<<if $enemyno gte 2>>
				<<set _counterChance to Math.round(_counterChance * Math.max(0.4, 1 - (0.15 * ($enemyno - 1))))>>
			<</if>>
			/* Light frames turn a blow more readily than heavy ones */
			<<set _counterChance to _counterChance * bodySizeCounterMultiplier()>>
			<<if _counterChance gte random(_check1)>>
				<<set _counterSuccess to 2>>
			<<elseif _counterChance gte random(_check2)>>
				<<set _counterSuccess to 1>>
			<<else>>
				<<set _counterSuccess to 0>>
			<</if>>
		<</if>>
	<</if>>
	<<if $suffocated is undefined and $willpowerpain is undefined and $orgasmdown lte 0 and $trance lte 0 and $panicparalysis is 0 and $panicviolence is 0 and $dissociation lte 1>>
		<<set $combatExtended.counterSuccess to _counterSuccess>>
		<<if _counterSuccess gte 1>>
			<<set $combatExtended.counterCharges to Math.max(0, ($combatExtended.counterCharges ?? 0) - 1)>>
		<</if>>
		<<if _passiveDodgeSuccess gt _activeDodgeSuccess>>
			<<set $combatExtended.dodgeSuccess to _passiveDodgeSuccess>>
		<<else>>
			<<set $combatExtended.dodgeSuccess to _activeDodgeSuccess>>
		<</if>>
	<</if>>
<</widget>>

<<widget "combatExtendedStability">>
	<<set _tmp to _args[0]>>
	<<if $combatExtended.footworkToggle is 1 and _tmp lt 0>>
		<<if _tmp lte 0>>
			<<set _tmp to _tmp * (1 - (0.8 * (combatExtendedSkillValue('footwork') / 2000)))>>
		<<else>>
			<<set _tmp to _tmp * (1 + (0.8 * (combatExtendedSkillValue('footwork') / 2000)))>>
		<</if>>
	<</if>>
	<<set $combatExtended.stability to Math.clamp($combatExtended.stability + _tmp, 0 , 100)>>
<</widget>>

<<widget "combatExtendedEnemyCheck">>
	/* Island fighters: working implants and any technique they primed last turn. Unchanged for everyone else. */
	<<run setup.arcology.noteAttack(_args[0], $kicking is 1 ? "kick" : $combatExtended.hookpunchingActive gte 1 ? "hook" : "strike")>>
	<<if $combatExtended.feinting is 1 and $combatExtended.feintingActive gte 1 and setup.arcology.breakFocus(_args[0])>><<set _cyberFocusBroken to _args[0]>><</if>>
	<<set _dodgeChance to setup.arcology.turnDodge(_args[0], $NPCList[_args[0]].dodgeChance)>>
	<<set _passiveEnemyDodge to 0>>
	<<set _activeEnemyDodge to 0>>
	<<set _enemyCounter to 0>>
	<<set _check1 to 100>>
	<<set $enemyCEActions to []>>
	<<if $combatExtended.enemyActiveDodging is 1>>
		<<run $enemyCEActions.push("dodge")>>
		<<if $enemyanger lt 100>>
			<<run $enemyCEActions.push("nothing")>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyBlocking is 1>>
		<<run $enemyCEActions.push("block")>>
		<<if $enemyanger lt 100>>
			<<run $enemyCEActions.push("nothing")>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyCountering is 1>>
		<<run $enemyCEActions.push("counter")>>
		<<if $enemyanger lt 100>>
			<<run $enemyCEActions.push("nothing")>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyMartialArts is 1 and $combatExtended.enemyMartialArtsBadass is 1>>
		<<set _j to Math.floor($NPCList[_args[0]].martialArts / 500) + 1>>
	<<else>>
		<<set _j to 1>>
	<</if>>
	<<for _i to 0; _i lt _j; _i++>>
		<<if $enemyCEActions[Math.floor(Math.random() * $enemyCEActions.length)] is "dodge">>
			<<set _dodgeChance *= 2>>
			<<set $combatExtended.enemyActiveDodgingActive to 1>>
			<<run $enemyCEActions.filter(item => item !== "dodge")>>
		<</if>>
		<<if $enemyCEActions[Math.floor(Math.random() * $enemyCEActions.length)] is "block">>
			<<set $combatExtended.enemyBlockingActive to 1>>
			<<run $enemyCEActions.filter(item => item !== "block")>>
		<</if>>
		<<if $enemyCEActions[Math.floor(Math.random() * $enemyCEActions.length)] is "counter">>
			<<set $combatExtended.enemyCounteringActive to 1>>
			<<run $enemyCEActions.filter(item => item !== "counter")>>
		<</if>>
	<</for>>
	/* Reinforced arms are raised to block far more readily. */
	<<if $combatExtended.enemyBlocking is 1 and $combatExtended.enemyBlockingActive isnot 1 and setup.arcology.cyberHas(_args[0], "limbs") and random(1, 100) lte 30>>
		<<set $combatExtended.enemyBlockingActive to 1>>
	<</if>>
	<<set _test2 to _dodgeChance>>
	<<set _check2 to _check1 * 0.8>>
	<<if $combatExtended.feinting is 1 and $combatExtended.feintingActive gte 1>>
		<<set _dodgeChanceReduction to Math.round($skulduggery / 100)>>
		<<if $combatExtended.stabilityLost is 1>>
			<<set _dodgeChanceReduction to _dodgeChanceReduction / 4>>
		<</if>>
		/* Synthetic eyes track the real movement, so a feint buys half as much. */
		<<if setup.arcology.cyberHas(_args[0], "vision")>>
			<<set _dodgeChanceReduction to _dodgeChanceReduction / 2>>
			<<if setup.arcology.cyberPart(_args[0], "vision")>><<run setup.arcology.cyberNote(_args[0], "feint")>><</if>>
		<</if>>
		<<if $combatExtended.feintingActive is 2>>
			<<set _dodgeChance -= _dodgeChanceReduction * 3>>
		<<else>>
			<<set _dodgeChance -= _dodgeChanceReduction>>
		<</if>>
	<</if>>
	<<if $combatExtended.hookpunching is 1 and $combatExtended.hookpunchingActive gte 1>>
		<<if $combatExtended.hookpunchingActive is 2>>
			<<set _dodgeChance += 30>>
		<<else>>
			<<set _dodgeChance += 10>>
		<</if>>
	<</if>>
	<<if $combatExtended.strikingToggle is 1 and $striking is 1>>
		<<set _dodgeChance -= Math.round(combatExtendedSkillValue('striking') / 10)>>
	<</if>>
	<<if $combatExtended.kickingToggle is 1 and $kicking is 1>>
		<<set _dodgeChance -= Math.round(combatExtendedSkillValue('kicking') / 10)>>
	<</if>>
	/* Island fighters' training and implants keep part of their dodge however well the player reads them. */
	<<set _dodgeChance to Math.max(_dodgeChance, setup.arcology.dodgeFloor(_args[0]))>>
	<<set _test1 to _dodgeChance>>
	<<if $combatExtended.enemyPassiveDodging is 1>>
		<<if _dodgeChance gte random(_check1)>>
			<<set _passiveEnemyDodge to 2>>
		<<elseif _dodgeChance gte random(_check2)>>
			<<set _passiveEnemyDodge to 1>>
		<<else>>
			<<set _passiveEnemyDodge to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyActiveDodgingActive is 1>>
		<<if _dodgeChance gte random(_check1)>>
			<<set _activeEnemyDodge to 2>>
		<<elseif _dodgeChance gte random(_check2)>>
			<<set _activeEnemyDodge to 1>>
		<<else>>
			<<set _activeEnemyDodge to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyCounteringActive is 1>>
		/* A combat processor reads the opening sooner, making counters more likely. */
		<<set _check1 += (setup.arcology.cyberHas(_args[0], "processor") ? 25 : 50)>>
		<<set _check1 to setup.arcology.turnCounterCheck(_args[0], _check1)>>
		<<set _check2 to _check1 * 0.8>>
		<<if _dodgeChance gte random(_check1)>>
			<<set _enemyCounter to 2>>
		<<elseif _dodgeChance gte random(_check2)>>
			<<set _enemyCounter to 1>>
		<<else>>
			<<set _enemyCounter to 0>>
		<</if>>
	<</if>>
	<<set $combatExtended.enemyCounterSuccess to _enemyCounter>>
	<<if _passiveEnemyDodge gt _activeEnemyDodge>>
		<<set $combatExtended.enemyDodgeSuccess to _passiveEnemyDodge>>
	<<else>>
		<<set $combatExtended.enemyDodgeSuccess to _activeEnemyDodge>>
	<</if>>
	<<if $combatExtended.enemyCounterSuccess gte 1 and setup.arcology.cyberHas(_args[0], "processor")>>
		<<run setup.arcology.cyberNote(_args[0], "counter")>>
	<<elseif $combatExtended.enemyDodgeSuccess gte 1 and setup.arcology.cyberPart(_args[0], "vision")>>
		<<run setup.arcology.cyberNote(_args[0], "dodge")>>
	<</if>>
	<<if $combatExtended.enemyCounterSuccess is 2 or $combatExtended.enemyDodgeSuccess is 2>>
		<<set $combatExtended.enemyBlockingActive to 0>>
		<<set $striking to 0>>
		<<set $kicking to 0>>
	<</if>>
<</widget>>

<<widget "reverseRapeCheck">>
	<<if $combat is 1 and $combatExtended.reverseRape is 1 and $combatExtended.reverseRapeEnd is 0 and (hasSexStat("promiscuity", 5) or $backgroundTraits.includes("delinquent")) and $enemyhealth lte 0 and $combatExtended.reverseRapeStart is 0 and $combatExtended.reverseRapeInit is 1>>
		<<set $combatExtended.reverseRapeStart to 1>>
		<<set $combatExtended.stability to -100>>
		<<consensual>>
		<<set $consensual to 1>>
		<<reversenpcidlegenitals>>
		<<npc_submissive_multiple>>
		<<set $setupMidOrgasm to true>>
	<</if>>
<</widget>>

<<widget "healthMultiplier">>
	<<if $NPCList[0] and $NPCList[0].health isnot undefined and $NPCList[0].health gt $enemyhealth>>
		<<set $enemyhealth to $NPCList[0].health>>
	<</if>>
	<<set _buff to 0>>
	<<if $enemytype is "beast">>
		<<set $enemyhealth to Math.round($enemyhealth * ($beastHealthMult / 100))>>
	<<elseif $NPCList[0] and setup.NPCNameList.includes($NPCList[0].fullDescription)>>
		<<set $enemyhealth to Math.round($enemyhealth * ($nnpcHealthMult / 100))>>
	<<else>>
		<<set $enemyhealth to Math.round($enemyhealth * ($npcHealthMult / 100))>>
	<</if>>
	<<set _buffAmount to Math.floor(Time.days / $combatExtended.enemyDayScaling)>>
	<<if $combatExtended.enemyHealthDayScaling is 1>>
		<<if _buffAmount lte $combatExtended.enemyDayScalingLimit or $combatExtended.enemyInfiniteDayScaling is 1>>
			<<set _buff += _buffAmount * $combatExtended.enemyHealthDayScalingMult>>
		<<else>>
			<<set _buff += _buffAmount * $combatExtended.enemyDayScalingLimit>>
		<</if>>
	<</if>>
	<<set _buffAmount to Math.floor($enemiesDefeatedStat / $combatExtended.enemyDefeatScaling)>>
	<<if $combatExtended.enemyHealthDefeatScaling is 1>>
		<<if _buffAmount lte $combatExtended.enemyDefeatScalingLimit or $combatExtended.enemyInfiniteDefeatScaling is 1>>
			<<set _buff += _buffAmount * $combatExtended.enemyHealthDefeatScalingMult>>
		<<else>>
			<<set _buff += _buffAmount * $combatExtended.enemyDefeatScalingLimit>>
		<</if>>
	<</if>>
	/* Enemy HP scaling: robust against corrupted _buff and won't "lock" max to tiny values */
	<<set _enemyHPBuff to Number(_buff)>>

	/* If _buff is corrupted or insane, treat it as 0 (no buff) */
	<<if !Number.isFinite(_enemyHPBuff) or _enemyHPBuff lt -50 or _enemyHPBuff gt 500>>
		<<set _enemyHPBuff to 0>>
	<</if>>

	/* Apply scaling once to current enemyhealth */
	<<set $enemyhealth to Math.max(1, Math.round($enemyhealth * (1 + (_enemyHPBuff / 100))))>>

	<<set _eh to Number($enemyhealth)>>
	<<set _ehm to Number($enemyhealthmax)>>
	<<set _pehm to Number($permenemyhealthmax)>>

	<<if !Number.isFinite(_ehm) or _ehm lt 1>>
		<<set $enemyhealthmax to _eh>>
	<<else>>
		<<set $enemyhealthmax to Math.max(_ehm, _eh)>>
	<</if>>

	<<if !Number.isFinite(_pehm) or _pehm lt 1>>
		<<set $permenemyhealthmax to $enemyhealthmax>>
	<<else>>
		<<set $permenemyhealthmax to Math.max(_pehm, $enemyhealthmax)>>
	<</if>>
<</widget>>

/*
Gate added: a romance partner only robs you when angry or in pain.
- _args[0] (optional): NPC name to check. If omitted, auto-detects the active named combat NPC via $NPCList[0].fullDescription.
- A romance partner who is calm ($enemyanger lte 0) will NOT steal.
	Health-vs-max is deliberately NOT used: $enemyhealthmax persists and only ratchets UP across fights (see combatstart: Math.max(_ehm, _eh)), so a full-health NPC can falsely read as "hurt" and silently re-enable the steal.
	Fighting an NPC raises $enemyanger, so anger alone already covers both "angry" and "in pain".
- Partner detection uses isPossibleLoveInterest(), NOT isLoveInterest().
	isLoveInterest() only sees NPCs the player manually assigned to a $loveInterest slot (awareness-gated), so a romanced-but-unassigned partner (e.g. $whitneyromance is 1) fell through and kept robbing you.
	isPossibleLoveInterest() reads the per-NPC romance flags directly, which is the real relationship.
- The Kylar abduction is an unconditional block, NOT anger-gated. Combat $enemyanger climbs during the abduction rape (the scene involves struggling), but Kylar's obsessive "love" is the whole premise there, robbing you makes no sense regardless of the anger meter.
	isPossibleLoveInterest("Kylar") can also miss it (it needs kylarenglish gte 1), so the passage check is the authoritative signal for this arc.
- Strangers/unnamed attackers, and any angry non-abduction partner, steal as before.

The surrounding scene wording is untouched; only the pocket-rifling + money transfer below are suppressed when blocked.
*/
<<widget "npcStealMoney">>
	/* Name-list fallback: combat code uses setup.NPCNameList, other code uses $NPCNameList */
	<<set _nameList to (setup.NPCNameList ? setup.NPCNameList : ($NPCNameList ? $NPCNameList : []))>>
	<<set _stealNpc to (_args[0] isnot undefined ? _args[0] : (($NPCList[0] and _nameList.includes($NPCList[0].fullDescription)) ? $NPCList[0].fullDescription : undefined))>>
	/* typeof guard so a renamed/missing isPossibleLoveInterest can't throw and abort the widget */
	<<set _stealLoveInterest to (_stealNpc isnot undefined and _nameList.includes(_stealNpc) and typeof isPossibleLoveInterest is "function" and isPossibleLoveInterest(_stealNpc))>>
	/* undefined/NaN anger counts as calm (0); avoids JS quirk where undefined lte 0 is false */
	<<set _stealAnger to (Number.isFinite(Number($enemyanger)) ? Number($enemyanger) : 0)>>
	<<set _stealKylarAbduction to (passage().includes("Kylar Abduction"))>>
	/* Abduction blocks unconditionally; every other partner only when calm (anger lte 0). */
	<<set _stealBlocked to (_stealKylarAbduction or (_stealLoveInterest and _stealAnger lte 0))>>
	<<if $npcStealMoneyToggle is 1 and $npcStolenMoney is undefined and _stealBlocked is false>>
		<br>
		<<set _stolenMoney to setup.hbsc.stolenCashAmount()>>
		<<He>>【이가】 당신의 주머니를 뒤져 <<printmoney _stolenMoney>>【을를】 가져간다.
		<<if _stolenMoney gte 100000>>
			"돈이 꽤 많네. 이건 내가 가져갈게, 고마워."
		<<elseif _stolenMoney gte 50000>>
			"나쁘지 않네, 아주 나쁘지 않아."
		<<elseif _stolenMoney gte 10000>>
			"헤, 이 정도면 수고한 보람이 있지."
		<<elseif _stolenMoney gte 5000>>
			"가진 게 이게 다야?"
		<<else>>
			"이건 푼돈이잖아..."
		<</if>>
		<<set _stolenMoney to _stolenMoney * -1>>
		<<money _stolenMoney "stolenMoney">>
		<<if setup.hbsc.stealCard()>>
			<br><span class="red"><<He>>【은는】 당신의 은행 카드까지 가져간다.</span> 누가 쓰기 전에 HBSC에 신고해야 한다.
		<</if>>
		<<set $npcStolenMoney to 1>>
	<</if>>
<</widget>>

<<widget "struggle_defense_init">>
	<<if _args[0] is "guard">>
		<<if currentSkillValue("handskill") gte 800>>
			당신은 타이밍을 맞춰 타격을 가해 그 기세를 꺾고
		<<elseif currentSkillValue("handskill") gte 200>>
			당신은 그것을 옆으로 쳐내고
		<<else>>
			당신의 발버둥에 그것이 옆으로 나가떨어지며
		<</if>>
	<<elseif _args[0] is "dodge">>
		<<set $dodging -= 1>>
		<<if effectiveDrunk() gte 60>>
			당신은 술에 취해 비틀거리며 길을 피한다<<if !random(100)>>. 마치 취권의 달인처럼<</if>>.
		<<elseif currentSkillValue("feetskill") gte 800 or currentSkillValue('danceskill') gte 400>>
			당신은 춤추듯 옆으로 피한다.
		<<elseif currentSkillValue("feetskill") gte 200>>
			당신은 옆으로 비켜선다.
		<<else>>
			당신은 비틀거리며 피한다.
		<</if>>
	<</if>>
<</widget>>

<<widget "struggle_defense_result">>
	<<if _args[0] is "guard">>
		<<if _left_guard_chance gte _hit_chance>>
			<<unset $left_guard>>
		<<elseif _right_guard_chance gte _hit_chance>>
			<<unset $right_guard>>
		<</if>>
		<<if $struggle.enemy[_i].health gt 0>>
			<span class="teal">그것은 다쳤다. </span>
		<<else>>
			<span class="green">그것은 너무 심하게 다쳤다. </span>
		<</if>>
	<<elseif _args[0] is "dodge">>
		<<if $struggle.enemy[_i].dodge is undefined>>
			<<set $struggle.enemy[_i].dodge to 1>>
		<<elseif $struggle.enemy[_i].dodge lt 3>>
			<<set $struggle.enemy[_i].dodge ++>>
		<<else>>
			<<set $struggle.enemy[_i].dodge to 0>>
			<<set $struggle.enemy[_i].health -= 1>>
			<<if $struggle.enemy[_i].health gt 0>>
				<span class="teal">그것은 지쳐 가고 있다. </span>
			<<else>>
				<span class="green">그것은 완전히 지쳐 쓰러졌다. </span>
			<</if>>
		<</if>>
	<</if>>
	<<if $struggle.enemy[_i].health lte 0>>
		<span class="green">돌아오지 않을 것이다.</span>
		<<set $struggle.done += 1>>
		<<set $struggle.enemy[_i].location to "fled">>
	<</if>>
	<<unset _struggleDefenseResult>>
<</widget>>
