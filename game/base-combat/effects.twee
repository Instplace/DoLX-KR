							<</if>>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<actionshookpunch $righttarget>>

				/* Null-safe ring helpers (prevents crashes if worn.rings is missing/malformed) */
				<<set _ringsName to (($worn.rings && typeof $worn.rings.name === "string") ? $worn.rings.name : "")>>
				<<set _ringsType to (($worn.rings && typeof $worn.rings.type === "string") ? $worn.rings.type : "")>>
				<<set _ringsAltPos to (($worn.rings && typeof $worn.rings.altposition === "string") ? $worn.rings.altposition : "")>>

				<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
