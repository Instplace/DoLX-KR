<<widget "useLube">>
	<<set $_lube to window.listUniqueCarriedSextoys().find(item => item.type.includes("lube"))>>
	<<if $_lube>>
		<<if $_lube.uses is undefined or Number.isNaN($_lube.uses)>>
			<<set $_lube.uses to setup.sextoys.find(toy => toy.name === $_lube.name)?.uses || 3>>
		<</if>>
		<<set $_lube.uses -= 1>>
		<<if $debug is 1>><<run console.log("using lube? " + $_lube.name + " " + $_lube.uses)>><</if>>
		<<if $_lube.uses lte 0>>
			<<run V.player.inventory.sextoys[$_lube.name].splice(V.player.inventory.sextoys[$_lube.name].indexOf($_lube), 1)>>
