				<<He_Short>>【이가】 유혹적으로 웃는다.
				<<if $NPCList[$_target].lefthand is 0 or $NPCList[$_target].righthand is 0>>
					<span class="red">"쉿, 얌전히 조용히 해, <<pcpetname "Gwylan" "my">>."</span>
				<<else>>
					<span class="red">"이제 입 다물어, <<pcpetname "Gwylan" "my">>, 안 그러면 정반대로 해버릴 테니까."</span>
				<</if>>
			<<else>>
				<<He>>【은는】 대답하기 전 잠시 뜸을 들인다. <span class="red">"멍청한 걸레년, 네가 <<if $enemyno gte 2>>우리한테<<else>>나한테<</if>> 이래라저래라 할 수 있을 것 같아?"</span>
			<</if>>
		<<case "askPullOut">>
			<<if $NPCList[$mouthtarget].fullDescription is "Gwylan">>
				<<He_Short>>【이가】 낄낄거린다. <span class="red">"그럴 순 없어, 얘야. 날 용서하렴."</span>
			<<else>>
				<<set _response to [
					"멍청한 걸레년, 네가 나한테 이래라저래라 할 수 있을 것 같아?",
					"여기선 네가 나설 자리가 아니야, 걸레년아.",
					"내 마음대로 할 거야, 걸레년아."
				]>>
				<<if $settings.pregnancySpeechEnabled and $NPCList[$mouthtarget].penis is "vagina" and playerPregnancyPossibleWith($NPCList[$mouthtarget])>>
					<<run _response.pushUnique(
						"내가 널 임신시켜 주면 운 좋게 생각해야지.",
						"차라리 지금 네 안에 내 애를 만들어 줘야겠어.",
						"내가 강제로 널 임신시켜도 넌 손가락 하나 까딱 못 할걸."
					)>>
				<</if>>
				<<He_Short>>【은는】 대답하기 전 잠시 뜸을 들인다,
				<span class="red">"<<print _response.pluck()>>"</span>
			<</if>>
		<<default>>
			<<if $NPCList[$_target].type is "plant">>
				<<He>>【이가】 코웃음 친다. <span class="red">"장난해? 그게 제일 재밌는 부분인데!"</span>
			<<elseif $NPCList[$_target].fullDescription is "Gwylan">>
				<<He_Short>>【이가】 유혹적으로 웃는다. <span class="red">"하던 거 마저 하게 해줘, 자기야."</span>
			<<else>>
				<<He>>【은는】 대답하기 전 잠시 뜸을 들인다. <span class="red">"멍청한 걸레년, 네가 <<if $enemyno gte 2>>우리한테<<else>>나한테<</if>> 이래라저래라 할 수 있을 것 같아?"</span>
			<</if>>
	<</switch>>
	<<if $consensual is 1>>
		<<set $consensual to 0>>
		<<molested>><<controlloss>>
	<</if>>
<</widget>>
