			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
				
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2 and $gamemode isnot "soft">>
				<<wheeze "<<him>>에게 그만하고 싶다고 말한다">>
			<<else>>
				<<willpowercombatcheck>>
				<<if $willpowerSuccess and !$xchange.heat.bypassAsk>>
					<<set $mouthactiondefault to "rest">><<brat 10>>
					당신은 <<him>>에게 이제 질렸으니 그만하고 싶다고 말한다.
					<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
						<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 그것을 <<if $enemyno gte 2>>무시한다<<else>>무시한다<</if>>.
					<<elseif !$loveDrunk and $NPCList[0].type isnot "plant" and combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription) or $gamemode is "soft" or $gloryhole>>
						<<set $finish to 1>>
						<<if $trueconsensual isnot 1 and $gamemode is "soft">>
							<<set $enemyhealth to -100>>
						<</if>>
						<<if $enemytype is "man" or $monster is 1>>
							<<if $enemyno gte 2>>그들은 실망한 표정을 짓지만<<else>><<He>>【은는】 실망한 표정을 짓지만<</if>>, <span class="green">요구를 따른다.</span>
						<<else>>
							말을 할 순 없지만, <span class="green">당신의 뉘앙스를 알아채고 물러난다.</span>
						<</if>>
						<<if $gamemode is "soft">>
							<<set $enemyhealth to -1000>>
						<</if>>
					<<else>>
						<<set $consensual to 0>>
						<<switch $enemytype>>
							<<case "plant">>
								<span class="red"><<He>>【은는】 기분 좋게 고개를 젓는다.</span>
							<<case "beast">>
								<<if $settings.pregnancySpeechEnabled>>임신시키고<<else>>박고<</if>> 싶은 마음에 안달이 나서, <span class="red"><<bhe>>【은는】 당신의 말을 무시한다.</span>
							<<default>>
								<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 거절한다!</span>
						<</switch>>
						<<molested>><<controlloss>>
					<</if>>
				<<else>>
					<<set $mouthactiondefault to "rest">>
					당신은 그만두고 싶다고 생각한다. <span class="lewd">하지만 말이 입 밖으로 나오지 않는다.</span>
					<<set $xchange.heat.bypassAsk to false>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "ask" and $askAction is "novaginal">>
			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 질에 삽입하는 것은 싫다고 말한다">>
			<<else>>
				<<set $mouthactiondefault to "rest">>
				<<willpowercombatcheck>>
				<<if $willpowerSuccess and !$xchange.heat.bypassAsk>>
					<<brat 5>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>>
					<<if $player.virginity.vaginal is true>>
						당신은 <<him>>에게 당신은 아직 처녀이니 질에 아무것도 넣지 말아 달라고 말한다.
					<<else>>
						당신은 <<him>>에게 질에 삽입하는 것은 싫다고 말한다.
					<</if>>
					<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
						<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 그것을 <<if $enemyno gte 2>>무시한다<<else>>무시한다<</if>>.
					<<elseif $combatExtended.reverseRapeStart is 1 or combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription) or $gamemode is "soft" or $gloryhole>>
						<<set $novaginal to 1>><span class="green"><<if $enemyno gte 2>>그들은 알겠다는 듯 고개를 끄덕인다<<else>><<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다<</if>>.</span>
						<<if $vaginastate is "doublepenetrated">>
							<<set $vaginastate to "doubleentrance">><<set $vaginaaction to 0>>
							<<if $NPCList[$vaginatarget].penis is "vaginadouble" and $NPCList[$vaginadoubletarget].penis is "vaginadouble">>
								<<set $NPCList[$vaginatarget].penis to "vaginaentrancedouble">>
								<<set $NPCList[$vaginadoubletarget].penis to "vaginaentrancedouble">>
								<<combatPerson>>【와과】 <<personselect $vaginadoubletarget>><<combatperson>>【이가】 당신의 질에서 자신들의 자지를 빼낸다.
							<</if>>
						<<elseif $vaginastate is "penetrated">>
							<<set $vaginastate to "entrance">><<set $vaginaaction to 0>>
							<<if $NPCList[$vaginatarget].penis is "vagina">>
								<<set $NPCList[$vaginatarget].penis to "vaginaentrance">>
								<<combatPerson>>【이가】 당신의 질에서 <<his>> 자지를 빼낸다.
							<</if>>
						<</if>>
					<<else>>
						<<combatRequestRefused "novaginal" $mouthtarget>>
					<</if>>
				<<else>>
					당신은 <<him>>에게 질에 삽입하지 말아 달라고 부탁할까 생각한다. <span class="lewd">하지만 말이 입 밖으로 나오지 않는다.</span>
					<<set $xchange.heat.bypassAsk to false>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "ask" and $askAction is "noanal">>
			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 항문 안에 무엇도 넣고 싶지 않다고 말한다">>
			<<else>>
				<<set $mouthactiondefault to "rest">>
				<<willpowercombatcheck>>
				<<if $willpowerSuccess>>
					<<brat 5>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>>
					<<if $player.virginity.anal is true>>
						당신은 <<him>>에게 거긴 더러우니까 항문 안에 아무것도 넣지 말아 달라고 말한다!
					<<else>>
						당신은 <<him>>에게 항문에는 무엇도 삽입하고 싶지 않다고 말한다.
					<</if>>
