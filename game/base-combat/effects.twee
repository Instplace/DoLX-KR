					<<set $NPCList[$mouthtarget].righthand to 0>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "breastlick" and $NPCList[$mouthtarget].chest is "mouthentrance">>
			<<set $mouthactiondefault to "breastlick">><<set $mouthaction to 0>><<submission 3>>
			당신은 <<hisselect $mouthtarget>> <<= window.KR.getBreastSizeKr($NPCList[$mouthtarget].breastsdesc)>>【을를】 핥는다.
		<</if>>

		<<if $mouthaction is "breastclosed" and $NPCList[$mouthtarget].chest.toString().includes("mouth")>>
			<<set $mouthactiondefault to "breastclosed">><<set $mouthaction to 0>><<brat 3 $mouthtarget>>
			당신은 입을 다문 채로 있는다.
			<<if $NPCList[$mouthtarget].type is "plant" and $NPCList[$mouthtarget].pronoun is "f" and $settings.breastFeedingEnabled>>
				<span class="pink"><<hisselect $mouthtarget>> <<= window.KR.getBreastSizeKr($NPCList[$mouthtarget].breastdesc)>>에서 넥타르가 흘러나온다.</span>
			<<elseif $NPCList[$mouthtarget].lactation is 1 and $settings.breastFeedingEnabled>>
				<span class="pink"><<hisselect $mouthtarget>> <<= window.KR.getBreastSizeKr($NPCList[$mouthtarget].breastdesc)>>에서 우유가 흘러나온다.</span>
			<</if>>
		<</if>>

		<<if $mouthaction is "breastsuck" and $NPCList[$mouthtarget].chest.toString().includes("mouth")>>
			<<set $mouthactiondefault to "breastsuck">><<set $mouthaction to 0>><<submission 3>>
			<<set $mouthstate to "nipple">>
			<<set $NPCList[$mouthtarget].chest to "mouth">>
			당신은 <<hisselect $mouthtarget>> <<= window.KR.getBreastSizeKr($NPCList[$mouthtarget].breastdesc)>>【을를】 <<oraltext>> 빤다.
			<<if $NPCList[$mouthtarget].lefthand is "head_breasts">><<set $NPCList[$mouthtarget].lefthand to "head_nipples">><</if>>
			<<if $NPCList[$mouthtarget].righthand is "head_breasts">><<set $NPCList[$mouthtarget].righthand to "head_nipples">><</if>>
			<<if $settings.breastFeedingEnabled and $NPCList[$mouthtarget].type is "plant" and $NPCList[$mouthtarget].pronoun is "f">>
				<span class="purple">달콤한 넥타르가 당신의 입안을 채운다.</span>
				<<nectarfed 15>><<set $speechHeadSuckle to 1>><<submission 2>>
			<<elseif $settings.breastFeedingEnabled and $NPCList[$mouthtarget].lactation is 1>>
				<span class="purple">달콤하고 부드러운 우유가 당신의 입안을 채운다.</span>
				<<breastfed>><<set $speechHeadSuckle to 1>><<submission 2>>
			<<else>>
				<<set $speechHeadNipple to 1>>
			<</if>>
		<</if>>

		<<if $mouthaction is "scream">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<willpowercombatcheck>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "도움을 청하려 비명을 지른다">>
				<<set $speechChokedAction to "scream">>
			<<elseif $drugged gte (currentSkillValue('willpower') / 10) or $arousal gte $arousalmax * 0.9>>
				당신은 입을 열어 살려달라고 비명을 지르려 하지만, <span class="pink"><<= $drugged gt 0 ? "당신의 약에 취한 정신" : "당신의 흥분감">>【이가】 그것을 음란한 신음소리로 만들어버린다.</span>
				<<neutral 1>><<set $speechMoan to 1>>
			<<elseif !$willpowerSuccess>>
				당신은 살려달라고 비명을 지르려 하지만, <span class="red">목소리가 목구멍에 막혀 나오지 않는다.</span>
			<<elseif $uncomfortable.hypnosis is false and $hypnosis_traits.scream gte random(1,5)>>
				<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
				<<hypnosisText '당신은 도움을 청하려 비명을 지르려 하지만, 음란한 생각이 끼어들고 <span class="lewd">정신은 곧장 그것을 받아들인다.</span> <<askrough>>'>>
				<<hypnotised 1>><<submission 1>><<set $enemyanger += (10 * _speechTrait)>>
			<<elseif $hypnosis_traits.scream gte 1 and currentSkillValue('willpower') lt random(1, (200 * $hypnosis_traits.scream))>>
				<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
				<<hypnosisText '당신은 도움을 청하려 비명을 지르려 하지만, <span class="pink">그 생각은 정신에서 낚아채이듯 사라지고 다른 생각으로 바뀐다.</span> <<askrough>>'>>
				<<hypnotised 1>><<willpower 1>><<submission 1>><<set $enemyanger += (10 * _speechTrait)>>
			<<elseif numberOfEarSlime() and $earSlime.growth gte (currentSkillValue('willpower')/ 10)>>
				당신은 입을 벌려 살려달라고 소리치려 하지만, <span class="lewd">갑작스러운 흥분감이 그것을 음란한 신음소리로 바꿔버린다.</span> <<if earSlimeThoughts()>>음란한 생각이 홍수처럼 밀려와 집중력이 씻겨 나간다.<<else>>슬라임이 당신을 빠르게 마비시키는 것이 느껴진다.<</if>>
				<<if $earSlime.growth gt 50>><<set $earSlime.defyCooldown++>><</if>>
				<<submission 1>><<set $speechMoan to 1>><<drugs 10>><<arousal 1000>>
			<<elseif numberOfEarSlime() and $earSlime.corruption gte (currentSkillValue('willpower')/ 10) and random(0,100) gte 50>>
				당신은 입을 열어 살려달라고 비명을 지르려 하지만, <span class="red">목소리가 목구멍에 막혀 나오지 않는다.</span> <<slimeWord>>【이가】 당신의 집중력을 앗아가는 것을 느낀다.
				<<gwillpower>><<willpower 1>>
			<<elseif $NPCList[0].fullDescription is "Gwylan">>
				당신은 입을 열어 살려달라고 소리치려 하지만,
				<<if $hypnosis_traits.devotion gte 2>>
					<<his>> 손가락이 목을 타고 올라오며 비명이 갑작스럽게 끊긴다.
					<<if $hallucinations gte 2>>
						<<hypnosisText "<span class='red'>푸른 안개가 당신의 입에서 빠져나오고, <<he>>【이가】 <<his>> 손으로 그것을 부드럽게 낚아챈다. 아무리 애를 써도 목소리를 빼앗긴 것처럼 아무 소리도 나오지 않는다.</span>">>
					<<else>>
						<<hypnosisText "<span class='red'>목소리가 목구멍에 걸려 나온다. 아무리 애써도 비명을 지를 수 없다.</span>">>
					<</if>>
					<br>
					<<gwylanHypnoName "cap">>【이가】 다시 미소 짓는다. "얌전히 굴면 돌려줄게. 이제 착한 <<pcpetname "Gwylan" "good">>처럼 조용히 해." <<He>>【은는】 다시 자세를 잡고 계속한다.
					<<set $combat_silenced to true>>
					<<if $consensual is 1>>
						<<set $consensual to 0>>
						<<molested>><<controlloss>>
					<</if>>
					<br><br>
				<<else>>
					하지만 <<he>>【이가】 대신 <<if _gwylanTF?.known>>여우 같은<</if>> 비명을 질러 당신의 목소리를 묻어버린다.
				<</if>>
			<<else>>
				<<if $hypnosis_traits.scream gte 1>>
					<span class="green">당신은 잡념을 떨쳐내고,</span> 살려달라고 소리친다.<<stress -50>><<lllstress>>
				<<else>>
					당신은 도와달라고 소리친다.
				<</if>>
				<<if isLoveInterest("Eden") and $location is "forest" and !($npc.includes("Eden")) and (!$undergroundbrothel or !$undergroundbrothel.active)>>
					<<if $rng lte 50>>
						"에덴! 이것들 좀 떼어내 줘!"
					<<else>>
						"에덴! 도와줘!"
					<</if>>
				<</if>>
				<<brat 10>><<set $alarm to 1>><<set $mouthactiondefault to "scream">><<set $speechScreamForHelp to 1>>
				<<if $NPCList[0].lefthand is 0 and $mouthuse is 0 and $position isnot "wall" and !$robinRentEvent>>
					<<set $NPCList[0].lefthand to "mouth">><<person1>><<He>>【은는】 손으로 당신의 입을 틀어막아 조용히 시킨다.
					<<set $enemytrust -= 40>><<set $mouthuse to "lefthand">>
				<<elseif $NPCList[0].righthand is 0 and $mouthuse is 0 and $position isnot "wall" and !$robinRentEvent>>
					<<set $NPCList[0].righthand to "mouth">><<person1>><<He>>【은는】 손으로 당신의 입을 틀어막아 조용히 시킨다.
					<<set $enemytrust -= 40>><<set $mouthuse to "righthand">>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "apologise">>
			<<personselect $mouthtarget>>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<set _unforgiver to $NPCList.find(npc => npc.traits.includes("unforgiving"))>>
			<!-- an apology is only 30% as effective with no english ability, scaling up to full strength at the top english grade -->
			<<set _englishTraitMax to 4 * ($AMCTraits.english ?? 1)>>
			<<set _apologyPower to Math.clamp(0.3 + (0.7 * _speechTrait) / _englishTraitMax, 0.3, 1)>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "사과한다">>
				<<set $speechChokedAction to "apologise">>
			<<elseif $enemytype is "beast">>
				당신은 <<him>>에게 나쁘게 굴어서 미안하다고 말한다.
				<<set $mouthactiondefault to "plead">>
				<<if $NPCList[$mouthtarget] is _unforgiver and $apologised is 0>>
					<!-- apology to an unforgiving character, instead add 25 anger at no english, remove maximum of 50 at excellent english -->
					<<bHe>>【은는】 당신을 무시한다.
					<<set $apologised to 1>><<set $speechApologiseUnforgiving to 1>>
					<<set $enemyanger += Math.clamp(25 - _speechTrait * 20, $enemyangermax / -4, $enemyangermax / 2)>>
				<<elseif $NPCList[$mouthtarget] is _unforgiver>>
					<!-- repeated apology, now it's just more anger -->
					<span class = red><<bHe>>【은는】 더욱 짜증나는 표정을 지을 뿐이다.</span>
					<<set $enemyanger += Math.clamp(100 - _speechTrait * 20, 0, $enemyangermax / 2)>>
				<<elseif !!_unforgiver and $apologised is 0>>
					<<bHe>>【은는】 <<= _unforgiver.fullDescription>> 쪽을 바라보지만,
					<<if _unforgiver.monster is 0>>
						상대는 무시하듯 <<beast_growls_text _unforgiver.type>>.
					<<else>>
						상대는 그저 코웃음 칠 뿐이다.
					<</if>>
					<span class="red"><<bHe>>【은는】 대답으로 <<beast_growls_text>>, 당신의 사과를 무시한다.</span>
					<<set $apologised to 1>><<set $speechApologiseUnforgiving to 1>>
					<<set $enemyanger += Math.clamp(25 - _speechTrait * 20, $enemyangermax / -2, $enemyangermax / 2)>>
				<<elseif $apologised is 0>>
					<<if $monster is 1>>
						<<bHe>>【은는】 으르렁거린다. "좋아. 이제 가만히 있어."
					<<else>>
						그것은 당신의 말을 이해하지 못하지만, 당신의 목소리 톤은 영향을 미친다.
					<</if>>
					<<set $apologised to 1>><<set $speechApologise to 1>>
					<<set $enemyanger -= 50 * (1 + _speechTrait) * _apologyPower>>
				<<else>>
					<<bHe>>【은는】 당신을 무시한다.
					<<set $speechApologiseRejected to 1>>
				<</if>>
			<<else>>
				<<if $robinmist>>
					당신은 외친다. "곁에 있어주지 못해서 미안해!"
					<<set $speechApologiseRejected to 1>>
				<<elseif $robinRentEvent is 1 and $combatPhase is "Robin">>
					당신은 <<him>>에게 돈을 지불하지 않아서 미안하다고 말한다.
					<<set $speechApologiseRejected to 1>>
				<<elseif $npc.includes("Ivory Wraith") and $wraithPrison?.vision and !$wraithApologiseCooldown>>
					<<if $wraith.state is "haunt">>
						당신은 <<him>>에게 모든 것을 빼앗아서 미안하다고 말한다.
					<<else>>
						당신은 <<him>>에게 그동안 있었던 모든 일들에 대해 미안하다고 말한다.
					<</if>>
					<<set $mouthactiondefault to "plead">>
					<<if $apologised is 0>>
						<<set $apologised to 1>><<set $speechApologise to 1>><<set $wraithApologise to true>><<set $wraithApologiseCooldown to true>>
						<<set $enemyanger -= 100 * (1 + _speechTrait) * _apologyPower>>
					<<else>>
						<<He>>【은는】 분노하며 자신의 목을 할퀸다.
						<<set $speechApologiseRejected to 1>>
					<</if>>
				<<else>>
					당신은 <<him>>에게 나쁘게 굴어서 미안하다고 말한다.
					<<set $mouthactiondefault to "plead">>
					<<if $NPCList[$mouthtarget] is _unforgiver>>
						<span class="red"><<He>>【은는】 코웃음 친다.</span>
						<<if $apologised is 0>>
							<<set $enemyanger += Math.clamp(25 - _speechTrait * 20, $enemyangermax / -4, $enemyangermax / 2)>>
							<<set $apologised to 1>><<set $speechApologiseUnforgiving to 1>>
						<<else>>
							<<set $enemyanger += Math.clamp(100 - _speechTrait * 20, 0, $enemyangermax / 2)>>
						<</if>>
					<<elseif !!_unforgiver and $apologised is 0>>
						<<He>>【은는】 <<= _unforgiver.fullDescription>> 쪽으로 시선을 돌리지만,
						<<if _unforgiver.monster is 0>>
							상대는 무시하듯 <<beast_growls_text _unforgiver.type>>.
						<<else>>
							상대는 그저 코웃음 치며 말한다. "<<phim stranger>>의 말은 듣지 마."
						<</if>>
						<span class="red"><<He>>【은는】 고개를 끄덕이고, 당신의 사과를 무시한다.</span>
						<<set $apologised to 1>><<set $speechApologiseUnforgiving to 1>>
						<<set $enemyanger += Math.clamp(25 - _speechTrait * 20, $enemyangermax / -2, $enemyangermax / 2)>>
					<<elseif $apologised is 0>>
						<<His>> 표정이 누그러진다.
						<<if $NPCList[$mouthtarget].fullDescription is "Avery">>
							<<note "에이버리의 구원자" "teal">>
						<</if>>
						<<set $apologised to 1>><<set $speechApologise to 1>>
						<<set $enemyanger -= 50 * (1 + _speechTrait) * _apologyPower>>
					<<else>>
						<<He>>【은는】 당신을 무시한다.
						<<set $speechApologiseRejected to 1>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "focus">>
			<<set $mouthaction to 0>><<set $mouthactiondefault to "focus">>
			<<willpowercombatcheck>>
			<<if $willpowerSuccess>>
				<<willpowersuccess>>
				<<set $xchange.resistCombatArousal to 1>>
				<span class="blue">당신은 호흡에 집중해 밀려오는 쾌감의 일부를 막아낸다.</span>
			<<else>>
				<<set $xchange.resistCombatArousal to -1>>
				<span class="lewd">집중이 흔들리고, 정신이 반란을 일으켜 하나하나의 손길과 감각에 매달린다. 쾌감을 막아내기는커녕 실수로 오히려 키우고 만다.</span>
			<</if>>
			<<meek 1>>
		<</if>>

		<<if $mouthaction is "forgive">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze>>
			<<else>>
				<<set $mouthactiondefault to "plead">>
				<<set _cyAnger to $enemyanger>>
				<<set $trauma -= $traumagain>><<set $traumagain to 0>><<set $speechForgive to 1>><<set $enemyanger to 0>><<set $angelforgive to 1>>
				<<traumaClamp>>
				<<actionsforgive>>
				<<if setup.arcology.cyberAny("dampener")>><<set $enemyanger to Math.round(_cyAnger / 2)>> <<arcologyCyberReact "forgive" `setup.arcology.cyberSlot("dampener")`>><</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "retribution">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze>>
			<<else>>
				<<set $mouthactiondefault to "demand">>
				<<set $fallenangelretribution to 1>>
				<<if random(1, 100) gt 1>>
					<<if $enemytype is "beast">>
						<span class="red">"물러가라, <<beasttype>>【아야】!"</span> 당신이 선언한다.
					<<else>>
						<span class="red">"네 죄값을 치르게 될 거야!"</span> 당신이 선언한다.
					<</if>>
				<<else>>
					<span class="red"><span class="bold">"꺼져라, 걸레야!!!"</span></span>
					<<set $begoneThot to 1>>
					<<defiance 9999>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "dragonboost">>
			<<set $mouthaction to 0>><<set $mouthactiondefault to "demand">>
			<<if $dragonBoostUsed is 1>>
				<<set $dragonStar -= 1>>
				<span class="navy">당신은 용의 별을 이로 깨물어 부수고, 힘이 다시 솟구친다.</span>
			<</if>>
			<<set $dragonBoostUsed to 1>>
			<<personselect $mouthtarget>>
			당신은 몸을 웅크리고 기운을 모은 뒤, 갑자기 폭발하듯 앞으로 몸을 날린다.
			/* One ram in twenty knocks the target out, bypassing the per-blow damage cap. */
			<<set _dragonBoostRoll to random(1, 100)>>
			<<if _dragonBoostRoll gt 51>>
				<span class="purple">당신은 <<combatperson>>【을를】 스쳐 지나가며 놓친다.</span>
			<<elseif _dragonBoostRoll gt 5>>
				<span class="blue">당신은 <<combatperson>>【을를】 스치지만, 타격이 미끄러진다.</span>
				<<defiance 2 $mouthtarget>><<attackstat>>
			<<else>>
				<span class="green">당신은 <<combatperson>>에게 세게 부딪친다.</span>
				<<defiance 8 $mouthtarget>><<attackstat>>
			<</if>>
			<<if _dragonBoostRoll gt 5 or !$NPCList[$mouthtarget] or $NPCList[$mouthtarget].stance is "defeated">>
			<<elseif setup.arcology.resistsKnockout($mouthtarget)>>
				<<arcologyCyberReact "knockout" $mouthtarget>>
			<<else>>
				<span class="gold"><span class="bold">충격이 짓누르는 듯한 힘으로 꽂힌다.</span></span>
				<<if $enemyno gte 2>>
					<<set _thedamage to Math.max(0, $NPCList[$mouthtarget].health)>>
					<<npcdamage $mouthtarget>>
					<<set $enemyhealth -= Math.round(_thedamage)>>
				<<else>>
					<<set $enemyhealth to 0>>
					<<set $NPCList[$mouthtarget].health to 0>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "seduce">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze>>
			<<else>>
				<<if $submissive gte 1150 and !$robinRentEvent>>
					<<set $mouthactiondefault to "moan">>
				<<else>>
