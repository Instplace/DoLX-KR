								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.6 $lefttarget>>
							<<elseif _ringsName isnot "" and _ringsName isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.2 $lefttarget>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 2 $lefttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>

						<<if _ringsAltPos is "alt" or _ringsName.includes("rings")>>
							<<if _ringsType.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.3 $lefttarget>>
							<<elseif _ringsName isnot "" and _ringsName isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $lefttarget>>
							<</if>>
						<</if>>
					<</if>>
				<<else>>
					<<defiance 4 $lefttarget>><<set $speechPlayerHits to 1>><<set $hookpunchStat += 1>>

					<<if _ringsAltPos is "alt" or _ringsName.includes("rings")>>
						<<if _ringsType.includes("jewelled")>>
							당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
							<<defiance 0.6 $lefttarget>>
						<<elseif _ringsName isnot "" and _ringsName isnot "naked">>
							당신의 반지가 타격을 강화한다!
							<<defiance 0.2 $lefttarget>>
						<</if>>
					<</if>>
				<</if>>

				/* Keep DoLX feedback text for the sluggish fail vibe */
				당신은 왼손 훅을 날리지만, <span class="lewd">달아오르고 나른한 몸으로는 제대로 된 타격을 입히지 못한다.</span>
			<</if>>
		<</if>>

		<<if $rightaction is "righthookpunch">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthookpunch">>
			<<willpowercombatcheck>>
			<<if $willpowerSuccess>>
				<<personselect $righttarget>><<set $combatExtended.hookpunchingActive to 1>><<set $striking to 1>><<combatExtendedEnemyCheck $righttarget>>
				<<if $parasite.left_ear.name is "slime" and random(1, 3) is 3 or $parasite.right_ear.name is "slime" and random(1, 3) is 3>>
					<<if $earSlime.corruption gte (currentSkillValue('willpower') / 10)>>
						당신은 <<personselect $righttarget>><<combatperson>>【을를】 향해
						오른손을 휘두르려 하지만, <span class="red"><<slimeWord>>【이가】 당신의 사지를 고정시켜 버린다.</span>
						<<gwillpower>><<willpower 1>>
					<<else>>
						<<slimeWord>>【이가】 당신의 오른팔을 붙들어 고정하려 하지만, <span class="green">당신은 몸부림쳐 슬라임에게서 통제권을 되찾는다.</span>
						<<actionshookpunch $righttarget>>
						<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
							<<if $combatExtended.enemyCounterSuccess is 2>>
								<<violence 10>><<combatExtendedStability -10>>
							<<elseif $combatExtended.enemyDodgeSuccess is 2>>
								/* Attack dodged */
							<<elseif $combatExtended.enemyCounterSuccess is 1>>
								<<defiance 4 $righttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>><<combatExtendedStability -5>>
							<<else>>
								<<defiance 2 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
							<</if>>
						<<else>>
							<<defiance 4 $righttarget>><<set $speechPlayerHits to 1>><<set $hookpunchStat += 1>>
						<</if>>
					<</if>>
				<<else>>
					<<actionshookpunch $righttarget>>
					<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
						<<if $combatExtended.enemyCounterSuccess is 2>>
							<<violence 10>>
						<<elseif $combatExtended.enemyDodgeSuccess is 2>>
							/* Attack dodged */
						<<elseif $combatExtended.enemyCounterSuccess is 1>>
							<<defiance 4 $righttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>><<combatExtendedStability -5>>

							/* Null-safe ring helpers (prevents crashes if worn.rings is missing/malformed) */
							<<set _ringsName to (($worn.rings && typeof $worn.rings.name === "string") ? $worn.rings.name : "")>>
							<<set _ringsType to (($worn.rings && typeof $worn.rings.type === "string") ? $worn.rings.type : "")>>
							<<set _ringsAltPos to (($worn.rings && typeof $worn.rings.altposition === "string") ? $worn.rings.altposition : "")>>

							<<if _ringsAltPos isnot "alt" or _ringsName.includes("rings")>>
								<<if _ringsType.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.6 $righttarget>>
								<<elseif _ringsName isnot "" and _ringsName isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.2 $righttarget>>
								<</if>>
							<</if>>
						<<else>>
							<<defiance 2 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
							<<if $worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")>>
								<<if $worn.rings.type.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.3 $righttarget>>
								<<elseif $worn.rings.name isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.1 $righttarget>>
								<</if>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 4 $righttarget>><<set $speechPlayerHits to 1>><<set $hookpunchStat += 1>>
						<<if $worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.6 $righttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
