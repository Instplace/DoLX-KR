				<<if $earSlime.growth gte (currentSkillValue('willpower') / 10) and random(0,100) gte $earSlime.growth / 3>>
					당신은 <<personselect $lefttarget>><<combatperson>>【을를】 향해
					왼손을 휘두르려 하지만, <span class="red"><<slimeWord>>【이가】 당신의 사지를 고정시켜 버린다.</span>
					<<if $earSlime.growth gt 50>><<set $earSlime.defyCooldown++>><</if>>
				<<elseif $earSlime.corruption gte (currentSkillValue('willpower') / 10) and random(0,100) gte 50>>
					당신은 <<personselect $lefttarget>><<combatperson>>【을를】 향해
					왼손을 휘두르려 하지만, <span class="red"><<slimeWord>> 때문에 집중이 흐트러져 빗나간다.</span>
				<<else>>
					<<slimeWord>>【이가】 당신이 <<personselect $lefttarget>><<combatperson>>【을를】 때리지 못하게 방해하려 하지만, <span class="green">당신은 개의치 않고 가격한다.</span>
					<<actionshit $lefttarget>>
					<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
						<<if $combatExtended.enemyCounterSuccess is 2>>
							<<violence 10>><<combatExtendedStability -10>>
						<<elseif $combatExtended.enemyDodgeSuccess is 2>>
							/* Attack dodged */
						<<elseif $combatExtended.enemyCounterSuccess is 1>>
							<<defiance 2 $lefttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>><<combatExtendedStability -5>>
							<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
								<<if $worn.rings.type.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.3 $lefttarget>>
								<<elseif $worn.rings.name isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.1 $lefttarget>>
								<</if>>
							<</if>>
						<<else>>
							<<defiance 1 $lefttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
							<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
								<<if $worn.rings.type.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.15 $lefttarget>>
								<<elseif $worn.rings.name isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.05 $lefttarget>>
								<</if>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 2 $lefttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.3 $lefttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $lefttarget>>
							<</if>>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<actionshit $lefttarget>>
				<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
					<<if $combatExtended.enemyCounterSuccess is 2>>
						<<violence 10>>
					<<elseif $combatExtended.enemyDodgeSuccess is 2>>
						/* Attack dodged */
					<<elseif $combatExtended.enemyCounterSuccess is 1>>
						<<defiance 2 $lefttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.3 $lefttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $lefttarget>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 1 $lefttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.15 $lefttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.05 $lefttarget>>
							<</if>>
						<</if>>
					<</if>>
				<<else>>
					<<defiance 2 $lefttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
					<<if ($worn.rings.altposition is "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
						<<if $worn.rings.type.includes("jewelled")>>
							당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
							<<defiance 0.3 $lefttarget>>
						<<elseif $worn.rings.name isnot "naked">>
						당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $lefttarget>>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>

		<<if $rightaction is "righthit">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthit">><<personselect $righttarget>><<set $striking to 1>><<combatExtendedEnemyCheck $righttarget>>
			<<willpowercombatcheck>>
			<<if !$willpowerSuccess>>
				당신은 <<personselect $righttarget>><<combatperson>>【을를】 향해
				오른손을 휘두르려 하지만, <span class="lewd">흥분한 탓에 힘없는 잽밖에 되지 못한다.</span>
				 
			<<elseif numberOfEarSlime() and (($parasite.left_ear.name is "slime" and random(1, 3) is 3) or ($parasite.right_ear.name is "slime" and random(1, 3) is 3) or ($earSlime.growth gte 50 and random(1, 3) is 3))>>
				<<if $earSlime.growth gte (currentSkillValue('willpower') / 10) and random(0,100) gte $earSlime.growth / 3>>
					당신은 <<personselect $righttarget>><<combatperson>>【을를】 향해
					오른손을 휘두르려 하지만, <span class="red"><<slimeWord>>【이가】 당신의 사지를 고정시켜 버린다.</span>
					<<if $earSlime.growth gt 50>><<set $earSlime.defyCooldown++>><</if>>
				<<elseif $earSlime.corruption gte (currentSkillValue('willpower') / 10) and random(0,100) gte 50>>
					당신은 <<personselect $righttarget>><<combatperson>>【을를】 향해
					오른손을 휘두르려 하지만, <span class="red"><<slimeWord>> 때문에 집중이 흐트러져 빗나간다.</span>
					 
				<<else>>
					<<slimeWord>>【이가】 당신이 <<personselect $righttarget>><<combatperson>>【을를】 때리지 못하게 방해하려 하지만, <span class="green">당신은 개의치 않고 가격한다.</span>
					<<actionshit $righttarget>>
					<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
						<<if $combatExtended.enemyCounterSuccess is 2>>
							<<violence 10>><<combatExtendedStability -10>>
						<<elseif $combatExtended.enemyDodgeSuccess is 2>>
							/* Attack dodged */
						<<elseif $combatExtended.enemyCounterSuccess is 1>>
							<<defiance 2 $righttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>><<combatExtendedStability -5>>
							<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
								<<if $worn.rings.type.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.3 $righttarget>>
								<<elseif $worn.rings.name isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.1 $righttarget>>
								<</if>>
							<</if>>
						<<else>>
							<<defiance 1 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
							<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
								<<if $worn.rings.type.includes("jewelled")>>
									당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
									<<defiance 0.15 $righttarget>>
								<<elseif $worn.rings.name isnot "naked">>
									당신의 반지가 타격을 강화한다!
									<<defiance 0.05 $righttarget>>
								<</if>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 2 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.3 $righttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $righttarget>>
							<</if>>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<actionshit $righttarget>>
				<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
					<<if $combatExtended.enemyCounterSuccess is 2>>
						<<violence 10>>
					<<elseif $combatExtended.enemyDodgeSuccess is 2>>
						/* Attack dodged */
					<<elseif $combatExtended.enemyCounterSuccess is 1>>
						<<defiance 2 $righttarget>><<violence 5>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.3 $righttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.1 $righttarget>>
							<</if>>
						<</if>>
					<<else>>
						<<defiance 1 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
						<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
							<<if $worn.rings.type.includes("jewelled")>>
								당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
								<<defiance 0.15 $righttarget>>
							<<elseif $worn.rings.name isnot "naked">>
								당신의 반지가 타격을 강화한다!
								<<defiance 0.05 $righttarget>>
							<</if>>
						<</if>>
					<</if>>
				<<else>>
					<<defiance 2 $righttarget>><<set $speechPlayerHits to 1>><<set $attackstat += 1>>
					<<if ($worn.rings.altposition isnot "alt" or $worn.rings.name.includes("rings")) and !$worn.rings.name.includes("nail armour")>>
						<<if $worn.rings.type.includes("jewelled")>>
							당신의 반지가 타격을 강화한다! 보석이 상대의 몸에 작은 상처를 남긴다.
							<<defiance 0.3 $righttarget>>
						<<elseif $worn.rings.name isnot "naked">>
							당신의 반지가 타격을 강화한다!
							<<defiance 0.1 $righttarget>>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>

		/* Parallel to actionshit, but for the Scratch action.
		   Transformation claws and very long nails use claw-tier damage; long nails use scratch-tier damage. */
		<<if $leftaction is "leftscratch" and $rightaction is "rightscratch" and $lefttarget is $righttarget>>
			<<set $leftaction to 0>><<set $rightaction to 0>>
			<<set $leftactiondefault to "leftscratch">><<set $rightactiondefault to "rightscratch">>
			/* Transformation claws always count as level 3 regardless of natural nail length.
			_effectiveNailLevel drives the damage scaling below; $nailslevel is still useful for non-claw flavor. */
			<<playerClawType>>
			<<set _effectiveNailLevel to (_hasClaws ? 3 : ($nailslevel ?? 0))>>
			<<willpowercombatcheck>>
			<<if $willpowerSuccess>>
				<<set $striking to 1>><<combatExtendedEnemyCheck $lefttarget>><<actionsscratch "both">>

				/* Null-safe ring helpers.
				_hasNailRings identifies nail armour by name; the item shares the "jewelled" type tag with gemstone rings, so name match is the only reliable identifier.
				See clothing-rings.js index 265. */
				<<set _ringsName to (($worn.rings && typeof $worn.rings.name === "string") ? $worn.rings.name : "")>>
				<<set _hasNailRings to (_ringsName.includes("nail armour"))>>

				/* Damage profile: tier (scratch/claw), consensual-aware, body-size scaled for non-consensual. 
				_scratchDef = social effects, _scratchFlat = health. "dual" tells it this is a two-handed strike (slightly higher def). */
				<<playerClawType>>
				<<scratchDamageProfile "dual">>
				<<if _hasNailRings>><<set _scratchFlat += ($consensual is 1 ? 2 : 4)>><</if>>

				/* snapshot health before any defiance call so the flat override is exact */
				<<set _scratchHpBefore to $enemyhealth>>
				<<set _scratchNpcHpBefore to (($NPCList && $NPCList[$lefttarget] && typeof $NPCList[$lefttarget].health === "number") ? $NPCList[$lefttarget].health : undefined)>>

				<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
					<<if $combatExtended.enemyCounterSuccess is 2>>
						<<violence 10>><<combatExtendedStability -10>>
					<<elseif $combatExtended.enemyDodgeSuccess is 2>>
						/* Attack dodged */
					<<elseif $combatExtended.enemyCounterSuccess is 1>>
						<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef * 0.5)` $lefttarget>>
						<<violence 3>><<set $speechscratch to 1>><<set $attackstat += 2>><<combatExtendedStability -5>>
						<<if _hasNailRings>>
							네일 아머 반지가 발톱의 날카로움을 더해 준다.
						<</if>>
						<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore `Math.ceil(_scratchFlat * 0.5)`>>
					<<else>>
						<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef * 0.6)` $lefttarget>>
						<<set $speechscratch to 1>><<set $attackstat += 2>>
						<<if _hasNailRings>>
							네일 아머 반지가 발톱의 날카로움을 더해 준다.
						<</if>>
						<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore `Math.ceil(_scratchFlat * 0.6)`>>
					<</if>>
				<<else>>
					<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef)` $lefttarget>><<set $speechscratch to 1>><<set $attackstat += 2>>
					<<if _hasNailRings>>
						네일 아머 반지가 발톱의 날카로움을 더해, 상처가 더 깊어진다.
					<</if>>
					<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore _scratchFlat>>
				<</if>>
			<<else>>
				당신은 손톱으로 <<personselect $lefttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="lewd">달아오른 몸이 각도를 놓친다.</span>
			<</if>>
		<</if>>

		<<if $leftaction is "leftscratch">>
			<<set $leftaction to 0>><<set $leftactiondefault to "leftscratch">>
			<<set $striking to 1>><<combatExtendedEnemyCheck $lefttarget>>
			<<playerClawType>>
			<<set _effectiveNailLevel to (_hasClaws ? 3 : ($nailslevel ?? 0))>>
			<<willpowercombatcheck>>
			<<if !$willpowerSuccess>>
				당신은 왼손으로 <<personselect $lefttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="lewd">흥분한 탓에 일격에서 날카로움이 빠져 버린다.</span>
			<<else>>
				<<set _scratchCanLand to true>>
				<<if numberOfEarSlime() and (($parasite.left_ear.name is "slime" and random(1, 3) is 3) or ($parasite.right_ear.name is "slime" and random(1, 3) is 3) or ($earSlime.growth gte 50 and random(1, 3) is 3))>>
					<<if $earSlime.growth gte (currentSkillValue('willpower') / 10) and random(0,100) gte $earSlime.growth / 3>>
						당신은 왼손으로 <<personselect $lefttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="red"><<slimeWord>>【이가】 당신의 사지를 고정시켜 버린다.</span>
						<<set _scratchCanLand to false>>
						<<if $earSlime.growth gt 50>><<set $earSlime.defyCooldown++>><</if>>
					<<elseif $earSlime.corruption gte (currentSkillValue('willpower') / 10) and random(0,100) gte 50>>
						당신은 왼손으로 <<personselect $lefttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="red"><<slimeWord>> 때문에 집중이 흐트러져 손톱이 허공만 스친다.</span>
						<<set _scratchCanLand to false>>
					<<else>>
						<<slimeWord>>【이가】 당신을 막으려 하지만, <span class="green">당신은 그 저항을 뚫고 손을 밀어붙인다.</span>
					<</if>>
				<</if>>

				<<if _scratchCanLand>>
					<<actionsscratch $lefttarget>>
					<<set _ringsName to (($worn.rings && typeof $worn.rings.name === "string") ? $worn.rings.name : "")>>
					<<set _hasNailRings to (_ringsName.includes("nail armour"))>>
					<<playerClawType>>
					<<scratchDamageProfile "single">>
					<<if _hasNailRings>><<set _scratchFlat += ($consensual is 1 ? 1 : 2)>><</if>>
					<<set _scratchHpBefore to $enemyhealth>>
					<<set _scratchNpcHpBefore to (($NPCList && $NPCList[$lefttarget] && typeof $NPCList[$lefttarget].health === "number") ? $NPCList[$lefttarget].health : undefined)>>

					<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
						<<if $combatExtended.enemyCounterSuccess is 2>>
							<<violence 10>><<combatExtendedStability -10>>
						<<elseif $combatExtended.enemyDodgeSuccess is 2>>
							/* Attack dodged */
						<<elseif $combatExtended.enemyCounterSuccess is 1>>
							<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef * 0.5)` $lefttarget>>
							<<violence 3>><<set $speechscratch to 1>><<set $attackstat += 1>><<combatExtendedStability -5>>
							<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore `Math.ceil(_scratchFlat * 0.5)`>>
						<<else>>
							<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef * 0.6)` $lefttarget>>
							<<set $speechscratch to 1>><<set $attackstat += 1>>
							<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore `Math.ceil(_scratchFlat * 0.6)`>>
						<</if>>
					<<else>>
						<<defiance `($consensual is 1 and $NPCList[$lefttarget].fullDescription is "Gwylan") ? 0 : (_scratchDef)` $lefttarget>><<set $speechscratch to 1>><<set $attackstat += 1>>
						<<if _hasNailRings>>
							네일 아머 반지가 상처를 더 깊게 만든다.
						<</if>>
						<<scratchFlatDamage _scratchHpBefore $lefttarget _scratchNpcHpBefore _scratchFlat>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>

		<<if $rightaction is "rightscratch">>
			<<set $rightaction to 0>><<set $rightactiondefault to "rightscratch">>
			<<personselect $righttarget>>
			<<set $striking to 1>><<combatExtendedEnemyCheck $righttarget>>
			<<playerClawType>>
			<<set _effectiveNailLevel to (_hasClaws ? 3 : ($nailslevel ?? 0))>>
			<<willpowercombatcheck>>
			<<if !$willpowerSuccess>>
				당신은 오른손으로 <<personselect $righttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="lewd">흥분한 탓에 일격에서 날카로움이 빠져 버린다.</span>
			<<else>>
				<<set _scratchCanLand to true>>
				<<if numberOfEarSlime() and (($parasite.left_ear.name is "slime" and random(1, 3) is 3) or ($parasite.right_ear.name is "slime" and random(1, 3) is 3) or ($earSlime.growth gte 50 and random(1, 3) is 3))>>
					<<if $earSlime.growth gte (currentSkillValue('willpower') / 10) and random(0,100) gte $earSlime.growth / 3>>
						당신은 오른손으로 <<personselect $righttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="red"><<slimeWord>>【이가】 당신의 사지를 고정시켜 버린다.</span>
						<<set _scratchCanLand to false>>
						<<if $earSlime.growth gt 50>><<set $earSlime.defyCooldown++>><</if>>
					<<elseif $earSlime.corruption gte (currentSkillValue('willpower') / 10) and random(0,100) gte 50>>
						당신은 오른손으로 <<personselect $righttarget>><<combatperson>>【을를】 할퀴려 하지만, <span class="red"><<slimeWord>> 때문에 집중이 흐트러져 손톱이 허공만 스친다.</span>
						<<set _scratchCanLand to false>>
