:: Widgets Effects Man [widget]
<<widget "effectsman">>
	<<combat-stall-tick>>
	<<pet-combat-support>>
	<<npc-xchange-repair-active-genital-targets>>
	<div @class="($debugLines ? 'debugLines-effectsman' : '')">
		<!-- "FOR" loops work by counting backward from highest numbered combatant to lowest e.g. 5 to 0. -->
		<!-- In case of train combat, count stops after 1, e.g. 5 to 5. -->
		<!-- Lots of further opportunity to reduce code using <<for>><</for>> loops with NPC objects NG 2.8-->
		/*
		* Switched all instances of skill checks, that simply repeat themselves with a different variable, for the JS function combatSkillCheck()
		* The function can be found at "game/03-JavaScript/ingame.js". It takes one required argument and three optional arguments.
		* Argument 0 is for the skill being used. For simplicity at writing, you only pass the important part of the skill, E.g. "hand", or "feet", or "oral".
		* Argument 1 (optional) is used for the target of that action. This is used to future-proof the possibility of using the target's specific arousal/trust/anger in calculation.
		* Argument 2 (optional) is the base difficulty used for the action. Most actions use 1000 base difficulty, which is the default if left blank, but some actions take different chances (like undressing).
		* Argument 3 (optional) is the extra multiplier for the arousal side. This is only used in undressing so far, but might as well add it as an option.
		*/

		<<if $combatExtended.reverseRapeStart is 1>>
			<span class="yellow">이제 전투 메뉴를 열어 이 만남을 중단할 수 있다. </span>
			<br><br>
		<</if>>

		<<combat-dislodge-vaginal-dildo>>

		<<if $illOmen is 2 and random(1, 3) is 1>>
			<<= either(
				"<<person>>【이가】 무언가를 잡으려다 놓치고, 하마터면 <<his>> 균형을 잃을 뻔한다.",
				"방은 당신만 빼고 그 안의 모두에게서 계속 기울어 멀어진다.",
				"또 하나가 당신이 의도한 대로 실패한다."
			)>>
			<<ltrauma>><<trauma -3>>
			<br><br>
		<</if>>

		<<if $fortuneStolen is 2 and random(1, 3) is 1>>
			<<= either(
				"가슴속에 작은 온기가 느껴지고, 당신이 가져간 행운이 떠오른다.",
				"익숙한 온기가 몸속에서 느껴진다. 당신이 가져간 행운은 아직 그곳에 있다.",
				"잠깐의 온기가 가슴을 스쳐 지나가며, 당신이 훔친 행운을 일깨운다."
			)>>
			<<lstress>><<stress -3>>
			<br><br>
		<</if>>

		/* Player CE Actions Reset */
		<<set $combatExtended.activeDodgingActive to 0>>
		<<set $combatExtended.activeDodgingTarget to 0>>
		<<set $combatExtended.blockingActive to 0>>
		<<set $combatExtended.counteringActive to 0>>
		/* One counter per hand committed to countering. Without this a lone fighter negates and punishes every attack an entire group throws in a turn. */
		<<set $combatExtended.counterCharges to 0>>
		<<set $combatExtended.feintingActive to 0>>
		/* These mark what kind of blow is being thrown this turn. Without clearing them the first kick of a fight leaves every later punch collecting the kicking bonus, and the first hook punch leaves every later attack easier to dodge. */
		<<set $combatExtended.hookpunchingActive to 0>>
		<<set $striking to 0>><<set $kicking to 0>>

		<<unset $xchange.resistCombatArousal>>
		<<set _speechTrait to (!$statFreeze and $xchange.pill.bimboEffect) ? Math.max(0, $xchange.english ?? 0) : $englishtrait>>

		/* Enemy CE Actions Reset */
		<<set $combatExtended.enemyActiveDodgingActive to 0>>
		<<set $combatExtended.enemyBlockingActive to 0>>
		<<set $combatExtended.enemyCounteringActive to 0>>

		/* Check if standing fights toggle is on and if the fight is non-consensual */
		<<if $combatExtended.standingFights is 1 and $consensual is 0 and $position isnot "wall" and $punishmentposition isnot "gloryhole">>
			/* If the encounter starts mid-sex, keep the NPC's genitals active so the position does not disappear on the first turn. Oral already works this way. */
			<<set _npcAlreadyEngaged to (() => {
				const list = Array.isArray($NPCList) ? $NPCList : [];
				/* Only the live combat slots, the same bound the position selectors use. Retired slots keep stale parts. */
				const slots = (Number.isInteger($enemynomax) && $enemynomax > 0) ? Math.min($enemynomax, list.length) : list.length;
				const idle = [0, "0", "none", "clothed", "idle", "", undefined, null];
				for (let i = 0; i < slots; i++) {
					const npc = list[i];
					if (!npc || typeof npc !== "object") continue;
					if (npc.location && ["head", "genitals"].includes(npc.location.genitals)) return true;
					if (!idle.includes(npc.penis) || !idle.includes(npc.vagina) || !idle.includes(npc.chest)) return true;
				}
				return false;
			})()>>
			/* Start Standing Fights if not stuck in a wall or gloryhole */
			<<if $combatExtended.standingFightStart is 1
				and $position isnot "wall"
				and $punishmentposition isnot "gloryhole"
				and !_npcAlreadyEngaged>>
				<<set $combatExtended.standingFightStart to 0>>
				<<set $combatExtended.stability to 100>>
				<<unset $encounterHit>>
				<<npcidlegenitals>>
			<<elseif $combatExtended.standingFightStart is 1 and _npcAlreadyEngaged>>
				<<set $combatExtended.standingFightStart to 0>>
				<<set $combatExtended.stability to 0>>
				<<set $combatExtended.stabilityLost to 1>>
				<<unset $encounterHit>>
			<</if>>

			/* Reverse NPC genitals idle if lost stability */
			<<if $combatExtended.standingFightStart is 0 and $combatExtended.stability lte 0 and $combatExtended.stabilityLost is 0>>
				<<set $combatExtended.stabilityLost to 1>>
				<<reversenpcidlegenitals>>
			<</if>>
		<</if>>

		<<pain -0.25>>

		<<if $enemyno gte 2>>
			<<set $pronoun to "n">>
		<<else>>
			<<switch $NPCList[0].pronoun>>
				<<case "m">>
					<<set $pronoun to "m">>
				<<case "f">>
					<<set $pronoun to "f">>
				<<case "i">>
					<<set $pronoun to "i">>
				<<case "n">>
					<<set $pronoun to "n">>
				<<case "t">>
					<<set $pronoun to "t">>
			<</switch>>
		<</if>>

		<<if !$noIntroName>>
			<<for _i = 0; _i < $enemynomax; _i++>>
				<<set $NPCList[_i].intro to 1>>
			<</for>>
		<</if>>

		<<if $trance gte 1 or $dissociation gte 2>>
			<<if $position is "stalk">>
				당신은 주변을 의식하지 못한 채 멍하니 헤맨다.
			<<else>>
				당신은 똑바로 앞을 응시하고 있으며, 몸은 수동적이고 순종적이다.
			<</if>>
		<</if>>

		<<if $underwater is 1 and !Transformations.partActive("traits", "aquatic")>>
			<<set $underwatertime += 1>>
			<<if $underwatertime lte 5>>
				당신은 물속에 있어서 말을 할 수 없다.
			<<elseif $underwatertime lte 10>>
				<span class="blue">당신은 물속에 있어서 숨을 쉴 수 없다.</span>
				<<gstress>><<stress 1>>
			<<elseif $underwatertime lte 15>>
				<span class="purple">당신은 물속에 있어서 숨을 쉴 수 없다.</span>
				<<gstress>><<stress 2>>
			<<elseif $underwatertime lte 20>>
				<span class="pink">당신은 물속에 있어서 숨을 쉴 수 없다.</span>
				<<gtrauma>><<gstress>><<stress 4>><<trauma 2>>
			<<else>>
				<span class="red">당신은 물 밑에서 질식하고 있다.</span>
				<<pain 20 1>><<gtrauma>><<gstress>><<gpain>><<stress 6>><<trauma 4>>
				<br><br>
			<</if>>
		<</if>>

		<<if $position is "wall">>
			<<if $walltype is "pillory" or $walltype is "cleanpillory">>
				당신은 형틀에 갇힌 채, 무방비한 상태로 뒤태를 훤히 내놓고 있다.
			<<elseif $walltype is "horse_pillory">>
				당신의 다리와 목은 차가운 쇠사슬에 묶여 움직일 수 없다.
			<<elseif $walltype is "front">>
				당신은 벽에 갇혀, 허리 위쪽이 무방비한 상태다.
			<<elseif $walltype is "lift">>
				당신은 엘리베이터 안에 갇힌 채, 무방비한 상태로 뒤태를 훤히 내놓고 있다.
			<<else>>
				당신은 벽 안에 갇힌 채, 무방비한 상태로 뒤태를 훤히 내놓고 있다.
			<</if>>
		<</if>>

		<<effectspain>>
		<<effectsorgasm>>
		<<effectsdissociation>>
		<<if $possessed>>
			<<effectspossessed>>
		<</if>>

		<<effectsman-xchange>>

		<<effectsspray>>
		<<effectshandsclothes>>
		<<effectssteal>>
		<<effectspenwhack>>
		<<effectsshacklewhack>>
		<<effectshypnosiswhack>>
		<<effectshandsfreeface>>
		<<effectshandsfreechest>>
		<<effectshandpull>>
		<<effectsdildowhack>>
		<<effectspillwhack>>

		<<if $bodyaction is "doggy">>
			<<set $bodyaction to 0>>
			당신은 몸을 굴려 무릎을 꿇는다.
			<<set $position to "doggy">>
		<<elseif $bodyaction is "missionary">>
			<<set $bodyaction to 0>>
			당신은 몸을 굴려 등을 대고 눕는다.
			<<set $position to "missionary">>
		<</if>>

		/***
		*      ███   ███████ ██   ██ ███████
		*     ██ ██  ██   ██ ███ ███ ██
		*    ██   ██ █████   ██ █ ██ ███████
		*    ███████ ██  ██  ██   ██      ██
		*    ██   ██ ██   ██ ██   ██ ███████
		*
		*/
		<<if $newtarget isnot undefined>>
			<<setnewtarget>>
		<</if>>

		<<if $leftaction is "lefthandholdkeep" and $rightaction is "righthandholdkeep">>
			<<set $leftaction to 0>><<set $leftactiondefault to "lefthandholdkeep">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthandholdkeep">>
			당신은 <<someones $lefttarget>> 양손을 마주 잡는다.
			<<submission 4>>
		<</if>>

		<<if $leftaction is "lefthandholdnew">>
			<<set $leftaction to 0>><<set $leftactiondefault to "lefthandholdnew">>
			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $lefttarget)>>
				<<set $NPCList[$lefttarget].righthand to "handhold">>
				당신은 <<someones $lefttarget>> 오른손을 마주 잡는다.
				<<set $leftarm to "handheld">><<set $leftactiondefault to "lefthandholdkeep">>
				<<submission 1>>
				<<if isLoveInterest($NPCList[$lefttarget].fullDescription)>>
					<<takeHandholdingVirginity $NPCList[$lefttarget] "romantic" null true>>
				<<else>>
					<<takeHandholdingVirginity $NPCList[$lefttarget] null null true>>
				<</if>>
			<<else>>
				당신은 <<someones $lefttarget>> 오른손을 잡으려 손을 뻗지만, <<he>>【이가】 피한다.
			<</if>>
		<</if>>

		<<if $leftaction is "lefthandholdkeep">>
			<<set $leftaction to 0>><<set $leftactiondefault to "lefthandholdkeep">>
			당신은 <<someones $lefttarget>> 손을 마주 잡는다.
			<<submission 2>>
		<</if>>

		<<if $leftaction is "lefthandholdstop">>
			<<set $leftaction to 0>><<set $leftactiondefault to "rest">>
			당신은 <<someones $lefttarget>> 오른손을 놓아준다.
			<<set $leftarm to 0>>
			<<if $npcSub>>
				<<set $NPCList[$lefttarget].righthand to "idle">>
			<<else>>
				<<set $NPCList[$lefttarget].righthand to 0>>
			<</if>>
		<</if>>


		<<if $rightaction is "righthandholdnew">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthandholdnew">>
			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $righttarget)>>
				<<set $NPCList[$righttarget].lefthand to "handhold">>
				<<set $rightarm to "handheld">>
				당신은 <<hisselect $righttarget>> 왼손을 마주 잡는다.
				<<set $rightarm to "handheld">><<set $rightactiondefault to "righthandholdkeep">>
				<<submission 1>>
				<<if isLoveInterest($NPCList[$righttarget].fullDescription)>>
					<<takeHandholdingVirginity $NPCList[$righttarget] "romantic" null true>>
				<<else>>
					<<takeHandholdingVirginity $NPCList[$righttarget] null null true>>
				<</if>>
			<<else>>
				당신은 <<someones $righttarget>> 왼손을 잡으려 손을 뻗지만, <<he>>【이가】 피한다.
			<</if>>
		<</if>>

		<<if $rightaction is "righthandholdkeep">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthandholdkeep">>
			당신은 <<someones $righttarget>> 손을 마주 잡는다.
			<<submission 2>>
		<</if>>

		<<if $rightaction is "righthandholdstop">>
			<<set $rightaction to 0>><<set $rightactiondefault to "rest">>
			당신은 <<someones $righttarget>> 왼손을 놓아준다.
			<<set $rightarm to 0>>
			<<if $npcSub>>
				<<set $NPCList[$righttarget].lefthand to "idle">>
			<<else>>
				<<set $NPCList[$righttarget].lefthand to 0>>
			<</if>>
		<</if>>

		<<if $leftaction is "handguide">>
			<<set $leftaction to 0>><<set $leftactiondefault to "handguide">><<combatpromiscuity2>>

			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $lefttarget)>>
				<<if $rightaction is "handguide" and $handGuideLeft is $handGuideRight>>
					<<set $rightaction to 0>><<set $rightactiondefault to "rest">>
				<</if>>

				<<switch $handGuideLeft>>
					<<case "penis">>
						당신은 <<someones $lefttarget>> 손을 당신의 <<penis>> 쪽으로 가져간다.
						<<set $NPCList[$lefttarget].righthand to "penisentrance">><<set $penisuse to 1>><<set $penisstate to "otherhandentrance">>
					<<case "pussy">>
						당신은 <<someones $lefttarget>> 손을 당신의 <<pussy>> 쪽으로 가져간다.
						<<set $NPCList[$lefttarget].righthand to "vaginaentrance">><<set $vaginause to 1>><<set $vaginastate to "otherhandentrance">>
					<<case "ass">>
						당신은 <<someones $lefttarget>> 손을 당신의 <<bottom>>에 밀착시킨다.
						<<set $NPCList[$lefttarget].righthand to "anusentrance">><<set $anususe to "hand">><<set $anusstate to "handentrance">>
					<<case "neck">>
						당신은 <<someones $lefttarget>> 손을 당신의 목에 밀착시킨다.
						<<set $NPCList[$lefttarget].righthand to "throat">><<set $neckuse to "hand">>
					<<case "chest">>
						당신은 <<someones $lefttarget>> 손을 당신의 <<breasts>>에 밀착시킨다.
						<<set $NPCList[$lefttarget].righthand to "breasts">><<set $chestuse to "hand">><<set $cheststate to "hand">><<set $chesttarget to $lefttarget>>
					<<default>>
				<</switch>>
				<<set $leftactiondefault to "rest">><<set $leftarm to 0>><<submission 1>>
			<<else>>
				당신은 <<someones $lefttarget>> 손을
				<<switch $handGuideLeft>>
					<<case "penis">>당신의 <<penis>> 쪽으로 이끌려고 하지만,
					<<case "pussy">>당신의 <<pussy>> 쪽으로 이끌려고 하지만,
					<<case "ass">>당신의 <<bottom>> 쪽으로 이끌려고 하지만,
					<<case "neck">>당신의 목 쪽으로 이끌려고 하지만,
					<<case "chest">>당신의 <<breasts>> 쪽으로 이끌려고 하지만,
					<<default>>
				<</switch>>

				<<if $enemyanger gte random(30, 100)>>
					<span class="purple"><<he>>【이가】 당신의 손아귀에서 거칠게 손을 빼버린다.</span>
					<<set $leftactiondefault to "rest">><<set $leftarm to 0>>
					<<set $NPCList[$lefttarget].righthand to 0>><<violence 2>>
				<<else>>
					<<his>> 악력이 너무 강하다.
				<</if>>
			<</if>>
		<</if>>

		<<if $rightaction is "handguide">>
			<<set $rightaction to 0>><<set $rightactiondefault to "handguide">><<combatpromiscuity2>>

			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $righttarget)>>
				<<switch $handGuideRight>>
					<<case "penis">>
						당신은 <<someones $righttarget>> 손을 당신의 <<penis>> 쪽으로 가져간다.
						<<set $NPCList[$righttarget].lefthand to "penisentrance">><<set $penisuse to 1>><<set $penisstate to "otherhandentrance">>
					<<case "pussy">>
						당신은 <<someones $righttarget>> 손을 당신의 <<pussy>> 쪽으로 가져간다.
						<<set $NPCList[$righttarget].lefthand to "vaginaentrance">><<set $vaginause to 1>><<set $vaginastate to "otherhandentrance">>
					<<case "ass">>
						당신은 <<someones $righttarget>> 손을 당신의 <<bottom>>에 밀착시킨다.
						<<set $NPCList[$righttarget].lefthand to "anusentrance">><<set $anususe to "hand">><<set $anusstate to "handentrance">>
					<<case "neck">>
						당신은 <<someones $righttarget>> 손을 당신의 목에 밀착시킨다.
						<<set $NPCList[$righttarget].lefthand to "throat">><<set $neckuse to "hand">>
					<<case "chest">>
						당신은 <<someones $righttarget>> 손을 당신의 <<breasts>>에 밀착시킨다.
						<<set $NPCList[$righttarget].lefthand to "breasts">><<set $chestuse to "hand">><<set $cheststate to "hand">><<set $chesttarget to $righttarget>>
				<</switch>>
				<<set $rightactiondefault to "rest">><<set $rightarm to 0>><<submission 1>>
			<<else>>
				당신은 <<someones $righttarget>> 손을
				<<switch $handGuideRight>>
					<<case "penis">>당신의 <<penis>> 쪽으로 이끌려고 하지만,
					<<case "pussy">>당신의 <<pussy>> 쪽으로 이끌려고 하지만,
					<<case "ass">>당신의 <<bottom>> 쪽으로 이끌려고 하지만,
					<<case "neck">>당신의 목 쪽으로 이끌려고 하지만,
					<<case "chest">>당신의 <<breasts>> 쪽으로 이끌려고 하지만,
				<</switch>>

				<<if $enemyanger gte random(30, 100)>>
					<span class="purple"><<he>>【이가】 당신의 손아귀에서 거칠게 손을 빼버린다.</span>
					<<set $rightactiondefault to "rest">><<set $rightarm to 0>>
					<<set $NPCList[$righttarget].lefthand to 0>><<violence 2>>
				<<else>>
					<<his>> 악력이 너무 강하다.
				<</if>>
			<</if>>
		<</if>>

		<<if $leftaction is "leftgrab">>
			<<set $leftaction to 0>><<set $leftactiondefault to "leftgrab">><<handskilluse>><<combatpromiscuity3>>
			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $lefttarget)>>
				<<submission 1>><<handstat>>
				<<if $NPCList[$lefttarget].penis is 0>>
					<<set $leftactiondefault to "leftwork">><<set $NPCList[$lefttarget].penis to "leftarm">><<set $leftarm to "penis">>
					<span class="lblue">당신은 왼손으로 <<handtext>> <<if $NPCList[$lefttarget].chastity.penis.includes("chastity")>>어루만져<<else>>움켜쥐어<</if>> <<hisselect $lefttarget>> <<= window.KR.getPenisDescKr($NPCList[$lefttarget].penisdesc)>>【을를】 자극한다<<if $NPCList[$lefttarget].chastity.penis.includes("chastity")>>, <<hisselect $lefttarget>> $NPCList[$lefttarget].chastity.penis 위로<</if>>.</span>
				<<else>>
					<span class="blue">당신은 왼손으로 <<hisselect $lefttarget>> <<= window.KR.getPenisDescKr($NPCList[$lefttarget].penisdesc)>>【을를】 움켜쥐려 하지만, 그 자지는 이미 차지되어 있다.</span>
				<</if>>
			<<else>>
				당신은 왼손으로 <<someones $lefttarget>> 자지를 움켜쥐려 하지만 <<he>>【이가】 몸을 뺀다.
			<</if>>
		<</if>>

		<<if $rightaction is "rightgrab">>
			<<set $rightaction to 0>><<set $rightactiondefault to "rightgrab">><<handskilluse>><<combatpromiscuity3>>
			<<if $combatExtended.reverseRapeStart is 1 or combatSkillCheck("hand", $righttarget)>>
				<<submission 1>><<handstat>>
				<<if $NPCList[$righttarget].penis is 0>>
					<<set $NPCList[$righttarget].penis to "rightarm">><<set $rightarm to "penis">>
