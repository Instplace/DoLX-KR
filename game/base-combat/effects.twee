<<if $leftaction is "leftfeint" and $rightaction is "rightfeint" and $lefttarget is $righttarget>>
	<<set $leftaction to 0>><<set $rightaction to 0>><<set $leftactiondefault to "leftfeint">><<set $rightactiondefault to "rightfeint">>
