<</widget>>

<<widget "swarmName">>
	<<if _args[0] is undefined or _args[0] gt 1>>
		<<if $swarm.name.endsWith(" 떼")>>
			<<set _swarmname to $swarm.name>>
		<<else>>
			<<set _swarmname to $swarm.name>>
		<</if>>
	<<else>>
		<<set _swarmname to $swarm.name>>
	<</if>>
	_swarmname
<</widget>>
