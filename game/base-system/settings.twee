:: Widgets Settings [widget]

<<widget "initsettings">>
	/* <<set $player.combatstate to "">> */
	<<set $player.gender to "f">>
	<<set $player.sex to "f">>
	<<startingGenitalsSync>>
	<<set $player.gender_body to "a">>
	<<set $player.bodyshape to "classic">>
	<<set $player.ballsExist to false>>
	<<set $player.skin.faceFreckles to false>>
	<<set $player.skin.bodyFreckles to "none">>
	<<set $player.breastsize to 0>>
	<<set $player.penissize to 5>>
	<<set $facestyle to "default">>
	<<set $bodysize to 2>>
	<<set $mouthsensitivity to 1>>
	<<set $breastsensitivity to 1>>
	<<set $bottomsensitivity to 1>>
	<<set $genitalsensitivity to 1>>
	<<set $drunkSensitivity to 1>>
	<<set $facestyle to "default">>
	<<set $facevariant to "default">>
	<<set $eyeselect to "purple">>
	<<set $hairselect to "red">>
	<<set $hairlength to 200>>
	<<set $awareselect to "innocent">>
	/* <<set $background to "waif">> */
	<<set $startingseason to "autumn">>
	<<set $gamemode to "normal">>
	<<set $danceSkillDecay to 0>>
	<<set $settings.femaleNPCPenisChance to 0>>
	<<set $settings.maleNPCVaginaChance to 0>>
	<<set $settings.npcColossalPenisChance to 0>>
	<<set $settings.swarmsEnabled to true>>
	<<set $settings.spidersEnabled to true>>
	<<set $settings.slugsEnabled to true>>
	<<set $settings.maggotsEnabled to true>>
	<<set $settings.waspsEnabled to true>>
	<<set $settings.beesEnabled to true>>
	<<set $settings.lurkersEnabled to true>>
	<<set $settings.bodyWritingLevel to 3>>
	<<set $settings.npcMakeupLevel to 2>>
	<<set $settings.npcChastityLevel to 2>>
	<<set $settings.parasitesEnabled to true>>
	<<set $settings.ruinedOrgasmEnabled to true>>
	<<set $settings.smallPenisSemenVolumeLossDisabled to false>>
	<<set $settings.femaleClimaxAlways to false>>
	<<set $settings.clearClimaxEnabled to false>>
		<<set $settings.slimesEnabled to true>>
	<<set $settings.earSlimesEnabled to true>>
	<<set $settings.earSlimeThoughts to false>>
	<<set $settings.voreEnabled to true>>
	<<set $settings.tentaclesEnabled to true>>
	<<set $settings.plantsEnabled to true>>
	<<set $settings.analEnabled to true>>
	<<set $settings.analDoubleEnabled to true>>
	<<set $settings.analingusGivingEnabled to true>>
	<<set $settings.analingusReceivingEnabled to true>>
	<<set $settings.vaginalDoubleEnabled to true>>
	<<set $settings.transformAnimalEnabled to true>>
	<<set $settings.transformDivineEnabled to true>>
	/*<<set $hirsutedisable to "t">>*/
	<<set $settings.pubicHairEnabled to false>>
	<<set $settings.breastFeedingEnabled to true>>
	<<set $settings.lactationFlatChestEnabled to false>>
	<<set $settings.parasitePregnancyEnabled to true>>
	<<set $settings.asphyxiaLevel to 3>>
	<<set $settings.nudeGenderPerception to 1>>
	<<set $settings.npcVirginChanceStudent to 50>>
	<<set $settings.npcVirginChanceAdult to 10>>
	<<set $settings.footFetishEnabled to true>>
	<<set $settings.toyWhipEnabled to true>>
	<<set $settings.toyDildoEnabled to true>>
	<<set $settings.toyVirginityEnabled to false>>
	<<set $settings.toyMultiplePenetrationEnabled to true>>
	<<set $multiOrgasmGender to "all">>
	<<set $multiOrgasmChance to 20>>
	<<set $NNPCMultiOrgasmGender to "all">>
	<<set $postCombatStats to 0>>
	<<set $settings.pregnancySpeechEnabled to true>>
	<<set $settings.hypnosisEnabled to true>>
	<<set $settings.blindStatsEnabled to false>>
	<<set $cheatsEnabled to false>>
	<<set $settings.watersportsEnabled to false>>
	<<set $settings.facesitEnabled to true>>
	<<set $ruffledisable to "f">>
	<<set $settings.forcedCrossdressingEnabled to true>>
	<<set $settings.arousalMoanEnabled to true>>
	<<set $saveName to "">>
	<<set $settings.skillCheckStyle to "words">>
	<<set $settings.namedBeasts to {
		blackwolf: {monsterChance: 50, hallucinationsOnly: true},
		greathawk: {monsterChance: 50, hallucinationsOnly: true},
		nightmonster: {monsterChance: 50, hallucinationsOnly: true}
	}>>
	<<set $reducedLineHeight to false>>
	<<set $settings.clothingCostModifier to 1>>
	<<set $settings.underwearCostModifier to 1>>
	<<set $settings.schoolClothingCostModifier to 1>>
	<<set $settings.lewdClothingCostModifier to 1>>
	<<set $settings.furnitureCostModifier to 1>>
	<<set $settings.basePlayerPregnancyChance to 2>>
	<<set $settings.baseNpcPregnancyChance to 8>>
	<<set $settings.humanPregnancyMonths to 3>>
	<<set $settings.wolfPregnancyWeeks to 4>>
	<<set $settings.birdPregnancyWeeks to 3>>
	<<set $settings.playerPregnancyHumanEnabled to true>>
	<<set $settings.playerPregnancyBeastEnabled to true>>
	<<set $settings.playerPregnancyEggLayingEnabled to true>>
	<<set $settings.npcPregnancyEnabled to true>>
	<<set $settings.nnpcPregnancyEnabled to true>>
	<<set $settings.analPregnancy to false>>
	<<set $settings.npcAnalPregnancyEnabled to false>>
	<<set $settings.incompletePregnancyEnabled to false>>
	<<set $settings.fertilityCycleEnabled to true>>
	<<set $settings.pregnancyType to "realistic">>
	<<set $settings.realisticChildbirthEnabled to false>>
	<<set $settings.rentCostModifier to 1>>
	<<set $settings.inflationEnabled to true>>
	<<set $settings.inflationBaileyRelentless to false>>
	<<script>>setup.inflation?.applyPreset?.("current");<</script>>
	<<set $settings.condomLevel to 3>>
	<<set $settings.condomChance to 60>>
	<<set $settings.condomUseChanceRape to 33>>
	<<set $settings.condomUseChanceConsensual to 83>>
	<<set $settings.playerCondomBreakChance to 0>>
	<<set $settings.npcCondomBreakChance to 0>>
	<<set $settings.multipleWardrobes to "isolated">>
	<<set $settings.tendingYieldModifier to 5>>
	<<set $notifyUpdate = true>>
	<<set $disableAutoSelect to false>>
	<<set $ModExclusiveLIEnabled to $ModExclusiveLIEnabled is undefined ? 0 : $ModExclusiveLIEnabled>>
	<<run ensureModLISettings()>>
	<<set _tan to 0>>
	<<set $settings.skinToneMin to 0>>
	<<set $settings.skinToneMode to 50>>
	<<set $settings.skinToneMax to 100>>

	<<startingPlayerImageReset>>
<</widget>>

<<widget "startingGenitalsSync">>
	/* Keeps the character-creation mannequin's genitals in sync with the Genitals radio; player.penisExist/vaginaExist otherwise aren't set until variablesStart2 runs on Start2, after creation ends. */
	<<if $player.sex is "f">>
		<<set $player.vaginaExist to true>>
		<<set $player.penisExist to false>>
		<<set $player.ballsExist to false>>
	<<elseif $player.sex is "m">>
		<<set $player.vaginaExist to false>>
		<<set $player.penisExist to true>>
		<<set $player.ballsExist to true>>
	<</if>>
<</widget>>

<<widget "displaySettings">>
	<<if _args[0]>>
		<<set $currentSettings to _args[0]>>
	<</if>>
	<<if $passage isnot "Start" and ["characterSettings", "featSettings"].includes($currentSettings)>>
		<<set $currentSettings to "gameSettings">>
	<</if>>
	<<switch $currentSettings>>
		<<case "quickStart" "tweak">><<replace #settingsDiv>><<quickStart>><</replace>>
		<<case "characterSettings" "character">>
			<<replace #settingsDiv>><<characterSettings>><</replace>>
			<<if StartConfig.enableImages and $passage is "Start">><<startingPlayerImageUpdate>><<removeclass #startingPlayerImage "hidden">><</if>>
		<<case "featSettings" "feat">><<replace #settingsDiv>><<featSettings>><</replace>>
		<<case "gameSettings" "game">><<replace #settingsDiv>><<gameSettings>><</replace>>
		<<case "dolpSettings" "dolp">><<replace #settingsDiv>><<dolpSettings>><</replace>>
		<<case "sizeLimitsSettings" "size">><<replace #settingsDiv>><<sizeLimitsSettings>><</replace>>
		<<case "npcSettings" "npc">><<replace #settingsDiv>><<npcSettings>><</replace>>
		<<case "exportsettings" "export">><<replace #settingsDiv>><<exportsettings>><</replace>>
		<<case "gallerySettings" "gallery">><<replace #settingsDiv>><<gallerySettings>><</replace>>
		<<case "importConfirmDetails">><<replace #settingsDiv>><<importConfirmDetails>><</replace>>
		<<case "startDescriptions">><<startDescriptions>>
		<<default>><<replace #settingsDiv>><<gameSettings>><</replace>>
	<</switch>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "displaySubsection">>
	<<if _args[0]>>
		<<set $currentSubsection to _args[0]>>
	<</if>>
	<<switch $currentSubsection>>
		<<case "humanSettings">><<set _subsection to "human">><<replace #subsectionDiv>><<humanSettings>><</replace>>
		<<case "npcSettings">><<set _subsection to "npc">><<replace #subsectionDiv>><<npcSettings>><</replace>>
		<<case "beastSettings">><<set _subsection to "beast">><<replace #subsectionDiv>><<beastSettings>><</replace>>
		<<case "fetishSettings">><<set _subsection to "fetish">><<replace #subsectionDiv>><<fetishSettings>><</replace>>
		<<case "priceSettings">><<set _subsection to "price">><<replace #subsectionDiv>><<priceSettings>><</replace>>
		<<case "pregnancySettings">><<set _subsection to "pregnancy">><<replace #subsectionDiv>><<pregnancySettings>><</replace>>
		<<case "wliSettings">><<set _subsection to "wli">><<replace #subsectionDiv>><<wliSettings>><</replace>>
		<<case "sizeLimitsSettings">><<set _subsection to "sizeLimits">><<replace #subsectionDiv>><div class="solidBorderContainer settings-container"><<sizeLimitsSettings>></div><</replace>>
		<<default>><<set _subsection to "human">><<replace #subsectionDiv>><<humanSettings>><</replace>>
	<</switch>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "displayDoLP">>
	<<if _args[0]>>
		<<set $currentDoLP to _args[0]>>
	<</if>>
	<<switch $currentDoLP>>
		<<case "rebalanceSettings">><<set _dolp to "rebalance">><<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
		<<case "npcDoLPSettings">><<set _dolp to "npcDoLP">><<replace #subsectionDiv>><<npcDoLPSettings>><</replace>>
		<<case "beastDoLPSettings">><<set _dolp to "beastDoLP">><<replace #subsectionDiv>><<beastDoLPSettings>><</replace>>
		<<case "combatExtendedSettings">><<set _dolp to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
		<<case "amcTraitsSettings">><<set _dolp to "amcTraits">><<replace #subsectionDiv>><<amcTraitsSettings>><</replace>>
		<<case "xchangeSettings">><<set _subsection to "xchange">><<replace #subsectionDiv>><<xchangeSettings>><</replace>>
		<<case "identitySettings">><<set _subsection to "identity">><<replace #subsectionDiv>><<identitySettings>><<lockInIdentitySetting>><</replace>>	
		<<default>><<set _dolp to "rebalance">><<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
	<</switch>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "startOptionsComplexityButton">>
	<div @class="_selectedStart is _args[1] ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button _args[0]>>
			<<set _selectedStart to _args[1]>>
			<<set _settingsTab to "startDescriptions">>
			<<replace #startOptions>><<startOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "settingsTabButton">>
	<div @class="_settingsTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'" >
		<<button _args[0]>>
			<<set _settingsTab to _settingsTab is _args[1] ? "startDescriptions" : _args[1]>>
			<<if _args[1] is "game">><<set _subsection to "human">><</if>>
			<<replace #startOptions>><<startOptions>><</replace>>
			<<displaySettings _settingsTab>>
		<</button>>
	</div>
<</widget>>

<<widget "startOptions">>
	<div class="containerStart">
		<div id="startSelectionDefault" class="buttonSettings">
			<<startOptionsComplexityButton "기본" "default">>
		</div>

		<div id="startSelectionCustom" class="buttonSettings">
			<<startOptionsComplexityButton "커스텀" "custom">>
		</div>

		<div id="startSelectionRandom" class="buttonSettings">
			<<startOptionsComplexityButton "무작위" "random">>
		</div>
	</div>

	<hr>
	<<set _featTabName to "업적 부스터<span class='red'> *</span>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : "")>>
	<<switch _selectedStart>>
		<<case "default">>
			<div class="containerStart">
				<<settingsTabButton "캐릭터 생성<span class='red'> *</span>" "character">>
				<<settingsTabButton _featTabName "feat">>
				<<settingsTabButton "갤러리" "gallery">>
				<<settingsTabButton "설정 내보내기/불러오기" "export">>
			</div>
		<<case "custom">>
			<div class="containerStart">
				<<settingsTabButton "캐릭터 생성<span class='red'> *</span>" "character">>
				<<settingsTabButton "게임 설정" "game">>
				<<settingsTabButton "모드 설정" "dolp">>
				<<settingsTabButton _featTabName "feat">>
				<<settingsTabButton "갤러리" "gallery">>
				<<settingsTabButton "설정 내보내기/불러오기" "export">>
			</div>
		<<case "random">>
			<div class="containerStart">
				<<settingsTabButton _featTabName "feat">>
				<<settingsTabButton "갤러리" "gallery">>
			</div>
	<</switch>>
	<div id="settingsDiv">
		<<switch $currentSettings>>
			<<case "featSettings" "feat">><<featSettings>>
			<<default>><<startDescriptions _selectedStart>>
		<</switch>>
	</div>
<</widget>>

<<widget "settingsStart">>
	<<updatehistorycontrols>><!-- hides controls on going back in history after enabling that option -->
	<<set $settings.cheatsEnabledToggle to $cheatsEnabled>>
	<<if _selectedStart is undefined>>
		<<set _selectedStart to "default">>
	<</if>>

	<div class="start-shell">
		<div class="start-heading"><p class="gold m-0">설정을 선택하십시오:</p></div>
		<div id="startOptions" class="no-numberify">
			<<startOptions>>
		</div>
		<br>

		<div id="settingsExit">
			<<settingsExit>>
		</div>
	</div>
<</widget>>


<<widget "settingsOptions">>
<<if _selectedSettings is undefined>><<set _selectedSettings to "quick">><</if>>
<div class="containerStart">
	<div @class="_selectedSettings is 'quick' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "빠른 편집">>
			<<set _selectedSettings to "quick">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "quickStart">>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'game' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "게임 설정">>
			<<set _selectedSettings to "game">>
			<<set _subsection to "human">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "gameSettings">>
			/* Resets Quick edit temporary values, to make them reflect current settings as closely as they can */
			<<unset _pregnancytype>>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'dolp' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "모드 설정">>
			<<set _selectedSettings to "dolp">>
			<<set _dolp to "rebalance">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "dolpSettings">>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'gallery' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "갤러리">>
			<<set _selectedSettings to "gallery">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "gallerySettings">>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'export' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "설정 내보내기/불러오기">>
			<<set _selectedSettings to "export">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "exportsettings">>
		<</button>>
	</div>
</div>
<</widget>>

<<widget "settings">>
	<<updatehistorycontrols>><!-- hides controls on going back in history after enabling that option -->
	<<set $settings.cheatsEnabledToggle to $cheatsEnabled>>
	<div id="settingsOptions" class="no-numberify">
		<<settingsOptions>>
	</div>
	<div id="settingsDiv" class="no-numberify">
		<<quickStart>><<set $currentSettings to "quickStart">>
	</div>
	<br>
	<div id="settingsExit">
		<<settingsExit>>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "settingsExit">>
	<<saveNameSection>>
	<div style="margin-top:15px">
	<<if $passage is "Start">>
		<<switch _selectedStart>>
			<<case "default">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>기본값</i></div>
				<<button "게임 시작">>
					<<run applyKinkPreset(_kinkPreset)>>
					<<run applyMonstersPreset(_monstersPreset)>>
					<<if _namedNpcPreset isnot "namedNpcDefaultGender">><<presets _namedNpcPreset "save">><</if>>
					<<if _pregnancytype is "disabled">>
						<<set $settings.playerPregnancyHumanEnabled to false>>
						<<set $settings.playerPregnancyBeastEnabled to false>>
						<<set $settings.playerPregnancyEggLayingEnabled to false>>
						<<set $settings.npcPregnancyEnabled to false>>
						<<set $settings.nnpcPregnancyEnabled to false>>
					<<else>>
						<<set $settings.pregnancyType to _pregnancytype or "realistic">>
						<<set $settings.playerPregnancyHumanEnabled to true>>
						<<set $settings.npcPregnancyEnabled to true>>
						<<set $settings.nnpcPregnancyEnabled to true>>
					<</if>>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $settings.tendingYieldModifier lte 5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4)) and ($feats.pregnancySillyLocked or $settings.pregnancyType isnot "silly")>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
				<div class="small-description my-2" style>
					NPC 성별이나 야수 외형 같은 대부분의 설정은 나중에 당신의 침실에 있는 <span class="gold">게임플레이 설정</span> 링크를 통해 바꿀 수 있습니다. <span class="red">단, 게임이 시작된 후에는 캐릭터의 성기나 업적 부스터를 변경할 수 없습니다.</span>
				</div>
			<<case "custom">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>커스텀</i></div>
				<<button "게임 시작">>
					<<lockInIdentity>>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $statGainMult lte 100 and $npcHealthMult gte 100 and $nnpcHealthMult gte 100 and $beastHealthMult gte 100 and $tentacleHealthMult gte 100 and $struggleHealthMult gte 100 and $combatExtended.enemyDamageMult gte 100 and $settings.tendingYieldModifier lte 6.5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4)) and ($feats.pregnancySillyLocked or $settings.pregnancyType isnot "silly")>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
				<div class="small-description my-2">
					NPC 성별이나 야수 외형 같은 대부분의 설정은 나중에 당신의 침실에 있는 <span class="gold">게임플레이 설정</span> 링크를 통해 바꿀 수 있습니다. <span class="red">단, 게임이 시작된 후에는 캐릭터의 성기나 업적 부스터를 변경할 수 없습니다.</span>
				</div>
			<<case "random">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>무작위</i></div>
				<<button "게임 시작">>
						/*Rerolls all settings*/
					<<presets "randomize" "characterSettings" `randomizeSettings()`>>
					<<lockInIdentity>>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $statGainMult lte 100 and $npcHealthMult gte 100 and $nnpcHealthMult gte 100 and $beastHealthMult gte 100 and $tentacleHealthMult gte 100 and $struggleHealthMult gte 100 and $combatExtended.enemyDamageMult gte 100 and $settings.tendingYieldModifier lte 6.5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4)) and ($feats.pregnancySillyLocked or $settings.pregnancyType isnot "silly")>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #startOptions>><<startOptions>><</replace>>
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
				<div class="small-description my-2">
					NPC 성별이나 야수 외형 같은 대부분의 설정은 나중에 당신의 침실에 있는 <span class="gold">게임플레이 설정</span> 링크를 통해 바꿀 수 있습니다. <span class="red">단, 게임이 시작된 후에는 캐릭터의 성기나 업적 부스터를 변경할 수 없습니다.</span>
				</div>
		<</switch>>
	<<else>>
		<<button "변경사항 저장">>
			<<if $identity.init is 1>><<lockInIdentity>><</if>>
			<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $statGainMult lte 100 and $npcHealthMult gte 100 and $nnpcHealthMult gte 100 and $beastHealthMult gte 100 and $tentacleHealthMult gte 100 and $struggleHealthMult gte 100 and $combatExtended.enemyDamageMult gte 100 and $settings.tendingYieldModifier lte 6.5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4)) and ($feats.pregnancySillyLocked or $settings.pregnancyType isnot "silly")>>
				<<settingsExitFunction>>
			<<else>><!-- confirm cheats -->
				<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
			<</if>>
		<</button>>
	<</if>>
	</div>
<</widget>>

<<widget "settingsExitConfirm">>
	<<if _selectedStart is "random">>
		<span class="red">무작위 생성 설정으로 인해 특정 업적을 얻을 수 없게 되었습니다.</span>
		<ul>
			<<if $settings.cheatsEnabledToggle is true>><li>치트 활성화: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $statGainMult gt 100>><li>능력치 상승 배율 증가: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $npcHealthMult lt 100>><li>NPC 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $nnpcHealthMult lt 100>><li>네임드 NPC 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $beastHealthMult lt 100>><li>짐승 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $tentacleHealthMult lt 100>><li>촉수 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $struggleHealthMult lt 100>><li>발버둥 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $combatExtended.enemyDamageMult lt 100>><li>적 피해 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.rentCostModifier lt 1>><li>상납금 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.tendingYieldModifier gt 6.5>><li>작물 수확량 증가: 모든 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $gamemode is "soft">><li>이지 모드: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $settings.allureModifier lt 1>><li>매력 보정 감소: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>><li>인간 임신 기간이 3개월 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>><li>늑대 임신 기간이 4주 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancySillyLocked and $settings.pregnancyType is "silly">><li>임신 모드가 "엉뚱함"으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
		</ul>
		이 변경사항을 유지하시겠습니까?
		<br>
		<<button "아니오">>
			<<set $settings.cheatsEnabledToggle to false>>
			<<if $gamemode is "soft">>
				<<set $gamemode to "normal">>
			<</if>>
			<<if $statGainMult gt 100>>
				<<set $statGainMult to 100>>
			<</if>>
			<<if $npcHealthMult lt 100>>
				<<set $npcHealthMult to 100>>
			<</if>>
			<<if $nnpcHealthMult lt 100>>
				<<set $nnpcHealthMult to 100>>
			<</if>>
			<<if $beastHealthMult lt 100>>
				<<set $beastHealthMult to 100>>
			<</if>>
			<<if $tentacleHealthMult lt 100>>
				<<set $tentacleHealthMult to 100>>
			<</if>>
			<<if $struggleHealthMult lt 100>>
				<<set $struggleHealthMult to 100>>
			<</if>>
			<<if $combatExtended.enemyDamageMult lt 100>>
				<<set $combatExtended.enemyDamageMult to 100>>
			<</if>>
			<<if $settings.allureModifier lt 1>>
				<<set $settings.allureModifier to 1>>
			<</if>>
			<<if $settings.rentCostModifier lt 1>>
				<<set $settings.rentCostModifier to 1>>
			<</if>>
			<<if $settings.tendingYieldModifier gt 6.5>>
				<<set $settings.tendingYieldModifier to 6.5>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>>
				<<set $settings.humanPregnancyMonths to 3>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>>
				<<set $settings.wolfPregnancyWeeks to 4>>
			<</if>>
			<<if !$feats.pregnancySillyLocked and $settings.pregnancyType is "silly">>
				<<set $settings.pregnancyType to "realistic">>
			<</if>>
			<<displaySettings "startDescriptions">>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
		<br>
		<span class="gold small-description">(이 변경사항을 실행 취소하여 설정을 다시 뽑습니다.)</span>
		<br><br>
		<<button "예">>
			<<settingsExitFunction>>
		<</button>>
		<br>
		<span class="red small-description">(이 세이브 파일에서 업적 달성이 비활성화됩니다.)</span>

	<<else>>
		<span class="red">선택하신 설정으로 인해 더 이상 업적을 얻을 수 없게 됩니다.</span>

		<ul>
			<<if $settings.cheatsEnabledToggle is true>><li>치트 활성화: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $statGainMult gt 100>><li>능력치 상승 배율 증가: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $npcHealthMult lt 100>><li>NPC 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $nnpcHealthMult lt 100>><li>네임드 NPC 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $beastHealthMult lt 100>><li>짐승 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $tentacleHealthMult lt 100>><li>촉수 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $struggleHealthMult lt 100>><li>발버둥 체력 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $combatExtended.enemyDamageMult lt 100>><li>적 피해 배율 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.rentCostModifier lt 1>><li>상납금 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.tendingYieldModifier gt 6.5>><li>작물 수확량 증가: 모든 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $gamemode is "soft">><li>이지 모드: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $settings.allureModifier lt 1>><li>매력 보정 감소: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>><li>인간 임신 기간이 3개월 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>><li>늑대 임신 기간이 4주 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancySillyLocked and $settings.pregnancyType is "silly">><li>임신 모드가 "엉뚱함"으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
		</ul>
		이 변경사항을 유지하시겠습니까?
		<br>
		<<button "아니오">>
			<<set $settings.cheatsEnabledToggle to false>>
			<<if $gamemode is "soft">>
				<<set $gamemode to "normal">>
			<</if>>
			<<if $statGainMult gt 100>>
				<<set $statGainMult to 100>>
			<</if>>
			<<if $npcHealthMult lt 100>>
				<<set $npcHealthMult to 100>>
			<</if>>
			<<if $nnpcHealthMult lt 100>>
				<<set $nnpcHealthMult to 100>>
			<</if>>
			<<if $beastHealthMult lt 100>>
				<<set $beastHealthMult to 100>>
			<</if>>
			<<if $tentacleHealthMult lt 100>>
				<<set $tentacleHealthMult to 100>>
			<</if>>
			<<if $struggleHealthMult lt 100>>
				<<set $struggleHealthMult to 100>>
			<</if>>
			<<if $combatExtended.enemyDamageMult lt 100>>
				<<set $combatExtended.enemyDamageMult to 100>>
			<</if>>
			<<if $settings.allureModifier lt 1>>
				<<set $settings.allureModifier to 1>>
			<</if>>
			<<if $settings.rentCostModifier lt 1>>
				<<set $settings.rentCostModifier to 1>>
			<</if>>
			<<if $settings.tendingYieldModifier gt 6.5>>
				<<set $settings.tendingYieldModifier to 6.5>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>>
				<<set $settings.humanPregnancyMonths to 3>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>>
				<<set $settings.wolfPregnancyWeeks to 4>>
			<</if>>
			<<if !$feats.pregnancySillyLocked and $settings.pregnancyType is "silly">>
				<<set $settings.pregnancyType to "realistic">>
			<</if>>
			<<if _settingsTab is 'tweak'>>
				<<replace #gameModeQuick>><<gameMode>><</replace>>
			<<elseif _settingsTab is 'game'>>
				<<replace #gameMode>><<gameMode>><</replace>>
			<</if>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
		<br>
		<span class="gold small-description">(이 변경사항을 실행 취소하여 업적을 얻을 수 있게 합니다.)</span>
		<br><br>
		<<button "예">>
			<<settingsExitFunction>>
		<</button>>
		<br>
		<span class="red small-description">(이 세이브 파일에서 업적 달성이 비활성화됩니다.)</span>
	<</if>>
<</widget>>

<<widget "settingsExitConfirmHistory">>
	<span class="red"><b>경고! 기록 저장 깊이 설정값이 너무 높습니다!</b><br>
	설정값이 5를 넘으면 새로운 세이브 파일을 만들 때 오류가 생길 수 있습니다! 계속 진행하려면 이 기능을 확실히 이해하고 진행하시거나, 설정값을 낮추십시오!
	</span>
	<br>
	<<link "기능 비활성화">>
		<<set $options.maxStates to 1>>
		<<replace #settingsExit>><<settingsExit>><</replace>>
		<<displaySettings>>
	<</link>>
	<br>
	<<link "안전한 수치로 설정값 낮추기">>
		<<set $options.maxStates to 5>>
		<<replace #settingsExit>><<settingsExit>><</replace>>
		<<displaySettings>>
	<</link>>
	<br><br><br>
	<<link "내 발등을 내가 찍겠습니다">>
		<<settingsExitFunction>>
	<</link>>
<</widget>>

<<widget "settingsExitFunction">>
	<<set $npcHealthMult to Math.clamp($npcHealthMult, 1, 1000000)>>
	<<set $npcArousalMult to Math.clamp($npcArousalMult, 1, 1000000)>>
	<<set $nnpcHealthMult to Math.clamp($nnpcHealthMult, 1, 1000000)>>
	<<set $nnpcArousalMult to Math.clamp($nnpcArousalMult, 1, 1000000)>>
	<<set $beastHealthMult to Math.clamp($beastHealthMult, 1, 1000000)>>
	<<set $beastArousalMult to Math.clamp($beastArousalMult, 1, 1000000)>>
	<<set $tentacleHealthMult to Math.clamp($tentacleHealthMult, 1, 1000000)>>
	<<set $struggleHealthMult to Math.clamp($struggleHealthMult, 1, 1000000)>>
	<<set $combatExtended.enemyDamageMult to Math.clamp($combatExtended.enemyDamageMult, 25, 300)>>
	<<set $combatExtended.enemyLevelDayScalingMult to Math.clamp($combatExtended.enemyLevelDayScalingMult, 1, 1000000)>>
	<<set $combatExtended.enemyHealthDayScalingMult to Math.clamp($combatExtended.enemyHealthDayScalingMult, 1, 1000000)>>
	<<set $combatExtended.enemyDayScaling to Math.clamp($combatExtended.enemyDayScaling, 1, 1000000)>>
	<<set $combatExtended.enemyDayScalingLimit to Math.clamp($combatExtended.enemyDayScalingLimit, 1, 1000000)>>
	<<set $combatExtended.enemyLevelDefeatScalingMult to Math.clamp($combatExtended.enemyLevelDefeatScalingMult, 1, 1000000)>>
	<<set $combatExtended.enemyHealthDefeatScalingMult to Math.clamp($combatExtended.enemyHealthDefeatScalingMult, 1, 1000000)>>
	<<set $combatExtended.enemyDefeatScaling to Math.clamp($combatExtended.enemyDefeatScaling, 1, 1000000)>>
	<<set $combatExtended.enemyDefeatScalingLimit to Math.clamp($combatExtended.enemyDefeatScalingLimit, 1, 1000000)>>
	<<modParasiteCapUpdate>>
	<<amcTraitsUpdate>>
	<<modWardrobeUpdate>>
	<<if !$ironmanmode>>
		<<set $cheatsEnabled to $settings.cheatsEnabledToggle>>
	<</if>>
	<<if $cheatsEnabled is true or $settings.rentCostModifier lt 1 or $statGainMult gt 100 or $npcHealthMult lt 100 or $nnpcHealthMult lt 100 or $beastHealthMult lt 100 or $tentacleHealthMult lt 100 or $struggleHealthMult lt 100 or $combatExtended.enemyDamageMult lt 100 or $settings.tendingYieldModifier gt 6.5>>
		<<set $feats.locked to true>>
	<</if>>
	<<unset $settings.cheatsEnabledToggle>>
	<<if $gamemode is "soft" or $settings.allureModifier lt 1>>
		<<set $feats.soft to true>>
	<</if>>
	<<if $settings.humanPregnancyMonths lt 3 or $settings.wolfPregnancyWeeks lt 4>>
		<<set $feats.pregnancyLocked to true>>
	<</if>>
	<<if $settings.pregnancyType is "silly">>
		<<set $feats.pregnancySillyLocked to true>>
	<</if>>
	<<updatehistorycontrols>>
	<<if _namedNpcPreset isnot "namedNpcDefaultGender">><<presets _namedNpcPreset "save">><</if>>
	<<initnpcgender>>
	<<if _namedNpcFemaleGenitals and _namedNpcFemaleGenitals isnot "random">>
		<<assignNPCGenitalsByPronounCore "f" _namedNpcFemaleGenitals true>>
	<</if>>
	<<if _namedNpcMaleGenitals and _namedNpcMaleGenitals isnot "random">>
		<<assignNPCGenitalsByPronounCore "m" _namedNpcMaleGenitals true>>
	<</if>>
	<<updatePersistentNPCs>>
	<<hirsuteHideCheck>>
	<<generateTipsList>>
	<<if $player.skin.faceFreckles is "random">>
		<<set $player.skin.faceFreckles to (random(1, 5) is 1)>>
	<</if>>
	<<if $player.skin.bodyFreckles is "random">>
		<<set $player.skin.bodyFreckles to either("none", "none", "none", "upper", "full")>>
	<</if>>
	/* Reseeds named NPC cycle data in case the incomplete pregnancy content setting changed */
	<<npcPregnancyUpdater>>

	<!-- Init shop mannequin gender -->
	<<if $mannequinHasPenis is undefined>>
		<<set $mannequinHasPenis to $player.penisExist>>
		<<set $mannequinBreastsSize to ($mannequinHasPenis ? 0 : 3)>>
	<</if>>
	<<if $settings.lewdClothingCostModifier lt Math.ceil(10 / $settings.clothingCostModifier) * 0.1>>
		<<set $settings.lewdClothingCostModifier to parseFloat((Math.ceil(10 / $settings.clothingCostModifier) * 0.1).toFixed(1))>>
	<</if>>
	<<set _settingsExitPassage to clone($settingsExitPassage)>>
	<<unset $settingsExitPassage>>
	<<run State.display(_settingsExitPassage)>>
	<<set $saveName to $saveName.replace(/[^a-zA-Z\u4e00-\u9fa5 0-9]+/g,"")>>
	<<unset $importString>>

	/* Updates the penis max size for females so its never below Normal (4 in the 0..6 scheme, was 2 in the old -2..4 scheme) */
	<<if $player.sex is "f" && $penissizemax < 4>>
		<<set $penissizemax to 4>>
	<</if>>

	<<for _name range setup.NPCNameList>>
		<<set _nameReal to _name>>
		<<set _nnpcKey to _name.toLowerCase().split(" ").join("_")>>

		<<if $options.autoNNPCDisplay is undefined>>
			<<run console.warn("[settingsExitFunction] autoNNPCDisplay is missing. It should be initialised in variables-modUpdate.", _nameReal, _nnpcKey)>>
		<<else>>
			/* create missing display entry for modded/new NNPCs on old saves */
			<<if $options.autoNNPCDisplay[_nnpcKey] is undefined>>
				<<set $options.autoNNPCDisplay[_nnpcKey] to {}>>
			<</if>>
			<<if $options.autoNNPCDisplay[_nnpcKey].slot is undefined>>
				<<set $options.autoNNPCDisplay[_nnpcKey].slot to 1>>
			<</if>>
			<<if $options.autoNNPCDisplay[_nnpcKey].layer is undefined>>
				<<set $options.autoNNPCDisplay[_nnpcKey].layer to "front">>
			<</if>>
			<<if $options.autoNNPCDisplay[_nnpcKey].genderOverride is undefined>>
				<<set $options.autoNNPCDisplay[_nnpcKey].genderOverride to false>>
			<</if>>

			/* Guard in case an entry exists in setup.NPCNameList but C.npc data is missing */
			<<if C.npc[_nameReal] is undefined>>
				<<run console.warn("[settingsExitFunction] Missing C.npc entry while syncing autoNNPCDisplay gender.", _nameReal, _nnpcKey)>>
			<<elseif C.npc[_nameReal].pronoun is "m">>
				<<set $options.autoNNPCDisplay[_nnpcKey].gender to "male">>
			<<else>>
				<<set $options.autoNNPCDisplay[_nnpcKey].gender to "female">>
			<</if>>
		<</if>>
	<</for>>
<</widget>>

/*complete:{"Vrelnir (Default)":"vrelDefault","Lollipop Scythe":"lollipopScythe","PurityGuy":"purityGuy","Fangi":"fangi"},*/
<<widget "quickStartOptions">>
	<<if _quickStartOptions is undefined>>
		<<set _quickStartOptions to {
			player:{"Female Waif":"femaleWaif","Male Waif":"maleWaif", "Vrelnir PC":"vrel", "Crossdresser":"crossdresser","Tough Guy":"toughGuy"},
			genericNpc:{
				"Default Genders":"genericNpcDefaultGender",
				"All Male":"genericNpcAllMaleGender",
				"75% Male":"genericNpc75MaleGender",
				"All Female":"genericNpcAllFemaleGender",
				"75% Female":"genericNpc75FemaleGender",
				"All Opposite Gender":"genericNpcAllOppositeGenders",
				"90% Opposite Gender":"genericNpc90OppositeGenders",
				"75% Opposite Gender":"genericNpc75OppositeGenders",
				"All Same Gender":"genericNpcAllSameGenders",
				"90% Same Gender":"genericNpc90SameGenders",
				"75% Same Gender":"genericNpc75SameGenders",
			},
			namedNpc:{"Default Genders":"namedNpcDefaultGender", "All Male":"namedNpcAllMaleGender", "All Female":"namedNpcAllFemaleGender"},
			beasts:{
				"Default Genders":"beastDefaultGenders",
				"All Male":"beastMaleGenders",
				"75% Male":"beast75MaleGenders",
				"All Female":"beastFemaleGenders",
				"75% Female":"beast75FemaleGenders",
				"All Opposite Gender":"beastOppositeGenders",
				"90% Opposite Gender":"beast90OppositeGenders",
				"75% Opposite Gender":"beast75OppositeGenders",
				"All Same Gender":"beastSameGenders",
				"90% Same Gender":"beast90SameGenders",
				"75% Same Gender":"beast75SameGenders",
			},
			monsters:{"When Hallucinating":"monstersDefault", "No Monsters":"monstersNone", "All Monsters":"monstersAll"},
			kink:{"Reasonably Debauched":"kinkDefault", "Vanilla":"kinkVanilla", "No Beasts":"kinkNoBeasts", "Everything Goes":"kinkEverything"},
			game:{
				"Normal ":"gameNormal","Soft (No Feats)":"gameSoft","Hard":"gameHard","Hard (Ironman)":"gameHardIronman","Masochist":"gameMasochist","Soft with Cheats (No Feats)":"gameSoftCheats","Normal with Cheats (No Feats)":"gameNormalCheats","Hard with Cheats (No Feats)":"gameHardCheats","Masochist with Cheats (No Feats)":"gameMasochistCheats"
			},
			images:{"Default":"imagesdefault","High Quality":"imagesHigh","Low Quality":"imagesLow","Performance Mode":"imagesPerformance","Disable images":"imagesDisable"},
			settings:{"PC, Tips":"settingPCTip","PC, no Tips":"settingPCNoTip","Mobile, Tips":"settingMobileTips","Mobile, no Tips":"settingMobileNoTips"}
		}>>
	<</if>>
<</widget>>

<<widget "quickStart">>
	<div class="solidBorderContainer settings-container">
		<<quickStartOptions>>
		<div class="settingsToggleIndent">
		<<if $passage is "Start">>
			<i>게임 설정을 대략적으로 바꿉니다. 더 세밀하게 조정하려면 대신 <span class="gold">커스텀 시작</span>을 선택하십시오.</i>
		<<else>>
			<i>게임 설정을 빠르게 변경합니다. 더 세부적으로 조정하려면 <span class="gold">게임 설정</span> 탭을 이용하십시오.</i>
		<</if>>
		</div>

		<div class="settingsGrid">
			<div id="gameModeQuick" class="settingsToggleItem">
				<<gameMode>>
			</div>

			<<if $passage is "Start">>
				<div class="settingsToggleItem">
					<span class="gold">페티시 설정</span>
					<br>
					<<if _kinkPreset is undefined>><<set _kinkPreset to "kinkDefault">><</if>>
					<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">꽤 방탕한<span>기본 설정. 워터스포츠를 제외한 모든 페티시가 활성화됩니다.</span></mouse>
					<<radiobutton "_kinkPreset" "kinkDefault" autocheck>></label> |
					<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">바닐라<span>모든 수인 관련 토글이 비활성화되며, 인간형 식물, 촉수, 슬라임, 모유 수유, 페이스시팅, 이중 삽입, 최면도 비활성화됩니다.</span></mouse>
					<<radiobutton "_kinkPreset" "kinkVanilla" autocheck>></label> |
					<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">수인 없음<span>수인 관련 모든 설정이 비활성화됩니다. 수간, 스웜, 보어, 기생충, 거미, 민달팽이, 말벌, 럴커, 벌, 말 등이 포함됩니다.</span></mouse>
					<<radiobutton "_kinkPreset" "kinkNoBeasts" autocheck>></label> |
					<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">"뭐든지"<span>워터스포츠를 포함한 모든 페티시가 활성화됩니다.</span></mouse>
					<<radiobutton "_kinkPreset" "kinkEverything" autocheck>></label>
				</div>
			<</if>>

			<div class="settingsToggleItem">
				<<set _foundPregnancy to !!Object.values($NPCName || {}).find(npc => npc && npc.pregnancy && npc.pregnancy.enabled && getActivePregnancies(npc.fullDescription).length && !setup.pregnancy.canBePregnant.includes(npc.fullDescription))>>
					<span class="gold">임신 모드</span>
					<br>
					<<if $passage is "Start">>
						<label><<radiobutton "_pregnancytype" "realistic" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "realistic" ? "checked": "")`>> <mouse class="tooltip green">현실적<span>임신이 바로 진행되지 않으며, 임신이 되었는지 즉시 알 수 없습니다. 임신 테스트기를 사용해야 할 수도 있으며, 처음에는 아버지가 누구인지 모를 수 있습니다. 수 시간 안에 씻어내지 않으면 보지 바깥에 묻은 정액으로도 임신할 수 있습니다.</span></mouse></label> |
						<label><<radiobutton "_pregnancytype" "fetish" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "fetish" ? "checked": "")`>> <mouse class="tooltip pink">페티시<span>정액이 몸 안에 들어가는 즉시 임신될 수 있습니다. 임신 사실과 아버지가 누구인지도 곧바로 알게 됩니다.</span></mouse></label> |
						<label><<radiobutton "_pregnancytype" "silly" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "silly" ? "checked": "")`>> <mouse class="tooltip gold">엉뚱함<span>손을 잡거나 입을 맞추는 즉시, 특히 사랑하는 사람과라면 임신할 수 있습니다. <i class="red none">이 모드에서는 스토리 내용과 관련된 문제가 있을 수 있습니다. 이 모드에서는 일부 업적이 비활성화됩니다.</i></span></mouse></label> |
						<label><<radiobutton "_pregnancytype" "disabled" autocheck>> <mouse class="tooltip red">비활성화<span>임신이 비활성화됩니다.<<if $passage isnot "Start">>이미 진행 중인 임신을 막거나 플레이어가 자식과 상호작용하는 것을 막지는 않습니다.<</if>></span></mouse></label>
					<<else>>
						<<pregnancyType>>
					<</if>>
				<br>
				<label>
					<<realisticChildbirth>>
				</label>
				<br>
				<<fertilityCycles>>
				<br>
				<span data-target='["settingsincompletepregnancyenabled", "pregnancytype", "settingsnnpcpregnancyenabled", "settingsplayerpregnancyhumanenabled", "settingsplayerpregnancybeastenabled"]' data-disabledif="(T.foundPregnancy&&V.settings.incompletePregnancyEnabled===true)||T.pregnancytype==='disabled'||(!V.settings.nnpcPregnancyEnabled&&!V.settings.playerPregnancyHumanEnabled&&!V.settings.playerPregnancyBeastEnabled)">
					<<incompletePregnancy>>
				</span>
			</div>

			<div class="settingsToggleItem">
				<<if $passage is "Start">>
					<<quickNpcGenderSlider>>
				<<else>>
					<<npcAttractionSettings>>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<<if $passage is "Start">>
					<<quickBeastGenderSlider>>
				<<else>>
					<<beastAttractionSettings>>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">네임드 NPC 성별</span>
				<mouse class="tooltip linkBlue">(?)<span>변경 사항을 저장하면 설정이 적용됩니다.</span></mouse>
				<br>
				<<if _namedNpcPreset is undefined>><<set _namedNpcPreset to "namedNpcDefaultGender">><</if>>
				<label>모두 남성 <<radiobutton "_namedNpcPreset" "namedNpcAllMaleGender" autocheck>></label> |
				<label><<print $passage is "Start" ? "무작위 성별" : "현재 성별">> <<radiobutton "_namedNpcPreset" "namedNpcDefaultGender" autocheck>></label> |
				<label>모두 여성 <<radiobutton "_namedNpcPreset" "namedNpcAllFemaleGender" autocheck>></label>
			</div>

			<div class="settingsToggleItem">
				<<if $passage is "Start">>
					<<if _monstersPreset is undefined>><<set _monstersPreset to "monstersDefault">><</if>>
					<span class="gold">짐승을 수인 소녀와 소년으로 대체</span>
					<br>
					<label>항상 <<radiobutton "_monstersPreset" "monstersAll" autocheck>></label> |
					<label>환각 상태일 때만 <<radiobutton "_monstersPreset" "monstersDefault" autocheck>></label> |
					<label>사용 안 함 <<radiobutton "_monstersPreset" "monstersNone" autocheck>></label>
				<<else>>
					<<monsterSettings>>
				<</if>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "quickNpcGenderSlider">>
	<span class="gold">일반 NPC 성별</span>
	<<numberslider "$settings.maleChance" $settings.maleChance 0 100 25 {
		onInputChange: v => {
			if (V.settings.maleChanceSplit === true && v === 50) {
				V.settings.maleChanceMale = random (1, 99);
				V.settings.maleChanceFemale = random (1, 99);
				return;
			}
			if (V.settings.maleChanceSplit === true) {
				V.settings.maleChanceMale = 100 - v;
				V.settings.maleChanceFemale = v;
				return;
			}
		},
		value: v => {
			if (V.settings.maleChanceSplit === true) {
				switch (v) {
					case 100:
						return `<span class="small-description">NPC 전원이 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
					case 75:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
					case 50:
						return `<span class="small-description">NPC의 성적 지향이 <span class='gold inline-colour'>무작위로</span> 나뉩니다.</span>`;
					case 25:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
					case 0:
						return `<span class="small-description">NPC 전원이 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
					default:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
				}
			} else {
				switch (v) {
					case 100:
						return `<span class="small-description">NPC 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
					case 75:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">NPC의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 25:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
					case 0:
						return `<span class="small-description">NPC 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
					default:
						return `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
				}
			}
		},
	}>>
		<span id="humanSplitBy"><<humanSplitBy>></span>
<</widget>>

<<widget "quickBeastGenderSlider">>
	<span class="gold">짐승 성별</span>
	<<numberslider "$genericBeastSettings.beastMaleChance" $genericBeastSettings.beastMaleChance 0 100 25 {
		onInputChange: v => {
			setAllBeastsMaleChance(v);
			if (V.genericBeastSettings.beastMaleChanceSplit === true && v === 50) {
				setAllBeastsMaleChanceMale(V.genericBeastSettings.beastMaleChanceMale = random (1, 99));
				setAllBeastsMaleChanceFemale(V.genericBeastSettings.beastMaleChanceFemale = random (1, 99));
				return;
			}
			if (V.genericBeastSettings.beastMaleChanceSplit === true) {
				setAllBeastsMaleChanceMale(V.genericBeastSettings.beastMaleChanceMale = 100 - v);
				setAllBeastsMaleChanceFemale(V.genericBeastSettings.beastMaleChanceFemale = v);
				return;
			}
		},
		value: v => {
			if (V.genericBeastSettings.beastMaleChanceSplit === true) {
				switch (v) {
					case 100:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> 짐승이 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
					case 75:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
					case 50:
						return `<span class="small-description">짐승의 성적 지향이 <span class='gold inline-colour'>무작위로</span> 나뉩니다.</span>`;
					case 25:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
					case 0:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> 짐승이 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
					default:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>${v}%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
				}
			} else {
				switch (v) {
					case 100:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> 짐승이 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
					case 75:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>75%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">짐승의 성비가 <span class='blue inline-colour'>수컷</span>과 <span class='pink inline-colour'>암컷</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 25:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>75%</span>가 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
					case 0:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> 짐승이 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
					default:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>" + ${v} + "%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
				}
			}
		},
	}>>
	<span id="beastSplitBy"><<beastSplitBy>></span>
<</widget>>
<<widget "humanSplitByFull">>
	<<link `$settings.maleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.maleChanceSplit to $settings.maleChanceSplit is true ? false : true>>
		<<toggleclass "#simpleGenders" "hidden">>
		<<replace "#splitGenders">><<maleChanceSplitControls>><</replace>>
		<<toggleclass "#splitGenders" "hidden">>
		<<replace "#humanSplitByFull">><<humanSplitByFull>><</replace>>
	<</link>>
<</widget>>

<<widget "beastSplitByFull">>
	<<link `$genericBeastSettings.beastMaleChanceSplit ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $genericBeastSettings.beastMaleChanceSplit to !$genericBeastSettings.beastMaleChanceSplit>>
		<<run setAllBeastsMaleChanceSplit($genericBeastSettings.beastMaleChanceSplit)>>
		<<toggleclass "#simpleBeastGenders" "hidden">>
		<<replace "#splitBeastGenders">><<beastMaleChanceSplitControls>><</replace>>
		<<toggleclass "#splitBeastGenders" "hidden">>
		<<replace "#beastSplitByFull">><<beastSplitByFull>><</replace>>
	<</link>>
<</widget>>

<<widget "humanSplitBy">>
	<<link `$settings.maleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.maleChanceSplit to $settings.maleChanceSplit is true ? false : true>>
		<<replace "#humanSplitBy">><<humanSplitBy>><</replace>>
		<<run $("#numberslider-input-settingsmalechance").trigger("input");>>
	<</link>>
<</widget>>

<<widget "beastSplitBy">>
	<<link `$genericBeastSettings.beastMaleChanceSplit ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $genericBeastSettings.beastMaleChanceSplit to !$genericBeastSettings.beastMaleChanceSplit>>
		<<run setAllBeastsMaleChanceSplit($genericBeastSettings.beastMaleChanceSplit)>>
		<<replace "#beastSplitBy">><<beastSplitBy>><</replace>>
		<<run $("#numberslider-input-genericbeastsettingsbeastmalechance").trigger("input");>>
	<</link>>
<</widget>>

<<widget "characterSettings">>
	<div class="solidBorderContainer settings-container">
	<div class="settingsGrid">
		<div class="settingsToggleItem">
		<span class="gold">무작위 생성:</span><br>
			<<link "캐릭터 외모">><<presets "randomize" "characterSettings" `randomizeSettings('characterAppearance')`>><</link>>
			<mouse class="tooltip linkBlue">(?)<span>플레이어 캐릭터의 외모(머리, 눈, 피부색, 성별, 신체 부위 크기)를 무작위로 설정합니다. 신체 크기, 성별 외모, 성기, 기본 피부색은 게임을 시작한 후에는 변경할 수 없습니다.</span></mouse>
		<br>
		</div>
		<div class="settingsToggleItem">
		<<if StartConfig.enableImages is true>>
			<span class="gold">사이드바 미리보기:</span><br> <label>옷 숨기기 <<checkbox "_showClothes" true false autocheck>></label> | <label>속옷 숨기기 <<checkbox "_showUnderwear" true false autocheck>></label>
			<br>
		<</if>>
		</div>
	</div>
	</div>
	<<if _charTab is undefined>><<set _charTab to "physical">><</if>>
	<hr>
	<div id="characterTabs" class="no-numberify"><<characterTabButtons>></div>
	<div id="characterTabContent"><<characterTabContent>></div>
	<br>
	<<link "맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
<</widget>>

<<widget "characterTabButtons">>
	<div class="containerStart">
		<<characterTabButton "신체 특성" "physical">>
		<<characterTabButton "정신 특성" "mental">>
		<<characterTabButton "시작 조건" "starting">>
	</div>
<</widget>>

<<widget "characterTabButton">>
	<div @class="_charTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _charTab to _args[1]>>
			<<replace #characterTabs>><<characterTabButtons>><</replace>>
			<<replace #characterTabContent>><<characterTabContent>><</replace>>
			<<run settingsDisableElement()>>
		<</button>>
	</div>
<</widget>>

<<widget "characterTabContent">>
	<<switch _charTab>>
		<<case "mental">><<characterMentalSettings>>
		<<case "starting">><<characterStartingSettings>>
		<<default>><<characterPhysicalSettings>>
	<</switch>>
<</widget>>

<<widget "characterPhysicalSettings">>
	<div class="solidBorderContainer settings-container">
	<div class="settingsGrid">

		<div class="settingsHeader">
			몸
		</div>
		<!-- 
		<div class="settingsToggleItem">
			<div class="numberslider-inline">
			<label><span class="gold">성별:</span><br>
			<<numberslider "$genderidentity" $genderidentity 0 1000 25>>
			<<run settingsPlayerGender()>>
			/* <label class="blue">Male <<radiobutton "$player.gender" "m" autocheck>></label> |
			<label class="pink">여성 <<radiobutton "$player.gender" "f" autocheck>></label> |
			<label class="purple">어느 쪽도 아님 <<radiobutton "$player.gender" "n" autocheck>></label> */
			/* <br> */
			/* <span class="small-description">How you see yourself. Does not affect how others perceive you.</span> */
			</label>
			</div>
		</div>
		<<run
		$(() => {
			$('#genitals input[type="radio"]').on('change', () => {
				if (V.player.sex === "h" && V.background === "crossdresser") V.background = "waif";
				Wikifier.wikifyEval('<<replace #settingsDiv>><<characterSettings>><</replace>>');
				Wikifier.wikifyEval('<<updatesidebarimg>>');
			});
		})
		>>
		-->
		<div id="genitals" class="settingsToggleItem">
			<span class="gold">생식기:</span><br>
			<label>자지 <<radiobutton "$player.sex" "m" autocheck>></label> |
			<label>보지 <<radiobutton "$player.sex" "f" autocheck>></label>
			/* <label>Hermaphrodite <<radiobutton "$player.sex" "h" autocheck>></label> */
		</div>
		<<run
		$(() => {
			$('#genitals input[type="radio"]').on('change', () => {
				Wikifier.wikifyEval('<<startingGenitalsSync>><<displaySettings "character">>');
				Wikifier.wikifyEval('<<updatesidebarimg>>');
			});
		})
		>>
		<div class="settingsToggleItem">
			<span class="gold">체격:</span> <mouse class="tooltip linkBlue">(?)<span>체격이 크면 더 강인한 체력을 기를 수 있어 전투가 수월해집니다. 체격이 작으면 큰 체격이 끼어 버릴 만한 좁은 틈새도 빠져나갈 수 있어, 위험한 상황에서 탈출하기 수월해집니다.</span></mouse><br>
			<label>초소형 <<radiobutton "$bodysize" -1 autocheck>></label> |
			<label>매우 작음 <<radiobutton "$bodysize" 0 autocheck>></label> |
			<label>작음 <<radiobutton "$bodysize" 1 autocheck>></label> |
			<label>보통 <<radiobutton "$bodysize" 2 autocheck>></label> |
			<label>장신 <<radiobutton "$bodysize" 2.5 autocheck>></label> |
			<label>큼 <<radiobutton "$bodysize" 3 autocheck>></label> |
			<label>거대 <<radiobutton "$bodysize" 4 autocheck>></label><br>
			<span class="small-description">체격이 클수록 최대 체력과 피해량이 증가합니다.</span>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">체형:</span><br>
			<<capture _i>>
				<<for _i = 0; _i < setup.bodyShapes.length; _i++>>
					<label><<= setup.bodyShapes[_i] is "andro" ? "Androgynous" : setup.bodyShapes[_i].toUpperFirst()>> <<radiobutton "$player.bodyshape" setup.bodyShapes[_i] autocheck>></label>
					<<= _i lt setup.bodyShapes.length - 1 ? "|" : "">>
				<</for>>
			<</capture>>
			<br>
			<span class="small-description">순수하게 외모에만 관련된 항목입니다. 나중에 거울 메뉴에서 변경할 수 있습니다.</span>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">가슴 크기:</span><br>
			<label>납작한 <<radiobutton "$player.breastsize" 0 autocheck>></label> |
			<label>아주 작은 <<radiobutton "$player.breastsize" 1 autocheck>></label> |
			<label>작은 <<radiobutton "$player.breastsize" 2 autocheck>></label> |
			<label>봉긋한 <<radiobutton "$player.breastsize" 3 autocheck>></label> |
			<label>볼륨있는 <<radiobutton "$player.breastsize" 4 autocheck>></label> |
			<label>탱탱한 <<radiobutton "$player.breastsize" 5 autocheck>></label> |
			<label>풍만한 <<radiobutton "$player.breastsize" 6 autocheck>></label> |
			<label>큰 <<radiobutton "$player.breastsize" 7 autocheck>></label> |
			<label>커다란 <<radiobutton "$player.breastsize" 8 autocheck>></label> |
			<label>큼지막한 <<radiobutton "$player.breastsize" 9 autocheck>></label> |
			<label>거대한 <<radiobutton "$player.breastsize" 10 autocheck>></label> |
			<label>엄청난 <<radiobutton "$player.breastsize" 11 autocheck>></label> |
			<label>어마어마한 <<radiobutton "$player.breastsize" 12 autocheck>></label>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">엉덩이 크기:</span><br>
			<label>납작한 <<radiobutton "$player.bottomsize" 0 autocheck>></label> |
			<label>아담한 <<radiobutton "$player.bottomsize" 1 autocheck>></label> |
			<label>둥근 <<radiobutton "$player.bottomsize" 2 autocheck>></label> |
			<label>푹신한 <<radiobutton "$player.bottomsize" 3 autocheck>></label> |
			<label>부드러운 <<radiobutton "$player.bottomsize" 4 autocheck>></label> |
			<label>둥근 <<radiobutton "$player.bottomsize" 5 autocheck>></label> |
			<label>통통한 <<radiobutton "$player.bottomsize" 6 autocheck>></label> |
			<label>큰 <<radiobutton "$player.bottomsize" 7 autocheck>></label> |
			<label>거대한 <<radiobutton "$player.bottomsize" 8 autocheck>></label>
		</div>

		<!--<<if $player.sex isnot "f">>
		This prevents the options from showing up when switching gentials from vagina to penis unless the player switches tabs
		It's unintuitive
			-->
			<div class="settingsToggleItem">
				<span data-target="player.sex" data-disabledif="V.player.sex==='f'">
					<span class="gold">자지 크기 (해당하는 경우):</span><br>
					<label>극소형 <<radiobutton "$player.penissize" 0 autocheck>></label> |
					<label>초소형 <<radiobutton "$player.penissize" 1 autocheck>></label> |
					<label>매우 작음 <<radiobutton "$player.penissize" 2 autocheck>></label> |
					<label>작음 <<radiobutton "$player.penissize" 3 autocheck>></label> |
					<label>보통 <<radiobutton "$player.penissize" 4 autocheck>></label> |
					<label>큼 <<radiobutton "$player.penissize" 5 autocheck>></label> |
					<label>엄청남 <<radiobutton "$player.penissize" 6 autocheck>></label>
				</span>
			</div>
		<!--<</if>>-->
	</div>

	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader">
			머리
		</div>
		<div class="settingsToggleItemWide">
			<div class="numberslider-inline">
			<label><span class="gold">미모:</span><br>
			<<numberslider "$beauty" $beauty 0 10000 1>>
			<<run settingsPlayerBeauty()>>
			</label>
			</div>
		</div>
		<<if setup.faceStyleOptions.length gt 1>>
			<div id="settingsFaceStyle" class="settingsToggleItem">
				<span class="gold">얼굴 형태:</span><br>
				<<for _styleName, _styleValue range setup.faceStyleOptions>>
				<<capture _styleName, _styleValue>>
					<span @id="'link-'+_styleValue.replace(/ /g,'-')" @class="(_styleValue is $facestyle ? 'selected' : '')">
					<<silently>><<set _text_output to _styleName>><<capitalise>><</silently>>
					<<link _text_output>>
						<<removeclass `'#link-'+$facestyle.replace(/ /g,'-')` "selected">>
						<<set $facestyle to _styleValue>>
						<<set $facevariant to "default">>
						<<addclass `'#link-'+$facestyle.replace(/ /g,'-')` "selected">>
						<<replace "#settingsFaceVariantRadios">><<faceVariantSettings>><</replace>>
						<<updatesidebarimg true>>
					<</link>> |
					</span>
				<</capture>>
				<</for>>
			</div>
		<</if>>
		<div id="settingsFaceVariants" @class="setup.faceStyleOptions.length gt 1 ? 'settingsToggleItem' : 'settingsToggleItemWide'">
			<span class="gold">인상:</span>
			<br>
			<div id="settingsFaceVariantRadios">
				<<faceVariantSettings>>
				<br>
				<span class="small-description">순수하게 외모에만 관련된 항목입니다. 나중에 거울 메뉴에서 변경할 수 있습니다.</span>
			</div>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">타고난 눈 색:</span><br>
			<label><span class="black">검은색</span> <<radiobutton "$eyeselect" "black" autocheck>></label> |
			<label><span class="purple">보라색</span> <<radiobutton "$eyeselect" "purple" autocheck>></label> |
			<label><span class="blue">짙은 파란색</span> <<radiobutton "$eyeselect" "dark blue" autocheck>></label> |
			<label><span class="lblue">밝은 파란색</span> <<radiobutton "$eyeselect" "light blue" autocheck>></label> |
			<label><span class="tangerine">호박색</span> <<radiobutton "$eyeselect" "amber" autocheck>></label> |
			<label><span class="brown">헤이즐색</span> <<radiobutton "$eyeselect" "hazel" autocheck>></label> |
			<label><span class="brown">갈색</span> <<radiobutton "$eyeselect" "brown" autocheck>></label> |
			<label><span class="green">초록색</span> <<radiobutton "$eyeselect" "green" autocheck>></label> |
			<label><span class="green">연녹색</span> <<radiobutton "$eyeselect" "light green" autocheck>></label> |
			<label><span class="lime-green">라임색</span> <<radiobutton "$eyeselect" "lime green" autocheck>></label> |
			<label><span class="red">빨간색</span> <<radiobutton "$eyeselect" "red" autocheck>></label> |
			<label><span class="pink">분홍색</span> <<radiobutton "$eyeselect" "pink" autocheck>></label> |
			<label><span class="grey">회색</span> <<radiobutton "$eyeselect" "grey" autocheck>></label> |
			<label><span class="light-grey">연회색</span> <<radiobutton "$eyeselect" "light grey" autocheck>></label> |
			<label><span>무작위</span> <<radiobutton "$eyeselect" "random" autocheck>></label>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">타고난 머리 색:</span><br>
			<<for _i to 0; _i < setup.colours.hair.length; _i++>>
				<<if setup.colours.hair[_i].variable isnot "random" and (setup.colours.hair[_i].natural or setup.colours.hair[_i].dye)>>
					<label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiobutton "$hairselect" setup.colours.hair[_i].variable autocheck>></label> |
				<</if>>
			<</for>>
			<label><span>무작위</span> <<radiobutton "$hairselect" "random" autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">머리 길이:</span><br>
			<label>귀 <<radiobutton "$hairlength" 0 autocheck>></label> |
			<label>목 <<radiobutton "$hairlength" 200 autocheck>></label> |
			<label>가슴 <<radiobutton "$hairlength" 400 autocheck>></label> |
			<label>배꼽 <<radiobutton "$hairlength" 600 autocheck>></label> |
			<label>허벅지 <<radiobutton "$hairlength" 700 autocheck>></label> |
			<label>발 <<radiobutton "$hairlength" 900 autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">얼굴 주근깨:</span><br>
			<label>예 <<radiobutton "$player.skin.faceFreckles" true autocheck>></label> |
			<label>아니요 <<radiobutton "$player.skin.faceFreckles" false autocheck>></label> |
			<label>무작위 <<radiobutton "$player.skin.faceFreckles" "random" autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">몸 주근깨:</span><br>
			<label>없음 <<radiobutton "$player.skin.bodyFreckles" "none" autocheck>></label> |
			<label>상체 <<radiobutton "$player.skin.bodyFreckles" "upper" autocheck>></label> |
			<label>전신 <<radiobutton "$player.skin.bodyFreckles" "full" autocheck>></label> |
			<label>무작위 <<radiobutton "$player.skin.bodyFreckles" "random" autocheck>></label>
		</div>
	</div>

	<hr>

	<div class="settingsGrid">
		<<set _skinShade to ["light", "medium", "dark", "gyaru"].find(shade => ($player.skin?.color || "light").endsWith(shade)) || "light">>
		<<set _skinTone to ($player.skin?.color || "").slice(0, -_skinShade.length)>>

		<div class="settingsHeader">
			피부색
		</div>
		<div class="settingsToggleItem">
			<span class="gold">피부 톤:</span><br>
			<label>뉴트럴 <<radiovar "_skinTone" "">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>웜 <<radiovar "_skinTone" "r">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>골든 <<radiovar "_skinTone" "g">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>올리브 <<radiovar "_skinTone" "y">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>쿨 <<radiovar "_skinTone" "b">><<skinColourVariableCombine>><</radiovar>></label>
			<br>
			<span class="gold">피부 음영:</span><br>
			<label>밝은 <<radiovar "_skinShade" "light">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>중간 <<radiovar "_skinShade" "medium">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>어두운 <<radiovar "_skinShade" "dark">><<skinColourVariableCombine>><</radiovar>></label> |
			<label>갸루 <<radiovar "_skinShade" "gyaru">><<skinColourVariableCombine>><</radiovar>></label>
		</div>
		<div class="settingsToggleItem">
			<div class="numberslider-inline">
			<label><span class="gold">초기 태닝:</span>
			<<numberslider "_tan" _tan 0 100 1 {
				onInputChange: value => {
					Skin.color.setTan(value);
					Wikifier.wikifyEval("<<startingPlayerImageUpdate>>");
				},
				value: v => `${v}%`
			}>>
			</label>
			</div>
		</div>
	</div>

	<hr>

	<<sizeLimitsSettings>>
	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader">
			민감도 <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>민감도는 특정 신체 부위에 성적인 접촉이 있을 때 얻는 흥분도를 결정합니다. <i>민감도가 높을수록 게임이 더 어려워집니다.</i></span>">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">입:</span><br>
			<label>보통 <<radiobutton "$mouthsensitivity" 1 autocheck>></label> |
			<label><span class="light-pink">민감함</span> <<radiobutton "$mouthsensitivity" 2 autocheck>></label> |
			<label><span class="pink">매우 민감함</span> <<radiobutton "$mouthsensitivity" 3 autocheck>></label> |
			<label><span class="red">극도로 민감함</span> <<radiobutton "$mouthsensitivity" 4 autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">가슴:</span><br>
			<label>보통 <<radiobutton "$breastsensitivity" 1 autocheck>></label> |
			<label><span class="light-pink">민감함</span> <<radiobutton "$breastsensitivity" 2 autocheck>></label> |
			<label><span class="pink">매우 민감함</span> <<radiobutton "$breastsensitivity" 3 autocheck>></label> |
			<label><span class="red">극도로 민감함</span> <<radiobutton "$breastsensitivity" 4 autocheck>></label>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">엉덩이:</span><br>
			<label>보통 <<radiobutton "$bottomsensitivity" 1 autocheck>></label> |
			<label><span class="light-pink">민감함</span> <<radiobutton "$bottomsensitivity" 2 autocheck>></label> |
			<label><span class="pink">매우 민감함</span> <<radiobutton "$bottomsensitivity" 3 autocheck>></label> |
			<label><span class="red">극도로 민감함</span> <<radiobutton "$bottomsensitivity" 4 autocheck>></label>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">생식기:</span><br>
			<label>보통 <<radiobutton "$genitalsensitivity" 1 autocheck>></label> |
			<label><span class="light-pink">민감함</span> <<radiobutton "$genitalsensitivity" 2 autocheck>></label> |
			<label><span class="pink">매우 민감함</span> <<radiobutton "$genitalsensitivity" 3 autocheck>></label> |
			<label><span class="red">극도로 민감함</span> <<radiobutton "$genitalsensitivity" 4 autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">주량</span><br>
			<label><span class="blue">주당 </span><<radiobutton "$drunkSensitivity" 0.5 autocheck>></label> |
			<label>보통 <<radiobutton "$drunkSensitivity" 1 autocheck>></label> |
			<label><span class="red">약한 편</span> <<radiobutton "$drunkSensitivity" 1.5 autocheck>></label>
		</div>
	</div>
	</div>
<</widget>>

<<widget "characterMentalSettings">>
	<div class="solidBorderContainer settings-container">
	<div class="settingsGrid">
		<div class="settingsHeader">
			성격
		</div>
		/* <div class="settingsToggleItemWide">
			<span class="gold">무작위 생성:</span>
			<br>
			<<link "캐릭터 특성">><<presets "randomize" "characterSettings" `randomizeSettings('characterTrait')`>><</link>>
			<mouse class="tooltip linkBlue">(?)<span>플레이어 캐릭터의 특성(배경, 성지식, 전반적인 민감도 등)을 무작위로 설정합니다. <i class="red">이 특성들은 게임을 시작한 후에는 변경할 수 없습니다.</i></span></mouse>
			<br>
		</div> */
		<div class="settingsToggleItemWide">
			<span class="gold">성지식:</span> <mouse class="tooltip linkBlue">(?)<span>캐릭터가 경험이 부족해도 성에 대해 어느 정도 알고 있는지 설정합니다.</span></mouse>
			<br>
			<label>순진함 <<radiobutton "$awareselect" "innocent" autocheck>></label> |
			<label>알고 있음 <<radiobutton "$awareselect" "knowledgeable" autocheck>></label>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">배경:</span>
			<mouse class="tooltip linkBlue">(?)<span><i class="red">이 특성들은 게임을 시작한 후에는 변경할 수 없습니다.</i></span></mouse><br>
			<label data-target='["background.nerd","background.athlete","background.delinquent"]' data-disabledif="!V.background.nerd&&(V.background.athlete===true||V.background.delinquent===true)"><mouse class="tooltip"><span class="teal">범생이</span> <<checkbox "$background.nerd" false true autocheck>> - 학교 성적이 좋고, 아무도 당신이 파리 한 마리 해치리라고는 기대하지 않습니다. 괴롭힘을 당합니다.<span>
				<i class="red">'비사교적 나방' 업적을 얻을 수 없게 됩니다.</i>
				<b class="red">이 모드가 처음인 초보자에게는 권장하지 않습니다.</b>
				<br><br>
				보정치:
				<ul>
					<li class="green">학업 상승량 +100%.</li>
					<li class="green">의지력 상승량 +100%.</li>
					<li class="green">긍정적 명성 상승량 +100%.</li>
					<li class="green">불량도 상승량 -75%.</li>
					<li class="green">범죄도 상승량 -50%.</li>
					<li class="red">체격 상승량 -75%.</li>
					<li class="red">수영 상승량 -75%.</li>
					<li class="red">난투 상승량 -50%.</li>
					<li class="red">풋워크 상승량 -25%.</li>
					<li class="red">타격 상승량 -25%.</li>
					<li class="red">발차기 상승량 -25%.</li>
					<li class="red">체육 상승량 -25%.</li>
					<li class="red">춤 상승량 -25%.</li>
				</ul>
				감소:
				<ul>
					<li class="red">체격 감소량 +25%.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label data-target='["background.athlete","background.nerd","background.delinquent"]' data-disabledif="!V.background.athlete&&(V.background.nerd===true||V.background.delinquent===true)"><mouse class="tooltip"><span class="teal">운동선수</span> <<checkbox "$background.athlete" false true autocheck>> - 신체 능력이 뛰어납니다. 성적이 떨어졌습니다.<span>
				<b class="green">이 모드가 처음인 초보자에게 강력히 추천합니다.</b>
				<br><br>
				보정치:
				<ul>
					<li class="green">체격 상승량 +25%.</li>
					<li class="green">체육 상승량 +25%.</li>
					<li class="green">수영 상승량 +25%.</li>
					<li class="green">춤 상승량 +10%.</li>
					<li class="red">학업 상승량 -25%.</li>
				</ul>
				감소:
				<ul>
					<li class="green">체격 감소량 -75%.</li>
				</ul>
				
			</span></mouse></label>
			<br>
			<label data-target='["background.delinquent","background.nerd","background.athlete"]' data-disabledif="!V.background.delinquent&&(V.background.nerd===true||V.background.athlete===true)"><mouse class="tooltip"><span class="teal">불량배</span> <<checkbox "$background.delinquent" false true autocheck>> - 인기가 많고 싸움을 잘하지만, 자주 말썽에 휘말립니다.<span>
				보정치:
				<ul>
					<li class="green">난투 상승량 +50%.</li>
					<li class="green">속임수 상승량 +25%.</li>
					<li class="green">학교 지위 상승량 +25%.</li>
					<li class="green">풋워크 상승량 +25%.</li>
					<li class="green">타격 상승량 +25%.</li>
					<li class="green">발차기 상승량 +25%.</li>
					<li class="red">범죄도 상승량 +50%.</li>
					<li class="red">불량도 상승량 +25%.</li>
					<li class="red">학업 상승량 -50%.</li>
					<li class="orange">음란 수치와 관계없이 역강간을 할 수 있습니다.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label><mouse class="tooltip"><span class="blue">난잡함</span> <<checkbox "$background.promiscuous" false true autocheck>> - 당신은 성적인 경험이 있습니다.<span>
				보정치:
				<ul>
					<li class="green">유혹 상승량 +25%.</li>
					<li class="green">섹스 스킬 상승량 +25%.</li>
					<li class="red">성지식 상승량 +25%.</li>
				</ul>
				감소:
				<ul>
					<li class="red">성지식 감소량 -50%.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label><mouse class="tooltip"><span class="blue">노출증</span> <<checkbox "$background.exhibitionist" false true autocheck>> - 공공장소에서 자신을 노출하는 것에 친밀감을 느낍니다.<span>
				보정치:
				<ul>
					<li class="green">노출증 명성 상승량 -75%.</li>
					<li class="red">성지식 상승량 +25%.</li>
				</ul>
				감소:
				<ul>
					<li class="red">성지식 감소량 -50%.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label><mouse class="tooltip"><span class="blue">일탈자</span> <<checkbox "$background.deviant" false true autocheck>> - 당신은 동물을 <i>정말</i> 좋아합니다.<span>
				보정치:
				<ul>
					<li class="red">성지식 상승량 +25%.</li>
				</ul>
				감소:
				<ul>
					<li class="red">성지식 감소량 -50%.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label>
				<mouse class="tooltip">
					<span class="purple">자폐 스펙트럼</span> <<checkbox "$background.autism" false true autocheck>> - 소음, 변화, 불분명한 기대가 당신을 지치게 할 수 있습니다.
					<span>
						<i class="purple">부하는 당신이 얼마나 지쳐 있는지를 나타냅니다. 휴식을 취하면 줄어듭니다. 부하가 낮으면 안정, 높으면 번아웃입니다.</i>
						<br>
						<b class="purple">능동적 부하 관리.</b>
						<br><br>
						보정치:
						<ul>
							<li class="green">안정: 모든 스킬 +5%, 학교 성적 +25%.</li>
							<li class="green">일반 스킬에서 캐릭터 재능 +2, 섹스 스킬에서 +1.</li>
							<li class="green">가사, 청소, 보호소 관리의 보수가 15% 늘어납니다.</li>
							<li class="green">현재 관심사에 몰두하면 스트레스와 부하가 줄어듭니다.</li>
							<li class="green">스티밍을 하면 부하가 줄어들고, 남들 앞이 아닌 곳에서 가면을 벗어도 줄어듭니다.</li>
							<li class="green">수면은 부하를 줄여 줍니다. 조용한 활동은 하루 최대 <<= autismRecoveryCapValue()>>까지 더 줄여 줍니다.</li>
							<li class="red">번아웃: 모든 스킬 -20%, 학교 성적 -30%, 트라우마를 일으킬 수 있습니다.</li>
							<li class="red">갑작스러운 작업 전환, 인파, 소음, 눈부신 빛, 더위, 마스킹으로 부하가 오릅니다.</li>
							<li class="red">밀린 집세, 사회봉사, 정학은 매일 부하를 올립니다.</li>
							<li class="red">직접 고르지 않은 일을 시작하면 의지력이 줄고 스트레스가 쌓입니다.</li>
							<li class="red">두 시간을 넘겨 연습하면 얻는 양이 최대 25%까지 줄어듭니다.</li>
							<li class="red">부하와 스트레스가 모두 높으면 멜트다운이나 셧다운이 일어납니다.</li>
						</ul>
					</span>
				</mouse>
			</label>
			<br>
			<label><mouse class="tooltip"><span class="purple">무덤덤함</span> <<checkbox "$background.detached" false true autocheck>> - 감정은 느끼지만 좀처럼 겉으로 드러나지 않습니다.<span>
				<i class="purple">당신의 감정은 멀리 떨어져 있는 것 같습니다. 여전히 그 자리에 있지만, 밖에서는 보기 어렵습니다.</i>
				<br><br>
				보정치:
				<ul>
					<li class="green">스트레스 상승량 -35%. 고통이 오를수록 감소 폭이 줄고, 고통이 심하면 사라집니다.</li>
					<li class="green">네임드 NPC와의 호감도 감소량 -20%.</li>
					<li class="red">네임드 NPC와의 호감도 상승량 -25%.</li>
					<li class="orange">얼굴이 붉어지는 것과 흥분은 얼굴에 드러나지 않습니다. 고통은 여전히 드러납니다. 오르가슴과 매우 높은 스트레스는 이를 뚫고 나옵니다.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label data-target='["background.crossdresser","background.genderAnxious","background.transgender"]' data-disabledif="!V.background.crossdresser&&(V.background.genderAnxious===true||V.background.transgender===true)"><mouse class="tooltip"><span class="lewd">크로스드레서</span> <<checkbox "$background.crossdresser" false true autocheck>> - 이성의 옷차림에 취향이 생겼습니다.<span>
				보정치:
				<ul>
					<li class="green">원래 성별과 반대인 성별 상승량 +25%.</li>
					<li class="red">원래 성별과 일치하는 성별 상승량 -50%.</li>
					<li class="orange">이 배율은 태도 설정에서 성 정체성 갱신이 켜져 있을 때 일상 이벤트로 인한 변화에 적용됩니다.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label data-target='["background.crossdresser","background.genderAnxious","background.transgender"]' data-disabledif="!V.background.genderAnxious&&(V.background.crossdresser===true||V.background.transgender===true)"><mouse class="tooltip"><span class="lewd">성별 불안</span> <<checkbox "$background.genderAnxious" false true autocheck>> - 자신의 성별을 끊임없이 다시 확인해야 합니다.<span>
				보정치:
				<ul>
					<li class="green">원래 성별과 일치하는 성별 상승량 +25%.</li>
					<li class="red">원래 성별과 반대인 성별 상승량 -50%.</li>
					<li class="orange">이 배율은 태도 설정에서 성 정체성 갱신이 켜져 있을 때 일상 이벤트로 인한 변화에 적용됩니다.</li>
				</ul>
			</span></mouse></label>
			<br>
			<label data-target='["background.crossdresser","background.genderAnxious","background.transgender"]' data-disabledif="!V.background.transgender&&(V.background.crossdresser===true||V.background.genderAnxious===true)">
				<mouse class="tooltip"><span class="lewd">트랜스젠더</span> <<checkbox "$background.transgender" false true autocheck>> - 당신은 태어날 때의 성별과 다른 성별로 자신을 정체화합니다.<span class="green">당신은 자신이 태어난 성별과 다른 성별임을 언제나 알고 있었고, 아무리 다르게 옷을 입어도 그것은 바뀌지 않습니다(정체성은 세상이 정해 주는 것이 아니라 당신이 정하는 것입니다).</span></mouse>
			</label>
			<br>
			<label><mouse class="tooltip"><span class="lewd">호색한</span> <<checkbox "$background.lustful" false true autocheck>> - 흥분도가 시간이 지남에 따라 증가하며 관리가 필요합니다.<span>
				보정치:
				<ul>
					<li class="green">유혹 상승량 +15%.</li>
				</ul>
			</span></mouse></label>
			/*<br>
			<label>재배의 달인 <<checkbox "$background" "greenthumb" autocheck>> - 더 풍성한 작물을 거두고, 비료를 써도 효과가 줄어들지 않습니다. 비료 1개를 가지고 시작합니다.</label>*/
			<br>
			<label><mouse class="tooltip"><span class="lewd">나무성애자</span> <<checkbox "$background.plantlover" false true autocheck>> - 당신에게는 식물이 전부입니다.<span class="green">넥타르에 중독되었습니다. 최음제와 술에 더 취약합니다. 인간형 식물과 식물 기반 촉수를 만나기 위해 더 이상 환각이 필요하지 않습니다. 트라우마가 증가할수록 관리 스킬에 보너스를 받습니다.</span></mouse>
			</label>
			<br>
			<label><mouse class="tooltip"><span class="red">광기</span> <<checkbox "$background.insanity" false true autocheck>> - 산산이 부서진 불안정한 정신.<span>
				<i class="red">당신의 망가진 정신은 영구적인 트라우마에 시달립니다. 쉬고 있을 때도 불면증, 악몽, 심각한 불안 장애, 심각한 공황 발작, 심각한 환각, 해리 증상을 겪습니다.</i><br>
				<b class="red">이 모드가 처음인 초보자에게는 권장하지 않습니다.</b>
				<br><br>
				보정치:
				<ul>
					<li class="red">체격 상승량 -75%.</li>
					<li class="red">수영 상승량 -75%.</li>
					<li class="red">의지력 상승량 -75%.</li>
					<li class="red">난투 상승량 -50%.</li>
					<li class="red">풋워크 상승량 -25%.</li>
					<li class="red">타격 상승량 -25%.</li>
					<li class="red">발차기 상승량 -25%.</li>
					<li class="red">체육 상승량 -25%.</li>
					<li class="red">춤 상승량 -25%.</li>
					<li class="red">학업 상승량 -50%.</li>
					<li class="red">범죄도 상승량 +50%.</li>
					<li class="red">불량도 상승량 +25%.</li>
					<li class="orange">단련된 재능이 모두 강제로 활성화됩니다.</li>
					<li class='orange'>민감도 상승이 크게 억제됩니다.</li>
				</ul>
				감소:
				<ul>
					<li class="red">체격 감소량 +25%.</li>
				</ul>
			</span></mouse></label>
		</div>
	</div>
	<<identitySettings>>
	</div>
<</widget>>

<<widget "characterStartingSettings">>
	<<set _foundPregnancy to !!Object.values($NPCName || {}).find(npc => npc && npc.pregnancy && npc.pregnancy.enabled && getActivePregnancies(npc.fullDescription).length && !setup.pregnancy.canBePregnant.includes(npc.fullDescription))>>
	<div class="solidBorderContainer settings-container">
	<div class="settingsGrid">
		<div class="settingsToggleItemWide">
			<span class="gold">시작 계절</span> <mouse class="tooltip linkBlue">(?)<span style="font-size:16px;">게임은 선택한 계절의 첫 일요일에 시작됩니다.</span></mouse>
			<br>
			<label><mouse class="tooltip tangerine">가을 <<radiobutton "$startingseason" "autumn" autocheck>><span class="green"><i>초보자에게 추천합니다.</i></span></mouse></label> |
			<label><span class="teal">겨울</span> <<radiobutton "$startingseason" "winter" autocheck>></label> |
			<label><span class="lime-green">봄</span> <<radiobutton "$startingseason" "spring" autocheck>></label> |
			<label><span class="red">여름</span> <<radiobutton "$startingseason" "summer" autocheck>></label> |
			<label>무작위 <<radiobutton "$startingseason" "random" autocheck>></label>
		</div>

		<div class="settingsToggleItem">
			<<gameMode>>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">임신 모드</span>
			<br>
			<<if _selectedStart is "default">>
				/* The Basic start applies _pregnancytype when the game begins, so this tab has to write the same temp value. */
				<label><<radiobutton "_pregnancytype" "realistic" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "realistic" ? "checked": "")`>> <mouse class="tooltip green">현실적<span>임신이 바로 진행되지 않으며, 임신이 되었는지 즉시 알 수 없습니다. 임신 테스트기를 사용해야 할 수도 있으며, 처음에는 아버지가 누구인지 모를 수 있습니다. 수 시간 안에 씻어내지 않으면 보지 바깥에 묻은 정액으로도 임신할 수 있습니다.</span></mouse></label> |
				<label><<radiobutton "_pregnancytype" "fetish" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "fetish" ? "checked": "")`>> <mouse class="tooltip pink">페티시<span>정액이 몸 안에 들어가는 즉시 임신될 수 있습니다. 임신 사실과 아버지가 누구인지도 곧바로 알게 됩니다.</span></mouse></label> |
				<label><<radiobutton "_pregnancytype" "silly" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "silly" ? "checked": "")`>> <mouse class="tooltip gold">엉뚱함<span>손을 잡거나 입을 맞추는 즉시, 특히 사랑하는 사람과라면 임신할 수 있습니다. <i class="red none">이 모드에서는 스토리 내용과 관련된 문제가 있을 수 있습니다. 이 모드에서는 일부 업적이 비활성화됩니다.</i></span></mouse></label> |
				<label><<radiobutton "_pregnancytype" "disabled" autocheck>> <mouse class="tooltip red">비활성화<span>임신이 비활성화됩니다.</span></mouse></label>
			<<else>>
				<<pregnancyType>>
			<</if>>
			<br>
			<<realisticChildbirth>>
			<br>
			<<fertilityCycles>>
			<br>
			<span data-target='["settingsincompletepregnancyenabled", "settingspregnancytype", "settingsnnpcpregnancyenabled", "settingsplayerpregnancyhumanenabled", "settingsplayerpregnancybeastenabled"]' data-disabledif="(T.foundPregnancy&&V.settings.incompletePregnancyEnabled===true)||(!V.settings.nnpcPregnancyEnabled&&!V.settings.playerPregnancyHumanEnabled&&!V.settings.playerPregnancyBeastEnabled)">
				<<incompletePregnancy>>
			</span>
		</div>

		<div class="settingsToggleItem">
			<<quickNpcGenderSlider>>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">네임드 NPC 성별</span>
			<mouse class="tooltip linkBlue">(?)<span>변경 사항을 저장하면 설정이 적용됩니다.</span></mouse>
			<br>
			<<if _namedNpcPreset is undefined>><<set _namedNpcPreset to "namedNpcDefaultGender">><</if>>
			<label>모두 남성 <<radiobutton "_namedNpcPreset" "namedNpcAllMaleGender" autocheck>></label> |
			<label><<print $passage is "Start" ? "무작위 성별" : "현재 성별">> <<radiobutton "_namedNpcPreset" "namedNpcDefaultGender" autocheck>></label> |
			<label>모두 여성 <<radiobutton "_namedNpcPreset" "namedNpcAllFemaleGender" autocheck>></label>
		</div>

		<div class="settingsToggleItem">
			<<quickBeastGenderSlider>>
		</div>

		<div class="settingsToggleItem">
			<<if _selectedStart is "default">>
				/* The Basic start applies _monstersPreset when the game begins, so this tab has to write the same temp value. */
				<<if _monstersPreset is undefined>><<set _monstersPreset to "monstersDefault">><</if>>
				<span class="gold">짐승을 수인 소녀와 소년으로 대체</span>
				<br>
				<label>항상 <<radiobutton "_monstersPreset" "monstersAll" autocheck>></label> |
				<label>환각 상태일 때만 <<radiobutton "_monstersPreset" "monstersDefault" autocheck>></label> |
				<label>사용 안 함 <<radiobutton "_monstersPreset" "monstersNone" autocheck>></label>
			<<else>>
				<<monsterSettings>>
			<</if>>
		</div>

		<<if _selectedStart is "default">>
			<div class="settingsToggleItem">
				<span class="gold">페티시 설정</span>
				<br>
				<<if _kinkPreset is undefined>><<set _kinkPreset to "kinkDefault">><</if>>
				<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">바닐라<span>모든 수인 관련 토글이 비활성화되며, 인간형 식물, 촉수, 슬라임, 모유 수유, 페이스시팅, 이중 삽입, 최면도 비활성화됩니다.</span></mouse>
				<<radiobutton "_kinkPreset" "kinkVanilla" autocheck>></label> |
				<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">꽤 방탕한<span>기본 설정. 워터스포츠를 제외한 모든 페티시가 활성화됩니다.</span></mouse>
				<<radiobutton "_kinkPreset" "kinkDefault" autocheck>></label> |
				<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">수인 없음<span>수인 관련 모든 설정이 비활성화됩니다. 수간, 스웜, 보어, 기생충, 거미, 민달팽이, 말벌, 럴커, 벌, 말 등이 포함됩니다.</span></mouse>
				<<radiobutton "_kinkPreset" "kinkNoBeasts" autocheck>></label> |
				<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">"뭐든지"<span>워터스포츠를 포함한 모든 페티시가 활성화됩니다.</span></mouse>
				<<radiobutton "_kinkPreset" "kinkEverything" autocheck>></label>
			</div>
		<</if>>

		<div class="settingsToggleItem">
			<<if _selectedStart is "default">>
				<i>페티시 및 게임플레이 설정을 더 세부적으로 조정하려면 <span class="gold">커스텀</span> 시작을 이용하십시오. 게임플레이 설정은 게임을 시작한 후에도 변경할 수 있습니다.</i>
			<<else>>
				<i>페티시 토글, 가격, 그 밖의 세계 설정은 <span class="gold">게임 설정</span> 탭에 있습니다. 게임을 시작한 후에도 변경할 수 있습니다.</i>
			<</if>>
		</div>
	</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "featExplanation">>
	<<link "설명 숨기기...">>
		<<replace #featExplanation>><</replace>>
		<<toggleclass '#explain' 'hidden'>>
	<</link>><br>
	여러 세이브 파일의 업적을 모두 불러오지 않을 경우, <span class="gold">가장 최근에 불러온 세이브</span>에서 잠금 해제된 업적만이 다음 회차로 이어집니다. 100% 완료를 목표로 하고 있다면 이 점을 주의해 주십시오!
	<br><br>
	<span class="green">업적 부스터에 코인을 사용해도 코인은 영구적으로 소모되지 않으며, 하나의 업적으로 얻은 코인은 두 번 얻을 수 없습니다.</span> 사용한 코인은 개인 코인 저장소에 남아 새로운 게임을 시작할 때마다 사용할 수 있습니다.
	<br><br>
	<span class="red">특정 설정값을 변경할 경우 현재 게임에서 일부 업적과 코인을 획득하지 못할 수 있습니다.</span> 플레이 중 치트 옵션을 한 번이라도 활성화할 경우 남은 회차 동안 어떠한 업적도 획득할 수 없게 됩니다. 해당 설정들을 변경하려 할 경우 경고 메시지가 출력됩니다.
	<br><br>
	어떤 업적들은 조건을 달성하자마자 획득 표시가 뜨지만, 또 다른 업적들은 게임 내 시간이 다음 시간으로 넘어가야 표시됩니다. 그럼 즐거운 수집 시간 되시길 바랍니다!
<</widget>>

<<widget "featSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsToggleIndent">
	Degrees of Lewdity를 플레이하며 다양한 임무를 완수함으로써 <span class="gold">업적</span>을 얻게 됩니다. 더 많은 업적을 얻을수록 더 많은 <span class="gold">브렐 코인</span>을 얻습니다. 새로운 게임을 시작할 때 가장 최근에 불러온 세이브에 저장된 코인들을 사용해 <span class="gold">업적 부스터</span>를 구매할 수 있습니다. 이 부스터들은 다음 게임 시 보너스를 제공합니다.
				<br><br>
				업적들은 하나의 게임 회차 내에서 누적되어 달성됩니다. 만약 이전의 세이브 파일로 되돌아가거나 다른 회차로 전환할 경우, <span class="red">아래의 링크를 사용해 모든 업적을 불러오지 않는 한 달성한 업적과 브렐 코인을 모두 잃게 됩니다.</span> 업적 불러오기 실행 시 업적 부스터들은 초기화됩니다.
				<span id="explain">
					<<link "자세히 알아보기...">>
						<<replace #featExplanation>><<featExplanation>><</replace>>
						<<toggleclass '#explain' 'hidden'>>
					<</link>>
				</span>
				<span id="featExplanation"></span>
		</div>
			<div class="settingsToggleIndent">
				<<link "모든 업적 불러오기:">>
					<<replace #settingsStart>>
						<<loadAllFeats>>
					<</replace>>
				<</link>>
				<span class="green"> 장치 내 여러 로컬 세이브 파일들에서 달성된 모든 업적을 확인하여, 당신이 획득한 브렐 코인과 잠금 해제된 업적 부스터들을 병합합니다.</span>
			</div>
			<<if $feats.allSaves.points isnot undefined or $feats.allSaves.points isnot 0>>
				<div class="settingsToggleIndent">
				<<link "모든 업적 초기화:">>
					<<set $feats to {
						"locked":false,
						"soft":false,
						"allSaves":{},
						"currentSave":{},
						"filter":"All"
					}>>
					<<script>>
						localStorage.removeItem("dolFeats");
					<</script>>
					<<setupFeatBoosts true>>
					<<displaySettings "featSettings">>
				<</link>>
				<span class="red"> 이는 지금까지 획득한 모든 업적을 삭제하며, 처음부터 업적들을 전부 다시 수집해야 함을 의미합니다.</span>
				</div>
			<</if>>
				<hr>

				<<set _allUpgradeNames to Object.keys($featsBoosts.upgrades)>>
				<<set _traitUpgradeNames to ["orgasmTrait", "chokeTrait", "ejacTrait", "molestTrait", "rapeTrait", "bestialityTrait", "tentacleTrait", "critterMagnetTrait", "milkDrankTrait"]>>
				<<set _sexSkillUpgradeNames to ["seduction", "oral", "chest", "hands", "buttocks", "penile", "anal", "vaginal", "feet", "thighs"]>>
				<<set _basicSkillUpgradeNames to ["skulduggery", "dancing", "swimming", "athletics", "tending", "housekeeping"]>>
				<<set _advancedTraitUpgradeNames to ["xchangePurityTrait", "xchangeGrayAgentTrait", "greenThumb", "transcend", "adaptiveGenes", "purity", "impurity"]>>
				<<set _transformationUpgradeNames to ["divineTFs", "animalTFs"]>>
				<<set _sadoMasoUpgradeNames to ["sadism", "masochism", "sadistTrait", "masochistTrait"]>>
				<<set _coreCharacteristicUpgradeNames to ["physique", "willpower", "promiscuity", "exhibitionism", "deviancy"]>>
				<<set _upgradeNames to []>>
				<<set _traitCategoryAdded to false>>
				<<set _sexSkillCategoryAdded to false>>
				<<set _basicSkillCategoryAdded to false>>
				<<set _advancedTraitCategoryAdded to false>>
				<<set _transformationCategoryAdded to false>>
				<<set _sadoMasoCategoryAdded to false>>
				<<set _coreCharacteristicCategoryAdded to false>>
				<<for _boostName range _allUpgradeNames>>
					<<if _traitUpgradeNames.includes(_boostName)>>
						<<if !_traitCategoryAdded>>
							<<run _upgradeNames.push("sexRapeTraits")>>
							<<set _traitCategoryAdded to true>>
						<</if>>
					<<elseif _sexSkillUpgradeNames.includes(_boostName)>>
						<<if !_sexSkillCategoryAdded>>
							<<run _upgradeNames.push("sexSkills")>>
							<<set _sexSkillCategoryAdded to true>>
						<</if>>
					<<elseif _basicSkillUpgradeNames.includes(_boostName)>>
						<<if !_basicSkillCategoryAdded>>
							<<run _upgradeNames.push("basicSkills")>>
							<<set _basicSkillCategoryAdded to true>>
						<</if>>
					<<elseif _advancedTraitUpgradeNames.includes(_boostName)>>
						<<if !_advancedTraitCategoryAdded>>
							<<run _upgradeNames.push("advancedTraits")>>
							<<set _advancedTraitCategoryAdded to true>>
						<</if>>
					<<elseif _transformationUpgradeNames.includes(_boostName)>>
						<<if !_transformationCategoryAdded>>
							<<run _upgradeNames.push("transformations")>>
							<<set _transformationCategoryAdded to true>>
						<</if>>
					<<elseif _sadoMasoUpgradeNames.includes(_boostName)>>
						<<if !_sadoMasoCategoryAdded>>
							<<run _upgradeNames.push("sadoMaso")>>
							<<set _sadoMasoCategoryAdded to true>>
						<</if>>
					<<elseif _coreCharacteristicUpgradeNames.includes(_boostName)>>
						<<if !_coreCharacteristicCategoryAdded>>
							<<run _upgradeNames.push("coreCharacteristics")>>
							<<set _coreCharacteristicCategoryAdded to true>>
						<</if>>
					<<else>>
						<<run _upgradeNames.push(_boostName)>>
					<</if>>
				<</for>>
				<<set _preferredUpgradeNames to ["money", "coreCharacteristics", "basicSkills", "sexSkills", "grades", "advancedTraits", "sexRapeTraits"]>>
				<<for _preferredIndex to _preferredUpgradeNames.length - 1; _preferredIndex gte 0; _preferredIndex-->>
					<<set _preferredName to _preferredUpgradeNames[_preferredIndex]>>
					<<set _currentIndex to _upgradeNames.indexOf(_preferredName)>>
					<<if _currentIndex gte 0>>
						<<run _upgradeNames.unshift(_upgradeNames.splice(_currentIndex, 1)[0])>>
					<</if>>
				<</for>>
				<<set _visibleUpgradeNames to []>>
				<<set _visibleUpgradeIDs to []>>
				<<for _i to 0; _i lt _upgradeNames.length; _i++>>
					<<if _upgradeNames[_i] is "sexRapeTraits">>
						<<set _visibleUpgradeNames.push("섹스·강간 특성")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "sexSkills">>
						<<set _visibleUpgradeNames.push("성 기술 등급")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "basicSkills">>
						<<set _visibleUpgradeNames.push("기본 기술 등급")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "advancedTraits">>
						<<set _visibleUpgradeNames.push("특수 고급 특성")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "transformations">>
						<<set _visibleUpgradeNames.push("Transformation")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "sadoMaso">>
						<<set _visibleUpgradeNames.push("Sado-Maso")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif _upgradeNames[_i] is "coreCharacteristics">>
						<<set _visibleUpgradeNames.push("핵심 능력치 등급")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<elseif $featsBoosts.upgradeDetails[_upgradeNames[_i]].max>>
						<<set _visibleUpgradeNames.push($featsBoosts.name[_upgradeNames[_i]])>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<else>>
						<<set _visibleUpgradeNames.push("?????")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<</if>>
				<</for>>
				<div id="featsPointsMenu">
					<<featsPointsMenu>>
				</div>
				<<featsPointsMenuReset>>
	</div>
<</widget>>

<<widget "gameMode">>
	<span class="gold">게임 모드</span>
	<br>
	<div class="game-mode-row">
		<label class="mode-option">
			<mouse class="tooltip green">노말 모드<span>위험한 세계에서 살아남으십시오.</span></mouse>
			<<if ($ironmanmode is true and $gamemode is "hard") and $passage != "Start">>
				<input id="radiobutton-gamemode-normal" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
			<<else>>
				<<radiobutton "$gamemode" "normal" autocheck>>
			<</if>>
		</label>
		<label class="mode-option">
			<mouse class="tooltip blue">소프트 모드<span>가볍고 음란한 모험을 선호하는 분들을 위한 모드입니다. 다만 게임은 여전히 곳곳이 어둡습니다.<br><i class="red normal">이 기능은 실험적이며 게임을 망가뜨리는 버그가 있습니다. 앞으로 변경되거나 삭제될 수 있습니다. 소프트 모드로 설정을 두면 노말 모드로 바꿀 때까지 업적을 얻을 수 없습니다. 이렇게 하면 이 세이브에서 일부 업적을 영구히 얻을 수 없게 됩니다.</i></span></mouse>
			<<if ($ironmanmode is true and ["hard","normal"].includes($gamemode) is true) and $passage != "Start">>
				<input id="radiobutton-gamemode-soft" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
			<<else>>
				<<radiobutton "$gamemode" "soft" autocheck>>
			<</if>>
		</label>
		<<if $intro is 1 or $gamemode is "hard">>
			<label class="mode-option">
				<mouse class="tooltip purple">하드 모드<span>음란한 스탯(음란, 노출증, 이상성욕)의 자연 감소를 제거하여 트라우마와 통제력 관리를 점점 더 어렵게 만듭니다. 게임 시작 시에만 선택할 수 있으며 정신병원에 수감되면 노말 모드로 돌아갑니다. <br><i class="red normal">이 기능은 실험적이며 추후 변경되거나 삭제될 예정입니다.</i></span></mouse>
				<<if $ironmanmode is true and $passage != "Start">>
					<input id="radiobutton-gamemode-hard" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
				<<else>>
					<<radiobutton "$gamemode" "hard" autocheck>>
				<</if>>
			</label>
		<</if>>
	</div>
	<br>
	<<if $ironmanmode and $passage isnot "Start">>
		<span class="red">철인 모드 중에는 치트를 활성화할 수 없습니다.</span>
	<<else>>
		<<if $passage is "Start">>
			<label data-target="settingscheatsenabledtoggle" data-disabledif="V.settings.cheatsEnabledToggle===true">
				<input id="checkbox-ironmanmode" onclick="IronMan.UI.checkBox()" name="checkbox-ironmanmode" type="checkbox" tabindex="0" class="macro-checkbox"> <mouse class="tooltip white">철인 모드<span>세이브 로드 꼼수 등 이런 부류의 행위를 방지하기 위해 마련되었습니다.<br><br>저장할 수 있고 그러면 시작 메뉴로 이동하게 됩니다. 그 뒤 이 세이브 파일을 불러올 수 있지만 이후에는 자동 삭제됩니다.<br><br>또한 해당 세이브 파일을 잃을 경우를 대비해 게임 내에서 4-8일마다 추가 저장이 진행됩니다.</span></mouse>&nbsp;<i class="ironman-clarify">(게임 시작 후에는 해제할 수 없습니다)</i>
				<<run IronMan.UI.checkBox(`init`)>>
			</label>
			<br>
		<</if>>
		<label data-target="ironmanmode" data-disabledif="V.ironmanmode===true">
			<<checkbox "$settings.cheatsEnabledToggle" false true autocheck>> <mouse class="tooltip red">치트 모드<span>설정에서 치트를 활성화한 상태로 유지하면 세이브에서 업적을 획득할 수 없습니다.</span></mouse>&nbsp;<i class="ironman-clarify">(치트 버튼이 사이드바에 표시됩니다)</i>
		</label>
	<</if>>
<</widget>>

<<widget "gameSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">

			<div id="gameMode" class="settingsToggleItem">
				<<gameMode>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">조우 확률</span>
				<div class="small-description">기본값은 1.0. 매력이 조우 확률에 미치는 영향력을 곱셈합니다.</div>
				<div class="small-description"><span class="red">이 값을 1 미만으로 설정하면, 이 세이브에서는 일부 업적을 영원히 얻을 수 없게 되며 최소 1로 다시 올리기 전까지 다른 업적들도 얻을 수 없습니다.</span></div>
				<div id="sliderAllureMode">
					<<numberslider "$settings.allureModifier" $settings.allureModifier 0.2 2 0.1 $ironmanmode>>
				</div>
				<label data-target="ironmanmode" data-disabledif="V.ironmanmode===true && V.passage!=='Start'">
					<<checkbox "$settings.allureIgnoresFame" false true autocheck>> <mouse class="tooltip linkBlue">매력에서 명성 무시<span>기본적으로 매력의 대부분은 섹스나 노출증 같은 나쁜 명성에 따라 배율이 적용되므로, 명성이 낮은 캐릭터는 위험한 조우를 거의 겪지 않습니다. 이 옵션을 켜면 명성과 관계없이 매력 전체를 사용합니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">여러 옷장</span> <mouse class="tooltip linkBlue">(?)<span>
					<b class="teal">공용 옷장 하나:</b> 모든 옷장과 사물함이 같은 옷을 공유합니다.<br>
					<b class="teal">옷장 분리:</b> 일부 장소는 자체 옷을 가집니다. 탈의실에서는 연결된 다른 옷장에 여전히 접근할 수 있습니다.<br>
					<b class="teal">분리, 현장 전용:</b> 옷장이 분리되며, 현재 위치에 있는 옷장만 사용할 수 있습니다.<br>
					<i class="orange">감옥과 정신병원의 사물함은 항상 분리되어 있습니다.</i><br>
					<i class="red">실험적 기능입니다. 플레이 도중에 이 설정을 바꾸면 접근할 수 없는 옷이 생기거나 입을 만한 옷이 없어질 수 있습니다.</i>
				</span></mouse>
				<br>
				<label><<radiobutton "$settings.multipleWardrobes" false autocheck>> 공용 옷장 하나</label> |
				<label><<radiobutton "$settings.multipleWardrobes" "isolated" autocheck>> 옷장 분리</label> |
				<label><<radiobutton "$settings.multipleWardrobes" "strict" autocheck>> 분리, 현장 전용</label>
				<br>
				<<if $debug>>
					<!--This setting will not be ready on initial release-->
					<label><<radiobutton "$settings.multipleWardrobes" "all" autocheck>> 모든 옷장에 개별 적용</label>
					<br>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">스킬 판정 표시</span> <mouse class = "tooltip linkBlue">(?)<span>게임과 상호작용할 때, 특정 스킬이 일정 기준을 넘어야만 성공하는 행동들이 있습니다. 행동을 취하기 전 요구되는 스킬과 성공 확률을 보여주도록 선택할 수 있습니다.</span></mouse>
				<br>
				<label>정확한 성공 확률(%) 표시 <<radiobutton "$settings.skillCheckStyle" "percentage" autocheck>></label> |
				<label>대략적인 성공 확률 표시 <<radiobutton "$settings.skillCheckStyle" "words" autocheck>></label> |
				<label>요구되는 스킬 이름만 표시 <<radiobutton "$settings.skillCheckStyle" "skillname" autocheck>></label>
				<br>
				<label>
				<<checkbox "$settings.blindStatsEnabled" false true autocheck>> <mouse class = "tooltip linkBlue">블라인드 스탯 활성화<span>블라인드 스탯을 켜고 플레이하면 스탯이 변할 때 아무런 표시가 뜨지 않으며, 특정 이벤트의 성공을 위해 어떤 스킬이 필요한지도 알 수 없고, 상황에 따른 위험 경고도 받지 못합니다. 오직 직감만으로 살아남으십시오.<i class="red normal"><br>초보자에게는 권장하지 않습니다. 이 기능은 실험적이며 향후 변경되거나 삭제될 수 있습니다.</i></span></mouse>
				</label>
				<br>
			</div>

			<div class="settingsToggleItemWide">
				<span class="gold">무작위 생성:</span><br>

				<<link "게임플레이">><<presets "randomize" "gameSettings" `randomizeSettings('gameplay')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>조우 확률, 의상 가격, 작물 수확량, 베일리의 상납금 등 일반 게임플레이에 관련된 모든 설정을 무작위로 바꿉니다.</span></mouse> |
				<<link "조우">><<presets "randomize" "gameSettings" `randomizeSettings('encounter')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>일반 NPC와 관련된 모든 설정을 무작위로 바꿉니다.</span></mouse>
				<br>
			</div>
		</div>
	</div>
	<hr>
	<div id="startTabSettings">
		<<allSettings>>
	</div>
	<div id="subsectionDiv">
		<<humanSettings>>
	</div>
	<br>
	<<link "맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
	<div style="clear:both;">/*Keep at end of toggles*/</div>
<</widget>>

<<widget "subsectionSettingsTabButton">>
	<div @class="_subsection is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'" >
		<<button _args[0]>>
			<<if _subsection isnot _args[1]>>
				<<set _subsection to _args[1]>>
				<<displaySubsection `_args[1] + "Settings"`>>
				<<replace #startTabSettings>><<allSettings>><</replace>>
			<</if>>
		<</button>>
	</div>
<</widget>>

<<widget "allSettings">>
	<<if _subsection is undefined>><<set _subsection to "human">><</if>>
	<div id="containerStart" class="containerWrap">
		<div id="settingsHuman">
			<<subsectionSettingsTabButton "일반 NPC 설정" "human">>
		</div>

		<div id="settingsNPC">
			<<subsectionSettingsTabButton "네임드 NPC 설정" "npc">>
		</div>

		<div id="settingsBeast">
			<<subsectionSettingsTabButton "짐승 설정" "beast">>
		</div>

		<div id="settingsFetish">
			<<subsectionSettingsTabButton "페티시 설정" "fetish">>
		</div>

		<div id="settingsPrice">
			<<subsectionSettingsTabButton "비용 및 획득량 설정" "price">>
		</div>

		<div id="settingsPregnancy">
			<<subsectionSettingsTabButton "임신 설정" "pregnancy">>
		</div>
		<<if $passage isnot "Start">>
			<div id="settingsSizeLimits">
				<<subsectionSettingsTabButton "신체 부위 크기 제한" "sizeLimits">>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "dolpSettingsTabButton">>
	<div @class="_dolp is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'" >
		<<button _args[0]>>
			<<if _dolp isnot _args[1]>>
				<<set _dolp to _args[1]>>
				<<displayDoLP `_args[1] + "Settings"`>>
				<<replace #dolpTabSettings>><<allDoLPSettings>><</replace>>
			<</if>>
		<</button>>
	</div>
<</widget>>

<<widget "allDoLPSettings">>
	<<if _dolp is undefined>><<set _dolp to "rebalance">><</if>>
	<div id="containerStart" class="containerWrap">
		<div id="settingsRebalance">
			<<dolpSettingsTabButton "재조정 설정" "rebalance">>
		</div>
		<div id="settingsNPCDoLP">
			<<dolpSettingsTabButton "NPC 설정" "npcDoLP">>
		</div>
		<div id="settingsBeastDoLP">
			<<dolpSettingsTabButton "짐승 설정" "beastDoLP">>
		</div>
		<div id="settingsCombatExtended">
			<<dolpSettingsTabButton "확장 전투(CE) 설정" "combatExtended">>
		</div>
		<div id="settingsAMCTraits">
			<<dolpSettingsTabButton "재능과 특성" "amcTraits">>
		</div>
		<div id="settingsXChange">
			<<dolpSettingsTabButton "X-체인지 설정" "xchange">>
		</div>
		<<if $passage isnot "Start">>
			<div id="settingsIdentity">
				<<dolpSettingsTabButton "정체성 설정" "identity">>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "genericGenders">>
	<div class="numberslider-inline maleChance">
		<<numberslider "$settings.maleChance" $settings.maleChance 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description">NPC 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">NPC의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 100:
						return `<span class="small-description">NPC 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
					default:
						return v > 50
							? `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`
							: `<span class="small-description">NPC의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`
				}
			},
		}>>
	</div>
<</widget>>

<<widget "beastGenders">>
	<<set _beasts to $genericBeastSettings.monsterChance is 100 ? "수인" : "짐승">>
	<div class="numberslider-inline beastmalechance">
		<span class="gold"><<= $genericBeastSettings.monsterChance is 100 ? "수인" : "짐승">> 성별:</span>
		<<numberslider "$genericBeastSettings.beastMaleChance" $genericBeastSettings.beastMaleChance 0 100 1 {
			onInputChange: v => {
				setAllBeastsMaleChanceSplit(false);
				setAllBeastsMaleChance(v);
			},
			value: v => {
				const beasts = V.genericBeastSettings.monsterChance === 100 ? "수인" : "짐승";
				const Beasts = beasts;
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> ${beasts}이 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">${Beasts}의 성비가 <span class='blue inline-colour'>수컷</span>과 <span class='pink inline-colour'>암컷</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 100:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> ${beasts}이 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
					default:
						return v > 50
							? `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`
							: `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`
				}
			},
		}>>
	</div>
<</widget>>

<<widget "monsterSettings">>
	<div class="beastSettingColumn">
		<div class="numberslider-inline">
			<span class="gold">수인 출현 확률:</span>
			<<numberslider "$genericBeastSettings.monsterChance" $genericBeastSettings.monsterChance 0 100 1 {
				onInputChange: v => {
					setAllBeastsMonsterChance(v);
				},
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">짐승은 <span class='gold inline-colour'>절대</span> 수인으로 나타나지 않습니다.</span>`;
						case 50:
							return `<span class="small-description">전체 짐승의 <span class='gold inline-colour'>절반</span>이 수인으로 대체됩니다.</span>`;
						case 100:
							return `<span class="small-description">짐승은 <span class='gold inline-colour'>항상</span> 수인으로 나타납니다.</span>`;
						default:
							return `<span class="small-description">짐승의 <span class='gold inline-colour'>${v}%</span>가 수인으로 대체됩니다.</span>`
					}
				},
			}>>
		</div>
		<label onchange="setAllBeastsMonsterHallucinationsOnly(V.genericBeastSettings.monsterHallucinationsOnly)">
			<<checkbox "$genericBeastSettings.monsterHallucinationsOnly" false true autocheck>> 수인은 환각 상태에서만 출현합니다
		</label>
		<label onchange="setAllBeastsVictimsAlwaysMonster(V.genericBeastSettings.victimsAlwaysMonster)">
			<<checkbox "$genericBeastSettings.victimsAlwaysMonster" false true autocheck>> 피해자가 되는 짐승은 항상 수인으로 나타납니다
		</label>
	</div>
<</widget>>

<<widget "npcAttractionSettings">>
	<div id="simpleGenders" @class="(V.settings.maleChanceSplit === true ? ' hidden' : '')">
		<span class="gold">일반 NPC 성별</span>
		<<genericGenders>>
	</div>
	<div id="splitGenders" @class="(V.settings.maleChanceSplit === false ? ' hidden' : '')">
		<<maleChanceSplitControls>>
	</div>
	<span id="humanSplitByFull"><<humanSplitByFull>></span>
<</widget>>

<<widget "beastAttractionSettings">>
	<div class="beastSettingColumn">
		<div id="simpleBeastGenders" @class="(V.genericBeastSettings.beastMaleChanceSplit ? ' hidden' : '')">
			<<beastGenders>>
		</div>
		<div id="splitBeastGenders" @class="(!V.genericBeastSettings.beastMaleChanceSplit ? ' hidden' : '')">
			<<beastMaleChanceSplitControls>>
		</div>
		<span id="beastSplitByFull"><<beastSplitByFull>></span>
		<div class="beastSettingBestiality" role="group" aria-label="Bestiality" onchange="setAllBeastsBestialityMode(V.genericBeastSettings.bestiality)">
			<span>수간:</span>
			<label><<radiobutton "$genericBeastSettings.bestiality" "on" autocheck>> 활성화</label> |
			<label><<radiobutton "$genericBeastSettings.bestiality" "monsterOnly" autocheck>> 수인으로만</label> |
			<label><<radiobutton "$genericBeastSettings.bestiality" "off" autocheck>> 비활성화</label>
		</div>
	</div>
<</widget>>

<<widget "humanSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 성별
			</div>
			<div class="settingsToggleItem">
				<<npcAttractionSettings>>
			</div>
			<div class="settingsToggleItem">
				<div class="numberslider-inline malevictimchance">
					<span class="gold">다른 피해자
						<mouse class="tooltip linkBlue">(?)<span>타협을 강요받거나 학대받는 상황에 처한 NPC들의 성별을 조정합니다.</span></mouse>
					</span>
					<<numberslider "$settings.maleVictimChance" $settings.maleVictimChance 0 100 1 {
						value: v => {
							switch (v) {
								case 0:
									return `<span class="small-description">당신이 조우하는 다른 피해자 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
								case 50:
									return `<span class="small-description">당신이 조우하는 다른 피해자의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
								case 100:
									return `<span class="small-description">당신이 조우하는 다른 피해자 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
								default:
									return v > 50
										? `<span class="small-description">당신이 조우하는 다른 피해자의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`
										: `<span class="small-description">당신이 조우하는 다른 피해자의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`
							}
						},
					}>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 신체 부위
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">여성의 평균 가슴 크기
				<mouse class="tooltip linkBlue">(?)<span>숫자가 클수록 세계의 가슴 크기가 커집니다. 12일 경우 모두가 거대한 가슴을 갖게 됩니다. -12일 경우 모두가 납작한 가슴을 갖게 됩니다. 기본값은 0이며, 넓은 범위의 크기가 나타납니다.</span></mouse>
				</span>
				<<numberslider "$settings.breastModifier" $settings.breastModifier -12 12 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 평균 자지 크기
				<mouse class="tooltip linkBlue">(?)<span>숫자가 클수록 세계의 자지 크기가 커집니다. 8일 경우 모두가 거대한 자지를 갖게 됩니다. -8일 경우 모두가 아주 작은 자지를 갖게 됩니다. 기본값은 0이며, 넓은 범위의 크기가 나타납니다.</span></mouse>
				</span>
				<<numberslider "$settings.penisModifier" $settings.penisModifier -8 8 1>>
			</div>
			<div class="solidBorderContainer">
				<<if $fregularchance is undefined>>
					<<if $fregular isnot undefined>>
						<<set $fregularchance to $fregular>>
						<<run delete $fregular>>
					<<else>>
						<<set $fregularchance to 100 - ($settings.femaleNPCPenisChance || 0)>>
					<</if>>
				<</if>>
				<<set $fregularchance to Math.clamp($fregularchance, 0, 100)>>
				<<set $fhermchance to 0>>
				<<set $settings.femaleNPCPenisChance to 100 - $fregularchance>>
				<div style="font-size:0.9em; margin-bottom: 1%">
					<span class="gold">보지만 가진 여성의 비율:</span> <span id="numberslider-value-fregularchance">$fregularchance</span><br>
					/* <span class="gold">둘 다 가진 여성의 비율:</span> <span id="numberslider-value-fhermchance">0</span><br> */
					<span class="gold">자지만 가진 여성의 비율:</span> <span id="numberslider-value-settings.femaleNPCPenisChance">$settings.femaleNPCPenisChance</span><br>
				</div>
				<<doubleslider "fregularchance" "fhermchance" "$settings.femaleNPCPenisChance" "var(--pink)" "var(--purple-secondary)" "var(--blue)">>
			</div>
			<div class="solidBorderContainer">
				<<if $mregularchance is undefined>>
					<<if $mregular isnot undefined>>
						<<set $mregularchance to $mregular>>
						<<run delete $mregular>>
					<<else>>
						<<set $mregularchance to 100 - ($settings.maleNPCVaginaChance || 0)>>
					<</if>>
				<</if>>
				<<set $mregularchance to Math.clamp($mregularchance, 0, 100)>>
				<<set $mhermchance to 0>>
				<<set $settings.maleNPCVaginaChance to 100 - $mregularchance>>
				<div style="font-size:0.9em; margin-bottom: 1%">
					<span class="gold">자지만 가진 남성의 비율:</span> <span id="numberslider-value-mregularchance">$mregularchance</span><br>
					/* <span class="gold">둘 다 가진 남성의 비율:</span> <span id="numberslider-value-mhermchance">0</span><br> */
					<span class="gold">보지만 가진 남성의 비율:</span> <span id="numberslider-value-settings.maleNPCVaginaChance">$settings.maleNPCVaginaChance</span><br>
				</div>
				<<doubleslider "mregularchance" "mhermchance" "$settings.maleNPCVaginaChance" "var(--blue)" "var(--purple-secondary)" "var(--pink)">>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">페니스 밴드 자지를 가진 여성의 비율 </span>
				<<numberslider "$settings.straponChance" $settings.straponChance 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">초거대 NPC 자지의 확률
				<mouse class="tooltip linkBlue">(?)<span>이미 가장 큰 자지 크기가 나온 NPC가 초거대 크기로 올라갈 확률입니다. X-체인지로 생성된 NPC의 자지와 무작위 페니스 밴드에도 적용됩니다.</span></mouse>
				</span>
				<<numberslider "$settings.npcColossalPenisChance" $settings.npcColossalPenisChance 0 100 1 { value: v => v + "%" }>>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 특성
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">학생이 처녀/동정일 확률
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC에게는 영향을 미치지 않습니다. 각 부위의 순결은 개별적으로 생성되므로, 다양한 조합이 가능합니다.</span></mouse>
				</span>
				<<numberslider "$settings.npcVirginChanceStudent" $settings.npcVirginChanceStudent 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">성인이 처녀/동정일 확률
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC에게는 영향을 미치지 않습니다. 각 부위의 순결은 개별적으로 생성되므로, 다양한 조합이 가능합니다.</span></mouse>
				</span>
				<<numberslider "$settings.npcVirginChanceAdult" $settings.npcVirginChanceAdult 0 100 1>>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">NPC 피부 톤:
				<mouse class="tooltip linkBlue">(?)<span>핸들을 드래그해 생성되는 NPC가 가질 수 있는 가장 밝은 피부색과 가장 어두운 피부색을 정합니다. 피부 톤은 가장 흔한 톤 주변에 몰립니다. 무작위로 생성되는 네임드 NPC의 피부 톤은 이 범위 안에 들어갑니다. 네임드 NPC는 개별 설정에서 이 범위 밖으로 피부 톤을 직접 정할 수도 있습니다. 피부 톤은 게임플레이에 영향을 주지 않습니다. 섹스/전투 중 NPC의 겉모습과 자녀가 물려받는 피부 톤만 바뀝니다.</span></mouse>
				</span>
				<<skinToneRange>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "maleChanceSplitControls">>
	<div class="numberslider-inline maleChanceMale">
		<span class="gold">남성에게 끌리는 일반 NPC 비율 <mouse class="tooltip linkBlue">(?)<span>마을에서 보이는 남/남 커플의 수에 영향을 줍니다. <i class="blue none">만약 당신이 남성처럼 보인다면, 당신에게 이끌리는 NPC들은 이 설정을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.maleChanceMale" $settings.maleChanceMale 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> 전원과 <span class='blue inline-colour'>남성</span> <span class='gold inline-colour'>0%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					case 100:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>남성</span> 전원이 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					default:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>남성</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
				}
			},
		}>>
		</div>
	</div>

	<div class="numberslider-inline maleChanceFemale">
		<span class="gold">여성에게 끌리는 일반 NPC <mouse class="tooltip linkBlue">(?)<span>마을에서 보이는 여/여 커플의 수에 영향을 줍니다. <i class="pink none">만약 당신이 여성처럼 보인다면, 당신에게 이끌리는 NPC들은 이 설정을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.maleChanceFemale" $settings.maleChanceFemale 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> 전원과 <span class='blue inline-colour'>남성</span> <span class='gold inline-colour'>0%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					case 100:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>남성</span> 전원이 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					default:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>남성</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
				}
			},
		}>>
		</div>
	</div>
<</widget>>

<<widget "beastSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 선호 설정
				<label class="settingsGranularToggle" onchange="wikifier('displaySubsection')">
					<<checkbox "$settings.granularBeastControl" false true autocheck>> 세부 짐승 선호 설정
					<mouse class="tooltip linkBlue">(?)<span>일반 짐승 설정을 바꾸면 모든 세부 짐승 설정에 그 값이 덮어씌워지며, 다른 세부 설정은 그대로 유지됩니다.</span></mouse>
				</label>
			</div>
			<<if $settings.granularBeastControl>>
				<<beastTypeSettingRow "dog" "Dogs">>
				<<beastTypeSettingRow "cat" "Cats">>
				<<beastTypeSettingRow "pig" "Pigs">>
				<<beastTypeSettingRow "boar" "Boars">>
				<<beastTypeSettingRow "wolf" "Wolves">>
				<<beastTypeSettingRow "bear" "Bears">>
				<<beastTypeSettingRow "dolphin" "Dolphins">>
				<<beastTypeSettingRow "lizard" "Lizards">>
				<<beastTypeSettingRow "cow" "Cattle">>
				<<beastTypeSettingRow "horse" "Horses">>
				<<beastTypeSettingRow "fox" "Foxes">>
				<<beastTypeSettingRow "hawk" "Hawks">>
				<<beastTypeSettingRow "spider" "Spiders">>
				<<beastTypeSettingRow "snake" "Snakes">>
			<<else>>
				<div class="settingsToggleItem">
					<<beastAttractionSettings>>
				</div>
				<div class="settingsToggleItem">
					<<monsterSettings>>
				</div>
			<</if>>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 설정
			</div>
			<div class="settingsToggleButton" class="link-internal macro-button">
				<<run beastTogglesCheck()>>
				<<button `"모든 짐승 " + (_anyBeastOn ? "비활성화" : "활성화")`>>
					<<script>>
						let val = T.anyBeastOn ? false : true;
						T.beastVars.forEach(x => V.settings[x] = val);
						V.genericBeastSettings.bestiality = val ? "on" : "off";
						setAllBeastsBestialityMode(V.genericBeastSettings.bestiality);
					<</script>>
					<<displaySubsection "beastSettings">>
				<</button>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.swarmsEnabled" false true autocheck>> 군집체(장어 등) 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.parasitesEnabled" false true autocheck>> 기생충 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.tentaclesEnabled" false true autocheck>> 촉수 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.slimesEnabled" false true autocheck>> 슬라임 활성화
				</label>
				<mouse class="tooltip linkBlue">(?)<span>피부와 성기에 달라붙는 슬라임과 슬라임 조우입니다.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.earSlimesEnabled" false true autocheck>> 귀 슬라임 활성화
				</label>
				<mouse class="tooltip linkBlue">(?)<span>귀 속으로 기어 들어가 행동에 영향을 주는 슬라임입니다. 일반 슬라임과는 별개입니다.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.earSlimeThoughts" false true autocheck>> 귀 슬라임이 불쑥 떠오르는 생각으로 나타남
				</label>
				<mouse class="tooltip linkBlue">(?)<span>슬라임이 귀로 기어 들어가는 대신, 최면이 머릿속에 목소리를 심습니다. 기생충이 비활성화된 상태에서도 작동하며, 몸에는 아무것도 자라지 않습니다. 귀 슬라임이 활성화되어 있어야 합니다.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.voreEnabled" false true autocheck>> 소프트 보어물(집어삼키기) 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.spidersEnabled" false true autocheck>> 거미 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.slugsEnabled" false true autocheck>> 민달팽이 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.maggotsEnabled" false true autocheck>> 구더기 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.waspsEnabled" false true autocheck>> 말벌 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.beesEnabled" false true autocheck>> 벌 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.lurkersEnabled" false true autocheck>> 럴커 활성화 <mouse class="tooltip linkBlue">(?)<span>럴커는 팔다리가 많고 가죽 같은 피부를 가진 기묘하게 생긴 생물입니다. 긴 주둥이를 사용하며 대체로 꽤 작습니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.plantsEnabled" false true autocheck>> 식물 수인 활성화
				</label>
			</div>
		</div>
		<div style="clear:both;">/*Keep at end of toggles*/</div>
	</div>
<</widget>>

<<widget "beastMaleChanceSplitControls">>
	<div class="numberslider-inline beastMaleChanceMale">
		<span class="gold">남성에게 끌리는 짐승 <mouse class="tooltip linkBlue">(?)<span>목격되는 수컷/수컷 짐승 짝짓기의 빈도에 영향을 미칩니다. <i class="blue none">당신이 남성으로 보일 경우, 당신에게 끌리는 NPC들은 이 패턴을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$genericBeastSettings.beastMaleChanceMale" $genericBeastSettings.beastMaleChanceMale 0 100 1 {
			onInputChange: v => {
				setAllBeastsMaleChanceSplit(true);
				setAllBeastsMaleChanceMale(v);
			},
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='gold inline-colour'>모든</span> <span class='pink inline-colour'>암컷 짐승</span>은 남성에게 끌리지만, <span class='blue inline-colour'>수컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> <span class='blue inline-colour'>남성에게 끌리지 않습니다</span>.</span>`;
						case 100:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> 남성에게 끌리지 않지만, <span class='gold inline-colour'>모든</span> <span class='blue inline-colour'>수컷 짐승</span>은 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
						default:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷 짐승</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					}
				},
			}>>
		</div>
	</div>
	<div class="numberslider-inline beastMaleChanceFemale">
		<span class="gold">여성에게 끌리는 짐승 <mouse class="tooltip linkBlue">(?)<span>목격되는 암컷/암컷 짐승 짝짓기의 빈도에 영향을 미칩니다. <i class="pink none">당신이 여성으로 보일 경우, 당신에게 끌리는 NPC들은 이 패턴을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$genericBeastSettings.beastMaleChanceFemale" $genericBeastSettings.beastMaleChanceFemale 0 100 1 {
			onInputChange: v => {
				setAllBeastsMaleChanceSplit(true);
				setAllBeastsMaleChanceFemale(v);
			},
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='gold inline-colour'>모든</span> <span class='pink inline-colour'>암컷 짐승</span>은 여성에게 끌리지만, <span class='blue inline-colour'>수컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> <span class='pink inline-colour'>여성에게 끌리지 않습니다</span>.</span>`;
						case 100:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> 여성에게 끌리지 않지만, <span class='gold inline-colour'>모든</span> <span class='blue inline-colour'>수컷 짐승</span>은 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
						default:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷 짐승</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					}
				},
			}>>
		</div>
	</div>
<</widget>>

<<widget "beastTypeGenders">>
	<<set _beastType to _args[0]>>
	<<capture _beastType>>
		<<if $settings.beastSettings[_beastType].maleChanceSplit>>
			<div class="numberslider-inline">
				<span>남성에게 끌림 <mouse class="tooltip linkBlue">(?)<span>대상이 남성으로 보일 때 이 생물 중 <span class="blue none">수컷</span>이 차지하는 비율입니다. 수컷/수컷 짝짓기가 얼마나 보이는지에 영향을 줍니다.</span></mouse>:</span>
				<<numberslider `"$settings.beastSettings." + _beastType + ".maleChanceMale"` $settings.beastSettings[_beastType].maleChanceMale 0 100 1 {
					value: v => {
						switch (v) {
							case 0:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span> <span class='gold inline-colour'>전원</span>과 <span class='blue inline-colour'>수컷</span> <span class='gold inline-colour'>0%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
							case 100:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>수컷</span> <span class='gold inline-colour'>전원</span>이 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
							default:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
						}
					},
				}>>
			</div>
			<div class="numberslider-inline">
				<span>여성에게 끌림 <mouse class="tooltip linkBlue">(?)<span>대상이 여성으로 보일 때 이 생물 중 <span class="blue none">수컷</span>이 차지하는 비율입니다. 암컷/암컷 짝짓기가 얼마나 보이는지에 영향을 줍니다.</span></mouse>:</span>
				<<numberslider `"$settings.beastSettings." + _beastType + ".maleChanceFemale"` $settings.beastSettings[_beastType].maleChanceFemale 0 100 1 {
					value: v => {
						switch (v) {
							case 0:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span> <span class='gold inline-colour'>전원</span>과 <span class='blue inline-colour'>수컷</span> <span class='gold inline-colour'>0%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
							case 100:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>수컷</span> <span class='gold inline-colour'>전원</span>이 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
							default:
								return `<span class="small-description"><span class='pink inline-colour'>암컷</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
						}
					},
				}>>
			</div>
		<<else>>
			<div class="numberslider-inline">
				<span>성별:</span>
				<<numberslider `"$settings.beastSettings." + _beastType + ".maleChance"` $settings.beastSettings[_beastType].maleChance 0 100 1 {
					value: v => {
						switch (v) {
							case 0:
								return `<span class="small-description"><span class='gold inline-colour'>전원</span>이 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
							case 50:
								return `<span class="small-description"><span class='blue inline-colour'>수컷</span>과 <span class='pink inline-colour'>암컷</span>이 <span class='gold inline-colour'>반반</span>으로 나뉩니다.</span>`;
							case 100:
								return `<span class="small-description"><span class='gold inline-colour'>전원</span>이 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
							default:
								return v > 50
									? `<span class="small-description"><span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`
									: `<span class="small-description"><span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
						}
					},
				}>>
			</div>
		<</if>>
		<<link `$settings.beastSettings[_beastType].maleChanceSplit ? "성적 지향 무시" : "성적 지향 설정"`>>
			<<set $settings.beastSettings[_beastType].maleChanceSplit to !$settings.beastSettings[_beastType].maleChanceSplit>>
			<<displaySubsection>>
		<</link>>
	<</capture>>
<</widget>>

<<widget "beastTypeSettingRow">>
	<<set _beastType to _args[0]>>
	<<set _beastLabel to _args[1]>>
	<div class="settingsToggleItemWide">
		<div class="gold beastTypeSettingLabel"><<print _beastLabel>></div>
		<div class="beastTypeSettingSplit">
			<div class="beastSettingColumn">
				<<beastTypeGenders _beastType>>
				<div class="beastSettingBestiality" role="group" aria-label="Bestiality">
					<span>수간:</span>
					<label><<radiobutton `"$settings.beastSettings." + _beastType + ".bestiality"` "on" autocheck>> 활성화</label> |
					<label><<radiobutton `"$settings.beastSettings." + _beastType + ".bestiality"` "monsterOnly" autocheck>> 수인으로만</label> |
					<label><<radiobutton `"$settings.beastSettings." + _beastType + ".bestiality"` "off" autocheck>> 비활성화</label>
				</div>
			</div>
			<div class="beastSettingColumn">
				<div class="numberslider-inline">
					<span>수인 출현 확률:</span>
					<<numberslider `"$settings.beastSettings." + _beastType + ".monsterChance"` $settings.beastSettings[_beastType].monsterChance 0 100 1 {
						value: v => {
							switch (v) {
								case 0:
									return `<span class="small-description">이 생물은 <span class='gold inline-colour'>절대</span> 수인으로 나타나지 않습니다.</span>`;
								case 50:
									return `<span class="small-description">이 생물의 <span class='gold inline-colour'>절반</span>이 수인으로 대체됩니다.</span>`;
								case 100:
									return `<span class="small-description">이 생물은 <span class='gold inline-colour'>항상</span> 수인으로 나타납니다.</span>`;
								default:
									return `<span class="small-description">이 생물의 <span class='gold inline-colour'>${v}%</span>가 수인으로 대체됩니다.</span>`;
							}
						},
					}>>
				</div>
				<label>
					<<checkbox `"$settings.beastSettings." + _beastType + ".hallucinationsOnly"` false true autocheck>> 이 유형의 수인은 환각 상태에서만 출현합니다
				</label>
				<label>
					<<checkbox `"$settings.beastSettings." + _beastType + ".victimsAlwaysMonster"` false true autocheck>> 이 유형의 피해자는 항상 수인으로 나타납니다
				</label>
			</div>
		</div>
	</div>
<</widget>>

<<widget "namedBeastSettingRow">>
	<<set _namedBeastKey to _args[0]>>
	<div class="settingsToggleItem">
		<div class="numberslider-inline">
			<span class="gold">수인 출현 확률:</span>
			<<numberslider `"$settings.namedBeasts." + _namedBeastKey + ".monsterChance"` $settings.namedBeasts[_namedBeastKey].monsterChance 0 100 1 {
				onInputChange: v => {
					if (v === 0) {
						$("#npcSkinToneSetting").addClass("hidden");
					} else {
						$("#npcSkinToneSetting").removeClass("hidden");
					}
				},
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='gold inline-colour'>항상</span> 진짜 짐승입니다.</span>`;
						case 100:
							return `<span class="small-description"><span class='gold inline-colour'>항상</span> 수인입니다.</span>`;
						default:
							return `<span class="small-description"><span class='gold inline-colour'>${v}%</span> 확률로 수인으로 나타납니다.</span>`;
					}
				},
			}>>
		</div>
		<label>
			<<checkbox `"$settings.namedBeasts." + _namedBeastKey + ".hallucinationsOnly"` false true autocheck>> 수인은 환각 상태에서만 출현
		</label>
	</div>
<</widget>>

<<widget "fetishSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.analEnabled" false true autocheck>> 애널 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.pubicHairEnabled" false true autocheck>> 음모 성장 활성화
			</label>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsAnalingusHead">
			<span id="settingsAnalingusHead">애널링구스:</span><br>
			<label>
				<<checkbox "$settings.analingusGivingEnabled" false true autocheck>> 하기
			</label>

			<label>
				<<checkbox "$settings.analingusReceivingEnabled" false true autocheck>> 받기
			</label>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsDoubleHead">
			<span id="settingsAnalingusHead">이중 삽입:</span><br>
			<label>
				<<checkbox "$settings.vaginalDoubleEnabled" false true autocheck>> 보지
			</label>
			<label data-target="settingsanalEnabled" data-disabledif="V.settings.analEnabled===false">
				<<checkbox "$settings.analDoubleEnabled" false true autocheck>> 애널
			</label>
			<mouse class="tooltip linkBlue">(?)<span>이중 애널 삽입은 애널이 활성화되어 있어야 합니다.
			<br>여기서 "이중 삽입"은 플레이어의 동일한 구멍에 두 개의 남근이 삽입되는 것을 의미합니다.</span></mouse>
		</div>

		<div class="settingsToggleItem" role="group">
			변신:
			<mouse class="tooltip linkBlue">(?)<span>신성한 변신 하나와 동물 변신 하나를 동시에 가질 수 있습니다. 한 범주를 비활성화하면 새로 시작되거나 더 진행되는 것만 막고, 이미 가진 변신을 되돌리거나 숨기지는 않습니다. 이미 가진 변신을 치료하려면 여전히 게임 내에서 보통 그것을 되돌리는 방법이 필요합니다.</span></mouse>
			<br>
			<label><<checkbox "$settings.transformAnimalEnabled" false true autocheck>> 동물화</label>
			<label><<checkbox "$settings.transformDivineEnabled" false true autocheck>> 신성화</label>
		</div>

		<div class="settingsToggleItem" role="group">
			<label>
				<<checkbox "$settings.breastFeedingEnabled" false true autocheck>> 수유 활성화
			</label>
			<br>
			<label data-target="settingsbreastFeedingEnabled" data-disabledif="V.settings.breastFeedingEnabled===false">
				<<checkbox "$settings.lactationFlatChestEnabled" false true autocheck>> 최소 가슴 크기에서도 허용
			</label>
			<mouse class="tooltip linkBlue">(?)<span>가슴이 납작한 플레이어도 수유하고 유축기를 쓸 수 있게 합니다. 이 설정이 없으면 가슴 크기가 최소일 때 수유가 멈춥니다.</span></mouse>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.watersportsEnabled" false true autocheck>> 워터스포츠(방뇨) 활성화
				<mouse class="tooltip linkBlue">(?)<span>워터스포츠는 소변을 보는 것과 관련된 성적 행위를 뜻합니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.footFetishEnabled" false true autocheck>> 발 페티시 활성화
				<mouse class="tooltip linkBlue">(?)<span>비활성화해도 플레이어의 발 자체가 사라지지는 않습니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.facesitEnabled" false true autocheck>> 얼굴에 앉기(안면승마) 활성화
				<mouse class="tooltip linkBlue">(?)<span>비활성화해도 커닐링구스(보지핥기)가 방지되지는 않습니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.hypnosisEnabled" false true autocheck>> 최면 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.arousalMoanEnabled" false true autocheck>> 신음과 끙끙거림 활성화
				<mouse class="tooltip linkBlue">(?)<span>흥분이 오르면 섹스 중에 소리 내어 신음하거나 끙끙거리게 합니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.forcedCrossdressingEnabled" false true autocheck>> 강제 크로스드레싱 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			오르가슴: <br>
			<label>
				<<checkbox "$settings.ruinedOrgasmEnabled" false true autocheck>> 망가진 절정 활성화
			</label>
			<mouse class="tooltip linkBlue">(?)<span>귀 슬라임 전용입니다.</span></mouse>
			<br>
			<label>
				<<checkbox "$settings.smallPenisSemenVolumeLossDisabled" false true autocheck>> 정액량 감소 비활성화
			</label>
			<mouse class="tooltip linkBlue">(?)<span>건조 오르가슴은 여전히 일어나지만 정액량을 줄이지는 않습니다.</span></mouse>
			<br>
			<label>
				<<checkbox "$settings.femaleClimaxAlways" false true autocheck>> 여자처럼 절정
			</label>
			<mouse class="tooltip linkBlue">(?)<span>자지가 더 크더라도 모든 자지 오르가슴이 건조한 분수식 절정으로 이어지게 합니다.</span></mouse>
			<br>
			<label>
				<<checkbox "$settings.clearClimaxEnabled" false true autocheck>> 투명한 절정
			</label>
			<mouse class="tooltip linkBlue">(?)<span>정액량이 50 아래로 떨어지면 누구도 임신시킬 수 없는 투명한 액체를 쌉니다. 정액량이 다시 90에 이르러야 원래대로 돌아옵니다. 투명한 절정을 겪을 때마다 콤플렉스가 하나씩 생깁니다.</span></mouse>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsToysHead">
			<span id="settingsSexToysHead">섹스 토이:</span>
			<mouse class="tooltip linkBlue">(?)<span>"딜도"는 딜도, 애널 비즈 등 삽입형 장난감을 뜻합니다. 페니스 밴드는 비활성화되지 않습니다.<br>"채찍"은 승마용 채찍과 일반 채찍을 포함합니다. 스팽킹 장면에서는 채찍이 제거되지 않습니다.<br>"장난감 동시 삽입"을 켜면, 성행위 중 장난감이 함께 삽입될 수 있습니다. (예: 보지에 자지와 딜도가 동시에 삽입됨)</span></mouse>
			<br>
			<label>
				<<checkbox "$settings.toyDildoEnabled" false true autocheck>> 딜도
			</label>
			<label>
				<<checkbox "$settings.toyWhipEnabled" false true autocheck>> 채찍
			</label>
			<label>
				<<checkbox "$settings.toyMultiplePenetrationEnabled" false true autocheck>> 장난감 동시 삽입
			</label>
			<br>
			<label>
				<<checkbox "$settings.toyVirginityEnabled" false true autocheck>> 장난감이 처녀성을 가져갈 수 있음
				<mouse class="tooltip linkBlue">(?)<span>딜도처럼 삽입하는 장난감(바이브레이터 제외)이 입구를 건드리기만 하는 데서 그치지 않고, 질/항문의 처녀성(당신 또는 NPC의 것)을 가져갈 수 있게 합니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			몸 낙서:
			<<numberslider "$settings.bodyWritingLevel" $settings.bodyWritingLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC가 당신의 몸에 낙서할 수 <span class='green inline-colour'>없습니다</span>.</span>`;
						case 1:
							return `<span class="small-description">NPC가 몸에 낙서해도 되는지 <span class='blue inline-colour'>물어볼 수 있습니다</span>.</span>`;
						case 2:
							return `<span class="small-description">NPC가 당신의 몸에 <span class='purple inline-colour'>강제로</span> 낙서할 수 있습니다.</span>`;
						case 3:
							return `<span class="small-description">NPC가 당신의 몸에 <span class='red inline-colour'>강제로</span> 낙서하거나 <span class='red inline-colour'>문신</span>을 새길 수 있습니다.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItem">
			NPC 화장 간섭:<mouse class="tooltip linkBlue">(?)<span>대상이 되는 조우는 인간 NPC와의 비동의 전투 중, 당신이 중심을 잃었거나(또는 서서 싸우는 중이거나) 마스크로 얼굴이 가려져 있지 않고 NPC의 손 하나가 비어 있는 경우입니다. 맨얼굴의 남성 캐릭터는 화장이 칠해질 수 있고, 화장을 한 여성 캐릭터는 화장이 지워질 수 있습니다.</span></mouse>
			<<numberslider "$settings.npcMakeupLevel" $settings.npcMakeupLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC가 조우 중에 당신의 화장을 하거나 지우는 일은 <span class='green inline-colour'>없습니다</span>.</span>`;
						case 1:
							return `<span class="small-description">NPC가 대상이 되는 조우 중에 당신의 화장을 하거나 지우는 일이 <span class='blue inline-colour'>드물게</span> 있습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC가 대상이 되는 조우 중에 당신의 화장을 하거나 지우는 일이 <span class='purple inline-colour'>가끔</span> 있습니다.</span>`;
						case 3:
							return `<span class="small-description">NPC가 대상이 되는 조우 중에 당신의 화장을 하거나 지우는 일이 <span class='red inline-colour'>자주</span> 있습니다.</span>`;
						formattedDate = `${dd}일 ${mm}월 ${yyyy}년`;
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItem">
			플레이어 콘돔 자동 파손:<mouse class="tooltip linkBlue">(?)<span>삽입이 이루어지는 매 턴마다 당신의 콘돔이 저절로 터질 확률을 정합니다.</span></mouse>
			<<numberslider "$settings.playerCondomBreakChance" $settings.playerCondomBreakChance 0 100 1 {
				value: v => `<span class="small-description">당신의 콘돔은 상대 몸속에 있는 매 턴마다 <span class='${v === 0 ? "green" : v < 20 ? "blue" : "red"} inline-colour'>${v}%</span> 확률로 터집니다.</span>`
			}>>
		</div>
		<div class="settingsToggleItem">
			NPC 콘돔 자동 파손:<mouse class="tooltip linkBlue">(?)<span>삽입이 이루어지는 매 턴마다 NPC의 콘돔이 저절로 터질 확률을 정합니다.</span></mouse>
			<<numberslider "$settings.npcCondomBreakChance" $settings.npcCondomBreakChance 0 100 1 {
				value: v => `<span class="small-description">NPC의 콘돔은 당신 몸속에 있는 매 턴마다 <span class='${v === 0 ? "green" : v < 20 ? "blue" : "red"} inline-colour'>${v}%</span> 확률로 터집니다.</span>`
			}>>
		</div>

		<div class="settingsToggleItem">
			NPC 정조대:<mouse class="tooltip linkBlue">(?)<span>조우에서 진 뒤나 보호소에서, 윈터의 창고에서, 또는 휘트니가 당신에게 강제로 채우는 정조대를 다룹니다. 이미 차고 있는 정조대의 열쇠를 NPC가 가져가는 경우도 포함합니다.
			<br><br>0이면 이런 이벤트가 비활성화됩니다. NPC가 원래 채워 준 정조대를 교체하거나 다시 잠그는 일은 여전히 일어날 수 있습니다. 신전에서처럼 스스로 찬 정조대는 영향을 받지 않습니다.</span></mouse>
			<<numberslider "$settings.npcChastityLevel" $settings.npcChastityLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC가 당신에게 정조대를 채우거나 열쇠를 가져가는 일은 <span class='green inline-colour'>결코</span> 없습니다.</span>`;
						case 1:
							return `<span class="small-description">NPC가 당신에게 정조대를 강제로 채우는 일이 <span class='blue inline-colour'>드물게</span> 있습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC가 당신에게 정조대를 강제로 채우는 일이 <span class='purple inline-colour'>가끔</span> 있습니다.</span>`;
						case 3:
							return `<span class="small-description">NPC가 당신에게 정조대를 강제로 채우는 일이 <span class='red inline-colour'>자주</span> 있습니다.</span>`;
						formattedDate = `${dd}일 ${mm}월 ${yyyy}년`;
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItem">
			질식:
			<<numberslider "$settings.asphyxiaLevel" $settings.asphyxiaLevel 0 5 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">목은 건드리지 마세요!</span>`;
						case 1:
							return `<span class="small-description">NPC가 당신의 목을 <span class='blue inline-colour'>붙잡을 수 있습니다</span>. 호흡을 방해하지는 않습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC가 합의된 성관계 중 당신을 <span class='purple inline-colour'>조르려 할 수 있습니다</span>.</span>`;
						case 3:
							return `<span class="small-description">NPC가 비동의 성관계 중 당신의 <span class='orange inline-colour'>목을 조르려 할 수 있습니다</span>.</span>`;
						case 4:
							return `<span class="small-description">NPC가 비동의 성관계 중 <span class='red inline-colour'>자주</span> 당신의 <span class='red inline-colour'>목을 조르려 할 수 있습니다</span>.</span>`;
						case 5:
							return `<span class="small-description">NPC가 비동의 성관계 중 <span class='lustful inline-colour'>화가 나지 않았어도</span> 당신의 <span class='lustful inline-colour'>목을 거리낌 없이 조릅니다</span>.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItemWide">
			<<if !$femininityModifier>><<set $femininityModifier to {}>><</if>>
			나체 성별 외형:
			<<numberslider "$settings.nudeGenderPerception" $settings.nudeGenderPerception 0 2 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC는 당신의 성별 외형을 판단할 때 성기를 <span class='blue inline-colour'>무시합니다</span>.</span>`;
						case 1:
							return `<span class="small-description">NPC는 당신의 성별 외형을 판단할 때 성기를 <span class='purple inline-colour'>고려합니다</span>.</span>`;
						case 2:
							return `<span class="small-description">NPC는 당신의 성별 외형을 성기에 따라 <span class='red inline-colour'>판단합니다</span>.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>
		</div>
	</div>
<</widget>>

<<widget "priceSettings">>
	<div class="solidBorderContainer clothes-price-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				베일리의 상납금
			</div>
			<div class="settingsToggleItemWide">
				<div class="small-description">
					베일리가 매주 요구하는 상납금의 액수를 조절합니다. 기본값은 100%입니다. <br>
					<span class="red">이 값을 100% 미만으로 설정하면 해당 세이브에서 업적을 얻을 수 없게 됩니다.</span>
				</div>
				<div class="ironman-slider" id="sliderRentMode">
					<<numberslider "$settings.rentCostModifier" $settings.rentCostModifier 0.1 10 0.1 $ironmanmode>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				상점 물가
			</div>
			<div class="settingsToggleItem">
				<div>
					<span class="gold">의류 가격</span>
					<div class="small-description">의류 아이템의 비용을 조절합니다. 구매, 자동 재구매, 수선 비용이 모두 포함됩니다. 수건은 여전히 무료입니다.</div>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">모든 의류 가격</span>
					<div class="small-description">하드 모드로는 200%를 추천합니다.</div>
					<<numberslider "$settings.clothingCostModifier" $settings.clothingCostModifier 1 10 0.5>>
				</div>
			</div>
			<div class="settingsToggleItem">
				<div>
					<span class="gold">속옷 가격</span>
					<<numberslider "$settings.underwearCostModifier" $settings.underwearCostModifier 1 2 0.1>>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">학교 교복 가격</span>
					<<numberslider "$settings.schoolClothingCostModifier" $settings.schoolClothingCostModifier 1 2 0.1>>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">음란한 옷 가격</span>
					<<numberslider "$settings.lewdClothingCostModifier" $settings.lewdClothingCostModifier 0.1 2 0.1>>
				</div>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">가구 가격</span>
				<div class="small-description">가구의 가격을 조절합니다.</div>
				<div class="ironman-slider" id="slider-furniture-price-factor">
					<<numberslider "$settings.furnitureCostModifier" $settings.furnitureCostModifier 0.6 5 0.2 $ironmanmode>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				작물 수확량
			</div>
			<div class="settingsToggleItemWide">
				<div class="small-description">수확되는 작물의 양을 조절합니다. 기본값은 500%입니다. 100%는 (기존) 하드 모드입니다.</div>
					<span class="red">이 값을 650%보다 높게 설정하면 해당 세이브에서 업적을 얻을 수 없습니다.</span>
				<div class="ironman-slider" id="sliderTendingYieldFactor">
					<<numberslider "$settings.tendingYieldModifier" $settings.tendingYieldModifier 1 10 0.5 $ironmanmode>>
				</div>
			</div>
		</div>
	</div>
		<!-- Make it show % instead of fractions and add some colour -->
		<<run $(() => { $('.clothes-price-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => Math.round(value * 100) + '%');

				if (value > 1)
					valSpan.css('color', 'gold');
				else if (value < 1)
					valSpan.css('color', 'green');
				else
					valSpan.css('color', 'unset');
			}).trigger('change') })>>
		<!-- Set the initial minimum -->
		<<run $(() => {
			let newmin = parseFloat((Math.ceil(10 / $('#numberslider-input-settingsclothingcostmodifier').val()) * 0.1).toFixed(1));
			let oldval = V.settings.lewdClothingCostModifier;
			$('#numberslider-input-settingslewdclothingcostmodifier').attr('min', newmin).val(oldval).trigger('change');
		})>>
		<!-- Limit lewd slider so that all coef * lewd coef >= 100% -->
		<<run $(() => {
			$('#numberslider-input-settingsclothingcostmodifier').on('input change', e => {
				let newmin = parseFloat((Math.ceil(10 / $(e.currentTarget).val()) * 0.1).toFixed(1));
				let oldval = V.settings.lewdClothingCostModifier;
				$('#numberslider-input-settingslewdclothingcostmodifier').attr('min', newmin).val(oldval).trigger('change');
			})
		})>>
<</widget>>

<<widget "incompletePregnancy">>
	<label><<checkbox "$settings.incompletePregnancyEnabled" false true autocheck>> 미완성 임신 콘텐츠 활성화</label>
	<<if _foundPregnancy>>
		<mouse class="tooltip linkBlue">(!!!)<span>네임드 NPC가 임신 중일 때는 비활성화할 수 없습니다.</span></mouse>
	<<else>>
		<mouse class="tooltip linkBlue">(?)<span>
			<div>활성화하면, 플레이어는 임신 가능한 모든 네임드 NPC를 임신시키거나 NPC에게 임신당할 수 있게 됩니다. 이는 임신 관련 상호작용이 없는 NNPC도 포함합니다. 비활성화하면, 콘텐츠가 미완성인 NNPC는 설정에서 임신 관련 토글이 회색으로 비활성화됩니다.</div>
			<div class="red">경고: 이로 인해 네임드 NPC가 플레이어의 임신이나 자신의 임신에 반응하지 않는 상황이 발생할 수 있으며, 기존 세이브 파일이 향후 업데이트될 콘텐츠를 건너뛰게 될 수 있습니다.</div>
		</span></mouse>
	<</if>>
<</widget>>

<<widget "fertilityCycles">>
	<label><<checkbox "$settings.fertilityCycleEnabled" false true autocheck>> 배란 주기 활성화</label>
	<mouse class="tooltip linkBlue">(?)<span>
		<div>활성화하면, 플레이어의 월경 주기가 임신 가능 여부를 결정합니다.</div>
		<div>비활성화하면 가임률이 항상 최고치로 유지됩니다. 발정기가 더 이상 적용되지 않습니다. 가임 촉진제로 인한 발정과 흥분은 영향을 받지 않습니다.</div>
	</span></mouse>
<</widget>>

<<widget "pregnancyType">>
	<label><<radiobutton "$settings.pregnancyType" "realistic" autocheck>> <mouse class="tooltip green">현실적<span>임신이 바로 진행되지 않으며, 임신이 되었는지 즉시 알 수 없습니다. 임신 테스트기를 사용해야 할 수도 있으며, 처음에는 아버지가 누구인지 모를 수 있습니다. 수 시간 안에 씻어내지 않으면 보지 바깥에 묻은 정액으로도 임신할 수 있습니다.</span></mouse></label> |
	<label><<radiobutton "$settings.pregnancyType" "fetish" autocheck>> <mouse class="tooltip pink">페티시<span>정액이 몸 안에 들어가는 즉시 임신이 될 수 있습니다. 임신이 되는 순간 바로 알 수 있으며, 아버지가 누구인지 즉시 알 수 있습니다.</span></mouse></label> |
	<label><<radiobutton "$settings.pregnancyType" "silly" autocheck>> <mouse class="tooltip gold">엉뚱함<span>손을 잡거나 입을 맞추는 즉시, 특히 사랑하는 사람과라면 임신할 수 있습니다. <i class="red none">이 모드에서는 스토리 내용과 관련된 문제가 있을 수 있습니다. 이 모드에서는 일부 업적이 비활성화됩니다.</i></span></mouse></label>
<</widget>>

<<widget "pregnancySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<<if $passage isnot "Start">>
				<div class="settingsToggleItemWide">
					<span class="red">이 설정들을 변경하더라도 현재 진행 중인 임신이 중단되거나 플레이어가 자식들과 상호작용하는 것을 막지는 못합니다.</span>
				</div>
			<</if>>
			<div class="settingsHeader">
				임신 확률
			</div>
			<div class="settingsToggleItemWide">
				<div class="numberslider-inline basePlayerPregnancyChance-container">
					<span class="gold">기본 플레이어 임신 확률</span>
					<<numberslider "$settings.basePlayerPregnancyChance" $settings.basePlayerPregnancyChance 0 100 1>>
					<div class="small-description">가임력이 최고조일 때, 하루마다 정액 한 회분이 당신을 임신시킬 확률입니다. 한 회분의 정액은 남아있는 동안 계속 확률을 유지하므로 매일 다시 판정합니다. 일부 이벤트로 인해 두 회분 이상의 정액이 남을 수도 있습니다.<br>
					<span class="green">현실적</span> 모드에서는 배란 주기 등 다른 요소들이 가임력을 변화시켜 임신 확률을 늘리거나 줄일 수 있습니다. 안전한 날에는 이 설정을 높여도 확률이 여전히 0에 가까울 수 있습니다.<br>
					<span class="pink">페티시</span> 모드에서는 정액 한 회분이 몸에 닿는 순간의 수정 확률을 뜻합니다. 끄지 않는 한 피임약과 배란 주기는 여전히 적용됩니다.<br>
					<span class="gold">엉뚱함</span> 모드에서는 손을 잡거나 입을 맞출 때마다의 확률입니다. 연애 상대 곁에서는 두 배가 됩니다.</div>
				</div>
			</div>
			<<run $(() => { $('.basePlayerPregnancyChance-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => value + "%");
			}).trigger('change') })>>

			<div class="settingsToggleItemWide numberslider-inline basenpcpregnancychance-container">
				<span class="gold">기본 NPC 임신 확률</span>
				<<numberslider "$settings.baseNpcPregnancyChance" $settings.baseNpcPregnancyChance 0 100 1>>
				<div class="small-description">가임력이 최고조일 때 삽입 사정으로 NPC가 임신할 확률입니다. <br>
				참고: 일부 NNPC는 피임약이나 가임 촉진제를 복용할 수 있으며, 이는 이 확률에 영향을 줍니다.</div>
			</div>
			<<run $(() => { $('.basenpcpregnancychance-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => value + "%");
			}).trigger('change') })>>
			<div class="settingsToggleItem">
					임신 유형:
					<<pregnancyType>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<realisticChildbirth>>
				</label>
			</div>
			<div class="settingsToggleItem">
				<<fertilityCycles>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyHumanEnabled" false true autocheck>> 플레이어의 인간 아이 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyBeastEnabled" false true autocheck>> 플레이어의 짐승 아이 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.npcPregnancyEnabled" false true autocheck>> 일반 NPC 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.nnpcPregnancyEnabled" false true autocheck>> 네임드 NPC 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 항문 임신:</span> <mouse class="tooltip linkBlue">(?)<span>
					<div>기본적으로 비활성화되어 있습니다. 켜면 플레이어 캐릭터가 항문으로 임신하고 출산할 수 있게 됩니다. 끄면 항문으로는 임신할 수 없습니다. "특수한 상황"으로 설정하면, 게임 내의 특정 방법을 통해서만 항문 임신이 가능합니다.</div>
					<div><div class="red">참고: 이것은 기생체와는 별개의 토글입니다. 기생체는 이 설정을 끄지 않는 한 질/항문으로 여전히 당신을 임신시킬 수 있습니다.</div></div>
				</span></mouse>
				<br>
				<label><<radiobutton "$settings.analPregnancy" "exceptional" autocheck>> 특수한 상황</label> |
				<label><<radiobutton "$settings.analPregnancy" "always" autocheck>> 켜짐</label> |
				<label><<radiobutton "$settings.analPregnancy" false autocheck>> 꺼짐</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">NPC 항문 임신:</span> <mouse class="tooltip linkBlue">(?)<span>
					<div>기본적으로 비활성화되어 있습니다. 켜면 NPC가 항문으로 임신할 수 있게 되며, 세계는 이를 일반적인 임신처럼 취급합니다. 끄면 항문 임신이 불가능합니다. 항문 임신은 네임드 NPC별로 각자의 설정에서 개별적으로 켜고 끌 수도 있습니다.</div>
					<div><div class="red">참고: 항문 임신이 작동하려면 임신 자체도 켜져 있어야 합니다. 미완성 임신 콘텐츠도 켜야 할 수 있습니다. 질을 가진 NPC도 설정에서 끄지 않는 한 항문으로 임신될 수 있습니다.</div></div>
				</span></mouse>
				<br>
				<label><<radiobutton "$settings.npcAnalPregnancyEnabled" true autocheck>> 켜짐</label> |
				<label><<radiobutton "$settings.npcAnalPregnancyEnabled" false autocheck>> 꺼짐</label>
			</div>
			<<set _foundPregnancy to !!Object.values($NPCName).find(npc => npc.pregnancy && npc.pregnancy.enabled && getActivePregnancies(npc.fullDescription).length && !setup.pregnancy.canBePregnant.includes(npc.fullDescription))>>
			<span data-target='["settingsincompletepregnancyenabled", "settingsnnpcpregnancyenabled", "settingsplayerpregnancyhumanenabled", "settingsplayerpregnancybeastenabled"]' data-disabledif="(T.foundPregnancy&&V.settings.incompletePregnancyEnabled===true)||(!V.settings.nnpcPregnancyEnabled&&!V.settings.playerPregnancyHumanEnabled&&!V.settings.playerPregnancyBeastEnabled)">
				<div class="settingsToggleItem">
						<<incompletePregnancy>>
				</div>
			</span>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				임신 기간
			</div>
			<<if playerPregnancyProgress() gte 0.9>>
				<span class="red">현재 임신 막바지에 다다랐기 때문에, 임신 기간 설정을 변경할 수 없습니다.</span>
			<</if>>
				<div class="settingsToggleItem numberslider-inline humanPregnancyMonths-container" data-target="humanPregnancyMonths" @data-disabledif="playerPregnancyProgress() gte 0.9">
					<span class="gold">인간 임신 기간:</span>
					<<numberslider "$settings.humanPregnancyMonths" $settings.humanPregnancyMonths 1 9 1 { value: (v) => v + "개월" }>>
				</div>
				<div class="settingsToggleItem numberslider-inline wolfPregnancyWeeks-container" data-target="wolfPregnancyWeeks" @data-disabledif="playerPregnancyProgress() gte 0.9">
					<span class="gold">늑대 임신 기간:</span>
					<<numberslider "$settings.wolfPregnancyWeeks" $settings.wolfPregnancyWeeks 2 12 1 { value: (v) => v + "주" }>>
				</div>
				<<run $(() => { $('.humanPregnancyMonths-container input, .wolfPregnancyWeeks-container input').on('input change', e => {
					if(V.feats.pregnancyLocked){
						$('#pregnancyFeatsDisabled').text("일부 임신 업적이 비활성화되었습니다.");
						$('#pregnancyFeatsDisabled').css('display', 'block');
					} else if(V.settings.humanPregnancyMonths < 3 || V.settings.wolfPregnancyWeeks < 4){
						$('#pregnancyFeatsDisabled').text("일부 임신 업적이 비활성화됩니다.");
						$('#pregnancyFeatsDisabled').css('display', 'block');
					} else{
						$('#pregnancyFeatsDisabled').text("");
						$('#pregnancyFeatsDisabled').css('display', 'none');
					}
				}).trigger('change') })>>
				<div id="pregnancyFeatsDisabled" class="red"></div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				임신 설정 토글
			</div>
			<div class="settingsToggleItem">
				콘돔
				<<numberslider "$settings.condomLevel" $settings.condomLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='red inline-colour'>모두가 라텍스와 안전한 성관계에 알레르기가 있습니다.</span></span>`;
						case 1:
							return `<span class="small-description">오직 <span class='green inline-colour'>당신</span>만이 콘돔을 사용할 수 있습니다. NPC에게 콘돔을 줄 수는 있습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC들은 그들과 플레이어 사이에 <span class='blue inline-colour'>임신</span>이 가능할 때만 콘돔을 소지합니다.</span>`;
						case 3:
							return `<span class="small-description">NPC들은 <span class='pink inline-colour'>그들이 원할 때마다</span> 콘돔을 소지하고 사용할 수 있습니다.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.parasitePregnancyEnabled" false true autocheck>> 기생충 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyEggLayingEnabled" false true autocheck>> 산란 켜기
					<mouse class="tooltip linkBlue">(?)<span>매와 하피를 임신시키거나 임신하기 위해 필요합니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.pregnancySpeechEnabled" false true autocheck>> 수정/가임 언급 켜기
					<mouse class="tooltip linkBlue">(?)<span>PC가 임신하거나 다른 사람을 임신시키는 것에 대한 언급을 허용합니다. 비활성화하더라도 다른 임신 설정이 켜져 있을 경우 임신과 관련된 모든 언급이 사라지지는 않습니다.</span></mouse>
				</label>
			</div>
			<<if $debug>>
				<div style="clear:both;">/*Keep at end of toggles*/</div>
				디버그:
				<br>
				<span class="gold">NPC들이 콘돔을 소지할 확률</span>
				<br>
				<<numberslider "$settings.condomChance" $settings.condomChance 0 100 1>>
				<br><br>

				<span class="gold">NPC들이 요청받지 않아도 콘돔을 사용할 확률...</span>
				<br>
				...강간 중
				<<numberslider "$settings.condomUseChanceRape" $settings.condomUseChanceRape 0 100 1>>
				<br>
				...합의된 성관계 중
				<<numberslider "$settings.condomUseChanceConsensual" $settings.condomUseChanceConsensual 0 100 1>>
				<br>
			<</if>>
		</div>
		<div style="clear:both;">/*Keep at end of toggles*/</div>
	</div>
<</widget>>

<<widget "skinColourVariableCombine">>
	<<set $player.skin.color to _skinTone + _skinShade>>
<</widget>>

<<widget "sizeLimitsSettings">>
	<div class="settingsGrid">
		<div class="settingsHeader">
			신체 부위 크기 제한 <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>음란한 행위나 경험에 참여함에 따라, 신체 부위가 커지거나 작아질 수 있습니다. 수술, 알약, 기생충 등이 크기에 영향을 줄 수 있는 조건 중 일부입니다.</span>">(?)</span>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">가슴 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 가슴은 자동으로 커지지 않습니다.">(?)</span>
			<br>
			<<rangeslider "$breastsizemin" "$breastsizemax" $breastsizemin $breastsizemax 0 12 1
				{}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 12, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 12, 0));
						var name = ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}
			>>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">엉덩이 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 엉덩이는 자동으로 커지지 않습니다.</span>">(?)</span>
			<br>
			<<rangeslider "$bottomsizemin" "$bottomsizemax" $bottomsizemin $bottomsizemax 0 8 1
				{}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 8, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 8, 0));
						var name = ["납작한", "아담한", "둥근", "부드러운", "통통한", "꽉 찬", "풍만한", "큰", "거대한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}
			>>
		</div>

		<<if ($passage is "Start" and $player.sex isnot "f") or $player.penisExist>>
			<div class="settingsToggleItemWide">
			<span class="gold">자지 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 자지는 자동으로 자라지 않습니다.</span>">(?)</span>
			<<rangeslider "$penissizemin" "$penissizemax" $penissizemin $penissizemax 0 6 1
				{}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 6, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 6, 0));
						var name = ["매우 작은","약간 작은", "작은", "보통", "큰", "매우 큰", "거대한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}

			>>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "gallerySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settings-intro">
		갤러리 옵션은 세이브 데이터에 아무런 영향을 주지 않습니다.
		<hr>
		<<if version.major gt 2 or version.minor gt 29>>
			<span class="bold">
				<<link [[캐릭터 뷰어|Clothes Testing]]>>
					<<set $lastPassage to $passage>>
				<</link>>
			</span>
			- 캐릭터 스프라이트를 가지고 놀 수 있습니다.
			<br>
		<</if>>
		<br>
		<<if $passage isnot "Start">>
			<span class="bold">
				<<link [[장면 뷰어|Scene Viewer]]>>
					<<set $lastPassage to $passage>>
					<<seenPassageChecks>>
				<</link>>
			</span>
			- 잠금 해제한 장면들을 다시 볼 수 있습니다.
			<br>
		<<else>>
			<span class=" red bold">장면 뷰어</span> - 시작 페이지에서는 접근할 수 없습니다. 게임을 진행하며 특별한 장면들을 해금할 수 있습니다. 해금된 장면들은 침실의 <span class="gold">게임플레이 설정</span> 링크를 통해 갤러리의 장면 뷰어에 들어가 다시 재생할 수 있습니다.
			<br>
		<</if>>
		/*<br>
		<span class="bold">
			<<link [[Test Renderer|Renderer Test Page]]>>
				<<set $lastPassage to $passage>>
			<</link>>
		</span>
		- This will check your browser's capabilities required for new renderer.
		<br>*/
		<br>
		<span class="bold">
			<<link [[도움말 갤러리|Tips]]>>
				<<set $lastPassage to $passage>>
			<</link>>
		</span>
	- Degrees of Lewdity에서 제공하는 힌트와 팁의 전체 목록을 확인합니다. 게임을 진행하는 동안 사이드바에 이 팁들이 무작위로 나타나며, <span class="gold">옵션</span> 버튼을 통해 비활성화할 수도 있습니다.
		</div>
	</div>
<</widget>>

<<widget "faceVariantSettings">>
	<<set _variants = Object.entries(setup.faceVariantOptions[$facestyle])>>
	<<for _i, _variant range _variants>>
		<label><<= _variant[0]>> <<radiobutton "$facevariant" _variant[1] autocheck>></label>
		<<= _i < _variants.length - 1 ? "|" : "">>
	<</for>>
<</widget>>

<<widget "npcSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsToggleIndent">
			<span class="gold">네임드 NPC에게 무작위 할당:</span> <mouse class="tooltip linkBlue">(?)<span>설정은 일반 NPC 설정을 기반으로 생성됩니다.</span></mouse>
			<br>
			<<link "성별">>
				<<initnpcgender "genders">>
				<<updatePersistentNPCs "genders">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "자지 크기">>
				<<initnpcgender "penis">>
				<<updatePersistentNPCs "penis">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "가슴 크기">>
				<<initnpcgender "breasts">>
				<<updatePersistentNPCs "breasts">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "피부 톤">>
				<<initnpcskin "skincolour">>
				<<updatePersistentNPCs "skincolour">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "기본 최대 절정 횟수">>
				<<initNPCBaseMaxOrgasm "base max orgasms">>
				<<updatePersistentNPCs "base max orgasms">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			<<if $debug>>
				|
				<<link "머리색과 눈색 초기화 (기본 색상을 가진 NPC에게만 영향을 미침)">>
					<<generateNPCNameHairAndEyeColors "default">>
					<<displaySettings>>
				<</link>>
			<</if>>
		</div>
		<div class="settingsToggleIndent">
			<<foldout false "_gender">>
				<span class="gold">모든 네임드 NPC에게 할당:</span>
				성별:
				<<link "남성">><<assignAllNPCs "pronoun" "m">><</link>> | <<link "여성">><<assignAllNPCs "pronoun" "f">><</link>>
				<br>
				생식기:
				<<link "자지">><<assignAllNPCs "gender" "m">><</link>> | <<link "보지">><<assignAllNPCs "gender" "f">><</link>>
				<br>
				<span @class="$passage is 'Start' ? 'link-disabled' : ''">
					남성 네임드 NPC 성기:
					<<link "자지">><<assignNPCGenitalsByPronoun "m" "m">><</link>> | <<link "보지">><<assignNPCGenitalsByPronoun "m" "f">><</link>>
					<br>
					여성 네임드 NPC 성기:
					<<link "보지">><<assignNPCGenitalsByPronoun "f" "f">><</link>> | <<link "자지">><<assignNPCGenitalsByPronoun "f" "m">><</link>>
				</span>
				<br>
				<<if $passage is "Start">>
					<span class="small-description">게임을 시작한 후에만 설정할 수 있습니다.</span>
					<br>
				<</if>>
				자지 크기:
				<<set _penisNames to ["", "작은", "보통", "큰", "거대한", "초거대한"]>> /* the empty first element is necessary because _j starts at 1 */
				<<for _j to 1; _j lt _penisNames.length; _j++>>
					<<capture _j>>
						<<link _penisNames[_j]>><<assignAllNPCs "penissize" _j>><</link>>
						<<if _j isnot _penisNames.length -1>>|<</if>>
					<</capture>>
				<</for>>
				<br>
				가슴 크기:
				<<set _breastNames to ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"]>>
				<<for _k to 0; _k lt _breastNames.length; _k++>>
					<<capture _k>>
						<<link _breastNames[_k]>><<assignAllNPCs "breastsize" _k>><</link>>
						<<if _k isnot _breastNames.length -1>>|<</if>>
					<</capture>>
				<</for>>
				<br>
				피부 톤:
				<<link "가장 밝음">><<assignAllNPCs "skincolour" 0>><</link>> | <<link "중간">><<assignAllNPCs "skincolour" 50>><</link>> | <<link "가장 어두움">><<assignAllNPCs "skincolour" 100>><</link>>
			<</foldout>>
		</div>
		<hr>
		<<if _npcId is undefined>>
			<<set _npcId to 0>>

			<<set _breastDescription to ["납작한", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한"]>>
            <<set _breastDescriptionNPC to ["유두", "봉긋한 가슴", "볼륨있는 가슴", "글래머한 가슴", "꽉 찬 가슴", "풍만한 가슴"]>>
            <<set _breastsDescriptionNPC to ["유두", "봉긋한 가슴", "볼륨있는 가슴", "글래머한 가슴", "꽉 찬 가슴", "풍만한 가슴"]>>

			<<set _hairColorNPC to ["빨간색","검은색","갈색","밝은 갈색","금발","플래티넘 블론드","스트로베리 블론드","적갈색", "회갈색"]>>
			<<set _hairColorNPCData to ["red","black","brown","lightbrown","blond","platinumblond","strawberryblond","ginger", "mousy"]>>
			<<set _hairColorNPCText to ["red","black","brown","lightbrown","gold","platinum","strawberry","tangerine", "mousy"]>>

			<<set _eyeColorNPC to ["보라색","진한 파란색","밝은 파란색","호박색","헤이즐","초록색","라임 그린","빨간색","분홍색","회색","밝은 회색"]>>
			<<set _eyeColorNPCData to ["purple","dark blue","light blue","amber","hazel","green", "lime green","red","pink","grey", "light grey"]>>
			<<set _eyeColorNPCText to ["purple","blue","lblue","tangerine","brown","green","lime-green","red","pink","grey", "light-grey"]>>
		<</if>>

		<<if _npcList is undefined>>
			<<set _npcList to {}>>
			<<set _sortedNPCList to clone($NPCNameList).sort()>>

			<<for $_i to 0; $_i lt _sortedNPCList.length; $_i++>>
				<<set _npcList[_sortedNPCList[$_i]] to $NPCNameList.indexOf(_sortedNPCList[$_i])>>
			<</for>>
			<<if $passage is "Start" or !$wraithIntro>>
				<<run delete _npcList["Ivory Wraith"]>>
				<<run (() => { const i = _sortedNPCList.indexOf("Ivory Wraith"); if (i >= 0) _sortedNPCList.splice(i, 1); })()>>
			<</if>>

			<<set _npcListKr to {}>>
			<<for $_i to 0; $_i lt _sortedNPCList.length; $_i++>>
				<<set _npcListKr[window.KR.gatPersonNameDictKR(_sortedNPCList[$_i])] to _npcList[_sortedNPCList[$_i]]>>
			<</for>>
		<</if>>

		/* The Silver Stranger (Luchifen) stays a hidden mystery; never expose their name in the NPC settings menu (unconditional, even after they've been met). */
		<<run delete _npcList["Luchifen"]>>
		<<run (() => { const i = _sortedNPCList.indexOf("Luchifen"); if (i >= 0) _sortedNPCList.splice(i, 1); })()>>

		/* Updates the npc's in case $incompletePregnancyDisable has been changed by the player */
		<<npcPregnancyUpdater>>
		<div id="npcSettingsMenu">
			<<npcSettingsMenu>>
		</div>

		<<if $passage isnot "Start" and $per_npc and Object.keys($per_npc).length gt 0>>
			<<run
				if (!T.perNPCLock) {
					$(".passage").on('change', '#perNPCSettingsMenu .macro-listbox', function (e) {
						new Wikifier(null, '<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>');
					});

					T.npcKeys = {};
					T.npcKeyNames = [];
					const allowed_npcs = ["steed", "guard", "inmate", "panty_thief", "school_nurse", "pinch", "black_dog", "hacker", "bishop", "bishop_right_hand", "bishop_left_hand", "manager", "alexs_parent1", "alexs_parent2", "whitneys_auncle", "whitney_parent_flat"];
					setup.pNpcNameKr = {
						"scarred_inmate": "흉터난 수감자",
						"veteran_guard": "베테랑 경비원",
						"anxious_guard": "불안한 경비원",
						"relaxed_guard": "느긋한 경비원",
						"tattooed_inmate": "문신한 수감자",
						"methodical_guard": "체계적인 경비원",
						"farm_tower_guard": "농장 탑 경비원",
						"saddled_steed": "안장 얹은 탈것",
						"chalets_manager": "산장 관리자",
						"black_dog": "검은 개",
						"manager": "관리자",
						"hacker": "해커",
						"bishop": "비숍",
						"bishop_right_hand": "비숍의 오른팔",
						"bishop_left_hand": "비숍의 왼팔",
						"school_nurse": "학교 간호사",
						"panty_thief": "팬티 도둑",
						"pinch": "핀치",
						"alexs_parent1": "알렉스의 부모1",
						"alexs_parent2": "알렉스의 부모2",
						"whitneys_auncle": "휘트니의 삼촌/이모",
						"whitney_parent_flat": "휘트니의 부모"
					};
					Object.keys(V.per_npc).forEach(k => {
						for (const j of allowed_npcs){
							if (k.includes(j)){
								T.npcKeyNames.push(k);
								const displayName = setup.pNpcNameKr[k] || toTitleCase(k.replace(/_/g, ' '));
								T.npcKeys[displayName] = k;
								break
							}
						}
					});
					T.perNPCLock = true;
				}
			>>
			<<if T.npcKeyNames and T.npcKeyNames.length>>
				<hr>
				<div id="perNPCSettingsMenu">
					<<perNPCSettingsMenu>>
				</div>
			<</if>>
		<</if>>

		<<if _listActive isnot true>>
			<<NPCSettingsReset>>
			<<set _listActive to true>>
		<</if>>
	</div>
<</widget>>

<<widget "assignAllNPCs">>
	<<set $_characteristic to _args[0]>>
	<<set $_targetValue to _args[1]>>
	<<for $_i to 0; $_i lt $NPCName.length; $_i++>>
		<<if $_characteristic is "gender" and getActivePregnancies($NPCName[$_i].nam).length>><<continue>><</if>>
		<<set $NPCName[$_i][$_characteristic] to $_targetValue>>
		<<if $_characteristic is "gender">>
			<<if $_targetValue is "f">>
				<<set $NPCName[$_i].vagina to ($NPCName[$_i].type isnot "human" ? 0 : "clothed")>>
				<<set $NPCName[$_i].penis to "none">>
			<<elseif $_targetValue is "m">>
				<<set $NPCName[$_i].penis to ($NPCName[$_i].type isnot "human" ? 0 : "clothed")>>
				<<set $NPCName[$_i].vagina to "none">>
			<</if>>
		<</if>>
		<<if $_characteristic is "breastsize">>
			<<set $NPCName[$_i].breastdesc to $_targetValue > 0 ? setup.breastsizes[$_targetValue] + " breast" : "nipple">>
			<<set $NPCName[$_i].breastsdesc to $_targetValue > 0 ? setup.breastsizes[$_targetValue] + " breasts" : "nipples">>
		<</if>>
	<</for>>
	<<if $passage isnot "Start" and $per_npc and Object.keys($per_npc).length gt 0>>
		<<for $_npcKey, $_npcData range $per_npc>>
			<<set $per_npc[$_npcKey][$_characteristic] to $_targetValue>>
			<<if $_characteristic is "gender">>
				<<if $_targetValue is "f">>
					<<set $per_npc[$_npcKey].vagina to ($per_npc[$_npcKey].type isnot "human" ? 0 : "clothed")>>
					<<set $per_npc[$_npcKey].penis to "none">>
				<<elseif $_targetValue is "m">>
					<<set $per_npc[$_npcKey].penis to ($per_npc[$_npcKey].type isnot "human" ? 0 : "clothed")>>
					<<set $per_npc[$_npcKey].vagina to "none">>
				<</if>>
			<</if>>
			<<if $_characteristic is "breastsize">>
				<<set $per_npc[$_npcKey].breastdesc to $_targetValue > 0 ? setup.breastsizes[$_targetValue] + " breast" : "nipple">>
				<<set $per_npc[$_npcKey].breastsdesc to $_targetValue > 0 ? setup.breastsizes[$_targetValue] + " breasts" : "nipples">>
			<</if>>
		<</for>>
	<</if>>
	<<if $_characteristic is "gender" or $_characteristic is "pronoun">>
		<<initnpcgender>>
		<<updatePersistentNPCs>>
	<</if>>
	<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
<</widget>>

<<widget "namedNpcGenderApply">>
	<<if $passage is "Start" or _args[0] is "namedNpcDefaultGender">>
		<<unset _namedNpcPendingGender>>
		<<run applyNpcGenderPreset(_args[0])>>
		<<initnpcgender>>
		<<updatePersistentNPCs>>
	<<else>>
		<<set _namedNpcPendingGender to _args[0]>>
	<</if>>
	<<replace #namedNpcGenderConfirm>><<namedNpcGenderConfirm>><</replace>>
<</widget>>

<<widget "namedNpcGenderConfirm">>
	<<if _namedNpcPendingGender>>
		<br>
		<span class="red">모든 네임드 NPC를 <<= _namedNpcPendingGender is "namedNpcAllMaleGender" ? "남성으로 바꾸고 모두 자지를 갖게 합니다" : "여성으로 바꾸고 모두 보지를 갖게 합니다">>. 개별 선택은 모두 사라집니다.</span>
		<br>
		<<button "예">>
			<<run applyNpcGenderPreset(_namedNpcPendingGender)>>
			<<initnpcgender>>
			<<updatePersistentNPCs>>
			<<unset _namedNpcPendingGender>>
			<<replace #namedNpcGenderConfirm>><</replace>>
		<</button>>
		<<button "아니오">>
			<<unset _namedNpcPendingGender>>
			<<set _namedNpcPreset to "namedNpcDefaultGender">>
			<<displaySettings "quickStart">>
		<</button>>
	<</if>>
<</widget>>

<<widget "nnpcGenderSetByHand">>
	<<set _nnpcGenderByHand to _nnpcGenderByHand ?? []>>
	<<run _nnpcGenderByHand.includes(_args[0]) || _nnpcGenderByHand.push(_args[0])>>
<</widget>>

<<widget "assignNPCGenitalsByPronoun">>
	<<assignNPCGenitalsByPronounCore _args[0] _args[1]>>
	<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
<</widget>>

<<widget "assignNPCGenitalsByPronounCore">>
	<<set $_pronounFilter to _args[0]>>
	<<set $_value to _args[1]>>
	<<for $_i to 0; $_i lt $NPCName.length; $_i++>>
		<<if $NPCName[$_i].pronoun is $_pronounFilter and !getActivePregnancies($NPCName[$_i].nam).length and !(_args[2] and (_nnpcGenderByHand ?? []).includes($_i))>>
			<<set $NPCName[$_i].gender to $_value>>
		<</if>>
	<</for>>
	<<if $_value isnot "h" and $passage isnot "Start" and $per_npc and Object.keys($per_npc).length gt 0>>
		<<for $_i range Object.keys($per_npc)>>
			<<if $per_npc[$_i].pronoun is $_pronounFilter>>
				<<set $per_npc[$_i].gender to $_value>>
			<</if>>
		<</for>>
	<</if>>
	<<initnpcgender>>
	<<updatePersistentNPCs>>
<</widget>>

<<widget "exportsettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settings-intro">
			<span class="yellow">"세이브/옵션" 오버레이의 설정도 함께 불러오거나 내보냅니다.</span>
			<hr>
			<h4 class="gold">설정 파일 불러오기/내보내기</h4>

			<<if SugarCube.Browser.isMobile.any() is true>>
				현재 안드로이드에서는 파일에서 저장하고 불러오는 기능이 작동하지 않으니 주의하십시오.
			<<else>>
				파일에서 불러오기: <input id="saveImport" type="file" value="파일에서 불러오기" onchange="importSettings(this.files, 'file')">
				<br><br>
				<<if $ironmanmode is true>>
					<input type="button" value="파일로 저장" disabled>
				<<else>>
					<input type="button" value="파일로 저장" onclick="exportSettings('file')">
				<</if>>
			<</if>>
			<hr>
			<h4 class="gold">설정 텍스트 내보내기/불러오기</h4>

			<ul>
			<li>현재 설정을 저장하려면 "설정 데이터 내보내기"를 클릭한 후, 필요한 곳에 데이터를 복사해서 붙여넣으십시오.</li>
			<li>현재 설정을 불러오려면, 설정 데이터를 붙여넣고 "설정 데이터 불러오기"를 클릭하십시오.</li>
			<li>안드로이드와 데이터를 주고받으려면, 이메일이나 pastebin 같은 서비스를 사용하는 것을 권장합니다. 문제가 발생하지 않도록 세이브 데이터의 시작과 끝이 정확한지 확인하십시오.</li>
			<li>현재 내용을 복사하려면 "텍스트 영역 복사하기"를 클릭하십시오. 기기나 브라우저가 지원하지 않을 경우 버튼 이름이 "복사 오류"로 변경됩니다.</li>
			</ul>
			<textarea id="settingsDataInput" rows="4" cols="40" onClick="if(V.disableAutoSelect == false)this.select();" onfocus="V.tempDisable = true;" onblur="V.tempDisable = false;"></textarea>
			<br>
			<input type="button" value="텍스트 상자 비우기" onclick="clearTextBox('settingsDataInput')"/>
			<input type="button" value="텍스트 상자 맨 위로" onclick="topTextArea('settingsDataInput')"/>
			<input type="button" value="텍스트 상자 맨 아래로" onclick="bottomTextArea('settingsDataInput')"/>
			<input type="button" value="설정 데이터 내보내기" onclick="exportSettings('text')"/>
			<input type="button" value="설정 데이터 불러오기" onclick="importSettings(null,'text')"/>
			<input id="CopyTextArea" type="button" value="텍스트 복사" onclick="copySavedata('settingsDataInput')">
			<input id="LoadExternalExportFile" type="button" value="외부 내보내기 파일 불러오기" onclick="loadExternalExportFile()">

			<br><br>

			<label>
				<<checkbox "$disableAutoSelect" false true autocheck>>
				자동 선택을 비활성화합니다.
			</label>
			<br>
			<span style="font-size: 80%">버전 0.5.13 이전에 만든 설정 내보내기 파일은 더 이상 지원되지 않습니다.</span>
		</div>
	</div>
<</widget>>

<<widget "startDescriptions">>
	<div class="solidBorderContainer settings-container">
		<div class="settings-intro">
			<<switch _args[0]>>
				<<case "default">><span class="gold bold">기본 시작:</span> 페티시 토글과 난이도 설정은 <span class="teal">기본</span> 설정 그대로 유지됩니다. 모든 NPC가 <span class="teal">무작위로</span> 생성됩니다. <i class="teal">초보자에게 추천합니다.</i>
				<<case "custom">><span class="gold bold">커스텀 시작:</span> 페티시 토글, 난이도 설정, NPC 성별을 포함한 <span class="teal">모든 설정</span>을 자유롭게 조정하여 원하는 플레이를 만들 수 있습니다.
				<<case "random">><span class="gold bold">무작위 시작:</span> 캐릭터 외형, 캐릭터 특성, 난이도 설정을 포함한 <span class="teal">모든 설정</span>을 무작위로 정해 게임을 시작합니다. 새로운 플레이를 위해 당신의 캐릭터와 모든 NPC도 <span class="teal">무작위로</span> 생성됩니다. <i><span class="teal">게임 시작 전에 특정 설정만 무작위로 정하고 싶다면, </span> <span class="gold">커스텀 시작</span><span class="teal">을 선택하십시오.</span></i>
			<</switch>>
		</div>
	</div>
<</widget>>

<<widget "npcSettingsMenu">>
	<div class="settingsToggleIndent">
		<span class="gold">특정 NPC로 이동: </span>
		<<listbox "_npcId" autoselect>>
			<<optionsfrom _npcListKr>>
		<</listbox>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader">
			<<= window.KR.gatPersonNameDictKR($NPCName[_npcId].nam)>> - <span style="text-transform: capitalize;"><<= window.KR.getNpcTitleKr($NPCName[_npcId].title)>></span>
			<span style="font-size:80%">
				<br>
				<<link "이전">>
					<<set _sortedId to _sortedNPCList.indexOf($NPCNameList[_npcId])>>
					<<if _sortedId is 0>>
						<<set _sortedId to _sortedNPCList.length - 1>>
					<<else>>
						<<set _sortedId-->>
					<</if>>
					<<set _npcId to _npcList[_sortedNPCList[_sortedId]]>>
					<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
				<</link>> <span style="color:white">|</span>
				<<link "다음">>
					<<set _sortedId to _sortedNPCList.indexOf($NPCNameList[_npcId])>>
					<<if _sortedId gte _sortedNPCList.length - 1>>
						<<set _sortedId to 0>>
					<<else>>
						<<set _sortedId++>>
					<</if>>
					<<set _npcId to _npcList[_sortedNPCList[_sortedId]]>>
					<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
				<</link>>
			</span>
		</div>
		<<if getActivePregnancies(V.NPCName[T.npcId].nam).length>>
			<div class="settingsToggleItemWide">
				이 NPC는 현재 임신 중입니다. 임신 기간 동안에는 일부 설정을 변경할 수 없습니다.
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<span class="gold">성별:</span>
			<br>
			<span data-target="npcname-npcidpronoun" data-disabledif="V.NPCName[T.npcId].pronoun==='i'">
			<label><<radiobutton "$NPCName[_npcId].pronoun" "f" autocheck>> 여성</label> |
			<label><<radiobutton "$NPCName[_npcId].pronoun" "m" autocheck>> 남성</label>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">생식기:</span>
			<br>
			<span data-target="npcname-pregnancy" data-disabledif="getActivePregnancies(V.NPCName[T.npcId].nam).length">
				<label><<radiovar "$NPCName[_npcId].gender" "f">><<nnpcGenderSetByHand _npcId>><</radiovar>> 보지</label> |
				<label><<radiovar "$NPCName[_npcId].gender" "m">><<nnpcGenderSetByHand _npcId>><</radiovar>> 자지</label>
				<<if $debug>>| <label><<radiovar "$NPCName[_npcId].gender" "h">><<nnpcGenderSetByHand _npcId>><</radiovar>> 양성</label><</if>>
			</span>
		</div>
		<div class="settingsToggleItem">
			<<set _penisNames to ["", "작은", "보통", "큰", "거대한", "초거대한"]>> /* the empty first element is necessary because _j starts at 1 */
			<span data-target="npcname-npcidgender" data-disabledif="V.NPCName[T.npcId].gender==='f'">
				<span class="gold">자지 크기:</span>
				<br>
				<<for _j to 1; _j lt _penisNames.length; _j++>>
					<label>	<<radiobutton "$NPCName[_npcId].penissize" _j autocheck>><<= _penisNames[_j]>></label>
					<<if _j isnot _penisNames.length -1>>|<</if>>
				<</for>>
			</span>
		</div>
		<div class="settingsToggleItem">
		<span class="gold">가슴 크기:</span>
		<br>
		<<numberslider "$NPCName[_npcId].breastsize" $NPCName[_npcId].breastsize 0 12 1 {
			onInputChange: v => {
				V.NPCName[_npcId].breastdesc = (v > 0) ? setup.breastsizes[v] + " breast" : "nipple";
				V.NPCName[_npcId].breastsdesc = (v > 0) ? setup.breastsizes[v] + " breasts" : "nipples";
			},
			value: v => {
				return (v > 0) ? window.KR.getBreastSizeKr(setup.breastsizes[v]) + " 가슴" : "유두";
			}
		}>>
		</div>
		<div class="settingsToggleItem">
			<span data-target="npcname-pregnancy" data-disabledif="!V.settings.nnpcPregnancyEnabled||setup.pregnancy.infertile.includes(V.NPCName[T.npcId].nam)||V.NPCName[T.npcId].pregnancy.enabled===undefined||getActivePregnancies(V.NPCName[T.npcId].nam).length||!setup.pregnancy.typesEnabled.includes(V.NPCName[T.npcId].type)">
				<span class="gold">NPC 임신 활성화:</span>
				<mouse class="tooltip linkBlue">(?)<span>"NNPC 임신" 토글이 활성화되어 있어야 합니다. "미완성 임신 콘텐츠" 토글도 활성화해야 할 수 있습니다. 비활성화해도 이미 진행 중인 임신은 중단되지 않습니다.</span></mouse>
				<br>
				<label><<radiobutton "$NPCName[_npcId].pregnancy.enabled" true autocheck>> 활성</label> |
				<label><<radiobutton "$NPCName[_npcId].pregnancy.enabled" false autocheck>> 비활성</label>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span data-target="npcname-analpregnancy" data-disabledif="!V.settings.nnpcPregnancyEnabled||!V.settings.npcAnalPregnancyEnabled||setup.pregnancy.infertile.includes(V.NPCName[T.npcId].nam)||V.NPCName[T.npcId].pregnancy.enabled===undefined||getActivePregnancies(V.NPCName[T.npcId].nam).length||!setup.pregnancy.typesEnabled.includes(V.NPCName[T.npcId].type)">
				<span class="gold">NPC 항문 임신 활성화:</span>
				<mouse class="tooltip linkBlue">(?)<span>"NNPC 임신"과 "NPC 항문 임신" 토글이 전역 게임 설정에서 활성화되어 있어야 작동합니다. "미완성 임신 콘텐츠" 토글도 활성화해야 할 수 있습니다. 이 NPC의 임신 토글도 함께 활성화되어 있어야 합니다. 보지가 있는 NPC는 이 옵션을 켜면 질과 항문 모두로 임신할 수 있게 됩니다.</span></mouse>
				<br>
				<label><<radiobutton "$NPCName[_npcId].pregnancy.analEnabled" true autocheck>> 활성</label> |
				<label><<radiobutton "$NPCName[_npcId].pregnancy.analEnabled" false autocheck>> 비활성</label>
			</span>
		</div>


		<<if $NPCName[_npcId].nam is "Black Wolf">>
			<<namedBeastSettingRow "blackwolf">>
		<<elseif $NPCName[_npcId].nam is "Great Hawk">>
			<<namedBeastSettingRow "greathawk">>
		<<elseif $NPCName[_npcId].nam is "Night Monster">>
			<<namedBeastSettingRow "nightmonster">>
		<</if>>

		<<set _skinToneHidden to ($NPCName[_npcId].nam is "Black Wolf" and $settings.namedBeasts.blackwolf.monsterChance is 0)
			or ($NPCName[_npcId].nam is "Great Hawk" and $settings.namedBeasts.greathawk.monsterChance is 0)
			or ($NPCName[_npcId].nam is "Night Monster" and $settings.namedBeasts.nightmonster.monsterChance is 0)>>
		<div id="npcSkinToneSetting" @class="'settingsToggleItem' + (_skinToneHidden ? ' hidden' : '')">
			<span class="gold">피부 톤:</span>
			<br>
			<<if ["Black Wolf", "Great Hawk", "Night Monster"].includes($NPCName[_npcId].nam)>>
				<<npcSkinTone>>
			<<else>>
				<span data-target="npcname-npcidskincolour" data-disabledif="V.NPCName[T.npcId].skinType==='ghost'">
				<<npcSkinTone>>
				</span>
			<</if>>
		</div>

		<div class="settingsToggleItem">
		<span class="gold">기본 최대 절정 횟수:</span>
		<br>
		<<numberslider "$NPCName[_npcId].maxOrgasms" $NPCName[_npcId].maxOrgasms 1 5 1>>
		</div>
	</div>
	<div style="clear:both;"></div>

	<<if $debug>>
		디버그:
		<br>
		<div class="settingsToggleItemWide">
			<span class="gold">머리색:</span>
			<br>
			<<for _j to 0; _j lt _hairColorNPC.length; _j++>>
				<label>
					<<print '<<radiobutton "$NPCName['+_npcId+'].hairColour" "'+_hairColorNPCData[_j]+'" ' + ($NPCName[_npcId].hairColour is _hairColorNPCData[_j] ? "checked" : "") + '>>'>>
					<span @class="_hairColorNPCText[_j]">_hairColorNPC[_j]</span>
				</label> |
			<</for>>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">눈색:</span>
			<br>
			<<for _j to 0; _j lt _eyeColorNPC.length; _j++>>
				<label>
					<<print '<<radiobutton "$NPCName['+_npcId+'].eyeColour" "'+_eyeColorNPCData[_j]+'" ' + ($NPCName[_npcId].eyeColour is _eyeColorNPCData[_j] ? "checked" : "") + '>>'>>
					<span @class="_eyeColorNPCText[_j]">_eyeColorNPC[_j]</span>
				</label> |
			<</for>>
		</div>
		<div style="clear:both;"></div>
	<</if>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "perNPCSettingsMenu">>
	<<set _npcIndex to _npcKeyNames.indexOf(_pNPCId)>>

	<div class="settingsToggleIndent">
		<span class="gold">지속성 NPC:</span>
		<<listbox "_pNPCId" autoselect>>
			<<optionsfrom _npcKeys>>
		<</listbox>>
		<span style="font-size:80%">
			| <<link "이전">>
				<<set _npcIndex to (_npcIndex is 0 ? _npcKeyNames.length - 1 : _npcIndex - 1)>>
				<<set _pNPCId to _npcKeyNames[_npcIndex]>>
				<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
			<</link>> |
			<<link "다음">>
				<<set _npcIndex to (_npcIndex is _npcKeyNames.length - 1 ? 0 : _npcIndex + 1)>>
				<<set _pNPCId to _npcKeyNames[_npcIndex]>>
				<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
			<</link>>
		</span>
	</div>

	<<switch _pNPCId>>
		<<case "scarred_inmate">>
			<<if $per_npc[_pNPCId].description isnot "scarred">>
				<<generate_scarred_inmate 0>>
				<<clearsinglenpc 0>>
			<</if>>
		<<case "veteran_guard">>
			<<if $per_npc[_pNPCId].description isnot "veteran">>
				<<generate_veteran_guard 0>>
				<<clearsinglenpc 0>>
			<</if>>
	<</switch>>

	<<if $per_npc[_pNPCId] eq null>>
		<<error {
			message : `pNPC의 주어진 ID가 사용 가능한 pNPC와 일치하지 않습니다: ${_pNPCId}.`,
			source	: _pNPCId
		}>>
	<<else>>
		<div class="settingsGrid">
			<div class="settingsHeader">
				<<if $per_npc[_pNPCId].name_known or _pNPCId is "farm_tower_guard">>
					<<= window.KR.gatPersonNameDictKR($per_npc[_pNPCId].name)>> - <<= setup.pNpcNameKr[_pNPCId] || toTitleCase(_pNPCId.toUpperFirst().replace(/_/g, ' '))>>
				<<elseif _pNPCId is "hacker">>
					해커 미키
				<<elseif _pNPCId is "bishop">>
					비숍
				<<elseif _pNPCId is "bishop_right_hand">>
					비숍의 오른팔
				<<elseif _pNPCId is "bishop_left_hand">>
					비숍의 왼팔
				<<elseif _pNPCId is "alexs_parent1">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						알렉스의 강인한 아버지
					<<else>>
						알렉스의 강인한 어머니
					<</if>>
				<<elseif _pNPCId is "alexs_parent2">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						알렉스의 계산적인 아버지
					<<else>>
						알렉스의 계산적인 어머니
					<</if>>
				<<elseif _pNPCId is "whitneys_auncle">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						휘트니의 삼촌
					<<else>>
						휘트니의 이모
					<</if>>
				<<elseif _pNPCId is "whitney_parent_flat">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						휘트니의 아버지
					<<else>>
						휘트니의 어머니
					<</if>>
				<<else>>
					<<= setup.pNpcNameKr[_pNPCId] || toTitleCase(_pNPCId.toUpperFirst().replace(/_/g, ' '))>>
				<</if>>

				<<if $per_npc[_pNPCId].name_known and $debug is 1>>
					<span style="font-size:80%">
						<br>
						<<link "이름 바꾸기">>
							<<if $per_npc[_pNPCId].pronoun is "f">>
								<<set $per_npc[_pNPCId].name to $NPC_names_f.random()>>
							<<else>>
								<<set $per_npc[_pNPCId].name to $NPC_names_m.random()>>
							<</if>>
							<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
						<</link>>
					</span>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">성별:</span>
				<br>
				<span data-target="pernpc-npcidpronoun" data-disabledif="V.per_npc[T.pNPCId].pronoun==='i'||V.per_npc[T.pNPCId].pronoun==='t'">
					<label><<radiobutton "$per_npc[_pNPCId].pronoun" "f" autocheck>> 여성</label> |
					<label><<radiobutton "$per_npc[_pNPCId].pronoun" "m" autocheck>> 남성</label>
				</span>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">생식기:</span>
				<br>
				<label><<radiovar "$per_npc[_pNPCId].gender" "f">><<set $per_npc[_pNPCId].vagina to ($per_npc[_pNPCId].type isnot "human" ? 0 : "clothed")>><<set $per_npc[_pNPCId].penis to "none">><</radiovar>> 보지</label> |
				<label><<radiovar "$per_npc[_pNPCId].gender" "m">><<set $per_npc[_pNPCId].penis to ($per_npc[_pNPCId].type isnot "human" ? 0 : "clothed")>><<set $per_npc[_pNPCId].vagina to "none">><</radiovar>> 자지</label>
			</div>

			<div class="settingsToggleItem">
				<<set _penisNames to ["", "작은", "보통", "큰", "거대한", "초거대한"]>>
				<span data-target="pernpc-npcidgender" data-disabledif="V.per_npc[T.pNPCId].gender==='f'">
					<span class="gold">자지 크기:</span>
					<br>
					<<for _j to 1; _j lt _penisNames.length; _j++>>
						<label>
							<<radiobutton "$per_npc[_pNPCId].penissize" _j autocheck>>
							<<print _penisNames[_j]>>
						</label>
						<<if _j isnot _penisNames.length - 1>> | <</if>>
					<</for>>
				</span>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">가슴 크기:</span>
				<br>
				<<numberslider "$per_npc[_pNPCId].breastsize" $per_npc[_pNPCId].breastsize 0 12 1 {
					onInputChange: v => {
						V.per_npc[_pNPCId].breastdesc = (v > 0) ? setup.breastsizes[v] + " breast" : "nipple";
						V.per_npc[_pNPCId].breastsdesc = (v > 0) ? setup.breastsizes[v] + " breasts" : "nipples";
					},
					value: v => {
						return (v > 0) ? window.KR.getBreastSizeKr(setup.breastsizes[v]) + " 가슴" : "유두";
					}
				}>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">피부 톤:</span>
				<br>
				<<if $per_npc[_pNPCId].skincolour isnot undefined>>
					<<numberslider "$per_npc[_pNPCId].skincolour" $per_npc[_pNPCId].skincolour 0 100 1 {
						value: v => setup.colours.getSkinToneSwatch(v),
					}>>
				<<else>>
					<span class="small-description">무작위로 정해집니다.</span>
				<</if>>
			</div>
		</div>
	<</if>>
	<div style="clear:both;"></div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "saveNameSection">>
	<div class="my-1">
		<span class="gold bold">세이브 이름:</span> <i>(선택 사항)</i>
	</div>
	<<textbox "$saveName" $saveName>>
<</widget>>

<<widget "combatExtendedSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				전투 관련 프리셋
			</div>
			<div class="settingsToggleItem">
				<span class="gold">난이도:</span>
				<br>
				<<link "매우 쉬움">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.enemyDamageMult to 75>>
					<<set $combatExtended.reverseRape to 1>>

					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set $combatExtended.dodgeChanceCap to 100>>

					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>

					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>

					<<set $combatExtended.brawlingToggle to 1>>
					<<set $combatExtended.footworkToggle to 1>>
					<<set $combatExtended.strikingToggle to 1>>
					<<set $combatExtended.kickingToggle to 1>>

					<<set $combatExtended.enemyPassiveDodging to 0>>
					<<set $combatExtended.enemyActiveDodging to 0>>
					<<set $combatExtended.enemyBlocking to 0>>
					<<set $combatExtended.enemyCountering to 0>>
					<<set $combatExtended.enemyFeinting to 0>>

					<<set $combatExtended.enemyLevelDayScaling to 0>>
					<<set $combatExtended.enemyLevelDayScalingMult to 1>>
					<<set $combatExtended.enemyHealthDayScaling to 0>>
					<<set $combatExtended.enemyHealthDayScalingMult to 5>>
					<<set $combatExtended.enemyDayScaling to 7>>
					<<set $combatExtended.enemyInfiniteDayScaling to 0>>
					<<set $combatExtended.enemyDayScalingLimit to 20>>

					<<set $combatExtended.enemyLevelDefeatScaling to 0>>
					<<set $combatExtended.enemyLevelDefeatScalingMult to 1>>
					<<set $combatExtended.enemyHealthDefeatScaling to 0>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 5>>
					<<set $combatExtended.enemyDefeatScaling to 10>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 0>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 100>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<<link "쉬움">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.enemyDamageMult to 100>>
					<<set $combatExtended.reverseRape to 1>>

					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set $combatExtended.dodgeChanceCap to 100>>

					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>

					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>

					<<set $combatExtended.brawlingToggle to 1>>
