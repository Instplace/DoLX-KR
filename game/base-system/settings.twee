					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 20>>
					<<set $combatExtended.enemyDefeatScaling to 10>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 0>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 200>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>

				<<link "불가능">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.enemyDamageMult to 250>>
					<<set $combatExtended.reverseRape to 1>>

					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 0>>
					<<set $combatExtended.dodgeChanceCap to 55>>

					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>

					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>

					<<set $combatExtended.brawlingToggle to 1>>
					<<set $combatExtended.footworkToggle to 1>>
					<<set $combatExtended.strikingToggle to 1>>
					<<set $combatExtended.kickingToggle to 1>>

					<<set $combatExtended.enemyPassiveDodging to 1>>
					<<set $combatExtended.enemyActiveDodging to 1>>
					<<set $combatExtended.enemyBlocking to 1>>
					<<set $combatExtended.enemyCountering to 1>>
					<<set $combatExtended.enemyFeinting to 1>>

					<<set $combatExtended.enemyLevelDayScaling to 1>>
					<<set $combatExtended.enemyLevelDayScalingMult to 20>>
					<<set $combatExtended.enemyHealthDayScaling to 1>>
					<<set $combatExtended.enemyHealthDayScalingMult to 50>>
					<<set $combatExtended.enemyDayScaling to 1>>
					<<set $combatExtended.enemyInfiniteDayScaling to 1>>
					<<set $combatExtended.enemyDayScalingLimit to 20>>

					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyLevelDefeatScalingMult to 20>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 50>>
					<<set $combatExtended.enemyDefeatScaling to 1>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 1>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 200>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br><br>
				<<link "Casual Recommendation">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.enemyDamageMult to 125>>
					<<set $combatExtended.reverseRape to 1>>

					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set $combatExtended.dodgeChanceCap to 100>>

					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>

					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>

					<<set $combatExtended.brawlingToggle to 1>>
					<<set $combatExtended.footworkToggle to 1>>
					<<set $combatExtended.strikingToggle to 1>>
					<<set $combatExtended.kickingToggle to 1>>

					<<set $combatExtended.enemyPassiveDodging to 1>>
					<<set $combatExtended.enemyActiveDodging to 1>>
					<<set $combatExtended.enemyBlocking to 1>>
					<<set $combatExtended.enemyCountering to 1>>
					<<set $combatExtended.enemyFeinting to 1>>

					<<set $combatExtended.enemyLevelDayScaling to 1>>
					<<set $combatExtended.enemyLevelDayScalingMult to 1>>
					<<set $combatExtended.enemyHealthDayScaling to 1>>
					<<set $combatExtended.enemyHealthDayScalingMult to 5>>
					<<set $combatExtended.enemyDayScaling to 7>>
					<<set $combatExtended.enemyInfiniteDayScaling to 0>>
					<<set $combatExtended.enemyDayScalingLimit to 20>>

					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyLevelDefeatScalingMult to 1>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 5>>
					<<set $combatExtended.enemyDefeatScaling to 10>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 0>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 200>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<<link "Tryhard Recommendation">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.enemyDamageMult to 175>>
					<<set $combatExtended.reverseRape to 1>>

					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set $combatExtended.dodgeChanceCap to 100>>

					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>

					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>

					<<set $combatExtended.brawlingToggle to 1>>
					<<set $combatExtended.footworkToggle to 1>>
					<<set $combatExtended.strikingToggle to 1>>
					<<set $combatExtended.kickingToggle to 1>>

					<<set $combatExtended.enemyPassiveDodging to 1>>
					<<set $combatExtended.enemyActiveDodging to 1>>
					<<set $combatExtended.enemyBlocking to 1>>
					<<set $combatExtended.enemyCountering to 1>>
					<<set $combatExtended.enemyFeinting to 1>>

					<<set $combatExtended.enemyLevelDayScaling to 1>>
					<<set $combatExtended.enemyLevelDayScalingMult to 4>>
					<<set $combatExtended.enemyHealthDayScaling to 1>>
					<<set $combatExtended.enemyHealthDayScalingMult to 20>>
					<<set $combatExtended.enemyDayScaling to 7>>
					<<set $combatExtended.enemyInfiniteDayScaling to 0>>
					<<set $combatExtended.enemyDayScalingLimit to 20>>

					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyLevelDefeatScalingMult to 4>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 20>>
					<<set $combatExtended.enemyDefeatScaling to 10>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 0>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 200>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Encounter Reworks:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.reverseRape to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.reverseRape" 0 1 autocheck>> 역강간 활성화
					<mouse class="tooltip linkBlue">(?)<span>적을 쓰러뜨렸다면 모든 조우에서 적이 복종 상태가 되며, 당신이 직접 끝낼 때까지 끝나지 않습니다. 발동하려면 음란 75 이상이 필요합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.standingFights" 0 1 autocheck>> 스탠딩 전투 활성화
					<mouse class="tooltip linkBlue">(?)<span>벽이나 글로리홀에 끼어 있지 않은 모든 비동의 조우는 스탠딩 전투로 시작됩니다.</span></mouse>
				</label><br>
				Standing Fight Type: <mouse class="tooltip linkBlue">(?)<span>Normal will still allow undressing and groping. Hostile will cause enemies to immediately use hostile actions.</span></mouse><br>
				<label>일반 <<radiobutton "$combatExtended.standingFightsType" "normal" autocheck>></label> |
				<label>적대 <<radiobutton "$combatExtended.standingFightsType" "hostile" autocheck>></label>
				<br>
			</div>
		</div>
	</div>
	<<if _ceTab is undefined>><<set _ceTab to "player">><</if>>
	<hr>
	<div id="ceTabs" class="no-numberify"><<combatExtendedTabButtons>></div>
	<div id="ceTabContent"><<combatExtendedTabContent>></div>
<</widget>>

<<widget "combatExtendedTabButtons">>
	<div class="containerStart">
		<<combatExtendedTabButton "Player" "player">>
		<<combatExtendedTabButton "Enemy" "enemy">>
	</div>
<</widget>>

<<widget "combatExtendedTabButton">>
	<div @class="_ceTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _ceTab to _args[1]>>
			<<replace #ceTabs>><<combatExtendedTabButtons>><</replace>>
			<<replace #ceTabContent>><<combatExtendedTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "combatExtendedTabContent">>
	<<switch _ceTab>>
		<<case "enemy">><<combatExtendedEnemySettings>>
		<<default>><<combatExtendedPlayerSettings>>
	<</switch>>
<</widget>>

<<widget "combatExtendedPlayerSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				플레이어 CE 행동
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 방어:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.blocking" 0 1 autocheck>> 방어 활성화
					<mouse class="tooltip linkBlue">(?)<span>받는 피해를 최대 80%까지 줄입니다. 피해 감소량은 체격에 비례합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.countering" 0 1 autocheck>> 반격 활성화
					<mouse class="tooltip linkBlue">(?)<span>A chance to deal damage instead of taking it when an enemy attacks. Success scales off of skulduggery. Each hand you guard with can turn aside one attack per turn. Countering is harder when you're outnumbered, and a light frame turns a blow more readily than a heavy one.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 공격:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.feinting" 0 1 autocheck>> 페인트 동작 활성화
					<mouse class="tooltip linkBlue">(?)<span>피해량이 줄어드는 대신 적의 회피 확률을 일부 무효화합니다. 속임수에 비례합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.hookpunching" 0 1 autocheck>> 훅 펀치 활성화
					<mouse class="tooltip linkBlue">(?)<span>적의 회피 확률이 높아지는 대신 두 배의 피해를 줄 확률이 있습니다.</span></mouse>
				</label>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				플레이어 스킬
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 회피:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.passiveDodging" 0 1 autocheck>> 수동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>수동 회피입니다. 매트릭스가 되어 보세요.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.activeDodging" 0 1 autocheck>> 능동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>회피를 위한 새로운 발 행동입니다. 수동 회피와는 별개의 더 좋은 회피 판정이지만, 발 행동을 소모하고 실패하면 안정성 피해를 입습니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.uncappedDodgeChance" 0 1 autocheck>> 회피 확률 상한 해제 활성화
					<mouse class="tooltip linkBlue">(?)<span>Removes the hard dodge cap. Very high dodge chance still has diminishing returns.</span></mouse>
				</label><br>
				<span class="gold">회피 확률 상한
				<mouse class="tooltip linkBlue">(?)<span>The cap for dodge chance. Your body size sets its own cap as well, and the lower of the two applies. Small bodies can dodge far more than large ones.</span></mouse>
				</span>
				<<numberslider "$combatExtended.dodgeChanceCap" $combatExtended.dodgeChanceCap 0 100 1>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$combatExtended.brawlingToggle" 0 1 autocheck>> 난투 활성화
					<mouse class="tooltip linkBlue">(?)<span>난투 스킬. 더 많은 사람과 싸울수록 오르며, 더 많은 상대와 싸울 때 효과가 더 크게 늘어납니다.</span></mouse>
				</label><br>
				<span data-target="combatExtended.standingFights" data-disabledif="V.combatExtended.standingFights===0">
					<label>
						<<checkbox "$combatExtended.footworkToggle" 0 1 autocheck>> 풋워크 활성화
						<mouse class="tooltip linkBlue">(?)<span>풋워크 스킬. 모든 원인으로 인한 안정성 손실을 줄여 줍니다.</span></mouse>
					</label><br>
				</span>
				<label>
					<<checkbox "$combatExtended.strikingToggle" 0 1 autocheck>> 타격 활성화
					<mouse class="tooltip linkBlue">(?)<span>타격 스킬. 타격의 명중률과 위력을 높여 줍니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.kickingToggle" 0 1 autocheck>> 발차기 활성화
					<mouse class="tooltip linkBlue">(?)<span>발차기 스킬. 타격의 명중률과 위력을 높여 줍니다.</span></mouse>
				</label>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "combatExtendedEnemySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				적의 확장 전투 행동
			</div>
			<div class="settingsToggleItem">
				<<link "모두 전환">>
					<<set $combatExtended.enemyPassiveDodging to 1>>
					<<set $combatExtended.enemyActiveDodging to 1>>
					<<set $combatExtended.enemyBlocking to 1>>
					<<set $combatExtended.enemyCountering to 1>>
					<<set $combatExtended.enemyFeinting to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyPassiveDodging" 0 1 autocheck>> 적의 수동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격을 회피할 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyActiveDodging" 0 1 autocheck>> 적의 능동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>그 턴 동안 회피 확률이 두 배가 될 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyBlocking" 0 1 autocheck>> 적의 공격 막기 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격을 막을 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyCountering" 0 1 autocheck>> 적의 반격 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격에 반격할 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyFeinting" 0 1 autocheck>> 적의 페인트 공격 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 회피 확률 일부를 상쇄할 확률이 생깁니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Enemy Damage Multiplier:</span><mouse class="tooltip linkBlue">(?)<span>Scales the pain, stress and trauma caused by landed enemy attacks.</span></mouse>
				<span class="red">Setting it below 100 will disable feats.</span><br>
				<<numberslider "$combatExtended.enemyDamageMult" $combatExtended.enemyDamageMult 25 300 5 {
					value: value => value + "%"
				}>>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				적의 스킬
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적의 기본 회피/반격 확률:</span>
				<br>
				<div class="small-description">예전 방식의 적 회피/반격 시스템입니다. 적의 무술과 중첩됩니다.</div>
				<span data-target='["combatExtended.enemyPassiveDodging", "combatExtended.enemyActiveDodging", "combatExtended.enemyCountering"]' data-disabledif="V.combatExtended.enemyPassiveDodging===0&&V.combatExtended.enemyActiveDodging===0&&V.combatExtended.enemyCountering===0">
					<label>
						<<checkbox "$combatExtended.enemyBaseDodgeChance" 0 1 autocheck>> 적의 기본 회피 확률 활성화
						<mouse class="tooltip linkBlue">(?)<span>무술 스킬과 무관한 적의 기본 회피 확률입니다.</span></mouse>
					</label><br>
					<span data-target="combatExtended.enemyBaseDodgeChance" data-disabledif="V.combatExtended.enemyBaseDodgeChance===0">
						<div class="solidBorderContainer settings-container">
							<span class="gold">기본 회피 확률 레벨 스케일링 (%)
							<mouse class="tooltip linkBlue">(?)<span>레벨당 적의 회피 확률이 얼마나 오르는지 정합니다. 최대 레벨은 22입니다. 예전 방식은 레벨당 2%였습니다.</span></mouse>
							</span>
							<<numberbox "$combatExtended.enemyBaseDodgeChanceMult" $combatExtended.enemyBaseDodgeChanceMult>>
						</div>
					</span>
				</span>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적의 무술:</span>
				<br>
				<span data-target='["combatExtended.enemyPassiveDodging", "combatExtended.enemyActiveDodging", "combatExtended.enemyCountering"]' data-disabledif="V.combatExtended.enemyPassiveDodging===0&&V.combatExtended.enemyActiveDodging===0&&V.combatExtended.enemyCountering===0">
					<label>
						<<checkbox "$combatExtended.enemyMartialArts" 0 1 autocheck>> 적의 무술 활성화
						<mouse class="tooltip linkBlue">(?)<span>적의 회피/반격 확률을 높이는 스킬입니다.</span></mouse>
					</label><br>
				</span>
				<span data-target="combatExtended.enemyMartialArts" data-disabledif="V.combatExtended.enemyMartialArts===0">
					<div class="small-description">무술 무작위 스케일링과 무술 레벨 스케일링을 둘 다 활성화하면 두 효과가 중첩됩니다.</div>
					Enemy Martial Arts Scaling:<br>
					<label>무작위 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "random" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 무작위로 정해집니다.</span></mouse> |
					<label>레벨 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "level" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 레벨에 따라 오릅니다.</span></mouse> |
					<label>둘 다 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "both" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>무작위 + 레벨 스케일링입니다.</span></mouse>
					<br>
					<span data-target="combatExtended.enemyMartialArtsLevelScaling" data-disabledif="V.combatExtended.enemyMartialArtsLevelScaling==='level'||V.combatExtended.enemyMartialArtsLevelScaling==='both'">
						<div class="solidBorderContainer settings-container">
							<span class="gold">무술 레벨 스케일링
							<mouse class="tooltip linkBlue">(?)<span>레벨당 적의 무술 스킬이 얼마나 오르는지 정합니다. 최대 레벨은 22입니다. 무술 10당 회피/반격 확률 1%입니다.</span></mouse>
							</span>
							<<numberbox "$combatExtended.enemyMartialArtsLevelScalingMult" $combatExtended.enemyMartialArtsLevelScalingMult>>
						</div>
					</span>
					<label>
						<<checkbox "$combatExtended.enemyMartialArtsBadass" 0 1 autocheck>> 적의 무술 강자 모드 활성화
						<mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 500 오를 때마다 적은 적의 확장 전투 행동 중 다른 행동을 동시에 하나 더 할 수 있습니다. 예: 무술 스킬 500인 적은 회피, 반격, 막기 중 두 가지를 고를 수 있습니다. 무술 스킬 1000인 적은 세 가지를 동시에 할 수 있습니다.</span></mouse>
					</label><br>
				</span>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				적 버프 스케일링
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적 일수 스케일링:</span>
				<br>
				<<link "일수 스케일링 전환">>
					<<set $combatExtended.enemyLevelDayScaling to 1>>
					<<set $combatExtended.enemyHealthDayScaling to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyLevelDayScaling" 0 1 autocheck>> 게임 내 일수에 따른 적 레벨 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 일반 NPC의 레벨이 오릅니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">레벨 버프 스케일링 (레벨)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프 한 번에 오르는 레벨입니다. 1이면 버프가 적용될 때마다 적의 레벨이 +1 오릅니다. 최대 레벨은 22입니다.</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyLevelDayScalingMult" $combatExtended.enemyLevelDayScalingMult>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyHealthDayScaling" 0 1 autocheck>> 게임 내 일수에 따른 적 체력 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 NPC와 짐승의 체력이 체력 배율과 별개로 추가 상승합니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">체력 비율 버프 스케일링 (%)
					<mouse class="tooltip linkBlue">(?)<span>스케일링이 발동할 때마다 얻는 체력 비율 버프입니다. 5이면 버프가 적용될 때마다 체력이 +5% 오릅니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyHealthDayScalingMult" $combatExtended.enemyHealthDayScalingMult>>
				</div>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 간격 (일)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 발동하는 일수 간격입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDayScaling" $combatExtended.enemyDayScaling>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyInfiniteDayScaling" 0 1 autocheck>> 무한 버프 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수에 제한이 없습니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 한도 (버프 횟수)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수의 한도입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDayScalingLimit" $combatExtended.enemyDayScalingLimit>>
				</div>
			</div>
			<div class="settingsToggleItem" role="group" aria-labelledby="settingsScaling">
				<span class="gold">적 패배 스케일링:</span>
				<br>
				<<link "패배 스케일링 전환">>
					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyLevelDefeatScaling" 0 1 autocheck>> 적 패배 수에 따른 적 레벨 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>적을 한 명 쓰러뜨릴 때마다 모든 일반 NPC의 레벨이 오릅니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">레벨 버프 스케일링 (레벨)
					<mouse class="tooltip linkBlue">(?)<span>레벨 버프가 적용되기까지 필요한 적 패배 수입니다. 1이면 버프가 적용될 때마다 적의 레벨이 +1 오릅니다. 최대 레벨은 22입니다.</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyLevelDefeatScalingMult" $combatExtended.enemyLevelDefeatScalingMult>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyHealthDefeatScaling" 0 1 autocheck>> 적 패배 수에 따른 적 체력 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 NPC와 짐승의 체력이 체력 배율과 별개로 추가 상승합니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">체력 비율 버프 스케일링 (%)
					<mouse class="tooltip linkBlue">(?)<span>스케일링이 발동할 때마다 얻는 체력 비율 버프입니다. 0.05이면 버프가 적용될 때마다 체력이 +5% 오릅니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyHealthDefeatScalingMult" $combatExtended.enemyHealthDefeatScalingMult>>
				</div>
				<div class="solidBorderContainer settings-container">
					<span class="gold">적 패배 스케일링 기준 (적 수)
					<mouse class="tooltip linkBlue">(?)<span>버프가 적용되기까지 필요한 적 패배 수의 기준입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDefeatScaling" $combatExtended.enemyDefeatScaling>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyInfiniteDefeatScaling" 0 1 autocheck>> 무한 버프 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수에 제한이 없습니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 한도 (버프 횟수)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수의 한도입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDefeatScalingLimit" $combatExtended.enemyDefeatScalingLimit>>
				</div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "amcTraitsSettings">>
	/% Dropping the Autism Spectrum trait drops the talents it paid for %/
	<<run autismEnforceTalentLimits()>>
	<<if typeof applyPermanentInsanityTalents is "function">>
		<<run applyPermanentInsanityTalents()>>
	<</if>>
	<<if _amcTab is undefined>><<set _amcTab to "talents">><</if>>
	<hr>
	<div id="amcTabs" class="no-numberify"><<amcTabButtons>></div>
	<div id="amcTabContent"><<amcTabContent>></div>
<</widget>>

<<widget "amcTabButtons">>
	<div class="containerStart">
		<<amcTabButton "Talents" "talents">>
		<<amcTabButton "Traits" "traits">>
		<<amcTabButton "Misc" "systems">>
	</div>
<</widget>>

<<widget "amcTabButton">>
	<div @class="_amcTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _amcTab to _args[1]>>
			<<replace #amcTabs>><<amcTabButtons>><</replace>>
			<<replace #amcTabContent>><<amcTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "amcTabContent">>
	<<switch _amcTab>>
		<<case "traits">><<amcTraitsTraitSettings>>
		<<case "systems">><<amcTraitsSystemSettings>>
		<<default>><<amcTraitsTalentSettings>>
	<</switch>>
<</widget>>

<<widget "amcTraitsTalentSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">Character Talents:</span><br>
				<span class="small-description">These talents double your skill cap, however they also make it twice as hard to raise those skills once the vanilla cap for said skill has been reached. Generally beneficial. Although, you only have a limited amount of talent points to spend on your character. So choose wisely.</span>
				<<if typeof permanentInsanityTalentLockActive is "function" and permanentInsanityTalentLockActive()>>
					<br><span class="red small-description">Permanent Insanity forces every talent active.</span>
				<</if>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Choose (max: 1<<if $seaRemembers?.reward>>, excluding your earned breakthrough<</if>>):</span><br>
				<label data-target='["AMCTraits.willpower"]' data-disabledif="V.seaRemembers?.reward === 'physique' || permanentInsanityTalentLockActive() || V.AMCTraits.willpower === 2 && V.seaRemembers?.reward !== 'willpower'"><span class="green">Tempered Physique</span> <<checkbox "$AMCTraits.physique" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.physique"]' data-disabledif="V.seaRemembers?.reward === 'willpower' || permanentInsanityTalentLockActive() || V.AMCTraits.physique === 2 && V.seaRemembers?.reward !== 'physique'"><span class="green">Tempered Willpower</span> <<checkbox "$AMCTraits.willpower" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Choose (max: 1):</span><br>
				<label data-target='["AMCTraits.semen"]' data-disabledif="permanentInsanityTalentLockActive() || V.AMCTraits.semen === 2"><span class="blue">Tempered Milk Volume</span> <<checkbox "$AMCTraits.milk" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.milk"]' data-disabledif="permanentInsanityTalentLockActive() || V.AMCTraits.milk === 2"><span class="blue">Tempered Semen Volume</span> <<checkbox "$AMCTraits.semen" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Choose (max: <<= autismTalentLimit("general")>>):</span><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.skulduggery !== 2"><span class="green">Tempered Skulduggery</span> <<checkbox "$AMCTraits.skulduggery" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.dancing !== 2"><span class="green">Tempered Dancing</span> <<checkbox "$AMCTraits.dancing" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.swimming !== 2"><span class="green">Tempered Swimming</span> <<checkbox "$AMCTraits.swimming" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="V.seaRemembers?.reward === 'athletics' || permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.athletics !== 2"><span class="green">Tempered Athletics</span> <<checkbox "$AMCTraits.athletics" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.tending !== 2"><span class="green">Tempered Tending</span> <<checkbox "$AMCTraits.tending" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.housekeeping !== 2"><span class="green">Tempered Housekeeping</span> <<checkbox "$AMCTraits.housekeeping" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.brawling !== 2"><span class="green">Tempered Brawling</span> <<checkbox "$AMCTraits.brawling" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.footwork !== 2"><span class="green">Tempered Footwork</span> <<checkbox "$AMCTraits.footwork" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.striking !== 2"><span class="green">Tempered Striking</span> <<checkbox "$AMCTraits.striking" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.kicking !== 2"><span class="green">Tempered Kicking</span> <<checkbox "$AMCTraits.kicking" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.science !== 2"><span class="teal">Tempered Science</span> <<checkbox "$AMCTraits.science" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.maths !== 2"><span class="teal">Tempered Maths</span> <<checkbox "$AMCTraits.maths" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.english !== 2"><span class="teal">Tempered English</span> <<checkbox "$AMCTraits.english" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.history !== 2"><span class="teal">Tempered History</span> <<checkbox "$AMCTraits.history" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Choose (max: <<= autismTalentLimit("sex")>>):</span><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.seductionskill !== 2"><span class="blue">Tempered Seduction Skill</span> <<checkbox "$AMCTraits.seductionskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.oralskill !== 2"><span class="blue">Tempered Oral Skill</span> <<checkbox "$AMCTraits.oralskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.chestskill !== 2"><span class="blue">Tempered Chest Skill</span> <<checkbox "$AMCTraits.chestskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.handskill !== 2"><span class="blue">Tempered Hands Skill</span> <<checkbox "$AMCTraits.handskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.bottomskill !== 2"><span class="blue">Tempered Buttocks Skill</span> <<checkbox "$AMCTraits.bottomskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.penileskill !== 2"><span class="blue">Tempered Penile Skill</span> <<checkbox "$AMCTraits.penileskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.vaginalskill !== 2"><span class="blue">Tempered Vaginal Skill</span> <<checkbox "$AMCTraits.vaginalskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.analskill !== 2"><span class="blue">Tempered Anal Skill</span> <<checkbox "$AMCTraits.analskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.thighskill !== 2"><span class="blue">Tempered Thighs Skill</span> <<checkbox "$AMCTraits.thighskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.feetskill !== 2"><span class="blue">Tempered Feet Skill</span> <<checkbox "$AMCTraits.feetskill" 1 2 autocheck>></label><br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "amcTraitsTraitSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">Traits</span><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Cock/Hole Addict:</span><br>
				<label><<checkbox "$xchange.genitalAddictTraitsEnabled" 0 1 autocheck>> Enable the traits</label> <mouse class="tooltip linkBlue">(?)<span>Gain acquisition of Cock/Hole Addict traits, which stop you from orgasming unless you're undergoing penetration of some kind (depending on the respective trait).</span></mouse><br>
				<label><<checkbox "$xchange.genitalAddictFreeOrgasm" false true autocheck>> Allow orgasm without penetration</label> <mouse class="tooltip linkBlue">(?)<span>Normally, Cock/Hole Addict stop you from orgasming without the penetration they crave. Enable this to allow orgasms anyway. Those orgasms feel hollow and cause stress.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Oral Fixation:</span><br>
				<label><<checkbox "$xchange.oralFixationTraitEnabled" 0 1 autocheck>> Enable the trait</label> <mouse class="tooltip linkBlue">(?)<span>Allows the Oral Fixation trait to be gained from giving oral and swallowing cum. It stops you from orgasming unless you're giving oral, raises mouth sensitivity, and makes swallowed cum act like plant nectar, including its addiction. Disable to remove and suppress it. Re-enable it to regain the trait if you've already met its requirement.</span></mouse><br>
				<label><<checkbox "$xchange.oralFixationSwallowRelief" 0 1 autocheck>> Swallowing cum lets you orgasm</label> <mouse class="tooltip linkBlue">(?)<span>With this on, swallowing cum also lets you orgasm for the next hour, even when nothing is in your mouth. Turn it off to only allow orgasm while you're giving oral.</span></mouse><br>
				<label><<checkbox "$xchange.oralFixationFreeOrgasm" false true autocheck>> Allow orgasm without oral</label> <mouse class="tooltip linkBlue">(?)<span>Normally, Oral Fixation stops you from orgasming unless it is satisfied. Enable this to allow orgasms anyway. Those orgasms feel hollow and cause stress.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Acclimated Traits:</span><br>
				<label><<checkbox "$xchange.chastityAcclimatedTraitEnabled" 0 1 autocheck>> Enable Chastity Acclimated</label> <mouse class="tooltip linkBlue">(?)<span>Allows the Chastity Acclimated trait to be gained after ten straight days locked in chastity. It greatly reduces the frustration that chastity you didn't choose builds up. Disable to remove and suppress it. Re-enable it to regain the trait if you've already met its requirement.</span></mouse><br>
				<label><<checkbox "$xchange.arousalAcclimatedTraitEnabled" 0 1 autocheck>> Enable Arousal Acclimated</label> <mouse class="tooltip linkBlue">(?)<span>Allows the Arousal Acclimated trait to be gained after two straight weeks of being Lustful, or once Chastity Acclimated. It halves all arousal gain and lets you sleep, leave the bath or shower, walk away from Wren's card table, and refuse advances no matter how aroused you are. Disable to remove and suppress it. Re-enable it to regain the trait if you've already met its requirement.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Blindfold Adaptability:</span><br>
				Keeping Adaptability: <mouse class="tooltip linkBlue">(?)<span>Adaptability fades while your eyes are uncovered. Fades: Gwylan can hypnotise you to pause the fading for a while. Gwylan locks it in: once you're fully adapted, Gwylan can make it permanent. Locks in: it becomes permanent as soon as you're fully adapted.</span></mouse><br>
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "fade" autocheck>> Fades</label> |
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "gwylan" autocheck>> Gwylan locks it in</label> |
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "auto" autocheck>> Locks in</label><br>
				<label><<checkbox "$xchange.blindAdaptabilityNoLove" 0 1 autocheck>> Gwylan helps without needing love</label> <mouse class="tooltip linkBlue">(?)<span>Normally Gwylan only helps with Adaptability once Gwylan's love is at 50% or more. With this on, Gwylan helps once you've done Gwylan a favour instead, like Gwylan's other hypnosis.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Heat/Rut:</span><br>
				<label><<checkbox "$xchange.heatBlocksScream" 0 1 autocheck>> Can't Scream while in Heat/Rut</label> <mouse class="tooltip linkBlue">(?)<span>While you are in heat or rut, you lose the Scream action in encounters.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Critter Magnet:</span><br>
				<label><<checkbox "$xchange.critterMagnetTraitEnabled" 0 1 autocheck>> Enable the trait</label> <mouse class="tooltip linkBlue">(?)<span>Allows the Critter Magnet trait to be gained. Disable to remove and suppress it. Re-enable it to regain the trait if you've already met its requirement.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Insanity:</span><br>
				<label><<checkbox "$xchange.insanityDisturbedTraitsEnabled" 0 1 autocheck>> Full Dissociation</label> <mouse class="tooltip linkBlue">(?)<span>By default, Insanity's Dissociation only paralyses you for the first two encounter sequences before becoming mild. Enable this to also become Visibly Disturbed and use normal severe Dissociation, which can keep you completely paralysed.</span></mouse> <span class="red">This option completely prevents you from screaming or fighting back!</span><br>
				<label><<checkbox "$xchange.insanityBecomesPermanent" 0 1 autocheck>> Naturally-gained Insanity is permanent</label> <mouse class="tooltip linkBlue">(?)<span>Normally, an Insanity gained in-game (from staying severely traumatised for over a week) fades once your trauma subsides. With this on, the moment it takes hold it becomes <b>permanent</b>. It does <i>not</i> grant the doubled skill caps of a character-creation Insanity. The only relief is Gwylan, who can hypnotise the madness into temporary quiet.</span></mouse><br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "amcTraitsSystemSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">Willpower System</span><br>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.willpowerSystemEnabled" 0 1 autocheck>> Enable willpower system</label> <mouse class="tooltip linkBlue">(?)<span>Willpower is turned into a daily resource, that gets weaker and weaker as it gets spent during the day, as well as a result of resisting pleasure during combat.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<label data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1"><<checkbox "$xchange.willpowerRestEnabled" 0 1 autocheck>> Rest and calm restore willpower</label>
				<mouse class="tooltip linkBlue">(?)<span>Resting, eating, praying, meditating, and reducing stress can restore some willpower. Daily recovery is limited, so sleep remains the main source.</span></mouse><br>
			</div>

			<div class="settingsToggleItem numberslider-inline" data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1">
				<span class="gold bold">Success Cost:
				<mouse class="tooltip linkBlue">(?)<span>The amount of willpower spent whenever you succeed a willpower difficulty check. (For reference, vanilla willpower goes up to 1000. And up to 2000 with AMC Traits).</span></mouse>
				</span>
				<<numberbox "$xchange.willpowerSuccessCost" $xchange.willpowerSuccessCost>>
			</div>
			<div class="settingsToggleItem numberslider-inline" data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1">
				<span class="gold bold">Failure Cost:
				<mouse class="tooltip linkBlue">(?)<span>The amount of willpower spent whenever you fail a willpower difficulty check. (For reference, vanilla willpower goes up to 1000. And up to 2000 with AMC Traits).</span></mouse>
				</span>
				<<numberbox "$xchange.willpowerFailureCost" $xchange.willpowerFailureCost>>
			</div>
			<div class="settingsToggleItemWide numberslider-inline" data-target='["xchange.willpowerSystemEnabled","xchange.willpowerRestEnabled"]' data-disabledif="V.xchange?.willpowerSystemEnabled!==1||V.xchange?.willpowerRestEnabled===0">
				<span class="gold bold">Rest Recovery Strength: (%)
					<mouse class="tooltip linkBlue">(?)<span>Changes how much willpower resting restores and its daily limit. At 100%, you can recover up to 40% of your willpower pool per day.</span></mouse>
				</span>
				<<numberslider "$xchange.willpowerRestPercent" $xchange.willpowerRestPercent 0 300 25>>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">Hypnosis Settings</span><br>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$angryHypnotist" false true autocheck>> Hypnotists are more likely to hypnotise you when angered
				</label><br>
				<label>
					<<checkbox "$deviantHypnotist" false true autocheck>> Hypnotists can give you hypnotic deviancy
				</label>
			</div>
			<div class="settingsToggleItem">
				<label><span class="gold">Enemy Hypnotist Chance (%)</span>
				<br>
				<<numberslider "$hypnotistChance" $hypnotistChance 0 100 1>>
				</label><br>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">Heat System</span><br>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.systemOn" 0 1 autocheck>> Enable forceful heat</label> 
				<mouse class="tooltip linkBlue">(?)<span>Being in heat can lead to characters losing themselves to their primal needs. If chastity blocks every breeding hole, they will claw at the device instead, slowly wearing it down.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.permanentOn" 0 1 autocheck>> Enable permanent system</label>
				<mouse class="tooltip linkBlue">(?)<span>Forces to stay in heat and/or rut at <b>all times</b>, regardless of pills, fertility, or cycle timing.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.resistWithWillpower" 0 1 autocheck>> Resist heat with willpower</label>
				<mouse class="tooltip linkBlue">(?)<span>When checked, a high willpower can hold heat back; it only overrides your actions when you <b>fail</b> a willpower check. Un-checking this ignores willpower and lets heat take over every time.</span></mouse>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "modLISettingsSection">>
	<<run ensureModLISettings()>>
	<<set _enabledModLIs to getActivatedModLIs()>>
	<<set _availableModLIs to getAvailableModLIs()>>
	<div class="settingsToggleItemWide">
		<<if $ModExclusiveLIEnabled is 1>>
			<div class="small-description red">경고: 모드 전용 연애 대상을 활성화하면 이 세이브 파일에서는 되돌릴 수 없습니다. 한 번 활성화한 연애 대상은 이번 플레이 내내 등장할 수 있습니다.</div>
			<label>이 세이브 파일에서 활성화할 커스텀 연애 대상을 고르십시오:</label><br>
			<<if _availableModLIs.length gt 0>>
				<<for _modLIName range _availableModLIs>>
					<<button _modLIName>>
						<<run activateModLI(_modLIName)>>
						<<replace #modLISettingsPanel>><<modLISettingsSection>><</replace>>
					<</button>>
					<<if _modLIName neq _availableModLIs[_availableModLIs.length - 1]>> | <</if>>
				<</for>>
			<<else>>
				<div class="green">모든 모드 전용 연애 대상이 이미 이 세이브 파일에서 활성화되어 있습니다.</div>
			<</if>>
			<br>
			<span class="gold">이 저장 파일에서 활성화됨</span><br>
			<<if _enabledModLIs.length gt 0>>
				<<for _enabledName range _enabledModLIs>>
					<<print _enabledName>>
					<<if _enabledName neq _enabledModLIs[_enabledModLIs.length - 1]>> | <</if>>
				<</for>>
			<<else>>
				<span class="small-description">이 세이브 파일에서 영구 활성화된 모드 전용 연애 대상이 아직 없습니다.</span>
			<</if>>
		<<else>>
			<span class="small-description">모드 전용 연애 대상을 켜면 영구 활성화 메뉴가 열립니다. 이미 활성화한 연애 대상은 나중에 이 메뉴를 다시 숨겨도 이 세이브 파일에 고정된 채로 남습니다.</span>
		<</if>>
	</div>
<</widget>>

<<widget "dolpSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem" id="modExclusiveLISetting">
				<span class="gold">모드 전용 연애 대상</span>
				<br>
				<label><<checkbox "$ModExclusiveLIEnabled" 0 1 autocheck>> 모드 전용 연애 대상 표시</label>
			</div>
			<div id="modLISettingsPanel"><<modLISettingsSection>></div>
			<<run $(() => {$('#modExclusiveLISetting input[type="checkbox"]').off('change.modli').on('change.modli', () => {Wikifier.wikifyEval('<<replace #modLISettingsPanel>><<modLISettingsSection>><</replace>>');});})>>
			
			<div class="settingsToggleItem">
				<span class="gold">적 능력치 표시</span> <mouse class = "tooltip linkBlue">(?)<span>조우에 들어서면 적의 상태가 글로 설명됩니다. 이 설정으로 적의 능력치가 정확히 몇인지 볼 수 있습니다.</span></mouse>
				<br>
				<label>정확한 수치 표시 <<radiobutton "$enemystatstyle" "full" autocheck>></label> |
				<label>설명만 표시 <<radiobutton "$enemystatstyle" "default" autocheck>></label>
				<br>
				<label>
					<<checkbox "$postCombatStats" 0 1 autocheck>> Show post-encounter summary <mouse class = "tooltip linkBlue">(?)<span>After an encounter ends, shows a recap: how many times you and your partners or assailants orgasmed, where you took and gave cum, and any clothing destroyed or stolen.</span></mouse>
				</label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Modded Clothing Traits</span>
				<br>
				<label>
					<<checkbox "$realisticTransparency" 0 1 autocheck>> Enable Realistic Clothing Transparency
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>In Vanilla, most clothes go transparent. This toggle changes it so it is based on the type of material it is usually made with.</span></mouse>
				<br>
				<label>
					<<checkbox "$preyTrait" 0 1 autocheck>> Enable Prey trait
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>Clothing with the Prey trait (bunny, cow and reindeer costumes) makes wild beasts in the forest and the hawk over the moor more likely to find you.</span></mouse>
				<br>
				<label>
					<<checkbox "$silkyTrait" 0 1 autocheck>> Enable Silky trait
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>Clothing with the Silky trait never rubs against sensitive nipples or genitals, so it won't arouse you or show the rubbing message.</span></mouse>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">옷장 수용량 배율</span>
				<br>
				<div class="small-description">Modifies the capacity of wardrobes. Purchases and transfers are limited to 3,000 total items per wardrobe regardless of this setting. Automatic clothing returns can exceed this limit.</div>
				<<numberslider "$wardrobeMult" $wardrobeMult 1 20 1>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">자전거 설정</span>
				<br>
				<label>
					<<checkbox "$bicycle.persistentLocation" false true autocheck>> 자전거 위치 유지 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 자전거를 둔 위치를 게임이 기억하며, 그 위치에서만 다시 탈 수 있습니다. 비활성화하면 이용 가능한 어느 장소에서든 탈 수 있습니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$bicycle.theftEnabled" false true autocheck>> 자전거 보안 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 자전거가 매일 자정마다 도난당할 위험이 있으며 보안 업그레이드를 이용할 수 있습니다. 비활성화하면 자전거는 절대 도난당하지 않습니다.</span></mouse>
				</label>
			</div>	

			<div class="settingsToggleItem">
				<span class="gold">Deposit Settings</span>
				<br>
				<div class="small-description numberslider-inline">Max weeks you can put down a deposit for. 0 means unlimited.
					<<numberslider "$depositMax" $depositMax 0 12 1>>
				</div>
				<div class="small-description numberslider-inline">How much of your deposit is cut as withdrawal fees if you decide to withdraw.
					<<numberslider "$depositWithdrawalFee" $depositWithdrawalFee 0 100 5 { value: (v) => v + "%" }>>
				</div>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">기생충 탱크·헛간 수용량 배율</span>
				<br>
				<div class="small-description">기생충 탱크와 헛간의 수용량을 조정합니다.</div>
				<<numberslider "$parasiteCapMult" $parasiteCapMult 1 10 1>>
			</div>
		</div>
	</div>
	<hr>
	<div id="dolpTabSettings">
		<<allDoLPSettings>>
	</div>
	<div id="subsectionDiv">
		<<rebalanceSettings>>
	</div>
	<br>
	<<link "맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
	<div style="clear:both;">/*Keep at end of toggles*/</div>
<</widget>>

<<widget "rebalanceSettings">>
	<<script>>setup.inflation?.ensureSettings?.();<</script>>
	<<if _rebalTab is undefined>><<set _rebalTab to "economy">><</if>>
	<hr>
	<div id="rebalTabs" class="no-numberify"><<rebalanceTabButtons>></div>
	<div id="rebalTabContent"><<rebalanceTabContent>></div>
<</widget>>

<<widget "rebalanceTabButtons">>
	<div class="containerStart">
		<<rebalanceTabButton "Economy Inflation" "economy">>
		<<rebalanceTabButton "Rebalancing Settings" "rebalancing">>
		<<rebalanceTabButton "Grind Settings" "grind">>
	</div>
<</widget>>

<<widget "rebalanceTabButton">>
	<div @class="_rebalTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _rebalTab to _args[1]>>
			<<replace #rebalTabs>><<rebalanceTabButtons>><</replace>>
			<<replace #rebalTabContent>><<rebalanceTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "rebalanceTabContent">>
	<<switch _rebalTab>>
		<<case "rebalancing">><<rebalanceRebalancingSettings>>
		<<case "grind">><<rebalanceGrindSettings>>
		<<default>><<rebalanceEconomySettings>>
	<</switch>>
<</widget>>

<<widget "rebalanceEconomySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				Economy Inflation <mouse class="tooltip linkBlue">(?)<span>These settings control how hard the economy pushes back.</span></mouse>
			</div>

			<div class="settingsToggleItemWide">
				<span class="gold">Economy Rebalance Preset</span> <mouse class="tooltip linkBlue">(?)<span>Applies a full economy tuning set. Light uses the lowest price increases, sets extra rent to start as late as possible, and sets refusal/hunt to Parody. Mid is softer than default. Current is the intended balance. Hard and Harsher make prices and Bailey pressure start biting earlier, and reduce Gentleman's Club quest income to 75% and 50% respectively. You can still adjust individual settings afterward.</span></mouse>
				<br>
				<<link "Light">><<run setup.inflation.applyPreset("light")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "Mid">><<run setup.inflation.applyPreset("mid")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "Current">><<run setup.inflation.applyPreset("current")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "Hard">><<run setup.inflation.applyPreset("hard")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "Harsher">><<run setup.inflation.applyPreset("harsher")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Inflation Percentages</span>
				<div class="small-description">Onset <mouse class="tooltip linkBlue">(?)<span>Price increase once total net wealth reaches £500,000.</span></mouse>: <<numberslider "$settings.inflationOnsetPct" $settings.inflationOnsetPct 11 30 1 { value: v => v + "%" }>></div>
				<div class="small-description">Bad economy <mouse class="tooltip linkBlue">(?)<span>Price increase once total net wealth reaches £2,000,000.</span></mouse>: <<numberslider "$settings.inflationBadPct" $settings.inflationBadPct 28 100 1 { value: v => v + "%" }>></div>
				<div class="small-description">Crisis <mouse class="tooltip linkBlue">(?)<span>Price increase once total net wealth reaches £5,000,000.</span></mouse>: <<numberslider "$settings.inflationCrisisPct" $settings.inflationCrisisPct 56 200 1 { value: v => v + "%" }>></div>
				<div class="small-description">Extreme <mouse class="tooltip linkBlue">(?)<span>Price increase once total net wealth reaches £15,000,000.</span></mouse>: <<numberslider "$settings.inflationExtremePct" $settings.inflationExtremePct 115 400 5 { value: v => v + "%" }>></div>
				<div class="small-description">Parody spiral <mouse class="tooltip linkBlue">(?)<span>Price increase once total net wealth reaches £100,000,000. This is the runaway-comedy tier, not the money-confiscation cap.</span></mouse>: <<numberslider "$settings.inflationParodyPct" $settings.inflationParodyPct 450 3000 50 { value: v => v + "%" }>></div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Bailey Triggers</span>
				<div class="red"><label><<checkbox "$settings.inflationBaileyRelentless" false true autocheck>> Relentless Bailey</label> <mouse class="tooltip linkBlue">(?)<span>When on, Bailey never accepts "no" and hunts you from the very start, sending thugs first and joining in personally far more often, and rent climbs a little every paid week no matter how poor you are, with <b>no cap</b> so it keeps rising forever. This overrides the two settings below and the Bailey Rent Limits caps (all greyed out). Only the weekly rent step controls how fast it climbs. Off by default; presets never change this.</span></mouse></div>
				<br>
				<div class="small-description" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">Extra rent starts <mouse class="tooltip linkBlue">(?)<span>Bailey starts adding extra rent after paid weeks once visible money reaches this inflation level. Visible money is cash and HBSC savings, minus bank-loan debt. Higher = starts later. Refuse still works.</span></mouse>: <<numberslider "$settings.inflationBaileyRentPct" $settings.inflationBaileyRentPct 3 300 1 { value: v => v + "%" }>></div>
				<div class="small-description" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">Refusal/hunt starts <mouse class="tooltip linkBlue">(?)<span>Choose the economy stage when Bailey stops accepting Refuse. Street hunts can also start from that stage. Later stages are easier.</span></mouse>:<br>
					<label>Onset <<radiobutton "$settings.inflationBaileyCrisisTier" "onset" autocheck>></label> |
					<label>Bad economy <<radiobutton "$settings.inflationBaileyCrisisTier" "bad" autocheck>></label> |
					<label>Crisis <<radiobutton "$settings.inflationBaileyCrisisTier" "crisis" autocheck>></label> |
					<label>Extreme <<radiobutton "$settings.inflationBaileyCrisisTier" "extreme" autocheck>></label> |
					<label>Parody <<radiobutton "$settings.inflationBaileyCrisisTier" "parody" autocheck>></label>
				</div>
			</div>

			<div class="settingsToggleItem" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">
				<span class="gold">Bailey Rent Limits</span> <mouse class="tooltip linkBlue">(?)<span>These caps bound how high Bailey's weekly rent can climb.</span></mouse>
				<div class="small-description">Low-wealth cap <mouse class="tooltip linkBlue">(?)<span>Maximum total rent demand while Bailey-visible wealth is below £1,000,000 and extra rent pressure is active.</span></mouse>: <<numberslider "$settings.inflationBaileyCapLow" $settings.inflationBaileyCapLow 500000 5000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">High-wealth cap <mouse class="tooltip linkBlue">(?)<span>Maximum total rent demand while Bailey-visible wealth is between £1,000,000 and £10,000,000.</span></mouse>: <<numberslider "$settings.inflationBaileyCapHigh" $settings.inflationBaileyCapHigh 1000000 10000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">Jump-tier cap <mouse class="tooltip linkBlue">(?)<span>Maximum total rent demand while Bailey-visible wealth is between £10,000,000 and £100,000,000. This is the special "I want more" demand tier.</span></mouse>: <<numberslider "$settings.inflationBaileyDemandJump" $settings.inflationBaileyDemandJump 2500000 25000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">Investment-tier cap <mouse class="tooltip linkBlue">(?)<span>Maximum total rent demand while Bailey-visible wealth is £100,000,000 or higher. This is Bailey treating the player as an investment.</span></mouse>: <<numberslider "$settings.inflationBaileyDemandInvestment" $settings.inflationBaileyDemandInvestment 5000000 100000000 50000 { value: v => formatMoney(v) }>></div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Bailey Weekly Pressure</span>
				<div class="small-description">Weekly rent step <mouse class="tooltip linkBlue">(?)<span>How much extra rent Bailey adds after each successful paid week while Extra rent starts is active, until the current rent cap is reached.</span></mouse>: <<numberslider "$settings.inflationBaileyStep" $settings.inflationBaileyStep 10000 200000 10000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">Overdue loan collection <mouse class="tooltip linkBlue">(?)<span>Weekly amount Bailey adds to rent when HBSC marks an unpaid loan overdue. It pays down the loan and is separate from inflation rent pressure.</span></mouse>: <<numberslider "$settings.inflationLoanRentSurcharge" $settings.inflationLoanRentSurcharge 50000 300000 5000 { value: v => formatMoney(v) }>></div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "rebalanceRebalancingSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				재조정 설정
				<br>
					<<link "Enable All">>
						<<set $tirednessMaxScalingToggle to 1>>
						<<set $stressMaxScalingToggle to 1>>
						<<set $athleticsFitnessToggle to 1>>
						<<set $fatigueSkillPenaltyToggle to 1>>

						<<set $mathsTraitBuffs.antiques to 1>>
						<<set $mathsTraitBuffs.stolen to 1>>
						<<set $mathsTraitBuffs.market to 1>>
						<<set $mathsTraitBuffs.aphrodisiacPhials to 1>>

						<<set $historyTraitBuffs.improvedChances to 1>>

						<<set $DoLPTFBuffs to 1>>
						<<set $DoLPTFTempTolerance to 1>>

						<<set $substanceRebalance to 1>>
						<<set $dancingRebalance to 1>>
						<<set $foodSpoilage to 1>>

						<<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
					<</link>>
					|
					<<link "Disable All">>
						<<set $tirednessMaxScalingToggle to 0>>
						<<set $stressMaxScalingToggle to 0>>
						<<set $athleticsFitnessToggle to 0>>
						<<set $fatigueSkillPenaltyToggle to 0>>

						<<set $mathsTraitBuffs.antiques to 0>>
						<<set $mathsTraitBuffs.stolen to 0>>
						<<set $mathsTraitBuffs.market to 0>>
						<<set $mathsTraitBuffs.aphrodisiacPhials to 0>>

						<<set $historyTraitBuffs.improvedChances to 0>>

						<<set $DoLPTFBuffs to 0>>
						<<set $DoLPTFTempTolerance to 0>>

						<<set $substanceRebalance to 0>>
						<<set $dancingRebalance to 0>>
						<<set $foodSpoilage to 0>>

						<<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
					<</link>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">핵심 특성</span>
				<br>
				<label>
					<<checkbox "$tirednessMaxScalingToggle" 0 1 autocheck>> 피로도 최대치 스케일링 활성화 <mouse class = "tooltip linkBlue">(?)<span>피로도 최대치가 체격에 따라 늘어납니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$stressMaxScalingToggle" 0 1 autocheck>> Enable Stress Max Scaling <mouse class = "tooltip linkBlue">(?)<span>Stress max will increase with your current willpower points while the willpower system is enabled, and with normal willpower otherwise.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$athleticsFitnessToggle" 0 1 autocheck>> 체육 체력 활성화 <mouse class = "tooltip linkBlue">(?)<span>체육이 피로도 증가량을 줄여 줍니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$fatigueSkillPenaltyToggle" 0 1 autocheck>> Enable Fatigue Skill Penalty <mouse class = "tooltip linkBlue">(?)<span>Skills lose power once tiredness rises above 50% of its maximum.</span></mouse>
				</label>
				<br>
				<div class="small-description numberslider-inline">Maximum skill loss at full tiredness.
					<<numberslider "$fatigueSkillPenaltyMax" $fatigueSkillPenaltyMax 0 100 5 { value: (v) => v + "%" }>>
				</div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Trait Buffs</span>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.antiques" 0 1 autocheck>> 골동품 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>골동품 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.stolen" 0 1 autocheck>> 장물 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>장물 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.market" 0 1 autocheck>> 시장 가판대 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>시장 가판대 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.aphrodisiacPhials" 0 1 autocheck>> 최음제 약병 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>최음제 약병 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$historyTraitBuffs.improvedChances" 0 1 autocheck>> Enable Antique Chance Buff  <mouse class = "tooltip linkBlue">(?)<span>The history trait raises the chance of finding antiques in certain locations.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">동물 변이 버프·너프</span>
				<br>
				<label>
					<<checkbox "$DoLPTFBuffs" 0 1 autocheck>> Enable Animal TF Buffs and Nerfs <mouse class = "tooltip linkBlue">(?)<span>Each animal TF gives its own buffs and nerfs to certain stats and skills.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$DoLPTFTempTolerance" 0 1 autocheck>> Enable Animal TF Temperature Tolerance <mouse class = "tooltip linkBlue">(?)<span>Each animal TF has its own temperature tolerance.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Gameplay Rebalances</span>
				<br>
				<label>
					<<checkbox "$substanceRebalance" 0 1 autocheck>> 기본 게임 약물 재조정 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 술, 환각제, 최음제의 효과가 꽤 아쉽습니다. 이 설정은 그 효과를 재조정하고 확장합니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$dancingRebalance" 0 1 autocheck>> 춤 재조정 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 춤으로 안전하게 수익을 유지하며 꾸려 가기가 꽤 어렵고 골치 아픕니다. 이 재조정은 스킬이 충분히 높다면 춤을 주 수입원으로 삼아도 될 만큼 현실성 있게 만들려는 것입니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$foodSpoilage" 0 1 autocheck>> Enable Food Spoilage  <mouse class = "tooltip linkBlue">(?)<span>Cooked food ages naturally. When enabled, food past its date is thrown away. When disabled, food stays stored after that date, but old servings lose all stat effects and only fill you up.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">수확량 <mouse class = "tooltip linkBlue">(?)<span>우유병, 송로버섯, 달걀.</span></mouse></span>
				<div class="small-description">수확물의 양을 조정합니다. 100%는 밭 수확량 500%를 기준으로 균형이 맞춰져 있습니다.
					<<numberslider "$produce_yield_factor" $produce_yield_factor 10 200 10>>
				</div>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Combat Stress Gain <mouse class = "tooltip linkBlue">(?)<span>Stress from being molested, raped or made to submit during non-consensual encounters. Other stress sources are unchanged.</span></mouse></span>
				<div class="small-description">Scales stress from non-consensual combat. Useful with longer encounters or higher NPC lust.
					<<numberslider "$combatStressGain" $combatStressGain 25 150 5>>
				</div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "rebalanceGrindSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				반복 작업 설정
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$easyHousekeeping" 0 1 autocheck>> 쉬운 가사 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 가사 행동마다 상한이 있어서 그 이상은 가사 스킬이 오르지 않습니다. 이 설정을 활성화하면 상한이 사라져 항상 가사 스킬이 오릅니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<label>
					<<checkbox "$danceSkillDecay" 0 1 autocheck>> Enable Dancing Skill Maintenance <mouse class = "tooltip linkBlue">(?)<span>Your dancing skill decays a little at the end of a week if you did not attend enough practices. Higher grades need more weekly practices.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">능력치 상승 배율</span>
				<br>
				<div class="small-description"><mouse class="tooltip red">능력치 상승<span>능력치 상승 배율을 100 초과로 둔 채로 두면 해당 세이브 파일에서 업적을 얻을 수 없습니다.</span></mouse> 배율. 100%는 평소와 같은 상승량을 뜻합니다.
					<<numberslider "$statGainMult" $statGainMult 10 1000 10>>
				</div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Gentleman's Club Income</span>
				<div class="small-description">Blackmail quest reward <mouse class="tooltip linkBlue">(?)<span>Controls how much the Gentleman's Club pays for completed blackmail quests. This is a percentage of the normal reward. Set it to 0% if you want the quests to pay nothing.</span></mouse>: <<numberslider "$settings.inflationBlackmailRewardPct" $settings.inflationBlackmailRewardPct 0 100 5 { value: v => v + "%" }>></div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "npcDoLPSettings">>
	<<if _npcDoLPTab is undefined>><<set _npcDoLPTab to "behaviour">><</if>>
	<hr>
	<div id="npcDoLPTabs" class="no-numberify"><<npcDoLPTabButtons>></div>
	<div id="npcDoLPTabContent"><<npcDoLPTabContent>></div>
<</widget>>

<<widget "npcDoLPTabButtons">>
	<div class="containerStart">
		<<npcDoLPTabButton "Arousal &amp; Multipliers" "behaviour">>
		<<npcDoLPTabButton "Theft &amp; Generation" "flavour">>
		<<npcDoLPTabButton "Wraith &amp; World Override" "world">>
	</div>
<</widget>>

<<widget "npcDoLPTabButton">>
	<div @class="_npcDoLPTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _npcDoLPTab to _args[1]>>
			<<replace #npcDoLPTabs>><<npcDoLPTabButtons>><</replace>>
			<<replace #npcDoLPTabContent>><<npcDoLPTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "npcDoLPTabContent">>
	<<switch _npcDoLPTab>>
		<<case "flavour">><<npcDoLPFlavourSettings>>
		<<case "world">><<npcDoLPWorldSettings>>
		<<default>><<npcDoLPBehaviourSettings>>
	<</switch>>
<</widget>>

<<widget "npcDoLPBehaviourSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 다중 오르가슴
			</div>

			<div class="settingsToggleItem">
				<label>
					<<checkbox "$multiOrgasmToggle" 0 1 autocheck>> Enable NPC multi-orgasm <mouse class = "tooltip linkBlue">(?)<span>Generic NPCs will be able to orgasm multiple times if they have the multi-orgasmic trait.</span></mouse>
				</label>
				<span data-target="multiOrgasmToggle" data-disabledif="V.multiOrgasmToggle===0">
					<br>Applies to:<mouse class = "tooltip linkBlue">(?)<span>Restricts which generic NPCs can be multi-orgasmic, by sex.</span></mouse><br>
					<label><<radiobutton "$multiOrgasmGender" "all" autocheck>> Everyone</label> |
					<label><<radiobutton "$multiOrgasmGender" "f" autocheck>> Women only</label> |
					<label><<radiobutton "$multiOrgasmGender" "m" autocheck>> Men only</label>
					<br>Chance per NPC:<mouse class = "tooltip linkBlue">(?)<span>Chance that a generic NPC is multi-orgasmic. Those NPCs orgasm at least twice, and higher-level ones can go more times.</span></mouse><br>
					<<numberslider "$multiOrgasmChance" $multiOrgasmChance 0 100 1>>
				</span>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$NNPCMultiOrgasmToggle" 0 1 autocheck>> 네임드 NPC 다중 오르가슴 활성화 <mouse class = "tooltip linkBlue">(?)<span>네임드 NPC가 여러 번 오르가슴에 도달할 수 있습니다.</span></mouse>
				</label>
				<span data-target="NNPCMultiOrgasmToggle" data-disabledif="V.NNPCMultiOrgasmToggle===0">
					<br>Applies to:<mouse class = "tooltip linkBlue">(?)<span>Restricts which named NPCs can be multi-orgasmic, by sex.</span></mouse><br>
					<label><<radiobutton "$NNPCMultiOrgasmGender" "all" autocheck>> Everyone</label> |
					<label><<radiobutton "$NNPCMultiOrgasmGender" "f" autocheck>> Women only</label> |
					<label><<radiobutton "$NNPCMultiOrgasmGender" "m" autocheck>> Men only</label>
				</span>
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$multiOrgasmLustScaling" 0 1 autocheck>> 네임드 NPC 욕정 스케일링 활성화 <mouse class = "tooltip linkBlue">(?)<span>네임드 NPC는 욕정 20마다 최대 오르가슴 횟수가 +1 오릅니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$multiOrgasmGroupDisable" 0 1 autocheck>> Disable multi-orgasms in group encounters <mouse class = "tooltip linkBlue">(?)<span>Simultaneous encounters that start with more than one NPC can only end in one group orgasm. Solo encounters and sequential beast encounters still use the NPC, NNPC and beast multi-orgasm settings.</span></mouse>
				</label>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				네임드 NPC 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">네임드 NPC 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$nnpcHealthMult" $nnpcHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">네임드 NPC 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$nnpcArousalMult" $nnpcArousalMult>>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>인간 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$npcHealthMult" $npcHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>인간 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$npcArousalMult" $npcArousalMult>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "npcDoLPFlavourSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 금품 갈취 설정
			</div>

			<div class="settingsToggleItem">
				<<checkbox "$npcStealMoneyToggle" 0 1 autocheck>> NPC의 금품 갈취 활성화.
				<mouse class="tooltip linkBlue">(?)<span>Cash and card theft share the existing encounter rules. Calm love interests cannot trigger it.</span></mouse>
			</div>

			<div class="settingsToggleItem">
				<<checkbox "$npcStealMoneyRandomToggle" 0 1 autocheck>> 갈취 비율을 무작위로 정합니다.
				<mouse class="tooltip linkBlue">(?)<span>Uses the minimum and maximum percentages below instead of the fixed amount.</span></mouse>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Fixed cash theft (%)
				<mouse class="tooltip linkBlue">(?)<span>Percentage of carried cash. Savings and fixed-term deposits are not cash.</span></mouse>
				</span>
				<<numberslider "$npcStealMoneyPercentage" $npcStealMoneyPercentage 1 100 1>>
			</div>
			<div class="settingsToggleItem">
				프리셋:
				<<link "Easy">><<run setup.hbsc.setTheftPreset("easy")>><<displayDoLP "npcDoLPSettings">><</link>> |
				<<link "Normal">><<run setup.hbsc.setTheftPreset("normal")>><<displayDoLP "npcDoLPSettings">><</link>> |
				<<link "Hard">><<run setup.hbsc.setTheftPreset("hard")>><<displayDoLP "npcDoLPSettings">><</link>>
				<br>Normal: 1-25% cash, 5% card theft chance, &pound;100 weekly card limit.
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Minimum random cash theft (%)</span>
				<<numberslider "$npcStealMoneyMin" $npcStealMoneyMin 1 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Maximum random cash theft (%)</span>
				<<numberslider "$npcStealMoneyMax" $npcStealMoneyMax 1 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Card theft chance per robbery (%)</span>
				<<numberslider "$npcStealCardChance" $npcStealCardChance 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">Stolen card weekly limit (&pound;)</span>
				<<numberslider "$npcStealCardWeeklyLimit" $npcStealCardWeeklyLimit 0 1000 1>>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 분위기 생성 설정
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 묘사 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 묘사가 레벨에 묶여 있어서 레벨 스케일링이 매우 높으면 모든 NPC가 악마로 나타날 수 있습니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcDescGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcDescGenType" "randomized" autocheck>></label>
				<br>
				<<checkbox "$npcDescDemonDisable" 0 1 autocheck>> 악마 묘사 비활성화.
				<mouse class="tooltip linkBlue">(?)<span>악마와 하급 악마 묘사가 나오지 않게 합니다.</span></mouse>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 가슴 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 가슴 크기가 레벨에 묶여 있어서 레벨 스케일링이 매우 높으면 모든 NPC의 가슴이 거대해질 수 있습니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcBreastGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcBreastGenType" "randomized" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 자지 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 레벨 19-20의 NPC는 자지가 반드시 최대 크기입니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcPenisGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcPenisGenType" "randomized" autocheck>></label>
				<br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "npcDoLPWorldSettings">>
	<<wliSettings>>
	<<worldGenderOverrideSettings>>
<</widget>>


<<widget "beastDoLPSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 다중 오르가슴
			</div>

			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$beastMultiOrgasmToggle" 0 1 autocheck>> 짐승 다중 오르가슴 활성화 <mouse class = "tooltip linkBlue">(?)<span>짐승이 여러 번 오르가슴에 도달할 수 있습니다.</span></mouse>
				</label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 단체
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$beastGroupFight" 0 1 autocheck>> 짐승 단체 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 여러 짐승과의 조우가 단체 성교와 같은 방식으로 진행됩니다.</span></mouse>
				</label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">짐승 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>짐승 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$beastHealthMult" $beastHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">짐승 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>짐승 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$beastArousalMult" $beastArousalMult>>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				촉수 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">촉수 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>촉수 하나하나의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$tentacleHealthMult" $tentacleHealthMult>>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				발버둥(럴커, 벌 등) 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">발버둥 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>발버둥 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$struggleHealthMult" $struggleHealthMult>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "xchangeSettings">>
	<<if _xchangeTab is undefined>><<set _xchangeTab to "core">><</if>>
	<hr>
	<div id="xchangeTabs" class="no-numberify"><<xchangeTabButtons>></div>
	<div id="xchangeTabContent"><<xchangeTabContent>></div>
<</widget>>

<<widget "xchangeTabButtons">>
	<div class="containerStart">
		<<xchangeTabButton "Core Settings" "core">>
		<<xchangeTabButton "Spiking Preferences" "spiking">>
		<<xchangeTabButton "Sexflipped Appearance" "appearance">>
		<<xchangeTabButton "Pill Effects" "effects">>
	</div>
<</widget>>

<<widget "xchangeTabButton">>
	<div @class="_xchangeTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _xchangeTab to _args[1]>>
			<<replace #xchangeTabs>><<xchangeTabButtons>><</replace>>
			<<replace #xchangeTabContent>><<xchangeTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "xchangeTabContent">>
	<<switch _xchangeTab>>
		<<case "spiking">><<xchangeSpikingSettings>>
		<<case "appearance">><<xchangeAppearanceSettings>>
		<<case "effects">><<xchangeEffectSettings>>
		<<default>><<xchangeCoreSettings>>
	<</switch>>
<</widget>>

<<widget "xchangeCoreSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">

			<div class="settingsToggleItem">
				<span class="gold bold">Pill Behaviour:</span><br>
				<label><<checkbox "$xchange.pillPermanence" 0 1 autocheck>> Enable pill permanence</label> <mouse class="tooltip linkBlue">(?)<span>If disabled, pill mechanics no longer result in permanence. Instead, they result in large increases in duration or pauses in the pill timer.</span></mouse><br>
				<label><<checkbox "$xchangeStatSplit" false true autocheck>> Enable lewd stat split</label> <mouse class="tooltip linkBlue">(?)<span>If enabled, lewd stats (Promiscuity, Exhibitionism, Deviancy) are tracked separately for each body. A new body starts with its own lewd stats, and switching back to a previous body restores that body's values. The stats are never merged.</span></mouse><br>
				<label><<checkbox "$xchange.grayPillGenderflip" 0 1 autocheck>> Gray pills also flip your sex</label> <mouse class="tooltip linkBlue">(?)<span>Gray X-Change pills normally add only their special effect, without changing your body. If this setting is enabled, taking a gray pill while not already transformed will also swap your genitals, then apply the effect to that changed body.</span></mouse><br>
				<label><<checkbox "$xchange.bodyAdjustmentEnabled" 0 1 autocheck>> Adjustment period after changing bodies</label> <mouse class="tooltip linkBlue">(?)<span>After a pill changes your body, or your body changes back, physique, athletics, swimming, dancing and skulduggery are lower until you get used to it. The longer you lived in the body you left, the bigger the drop and the longer it takes to wear off. Less than two days in a body causes none. Two months or more causes a 30% drop that fades over two weeks.</span></mouse><br>
				<label><<checkbox "$xchange.npcPillChangesGender" 0 1 autocheck>> Pills also change NPC gender</label> <mouse class="tooltip linkBlue">(?)<span>When enabled, genderswap pills change both an NPC's sex and gender, including their pronouns and descriptions. When disabled, only their physical sex changes. Applies to random and Named NPCs.</span></mouse><br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">Spiking Rules:</span><br>
				<label><<checkbox "$xchange.nonconEnabled" 0 1 autocheck>> Enable non-con pill spiking </label> <mouse class="tooltip linkBlue">(?)<span>Allows NPCs to spike with X-Change pills without explicit consent. Note: this setting does not affect Named NPCs.</span></mouse><br>
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikeSideEffectsEnabled" 0 1 autocheck>> Suspicious pills have side effects</label> <mouse class="tooltip linkBlue">(?)<span>When enabled, any spiked pill also triggers an additional side effect. This applies to bar, combat, and other spike sources. Disable for older behaviour, where spikes only apply the pill's normal effect.</span></mouse><br>
				<label><<checkbox "$xchange.disregardGender" 0 1 autocheck>> Ignore gender checks </label> <mouse class="tooltip linkBlue">(?)<span>Some pill scenes normally require the PC to be a specific gender. This setting removes that requirement. If a scene normally requires the PC and NPC to be the same gender, there is instead a 25% chance that the pill will be used.<br><br>Avery will only force pills during dates when this setting is enabled. The choice pill when moving into Avery's mansion is not affected.</span></mouse><br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">Appearance:</span><br>
				<label><<checkbox "$xchange.faceChangesEnabled" 0 1 autocheck>> Enable face changes for pills </label> <mouse class="tooltip linkBlue">(?)<span>If enabled, your PC's face style may change upon genderswapping for the first time. This setting is mostly provided for players that use graphics mods and don't want to be messing around with files more than necessary.</span></mouse><br>

				<label><<checkbox "$xchange.useHermBalls" 0 1 autocheck>> Purple pillers have testes</label> <mouse class="tooltip linkBlue">(?)<span>When you take a pill that turns you herm, this toggle determines whether you'll be given testicles or not.</span></mouse><br>

				<label><<checkbox "$xchange.chastityKeepBeltShape" 0 1 autocheck>> Keep chastity belt shape on sex change</label> <mouse class="tooltip linkBlue">(?)<span>If enabled, a chastity belt stays a belt when your body becomes male instead of reshaping into a cage. A belt locks a male body just fine, so this keeps the device you originally chose. Disable for the old behaviour, where becoming male turns a belt into a cage. Note: a cage always reshapes into a belt when you gain a vagina, since a cage can't enclose one, and turns back into a cage when you lose it.</span></mouse><br>

				<br>
				<<run setup.xChangeEnsureBodySizeSettings?.()>>
				<div class="xchangeBodySizeLimits">
					<span class="gold bold">Sexflipped Body Size Limits:</span> <mouse class="tooltip linkBlue">(?)<span>The size range a body given to you by a pill is generated in. With this off, X-Change bodies use your own Body Part Size Limits instead.<br><br>Your current body keeps the size it already has. The change shows up the next time a pill builds or brings back a body.<br><br>Pills that grow a part still add their growth on top of whatever size these limits produced.</span></mouse>
					<br>
					<label><span>Use separate limits for X-Change bodies</span> <<checkbox "$xchange.bodySizeLimitsEnabled" 0 1 autocheck>></label>
					<div data-target="xchange.bodySizeLimitsEnabled" data-disabledif="!V.xchange.bodySizeLimitsEnabled">
					<span class="gold">Breast Size Limits:</span>
					<<rangeslider "$xchange.bodyBreastSizeMin" "$xchange.bodyBreastSizeMax" $xchange.bodyBreastSizeMin $xchange.bodyBreastSizeMax 0 12 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 12, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 12, 0));
								var name = ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					<br>
					<span class="gold">Ass Size Limits:</span>
					<<rangeslider "$xchange.bodyBottomSizeMin" "$xchange.bodyBottomSizeMax" $xchange.bodyBottomSizeMin $xchange.bodyBottomSizeMax 0 8 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 8, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 8, 0));
								var name = ["납작한", "아담한", "둥근", "부드러운", "통통한", "꽉 찬", "풍만한", "큰", "거대한"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					<br>
					<span class="gold">Penis Size Limits:</span>
					<<rangeslider "$xchange.bodyPenisSizeMin" "$xchange.bodyPenisSizeMax" $xchange.bodyPenisSizeMin $xchange.bodyPenisSizeMax 0 6 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 6, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 6, 0));
								var name = ["Micro", "Mini", "Tiny", "Small", "Normal", "Large", "Enormous"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					</div>
				</div>

				<<set _xchangeActiveHermMismatch to playerIsXChanged() and $xchange.pill and $xchange.pill.hermEffect and (!$player.penisExist or !$player.vaginaExist or !["m", "f"].includes($player.sex))>>
				<<set _xchangeStoredOriginalSexMismatch to false>>
				<<set _xchangeStoredOriginalSexCanApply to false>>
				<<if playerIsXChanged() and $xchange.pill and $xchange.pill.originalBody and ($xchange.pill.originalBody.sex is undefined or !["m", "f"].includes($xchange.pill.originalBody.sex))>>
					<<set _xchangeStoredOriginalSexMismatch to true>>
					<<set _xchangeStoredOriginalSexCanApply to ($xchange.pill.originalBody.penisExist is true and $xchange.pill.originalBody.vaginaExist isnot true) or ($xchange.pill.originalBody.vaginaExist is true and $xchange.pill.originalBody.penisExist isnot true)>>
				<</if>>
				<<set _xchangeOldSaveGenitalMismatchNPC to []>>
				<<for _xchangeOldSaveNPCIndex to 0; _xchangeOldSaveNPCIndex lt $NPCName.length; _xchangeOldSaveNPCIndex++>>
					<<set _xchangeOldSaveNPC to $NPCName[_xchangeOldSaveNPCIndex]>>
					/* Poppy can retain a legacy fetus array after migration. Neither pregnancy model may contain an active pregnancy before offering anatomy recovery. */
					<<if $passage isnot "Start" and _xchangeOldSaveNPC and _xchangeOldSaveNPC.pregnancy and _xchangeOldSaveNPC.pregnancy.enabled isnot undefined and Array.isArray(_xchangeOldSaveNPC.pregnancy.fetus) and !_xchangeOldSaveNPC.pregnancy.fetus.length and !getActivePregnancies(_xchangeOldSaveNPC.nam).length>>
						<<if _xchangeOldSaveNPC.gender is "f" and (_xchangeOldSaveNPC.vagina is undefined or _xchangeOldSaveNPC.vagina is "none" or _xchangeOldSaveNPC.penis isnot "none")>>
							<<set _xchangeOldSaveGenitalMismatchNPC.push(_xchangeOldSaveNPCIndex)>>
						<<elseif _xchangeOldSaveNPC.gender is "m" and (_xchangeOldSaveNPC.penis is undefined or _xchangeOldSaveNPC.penis is "none" or _xchangeOldSaveNPC.vagina isnot "none")>>
							<<set _xchangeOldSaveGenitalMismatchNPC.push(_xchangeOldSaveNPCIndex)>>
						<</if>>
					<</if>>
				<</for>>
				<<if _xchangeActiveHermMismatch or _xchangeStoredOriginalSexMismatch or _xchangeOldSaveGenitalMismatchNPC.length>>
					<br>
					<span class="gold bold">Old-save recovery:</span><br>
					<<if _xchangeActiveHermMismatch>>
						<span class="red">Active Herm X-Change genital mismatch detected.</span>
						<<link "Apply active Herm genitals">>
							<<set $player.sex to "m">>
							<<set $player.penisExist to true>>
							<<set $player.vaginaExist to true>>
							<<set $player.ballsExist to $xchange.useHermBalls eq 1>>
							<<updatesidebarimg>>
							<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
						<</link>><br>
					<</if>>
					<<if _xchangeStoredOriginalSexMismatch>>
						<span class="red">Stored pre-pill X-Change sex is invalid.</span>
						<<if _xchangeStoredOriginalSexCanApply>>
							<<link "Apply stored pre-pill sex from saved genitals">>
								<<if $xchange.pill.originalBody.penisExist is true and $xchange.pill.originalBody.vaginaExist isnot true>>
									<<set $xchange.pill.originalBody.sex to "m">>
									<<set $xchange.pill.baseSex to "m">>
								<<elseif $xchange.pill.originalBody.vaginaExist is true and $xchange.pill.originalBody.penisExist isnot true>>
									<<set $xchange.pill.originalBody.sex to "f">>
									<<set $xchange.pill.baseSex to "f">>
								<</if>>
								<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
							<</link>>
						<<else>>
							The saved pre-pill body does not say whether its base sex was male or female. Export this save and report it.
						<</if>><br>
					<</if>>
					<<if _xchangeOldSaveGenitalMismatchNPC.length>>
						<span class="red">NPC genital mismatch detected for <<= _xchangeOldSaveGenitalMismatchNPC.map(npcIndex => $NPCName[npcIndex].nam).join(", ") >>.</span>
						<<capture _xchangeOldSaveGenitalMismatchNPC>>
							<<link "Apply selected genitals to these NPCs">>
								<<for _xchangeOldSaveNPCIndex range _xchangeOldSaveGenitalMismatchNPC>>
									<<set _xchangeOldSaveNPC to $NPCName[_xchangeOldSaveNPCIndex]>>
									<<if _xchangeOldSaveNPC.gender is "f">>
										<<set _xchangeOldSaveNPC.vagina to (_xchangeOldSaveNPC.type isnot "human" ? 0 : "clothed")>>
										<<set _xchangeOldSaveNPC.penis to "none">>
									<<elseif _xchangeOldSaveNPC.gender is "m">>
										<<set _xchangeOldSaveNPC.penis to (_xchangeOldSaveNPC.type isnot "human" ? 0 : "clothed")>>
										<<set _xchangeOldSaveNPC.vagina to "none">>
									<</if>>
								<</for>>
								<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
							<</link>>
						<</capture>>
					<</if>>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">Combat Pilling:</span><br>
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.combatPillingEnabled" 0 1 autocheck>> Enable combat pilling</label> <mouse class="tooltip linkBlue">(?)<span>NPCs may attempt to pill you during non-consensual encounters.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.restrictedSexCombatPilling" 0 1 autocheck>> Restrict combat pills to same sex NPCs</label> <mouse class="tooltip linkBlue">(?)<span>Only NPCs whose sex matches your original sex will attempt to pill you during non-consensual encounters. Meaning, if your original sex is male, only males will attempt to pill you.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.NNPCcombatPillingEnabled" 0 1 autocheck>> Allow NNPC noncon combat pilling</label> <mouse class="tooltip linkBlue">(?)<span>NNPCs are allowed to pill you during encounters.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.combatPillingIfPilled" 0 1 autocheck>> Allow combat pills if already pilled</label> <mouse class="tooltip linkBlue">(?)<span>NPCs are allowed to stack more effects on top of your current pill.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.combatPillingBeastsEnabled" 0 1 autocheck>> Allow beasts to carry combat pills</label> <mouse class="tooltip linkBlue">(?)<span>If enabled, any beast-type enemy, monster people included, may carry X-Change pills during encounters. Turn this off and use the option below to limit it to monster people only.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled", "xchange.combatPillingBeastsEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled || !!V.xchange.combatPillingBeastsEnabled"><<checkbox "$xchange.combatPillingMonsterPeopleEnabled" 0 1 autocheck>> Allow monster people to carry combat pills</label> <mouse class="tooltip linkBlue">(?)<span>If enabled, monster people may carry X-Change pills during encounters even when ordinary beasts can't. Has no effect unless beasts are being replaced with monster people.</span></mouse><br>

				<label><<checkbox "$whackRandom" false true autocheck>> Whack actions can fail</label> <mouse class="tooltip linkBlue">(?)<span>Attempts to whack away tools and pills from NPCs' hands can fail due to high arousal and low willpower.</span></mouse><br>
				<br>
				<span class="gold bold">Combat Tuning:</span><br>
				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>NPC pill chance:</span><mouse class="tooltip linkBlue">(?)<span>Chance for each eligible NPC to carry an X-Change pill. Rolled once per NPC when an encounter starts. At 0%, no NPCs carry pills. At 100%, every eligible NPC carries one.</span></mouse>
					<<numberslider "$xchange.combatPillingChance" $xchange.combatPillingChance 0 100 5>>
				</label><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>Use chance per turn:</span><mouse class="tooltip linkBlue">(?)<span>When an NPC has a pill, this is the chance they use it each valid combat turn. Higher values make them use it sooner.</span></mouse>
					<<numberslider "$xchange.combatPillingDrawChance" $xchange.combatPillingDrawChance 1 50 1>>
				</label><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>Clean pill ratio:</span> <mouse class="tooltip linkBlue">(?)<span>Chance that a combat pill has no random extras or side effects. Failed rolls become Suspicious pills.</span></mouse>
					<<numberslider "$xchange.combatPillingPureRatio" $xchange.combatPillingPureRatio 0 100 5>>
				</label>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeSpikingSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="small-description">Select the checkboxes to enable or disable each of the respective pill effects, and use the slide bar to tweak the relative frequency on which the respective effect will be featured during a spike.</span>

			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.herm" 0 1 autocheck>> <span>Purple (Herm):</span></label> <mouse class="tooltip linkBlue">(?)<span>Grants you a mix of the features from both of your sexes, in addition to giving you both sets of genitals.</span></mouse>
				<<numberslider "$xchange.spikerates.herm" $xchange.spikerates.herm 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.crossdresser" 0 1 autocheck>> <span>Sissy / Butch:</span></label> <mouse class="tooltip linkBlue">(?)<span>Makes you look like the opposite sex without fully switching you. Incentivises crossdressing through harsher stress penalties.</span></mouse>
				<<numberslider "$xchange.spikerates.crossdress" $xchange.spikerates.crossdress 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.bull" 0 1 autocheck>> <span>Bull:</span></label> <mouse class="tooltip linkBlue">(?)<span>Makes you exceptionally virile. Almost guarantees impregnation.</span></mouse>
				<<numberslider "$xchange.spikerates.bull" $xchange.spikerates.bull 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.breeder" 0 1 autocheck>> <span>Breeder:</span></label> <mouse class="tooltip linkBlue">(?)<span>Prevents you from orgasming unless there's sperm in your vagina. Getting creampied feels really good. Lowers stress while there's sperm in vagina. Fertility almost guarantees pregnancy. <b>Only works while you have a womb and vagina.</b></span></mouse>
				<<numberslider "$xchange.spikerates.breeder" $xchange.spikerates.breeder 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.resistance" 0 1 autocheck>> <span>Resistance:</span></label> <mouse class="tooltip linkBlue">(?)<span>Every orgasm increases the likelihood the pill becomes permanent (or lasts a whole month if permanence is off). Mutually exclusive with Continue effect.</span></mouse>
				<<numberslider "$xchange.spikerates.resistance" $xchange.spikerates.resistance 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.continue" 0 1 autocheck>> <span>Continue:</span></label> <mouse class="tooltip linkBlue">(?)<span>Every orgasm extends the duration of the pill. Mutually exclusive with Resistance effect.</span></mouse>
				<<numberslider "$xchange.spikerates.continue" $xchange.spikerates.continue 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.passion" 0 1 autocheck>> <span>Passion:</span></label> <mouse class="tooltip linkBlue">(?)<span>Injects aphrodisiacs into your bloodstream randomly every hour.</span></mouse>
				<<numberslider "$xchange.spikerates.passion" $xchange.spikerates.passion 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$portalPantiesEnabled" 0 1 autocheck>> <span>Portal:</span></label> <mouse class="tooltip linkBlue">(?)<span>Adds a special pill effect to the spiking pool. When applied, this effect allows random NPCs to fuck you at semi-random intervals, remotely, stealthily, and regardless of context. <br><br><b>BE WARNED:</b> May result in loss of virginity and/or pregnancy with no way to counter or avoid it.</span></mouse>
				<<numberslider "$xchange.spikerates.portal" $xchange.spikerates.portal 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.dumbbitch" 0 1 autocheck>> <span>Dumb Bitch:</span></label> <mouse class="tooltip linkBlue">(?)<span>Each orgasm worsens your academic performance, then your sense of malice (skulduggery) and willpower. Finally, when little of that remains, you gain sexual compulsions.</span></mouse>
				<<numberslider "$xchange.spikerates['dumb-bitch']" $xchange.spikerates['dumb-bitch'] 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.innocence" 0 1 autocheck>> <span>Innocence:</span></label> <mouse class="tooltip linkBlue">(?)<span>While under this pill, all sexual awareness is wiped from your mind.</span></mouse>
				<<numberslider "$xchange.spikerates.innocence" $xchange.spikerates.innocence 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.feartoxin" 0 1 autocheck>> <span>Fear Toxin:</span></label> <mouse class="tooltip linkBlue">(?)<span>Keeps your trauma at maximum and self-control at zero while active. When it ends, neither stat is restored, so long doses can leave you insane. Never rolls alongside Innocence.</span></mouse>
				<<numberslider "$xchange.spikerates.feartoxin" $xchange.spikerates.feartoxin 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.swell" 0 1 autocheck>> Swell</label> <mouse class="tooltip linkBlue">(?)<span>Increases the size of your breasts and ass (Pink) or penis (Blue) for the duration.</span></mouse>
				<<numberslider "$xchange.spikerates.swell" $xchange.spikerates.swell 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.bimbo" 0 1 autocheck>> Bimbo</label> <mouse class="tooltip linkBlue">(?)<span>Decreases your intelligence, increases your lewdness, and applies the Bimbo pill's built-in Swell effect.</span></mouse>
				<<numberslider "$xchange.spikerates.bimbo" $xchange.spikerates.bimbo 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.cumcure" 0 1 autocheck>> CumCure</label> <mouse class="tooltip linkBlue">(?)<span>Reduces the duration of your transformation every time cum is deposited inside you.</span></mouse><br>
				<<numberslider "$xchange.spikerates.cumcure" $xchange.spikerates.cumcure 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.fertility" 0 1 autocheck>> Hyper Fertility</label>	<mouse class="tooltip linkBlue">(?)<span>Speeds up pregnancy and increases the chance of twins, triplets or quadruplets. Affects both pregnancies you carry and pregnancies you cause. Also speeds up parasite and non-humanoid pregnancies.</span></mouse><br>
				<<numberslider "$xchange.spikerates.fertility" $xchange.spikerates.fertility 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.omega" 0 1 autocheck>> Omega</label> <mouse class="tooltip linkBlue">(?)<span>Applies the Omega agent: anal pregnancy compatibility and heightened pleasure during anal insemination. Works on any body.</span></mouse><br>
				<<numberslider "$xchange.spikerates.omega" $xchange.spikerates.omega 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.alpha" 0 1 autocheck>> Alpha</label> <mouse class="tooltip linkBlue">(?)<span>Applies the Alpha agent: a knotted penis and an urge to be buried inside a partner before release. <b>Only rolls while you have a penis.</b></span></mouse><br>
				<<numberslider "$xchange.spikerates.alpha" $xchange.spikerates.alpha 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.beta" 0 1 autocheck>> Beta</label> <mouse class="tooltip linkBlue">(?)<span>Applies the Beta agent: a second womb capable of carrying an independent pregnancy. <b>Only rolls while you have a vagina.</b></span></mouse><br>
				<<numberslider "$xchange.spikerates.beta" $xchange.spikerates.beta 1 10 1>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeAppearanceSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">Sexflipped Eye Colour:</span><br>
				<label><span>Same as before</span> <<radiobutton "$xchange.customisedEyeColour" "nochange" autocheck>></label> |
				<label><span class="black">Black</span> <<radiobutton "$xchange.customisedEyeColour" "black" autocheck>></label> |
				<label><span class="purple">Purple</span> <<radiobutton "$xchange.customisedEyeColour" "purple" autocheck>></label> |
				<label><span class="blue">Dark Blue</span> <<radiobutton "$xchange.customisedEyeColour" "dark blue" autocheck>></label> |
				<label><span class="lblue">Light Blue</span> <<radiobutton "$xchange.customisedEyeColour" "light blue" autocheck>></label> |
				<label><span class="tangerine">Amber</span> <<radiobutton "$xchange.customisedEyeColour" "amber" autocheck>></label> |
				<label><span class="brown">Hazel</span> <<radiobutton "$xchange.customisedEyeColour" "hazel" autocheck>></label> |
				<label><span class="green">Green</span> <<radiobutton "$xchange.customisedEyeColour" "green" autocheck>></label> |
				<label><span class="lime-green">Lime Green</span> <<radiobutton "$xchange.customisedEyeColour" "lime green" autocheck>></label> |
				<label><span class="red">Red</span> <<radiobutton "$xchange.customisedEyeColour" "red" autocheck>></label> |
				<label><span class="pink">Pink</span> <<radiobutton "$xchange.customisedEyeColour" "pink" autocheck>></label> |
				<label><span class="grey">Grey</span> <<radiobutton "$xchange.customisedEyeColour" "grey" autocheck>></label> |
				<label><span class="light-grey">Light Grey</span> <<radiobutton "$xchange.customisedEyeColour" "light grey" autocheck>></label> |
				<label><span>Random</span> <<radiobutton "$xchange.customisedEyeColour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold bold">Sexflipped Hair Colour:</span><br>
				<label><span>Same as before</span> <<radiobutton "$xchange.customisedHairColour" "nochange" autocheck>></label> |
				<<for _i to 0; _i < setup.colours.hair.length; _i++>>
					<<if setup.colours.hair[_i].variable isnot "random" and (setup.colours.hair[_i].natural or setup.colours.hair[_i].dye)>>
						<label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiobutton "$xchange.customisedHairColour" setup.colours.hair[_i].variable autocheck>></label> |
					<</if>>
				<</for>>
				<label><span>Random</span> <<radiobutton "$xchange.customisedHairColour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold bold">Sexflipped Demeanour:</span> <mouse class="tooltip linkBlue">(?)<span>Changes how you speak with others while an X-Change pill has altered your body. Your original demeanour comes back when you return to your own body.</span></mouse><br>
				<label><span>Same as before</span> <<radiobutton "$xchange.customisedDemeanour" "nochange" autocheck>></label> |
				<label><span class="pink">Docile</span> <<radiobutton "$xchange.customisedDemeanour" "docile" autocheck>></label> |
				<label><span class="meek">Meek</span> <<radiobutton "$xchange.customisedDemeanour" "meek" autocheck>></label> |
				<label><span class="purple">Shy</span> <<radiobutton "$xchange.customisedDemeanour" "shy" autocheck>></label> |
				<label><span class="blue">Polite</span> <<radiobutton "$xchange.customisedDemeanour" "polite" autocheck>></label> |
				<label><span>Neutral</span> <<radiobutton "$xchange.customisedDemeanour" "neutral" autocheck>></label> |
				<label><span class="teal">Confident</span> <<radiobutton "$xchange.customisedDemeanour" "confident" autocheck>></label> |
				<label><span class="brat">Bratty</span> <<radiobutton "$xchange.customisedDemeanour" "bratty" autocheck>></label> |
				<label><span class="red">Cruel</span> <<radiobutton "$xchange.customisedDemeanour" "cruel" autocheck>></label> |
				<label><span class="pink">Flamboyant</span> <<radiobutton "$xchange.customisedDemeanour" "flamboyant" autocheck>></label> |
				<label><span class="gold">Special</span> <<radiobutton "$xchange.customisedDemeanour" "special" autocheck>></label> |
				<label><span class="lustful">Capricious</span> <<radiobutton "$xchange.customisedDemeanour" "capricious" autocheck>></label> |
				<label><span class="lustful">Fickle</span> <<radiobutton "$xchange.customisedDemeanour" "fickle" autocheck>></label> |
				<label><span>Random</span> <<radiobutton "$xchange.customisedDemeanour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItem">
				<<set _xchangeSkinShade to ["light", "medium", "dark", "gyaru"].find(shade => ($xchange?.customisedSkinColour || "").endsWith(shade))>>
				<<if _xchangeSkinShade>>
					<<set _xchangeSkinTone to $xchange.customisedSkinColour.slice(0, -_xchangeSkinShade.length)>>
				<<else>>
					<<set _xchangeSkinTone to "no">>
					<<set _xchangeSkinShade to "change">>
				<</if>>
				<span class="gold bold">Sexflipped Skin Tone:</span><br>
				<label>Same as before <<radiovar "_xchangeSkinTone" "no">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |<br>
				<label>Neutral <<radiovar "_xchangeSkinTone" "">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>Warm <<radiovar "_xchangeSkinTone" "r">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>Golden <<radiovar "_xchangeSkinTone" "g">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>Olive <<radiovar "_xchangeSkinTone" "y">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>Cool <<radiovar "_xchangeSkinTone" "b">><<xchangeSkinColourVariableCombine>><</radiovar>></label>
				<br><br>
				<span class="gold bold">Sexflipped Skin Shade:</span><br>
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">Light <<radiovar "_xchangeSkinShade" "light">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">Medium <<radiovar "_xchangeSkinShade" "medium">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">Dark <<radiovar "_xchangeSkinShade" "dark">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">Gyaru <<radiovar "_xchangeSkinShade" "gyaru">><<xchangeSkinColourVariableCombine>><</radiovar>></label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Physique Changes: <mouse class="tooltip linkBlue">(?)<span>An override to the default X-Change behaviour. Normally, M2F shrinks you one size, and F2M grows you one size, but this setting overrides that behaviour.</span></mouse></span><br>

				<label>Default <<radiobutton "$xchange.sizeOverride" "default" autocheck>></label> |
				<label>Miniature <<radiobutton "$xchange.sizeOverride" "miniature" autocheck>></label> |
				<label>Tiny <<radiobutton "$xchange.sizeOverride" "tiny" autocheck>></label> |
				<label>Small <<radiobutton "$xchange.sizeOverride" "small" autocheck>></label> |
				<label>Normal <<radiobutton "$xchange.sizeOverride" "normal" autocheck>></label> |
				<label>Tall <<radiobutton "$xchange.sizeOverride" "tall" autocheck>></label> |
				<label>Large <<radiobutton "$xchange.sizeOverride" "large" autocheck>></label> |
				<label>Giant <<radiobutton "$xchange.sizeOverride" "giant" autocheck>></label>

				<br><br>

				<span>Transformation multiplier: (%)
				<mouse class="tooltip linkBlue">(?)<span>A multiplier applied to a character's x-changed physique on transformation, after the body size scaling has been applied.</span></mouse>
				</span>
				<<numberbox "$xchange.physiqueChangePercent" $xchange.physiqueChangePercent>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeEffectSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">Sensitivity Boost:</span>
				<span>Due to pill:
				<mouse class="tooltip linkBlue">(?)<span>X-Change Pills alter a body's sensitivity by this value for the duration of its effect. Pink pills increase sensitivity. Blue pills reduce it. HINT: use a negative value to invert this behaviour.</span></mouse>
				</span>
				<<numberbox "$xchange.pillSensitivityChange" $xchange.pillSensitivityChange>>
				<br>
				<span>Due to impurity:
				<mouse class="tooltip linkBlue">(?)<span>A scaling sensitivity bonus added to your body due to impurity while xchanged. Note: this bonus applies twofold for your genitals, but does not affect your mouth's sensitivity.</span></mouse>
				</span>
				<<numberbox "$xchange.impuritySensitivityBonus" $xchange.impuritySensitivityBonus>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">Resistance Settings:</span>
				<span>Odds Reduction Factor per Orgasm:
				<mouse class="tooltip linkBlue">(?)<span>By how much your odds of turning back get reduced when you orgasm under a Resistance effect. <br><br>For example: if value is set to 0.7, your first orgasm lowers odds to 100% * 0.7 = 70%, then the second orgasm lowers odds to 70% * 0.7 = 49%, a third to 49% * 0.7 = 34.3%, and so on. </span></mouse>
				</span>
				<<numberslider "$xchange.resistanceOrgasmPenalty" $xchange.resistanceOrgasmPenalty 0.5 0.99 0.01>>
				<br>
				<span>Pill-End Failure Penalty: (Days)
				<mouse class="tooltip linkBlue">(?)<span>The number of additional days of extended duration you'll be penalised with if you fail the check at the end of the pill's standard duration. Only applies if permanence is disabled.<br><br>Note: any value lower than 1 day will be interpreted as 1 day, you smarty-pants.</span></mouse>
				</span>
				<<numberbox "$xchange.resistanceDaysPenalty" $xchange.resistanceDaysPenalty>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Continue Settings:</span><br>
				<label><<checkbox "$xchange.continueDurationCapEnabled" false true autocheck>> Cap Continue duration</label> <mouse class="tooltip linkBlue">(?)<span>Stops Continue from extending a transformation past the Resistance Pill-End Failure Penalty, up to the normal 30-day limit. Once the cap is reached, Continue is removed and the transformation timer starts counting down normally. Fertile is added if your current body can become pregnant. Any time already above the cap is kept until your next climax. Permanent transformations stay permanent, but Continue will still be removed on your next climax.</span></mouse><br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">Portal Settings:</span>
				<span>Frequency: (%)
				<mouse class="tooltip linkBlue">(?)<span>A multiplier applied to the portal effect cooldown, that influences how often the portal penetration happens. Default value is 100%, which makes it occur as often a normal. 200% means twice as frequent.</span></mouse>
				</span>
				<<numberbox "$xchange.portalFrequency" $xchange.portalFrequency>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">CumCure Settings:</span>
				<span>CumCure time reduction factor:
				<mouse class="tooltip linkBlue">(?)<span>How many hours the duration of your pill is reduced when you take cum inside you.</span></mouse>
				</span>
				<<numberslider "$xchange.cumcureTime" $xchange.cumcureTime 1 24 1>>
				<br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Breeder Settings:</span><mouse class="tooltip linkBlue">(?)<span><b>Breeder only works if you have a womb and vagina.</b></span></mouse><br>
				<label><<checkbox "$xchange.breederFreeOrgasm" false true autocheck>> Allow orgasm without creampie</label>
				<mouse class="tooltip linkBlue">(?)<span>Normally, Breeder stops you from orgasming unless there is cum in your pussy. Enable this to allow orgasms without a creampie. Those orgasms feel hollow and cause stress. A real creampie still gives the stronger pleasure and stress relief.</span></mouse><br>
				<label><<checkbox "$xchange.breederInfertile" false true autocheck>> Breeder does not increase fertility</label>
				<mouse class="tooltip linkBlue">(?)<span>Enable this to keep Breeder's cravings, pleasure, and stress effects without making you more fertile. "Always fertile" and Hyper Fertility can still make you fertile.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Omega Settings:</span><mouse class="tooltip linkBlue">(?)<span><b>Omega</b> allows anal pregnancy.</span></mouse><br>
				<label><<checkbox "$xchange.omegaFreeOrgasm" false true autocheck>> Allow orgasm without being filled</label>
				<mouse class="tooltip linkBlue">(?)<span>Normally, Omega stops you from orgasming unless there is cum in the hole it targets. Enable this to allow orgasms anyway. Those orgasms feel hollow and cause stress. Getting filled still gives the stronger pleasure and stress relief.</span></mouse><br>
				<label><<checkbox "$xchange.omegaShrinkGenitals" 0 1 autocheck>> Pink Omega pill shrinks instead of changing sex</label>
				<mouse class="tooltip linkBlue">(?)<span>Only affects the <b>X-Change Pink Omega</b> pill. Instead of changing your sex, it shrinks masculine genitals like X-Change Sissy. Its anal pregnancy effect still works. Every other Pink or Blue pill still changes your sex, and Omega from spiking or Gray pills is not affected.</span></mouse><br>
				<label><<checkbox "$xchange.omegaNeedsNoVagina" 0 1 autocheck>> Only affect the ass without a vagina</label>
				<mouse class="tooltip linkBlue">(?)<span>When enabled, Omega only allows anal pregnancy if you have no vagina. If you have one, breeding uses the vagina instead.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Alpha Settings:</span><mouse class="tooltip linkBlue">(?)<span><b>Alpha</b> affects the penis.</span></mouse><br>
				<label><<checkbox "$xchange.alphaFreeOrgasm" false true autocheck>> Allow orgasm without knotting</label>
				<mouse class="tooltip linkBlue">(?)<span>Normally, Alpha stops you from orgasming unless your cock is inside something. Enable this to allow orgasms anyway. Those orgasms feel hollow and cause stress.</span></mouse><br>
				<label><<checkbox "$xchange.alphaGrowsPenis" 0 1 autocheck>> Grow a cock if you have none</label>
				<mouse class="tooltip linkBlue">(?)<span>Only matters when you get the Alpha effect without a cock, such as from spiking or a Gray pill while you have a pussy. With this on, you grow a temporary cock that disappears when the effect ends. With it off, Alpha does nothing until you have a cock. Blue and Herm Alpha pills already give you one, so this setting does not change them.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Shared Alpha/Beta/Omega Settings:</span><mouse class="tooltip linkBlue">(?)<span><b>Alpha</b> affects the penis, <b>Beta</b> gives a vaginal body two wombs, and <b>Omega</b> allows anal pregnancy.</span></mouse><br>
				<label><<checkbox "$xchange.aboDrivesHeat" 0 1 autocheck>> Alpha and Omega cause rut and heat</label>
				<mouse class="tooltip linkBlue">(?)<span>When enabled, Alpha can put you into rut and Omega can put you into heat through your fertility cycle.</span></mouse><br>
				<label><<checkbox "$xchange.pheromoneAllure" 0 1 autocheck>> Alpha, Beta, and Omega increase allure</label>
				<mouse class="tooltip linkBlue">(?)<span>When enabled, these pills increase allure while active. Alpha requires a cock, and Beta requires a vagina.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Fertility Settings:</span><br>
				<label><<checkbox "$xchange.postPermanenceFertilityReset" 0 1 autocheck>> Reset fertility to normal rate after permanence </label> <mouse class="tooltip linkBlue">(?)<span>Pills that have reduced fertility rates as part of their effects go back to normal fertility rates after the first pregnancy. Note: Pills that have breeder effects remain the same even after pregnancy.</span></mouse><br>
				<label><<checkbox "$xchange.alwaysFertile" false true autocheck>> Always fertile while X-Changed</label> <mouse class="tooltip linkBlue">(?)<span>While an X-Change pill is active, you can become pregnant at any time if you have a womb and vagina. This does not affect your normal body when no pill is active.</span></mouse><br>
				<span>Pilled chance modifier: (%)
					<mouse class="tooltip linkBlue">(?)<span>A multiplier applied to a character's base pregnancy/impregnation chance while pilled and fertile (for breeder and bull effects, different rates apply).</span></mouse>
				</span>
				<<numberbox "$xchange.pregnancyMultPercent" $xchange.pregnancyMultPercent>><br>
				<span>Fertility strength: (%)
					<mouse class="tooltip linkBlue">(?)<span>Controls how much Fertility and Hyper Fertility increase your chance of becoming pregnant. 100% is the normal strength. This does not affect pregnancy speed or the chance of twins or triplets.</span></mouse>
				</span>
				<<numberslider "$xchange.fertilityStrengthPercent" $xchange.fertilityStrengthPercent 25 400 25>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "loadAllFeats">>
	<div id="featsBeginLoadingText">
		몇 가지 기본 확인을 실행하는 중...
		<br>
	</div>
	<div id="featsBeginButton" class="hidden">
		<span id="featsBeginText"></span> "시작"을 클릭한 후에는 게임을 새로고침하지 마십시오. 그렇지 않으면 과정을 다시 실행해야 합니다.
		<br><br>
		내보낸 세이브는 먼저 불러와서 로컬 세이브로 만들지 않는 한 이 과정에서 제외됩니다.
		<br>
		<<link "시작">>
			<<replace "#startCaption">><</replace>>
			<<replace "#settingsStart">><<loadingAllFeats>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMergePre")})>>
	<br><br>
	<<link "취소">>
		<<replace "#settingsStart">><<settingsStart>><</replace>>
	<</link>>
<</widget>>

<<widget "loadingAllFeats">>
	<div id="featsLoadingMeter" class="meter">
		<div class="greenbar" style="width:0%"></div>
		<span id="featsLoadingText">_saveDataImportCount개의 세이브 중 0개 확인됨.</span>
	</div>
	<br><br>
	<div id="featsFinishButton" class="hidden">
		<<link "다음">>
			<<setupFeatBoosts true>>
			<<replace "#startCaption">><<startCaption>><</replace>>
			<<replace "#settingsStart">><<settingsStart>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMerge")})>>
<</widget>>

<<widget "skinToneRange">>
	<div class="skinToneRange" @style="'--skin-gradient: linear-gradient(to right, ' + setup.colours.skin_options.gyaru.gradient.join(', ') + ')'">
		<<for _handle range [["min", "Min", "가장 밝은"], ["mean", "Mode", "가장 흔한"], ["max", "Max", "가장 어두운"]]>>
			<<set _tone to $settings["skinTone" + _handle[1]]>>
			<input type="range" min="0" max="100" step="1" @data-skin="_handle[0]" @data-tip="_handle[2] + ' 피부 톤'" @value="_tone"
				@style="'--skin-thumb: ' + setup.colours.getSkinRgb(setup.colours.skin_options.gyaru, _tone / 100)">
		<</for>>
		<span class="skinToneTip"></span>
	</div>
<</widget>>

<<widget "npcSkinTone">>
	<<if $NPCName[_npcId].skinType is "ghost">>
		<span class="small-description">유령처럼 창백함.</span>
	<<elseif $NPCName[_npcId].skincolour isnot undefined and $NPCName[_npcId].skincolour isnot "none">>
		<<numberslider "$NPCName[_npcId].skincolour" $NPCName[_npcId].skincolour 0 100 1 {
			value: v => setup.colours.getSkinToneSwatch(v),
		}>>
		<<link "무작위">>
			<<initnpcskinsingle _npcId "skincolour">>
			<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
		<</link>>
	<<else>>
		<span class="small-description">게임이 시작될 때 무작위로 정해집니다.</span>
		<<link "톤 설정">>
			<<set $NPCName[_npcId].skincolour to Math.clamp($settings.skinToneMode, 0, 100)>>
			<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
		<</link>>
	<</if>>
<</widget>>

:: Settings [exitCheckBypass]
<<if $options.images is 1>>
	<span id="bannerStyle">
		<img class="resize" src="img/misc/banner.png">
	</span>
<</if>>
<<settings>>

:: Attitudes
<<attitudes>>
<<set $attitudesControl.showGoldLink to "false">>
<div class="settingsGrid">
	<<button [[확인|$attitudesExitPassage]]>>
		<<set $speech_attitude to $speech_attitude_special>>

		<<unset $attitudesExitPassage>>
		<<run DefaultActions.save(T.defaultActions)>>
		<<if $LIChanged>>
			<<unset $LIChanged>>
			<<set $stress += 2000>><<set $trauma += 600>>
		<</if>>
	<</button>>
</div>
<br>
