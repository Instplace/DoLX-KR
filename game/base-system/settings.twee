					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyLevelDefeatScalingMult to 4>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScalingMult to 20>>
					<<set $combatExtended.enemyDefeatScaling to 10>>
					<<set $combatExtended.enemyInfiniteDefeatScaling to 0>>
					<<set $combatExtended.enemyDefeatScalingLimit to 20>>

					<<set $npcHealthMult to 100>>
					<<set $beastHealthMult to 200>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">조우 개편:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.standingFights to 1>>
					<<set $combatExtended.reverseRape to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.reverseRape" 0 1 autocheck>> 역강간 활성화
					<mouse class="tooltip linkBlue">(?)<span>적을 쓰러뜨렸다면 모든 조우에서 적이 복종 상태가 되며, 당신이 직접 끝낼 때까지 끝나지 않습니다. 발동하려면 음란 75 이상이 필요합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.standingFights" 0 1 autocheck>> 스탠딩 전투 활성화
					<mouse class="tooltip linkBlue">(?)<span>벽이나 글로리홀에 끼어 있지 않은 모든 비동의 조우는 스탠딩 전투로 시작됩니다.</span></mouse>
				</label><br>
				스탠딩 전투 유형: <mouse class="tooltip linkBlue">(?)<span>일반은 여전히 옷 벗기기와 더듬기를 허용합니다. 적대는 적이 즉시 적대적 행동을 하게 만듭니다.</span></mouse><br>
				<label>일반 <<radiobutton "$combatExtended.standingFightsType" "normal" autocheck>></label> |
				<label>적대 <<radiobutton "$combatExtended.standingFightsType" "hostile" autocheck>></label>
				<br>
			</div>
		</div>
	</div>
	<<if _ceTab is undefined>><<set _ceTab to "player">><</if>>
	<hr>
	<div id="ceTabs" class="no-numberify"><<combatExtendedTabButtons>></div>
	<div id="ceTabContent"><<combatExtendedTabContent>></div>
<</widget>>

<<widget "combatExtendedTabButtons">>
	<div class="containerStart">
		<<combatExtendedTabButton "Player" "player">>
		<<combatExtendedTabButton "Enemy" "enemy">>
	</div>
<</widget>>

<<widget "combatExtendedTabButton">>
	<div @class="_ceTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _ceTab to _args[1]>>
			<<replace #ceTabs>><<combatExtendedTabButtons>><</replace>>
			<<replace #ceTabContent>><<combatExtendedTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "combatExtendedTabContent">>
	<<switch _ceTab>>
		<<case "enemy">><<combatExtendedEnemySettings>>
		<<default>><<combatExtendedPlayerSettings>>
	<</switch>>
<</widget>>

<<widget "combatExtendedPlayerSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				플레이어 CE 행동
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 방어:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.blocking to 1>>
					<<set $combatExtended.countering to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.blocking" 0 1 autocheck>> 방어 활성화
					<mouse class="tooltip linkBlue">(?)<span>받는 피해를 최대 80%까지 줄입니다. 피해 감소량은 체격에 비례합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.countering" 0 1 autocheck>> 반격 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 공격할 때 피해를 받는 대신 피해를 줄 확률이 있습니다. 성공률은 속임수에 비례합니다. 방어에 쓰는 손 하나마다 턴당 공격 하나를 받아넘길 수 있습니다. 수적으로 열세일 때는 반격이 더 어렵고, 가벼운 체구는 무거운 체구보다 타격을 더 쉽게 흘려냅니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 공격:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.feinting to 1>>
					<<set $combatExtended.hookpunching to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.feinting" 0 1 autocheck>> 페인트 동작 활성화
					<mouse class="tooltip linkBlue">(?)<span>피해량이 줄어드는 대신 적의 회피 확률을 일부 무효화합니다. 속임수에 비례합니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.hookpunching" 0 1 autocheck>> 훅 펀치 활성화
					<mouse class="tooltip linkBlue">(?)<span>적의 회피 확률이 높아지는 대신 두 배의 피해를 줄 확률이 있습니다.</span></mouse>
				</label>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				플레이어 스킬
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 회피:</span>
				<br>
				<<link "모두 전환">>
					<<set $combatExtended.passiveDodging to 1>>
					<<set $combatExtended.activeDodging to 1>>
					<<set $combatExtended.uncappedDodgeChance to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.passiveDodging" 0 1 autocheck>> 수동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>수동 회피입니다. 매트릭스가 되어 보세요.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.activeDodging" 0 1 autocheck>> 능동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>회피를 위한 새로운 발 행동입니다. 수동 회피와는 별개의 더 좋은 회피 판정이지만, 발 행동을 소모하고 실패하면 안정성 피해를 입습니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.uncappedDodgeChance" 0 1 autocheck>> 회피 확률 상한 해제 활성화
					<mouse class="tooltip linkBlue">(?)<span>회피의 절대 상한을 없앱니다. 회피 확률이 매우 높아도 효과는 점점 줄어듭니다.</span></mouse>
				</label><br>
				<span class="gold">회피 확률 상한
				<mouse class="tooltip linkBlue">(?)<span>회피 확률의 상한입니다. 체격에도 자체 상한이 있어서, 둘 중 낮은 쪽이 적용됩니다. 작은 체격은 큰 체격보다 훨씬 많이 회피할 수 있습니다.</span></mouse>
				</span>
				<<numberslider "$combatExtended.dodgeChanceCap" $combatExtended.dodgeChanceCap 0 100 1>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$combatExtended.brawlingToggle" 0 1 autocheck>> 난투 활성화
					<mouse class="tooltip linkBlue">(?)<span>난투 스킬. 더 많은 사람과 싸울수록 오르며, 더 많은 상대와 싸울 때 효과가 더 크게 늘어납니다.</span></mouse>
				</label><br>
				<span data-target="combatExtended.standingFights" data-disabledif="V.combatExtended.standingFights===0">
					<label>
						<<checkbox "$combatExtended.footworkToggle" 0 1 autocheck>> 풋워크 활성화
						<mouse class="tooltip linkBlue">(?)<span>풋워크 스킬. 모든 원인으로 인한 안정성 손실을 줄여 줍니다.</span></mouse>
					</label><br>
				</span>
				<label>
					<<checkbox "$combatExtended.strikingToggle" 0 1 autocheck>> 타격 활성화
					<mouse class="tooltip linkBlue">(?)<span>타격 스킬. 타격의 명중률과 위력을 높여 줍니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.kickingToggle" 0 1 autocheck>> 발차기 활성화
					<mouse class="tooltip linkBlue">(?)<span>발차기 스킬. 타격의 명중률과 위력을 높여 줍니다.</span></mouse>
				</label>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "combatExtendedEnemySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				적의 확장 전투 행동
			</div>
			<div class="settingsToggleItem">
				<<link "모두 전환">>
					<<set $combatExtended.enemyPassiveDodging to 1>>
					<<set $combatExtended.enemyActiveDodging to 1>>
					<<set $combatExtended.enemyBlocking to 1>>
					<<set $combatExtended.enemyCountering to 1>>
					<<set $combatExtended.enemyFeinting to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyPassiveDodging" 0 1 autocheck>> 적의 수동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격을 회피할 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyActiveDodging" 0 1 autocheck>> 적의 능동 회피 활성화
					<mouse class="tooltip linkBlue">(?)<span>그 턴 동안 회피 확률이 두 배가 될 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyBlocking" 0 1 autocheck>> 적의 공격 막기 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격을 막을 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyCountering" 0 1 autocheck>> 적의 반격 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 공격에 반격할 확률이 생깁니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$combatExtended.enemyFeinting" 0 1 autocheck>> 적의 페인트 공격 활성화
					<mouse class="tooltip linkBlue">(?)<span>적이 당신의 회피 확률 일부를 상쇄할 확률이 생깁니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적 피해 배율:</span><mouse class="tooltip linkBlue">(?)<span>적의 공격이 적중했을 때 가해지는 고통, 스트레스, 트라우마를 조절합니다.</span></mouse>
				<span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span><br>
				<<numberslider "$combatExtended.enemyDamageMult" $combatExtended.enemyDamageMult 25 300 5 {
					value: value => value + "%"
				}>>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				적의 스킬
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적의 기본 회피/반격 확률:</span>
				<br>
				<div class="small-description">예전 방식의 적 회피/반격 시스템입니다. 적의 무술과 중첩됩니다.</div>
				<span data-target='["combatExtended.enemyPassiveDodging", "combatExtended.enemyActiveDodging", "combatExtended.enemyCountering"]' data-disabledif="V.combatExtended.enemyPassiveDodging===0&&V.combatExtended.enemyActiveDodging===0&&V.combatExtended.enemyCountering===0">
					<label>
						<<checkbox "$combatExtended.enemyBaseDodgeChance" 0 1 autocheck>> 적의 기본 회피 확률 활성화
						<mouse class="tooltip linkBlue">(?)<span>무술 스킬과 무관한 적의 기본 회피 확률입니다.</span></mouse>
					</label><br>
					<span data-target="combatExtended.enemyBaseDodgeChance" data-disabledif="V.combatExtended.enemyBaseDodgeChance===0">
						<div class="solidBorderContainer settings-container">
							<span class="gold">기본 회피 확률 레벨 스케일링 (%)
							<mouse class="tooltip linkBlue">(?)<span>레벨당 적의 회피 확률이 얼마나 오르는지 정합니다. 최대 레벨은 22입니다. 예전 방식은 레벨당 2%였습니다.</span></mouse>
							</span>
							<<numberbox "$combatExtended.enemyBaseDodgeChanceMult" $combatExtended.enemyBaseDodgeChanceMult>>
						</div>
					</span>
				</span>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적의 무술:</span>
				<br>
				<span data-target='["combatExtended.enemyPassiveDodging", "combatExtended.enemyActiveDodging", "combatExtended.enemyCountering"]' data-disabledif="V.combatExtended.enemyPassiveDodging===0&&V.combatExtended.enemyActiveDodging===0&&V.combatExtended.enemyCountering===0">
					<label>
						<<checkbox "$combatExtended.enemyMartialArts" 0 1 autocheck>> 적의 무술 활성화
						<mouse class="tooltip linkBlue">(?)<span>적의 회피/반격 확률을 높이는 스킬입니다.</span></mouse>
					</label><br>
				</span>
				<span data-target="combatExtended.enemyMartialArts" data-disabledif="V.combatExtended.enemyMartialArts===0">
					<div class="small-description">무술 무작위 스케일링과 무술 레벨 스케일링을 둘 다 활성화하면 두 효과가 중첩됩니다.</div>
					적 무술 스케일링:<br>
					<label>무작위 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "random" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 무작위로 정해집니다.</span></mouse> |
					<label>레벨 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "level" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 레벨에 따라 오릅니다.</span></mouse> |
					<label>둘 다 <<radiobutton "$combatExtended.enemyMartialArtsScaling" "both" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>무작위 + 레벨 스케일링입니다.</span></mouse>
					<br>
					<span data-target="combatExtended.enemyMartialArtsLevelScaling" data-disabledif="V.combatExtended.enemyMartialArtsLevelScaling==='level'||V.combatExtended.enemyMartialArtsLevelScaling==='both'">
						<div class="solidBorderContainer settings-container">
							<span class="gold">무술 레벨 스케일링
							<mouse class="tooltip linkBlue">(?)<span>레벨당 적의 무술 스킬이 얼마나 오르는지 정합니다. 최대 레벨은 22입니다. 무술 10당 회피/반격 확률 1%입니다.</span></mouse>
							</span>
							<<numberbox "$combatExtended.enemyMartialArtsLevelScalingMult" $combatExtended.enemyMartialArtsLevelScalingMult>>
						</div>
					</span>
					<label>
						<<checkbox "$combatExtended.enemyMartialArtsBadass" 0 1 autocheck>> 적의 무술 강자 모드 활성화
						<mouse class="tooltip linkBlue">(?)<span>적의 무술 스킬이 500 오를 때마다 적은 적의 확장 전투 행동 중 다른 행동을 동시에 하나 더 할 수 있습니다. 예: 무술 스킬 500인 적은 회피, 반격, 막기 중 두 가지를 고를 수 있습니다. 무술 스킬 1000인 적은 세 가지를 동시에 할 수 있습니다.</span></mouse>
					</label><br>
				</span>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				적 버프 스케일링
			</div>
			<div class="settingsToggleItem">
				<span class="gold">적 일수 스케일링:</span>
				<br>
				<<link "일수 스케일링 전환">>
					<<set $combatExtended.enemyLevelDayScaling to 1>>
					<<set $combatExtended.enemyHealthDayScaling to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyLevelDayScaling" 0 1 autocheck>> 게임 내 일수에 따른 적 레벨 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 일반 NPC의 레벨이 오릅니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">레벨 버프 스케일링 (레벨)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프 한 번에 오르는 레벨입니다. 1이면 버프가 적용될 때마다 적의 레벨이 +1 오릅니다. 최대 레벨은 22입니다.</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyLevelDayScalingMult" $combatExtended.enemyLevelDayScalingMult>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyHealthDayScaling" 0 1 autocheck>> 게임 내 일수에 따른 적 체력 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 NPC와 짐승의 체력이 체력 배율과 별개로 추가 상승합니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">체력 비율 버프 스케일링 (%)
					<mouse class="tooltip linkBlue">(?)<span>스케일링이 발동할 때마다 얻는 체력 비율 버프입니다. 5이면 버프가 적용될 때마다 체력이 +5% 오릅니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyHealthDayScalingMult" $combatExtended.enemyHealthDayScalingMult>>
				</div>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 간격 (일)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 발동하는 일수 간격입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDayScaling" $combatExtended.enemyDayScaling>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyInfiniteDayScaling" 0 1 autocheck>> 무한 버프 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수에 제한이 없습니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 한도 (버프 횟수)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수의 한도입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDayScalingLimit" $combatExtended.enemyDayScalingLimit>>
				</div>
			</div>
			<div class="settingsToggleItem" role="group" aria-labelledby="settingsScaling">
				<span class="gold">적 패배 스케일링:</span>
				<br>
				<<link "패배 스케일링 전환">>
					<<set $combatExtended.enemyLevelDefeatScaling to 1>>
					<<set $combatExtended.enemyHealthDefeatScaling to 1>>
					<<set _subsection to "combatExtended">><<replace #subsectionDiv>><<combatExtendedSettings>><</replace>>
				<</link>><br>
				<label>
					<<checkbox "$combatExtended.enemyLevelDefeatScaling" 0 1 autocheck>> 적 패배 수에 따른 적 레벨 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>적을 한 명 쓰러뜨릴 때마다 모든 일반 NPC의 레벨이 오릅니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">레벨 버프 스케일링 (레벨)
					<mouse class="tooltip linkBlue">(?)<span>레벨 버프가 적용되기까지 필요한 적 패배 수입니다. 1이면 버프가 적용될 때마다 적의 레벨이 +1 오릅니다. 최대 레벨은 22입니다.</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyLevelDefeatScalingMult" $combatExtended.enemyLevelDefeatScalingMult>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyHealthDefeatScaling" 0 1 autocheck>> 적 패배 수에 따른 적 체력 스케일링 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프가 적용될 때마다 모든 NPC와 짐승의 체력이 체력 배율과 별개로 추가 상승합니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">체력 비율 버프 스케일링 (%)
					<mouse class="tooltip linkBlue">(?)<span>스케일링이 발동할 때마다 얻는 체력 비율 버프입니다. 0.05이면 버프가 적용될 때마다 체력이 +5% 오릅니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyHealthDefeatScalingMult" $combatExtended.enemyHealthDefeatScalingMult>>
				</div>
				<div class="solidBorderContainer settings-container">
					<span class="gold">적 패배 스케일링 기준 (적 수)
					<mouse class="tooltip linkBlue">(?)<span>버프가 적용되기까지 필요한 적 패배 수의 기준입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDefeatScaling" $combatExtended.enemyDefeatScaling>>
				</div>
				<label>
					<<checkbox "$combatExtended.enemyInfiniteDefeatScaling" 0 1 autocheck>> 무한 버프 활성화
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수에 제한이 없습니다.</span></mouse>
				</label>
				<div class="solidBorderContainer settings-container">
					<span class="gold">스케일링 한도 (버프 횟수)
					<mouse class="tooltip linkBlue">(?)<span>스케일링 버프를 적용할 수 있는 횟수의 한도입니다. 범위 1 - 1000000</span></mouse>
					</span>
					<<numberbox "$combatExtended.enemyDefeatScalingLimit" $combatExtended.enemyDefeatScalingLimit>>
				</div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "amcTraitsSettings">>
	/% Dropping the Autism Spectrum trait drops the talents it paid for %/
	<<run autismEnforceTalentLimits()>>
	<<if typeof applyPermanentInsanityTalents is "function">>
		<<run applyPermanentInsanityTalents()>>
	<</if>>
	<<if _amcTab is undefined>><<set _amcTab to "talents">><</if>>
	<hr>
	<div id="amcTabs" class="no-numberify"><<amcTabButtons>></div>
	<div id="amcTabContent"><<amcTabContent>></div>
<</widget>>

<<widget "amcTabButtons">>
	<div class="containerStart">
		<<amcTabButton "Talents" "talents">>
		<<amcTabButton "Traits" "traits">>
		<<amcTabButton "Misc" "systems">>
	</div>
<</widget>>

<<widget "amcTabButton">>
	<div @class="_amcTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _amcTab to _args[1]>>
			<<replace #amcTabs>><<amcTabButtons>><</replace>>
			<<replace #amcTabContent>><<amcTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "amcTabContent">>
	<<switch _amcTab>>
		<<case "traits">><<amcTraitsTraitSettings>>
		<<case "systems">><<amcTraitsSystemSettings>>
		<<default>><<amcTraitsTalentSettings>>
	<</switch>>
<</widget>>

<<widget "amcTraitsTalentSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">캐릭터 재능:</span><br>
				<span class="small-description">이 재능은 스킬 상한을 두 배로 늘려 주지만, 해당 스킬이 기본 게임의 상한에 도달한 뒤에는 그 스킬을 올리는 것도 두 배로 어려워집니다. 대체로 유익합니다. 다만 캐릭터에 쓸 수 있는 재능 포인트는 한정되어 있으니 신중히 고르십시오.</span>
				<<if typeof permanentInsanityTalentLockActive is "function" and permanentInsanityTalentLockActive()>>
					<br><span class="red small-description">영구 광기는 모든 재능을 강제로 활성화합니다.</span>
				<</if>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">선택 (최대 1개<<if $seaRemembers?.reward>>, 획득한 돌파 보상 제외<</if>>):</span><br>
				<label data-target='["AMCTraits.willpower"]' data-disabledif="V.seaRemembers?.reward === 'physique' || permanentInsanityTalentLockActive() || V.AMCTraits.willpower === 2 && V.seaRemembers?.reward !== 'willpower'"><span class="green">단련된 체격</span> <<checkbox "$AMCTraits.physique" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.physique"]' data-disabledif="V.seaRemembers?.reward === 'willpower' || permanentInsanityTalentLockActive() || V.AMCTraits.physique === 2 && V.seaRemembers?.reward !== 'physique'"><span class="green">단련된 의지력</span> <<checkbox "$AMCTraits.willpower" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">선택 (최대 1개):</span><br>
				<label data-target='["AMCTraits.semen"]' data-disabledif="permanentInsanityTalentLockActive() || V.AMCTraits.semen === 2"><span class="blue">단련된 모유량</span> <<checkbox "$AMCTraits.milk" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.milk"]' data-disabledif="permanentInsanityTalentLockActive() || V.AMCTraits.milk === 2"><span class="blue">단련된 정액량</span> <<checkbox "$AMCTraits.semen" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">선택 (최대 <<= autismTalentLimit("general")>>개):</span><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.skulduggery !== 2"><span class="green">단련된 속임수</span> <<checkbox "$AMCTraits.skulduggery" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.dancing !== 2"><span class="green">단련된 춤</span> <<checkbox "$AMCTraits.dancing" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.swimming !== 2"><span class="green">단련된 수영</span> <<checkbox "$AMCTraits.swimming" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="V.seaRemembers?.reward === 'athletics' || permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.athletics !== 2"><span class="green">단련된 체육</span> <<checkbox "$AMCTraits.athletics" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.tending !== 2"><span class="green">단련된 관리</span> <<checkbox "$AMCTraits.tending" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.housekeeping !== 2"><span class="green">단련된 가사</span> <<checkbox "$AMCTraits.housekeeping" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.brawling !== 2"><span class="green">단련된 난투</span> <<checkbox "$AMCTraits.brawling" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.footwork !== 2"><span class="green">단련된 풋워크</span> <<checkbox "$AMCTraits.footwork" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.striking !== 2"><span class="green">단련된 타격</span> <<checkbox "$AMCTraits.striking" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.kicking !== 2"><span class="green">단련된 발차기</span> <<checkbox "$AMCTraits.kicking" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.science !== 2"><span class="teal">단련된 과학</span> <<checkbox "$AMCTraits.science" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.maths !== 2"><span class="teal">단련된 수학</span> <<checkbox "$AMCTraits.maths" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.english !== 2"><span class="teal">단련된 영어</span> <<checkbox "$AMCTraits.english" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.skulduggery","AMCTraits.dancing","AMCTraits.swimming","AMCTraits.athletics","AMCTraits.tending","AMCTraits.housekeeping","AMCTraits.brawling","AMCTraits.footwork","AMCTraits.striking","AMCTraits.kicking","AMCTraits.science","AMCTraits.maths","AMCTraits.english","AMCTraits.history"]' data-disabledif="permanentInsanityTalentLockActive() || sumTalents()-14 >= autismTalentLimit('general') && V.AMCTraits.history !== 2"><span class="teal">단련된 역사</span> <<checkbox "$AMCTraits.history" 1 2 autocheck>></label><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">선택 (최대 <<= autismTalentLimit("sex")>>개):</span><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.seductionskill !== 2"><span class="blue">단련된 유혹 스킬</span> <<checkbox "$AMCTraits.seductionskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.oralskill !== 2"><span class="blue">단련된 구강 스킬</span> <<checkbox "$AMCTraits.oralskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.chestskill !== 2"><span class="blue">단련된 가슴 스킬</span> <<checkbox "$AMCTraits.chestskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.handskill !== 2"><span class="blue">단련된 손 스킬</span> <<checkbox "$AMCTraits.handskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.bottomskill !== 2"><span class="blue">단련된 엉덩이 스킬</span> <<checkbox "$AMCTraits.bottomskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.penileskill !== 2"><span class="blue">단련된 자지 스킬</span> <<checkbox "$AMCTraits.penileskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.vaginalskill !== 2"><span class="blue">단련된 질 스킬</span> <<checkbox "$AMCTraits.vaginalskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.analskill !== 2"><span class="blue">단련된 항문 스킬</span> <<checkbox "$AMCTraits.analskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.thighskill !== 2"><span class="blue">단련된 허벅지 스킬</span> <<checkbox "$AMCTraits.thighskill" 1 2 autocheck>></label><br>
				<label data-target='["AMCTraits.seductionskill","AMCTraits.oralskill","AMCTraits.chestskill","AMCTraits.handskill","AMCTraits.bottomskill","AMCTraits.penileskill","AMCTraits.vaginalskill","AMCTraits.analskill","AMCTraits.thighskill","AMCTraits.feetskill"]' data-disabledif="permanentInsanityTalentLockActive() || sumSexTalents()-10 >= autismTalentLimit('sex') && V.AMCTraits.feetskill !== 2"><span class="blue">단련된 발 스킬</span> <<checkbox "$AMCTraits.feetskill" 1 2 autocheck>></label><br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "amcTraitsTraitSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">특성</span><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">자지/구멍 중독:</span><br>
				<label><<checkbox "$xchange.genitalAddictTraitsEnabled" 0 1 autocheck>> 특성 활성화</label> <mouse class="tooltip linkBlue">(?)<span>자지/구멍 중독 특성을 얻을 수 있게 합니다. 이 특성은 (각 특성에 따라) 어떤 형태로든 삽입을 받는 중이 아니면 오르가슴에 도달하지 못하게 합니다.</span></mouse><br>
				<label><<checkbox "$xchange.genitalAddictFreeOrgasm" false true autocheck>> 삽입 없이도 오르가슴 허용</label> <mouse class="tooltip linkBlue">(?)<span>평소에 자지/구멍 중독은 갈망하는 삽입 없이는 오르가슴에 도달하지 못하게 합니다. 이를 켜면 어쨌든 오르가슴에 도달할 수 있습니다. 그런 오르가슴은 허무하고 스트레스를 줍니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">구강 집착:</span><br>
				<label><<checkbox "$xchange.oralFixationTraitEnabled" 0 1 autocheck>> 특성 활성화</label> <mouse class="tooltip linkBlue">(?)<span>오럴을 해 주거나 정액을 삼켜서 구강 집착 특성을 얻을 수 있게 합니다. 오럴을 해 주는 중이 아니면 오르가슴에 도달하지 못하게 하고, 입의 민감도를 높이며, 삼킨 정액이 식물 꿀처럼(중독 포함) 작용하게 합니다. 비활성화하면 특성이 제거되고 억제됩니다. 이미 조건을 충족했다면 다시 활성화해 특성을 되찾을 수 있습니다.</span></mouse><br>
				<label><<checkbox "$xchange.oralFixationSwallowRelief" 0 1 autocheck>> 정액을 삼키면 오르가슴 가능</label> <mouse class="tooltip linkBlue">(?)<span>이 설정을 켜면 정액을 삼킨 뒤 1시간 동안은 입에 아무것도 없어도 오르가슴에 도달할 수 있습니다. 끄면 오럴을 해 주는 동안에만 오르가슴이 가능합니다.</span></mouse><br>
				<label><<checkbox "$xchange.oralFixationFreeOrgasm" false true autocheck>> 오럴 없이도 오르가슴 허용</label> <mouse class="tooltip linkBlue">(?)<span>평소에 구강 집착은 충족되지 않으면 오르가슴에 도달하지 못하게 합니다. 이를 켜면 어쨌든 오르가슴에 도달할 수 있습니다. 그런 오르가슴은 허무하고 스트레스를 줍니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">적응 특성:</span><br>
				<label><<checkbox "$xchange.chastityAcclimatedTraitEnabled" 0 1 autocheck>> 정조대 적응 활성화</label> <mouse class="tooltip linkBlue">(?)<span>정조대에 열흘 연속으로 갇혀 있으면 정조대 적응 특성을 얻을 수 있게 합니다. 스스로 고르지 않은 정조대 때문에 쌓이는 욕구불만이 크게 줄어듭니다. 비활성화하면 특성이 제거되고 억제됩니다. 이미 조건을 충족했다면 다시 활성화해 특성을 되찾을 수 있습니다.</span></mouse><br>
				<label><<checkbox "$xchange.arousalAcclimatedTraitEnabled" 0 1 autocheck>> 흥분 적응 활성화</label> <mouse class="tooltip linkBlue">(?)<span>2주 연속으로 호색한 상태이거나 정조대 적응 상태가 되면 흥분 적응 특성을 얻을 수 있게 합니다. 모든 흥분 상승량이 절반이 되고, 아무리 흥분해 있어도 잠을 자고, 욕조나 샤워에서 나오고, 렌의 카드 테이블에서 물러나고, 접근을 거절할 수 있게 됩니다. 비활성화하면 특성이 제거되고 억제됩니다. 이미 조건을 충족했다면 다시 활성화해 특성을 되찾을 수 있습니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">안대 적응력:</span><br>
				적응력 유지: <mouse class="tooltip linkBlue">(?)<span>눈을 가리지 않으면 적응력이 줄어듭니다. 서서히 사라짐: 그윌란이 최면을 걸어 한동안 감소를 멈춰 줄 수 있습니다. 그윌란이 고정해 줌: 완전히 적응하면 그윌란이 영구화해 줄 수 있습니다. 바로 고정: 완전히 적응하는 즉시 영구화됩니다.</span></mouse><br>
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "fade" autocheck>> 서서히 사라짐</label> |
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "gwylan" autocheck>> 그윌란이 고정해 줌</label> |
				<label><<radiobutton "$xchange.blindAdaptabilityKeep" "auto" autocheck>> 바로 고정</label><br>
				<label><<checkbox "$xchange.blindAdaptabilityNoLove" 0 1 autocheck>> 호감도 없이도 그윌란이 도와줌</label> <mouse class="tooltip linkBlue">(?)<span>평소 그윌란은 그윌란의 호감도가 50% 이상일 때만 적응력을 도와줍니다. 이를 켜면 그윌란의 다른 최면처럼, 그윌란에게 호의를 한 번 베푼 뒤에 도와줍니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">발정기:</span><br>
				<label><<checkbox "$xchange.heatBlocksScream" 0 1 autocheck>> 발정기에는 비명을 지를 수 없음</label> <mouse class="tooltip linkBlue">(?)<span>발정기(암컷 또는 수컷) 중에는 조우에서 비명 행동을 쓸 수 없습니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">동물 자석:</span><br>
				<label><<checkbox "$xchange.critterMagnetTraitEnabled" 0 1 autocheck>> 특성 활성화</label> <mouse class="tooltip linkBlue">(?)<span>동물 자석 특성을 얻을 수 있게 합니다. 비활성화하면 특성이 제거되고 억제됩니다. 이미 조건을 충족했다면 다시 활성화해 특성을 되찾을 수 있습니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">광기:</span><br>
				<label><<checkbox "$xchange.insanityDisturbedTraitsEnabled" 0 1 autocheck>> 전체 해리</label> <mouse class="tooltip linkBlue">(?)<span>기본적으로 광기의 해리는 처음 두 번의 조우 동안만 당신을 마비시키고 이후에는 약해집니다. 이를 켜면 눈에 띄게 동요하는 상태가 되고 보통의 심한 해리를 쓰게 되어, 완전히 마비된 채로 있을 수도 있습니다.</span></mouse> <span class="red">이 옵션은 비명을 지르거나 반격하는 것을 완전히 막습니다!</span><br>
				<label><<checkbox "$xchange.insanityBecomesPermanent" 0 1 autocheck>> 자연 발생한 광기는 영구적</label> <mouse class="tooltip linkBlue">(?)<span>평소에 게임 안에서 얻은 광기(일주일 넘게 심한 트라우마 상태로 지낼 때 생김)는 트라우마가 가라앉으면 사라집니다. 이를 켜면 광기가 자리 잡는 순간 <b>영구적</b>이 됩니다. 캐릭터 생성 때 고른 광기처럼 스킬 상한이 두 배가 되지는 <i>않습니다</i>. 유일한 해소법은 그윌란이 최면으로 광기를 잠시 잠재워 주는 것뿐입니다.</span></mouse><br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "amcTraitsSystemSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">의지력 시스템</span><br>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.willpowerSystemEnabled" 0 1 autocheck>> 의지력 시스템 활성화</label> <mouse class="tooltip linkBlue">(?)<span>의지력이 하루 단위 자원이 되어, 하루 동안 쓸수록, 그리고 전투 중 쾌락에 저항할 때마다 점점 약해집니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<label data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1"><<checkbox "$xchange.willpowerRestEnabled" 0 1 autocheck>> 휴식과 진정이 의지력을 회복시킴</label>
				<mouse class="tooltip linkBlue">(?)<span>휴식, 식사, 기도, 명상, 스트레스 감소로 의지력을 어느 정도 회복할 수 있습니다. 하루 회복량에는 한도가 있어, 주된 회복 수단은 여전히 수면입니다.</span></mouse><br>
			</div>

			<div class="settingsToggleItem numberslider-inline" data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1">
				<span class="gold bold">성공 비용:
				<mouse class="tooltip linkBlue">(?)<span>의지력 판정에 성공할 때마다 소모되는 의지력의 양입니다. (참고로 기본 게임의 의지력은 최대 1000이며, AMC 특성이 있으면 최대 2000입니다.)</span></mouse>
				</span>
				<<numberbox "$xchange.willpowerSuccessCost" $xchange.willpowerSuccessCost>>
			</div>
			<div class="settingsToggleItem numberslider-inline" data-target="xchange.willpowerSystemEnabled" data-disabledif="V.xchange?.willpowerSystemEnabled!==1">
				<span class="gold bold">실패 비용:
				<mouse class="tooltip linkBlue">(?)<span>의지력 판정에 실패할 때마다 소모되는 의지력의 양입니다. (참고로 기본 게임의 의지력은 최대 1000이며, AMC 특성이 있으면 최대 2000입니다.)</span></mouse>
				</span>
				<<numberbox "$xchange.willpowerFailureCost" $xchange.willpowerFailureCost>>
			</div>
			<div class="settingsToggleItemWide numberslider-inline" data-target='["xchange.willpowerSystemEnabled","xchange.willpowerRestEnabled"]' data-disabledif="V.xchange?.willpowerSystemEnabled!==1||V.xchange?.willpowerRestEnabled===0">
				<span class="gold bold">휴식 회복 강도: (%)
					<mouse class="tooltip linkBlue">(?)<span>휴식이 회복시키는 의지력의 양과 하루 한도를 바꿉니다. 100%일 때는 하루에 의지력 풀의 최대 40%까지 회복할 수 있습니다.</span></mouse>
				</span>
				<<numberslider "$xchange.willpowerRestPercent" $xchange.willpowerRestPercent 0 300 25>>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">최면 설정</span><br>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$angryHypnotist" false true autocheck>> 최면술사가 화가 나 있으면 당신에게 최면을 걸 가능성이 높아짐
				</label><br>
				<label>
					<<checkbox "$deviantHypnotist" false true autocheck>> 최면술사가 당신에게 최면에 의한 이상성욕을 줄 수 있음
				</label>
			</div>
			<div class="settingsToggleItem">
				<label><span class="gold">적 최면술사 확률 (%)</span>
				<br>
				<<numberslider "$hypnotistChance" $hypnotistChance 0 100 1>>
				</label><br>
			</div>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				<span class="gold">발정기 시스템</span><br>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.systemOn" 0 1 autocheck>> 강제 발정 활성화</label>
				<mouse class="tooltip linkBlue">(?)<span>발정기에는 캐릭터가 본능적인 욕구에 자신을 잃을 수 있습니다. 정조대가 번식에 쓰이는 모든 구멍을 막고 있다면, 대신 그 장치를 긁어 대며 서서히 닳게 합니다.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.permanentOn" 0 1 autocheck>> 영구 시스템 활성화</label>
				<mouse class="tooltip linkBlue">(?)<span>알약, 가임력, 주기와 관계없이 <b>항상</b> 발정기 및/또는 수컷 발정기 상태로 있게 합니다.</span></mouse>
			</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$xchange.heat.resistWithWillpower" 0 1 autocheck>> 의지력으로 발정 저항</label>
				<mouse class="tooltip linkBlue">(?)<span>체크하면 높은 의지력이 발정을 억누를 수 있으며, 의지력 판정에 <b>실패</b>할 때만 당신의 행동이 덮어쓰입니다. 체크를 해제하면 의지력을 무시하고 발정이 매번 당신을 지배합니다.</span></mouse>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "modLISettingsSection">>
	<<run ensureModLISettings()>>
	<<set _enabledModLIs to getActivatedModLIs()>>
	<<set _availableModLIs to getAvailableModLIs()>>
	<div class="settingsToggleItemWide">
		<<if $ModExclusiveLIEnabled is 1>>
			<div class="small-description red">경고: 모드 전용 연애 대상을 활성화하면 이 세이브 파일에서는 되돌릴 수 없습니다. 한 번 활성화한 연애 대상은 이번 플레이 내내 등장할 수 있습니다.</div>
			<label>이 세이브 파일에서 활성화할 커스텀 연애 대상을 고르십시오:</label><br>
			<<if _availableModLIs.length gt 0>>
				<<for _modLIName range _availableModLIs>>
					<<button _modLIName>>
						<<run activateModLI(_modLIName)>>
						<<replace #modLISettingsPanel>><<modLISettingsSection>><</replace>>
					<</button>>
					<<if _modLIName neq _availableModLIs[_availableModLIs.length - 1]>> | <</if>>
				<</for>>
			<<else>>
				<div class="green">모든 모드 전용 연애 대상이 이미 이 세이브 파일에서 활성화되어 있습니다.</div>
			<</if>>
			<br>
			<span class="gold">이 저장 파일에서 활성화됨</span><br>
			<<if _enabledModLIs.length gt 0>>
				<<for _enabledName range _enabledModLIs>>
					<<print _enabledName>>
					<<if _enabledName neq _enabledModLIs[_enabledModLIs.length - 1]>> | <</if>>
				<</for>>
			<<else>>
				<span class="small-description">이 세이브 파일에서 영구 활성화된 모드 전용 연애 대상이 아직 없습니다.</span>
			<</if>>
		<<else>>
			<span class="small-description">모드 전용 연애 대상을 켜면 영구 활성화 메뉴가 열립니다. 이미 활성화한 연애 대상은 나중에 이 메뉴를 다시 숨겨도 이 세이브 파일에 고정된 채로 남습니다.</span>
		<</if>>
	</div>
<</widget>>

<<widget "dolpSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem" id="modExclusiveLISetting">
				<span class="gold">모드 전용 연애 대상</span>
				<br>
				<label><<checkbox "$ModExclusiveLIEnabled" 0 1 autocheck>> 모드 전용 연애 대상 표시</label>
			</div>
			<div id="modLISettingsPanel"><<modLISettingsSection>></div>
			<<run $(() => {$('#modExclusiveLISetting input[type="checkbox"]').off('change.modli').on('change.modli', () => {Wikifier.wikifyEval('<<replace #modLISettingsPanel>><<modLISettingsSection>><</replace>>');});})>>
			
			<div class="settingsToggleItem">
				<span class="gold">적 능력치 표시</span> <mouse class = "tooltip linkBlue">(?)<span>조우에 들어서면 적의 상태가 글로 설명됩니다. 이 설정으로 적의 능력치가 정확히 몇인지 볼 수 있습니다.</span></mouse>
				<br>
				<label>정확한 수치 표시 <<radiobutton "$enemystatstyle" "full" autocheck>></label> |
				<label>설명만 표시 <<radiobutton "$enemystatstyle" "default" autocheck>></label>
				<br>
				<label>
					<<checkbox "$postCombatStats" 0 1 autocheck>> 조우 후 요약 표시 <mouse class = "tooltip linkBlue">(?)<span>조우가 끝나면 요약을 보여 줍니다. 당신과 상대 또는 가해자들이 몇 번 오르가슴에 도달했는지, 정액을 어디에서 받고 어디에 주었는지, 파괴되거나 도난당한 의류가 있는지를 알려 줍니다.</span></mouse>
				</label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">모드 의류 특성</span>
				<br>
				<label>
					<<checkbox "$realisticTransparency" 0 1 autocheck>> 현실적인 의류 투명도 활성화
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 대부분의 옷이 투명해집니다. 이 토글은 보통 만들어지는 소재의 종류에 따라 투명도가 정해지게 바꿉니다.</span></mouse>
				<br>
				<label>
					<<checkbox "$preyTrait" 0 1 autocheck>> 먹잇감 특성 활성화
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>먹잇감 특성이 있는 의류(토끼, 소, 순록 의상)는 숲의 야생 짐승과 황야의 매가 당신을 발견할 가능성을 높입니다.</span></mouse>
				<br>
				<label>
					<<checkbox "$silkyTrait" 0 1 autocheck>> 실크 특성 활성화
				</label>
				<mouse class = "tooltip linkBlue">(?)<span>실크 특성이 있는 의류는 민감한 젖꼭지나 성기에 쓸리지 않아서 흥분하지 않고 쓸림 메시지도 표시되지 않습니다.</span></mouse>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">옷장 수용량 배율</span>
				<br>
				<div class="small-description">옷장의 수용량을 조절합니다. 이 설정과 관계없이 구매와 이동은 옷장당 총 3,000벌로 제한됩니다. 의류 자동 반환은 이 한도를 넘을 수 있습니다.</div>
				<<numberslider "$wardrobeMult" $wardrobeMult 1 20 1>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">자전거 설정</span>
				<br>
				<label>
					<<checkbox "$bicycle.persistentLocation" false true autocheck>> 자전거 위치 유지 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 자전거를 둔 위치를 게임이 기억하며, 그 위치에서만 다시 탈 수 있습니다. 비활성화하면 이용 가능한 어느 장소에서든 탈 수 있습니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$bicycle.theftEnabled" false true autocheck>> 자전거 보안 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 자전거가 매일 자정마다 도난당할 위험이 있으며 보안 업그레이드를 이용할 수 있습니다. 비활성화하면 자전거는 절대 도난당하지 않습니다.</span></mouse>
				</label>
			</div>	

			<div class="settingsToggleItem">
				<span class="gold">예금 설정</span>
				<br>
				<div class="small-description numberslider-inline">예금을 맡길 수 있는 최대 주 수입니다. 0은 무제한을 뜻합니다.
					<<numberslider "$depositMax" $depositMax 0 12 1>>
				</div>
				<div class="small-description numberslider-inline">예금을 인출하기로 했을 때 인출 수수료로 예금에서 얼마가 차감되는지입니다.
					<<numberslider "$depositWithdrawalFee" $depositWithdrawalFee 0 100 5 { value: (v) => v + "%" }>>
				</div>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">기생충 탱크·헛간 수용량 배율</span>
				<br>
				<div class="small-description">기생충 탱크와 헛간의 수용량을 조정합니다.</div>
				<<numberslider "$parasiteCapMult" $parasiteCapMult 1 10 1>>
			</div>
		</div>
	</div>
	<hr>
	<div id="dolpTabSettings">
		<<allDoLPSettings>>
	</div>
	<div id="subsectionDiv">
		<<rebalanceSettings>>
	</div>
	<br>
	<<link "맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
	<div style="clear:both;">/*Keep at end of toggles*/</div>
<</widget>>

<<widget "rebalanceSettings">>
	<<script>>setup.inflation?.ensureSettings?.();<</script>>
	<<if _rebalTab is undefined>><<set _rebalTab to "economy">><</if>>
	<hr>
	<div id="rebalTabs" class="no-numberify"><<rebalanceTabButtons>></div>
	<div id="rebalTabContent"><<rebalanceTabContent>></div>
<</widget>>

<<widget "rebalanceTabButtons">>
	<div class="containerStart">
		<<rebalanceTabButton "경제 인플레이션" "economy">>
		<<rebalanceTabButton "재조정 설정" "rebalancing">>
		<<rebalanceTabButton "반복 작업 설정" "grind">>
	</div>
<</widget>>

<<widget "rebalanceTabButton">>
	<div @class="_rebalTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _rebalTab to _args[1]>>
			<<replace #rebalTabs>><<rebalanceTabButtons>><</replace>>
			<<replace #rebalTabContent>><<rebalanceTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "rebalanceTabContent">>
	<<switch _rebalTab>>
		<<case "rebalancing">><<rebalanceRebalancingSettings>>
		<<case "grind">><<rebalanceGrindSettings>>
		<<default>><<rebalanceEconomySettings>>
	<</switch>>
<</widget>>

<<widget "rebalanceEconomySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				경제 인플레이션 <mouse class="tooltip linkBlue">(?)<span>이 설정들은 경제가 얼마나 강하게 반발하는지를 정합니다.</span></mouse>
			</div>

			<div class="settingsToggleItemWide">
				<span class="gold">경제 재조정 프리셋</span> <mouse class="tooltip linkBlue">(?)<span>경제 조정 항목 전체를 한꺼번에 적용합니다. 가벼움은 가격 인상폭이 가장 낮고, 추가 집세가 가능한 한 늦게 시작되며, 거절/추적이 패러디 단계에서 시작되게 합니다. 중간은 기본보다 부드럽습니다. 현재는 의도된 균형입니다. 어려움과 더 가혹함은 가격과 베일리의 압박이 더 일찍 시작되며, 신사 클럽 퀘스트 수입을 각각 75%와 50%로 줄입니다. 적용한 뒤에도 개별 설정은 조정할 수 있습니다.</span></mouse>
				<br>
				<<link "가벼움">><<run setup.inflation.applyPreset("light")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "중간">><<run setup.inflation.applyPreset("mid")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "현재">><<run setup.inflation.applyPreset("current")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "어려움">><<run setup.inflation.applyPreset("hard")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>> |
				<<link "더 가혹함">><<run setup.inflation.applyPreset("harsher")>><<replace #subsectionDiv>><<rebalanceSettings>><</replace>><</link>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">인플레이션 비율</span>
				<div class="small-description">초기 <mouse class="tooltip linkBlue">(?)<span>총 순자산이 £500,000에 도달하면 가격이 오르는 폭입니다.</span></mouse>: <<numberslider "$settings.inflationOnsetPct" $settings.inflationOnsetPct 11 30 1 { value: v => v + "%" }>></div>
				<div class="small-description">경기 악화 <mouse class="tooltip linkBlue">(?)<span>총 순자산이 £2,000,000에 도달하면 가격이 오르는 폭입니다.</span></mouse>: <<numberslider "$settings.inflationBadPct" $settings.inflationBadPct 28 100 1 { value: v => v + "%" }>></div>
				<div class="small-description">위기 <mouse class="tooltip linkBlue">(?)<span>총 순자산이 £5,000,000에 도달하면 가격이 오르는 폭입니다.</span></mouse>: <<numberslider "$settings.inflationCrisisPct" $settings.inflationCrisisPct 56 200 1 { value: v => v + "%" }>></div>
				<div class="small-description">극단 <mouse class="tooltip linkBlue">(?)<span>총 순자산이 £15,000,000에 도달하면 가격이 오르는 폭입니다.</span></mouse>: <<numberslider "$settings.inflationExtremePct" $settings.inflationExtremePct 115 400 5 { value: v => v + "%" }>></div>
				<div class="small-description">패러디 폭주 <mouse class="tooltip linkBlue">(?)<span>총 순자산이 £100,000,000에 도달하면 가격이 오르는 폭입니다. 이는 폭주하는 코미디 단계이지, 돈 몰수의 상한이 아닙니다.</span></mouse>: <<numberslider "$settings.inflationParodyPct" $settings.inflationParodyPct 450 3000 50 { value: v => v + "%" }>></div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">베일리 발동 조건</span>
				<div class="red"><label><<checkbox "$settings.inflationBaileyRelentless" false true autocheck>> 집요한 베일리</label> <mouse class="tooltip linkBlue">(?)<span>켜면 베일리는 "싫다"를 절대 받아들이지 않고 처음부터 당신을 추적하며, 부하들을 먼저 보내고 직접 나서는 일도 훨씬 잦아집니다. 집세는 아무리 가난해도 납부한 주마다 조금씩 오르며 <b>상한이 없어</b> 영원히 오릅니다. 이 설정은 아래의 두 설정과 베일리 집세 한도의 상한을 덮어씁니다(모두 회색으로 표시됨). 오르는 속도는 주간 집세 증가폭만이 정합니다. 기본값은 꺼짐이며, 프리셋은 이 설정을 바꾸지 않습니다.</span></mouse></div>
				<br>
				<div class="small-description" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">추가 집세 시작 <mouse class="tooltip linkBlue">(?)<span>눈에 보이는 돈이 이 인플레이션 수준에 도달하면, 납부한 주 이후부터 베일리가 추가 집세를 붙이기 시작합니다. 눈에 보이는 돈은 현금과 HBSC 예금에서 은행 대출 빚을 뺀 금액입니다. 높을수록 늦게 시작됩니다. 거절은 여전히 통합니다.</span></mouse>: <<numberslider "$settings.inflationBaileyRentPct" $settings.inflationBaileyRentPct 3 300 1 { value: v => v + "%" }>></div>
				<div class="small-description" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">거절/추적 시작 <mouse class="tooltip linkBlue">(?)<span>베일리가 거절을 받아주지 않게 되는 경제 단계를 고릅니다. 그 단계부터 거리 추적도 시작될 수 있습니다. 나중 단계일수록 쉬워집니다.</span></mouse>:<br>
					<label>초기 <<radiobutton "$settings.inflationBaileyCrisisTier" "onset" autocheck>></label> |
					<label>경기 악화 <<radiobutton "$settings.inflationBaileyCrisisTier" "bad" autocheck>></label> |
					<label>위기 <<radiobutton "$settings.inflationBaileyCrisisTier" "crisis" autocheck>></label> |
					<label>극단 <<radiobutton "$settings.inflationBaileyCrisisTier" "extreme" autocheck>></label> |
					<label>패러디 <<radiobutton "$settings.inflationBaileyCrisisTier" "parody" autocheck>></label>
				</div>
			</div>

			<div class="settingsToggleItem" data-target='["settings.inflationBaileyRelentless"]' data-disabledif="V.settings.inflationBaileyRelentless">
				<span class="gold">베일리 집세 한도</span> <mouse class="tooltip linkBlue">(?)<span>이 상한들은 베일리의 주간 집세가 얼마나 오를 수 있는지를 제한합니다.</span></mouse>
				<div class="small-description">저자산 한도 <mouse class="tooltip linkBlue">(?)<span>베일리에게 보이는 자산이 £1,000,000 미만이고 추가 집세 압박이 활성화된 동안의 집세 요구 총액 최대치입니다.</span></mouse>: <<numberslider "$settings.inflationBaileyCapLow" $settings.inflationBaileyCapLow 500000 5000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">고자산 한도 <mouse class="tooltip linkBlue">(?)<span>베일리에게 보이는 자산이 £1,000,000에서 £10,000,000 사이인 동안의 집세 요구 총액 최대치입니다.</span></mouse>: <<numberslider "$settings.inflationBaileyCapHigh" $settings.inflationBaileyCapHigh 1000000 10000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">도약 단계 한도 <mouse class="tooltip linkBlue">(?)<span>베일리에게 보이는 자산이 £10,000,000에서 £100,000,000 사이인 동안의 집세 요구 총액 최대치입니다. 특별한 "더 원한다" 요구 단계입니다.</span></mouse>: <<numberslider "$settings.inflationBaileyDemandJump" $settings.inflationBaileyDemandJump 2500000 25000000 50000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">투자 단계 한도 <mouse class="tooltip linkBlue">(?)<span>베일리에게 보이는 자산이 £100,000,000 이상인 동안의 집세 요구 총액 최대치입니다. 베일리가 플레이어를 투자 대상으로 보는 단계입니다.</span></mouse>: <<numberslider "$settings.inflationBaileyDemandInvestment" $settings.inflationBaileyDemandInvestment 5000000 100000000 50000 { value: v => formatMoney(v) }>></div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">베일리 주간 압박</span>
				<div class="small-description">주간 집세 증가폭 <mouse class="tooltip linkBlue">(?)<span>추가 집세 시작이 활성화된 동안, 납부에 성공한 주마다 베일리가 현재 집세 한도에 이를 때까지 추가로 붙이는 집세의 양입니다.</span></mouse>: <<numberslider "$settings.inflationBaileyStep" $settings.inflationBaileyStep 10000 200000 10000 { value: v => formatMoney(v) }>></div>
				<div class="small-description">연체 대출 회수 <mouse class="tooltip linkBlue">(?)<span>HBSC가 미납 대출을 연체로 표시하면 베일리가 집세에 붙이는 주간 금액입니다. 대출을 갚는 데 쓰이며 인플레이션 집세 압박과는 별개입니다.</span></mouse>: <<numberslider "$settings.inflationLoanRentSurcharge" $settings.inflationLoanRentSurcharge 50000 300000 5000 { value: v => formatMoney(v) }>></div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "rebalanceRebalancingSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				재조정 설정
				<br>
					<<link "모두 켜기">>
						<<set $tirednessMaxScalingToggle to 1>>
						<<set $stressMaxScalingToggle to 1>>
						<<set $athleticsFitnessToggle to 1>>
						<<set $fatigueSkillPenaltyToggle to 1>>

						<<set $mathsTraitBuffs.antiques to 1>>
						<<set $mathsTraitBuffs.stolen to 1>>
						<<set $mathsTraitBuffs.market to 1>>
						<<set $mathsTraitBuffs.aphrodisiacPhials to 1>>

						<<set $historyTraitBuffs.improvedChances to 1>>

						<<set $DoLPTFBuffs to 1>>
						<<set $DoLPTFTempTolerance to 1>>

						<<set $substanceRebalance to 1>>
						<<set $dancingRebalance to 1>>
						<<set $foodSpoilage to 1>>

						<<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
					<</link>>
					|
					<<link "모두 끄기">>
						<<set $tirednessMaxScalingToggle to 0>>
						<<set $stressMaxScalingToggle to 0>>
						<<set $athleticsFitnessToggle to 0>>
						<<set $fatigueSkillPenaltyToggle to 0>>

						<<set $mathsTraitBuffs.antiques to 0>>
						<<set $mathsTraitBuffs.stolen to 0>>
						<<set $mathsTraitBuffs.market to 0>>
						<<set $mathsTraitBuffs.aphrodisiacPhials to 0>>

						<<set $historyTraitBuffs.improvedChances to 0>>

						<<set $DoLPTFBuffs to 0>>
						<<set $DoLPTFTempTolerance to 0>>

						<<set $substanceRebalance to 0>>
						<<set $dancingRebalance to 0>>
						<<set $foodSpoilage to 0>>

						<<replace #subsectionDiv>><<rebalanceSettings>><</replace>>
					<</link>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">핵심 특성</span>
				<br>
				<label>
					<<checkbox "$tirednessMaxScalingToggle" 0 1 autocheck>> 피로도 최대치 스케일링 활성화 <mouse class = "tooltip linkBlue">(?)<span>피로도 최대치가 체격에 따라 늘어납니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$stressMaxScalingToggle" 0 1 autocheck>> 스트레스 최대치 스케일링 활성화 <mouse class = "tooltip linkBlue">(?)<span>의지력 시스템이 활성화된 동안에는 현재 의지력 포인트에 따라, 그렇지 않으면 일반 의지력에 따라 스트레스 최대치가 증가합니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$athleticsFitnessToggle" 0 1 autocheck>> 체육 체력 활성화 <mouse class = "tooltip linkBlue">(?)<span>체육이 피로도 증가량을 줄여 줍니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$fatigueSkillPenaltyToggle" 0 1 autocheck>> 피로 스킬 페널티 활성화 <mouse class = "tooltip linkBlue">(?)<span>피로도가 최대치의 50%를 넘으면 스킬이 약해집니다.</span></mouse>
				</label>
				<br>
				<div class="small-description numberslider-inline">피로도가 가득 찼을 때의 최대 스킬 감소량.
					<<numberslider "$fatigueSkillPenaltyMax" $fatigueSkillPenaltyMax 0 100 5 { value: (v) => v + "%" }>>
				</div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">특성 버프</span>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.antiques" 0 1 autocheck>> 골동품 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>골동품 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.stolen" 0 1 autocheck>> 장물 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>장물 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.market" 0 1 autocheck>> 시장 가판대 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>시장 가판대 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$mathsTraitBuffs.aphrodisiacPhials" 0 1 autocheck>> 최음제 약병 가격 보너스 활성화  <mouse class = "tooltip linkBlue">(?)<span>최음제 약병 가격에 수학 특성 보너스가 적용됩니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$historyTraitBuffs.improvedChances" 0 1 autocheck>> 골동품 확률 버프 활성화 <mouse class = "tooltip linkBlue">(?)<span>역사 특성이 특정 장소에서 골동품을 발견할 확률을 높입니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">동물 변이 버프·너프</span>
				<br>
				<label>
					<<checkbox "$DoLPTFBuffs" 0 1 autocheck>> 동물 변신 버프/너프 활성화 <mouse class = "tooltip linkBlue">(?)<span>각 동물 변신은 특정 능력치와 스킬에 고유한 버프와 너프를 줍니다.</span></mouse>
				</label><br>
				<label>
					<<checkbox "$DoLPTFTempTolerance" 0 1 autocheck>> 동물 변신 온도 내성 활성화 <mouse class = "tooltip linkBlue">(?)<span>각 동물 변신은 고유한 온도 내성을 가집니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">게임플레이 재조정</span>
				<br>
				<label>
					<<checkbox "$substanceRebalance" 0 1 autocheck>> 기본 게임 약물 재조정 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 술, 환각제, 최음제의 효과가 꽤 아쉽습니다. 이 설정은 그 효과를 재조정하고 확장합니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$dancingRebalance" 0 1 autocheck>> 춤 재조정 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 춤으로 안전하게 수익을 유지하며 꾸려 가기가 꽤 어렵고 골치 아픕니다. 이 재조정은 스킬이 충분히 높다면 춤을 주 수입원으로 삼아도 될 만큼 현실성 있게 만들려는 것입니다.</span></mouse>
				</label>
				<br>
				<label>
					<<checkbox "$foodSpoilage" 0 1 autocheck>> 음식 부패 활성화 <mouse class = "tooltip linkBlue">(?)<span>조리한 음식은 시간이 지나면 상합니다. 켜면 기한이 지난 음식은 버려집니다. 끄면 기한이 지나도 음식이 보관되지만, 오래된 음식은 모든 능력치 효과를 잃고 배만 채워 줍니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">수확량 <mouse class = "tooltip linkBlue">(?)<span>우유병, 송로버섯, 달걀.</span></mouse></span>
				<div class="small-description">수확물의 양을 조정합니다. 100%는 밭 수확량 500%를 기준으로 균형이 맞춰져 있습니다.
					<<numberslider "$produce_yield_factor" $produce_yield_factor 10 200 10>>
				</div>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">전투 스트레스 증가 <mouse class = "tooltip linkBlue">(?)<span>비동의 조우 중 추행당하거나 강간당하거나 굴복하게 되면서 받는 스트레스입니다. 다른 스트레스 원인은 그대로입니다.</span></mouse></span>
				<div class="small-description">비동의 전투로 인한 스트레스를 조절합니다. 조우가 길어지거나 NPC의 욕정이 높을 때 유용합니다.
					<<numberslider "$combatStressGain" $combatStressGain 25 150 5>>
				</div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "rebalanceGrindSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				반복 작업 설정
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$easyHousekeeping" 0 1 autocheck>> 쉬운 가사 활성화  <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 가사 행동마다 상한이 있어서 그 이상은 가사 스킬이 오르지 않습니다. 이 설정을 활성화하면 상한이 사라져 항상 가사 스킬이 오릅니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<label>
					<<checkbox "$danceSkillDecay" 0 1 autocheck>> 춤 스킬 유지 활성화 <mouse class = "tooltip linkBlue">(?)<span>일주일 동안 연습에 충분히 참석하지 않으면 주말에 춤 스킬이 조금 떨어집니다. 등급이 높을수록 주당 필요한 연습 횟수가 늘어납니다.</span></mouse>
				</label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">능력치 상승 배율</span>
				<br>
				<div class="small-description"><mouse class="tooltip red">능력치 상승<span>능력치 상승 배율을 100 초과로 둔 채로 두면 해당 세이브 파일에서 업적을 얻을 수 없습니다.</span></mouse> 배율. 100%는 평소와 같은 상승량을 뜻합니다.
					<<numberslider "$statGainMult" $statGainMult 10 1000 10>>
				</div>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">신사 클럽 수입</span>
				<div class="small-description">협박 퀘스트 보상 <mouse class="tooltip linkBlue">(?)<span>완료한 협박 퀘스트에 대해 신사 클럽이 지급하는 금액을 정합니다. 보통 보상에 대한 비율입니다. 퀘스트가 아무것도 지급하지 않게 하려면 0%로 설정하십시오.</span></mouse>: <<numberslider "$settings.inflationBlackmailRewardPct" $settings.inflationBlackmailRewardPct 0 100 5 { value: v => v + "%" }>></div>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "npcDoLPSettings">>
	<<if _npcDoLPTab is undefined>><<set _npcDoLPTab to "behaviour">><</if>>
	<hr>
	<div id="npcDoLPTabs" class="no-numberify"><<npcDoLPTabButtons>></div>
	<div id="npcDoLPTabContent"><<npcDoLPTabContent>></div>
<</widget>>

<<widget "npcDoLPTabButtons">>
	<div class="containerStart">
		<<npcDoLPTabButton "흥분 및 배율" "behaviour">>
		<<npcDoLPTabButton "도난 및 생성" "flavour">>
		<<npcDoLPTabButton "원혼 및 세계 덮어쓰기" "world">>
	</div>
<</widget>>

<<widget "npcDoLPTabButton">>
	<div @class="_npcDoLPTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _npcDoLPTab to _args[1]>>
			<<replace #npcDoLPTabs>><<npcDoLPTabButtons>><</replace>>
			<<replace #npcDoLPTabContent>><<npcDoLPTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "npcDoLPTabContent">>
	<<switch _npcDoLPTab>>
		<<case "flavour">><<npcDoLPFlavourSettings>>
		<<case "world">><<npcDoLPWorldSettings>>
		<<default>><<npcDoLPBehaviourSettings>>
	<</switch>>
<</widget>>

<<widget "npcDoLPBehaviourSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 다중 오르가슴
			</div>

			<div class="settingsToggleItem">
				<label>
					<<checkbox "$multiOrgasmToggle" 0 1 autocheck>> NPC 다중 오르가슴 활성화 <mouse class = "tooltip linkBlue">(?)<span>일반 NPC가 다중 오르가슴 특성이 있으면 여러 번 오르가슴에 도달할 수 있습니다.</span></mouse>
				</label>
				<span data-target="multiOrgasmToggle" data-disabledif="V.multiOrgasmToggle===0">
					<br>적용 대상:<mouse class = "tooltip linkBlue">(?)<span>성별에 따라 어떤 일반 NPC가 다중 오르가슴이 될 수 있는지 제한합니다.</span></mouse><br>
					<label><<radiobutton "$multiOrgasmGender" "all" autocheck>> 모두</label> |
					<label><<radiobutton "$multiOrgasmGender" "f" autocheck>> 여성만</label> |
					<label><<radiobutton "$multiOrgasmGender" "m" autocheck>> 남성만</label>
					<br>NPC당 확률:<mouse class = "tooltip linkBlue">(?)<span>일반 NPC가 다중 오르가슴일 확률입니다. 그런 NPC는 최소 두 번 오르가슴에 도달하며, 레벨이 높으면 더 많이 도달할 수 있습니다.</span></mouse><br>
					<<numberslider "$multiOrgasmChance" $multiOrgasmChance 0 100 1>>
				</span>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$NNPCMultiOrgasmToggle" 0 1 autocheck>> 네임드 NPC 다중 오르가슴 활성화 <mouse class = "tooltip linkBlue">(?)<span>네임드 NPC가 여러 번 오르가슴에 도달할 수 있습니다.</span></mouse>
				</label>
				<span data-target="NNPCMultiOrgasmToggle" data-disabledif="V.NNPCMultiOrgasmToggle===0">
					<br>적용 대상:<mouse class = "tooltip linkBlue">(?)<span>성별에 따라 어떤 네임드 NPC가 다중 오르가슴이 될 수 있는지 제한합니다.</span></mouse><br>
					<label><<radiobutton "$NNPCMultiOrgasmGender" "all" autocheck>> 모두</label> |
					<label><<radiobutton "$NNPCMultiOrgasmGender" "f" autocheck>> 여성만</label> |
					<label><<radiobutton "$NNPCMultiOrgasmGender" "m" autocheck>> 남성만</label>
				</span>
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$multiOrgasmLustScaling" 0 1 autocheck>> 네임드 NPC 욕정 스케일링 활성화 <mouse class = "tooltip linkBlue">(?)<span>네임드 NPC는 욕정 20마다 최대 오르가슴 횟수가 +1 오릅니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$multiOrgasmGroupDisable" 0 1 autocheck>> 그룹 조우에서 다중 오르가슴 비활성화 <mouse class = "tooltip linkBlue">(?)<span>NPC가 둘 이상으로 시작하는 동시 조우는 단체 오르가슴 한 번으로만 끝날 수 있습니다. 단독 조우와 순차적 짐승 조우는 여전히 NPC, 네임드 NPC, 짐승의 다중 오르가슴 설정을 따릅니다.</span></mouse>
				</label>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				네임드 NPC 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">네임드 NPC 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$nnpcHealthMult" $nnpcHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">네임드 NPC 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$nnpcArousalMult" $nnpcArousalMult>>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>인간 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$npcHealthMult" $npcHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>인간 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$npcArousalMult" $npcArousalMult>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "npcDoLPFlavourSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 금품 갈취 설정
			</div>

			<div class="settingsToggleItem">
				<<checkbox "$npcStealMoneyToggle" 0 1 autocheck>> NPC의 금품 갈취 활성화.
				<mouse class="tooltip linkBlue">(?)<span>현금과 카드 도난은 기존 조우 규칙을 공유합니다. 차분한 연애 상대는 이를 일으킬 수 없습니다.</span></mouse>
			</div>

			<div class="settingsToggleItem">
				<<checkbox "$npcStealMoneyRandomToggle" 0 1 autocheck>> 갈취 비율을 무작위로 정합니다.
				<mouse class="tooltip linkBlue">(?)<span>고정 금액 대신 아래의 최소/최대 비율을 사용합니다.</span></mouse>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">고정 현금 도난 (%)
				<mouse class="tooltip linkBlue">(?)<span>소지한 현금의 비율입니다. 저축과 정기 예금은 현금이 아닙니다.</span></mouse>
				</span>
				<<numberslider "$npcStealMoneyPercentage" $npcStealMoneyPercentage 1 100 1>>
			</div>
			<div class="settingsToggleItem">
				프리셋:
				<<link "쉬움">><<run setup.hbsc.setTheftPreset("easy")>><<displayDoLP "npcDoLPSettings">><</link>> |
				<<link "보통">><<run setup.hbsc.setTheftPreset("normal")>><<displayDoLP "npcDoLPSettings">><</link>> |
				<<link "어려움">><<run setup.hbsc.setTheftPreset("hard")>><<displayDoLP "npcDoLPSettings">><</link>>
				<br>보통: 현금 1-25%, 카드 도난 확률 5%, 주간 카드 한도 &pound;100.
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">무작위 현금 도난 최소 (%)</span>
				<<numberslider "$npcStealMoneyMin" $npcStealMoneyMin 1 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">무작위 현금 도난 최대 (%)</span>
				<<numberslider "$npcStealMoneyMax" $npcStealMoneyMax 1 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">강도당할 때 카드 도난 확률 (%)</span>
				<<numberslider "$npcStealCardChance" $npcStealCardChance 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">도난 카드 주간 한도 (&pound;)</span>
				<<numberslider "$npcStealCardWeeklyLimit" $npcStealCardWeeklyLimit 0 1000 1>>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 분위기 생성 설정
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 묘사 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 묘사가 레벨에 묶여 있어서 레벨 스케일링이 매우 높으면 모든 NPC가 악마로 나타날 수 있습니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcDescGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcDescGenType" "randomized" autocheck>></label>
				<br>
				<<checkbox "$npcDescDemonDisable" 0 1 autocheck>> 악마 묘사 비활성화.
				<mouse class="tooltip linkBlue">(?)<span>악마와 하급 악마 묘사가 나오지 않게 합니다.</span></mouse>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 가슴 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 가슴 크기가 레벨에 묶여 있어서 레벨 스케일링이 매우 높으면 모든 NPC의 가슴이 거대해질 수 있습니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcBreastGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcBreastGenType" "randomized" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">NPC 자지 생성</span> <mouse class = "tooltip linkBlue">(?)<span>기본 게임에서는 레벨 19-20의 NPC는 자지가 반드시 최대 크기입니다. 무작위를 고르면 이를 완전히 무작위로 정합니다.</span></mouse>
				<br>
				<label>기본 게임 <<radiobutton "$npcPenisGenType" "vanilla" autocheck>></label> |
				<label>무작위 <<radiobutton "$npcPenisGenType" "randomized" autocheck>></label>
				<br>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "npcDoLPWorldSettings">>
	<<wliSettings>>
	<<worldGenderOverrideSettings>>
<</widget>>


<<widget "beastDoLPSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 다중 오르가슴
			</div>

			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$beastMultiOrgasmToggle" 0 1 autocheck>> 짐승 다중 오르가슴 활성화 <mouse class = "tooltip linkBlue">(?)<span>짐승이 여러 번 오르가슴에 도달할 수 있습니다.</span></mouse>
				</label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 단체
			</div>
			<div class="settingsToggleItemWide">
				<label>
					<<checkbox "$beastGroupFight" 0 1 autocheck>> 짐승 단체 활성화  <mouse class = "tooltip linkBlue">(?)<span>활성화하면 여러 짐승과의 조우가 단체 성교와 같은 방식으로 진행됩니다.</span></mouse>
				</label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">짐승 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>짐승 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$beastHealthMult" $beastHealthMult>>
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">짐승 최대 흥분 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>짐승 적의 최대 흥분에 곱해집니다. 범위 1 - 1000000</span></mouse>
				</span>
				<<numberbox "$beastArousalMult" $beastArousalMult>>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				촉수 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">촉수 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>촉수 하나하나의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$tentacleHealthMult" $tentacleHealthMult>>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				발버둥(럴커, 벌 등) 배율
			</div>

			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">발버둥 최대 체력 배율 (%)
				<mouse class="tooltip linkBlue">(?)<span>발버둥 적의 최대 체력에 곱해집니다. 범위 1 - 1000000.</span></mouse> <span class="red">100 미만으로 설정하면 업적이 비활성화됩니다.</span>
				</span>
				<<numberbox "$struggleHealthMult" $struggleHealthMult>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "xchangeSettings">>
	<<if _xchangeTab is undefined>><<set _xchangeTab to "core">><</if>>
	<hr>
	<div id="xchangeTabs" class="no-numberify"><<xchangeTabButtons>></div>
	<div id="xchangeTabContent"><<xchangeTabContent>></div>
<</widget>>

<<widget "xchangeTabButtons">>
	<div class="containerStart">
		<<xchangeTabButton "핵심 설정" "core">>
		<<xchangeTabButton "몰래 먹이기 선호" "spiking">>
		<<xchangeTabButton "성별 반전 외모" "appearance">>
		<<xchangeTabButton "알약 효과" "effects">>
	</div>
<</widget>>

<<widget "xchangeTabButton">>
	<div @class="_xchangeTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'">
		<<button _args[0]>>
			<<set _xchangeTab to _args[1]>>
			<<replace #xchangeTabs>><<xchangeTabButtons>><</replace>>
			<<replace #xchangeTabContent>><<xchangeTabContent>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "xchangeTabContent">>
	<<switch _xchangeTab>>
		<<case "spiking">><<xchangeSpikingSettings>>
		<<case "appearance">><<xchangeAppearanceSettings>>
		<<case "effects">><<xchangeEffectSettings>>
		<<default>><<xchangeCoreSettings>>
	<</switch>>
<</widget>>

<<widget "xchangeCoreSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">

			<div class="settingsToggleItem">
				<span class="gold bold">알약 동작:</span><br>
				<label><<checkbox "$xchange.pillPermanence" 0 1 autocheck>> 알약 영구화 활성화</label> <mouse class="tooltip linkBlue">(?)<span>비활성화하면 알약의 작용이 더 이상 영구화로 이어지지 않습니다. 대신 지속 시간이 크게 늘어나거나 알약 타이머가 멈춥니다.</span></mouse><br>
				<label><<checkbox "$xchangeStatSplit" false true autocheck>> 음란 스탯 분리 활성화</label> <mouse class="tooltip linkBlue">(?)<span>켜면 음란 스탯(음란, 노출증, 이상성욕)이 몸마다 따로 기록됩니다. 새 몸은 자신만의 음란 스탯으로 시작하고, 이전 몸으로 돌아가면 그 몸의 값이 복원됩니다. 스탯이 합쳐지는 일은 없습니다.</span></mouse><br>
				<label><<checkbox "$xchange.grayPillGenderflip" 0 1 autocheck>> 그레이 알약이 성별도 뒤집음</label> <mouse class="tooltip linkBlue">(?)<span>그레이 X-체인지 알약은 보통 몸을 바꾸지 않고 특수 효과만 더합니다. 이 설정을 켜면 아직 변신하지 않은 상태에서 그레이 알약을 먹을 때 성기도 바뀌고, 바뀐 몸에 효과가 적용됩니다.</span></mouse><br>
				<label><<checkbox "$xchange.bodyAdjustmentEnabled" 0 1 autocheck>> 몸이 바뀐 뒤 적응 기간</label> <mouse class="tooltip linkBlue">(?)<span>알약으로 몸이 바뀌거나 원래 몸으로 돌아온 뒤, 익숙해질 때까지 체격, 체육, 수영, 춤, 속임수가 낮아집니다. 떠나온 몸에서 오래 살았을수록 하락 폭이 크고 사라지는 데 걸리는 시간도 깁니다. 한 몸에서 이틀 미만이면 하락이 없습니다. 두 달 이상이면 30% 하락하며 2주에 걸쳐 사라집니다.</span></mouse><br>
				<label><<checkbox "$xchange.npcPillChangesGender" 0 1 autocheck>> 알약이 NPC의 성별도 바꿈</label> <mouse class="tooltip linkBlue">(?)<span>켜면 성별 전환 알약이 NPC의 신체적 성과 성별을 모두, 대명사와 묘사까지 바꿉니다. 끄면 신체적 성만 바뀝니다. 무작위 NPC와 네임드 NPC 모두에 적용됩니다.</span></mouse><br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">몰래 먹이기 규칙:</span><br>
				<label><<checkbox "$xchange.nonconEnabled" 0 1 autocheck>> 비동의 알약 몰래 먹이기 활성화 </label> <mouse class="tooltip linkBlue">(?)<span>NPC가 명시적 동의 없이 X-체인지 알약을 몰래 먹일 수 있게 합니다. 참고: 이 설정은 네임드 NPC에게는 영향을 주지 않습니다.</span></mouse><br>
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikeSideEffectsEnabled" 0 1 autocheck>> 수상한 알약에 부작용 있음</label> <mouse class="tooltip linkBlue">(?)<span>켜면 몰래 먹인 알약은 모두 추가 부작용도 일으킵니다. 술집, 전투 등 모든 몰래 먹이기에 적용됩니다. 끄면 몰래 먹인 알약이 보통 효과만 일으키는 예전 동작으로 돌아갑니다.</span></mouse><br>
				<label><<checkbox "$xchange.disregardGender" 0 1 autocheck>> 성별 조건 무시 </label> <mouse class="tooltip linkBlue">(?)<span>일부 알약 장면은 보통 PC가 특정 성별이어야 합니다. 이 설정은 그 조건을 없앱니다. 장면이 PC와 NPC가 같은 성별이어야 한다면, 대신 25% 확률로 알약이 사용됩니다.<br><br>에이버리는 이 설정이 켜져 있을 때만 데이트 중에 알약을 강요합니다. 에이버리의 저택으로 이사할 때의 초이스 알약은 영향을 받지 않습니다.</span></mouse><br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">외모:</span><br>
				<label><<checkbox "$xchange.faceChangesEnabled" 0 1 autocheck>> 알약으로 인한 얼굴 변화 활성화 </label> <mouse class="tooltip linkBlue">(?)<span>켜면 처음 성별을 바꿀 때 PC의 얼굴 스타일이 바뀔 수 있습니다. 이 설정은 주로 그래픽 모드를 쓰면서 파일을 필요 이상으로 만지고 싶지 않은 플레이어를 위한 것입니다.</span></mouse><br>

				<label><<checkbox "$xchange.useHermBalls" 0 1 autocheck>> 퍼플 알약 복용자는 고환이 있음</label> <mouse class="tooltip linkBlue">(?)<span>헤름이 되는 알약을 먹을 때 고환을 갖게 될지 정합니다.</span></mouse><br>

				<label><<checkbox "$xchange.chastityKeepBeltShape" 0 1 autocheck>> 성별이 바뀌어도 정조대 모양 유지</label> <mouse class="tooltip linkBlue">(?)<span>켜면 몸이 남성이 되어도 정조대가 케이지로 바뀌지 않고 정조대 모양을 유지합니다. 정조대는 남성의 몸도 문제없이 잠그므로, 원래 고른 장치가 그대로 유지됩니다. 끄면 남성이 될 때 정조대가 케이지로 바뀌는 예전 동작으로 돌아갑니다. 참고: 케이지는 질을 감쌀 수 없으므로, 질이 생기면 케이지는 항상 정조대로 모양이 바뀌고, 질을 잃으면 다시 케이지로 돌아옵니다.</span></mouse><br>

				<br>
				<<run setup.xChangeEnsureBodySizeSettings?.()>>
				<div class="xchangeBodySizeLimits">
					<span class="gold bold">성별 전환 후 체형 크기 한도:</span> <mouse class="tooltip linkBlue">(?)<span>알약으로 얻는 몸이 생성되는 크기 범위입니다. 끄면 X-체인지 몸은 대신 당신 자신의 신체 부위 크기 한도를 사용합니다.<br><br>현재 몸은 이미 가진 크기를 유지합니다. 변화는 다음에 알약이 몸을 만들거나 되돌릴 때 나타납니다.<br><br>부위를 키우는 알약은 이 한도로 나온 크기 위에 성장을 더합니다.</span></mouse>
					<br>
					<label><span>X-체인지 몸에 별도 한도 사용</span> <<checkbox "$xchange.bodySizeLimitsEnabled" 0 1 autocheck>></label>
					<div data-target="xchange.bodySizeLimitsEnabled" data-disabledif="!V.xchange.bodySizeLimitsEnabled">
					<span class="gold">가슴 크기 한도:</span>
					<<rangeslider "$xchange.bodyBreastSizeMin" "$xchange.bodyBreastSizeMax" $xchange.bodyBreastSizeMin $xchange.bodyBreastSizeMax 0 12 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 12, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 12, 0));
								var name = ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					<br>
					<span class="gold">엉덩이 크기 한도:</span>
					<<rangeslider "$xchange.bodyBottomSizeMin" "$xchange.bodyBottomSizeMax" $xchange.bodyBottomSizeMin $xchange.bodyBottomSizeMax 0 8 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 8, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 8, 0));
								var name = ["납작한", "아담한", "둥근", "부드러운", "통통한", "꽉 찬", "풍만한", "큰", "거대한"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					<br>
					<span class="gold">자지 크기 한도:</span>
					<<rangeslider "$xchange.bodyPenisSizeMin" "$xchange.bodyPenisSizeMax" $xchange.bodyPenisSizeMin $xchange.bodyPenisSizeMax 0 6 1
						{}
						{
							value: (v1, v2) => {
								const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 6, 0));
								const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 6, 0));
								var name = ["초소형", "매우 작은", "아주 작은", "작은", "보통", "큰", "엄청난"];
								return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
							},
						}
					>>
					</div>
				</div>

				<<set _xchangeActiveHermMismatch to playerIsXChanged() and $xchange.pill and $xchange.pill.hermEffect and (!$player.penisExist or !$player.vaginaExist or !["m", "f"].includes($player.sex))>>
				<<set _xchangeStoredOriginalSexMismatch to false>>
				<<set _xchangeStoredOriginalSexCanApply to false>>
				<<if playerIsXChanged() and $xchange.pill and $xchange.pill.originalBody and ($xchange.pill.originalBody.sex is undefined or !["m", "f"].includes($xchange.pill.originalBody.sex))>>
					<<set _xchangeStoredOriginalSexMismatch to true>>
					<<set _xchangeStoredOriginalSexCanApply to ($xchange.pill.originalBody.penisExist is true and $xchange.pill.originalBody.vaginaExist isnot true) or ($xchange.pill.originalBody.vaginaExist is true and $xchange.pill.originalBody.penisExist isnot true)>>
				<</if>>
				<<set _xchangeOldSaveGenitalMismatchNPC to []>>
				<<for _xchangeOldSaveNPCIndex to 0; _xchangeOldSaveNPCIndex lt $NPCName.length; _xchangeOldSaveNPCIndex++>>
					<<set _xchangeOldSaveNPC to $NPCName[_xchangeOldSaveNPCIndex]>>
					/* Poppy can retain a legacy fetus array after migration. Neither pregnancy model may contain an active pregnancy before offering anatomy recovery. */
					<<if $passage isnot "Start" and _xchangeOldSaveNPC and _xchangeOldSaveNPC.pregnancy and _xchangeOldSaveNPC.pregnancy.enabled isnot undefined and Array.isArray(_xchangeOldSaveNPC.pregnancy.fetus) and !_xchangeOldSaveNPC.pregnancy.fetus.length and !getActivePregnancies(_xchangeOldSaveNPC.nam).length>>
						<<if _xchangeOldSaveNPC.gender is "f" and (_xchangeOldSaveNPC.vagina is undefined or _xchangeOldSaveNPC.vagina is "none" or _xchangeOldSaveNPC.penis isnot "none")>>
							<<set _xchangeOldSaveGenitalMismatchNPC.push(_xchangeOldSaveNPCIndex)>>
						<<elseif _xchangeOldSaveNPC.gender is "m" and (_xchangeOldSaveNPC.penis is undefined or _xchangeOldSaveNPC.penis is "none" or _xchangeOldSaveNPC.vagina isnot "none")>>
							<<set _xchangeOldSaveGenitalMismatchNPC.push(_xchangeOldSaveNPCIndex)>>
						<</if>>
					<</if>>
				<</for>>
				<<if _xchangeActiveHermMismatch or _xchangeStoredOriginalSexMismatch or _xchangeOldSaveGenitalMismatchNPC.length>>
					<br>
					<span class="gold bold">오래된 세이브 복구:</span><br>
					<<if _xchangeActiveHermMismatch>>
						<span class="red">활성 헤름 X-체인지 성기 불일치가 감지되었습니다.</span>
						<<link "활성 헤름 성기 적용">>
							<<set $player.sex to "m">>
							<<set $player.penisExist to true>>
							<<set $player.vaginaExist to true>>
							<<set $player.ballsExist to $xchange.useHermBalls eq 1>>
							<<updatesidebarimg>>
							<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
						<</link>><br>
					<</if>>
					<<if _xchangeStoredOriginalSexMismatch>>
						<span class="red">저장된 알약 복용 전 X-체인지 성별이 올바르지 않습니다.</span>
						<<if _xchangeStoredOriginalSexCanApply>>
							<<link "저장된 성기로부터 저장된 복용 전 성별 적용">>
								<<if $xchange.pill.originalBody.penisExist is true and $xchange.pill.originalBody.vaginaExist isnot true>>
									<<set $xchange.pill.originalBody.sex to "m">>
									<<set $xchange.pill.baseSex to "m">>
								<<elseif $xchange.pill.originalBody.vaginaExist is true and $xchange.pill.originalBody.penisExist isnot true>>
									<<set $xchange.pill.originalBody.sex to "f">>
									<<set $xchange.pill.baseSex to "f">>
								<</if>>
								<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
							<</link>>
						<<else>>
							저장된 복용 전 몸에는 원래 성별이 남성이었는지 여성이었는지 기록되어 있지 않습니다. 이 세이브를 내보내서 보고해 주십시오.
						<</if>><br>
					<</if>>
					<<if _xchangeOldSaveGenitalMismatchNPC.length>>
						<span class="red"><<= _xchangeOldSaveGenitalMismatchNPC.map(npcIndex => $NPCName[npcIndex].nam).join(", ") >>의 NPC 성기 불일치가 감지되었습니다.</span>
						<<capture _xchangeOldSaveGenitalMismatchNPC>>
							<<link "선택한 성기를 이 NPC들에게 적용">>
								<<for _xchangeOldSaveNPCIndex range _xchangeOldSaveGenitalMismatchNPC>>
									<<set _xchangeOldSaveNPC to $NPCName[_xchangeOldSaveNPCIndex]>>
									<<if _xchangeOldSaveNPC.gender is "f">>
										<<set _xchangeOldSaveNPC.vagina to (_xchangeOldSaveNPC.type isnot "human" ? 0 : "clothed")>>
										<<set _xchangeOldSaveNPC.penis to "none">>
									<<elseif _xchangeOldSaveNPC.gender is "m">>
										<<set _xchangeOldSaveNPC.penis to (_xchangeOldSaveNPC.type isnot "human" ? 0 : "clothed")>>
										<<set _xchangeOldSaveNPC.vagina to "none">>
									<</if>>
								<</for>>
								<<replace "#subsectionDiv">><<xchangeSettings>><</replace>>
							<</link>>
						<</capture>>
					<</if>>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold bold">전투 중 알약:</span><br>
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.combatPillingEnabled" 0 1 autocheck>> 전투 중 알약 투여 활성화</label> <mouse class="tooltip linkBlue">(?)<span>NPC가 비동의 조우 중에 당신에게 알약을 먹이려 할 수 있습니다.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.restrictedSexCombatPilling" 0 1 autocheck>> 전투 중 알약을 같은 성별 NPC로 제한</label> <mouse class="tooltip linkBlue">(?)<span>원래 성별이 당신의 원래 성별과 같은 NPC만 비동의 조우 중에 당신에게 알약을 먹이려 합니다. 즉, 당신의 원래 성별이 남성이면 남성만 알약을 먹이려 합니다.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.NNPCcombatPillingEnabled" 0 1 autocheck>> 네임드 NPC의 비동의 전투 알약 투여 허용</label> <mouse class="tooltip linkBlue">(?)<span>네임드 NPC가 조우 중에 당신에게 알약을 먹이는 것을 허용합니다.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.combatPillingIfPilled" 0 1 autocheck>> 이미 알약을 먹은 상태에서도 전투 알약 허용</label> <mouse class="tooltip linkBlue">(?)<span>NPC가 현재 알약 위에 효과를 더 쌓을 수 있습니다.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled"><<checkbox "$xchange.combatPillingBeastsEnabled" 0 1 autocheck>> 짐승이 전투 알약을 가질 수 있음</label> <mouse class="tooltip linkBlue">(?)<span>켜면 수인을 포함한 모든 짐승형 적이 조우 중 X-체인지 알약을 가질 수 있습니다. 끄고 아래 옵션을 쓰면 수인에게만 허용할 수 있습니다.</span></mouse><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled", "xchange.combatPillingBeastsEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled || !!V.xchange.combatPillingBeastsEnabled"><<checkbox "$xchange.combatPillingMonsterPeopleEnabled" 0 1 autocheck>> 수인이 전투 알약을 가질 수 있음</label> <mouse class="tooltip linkBlue">(?)<span>켜면 일반 짐승이 가질 수 없을 때에도 수인은 조우 중 X-체인지 알약을 가질 수 있습니다. 짐승을 수인으로 대체하는 중이 아니면 효과가 없습니다.</span></mouse><br>

				<label><<checkbox "$whackRandom" false true autocheck>> 쳐내기 행동이 실패할 수 있음</label> <mouse class="tooltip linkBlue">(?)<span>NPC의 손에서 도구와 알약을 쳐내려는 시도가 높은 흥분과 낮은 의지력 때문에 실패할 수 있습니다.</span></mouse><br>
				<br>
				<span class="gold bold">전투 조정:</span><br>
				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>NPC 알약 확률:</span><mouse class="tooltip linkBlue">(?)<span>대상이 되는 NPC 각각이 X-체인지 알약을 가질 확률입니다. 조우가 시작될 때 NPC마다 한 번 굴립니다. 0%면 알약을 가진 NPC가 없고, 100%면 대상 NPC 모두가 하나씩 가집니다.</span></mouse>
					<<numberslider "$xchange.combatPillingChance" $xchange.combatPillingChance 0 100 5>>
				</label><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>턴당 사용 확률:</span><mouse class="tooltip linkBlue">(?)<span>NPC가 알약을 가지고 있을 때, 유효한 전투 턴마다 그것을 사용할 확률입니다. 값이 높을수록 더 빨리 사용합니다.</span></mouse>
					<<numberslider "$xchange.combatPillingDrawChance" $xchange.combatPillingDrawChance 1 50 1>>
				</label><br>

				<label data-target='["xchange.nonconEnabled", "xchange.combatPillingEnabled"]' data-disabledif="!V.xchange.nonconEnabled || !V.xchange.combatPillingEnabled">
					<span>깨끗한 알약 비율:</span> <mouse class="tooltip linkBlue">(?)<span>전투 알약에 무작위 추가 효과나 부작용이 없을 확률입니다. 실패하면 수상한 알약이 됩니다.</span></mouse>
					<<numberslider "$xchange.combatPillingPureRatio" $xchange.combatPillingPureRatio 0 100 5>>
				</label>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeSpikingSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="small-description">체크박스를 선택해 각 알약 효과를 켜거나 끄고, 슬라이드 바로 몰래 먹일 때 각 효과가 나올 상대적 빈도를 조정하십시오.</span>

			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.herm" 0 1 autocheck>> <span>퍼플(헤름):</span></label> <mouse class="tooltip linkBlue">(?)<span>두 성별의 특징을 섞어서 주며, 두 종류의 성기도 함께 갖게 합니다.</span></mouse>
				<<numberslider "$xchange.spikerates.herm" $xchange.spikerates.herm 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.crossdresser" 0 1 autocheck>> <span>시시 / 부치:</span></label> <mouse class="tooltip linkBlue">(?)<span>완전히 성을 바꾸지 않고 이성처럼 보이게 합니다. 더 가혹한 스트레스 페널티로 이성 복장을 유도합니다.</span></mouse>
				<<numberslider "$xchange.spikerates.crossdress" $xchange.spikerates.crossdress 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.bull" 0 1 autocheck>> <span>불:</span></label> <mouse class="tooltip linkBlue">(?)<span>유난히 정력이 넘치게 합니다. 거의 확실하게 임신시킵니다.</span></mouse>
				<<numberslider "$xchange.spikerates.bull" $xchange.spikerates.bull 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.breeder" 0 1 autocheck>> <span>브리더:</span></label> <mouse class="tooltip linkBlue">(?)<span>질 안에 정자가 없으면 오르가슴에 도달하지 못하게 합니다. 질내사정을 당하면 정말 좋습니다. 질 속에 정자가 있는 동안 스트레스가 줄어듭니다. 가임력이 임신을 거의 확실하게 만듭니다. <b>자궁과 질이 있는 동안에만 작동합니다.</b></span></mouse>
				<<numberslider "$xchange.spikerates.breeder" $xchange.spikerates.breeder 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.resistance" 0 1 autocheck>> <span>레지스턴스:</span></label> <mouse class="tooltip linkBlue">(?)<span>오르가슴마다 알약이 영구화될 가능성이 높아집니다(영구화가 꺼져 있으면 한 달 내내 지속). 컨티뉴 효과와는 함께 쓸 수 없습니다.</span></mouse>
				<<numberslider "$xchange.spikerates.resistance" $xchange.spikerates.resistance 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.continue" 0 1 autocheck>> <span>컨티뉴:</span></label> <mouse class="tooltip linkBlue">(?)<span>오르가슴마다 알약의 지속 시간이 늘어납니다. 레지스턴스 효과와는 함께 쓸 수 없습니다.</span></mouse>
				<<numberslider "$xchange.spikerates.continue" $xchange.spikerates.continue 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.passion" 0 1 autocheck>> <span>패션:</span></label> <mouse class="tooltip linkBlue">(?)<span>매시간 무작위로 최음제를 혈류에 주입합니다.</span></mouse>
				<<numberslider "$xchange.spikerates.passion" $xchange.spikerates.passion 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$portalPantiesEnabled" 0 1 autocheck>> <span>포털:</span></label> <mouse class="tooltip linkBlue">(?)<span>몰래 먹이기 목록에 특별한 알약 효과를 추가합니다. 적용되면 이 효과로 무작위 NPC가 상황과 관계없이 반쯤 무작위 간격으로 원격에서 몰래 당신을 박을 수 있습니다. <br><br><b>경고:</b> 막거나 피할 방법 없이 처녀를 잃거나 임신할 수 있습니다.</span></mouse>
				<<numberslider "$xchange.spikerates.portal" $xchange.spikerates.portal 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.dumbbitch" 0 1 autocheck>> <span>멍청한 암캐:</span></label> <mouse class="tooltip linkBlue">(?)<span>오르가슴마다 학업 성적이 떨어지고, 이어서 악의(속임수)와 의지력이 떨어집니다. 그것들이 거의 남지 않으면 마침내 성적 강박을 얻습니다.</span></mouse>
				<<numberslider "$xchange.spikerates['dumb-bitch']" $xchange.spikerates['dumb-bitch'] 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.innocence" 0 1 autocheck>> <span>순수:</span></label> <mouse class="tooltip linkBlue">(?)<span>이 알약의 영향을 받는 동안 성에 대한 지식이 머릿속에서 모두 지워집니다.</span></mouse>
				<<numberslider "$xchange.spikerates.innocence" $xchange.spikerates.innocence 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.feartoxin" 0 1 autocheck>> <span>공포 독소:</span></label> <mouse class="tooltip linkBlue">(?)<span>지속되는 동안 트라우마를 최대로, 통제력을 0으로 유지합니다. 끝나도 어느 쪽 수치도 복원되지 않으므로 오래 투여하면 정신을 잃을 수 있습니다. 순수와 함께 나오지 않습니다.</span></mouse>
				<<numberslider "$xchange.spikerates.feartoxin" $xchange.spikerates.feartoxin 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.swell" 0 1 autocheck>> 부풀기</label> <mouse class="tooltip linkBlue">(?)<span>지속되는 동안 가슴과 엉덩이(핑크) 또는 자지(블루)의 크기가 커집니다.</span></mouse>
				<<numberslider "$xchange.spikerates.swell" $xchange.spikerates.swell 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.bimbo" 0 1 autocheck>> 빔보</label> <mouse class="tooltip linkBlue">(?)<span>지능을 떨어뜨리고 음란함을 높이며, 빔보 알약에 내장된 부풀기 효과를 적용합니다.</span></mouse>
				<<numberslider "$xchange.spikerates.bimbo" $xchange.spikerates.bimbo 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.cumcure" 0 1 autocheck>> 컴큐어</label> <mouse class="tooltip linkBlue">(?)<span>정액이 몸 안에 쏟아질 때마다 변신의 지속 시간이 줄어듭니다.</span></mouse><br>
				<<numberslider "$xchange.spikerates.cumcure" $xchange.spikerates.cumcure 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.fertility" 0 1 autocheck>> 하이퍼 퍼틸리티</label>	<mouse class="tooltip linkBlue">(?)<span>임신 속도를 높이고 쌍둥이, 세쌍둥이, 네쌍둥이가 될 확률을 높입니다. 당신이 품는 임신과 당신이 일으키는 임신 모두에 적용됩니다. 기생충 및 비인간형 임신의 속도도 높입니다.</span></mouse><br>
				<<numberslider "$xchange.spikerates.fertility" $xchange.spikerates.fertility 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.omega" 0 1 autocheck>> 오메가</label> <mouse class="tooltip linkBlue">(?)<span>오메가 작용제를 적용합니다. 항문 임신이 가능해지고 항문 사정 중 쾌감이 높아집니다. 어떤 몸에서든 작동합니다.</span></mouse><br>
				<<numberslider "$xchange.spikerates.omega" $xchange.spikerates.omega 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.alpha" 0 1 autocheck>> 알파</label> <mouse class="tooltip linkBlue">(?)<span>알파 작용제를 적용합니다. 매듭이 있는 자지가 생기고, 사정하기 전에 상대 안에 파묻히고 싶은 충동이 듭니다. <b>자지가 있을 때만 나옵니다.</b></span></mouse><br>
				<<numberslider "$xchange.spikerates.alpha" $xchange.spikerates.alpha 1 10 1>>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["xchange.nonconEnabled"]' data-disabledif="!V.xchange.nonconEnabled"><<checkbox "$xchange.spikepool.beta" 0 1 autocheck>> 베타</label> <mouse class="tooltip linkBlue">(?)<span>베타 작용제를 적용합니다. 독립적인 임신을 품을 수 있는 두 번째 자궁이 생깁니다. <b>질이 있을 때만 나옵니다.</b></span></mouse><br>
				<<numberslider "$xchange.spikerates.beta" $xchange.spikerates.beta 1 10 1>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeAppearanceSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">성별 전환 후 눈 색:</span><br>
				<label><span>이전과 같음</span> <<radiobutton "$xchange.customisedEyeColour" "nochange" autocheck>></label> |
				<label><span class="black">검정</span> <<radiobutton "$xchange.customisedEyeColour" "black" autocheck>></label> |
				<label><span class="purple">보라</span> <<radiobutton "$xchange.customisedEyeColour" "purple" autocheck>></label> |
				<label><span class="blue">짙은 파랑</span> <<radiobutton "$xchange.customisedEyeColour" "dark blue" autocheck>></label> |
				<label><span class="lblue">밝은 파랑</span> <<radiobutton "$xchange.customisedEyeColour" "light blue" autocheck>></label> |
				<label><span class="tangerine">호박색</span> <<radiobutton "$xchange.customisedEyeColour" "amber" autocheck>></label> |
				<label><span class="brown">헤이즐</span> <<radiobutton "$xchange.customisedEyeColour" "hazel" autocheck>></label> |
				<label><span class="green">초록</span> <<radiobutton "$xchange.customisedEyeColour" "green" autocheck>></label> |
				<label><span class="lime-green">연두</span> <<radiobutton "$xchange.customisedEyeColour" "lime green" autocheck>></label> |
				<label><span class="red">빨강</span> <<radiobutton "$xchange.customisedEyeColour" "red" autocheck>></label> |
				<label><span class="pink">분홍</span> <<radiobutton "$xchange.customisedEyeColour" "pink" autocheck>></label> |
				<label><span class="grey">회색</span> <<radiobutton "$xchange.customisedEyeColour" "grey" autocheck>></label> |
				<label><span class="light-grey">연회색</span> <<radiobutton "$xchange.customisedEyeColour" "light grey" autocheck>></label> |
				<label><span>무작위</span> <<radiobutton "$xchange.customisedEyeColour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold bold">성별 전환 후 머리 색:</span><br>
				<label><span>이전과 같음</span> <<radiobutton "$xchange.customisedHairColour" "nochange" autocheck>></label> |
				<<for _i to 0; _i < setup.colours.hair.length; _i++>>
					<<if setup.colours.hair[_i].variable isnot "random" and (setup.colours.hair[_i].natural or setup.colours.hair[_i].dye)>>
						<label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiobutton "$xchange.customisedHairColour" setup.colours.hair[_i].variable autocheck>></label> |
					<</if>>
				<</for>>
				<label><span>무작위</span> <<radiobutton "$xchange.customisedHairColour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold bold">성별 전환 후 태도:</span> <mouse class="tooltip linkBlue">(?)<span>X-체인지 알약으로 몸이 바뀐 동안 다른 사람과 말하는 방식을 바꿉니다. 원래 몸으로 돌아오면 원래 태도도 돌아옵니다.</span></mouse><br>
				<label><span>이전과 같음</span> <<radiobutton "$xchange.customisedDemeanour" "nochange" autocheck>></label> |
				<label><span class="pink">온순</span> <<radiobutton "$xchange.customisedDemeanour" "docile" autocheck>></label> |
				<label><span class="meek">순종적</span> <<radiobutton "$xchange.customisedDemeanour" "meek" autocheck>></label> |
				<label><span class="purple">수줍음</span> <<radiobutton "$xchange.customisedDemeanour" "shy" autocheck>></label> |
				<label><span class="blue">공손</span> <<radiobutton "$xchange.customisedDemeanour" "polite" autocheck>></label> |
				<label><span>중립</span> <<radiobutton "$xchange.customisedDemeanour" "neutral" autocheck>></label> |
				<label><span class="teal">자신감</span> <<radiobutton "$xchange.customisedDemeanour" "confident" autocheck>></label> |
				<label><span class="brat">반항적</span> <<radiobutton "$xchange.customisedDemeanour" "bratty" autocheck>></label> |
				<label><span class="red">잔혹</span> <<radiobutton "$xchange.customisedDemeanour" "cruel" autocheck>></label> |
				<label><span class="pink">화려함</span> <<radiobutton "$xchange.customisedDemeanour" "flamboyant" autocheck>></label> |
				<label><span class="gold">특별</span> <<radiobutton "$xchange.customisedDemeanour" "special" autocheck>></label> |
				<label><span class="lustful">변덕스러움</span> <<radiobutton "$xchange.customisedDemeanour" "capricious" autocheck>></label> |
				<label><span class="lustful">오락가락</span> <<radiobutton "$xchange.customisedDemeanour" "fickle" autocheck>></label> |
				<label><span>무작위</span> <<radiobutton "$xchange.customisedDemeanour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItem">
				<<set _xchangeSkinShade to ["light", "medium", "dark", "gyaru"].find(shade => ($xchange?.customisedSkinColour || "").endsWith(shade))>>
				<<if _xchangeSkinShade>>
					<<set _xchangeSkinTone to $xchange.customisedSkinColour.slice(0, -_xchangeSkinShade.length)>>
				<<else>>
					<<set _xchangeSkinTone to "no">>
					<<set _xchangeSkinShade to "change">>
				<</if>>
				<span class="gold bold">성별 전환 후 피부 톤:</span><br>
				<label>이전과 같음 <<radiovar "_xchangeSkinTone" "no">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |<br>
				<label>중립 <<radiovar "_xchangeSkinTone" "">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>따뜻함 <<radiovar "_xchangeSkinTone" "r">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>황금빛 <<radiovar "_xchangeSkinTone" "g">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>올리브 <<radiovar "_xchangeSkinTone" "y">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label>차가움 <<radiovar "_xchangeSkinTone" "b">><<xchangeSkinColourVariableCombine>><</radiovar>></label>
				<br><br>
				<span class="gold bold">성별 전환 후 피부 명암:</span><br>
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">밝음 <<radiovar "_xchangeSkinShade" "light">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">중간 <<radiovar "_xchangeSkinShade" "medium">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">어두움 <<radiovar "_xchangeSkinShade" "dark">><<xchangeSkinColourVariableCombine>><</radiovar>></label> |
				<label data-target='["xchangeSkinTone"]' data-disabledif="T.xchangeSkinTone === 'no'">갸루 <<radiovar "_xchangeSkinShade" "gyaru">><<xchangeSkinColourVariableCombine>><</radiovar>></label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">체격 변화: <mouse class="tooltip linkBlue">(?)<span>기본 X-체인지 동작을 덮어씁니다. 보통 남성에서 여성으로 바뀌면 한 단계 작아지고 여성에서 남성으로 바뀌면 한 단계 커지는데, 이 설정이 그 동작을 덮어씁니다.</span></mouse></span><br>

				<label>기본값 <<radiobutton "$xchange.sizeOverride" "default" autocheck>></label> |
				<label>초소형 <<radiobutton "$xchange.sizeOverride" "miniature" autocheck>></label> |
				<label>매우 작음 <<radiobutton "$xchange.sizeOverride" "tiny" autocheck>></label> |
				<label>작음 <<radiobutton "$xchange.sizeOverride" "small" autocheck>></label> |
				<label>보통 <<radiobutton "$xchange.sizeOverride" "normal" autocheck>></label> |
				<label>장신 <<radiobutton "$xchange.sizeOverride" "tall" autocheck>></label> |
				<label>큼 <<radiobutton "$xchange.sizeOverride" "large" autocheck>></label> |
				<label>거대 <<radiobutton "$xchange.sizeOverride" "giant" autocheck>></label>

				<br><br>

				<span>변신 배율: (%)
				<mouse class="tooltip linkBlue">(?)<span>변신 시 체격 스케일링이 적용된 뒤, 캐릭터의 X-체인지된 체격에 곱해지는 배율입니다.</span></mouse>
				</span>
				<<numberbox "$xchange.physiqueChangePercent" $xchange.physiqueChangePercent>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "xchangeEffectSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">민감도 증가:</span>
				<span>알약으로 인한 증가:
				<mouse class="tooltip linkBlue">(?)<span>X-체인지 알약은 효과가 지속되는 동안 이 값만큼 몸의 민감도를 바꿉니다. 핑크 알약은 민감도를 높이고 블루 알약은 낮춥니다. 힌트: 이 동작을 뒤집으려면 음수 값을 쓰십시오.</span></mouse>
				</span>
				<<numberbox "$xchange.pillSensitivityChange" $xchange.pillSensitivityChange>>
				<br>
				<span>불순함으로 인한 증가:
				<mouse class="tooltip linkBlue">(?)<span>X-체인지 상태인 동안 불순함 때문에 몸에 더해지는 단계적 민감도 보너스입니다. 참고: 이 보너스는 성기에는 두 배로 적용되지만 입의 민감도에는 영향을 주지 않습니다.</span></mouse>
				</span>
				<<numberbox "$xchange.impuritySensitivityBonus" $xchange.impuritySensitivityBonus>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">레지스턴스 설정:</span>
				<span>오르가슴당 확률 감소 계수:
				<mouse class="tooltip linkBlue">(?)<span>레지스턴스 효과 아래에서 오르가슴에 도달할 때 원래 몸으로 돌아올 확률이 얼마나 줄어드는지입니다. <br><br>예: 값이 0.7이면 첫 오르가슴에서 확률이 100% * 0.7 = 70%로 낮아지고, 두 번째에는 70% * 0.7 = 49%, 세 번째에는 49% * 0.7 = 34.3%로 낮아지며, 이런 식으로 계속됩니다. </span></mouse>
				</span>
				<<numberslider "$xchange.resistanceOrgasmPenalty" $xchange.resistanceOrgasmPenalty 0.5 0.99 0.01>>
				<br>
				<span>알약 종료 실패 페널티: (일)
				<mouse class="tooltip linkBlue">(?)<span>알약의 기본 지속 시간이 끝날 때의 판정에 실패하면 페널티로 추가되는 지속 시간 연장 일수입니다. 영구화가 꺼져 있을 때만 적용됩니다.<br><br>참고: 1일 미만의 값은 1일로 처리됩니다. 꼼수는 통하지 않습니다.</span></mouse>
				</span>
				<<numberbox "$xchange.resistanceDaysPenalty" $xchange.resistanceDaysPenalty>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">컨티뉴 설정:</span><br>
				<label><<checkbox "$xchange.continueDurationCapEnabled" false true autocheck>> 컨티뉴 지속 시간 제한</label> <mouse class="tooltip linkBlue">(?)<span>컨티뉴가 변신을 레지스턴스 알약 종료 실패 페널티 이상으로, 통상 30일 한도까지 늘리지 못하게 합니다. 한도에 이르면 컨티뉴가 제거되고 변신 타이머가 정상적으로 줄어들기 시작합니다. 현재 몸이 임신할 수 있다면 가임 상태가 더해집니다. 이미 한도를 넘은 시간은 다음 절정 때까지 유지됩니다. 영구 변신은 계속 영구적이지만, 다음 절정 때 컨티뉴는 여전히 제거됩니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">포털 설정:</span>
				<span>빈도: (%)
				<mouse class="tooltip linkBlue">(?)<span>포털 효과의 재사용 대기 시간에 곱해지는 배율로, 포털 삽입이 얼마나 자주 일어나는지에 영향을 줍니다. 기본값은 100%이며 보통 빈도로 일어납니다. 200%는 두 배로 자주 일어난다는 뜻입니다.</span></mouse>
				</span>
				<<numberbox "$xchange.portalFrequency" $xchange.portalFrequency>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold bold">컴큐어 설정:</span>
				<span>컴큐어 시간 단축 계수:
				<mouse class="tooltip linkBlue">(?)<span>몸 안에 정액을 받을 때 알약 지속 시간이 몇 시간 줄어드는지입니다.</span></mouse>
				</span>
				<<numberslider "$xchange.cumcureTime" $xchange.cumcureTime 1 24 1>>
				<br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">브리더 설정:</span><mouse class="tooltip linkBlue">(?)<span><b>브리더는 자궁과 질이 있을 때만 작동합니다.</b></span></mouse><br>
				<label><<checkbox "$xchange.breederFreeOrgasm" false true autocheck>> 질내사정 없이도 오르가슴 허용</label>
				<mouse class="tooltip linkBlue">(?)<span>평소에 브리더는 보지 안에 정액이 없으면 오르가슴에 도달하지 못하게 합니다. 이를 켜면 질내사정 없이도 오르가슴에 도달할 수 있습니다. 그런 오르가슴은 허무하고 스트레스를 줍니다. 진짜 질내사정은 여전히 더 강한 쾌감과 스트레스 해소를 줍니다.</span></mouse><br>
				<label><<checkbox "$xchange.breederInfertile" false true autocheck>> 브리더가 가임력을 높이지 않음</label>
				<mouse class="tooltip linkBlue">(?)<span>브리더의 갈망, 쾌감, 스트레스 효과는 유지하되 가임력은 높아지지 않게 합니다. "항상 가임"과 하이퍼 퍼틸리티는 여전히 당신을 가임 상태로 만들 수 있습니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">오메가 설정:</span><mouse class="tooltip linkBlue">(?)<span><b>오메가</b>는 항문 임신을 가능하게 합니다.</span></mouse><br>
				<label><<checkbox "$xchange.omegaFreeOrgasm" false true autocheck>> 채워지지 않아도 오르가슴 허용</label>
				<mouse class="tooltip linkBlue">(?)<span>평소에 오메가는 표적이 되는 구멍에 정액이 없으면 오르가슴에 도달하지 못하게 합니다. 이를 켜면 어쨌든 오르가슴에 도달할 수 있습니다. 그런 오르가슴은 허무하고 스트레스를 줍니다. 채워지면 여전히 더 강한 쾌감과 스트레스 해소를 줍니다.</span></mouse><br>
				<label><<checkbox "$xchange.omegaShrinkGenitals" 0 1 autocheck>> 핑크 오메가 알약이 성별을 바꾸는 대신 몸을 줄임</label>
				<mouse class="tooltip linkBlue">(?)<span><b>X-체인지 핑크 오메가</b> 알약에만 영향을 줍니다. 성별을 바꾸는 대신 X-체인지 시시처럼 남성 성기를 줄입니다. 항문 임신 효과는 그대로 작동합니다. 다른 모든 핑크 또는 블루 알약은 여전히 성별을 바꾸며, 몰래 먹이기나 그레이 알약으로 받는 오메가는 영향을 받지 않습니다.</span></mouse><br>
				<label><<checkbox "$xchange.omegaNeedsNoVagina" 0 1 autocheck>> 질이 없을 때만 엉덩이에 영향</label>
				<mouse class="tooltip linkBlue">(?)<span>켜면 오메가는 질이 없을 때만 항문 임신을 가능하게 합니다. 질이 있으면 번식에는 대신 질이 쓰입니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">알파 설정:</span><mouse class="tooltip linkBlue">(?)<span><b>알파</b>는 자지에 영향을 줍니다.</span></mouse><br>
				<label><<checkbox "$xchange.alphaFreeOrgasm" false true autocheck>> 매듭 없이도 오르가슴 허용</label>
				<mouse class="tooltip linkBlue">(?)<span>평소에 알파는 자지가 무언가 안에 들어가 있지 않으면 오르가슴에 도달하지 못하게 합니다. 이를 켜면 어쨌든 오르가슴에 도달할 수 있습니다. 그런 오르가슴은 허무하고 스트레스를 줍니다.</span></mouse><br>
				<label><<checkbox "$xchange.alphaGrowsPenis" 0 1 autocheck>> 자지가 없으면 자지가 자라남</label>
				<mouse class="tooltip linkBlue">(?)<span>자지가 없는 상태에서 알파 효과를 받을 때만 의미가 있습니다. 예를 들어 보지가 있는 상태에서 몰래 먹이기나 그레이 알약으로 받는 경우입니다. 켜면 효과가 끝나면 사라지는 임시 자지가 자랍니다. 끄면 자지가 생길 때까지 알파는 아무 일도 하지 않습니다. 블루와 헤름 알파 알약은 이미 자지를 주므로 이 설정이 영향을 주지 않습니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">알파/베타/오메가 공통 설정:</span><mouse class="tooltip linkBlue">(?)<span><b>알파</b>는 자지에 영향을 주고, <b>베타</b>는 질이 있는 몸에 자궁을 둘 주며, <b>오메가</b>는 항문 임신을 가능하게 합니다.</span></mouse><br>
				<label><<checkbox "$xchange.aboDrivesHeat" 0 1 autocheck>> 알파와 오메가가 수컷 발정기와 발정기를 일으킴</label>
				<mouse class="tooltip linkBlue">(?)<span>켜면 알파는 수컷 발정기에, 오메가는 가임 주기를 통해 발정기에 들게 할 수 있습니다.</span></mouse><br>
				<label><<checkbox "$xchange.pheromoneAllure" 0 1 autocheck>> 알파, 베타, 오메가가 매력을 높임</label>
				<mouse class="tooltip linkBlue">(?)<span>켜면 이 알약들이 지속되는 동안 매력을 높입니다. 알파는 자지가, 베타는 질이 필요합니다.</span></mouse><br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">가임력 설정:</span><br>
				<label><<checkbox "$xchange.postPermanenceFertilityReset" 0 1 autocheck>> 영구화 이후 가임률을 정상으로 되돌림 </label> <mouse class="tooltip linkBlue">(?)<span>효과의 일부로 가임률이 낮아지는 알약은 첫 임신 이후 가임률이 정상으로 돌아옵니다. 참고: 브리더 효과가 있는 알약은 임신 이후에도 그대로입니다.</span></mouse><br>
				<label><<checkbox "$xchange.alwaysFertile" false true autocheck>> X-체인지 중에는 항상 가임</label> <mouse class="tooltip linkBlue">(?)<span>X-체인지 알약이 지속되는 동안 자궁과 질이 있으면 언제든 임신할 수 있습니다. 알약이 없을 때의 평소 몸에는 영향을 주지 않습니다.</span></mouse><br>
				<span>알약 복용 시 확률 보정: (%)
					<mouse class="tooltip linkBlue">(?)<span>알약을 먹어 가임 상태인 동안 캐릭터의 기본 임신/임신시킴 확률에 곱해지는 배율입니다(브리더와 불 효과에는 다른 비율이 적용됩니다).</span></mouse>
				</span>
				<<numberbox "$xchange.pregnancyMultPercent" $xchange.pregnancyMultPercent>><br>
				<span>가임력 강도: (%)
					<mouse class="tooltip linkBlue">(?)<span>가임력과 하이퍼 퍼틸리티가 임신 확률을 얼마나 높이는지 조절합니다. 100%가 보통 강도입니다. 임신 속도나 쌍둥이, 세쌍둥이가 될 확률에는 영향을 주지 않습니다.</span></mouse>
				</span>
				<<numberslider "$xchange.fertilityStrengthPercent" $xchange.fertilityStrengthPercent 25 400 25>>
			</div>
		</div>
	</div>
	<<run settingsDisableElement()>>
<</widget>>


<<widget "loadAllFeats">>
	<div id="featsBeginLoadingText">
		몇 가지 기본 확인을 실행하는 중...
		<br>
	</div>
	<div id="featsBeginButton" class="hidden">
		<span id="featsBeginText"></span> "시작"을 클릭한 후에는 게임을 새로고침하지 마십시오. 그렇지 않으면 과정을 다시 실행해야 합니다.
		<br><br>
		내보낸 세이브는 먼저 불러와서 로컬 세이브로 만들지 않는 한 이 과정에서 제외됩니다.
		<br>
		<<link "시작">>
			<<replace "#startCaption">><</replace>>
			<<replace "#settingsStart">><<loadingAllFeats>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMergePre")})>>
	<br><br>
	<<link "취소">>
		<<replace "#settingsStart">><<settingsStart>><</replace>>
	<</link>>
<</widget>>

<<widget "loadingAllFeats">>
	<div id="featsLoadingMeter" class="meter">
		<div class="greenbar" style="width:0%"></div>
		<span id="featsLoadingText">_saveDataImportCount개의 세이브 중 0개 확인됨.</span>
	</div>
	<br><br>
	<div id="featsFinishButton" class="hidden">
		<<link "다음">>
			<<setupFeatBoosts true>>
			<<replace "#startCaption">><<startCaption>><</replace>>
			<<replace "#settingsStart">><<settingsStart>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMerge")})>>
<</widget>>

<<widget "skinToneRange">>
	<div class="skinToneRange" @style="'--skin-gradient: linear-gradient(to right, ' + setup.colours.skin_options.gyaru.gradient.join(', ') + ')'">
		<<for _handle range [["min", "Min", "가장 밝은"], ["mean", "Mode", "가장 흔한"], ["max", "Max", "가장 어두운"]]>>
			<<set _tone to $settings["skinTone" + _handle[1]]>>
			<input type="range" min="0" max="100" step="1" @data-skin="_handle[0]" @data-tip="_handle[2] + ' 피부 톤'" @value="_tone"
				@style="'--skin-thumb: ' + setup.colours.getSkinRgb(setup.colours.skin_options.gyaru, _tone / 100)">
		<</for>>
		<span class="skinToneTip"></span>
	</div>
<</widget>>

<<widget "npcSkinTone">>
	<<if $NPCName[_npcId].skinType is "ghost">>
		<span class="small-description">유령처럼 창백함.</span>
	<<elseif $NPCName[_npcId].skincolour isnot undefined and $NPCName[_npcId].skincolour isnot "none">>
		<<numberslider "$NPCName[_npcId].skincolour" $NPCName[_npcId].skincolour 0 100 1 {
			value: v => setup.colours.getSkinToneSwatch(v),
		}>>
		<<link "무작위">>
			<<initnpcskinsingle _npcId "skincolour">>
			<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
		<</link>>
	<<else>>
		<span class="small-description">게임이 시작될 때 무작위로 정해집니다.</span>
		<<link "톤 설정">>
			<<set $NPCName[_npcId].skincolour to Math.clamp($settings.skinToneMode, 0, 100)>>
			<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
		<</link>>
	<</if>>
<</widget>>

:: Settings [exitCheckBypass]
<<if $options.images is 1>>
	<span id="bannerStyle">
		<img class="resize" src="img/misc/banner.png">
	</span>
<</if>>
<<settings>>

:: Attitudes
<<attitudes>>
<<set $attitudesControl.showGoldLink to "false">>
<div class="settingsGrid">
	<<button [[확인|$attitudesExitPassage]]>>
		<<set $speech_attitude to $speech_attitude_special>>

		<<unset $attitudesExitPassage>>
		<<run DefaultActions.save(T.defaultActions)>>
		<<if $LIChanged>>
			<<unset $LIChanged>>
			<<set $stress += 2000>><<set $trauma += 600>>
		<</if>>
	<</button>>
</div>
<br>
