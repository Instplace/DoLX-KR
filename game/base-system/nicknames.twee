:: Widgets Nicknames [widget]
<<widget "underworld_nickname">><<silently>>
	<<if $fame.sex gte 400>>
		<<if $fame.prostitution gte 400>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Our Boy" : currentAppearanceBand() is "f" ? "Our Girl" : "Our Enby">>
						<<else>>
							<<set _text_output to currentAppearanceBand() is "m" ? "The Boy" : currentAppearanceBand() is "f" ? "The Girl" : "The Enby">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "노리개">>
						<<else>>
							<<set _text_output to "육변기">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "파이크">>
						<<else>>
							<<set _text_output to "레이피어">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "초특급 걸레">>
						<<else>>
							<<set _text_output to "슈퍼 걸레">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "착유기">>
						<<else>>
							<<set _text_output to "밀키">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "키블즈">>
						<<else>>
							<<set _text_output to "니블즈">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "방직공">>
						<<else>>
							<<set _text_output to "바늘">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "포키즈">>
						<<else>>
							<<set _text_output to "포키">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "늑대 창녀">>
						<<else>>
							<<set _text_output to "늑대 걸레">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개 창녀">>
						<<else>>
							<<set _text_output to "개 걸레">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "스파이크">>
						<<else>>
							<<set _text_output to "난투꾼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "공짜">>
						<<else>>
							<<set _text_output to "공짜 걸레">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개새끼 착즙기">>
						<<else>>
							<<set _text_output to "늑대 전사">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개새끼 착유기">>
						<<else>>
							<<set _text_output to "늑대 기수">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "f" ? "Madame" : "Pimp">>
						<<else>>
							<<set _text_output to "사브르">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Slut Dad" : currentAppearanceBand() is "f" ? "Slut Mum" : "Slut Parent">>
						<<else>>
							<<set _text_output to "걸레">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<if $fame.prostitution gte 400>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Hound Father" : currentAppearanceBand() is "f" ? "Hound Mother" : "Hound Parent">>
						<<else>>
							<<set _text_output to "사냥개">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "지독한 놈">>
						<<else>>
							<<set _text_output to "강아지">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "단검">>
						<<else>>
							<<set _text_output to "흉터">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "섹스 구걸꾼">>
						<<else>>
							<<set _text_output to "강간 구걸꾼">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "송곳니">>
						<<else>>
							<<set _text_output to "발톱">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "그 사냥개">>
						<<else>>
							<<set _text_output to "새끼강아지">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "스틸레토">>
						<<else>>
							<<set _text_output to "칼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Whoredad" : currentAppearanceBand() is "f" ? "Whoremum" : "Whoreparent">>
						<<else>>
							<<set _text_output to "동전 사냥꾼">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "맛있는 녀석">>
						<<else>>
							<<set _text_output to "그 토끼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "새끼고양이">>
						<<else>>
							<<set _text_output to "암캐">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "거친 놈">>
						<<else>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Spear-Prick" : currentAppearanceBand() is "f" ? "Vagina Dentata" : "The Teeth">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "무료 샘플">>
						<<else>>
							<<set _text_output to "강간 미끼">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Den Father" : currentAppearanceBand() is "f" ? "Den Mother" : "Den Parent">>
						<<else>>
							<<set _text_output to "그 늑대">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "목장주">>
						<<else>>
							<<set _text_output to "앞발">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 4000>>
						<<set _text_output to "무적의 챔피언">>
					<<elseif $fame.scrap gte 3600>>
						<<set _text_output to "챔피언">>
					<<elseif $fame.scrap gte 3200>>
						<<set _text_output to "KO의 왕">>
					<<elseif $fame.scrap gte 2800>>
						<<set _text_output to "강철 주먹">>
					<<elseif $fame.scrap gte 2400>>
						<<set _text_output to "뼈 부수는 자">>
					<<elseif $fame.scrap gte 2000>>
						<<set _text_output to "길거리의 왕">>
					<<elseif $fame.scrap gte 1600>>
						<<set _text_output to "강타자">>
					<<elseif $fame.scrap gte 1200>>
						<<set _text_output to "난투꾼">>
					<<elseif $fame.scrap gte 800>>
						<<set _text_output to "주먹잡이">>
					<<elseif $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "그 쥐새끼">>
						<<else>>
							<<set _text_output to "싸움닭">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to currentAppearanceBand() is "m" ? "Dad" : currentAppearanceBand() is "f" ? "Mum" : "Parent">>
						<<else>>
							<<set _text_output to "고기">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "cap">><<capitalise>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "overworld_nickname">><<silently>>
	<<if $fame.exhibitionism gte 400>>
		<<if $fame.good gte 400>>
			<<if $fame.business gte 400>>
				<<if $fame.social gte 400>>
					<<set _text_output to "고아">>
				<<elseif $fame.model gte 400>>
					<<set _text_output to "인기쟁이">>
				<<else>>
					<<set _text_output to "따뜻한 마음">>
				<</if>>
			<<else>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "스캔들 메이커">>
					<<else>>
						<<set _text_output to "과시꾼">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to "비너스">>
					<<else>>
						<<set _text_output to "미소">>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.business gte 400>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "센터폴드">>
					<<else>>
						<<set _text_output to "난초">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to "핫 샷">>
					<<else>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Suspicious Shop Boy" : currentAppearanceBand() is "f" ? "Suspicious Shop Girl" : "Suspicious Shop Clerk">>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to currentAppearanceBand() is "f" ? "Starlet" : "Star">>
					<<else>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Party Boy" : currentAppearanceBand() is "f" ? "Party Girl" : "Party Animal">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Pin-Up Boy" : currentAppearanceBand() is "f" ? "Pin-Up Girl" : "Pin-Up">>
					<<else>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Lewd Boy" : currentAppearanceBand() is "f" ? "Lewd Girl" : "Lewd Enby">>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<if $fame.good gte 400>>
			<<if $fame.business gte 400>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "아이콘">>
					<<else>>
						<<set _text_output to "꽃">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to "마스코트">>
					<<else>>
						<<set _text_output to "자선가">>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "귀염둥이">>
					<<else>>
						<<set _text_output to "설교꾼">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to "뮤즈">>
					<<else>>
						<<set _text_output to "천사">>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.business gte 400>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "홍보대사">>
					<<else>>
						<<set _text_output to "튤립">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to "머니 샷">>
					<<else>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Shop Boy" : currentAppearanceBand() is "f" ? "Shop Girl" : "Shop Clerk">>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "트렌디">>
					<<else>>
						<<set _text_output to "월플라워">>
					<</if>>
				<<else>>
					<<if $fame.model gte 400>>
						<<set _text_output to currentAppearanceBand() is "m" ? "Glamour Boy" : currentAppearanceBand() is "f" ? "Glamour Girl" : "Glamour Model">>
					<<else>>
						<<set _text_output to currentAppearanceBand() is "m" ? "some orphan boy" : currentAppearanceBand() is "f" ? "some orphan girl" : "some orphan">>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "cap">><<capitalise>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcpetname">><<silently>>
	<<if _args[0]>>
		<<set $_npc to _args[0]>>
	<<elseif $npc.length gte 1>>
		<<set $_npc to $npc[0]>>
	<</if>>
	<<set $_mod to _args[1]>>
	<<if $wraith.mimic is $_npc>>
		<<set $_wraith to true>>
	<</if>>
	<<set _names to []>>
	<<set _gender to npcAddressPronoun($_npc)>>

	<<switch $_npc>>
		<<case "Avery" "avery">>
			/* note: female terms for male pc are intentional */
			<<set _names.push(_gender is "m" ? "boy" : _gender is "f" ? "girl" : "darling")>>
			<<set _love to C.npc.Avery.love>>
			<<set _rage to C.npc.Avery.rage>>
			<<set _dom to C.npc.Avery.dom>>
			<<if _love + _rage gte 25>>
				/* generic */
				<<if _love gte 30>>
					<<if _love gte 60>>
						/* high love: the warmer names crowd out the milder ones */
						<<set _names.delete(_gender is "m" ? "boy" : _gender is "f" ? "girl" : "darling")>>
						<<set _names.push("princess", "sweetheart", "darling")>>
						<<if _gender is "m">><<set _names.push("왕자님")>><</if>>
						<<if _love lt 80>><<set _names.push("doll", "sunshine")>><</if>>
					<<else>>
						<<set _names.push("doll", "sunshine")>>
					<</if>>
				<</if>>
				<<if _rage gte 30>>
					<<set _names.push("버릇없는 애")>>
					<<if _rage gte 60>>
						<<set _names.push("씹년")>>
						<<if _gender is "m">><<set _names.push("자지새끼")>><</if>>
					<</if>>
				<</if>>
				/* tf */
				<<if Transformations.partActive("cat", "ears") and Transformations.partActive("cat", "tail")>>
					<<set _names.push("아기 고양이", "야옹이")>>
				<</if>>
				<<if Transformations.partActive("wolf", "ears") and Transformations.partActive("wolf", "tail")>>
					<<set _names.push("강아지", "멍멍이")>>
				<</if>>
				<<if Transformations.partActive("cow", "ears") and Transformations.partActive("cow", "tail") and Transformations.partActive("cow", "horns")>>
					<<set _names.push(_gender is "m" ? "cowboy" : _gender is "f" ? "cowgirl" : "cowhand")>>
				<</if>>
				<<if Transformations.partActive("bird", "wings") and Transformations.partActive("bird", "tail") and Transformations.partActive("bird", "plumage")>>
					<<set _names.push("새끼 새", "어린 백조")>>
				<</if>>
				<<if Transformations.partActive("fox", "ears") and Transformations.partActive("fox", "tail")>>
					<<set _names.push(_gender is "f" ? "vixen" : "kit")>>
				<</if>>
				<<if Transformations.partActive("bear", "ears") and Transformations.partActive("bear", "tail")>>
					<<set _names.push("cub", "teddy bear")>>
				<</if>>
				<<if Transformations.partActive("bunny", "ears") and Transformations.partActive("bunny", "tail")>>
					<<set _names.push("bunny", "cottontail")>>
				<</if>>
				<<if Transformations.partActive("waterdragon", "horns") and Transformations.partActive("waterdragon", "ears") and Transformations.partActive("waterdragon", "tail")>>
					<<set _names.push("hatchling", "dragon")>>
				<</if>>
				<<if Transformations.partActive("angel", "wings") and Transformations.partActive("angel", "halo")>>
					<<set _names.push("천사", "아기 천사")>>
				<</if>>
				<<if Transformations.partActive("fallenAngel", "wings") and Transformations.partActive("fallenAngel", "halo")>>
					<<set _names.push("fallen angel", "dark angel")>>
				<</if>>
				<<if Transformations.partActive("demon", "wings") and Transformations.partActive("demon", "tail") and Transformations.partActive("demon", "horns")>>
					<<set _names.push("demon")>>
					<<if _gender is "m">><<set _names.push("incubus")>><<elseif _gender is "f">><<set _names.push("succubus")>><</if>>
				<</if>>
				<<if $dryad gte 6>>
					<<set _names.push("sapling", "flower")>>
				<</if>>
				/* attitude and dominance */
				<<if random(0, 100) lt 40>>
					<<if $submissive gte 1150 or _dom gte 25>>
						<<set _names.push("애완동물")>>
						<<if $submissive gte 1500 or _dom gte 50>>
							<<set _names.push("장난감")>>
							<<if $submissive gte 1900 or _dom gte 75>>
								<<set _names.push("노예")>>
							<</if>>
						<</if>>
					<</if>>
				<</if>>
				/* fame */
				<<if random(0, 100) lt 20>>
					<<if $fame.exhibitionism gte 400>>
						<<set _names.push("과시꾼")>>
						<<if $fame.exhibitionism gte 600>>
							<<set _names.push("자랑쟁이")>>
						<</if>>
					<</if>>
					<<if $fame.sex gte 400>>
						<<set _names.push("님프")>>
						<<if $fame.sex gte 600>>
							<<set _names.push("걸레")>>
						<</if>>
					<</if>>
					<<if $fame.prostitution gte 400>>
						<<set _names.push("싸구려")>>
						<<if $fame.prostitution gte 600>>
							<<set _names.push("창녀")>>
						<</if>>
					<</if>>
					<<if $fame.rape gte 400>>
						<<set _names.push("섹스 인형")>>
						<<if $fame.rape gte 600>>
							<<set _names.push("육변기")>>
						<</if>>
					<</if>>
				<</if>>
				/* mimic */
				<<if $_wraith>>
					<<set _names.push("도둑","무덤 도굴꾼")>>
				<</if>>
			<</if>>
			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if _love gte 30 and random(0, 100) lt _love - 30 and !["소년","소녀"].includes(_text_output)>>
				<<set _text_output to "작은 " + _text_output>>
			<</if>>
			<<if _rage gte 50 and random(0, 100) lt _rage - 30>>
				<<set _text_output to "꼴 보기 싫은 " + _text_output>>
			<</if>>
			<<if _love gte 60 and random(0, 100) lt _love - 30 and _args[1] isnot "my">>
				<<set _text_output to "내 " + _text_output>>
			<</if>>
		<<case "wraith" "Wraith" "Ivory Wraith">>
			<<set _pre to [""]>>
			/* generic */
			<<set _names.push(
				"현현",
				"그림자",
				"육신"
			)>>
			<<if playerIsPregnant()>>
				<<set _names.push("생명의 그릇")>>
			<</if>>
			<<if $location is "lake" or $location is "forest">>
				<<set _names.push("침입자")>>
			<</if>>
			<<if $avery_fate is "ascended">>
				<<set _names.push("배신자", "발판")>>
			<</if>>
			/* angry or calm */
			<<if $wraith.state is "haunt" and $_mod isnot "nice" or $_mod is "angry">>
				<<set _names.push(
					"무덤 도굴꾼","무덤 도굴꾼","무덤 도굴꾼","무덤 도굴꾼","무덤 도굴꾼","무덤 도굴꾼",
					"도둑","도둑","도둑","도둑",
					"시체새","시체새",
					"저버린 자",
					"후예",
					"잔가지"
				)>>
				<<if playerIsPregnant()>>
					<<set _names.push("씨받이")>>
				<</if>>
				<<set _pre.push(
					"비참한 ",
					"불길한 ",
					"잔혹한 "
				)>>
			<<else>>
				<<if $wraith.state is "despair">>
					<<set _names.push("공범")>>
				<</if>>
				<<set _names.push(
					"약속",
					"물방울",
					"기억",
					"진주"
				)>>
				<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
					<<set _names.push(
						"숯길 걷는 자"
					)>>
				<</if>>
				<<if $temple_confessor_intro>>
					<<set _names.push(
						"고해자"
					)>>
				<</if>>
			<</if>>
			/* offspring */
			<<if ["dead","sold"].includes($wraith.offspring)>>
				<<set _names.push(
					"맹세를 깬 자",
					"반역자",
					"뱀"
				)>>
			<</if>>
			/* tfs, intended to not check for part visibility */
			<<if (effectiveTransformationLevel("angel") gte 6)>>
				<<set _names.push(
					"전령",
					"간수"
				)>>
				<<set _pre.push("파닥이는 ")>>
			<</if>>
			<<if (effectiveTransformationLevel("fallen") gte 2)>>
				<<set _names.push(
					"날개 잃은 자",
					"파편"
				)>>
				<<set _pre.push("타락한 ")>>
			<</if>>
			<<if (effectiveTransformationLevel("demon") gte 6)>>
				<<set _names.push(
					"망나니",
					"임프"
				)>>
			<</if>>
			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if random(1,100) lte 15>>
				<<set _text_output to _pre.pluck() + _text_output>>
			<</if>>
		<<case "gwylan" "Gwylan">>
			<<set _yearning to C.npc.Gwylan.dom>>
			<<if ["good", "dear", "bad", "naughty"].includes(_args[1])>>
				<<set _names.push(_gender is "m" ? "boy" : _gender is "f" ? "girl" : "pet")>>
			<</if>>
			/* tfs, intended to not check for part visibility */
			<<if (effectiveTransformationLevel("cat") gte 6)>>
				<<set _names.push("야옹이")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("앞발")>>
					<<if $gwylanSeen?.includes("cream_lick")>>
						<<set _names.push("거친 혀")>>
					<</if>>
				<</if>>
			<<elseif (effectiveTransformationLevel("wolf") gte 6)>>
				<<set _names.push("강아지")>>
				<<if _yearning gte 100>>
					<<set _names.push("개")>>
					<<if (effectiveTransformationLevel("angel") gte 6) or (effectiveTransformationLevel("fallen") gte 2) or $dryad gte 6>>
						<<set _names.push("잡종")>>
					<</if>>
					<<if (effectiveTransformationLevel("demon") gte 6)>>
						<<set _names.push("지옥 강아지")>>
					<</if>>
				<</if>>
			<<elseif (effectiveTransformationLevel("bird") gte 6)>>
				<<set _names.push("새님", "카나리아")>>
				<<if (effectiveTransformationLevel("demon") gte 6)>>
					<<set _names.push("세이렌")>>
				<</if>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("짹짹이")>>
				<</if>>
			<<elseif (effectiveTransformationLevel("fox") gte 6)>>
				<<set _names.push("새끼 여우")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("여우")>>
					<<if $gwylanSeen?.includes("gwylan_tf_revealed")>>
						<<set _names.push("동족")>>
					<</if>>
					<<if (effectiveTransformationLevel("demon") gte 6)>>
						<<set _names.push("여우불")>>
					<</if>>
				<</if>>
			<<elseif (effectiveTransformationLevel("cow") gte 6)>>
				<<set _names.push("송아지")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("반짝눈")>>
				<</if>>
			<<elseif (effectiveTransformationLevel("bear") gte 6)>>
				<<set _names.push("cub")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("honeypaws")>>
				<</if>>
			<<elseif (effectiveTransformationLevel("bunny") gte 6)>>
				<<set _names.push("bun")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("cottontail")>>
				<</if>>
			<<elseif (effectiveTransformationLevel("waterdragon") gte 7)>>
				<<set _names.push("hatchling")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("scales")>>
				<</if>>
			<<elseif _yearning gte 35>>
				<<set _names.push("강아지")>>
			<</if>>
			<<if (effectiveTransformationLevel("angel") gte 6) or (effectiveTransformationLevel("fallen") gte 2)>>
				<<set _names.push((effectiveTransformationLevel("angel") gte 6) ? "angel" : "fallen star")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("천사의 눈", "반짝머리")>>
				<</if>>
			<<elseif (effectiveTransformationLevel("demon") gte 6)>>
				<<set _names.push("imp")>>
			<<elseif $dryad gte 6>>
				<<set _names.push("묘목", "새싹")>>
			<</if>>

			/* clothing */
			<<if $worn.upper.name is "pumpkin dress">>
				<<set _names.push("호박")>>
			<</if>>

			/* other */
			<<if (_yearning gte 75 or $hypnosis_traits.devotion gte 4) and ["simple", undefined].includes(_args[1]) or ["my"].includes(_args[1])>>
				<<set _names.push("애완동물")>>
			<</if>>
			<<if $gwylanSeen?.includes("romance") and ["simple", "name", undefined].includes(_args[1])>>
				<<set _names.push("사랑", "소중한 아이")>>
			<</if>>
			<<if _names.length is 0 or ["simple", "name", undefined].includes(_args[1])>>
				<<set _names.push("얘야")>>
			<</if>>

			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if !["simple", "bad", "naughty", "good", "dear", "name"].includes(_args[1]) and (_args[1] is "my" or _yearning gte 75 and random(0, 150) lt _yearning - 50 or _text_output.includes("애완동물"))>>
				<<set $_addMyToStart to true>>
			<</if>>
			<<if !["simple", "name"].includes(_args[1]) and random(0, 150) lt _yearning - 50 and !["소년","소녀","얘야","사랑","소중한 아이"].includes(_text_output)>>
				<<set _text_output to "작은 " + _text_output>>
			<</if>>
			<<if !["simple", "bad", "naughty", "name"].includes(_args[1]) and (["good", "dear"].includes(_args[1]) or _yearning gte 60 and random(0, 150) lt _yearning - 50 and !$gwylan.punishment and $_addMyToStart) and !["얘야","사랑","소중한 아이"].includes(_text_output)>>
				<<if ["good", "dear"].includes(_args[1])>>
					<<if _args[1] is "good">>
						<<set _text_output to "착한 " + _text_output>>
					<<else>>
						<<set _text_output to "사랑스러운 " + _text_output>>
					<</if>>
				<<elseif random(0, 1)>>
					<<set _text_output to "착한 " + _text_output>>
				<<else>>
					<<set _text_output to "사랑스러운 " + _text_output>>
				<</if>>
			<<elseif !["simple", "good", "dear", "name"].includes(_args[1]) and (["bad", "naughty"].includes(_args[1]) or $gwylan.punishment and $_addMyToStart) and !["얘야","사랑","소중한 아이"].includes(_text_output)>>
				<<if ["bad", "naughty"].includes(_args[1])>>
					<<if _args[1] is "bad">>
						<<set _text_output to "나쁜 " + _text_output>>
					<<else>>
						<<set _text_output to "장난꾸러기 " + _text_output>>
					<</if>>
				<<elseif random(0, 1)>>
					<<set _text_output to "나쁜 " + _text_output>>
				<<else>>
					<<set _text_output to "장난꾸러기 " + _text_output>>
				<</if>>
			<</if>>
			<<if $_addMyToStart>>
				<<set _text_output to "내 " + _text_output>>
			<</if>>
		<<default>>
			<<girl>>
	<</switch>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcPetname">><<silently>>
	<<pcpetname _args[0] _args[1]>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "foxnickname">><<silently>>
	<<if (effectiveTransformationLevel("fox") gte 6)>>
		<<set _text_output to "새끼">>
	<<elseif (effectiveTransformationLevel("cat") gte 6)>>
		<<set _text_output to "길 잃은 놈">>
	<<elseif (effectiveTransformationLevel("wolf") gte 6)>>
		<<set _text_output to "강아지">>
	<<else>>
		<<set _text_output to "고기">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "overworld_nickname_dolp">><<silently>>
	<<set _fameTitles = {
		"good": [
			{ "level": 400, "title": "마음씨 고운 사람" },
			{ "level": 800, "title": "자비로운 사람" },
			{ "level": 1600, "title": "성인 같은 인물" },
			{ "level": 2400, "title": "희망의 등불" },
			{ "level": 3200, "title": "귀감" },
			{ "level": 4000, "title": "성스러운 상징" }
		],
		"business": [
			{ "level": 400, "title": "수완가" },
			{ "level": 800, "title": "기업가" },
			{ "level": 1600, "title": "거래의 달인" },
			{ "level": 2400, "title": "재벌" },
			{ "level": 3200, "title": "업계의 거두" },
			{ "level": 4000, "title": "제국의 건설자" }
		],
		"social": [
			{ "level": 400, "title": "사교계의 나비" },
			{ "level": 800, "title": "유행의 선구자" },
			{ "level": 1600, "title": "인플루언서" },
			{ "level": 2400, "title": "상류 사회" },
			{ "level": 3200, "title": "매력쟁이" },
			{ "level": 4000, "title": "아이콘" }
		],
		"model": [
			{ "level": 400, "title": "예쁜 얼굴" },
			{ "level": 800, "title": "표지 모델" },
			{ "level": 1600, "title": "런웨이의 돌풍" },
			{ "level": 2400, "title": "화보의 아이콘" },
			{ "level": 3200, "title": "슈퍼모델 뮤즈" },
			{ "level": 4000, "title": "촬영장의 전설" }
		],
		"xchange": [
			{ "level": 100, "title": "Pill Popper" },
			{ "level": 200, "title": "Quick Change" },
			{ "level": 400, "title": "Gender Bender" },
			{ "level": 600, "title": "Shapeshifter" },
			{ "level": 800, "title": "The Chameleon" },
			{ "level": 1000, "title": "The Many-Faced" }
		],
		"combinations": [
			{ "levels": [400, 400], "categories": ["good", "business"], "title": "자비로운 자본가" },
			{ "levels": [400, 400], "categories": ["good", "social"], "title": "사랑받는 인물" },
			{ "levels": [400, 400], "categories": ["good", "model"], "title": "우아한 아이콘" },
			{ "levels": [400, 400], "categories": ["business", "social"], "title": "인맥의 달인" },
			{ "levels": [400, 400], "categories": ["business", "model"], "title": "기업계의 스타" },
			{ "levels": [400, 400], "categories": ["social", "model"], "title": "사진발 좋은 매력쟁이" },
			{ "levels": [400, 100], "categories": ["good", "xchange"], "title": "Kindly Stranger" },
			{ "levels": [400, 100], "categories": ["business", "xchange"], "title": "Two-Faced Dealer" },
			{ "levels": [400, 100], "categories": ["social", "xchange"], "title": "Social Chameleon" },
			{ "levels": [400, 100], "categories": ["model", "xchange"], "title": "Dual Cover Star" },

			{ "levels": [1600, 1600], "categories": ["good", "business"], "title": "이타적인 거물" },
			{ "levels": [1600, 1600], "categories": ["good", "social"], "title": "민중의 성인" },
			{ "levels": [1600, 1600], "categories": ["good", "model"], "title": "우아함의 화신" },
			{ "levels": [1600, 1600], "categories": ["business", "social"], "title": "사교계의 거물" },
			{ "levels": [1600, 1600], "categories": ["business", "model"], "title": "상품성 있는 미인" },
			{ "levels": [1600, 1600], "categories": ["social", "model"], "title": "셀럽" },
			{ "levels": [1600, 400], "categories": ["good", "xchange"], "title": "Secret Samaritan" },
			{ "levels": [1600, 400], "categories": ["business", "xchange"], "title": "Double Dealer" },
			{ "levels": [1600, 400], "categories": ["social", "xchange"], "title": "Life of Every Party" },
			{ "levels": [1600, 400], "categories": ["model", "xchange"], "title": "Versatile Muse" },

			{ "levels": [3200, 3200], "categories": ["good", "business"], "title": "자선가 재벌" },
			{ "levels": [3200, 3200], "categories": ["good", "social"], "title": "길을 밝히는 빛" },
			{ "levels": [3200, 3200], "categories": ["good", "model"], "title": "신성한 미인" },
			{ "levels": [3200, 3200], "categories": ["business", "social"], "title": "막후 실력자" },
			{ "levels": [3200, 3200], "categories": ["business", "model"], "title": "미디어 거물" },
			{ "levels": [3200, 3200], "categories": ["social", "model"], "title": "패션계의 왕족" },
			{ "levels": [3200, 800], "categories": ["good", "xchange"], "title": "Guardian Unknown" },
			{ "levels": [3200, 800], "categories": ["business", "xchange"], "title": "Phantom Tycoon" },
			{ "levels": [3200, 800], "categories": ["social", "xchange"], "title": "Face of the Season" },
			{ "levels": [3200, 800], "categories": ["model", "xchange"], "title": "Both Covers" },

			{ "levels": [4000, 4000, 4000, 4000], "categories": ["good", "business", "social", "model"], "title": "The One and Only" },
			{ "levels": [4000, 4000, 4000, 4000, 1000], "categories": ["good", "business", "social", "model", "xchange"], "title": "The One and Only, Twice Over" }
		]
	}>>
	<<set _fame_types = ["good", "business", "social", "model", "xchange"]>>
	<<set _text_output = "평범한 고아">>  <!-- Default title -->
	<<set _highest_fame = {}>>  <!-- Highest title reached per fame type -->
	<<set _fame_values = {}>>
	<<set _fame_tier = {}>>  <!-- How many rungs up its own ladder each fame type has climbed -->

	<!-- Get highest fame titles -->
	<<for _type range _fame_types>>
		<<set _fame_values[_type] to (_type is "xchange" ? $xchange_fame : $fame[_type]) || 0>>
		<<for _i, _entry range _fameTitles[_type]>>
			<<if _fame_values[_type] gte _entry.level>>
				<<set _highest_fame[_type] to _entry.title>>
				<<set _fame_tier[_type] to _i + 1>>
			<</if>>
		<</for>>
	<</for>>

	<!-- Best qualifying combination -->
	<<set _best_count to 0>>
	<<set _best_weight to -1>>
	<<for _combo range _fameTitles.combinations>>
		<<set _qualifies to true>>
		<<set _combo_weight to 0>>
		<<for _i, _category range _combo.categories>>
			<<if _fame_values[_category] is undefined or _fame_values[_category] lt _combo.levels[_i]>>
				<<set _qualifies to false>>
			<<else>>
				<<set _combo_weight += _combo.levels[_i]>>
			<</if>>
		<</for>>
		<<if _qualifies and (_combo.categories.length gt _best_count or (_combo.categories.length is _best_count and _combo_weight gt _best_weight))>>
			<<set _best_count to _combo.categories.length>>
			<<set _best_weight to _combo_weight>>
			<<set _text_output to _combo.title>>
		<</if>>
	<</for>>

	<!-- No combination qualified -->
	<<if _best_count is 0>>
		<<set _best_tier to 0>>
		<<for _type range _fame_types>>
			<<if _fame_tier[_type] and _fame_tier[_type] gt _best_tier>>
				<<set _best_tier to _fame_tier[_type]>>
				<<set _text_output to _highest_fame[_type]>>
			<</if>>
		<</for>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "fisherPerson">><<silently>>
	<<if $player.gender_appearance is "m">>
		<<set _text_output to "fisherman">>
	<<else>>
		<<set _text_output to "fisherwoman">>
	<</if>>
<</silently>><<print _text_output>><</widget>>
