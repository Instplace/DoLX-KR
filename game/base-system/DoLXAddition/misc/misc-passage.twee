:: Bathroom Scoop Out Vagina
<<effects>><<set _exit to $bathroomExit or "Bathroom">>
<<if wornSetupClothes("lower").skirt>>
	$worn.lower.name【을를】 걷어 올리고,
<<elseif $worn.lower.name isnot "naked">>
	$worn.lower.name【을를】 내리고,
	<<lowerstrip>>
<<else>>
	손을 사타구니로 뻗어,
<</if>>
<<if $worn.under_lower.name isnot "naked">>
	단숨에 $worn.under_lower.name【을를】 내린다. <<print $worn.under_lower.name_simple or $worn.under_lower.name>>에 묻은 끈적임이 떨어지며 당신의 <<pussy>>까지 체액이 실처럼 늘어진다.
	<<underlowerstrip>>
<<else>>
	당신은 손으로 <<pussy>> 언저리를 쓸다가 손에 체액이 실처럼 달라붙는 것을 알아챈다.
<</if>>
<<if playerHasWornVaginalDildo()>>
	<<set _toyName to $worn.vaginal_dildo.name>><<set $worn.vaginal_dildo.state to "removed">>
	당신은 _toyName【을를】 질에서 조심스럽게 빼내어 한쪽에 둔다.
<</if>>
<br><br>
<<arousal 200 "vagina">>
당신은 한참 애를 써서 질을 벌리고 깊숙이 파고들어, 안에 있는 찌꺼기를 긁어낸다.<<wash_vagina>>
<<if _toyName>>
	그런 다음 _toyName【을를】 다시 질 속으로 밀어 넣는다.<<vaginaldildoon>>
<</if>>
<br><br>
<<if $pleasure gte $pleasuremax>>
	하지만 주름 사이를 파고드는 자극이 너무 강렬해 당신은 한계를 넘어 버린다.
	<<orgasm>>
	<<set $orgasmcurrent to 0>>
	<br><br>
<</if>>
<<link [[다음|_exit]]>><<clotheson>><<run delete $bathroomExit>><</link>>
<br>

:: Bathroom Scoop Out Anus
<<effects>><<set _exit to $bathroomExit or "Bathroom">>
<<if wornSetupClothes("lower").skirt>>
	$worn.lower.name【을를】 걷어 올리고,
<<elseif $worn.lower.name isnot "naked">>
	$worn.lower.name【을를】 내리고,
	<<lowerstrip>>
<<else>>
	손을 뒤로 뻗어,
<</if>>
<<if $worn.under_lower.name isnot "naked">>
	단숨에 $worn.under_lower.name【을를】 내린다. <<print $worn.under_lower.name_simple or $worn.under_lower.name>>에 묻은 끈적임이 떨어지며 당신의 <<bottom>>까지 체액이 실처럼 늘어진다.
	<<underlowerstrip>>
<<else>>
	당신은 손으로 <<bottom>> 언저리를 쓸다가 손에 체액이 실처럼 달라붙는 것을 알아챈다.
<</if>>
<<if playerHasButtPlug()>>
	<<set _toyName to $worn.butt_plug.name>><<set $worn.butt_plug.state to "removed">>
	당신은 _toyName【을를】 항문에서 조심스럽게 빼내어 한쪽에 둔다.
<</if>>
<br><br>
<<arousal 200 "anus">>
당신은 한참 애를 써서 엉덩이를 벌리고 깊숙이 파고들어, 안에 있는 찌꺼기를 긁어낸다.<<wash_anus>>
<<if _toyName>>
	그런 다음 _toyName【을를】 다시 항문 속으로 밀어 넣는다.<<buttplugon>>
<</if>>
<br><br>
<<if $pleasure gte $pleasuremax>>
	하지만 안쪽을 파고드는 자극이 너무 강렬해 당신은 한계를 넘어 버린다.
	<<orgasm>>
	<<set $orgasmcurrent to 0>>
	<br><br>
<</if>>
<<link [[다음|_exit]]>><<clotheson>><<run delete $bathroomExit>><</link>>
<br>

:: Melusine Rain Dance
<<effects>>
<<set _rainDanceReturn to ($lastPassage and Story.has($lastPassage)) ? $lastPassage : "Garden">>
<<if $daily.melusineRainDance is 1>>
	오늘은 이미 날씨를 불렀다. 당신의 멜루신 본성에는 회복할 시간이 필요하다.
	<br><br>
	<<link [[돌아간다|_rainDanceReturn]]>><<unset $phase>><<unset $lastPassage>><</link>>
<<elseif $feetuse is "bound" or $worn.feet.type.includes("shackle")>>
	다리가 묶여 있어서 비를 부르는 춤을 출 수 없다.
	<br><br>
	<<link [[돌아간다|_rainDanceReturn]]>><<unset $phase>><<unset $lastPassage>><</link>>
<<elseif !Transformations.chimeraActive("melusine") or ($sciencetrait lt 5 and $danceskill lt 1000)>>
	이제는 멜루신 본성으로 날씨에 닿을 수 없다.
	<br><br>
	<<link [[돌아간다|_rainDanceReturn]]>><<unset $phase>><<unset $lastPassage>><</link>>
<<else>>
	당신은 하늘로 주의를 돌리고 멜루신 본성에 이끌려 비를 부르는 춤을 추기 시작한다.
	당신은 구름을 살피고 바람을 가늠하며 공기 속의 습기를 느끼면서, 날씨를
	끌어당길 가장 좋은 방법을 찾는다.
	<br><br>
	<<link [[약한 비나 눈을 부른다 (0:15)|Melusine Rain Dance Result]]>><<set $phase to "lightPrecipitation">><</link>>
	<br>
	<<link [[강한 비나 눈을 부른다 (0:15)|Melusine Rain Dance Result]]>><<set $phase to "heavyPrecipitation">><</link>>
<</if>>
<br>

:: Melusine Rain Dance Result
<<effects>>
<<set _rainDanceReturn to ($lastPassage and Story.has($lastPassage)) ? $lastPassage : "Garden">>
<<if $daily.melusineRainDance is 1>>
	오늘은 이미 날씨를 불렀다. 당신의 멜루신 본성에는 회복할 시간이 필요하다.
<<elseif $feetuse is "bound" or $worn.feet.type.includes("shackle")>>
	다리가 묶여 있어서 비를 부르는 춤을 끝까지 출 수 없다.
<<elseif !Transformations.chimeraActive("melusine") or ($sciencetrait lt 5 and $danceskill lt 1000) or !["lightPrecipitation", "heavyPrecipitation"].includes($phase)>>
	이제는 멜루신 본성으로 날씨에 닿을 수 없다.
<<else>>
	<<set $daily.melusineRainDance to 1>>
	<<set _rainDanceChance to Math.round((45 * Math.clamp($sciencetrait / 8, 0, 1)) + (45 * Math.clamp($danceskill / 2000, 0, 1)))>>
	당신은 계속 춤을 추며 하늘을 향해 팔을 들어 올린다. 구름이 당신과 함께 움직이기 시작한다.
	<<pass 15>><<tiredness 3>><<gtiredness>>
	<br><br>
	<<if random(1, 100) lte _rainDanceChance>>
		<<run Weather.set($phase, true, 6 * 60)>>
		하늘이 응답한다. <<= $phase is "lightPrecipitation" ? "약한" : "강한">> <<= Weather.precipitation is "rain" ? "비" : "눈">>【이가】 <span class="green">내리기 시작하며, 적어도 여섯 시간은 이어질 것이다</span>.
	<<else>>
		당신은 계속 춤을 추지만 구름은 모이지 않고 <span class="purple">비는 내리지 않는다</span>.
	<</if>>
<</if>>
<br><br>
<<link [[화단을 확인한다|_rainDanceReturn]]>><<unset $phase>><<unset $lastPassage>><</link>>
<br>

:: Seed List Settings
씨앗을 심을 때 보일 씨앗을 고릅니다. 이 설정은 모든 밭, 텃밭, 화분에 적용됩니다.
<br><br>
<label>제철이 아닌 씨앗 숨기기 <<checkbox "$tendingUI.hideOutOfSeason" false true autocheck>></label>
<br>
<label>현재 화단 종류에 맞지 않는 씨앗 숨기기 <<checkbox "$tendingUI.hideIncompatible" false true autocheck>></label>
<br><br>
씨앗을 하나씩 숨길 수도 있습니다:
<br>
<div id="tending-seed-visibility"><<tendingSeedVisibilitySettings>></div>
<br>
<<link [[뒤로|$tendingUIExitPassage]]>><<unset $tendingUIExitPassage>><</link>>
<br>

:: Wigdet Mod Misc Overlay [widget]
<<widget "cheats-alex">>
	<div class="settingsGrid">
		<div class="settingsHeader options">동물 호감도</div>
		<<numberStepper "🐎 말의 호감도" $farm.beasts.horses {callback: value => V.farm.beasts.horses = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐖 돼지의 호감도" $farm.beasts.pigs {callback: value => V.farm.beasts.pigs = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐄 소의 호감도" $farm.beasts.cattle {callback: value => V.farm.beasts.cattle = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐕 개의 호감도" $farm.beasts.dogs {callback: value => V.farm.beasts.dogs = value, min: -30, max: 30, step: 1, percentage: false}>>
	</div>

	<<if $farm_stage gte 6 and $farm_countdown is undefined and $wardrobes.alexFarm.unlocked is false>>
		<<set $farm_countdown to 7>>
		<<set $alex_countdown to 3>>
		<<set $wardrobes.alexFarm.unlocked to true>>
	<</if>>
	<<farmcheatsync>>

	<div class="settingsGrid">
		<div class="settingsHeader options">농장 진행도</div>
		<div class="settingsToggleItemWide description">농장 부지는 앞으로만 진행할 수 있습니다. 새 부지마다 게임 진행 데이터도 함께 초기화되기 때문입니다. 이전과 마찬가지로 진행도를 억지로 올리면 아직 끝나지 않은 농장 의뢰에 지장이 생길 수 있습니다.</div>
		<<numberStepper "🌱 농장 부지" $farm_stage_cheat {
			callback: value => {
				if (value > V.farm_stage_cheat) Wikifier.wikifyEval("<<farmincrcheat>>");
			},
			min: $farm_stage_cheat, max: 9, step: 1, activeButtons: ["single"], percentage: false
		}>>
		<<set $farm.clearing ||= 0>>
		<<numberStepper "🪓 농장 개간" $farm.clearing {callback: value => V.farm.clearing = value, min: 0, max: 100, step: 1, percentage: false}>>
	</div>

	<<if $farm_stage gte 8>>
		<<set $farm.wall ||= 0>>
		<<set $farm.tower ||= 0>>
		<<set $farm.woodland ||= 0>>
		<<set $farm.kennel ||= 0>>
		<<set $farm.barn ||= 0>>
		<<set $farm.stable ||= 0>>
		<<set $farm.coop ||= 0>>
		<<set $farm.tractor ||= 0>>
		<<set $farm.tractorplough = $farm.tractorplough is true>>
		<<set $farm.tractorseeddrill = $farm.tractorseeddrill is true>>
		<<set $farm.tractorharvester = $farm.tractorharvester is true>>
		<<set $farm.tractorloader = $farm.tractorloader is true>>
		<<set $farm.compostbin ||= 0>>
		<<set $farm.compostToProduce ||= 0>>
		<<set $farm.compostWaiting ||= 0>>
		<<set $farm.compostProducing ||= [-1, -1, -1, -1]>>
		<<set $farm.compostReady ||= 0>>
		<<set $farm.extract ||= 0>>
		<<set $farm.net ||= 0>>
		<<set $farm.cooler ||= 0>>
		<<set $farm.waterField ||= 0>>
		<<set $farm.irrigation ||= 0>>
		<<set $farm.parasitebarn ||= 0>>
		<<set $farm.greenhouse ||= 0>>
		<<set $alex_greenhouse ||= 0>>

		<div class="settingsGrid">
			<div class="settingsHeader options">건물과 토지</div>
			<<numberStepper "🧱 농장 담장" $farm.wall {callback: value => V.farm.wall = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "🗼 농장 망루" $farm.tower {callback: value => {
				V.farm.tower = value;
				V.farm.tower_guard_can_hire = value > 0 && !V.farm.tower_guard;
				if (value <= 0) delete V.farm.tower_guard;
			}, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🌳 농장 삼림" $farm.woodland {callback: value => V.farm.woodland = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🐕 농장 개집" $farm.kennel {callback: value => V.farm.kennel = value, min: 0, max: 1, step: 1, percentage: false}>>
			<<numberStepper "🏚️ 농장 헛간" $farm.barn {callback: value => V.farm.barn = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🐎 농장 마구간" $farm.stable {callback: value => V.farm.stable = value, min: 0, max: 1, step: 1, percentage: false}>>
			<<numberStepper "🐔 농장 닭장" $farm.coop {callback: value => V.farm.coop = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🌿 농장 온실" $farm.greenhouse {callback: value => V.farm.greenhouse = value, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🏡 고아원 온실" $alex_greenhouse {callback: value => V.alex_greenhouse = value, min: 0, max: 3, step: 1, percentage: false}>>
		</div>

		<div class="settingsGrid">
			<div class="settingsHeader options">장비와 개선</div>
			<<numberStepper "🚜 농장 트랙터" $farm.tractor {callback: value => V.farm.tractor = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "⚙️ 트랙터 쟁기" `$farm.tractorplough ? 1 : 0` {callback: value => V.farm.tractorplough = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "켜짐" : "꺼짐"}>>
			<<numberStepper "🌾 트랙터 파종기" `$farm.tractorseeddrill ? 1 : 0` {callback: value => V.farm.tractorseeddrill = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "켜짐" : "꺼짐"}>>
			<<numberStepper "🌽 트랙터 수확기" `$farm.tractorharvester ? 1 : 0` {callback: value => V.farm.tractorharvester = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "켜짐" : "꺼짐"}>>
			<<numberStepper "📦 트랙터 로더" `$farm.tractorloader ? 1 : 0` {callback: value => V.farm.tractorloader = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "켜짐" : "꺼짐"}>>
			<<numberStepper "♻️ 퇴비통" $farm.compostbin {callback: value => V.farm.compostbin = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "🧪 최음제 추출 장치" $farm.extract {callback: value => V.farm.extract = value, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🥅 농장 그물" $farm.net {callback: value => V.farm.net = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "❄️ 농장 냉장고" $farm.cooler {callback: value => V.farm.cooler = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "💧 물 대는 밭" $farm.waterField {callback: value => V.farm.waterField = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "🚿 농장 관개 시설" $farm.irrigation {callback: value => V.farm.irrigation = value, min: 0, max: 9, step: 1, percentage: false}>>
			<<numberStepper "🪱 기생충 헛간" $farm.parasitebarn {callback: value => V.farm.parasitebarn = value, min: 0, max: 2, step: 1, percentage: false}>>
		</div>
	<</if>>
<</widget>>

/* X-Change: pick which Hopeless Cycle endings to buy.
Like any feat boost, these can be purchased outright with VrelCoins. */
<<widget "hopelessEndingsFeatUI">>
	<br>
	<div class="settingsHeader" style="margin-bottom: 0.5em">읽을 엔딩</div>
	<<for _hcEndKey range ["S","A","B","C","D","E","F"]>>
		<<set _hcEndData to setup.hopelessCycleEndingCosts[_hcEndKey]>>
		<<set _hcEndCost to _hcEndData.cost>>
		<<capture _hcEndKey, _hcEndData, _hcEndCost>>
			<<set _hcEndAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - _hcEndCost gte 0>>
			<div class="settingsToggleItem">
				<<if $featsBoosts.hopelessEndings[_hcEndKey]>>
					<<link "[✓] 엔딩 _hcEndKey">>
						<<set $featsBoosts.hopelessEndings[_hcEndKey] to false>>
						<<updateFeatsPointsMenu "hopelessEndings" _hcEndCost "subtract">>
					<</link>>
					<span @class="_hcEndData.colour"><<print _hcEndData.name>></span>
					<span class="gold">(<<print _hcEndCost>> <<pluralise _hcEndCost "VrelCoin">>)</span>
				<<elseif _hcEndAfford>>
					<<link "[ ] 엔딩 _hcEndKey">>
						<<set $featsBoosts.hopelessEndings[_hcEndKey] to true>>
						<<updateFeatsPointsMenu "hopelessEndings" _hcEndCost>>
					<</link>>
					<span @class="_hcEndData.colour"><<print _hcEndData.name>></span>
					<span class="gold">(<<print _hcEndCost>> <<pluralise _hcEndCost "VrelCoin">>)</span>
				<<else>>
					<span class="black">[ ] 엔딩 _hcEndKey <span @class="_hcEndData.colour"><<print _hcEndData.name>></span></span>
					<span class="red">브렐 코인이 부족합니다 (<<print _hcEndCost>>)</span>
				<</if>>
			</div>
		<</capture>>
	<</for>>
<</widget>>

/* X-Change: links to read endings bought via the "Hopeless Cycle Endings" feat boost, skipping the full sequence.
Each sets up the gaoler context (freeze/morph), then jumps straight to that ending's narrative, which funnels into "Hopeless Cycle End" and awards the prize. */
<<widget "hopelessCycleQuickReadLinks">>
	<<set $hcBoughtEndings ||= []>>
	<<set _quickReadList to ["S","A","B","C","D","E","F"].filter(e => $hcBoughtEndings.includes(e))>>
	<<if _quickReadList.length>>
		이 이야기들 중에는 이미 겪어 본 것처럼 느껴지는 것이 있다. <span class="gold">결말까지 곧장 이야기할 수 있다</span>:
		<br>
		<<for _qrEnd range _quickReadList>>
			<<capture _qrEnd>>
				<<set _qrData to setup.hopelessCycleEndingCosts[_qrEnd]>>
				<<link `"엔딩 읽기: " + _qrData.name + " (" + _qrEnd + ")"` `"Hopeless Cycle Ending " + _qrEnd`>>
					<<hopelessCycleStart>>
				<</link>>
				<br>
			<</capture>>
		<</for>>
		<br>
	<</if>>
<</widget>>

<<widget "reclaimWhitney">>
    <<loveInterestAdd "Whitney">>
    <<npcset Whitney state "active">>
<</widget>>

<<widget "reclaimKylar">>
    <<npcset Kylar state "active">>
    <<if $englishPlay is "ongoing">>
            <<set $englishPlayKylarReplace to false>>
    <</if>>
    <<loveInterestAdd "Kylar">>
    <br><br>
<</widget>>

<<widget "godClothe">>
    <<if $godClothes is undefined>>
        <<set $godClothes to 0>>
    <</if>>
    <<if $godClothes is 0>>
        <<set $godClothes to 0>>
    <<elseif $godClothes is 1>>
        <<set $godClothes to 1>>
    <</if>>
<</widget>>

<<widget "tendingSeedVisibilitySettings">>
	<<if $plants_known.length is 0>>
		아직 발견한 씨앗이 없습니다.
	<<else>>
		<<for _plantType range $plants_known>>
			<<set _plant to setup.foodstuff[_plantType]>>
			<<if _plant>>
				<<set _seedName to (_plant.tending?.seed_name || _plant.plural || _plant.name || _plantType).replace(/_/g, " ").toLocaleUpperFirst()>>
				<<capture _plantType>>
					<<if $options.images is 1>><<foodstufficon _plantType>><</if>>
					_seedName:
					<<if $tendingUI.hiddenSeeds.includes(_plantType)>>
						<span class="red">숨김</span> - <<link "보이기">><<run $tendingUI.hiddenSeeds.delete(_plantType)>><<replace "#tending-seed-visibility">><<tendingSeedVisibilitySettings>><</replace>><<numberify "#passages > .passage">><</link>>
					<<else>>
						<span class="green">표시 중</span> - <<link "숨기기">><<run $tendingUI.hiddenSeeds.pushUnique(_plantType)>><<replace "#tending-seed-visibility">><<tendingSeedVisibilitySettings>><</replace>><<numberify "#passages > .passage">><</link>>
					<</if>>
					<br>
				<</capture>>
			<</if>>
		<</for>>
		<<if $tendingUI.hiddenSeeds.length gt 0>>
			<br>
			<<link "모든 씨앗 보이기">><<set $tendingUI.hiddenSeeds to []>><<replace "#tending-seed-visibility">><<tendingSeedVisibilitySettings>><</replace>><<numberify "#passages > .passage">><</link>>
		<</if>>
	<</if>>
<</widget>>

/* Add gender presentation meter in mirror */
<<widget "genderAppearanceMeter">>
	<<if Number.isFinite($player.femininity)>>
		<<set _appearanceGender to perceivedGender()>>
		<<set _appearanceScore to $player.femininity>>

		/* Visual meter range. Scores beyond this are simply pinned to the edge. */
		<<set _appearanceLimit to 2000>>

		<<set _appearancePosition to Math.clamp(
			((_appearanceScore + _appearanceLimit) / (_appearanceLimit * 2)) * 100,
			0,
			100
		)>>

		<<set _appearanceDeadzoneSize to
			(ANDROGYNOUS_FEMININITY_DEADZONE / (_appearanceLimit * 2)) * 100
		>>
		<<set _appearanceDeadzoneStart to 50 - _appearanceDeadzoneSize>>
		<<set _appearanceDeadzoneEnd to 50 + _appearanceDeadzoneSize>>

		<<set _appearanceName to
			_appearanceGender is "m"
				? "남성적"
				: _appearanceGender is "f"
					? "여성적"
					: "중성적"
		>>

		<<set _appearanceTitle to
			"성별 외모: " + _appearanceName
			+ " (" + (_appearanceScore gt 0 ? "+" : "") + _appearanceScore + "). "
			+ "중성 범위: -" + ANDROGYNOUS_FEMININITY_DEADZONE
			+ " ~ +" + ANDROGYNOUS_FEMININITY_DEADZONE + "."
		>>

		<div class="genderAppearance">
			<div class="genderAppearanceHeader">
				<span class="genderAppearanceLabel">외모</span>

				<<settextcolorfromgender _appearanceGender>>
				<span @class="'genderAppearanceValue ' + _text_color">
					<<print _appearanceName>>
					<span class="genderAppearanceScore">
						(<<if _appearanceScore gt 0>>+<</if>><<print _appearanceScore>>)
					</span>
				</span>
			</div>

			<div
				class="genderAppearanceBar"
				@title="_appearanceTitle"
				@style="'background: linear-gradient(to right, '
					+ 'var(--lblue) 0%, '
					+ 'var(--lblue) ' + _appearanceDeadzoneStart + '%, '
					+ 'var(--purple) ' + _appearanceDeadzoneStart + '%, '
					+ 'var(--purple) ' + _appearanceDeadzoneEnd + '%, '
					+ 'var(--pink) ' + _appearanceDeadzoneEnd + '%, '
					+ 'var(--pink) 100%);'"
			>
				<div
					class="genderAppearancePin"
					@style="'left:' + _appearancePosition + '%;'"
				></div>
			</div>

			<div class="genderAppearanceScale">
				<span>남성적</span>
				<span>중성적</span>
				<span>여성적</span>
			</div>
		</div>
	<</if>>
<</widget>>