:: X-Change Misc Widgets [widget]
	<!-- Usage: <<fame-propagate 10 "scrap" "good">> after <<fame>>. Applies the same change to other stored body identities. -->
	<<widget "fame-propagate">>
		<<if _args.length gte 2 and $statFreeze isnot true>>
			<!-- Partial body records have no identity fame yet. Shared fame objects must only receive the penalty once. -->
			<<set _propagateCurrentFame to $fame>>
			<<set _propagateFames to [...new Set([$xchange.pill.changedBody?.fame, $xchange.pill.originalBody?.fame, $xchange.pill.hermBody?.fame])].filter(fame => fame && typeof fame === "object" && !Array.isArray(fame) && fame !== $fame)>>
			<<for _propagateFame range _propagateFames>>
				<<set $fame to _propagateFame>>
				<<for _propagateType range _args.slice(1)>>
					<<fame _args[0] _propagateType>>
				<</for>>
			<</for>>
			<<set $fame to _propagateCurrentFame>>
		<</if>>
	<</widget>>

	<!-- Usage: <<xchange-fame 10>>, or <<xchange-fame 10 true>> to apply regardless of mask/gloryhole (e.g. a third party doing it for you, rather than you being recognised in person). -->
	<<widget "xchange-fame">>
		<<if _args[0] and $statFreeze isnot true>>
			<<if _args[1] is true>>
				<<set _maskFactor to 1>>
			<<elseif playerIsXChanged() and !$gloryhole>>
				<!-- A mask/covered face fully hides you below 500 X-Change fame, only halves recognition from 500-999, and stops concealing you at all at 1000 (max): you're too recognisable by then regardless of your face. -->
				<<if $face isnot "covered" and !$worn.face.type.includes("mask")>>
					<<set _maskFactor to 1>>
				<<elseif $xchange_fame gte 1000>>
					<<set _maskFactor to 1>>
				<<elseif $xchange_fame gte 500>>
					<<set _maskFactor to 0.5>>
				<<else>>
					<<set _maskFactor to 0>>
				<</if>>
			<<else>>
				<<set _maskFactor to 0>>
			<</if>>
			<<if _maskFactor gt 0>>
				<<set $xchange_fame += _args[0] * _maskFactor * 2>>
				<<set $xchange_fame to Math.clamp($xchange_fame, 0, 1000)>>
				<<if $xchange_fame gte 1000>>
					<<for _name range $NPCNameList>>
						<<set $xchange.known.pushUnique(_name)>>
					<</for>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "xchange-seen">>
		<<if $xchange.pill.genderflipEffect>>
			<<set _increase to 10 * _args[0]>>
			<<xchange-fame _increase>>
		<</if>>
	<</widget>>

	<<widget "currentSexSidebar">>
		<<if $options.showCurrentSexIcon>>
			<div id="bodysex-sidebar" class="bodysex-sidebar">
				<<if $options.currentSexIconIdentity>>
					<<set _sidebarGender to playerFeltGender()>>
					<<set _sidebarGenderLabel to $background.transgender ? playerTransLabel() : playerGenderWord()>>
					<<set _sidebarGenderIcon to $background.transgender ? "trans-" + _sidebarGender + ".png" : (_sidebarGender is "n" ? "nonbinary.png" : (_sidebarGender is "f" ? "female.png" : "male.png"))>>
					<div @tooltip="'성 정체성: ' + _sidebarGenderLabel"><img draggable="false" @alt="_sidebarGenderLabel" @src="'img/misc/icon/' + _sidebarGenderIcon"></div>
				<<elseif playerIsXChanged() and $xchange.pill.hermEffect and !$statFreeze>>
					<div tooltip="<span class='green'>양성</span>"><img dragable="false" src="img/misc/icon/unisex.png"></div>
					
				<<elseif $player.sex is "f">>
					<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and !$xchange.pill.genderflipEffect>>
						<div tooltip="<span class='blue'>부치</span>"><img dragable="false" src="img/misc/icon/butch.png"></div>
					<<else>>
						<div tooltip="<span class='meek'>여성</span>"><img dragable="false" src="img/misc/icon/female.png"></div>
					<</if>>
				<<elseif $player.sex is "m">>
					<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and !$xchange.pill.genderflipEffect>>
						<div tooltip="<span class='meek'>시시</span>"><img dragable="false" src="img/misc/icon/sissy.png"></div>
					<<else>>
						<div tooltip="<span class='blue'>남성</span>"><img dragable="false" src="img/misc/icon/male.png"></div>
					<</if>>
				<</if>>
			</div>
		<</if>>
	<</widget>>

	<<widget "arousal-wetness">>
		<<if $arousal gte $arousalmax * 0.6>>
			<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 10)>>
		<<elseif $arousal gte $arousalmax * 0.3>>
			<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 5)>>
		<</if>>
	<</widget>>

	<<widget "breeder-heat">>
		<<willpowercombatcheck>>
		<<if !$willpowerSuccess or !$xchange.heat.resistWithWillpower>>
			/* Breeding holes: a vagina always counts; omega (and other butt-pregnancy) heat breeds through the anus. Being bred in any eligible hole satisfies the compulsion. */
			<<set _heatVaginal to $player.vaginaExist and !playerChastity("vagina") and $vaginatarget isnot undefined and $NPCList[$vaginatarget] isnot undefined>>
			<<set _heatAnal to canBeMPregnant() and !playerChastity("anus")>>
			<<set _heatAnalTargeted to _heatAnal and $anustarget isnot undefined and $NPCList[$anustarget] isnot undefined>>
			<<set _vaginalBred to _heatVaginal and ($vaginastate is "penetrated" or $vaginastate is "doublepenetrated")>>
			<<set _analBred to _heatAnal and ($anusstate is "penetrated" or $anusstate is "doublepenetrated")>>
			<<set _beingBred to _vaginalBred or _analBred>>
			<<if _heatVaginal and !_heatAnal>>
				<<if $anusstate is "entrance" and $vaginastate isnot "doublepenetrated">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "penispussy">>
				<</if>>
				<<if $anusstate is "imminent" and $vaginastate isnot "penetrated">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "escape">>
				<</if>>
			<</if>>
			<<if $cheekaction is "rub" and !_beingBred and !_heatAnal>>
				<<set $xchange.heat.message to true>>
				<<set $cheekaction to "stop">>					
			<</if>>
			<<if ($mouthstate is "entrance" or $mouthstate is "imminent" or ($mouthstate is "penetrated" and $head isnot "grappled" and $head isnot "bound")) and !_beingBred>>
				<<set $xchange.heat.message to true>>
				<<set $mouthaction to "pullaway">>
			<</if>>
			<<if $chestuse is "penis" and !_beingBred>>
				<<set $xchange.heat.message to true>>
				<<set $chestaction to "stop">>
			<</if>>
			<<if _heatVaginal and !wearingCondom($vaginatarget) and $vaginastate is "penetrated" and $NPCList[$vaginatarget].penis is "vagina" and $leglocktarget is undefined and $leftleg isnot "bound" and $rightleg isnot "bound">> 
				<<set $xchange.heat.message to true>>
				<<set $feettarget to $vaginatarget>>
				<<set $feetaction to "legLock">>
			<</if>>
			<<if _heatVaginal and !wearingCondom($vaginatarget) and $feetaction is "legRelease">>
				<<set $xchange.heat.message to true>>
				<<set $feetaction to "legLocked">>
			<</if>>
			<<if _heatVaginal and !_beingBred and (($vaginaaction is "penisanus" and !_heatAnal) or $vaginaaction is "penisthighs" or $vaginaaction is "penismouth")>>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "penistease">>
			<</if>>
			<<if _heatVaginal and !_beingBred and !wearingCondom($vaginatarget) and $worn.under_lower.vagina_exposed is 1 and $worn.lower.vagina_exposed is 1 and ($NPCList[$vaginatarget].penis is "vaginaentrance" or $NPCList[$vaginatarget].penis is "vaginaimminent")>>			
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "vaginapenisfuck">>
			<</if>>
			<<if _heatVaginal and !_beingBred and !wearingCondom($vaginatarget) and $NPCList[$vaginatarget].penis is 0 and $NPCList[$vaginatarget].stance isnot "topface" and ($enemytype isnot "man" or ($NPCList[$vaginatarget].location.genitals is 0 and $NPCList[$vaginatarget].location.head isnot "genitals")) and !npcHasStrapon($vaginatarget)>>			
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "vaginatopenis">>
			<</if>>
			<<if $askAction is "condoms">>
				<<set $xchange.heat.message to true>>
				<<set $askAction to "noCondoms">>
			<</if>>
			<<if $askAction is "novaginal" or $askAction is "askPullOut" or $askAction is "finish" or ($askAction is "noanal" and _heatAnal)>>
				<<set $xchange.heat.bypassAsk to true>>
			<</if>>
			<<if _heatVaginal and ($vaginastate is "penetrated" or $vaginastate is "doublepenetrated") and wearingCondom($vaginatarget) and $mouthstate is 0>>
				<<set $xchange.heat.message to true>>
				<<set $mouthtarget to $vaginatarget>>
				<<set $mouthaction to "ask">>
				<<set $askAction to "noCondoms">> 
			<</if>>
			<<if $thighuse is "penis">>
				<<set $xchange.heat.message to true>>
				<<set $thighaction to "stop">>
			<</if>>
			<<if _heatVaginal and $vaginastate is "othermouthimminent">>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "othermouthescape">>
			<</if>>
			<<if _heatVaginal and $vaginastate is "othermouthentrance">>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "thighbay">>
			<</if>>
			/*Arm Actions */
			<<if _heatVaginal and $leftarm isnot "bound" and $rightarm isnot "bound" and !_beingBred>>
				<<set $lefttarget to $vaginatarget>><<set $righttarget to $vaginatarget>>
				<<if $leftaction is "leftcovervaginameek" or $leftaction is "leftcovervaginalewd" or $leftaction is "leftcovervagina" or $leftaction is "leftgrab">>
				<<set $xchange.heat.message to true>>
					<<set $leftaction to "rest">>
				<</if>>
				<<if $rightaction is "rightcovervaginameek" or $rightaction is "rightcovervaginalewd" or $rightaction is "rightcovervagina" or $rightaction is "rightgrab">>
				<<set $xchange.heat.message to true>>
					<<set $rightaction to "rest">>
				<</if>>
				<<if $NPCList[$vaginatarget].penis is "clothed">>
				<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightUndressOther">>
					<<set $undressRightTarget to "lower">>		
				<</if>>
				<<if $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>			
				<<set $xchange.heat.message to true>>
					<<set $leftaction to "lower">><<set $rightaction to "lower">>
					<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
						<<set $xchange.heat.message to true>>
						<<set $rightaction to "under_lower">>	
					<</if>>
				<</if>>
				<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon()) and ($worn.lower.state isnot wornSetupClothes("lower").state_base or wornSetupClothes("lower").skirt is 1 or $worn.lower.type.includes("naked"))>>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "under_lower">>			
				<</if>>
				<<if wearingCondom($vaginatarget)>>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "npcremovecondom">>		
				<</if>>
				<<if (($NPCList[$lefttarget].lefthand and $NPCList[$lefttarget].lefthand.startsWith("vagina")) or ($NPCList[$lefttarget].righthand and $NPCList[$lefttarget].righthand.startsWith("vagina")))>>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "handpullvagina">>
				<</if>>
				<<if $NPCList[$lefttarget].mouth and $NPCList[$lefttarget].mouth.startsWith("vagina")>>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "stoporal">>
				<</if>>
				<<if $leftarm is "vagina">>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "leftstopvagina">>
				<</if>>
				<<if $rightarm is "vagina">>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightstopvagina">>
				<</if>>
				<<if $leftaction is "leftwork">>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "leftstoppenis">>
				<</if>>
				<<if $rightaction is "rightwork">>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightstoppenis">>
				<</if>>
			<</if>>
			<<if _heatAnalTargeted>>
				<<if !_beingBred and ["anusentrance","anusimminent"].includes($NPCList[$anustarget].penis) and !wearingCondom($anustarget)>>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "anuspenisfuck">>
				<</if>>
				<<if !_beingBred and (($anusaction is "penispussy" and !_heatVaginal) or ($anusaction is "penispussydap" and !_heatVaginal) or $anusaction is "penismouth" or $anusaction is "penischeeks")>>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "penistease">>
				<</if>>
				<<if !wearingCondom($anustarget) and $anusstate is "penetrated" and $NPCList[$anustarget].penis is "anus" and $leglocktarget is undefined and $leftleg isnot "bound" and $rightleg isnot "bound">>
					<<set $xchange.heat.message to true>>
					<<set $feettarget to $anustarget>>
					<<set $feetaction to "legLock">>
				<</if>>
				<<if _analBred and !wearingCondom($anustarget) and $feetaction is "legRelease">>
					<<set $xchange.heat.message to true>>
					<<set $feetaction to "legLocked">>
				<</if>>
				<<if _analBred and wearingCondom($anustarget) and $mouthstate is 0>>
					<<set $xchange.heat.message to true>>
					<<set $mouthtarget to $anustarget>>
					<<set $mouthaction to "ask">>
					<<set $askAction to "noCondoms">>
				<</if>>
				<<if $anusstate is "othermouthimminent">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "othermouthescape">>
				<</if>>
				<<if $anusstate is "othermouthentrance">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "bottombay">>
				<</if>>
				<<if !_heatVaginal>>
					<<if !_beingBred and !wearingCondom($anustarget) and $NPCList[$anustarget].penis is 0 and $NPCList[$anustarget].stance isnot "topface" and ($enemytype isnot "man" or ($NPCList[$anustarget].location.genitals is 0 and $NPCList[$anustarget].location.head isnot "genitals")) and !npcHasStrapon($anustarget)>>
						<<set $xchange.heat.message to true>>
						<<set $anusaction to "anustopenis">>
					<</if>>
					/*Arm Actions */
					<<if $leftarm isnot "bound" and $rightarm isnot "bound" and !_beingBred>>
						<<set $lefttarget to $anustarget>><<set $righttarget to $anustarget>>
						<<if $NPCList[$anustarget].penis is "clothed">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightUndressOther">>
							<<set $undressRightTarget to "lower">>
						<</if>>
						<<if $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "lower">><<set $rightaction to "lower">>
							<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
								<<set $xchange.heat.message to true>>
								<<set $rightaction to "under_lower">>
							<</if>>
						<</if>>
						<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon()) and ($worn.lower.state isnot wornSetupClothes("lower").state_base or wornSetupClothes("lower").skirt is 1 or $worn.lower.type.includes("naked"))>>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "under_lower">>
						<</if>>
						<<if wearingCondom($anustarget)>>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "npcremovecondom">>
						<</if>>
						<<if (($NPCList[$lefttarget].lefthand and $NPCList[$lefttarget].lefthand.startsWith("anus")) or ($NPCList[$lefttarget].righthand and $NPCList[$lefttarget].righthand.startsWith("anus")))>>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "handpullanus">>
						<</if>>
						<<if $leftarm is "anus">>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "leftstopanus">>
						<</if>>
						<<if $rightarm is "anus">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightstopanus">>
						<</if>>
						<<if $leftaction is "leftwork">>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "leftstoppenis">>
						<</if>>
						<<if $rightaction is "rightwork">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightstoppenis">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "breeder-heat-chastity">>
		<<willpowercombatcheck>>
		<<if !$willpowerSuccess or !$xchange.heat.resistWithWillpower>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">발정기가 당신을 집어삼키지만,</span> 당신의 $worn.genitals.name【이가】 <span class="pink">씨를 받지 못하게 막아 준다</span>.
			<<else>>
				<span class="red">번식하고 싶은 압도적인 욕구가 당신을 덮치지만,</span> 당신의 $worn.genitals.name【이가】 <span class="pink">가로막고 있다</span>.
			<</if>>
			<<if $leftarm isnot "bound" and $rightarm isnot "bound" and $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>
				/* The device is still hidden: tear at the clothes covering it, mirroring the unlocked undress compulsion */
				당신의 손이 그것을 덮은 <span class="purple">옷을 쥐어뜯는다</span>.
				<<set $leftaction to "lower">><<set $rightaction to "lower">>
				<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
					<<set $rightaction to "under_lower">>
				<</if>>
			<<elseif $leftarm isnot "bound" and $rightarm isnot "bound" and $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
				당신의 손이 그것을 덮은 <span class="purple">옷을 쥐어뜯는다</span>.
				<<set $rightaction to "under_lower">>
			<<elseif $worn.genitals.name is "chastity parasite">>
				당신은 사타구니에 달라붙은 생물을 붙잡고 <span class="purple">떼어 내려 애쓰지만</span>, 그것은 오히려 당신을 조여 오며 <span class="lewd">흥분만 더 심해지게 만든다</span>.
				<<set $worn.genitals.integrity -= 5>><<arousal 100 "genitals">>
				<<integritycheck>>
			<<elseif $leftarm isnot "bound" and $rightarm isnot "bound">>
				당신의 손이 장치를 할퀴고 비틀어 보지만 <span class="purple">잠금장치에 가로막혀 애만 쓸 뿐이다</span>.
				<<set $worn.genitals.integrity -= 20>>
				<<integritycheck>>
			<<elseif $leftarm isnot "bound" or $rightarm isnot "bound">>
				자유로운 한 손이 장치를 할퀴고 잡아당기지만 <span class="purple">잠금장치에 가로막혀 애만 쓸 뿐이다</span>.
				<<set $worn.genitals.integrity -= 10>>
				<<integritycheck>>
			<<else>>
				속박된 채로는 <span class="purple">장치에 몸을 비틀고 비벼 대는</span> 수밖에 없다.
			<</if>>
			<<if playerAwareTheyCanBePregnant()>>
				당신의 일부는 <span class="lewd">누군가 이음매 너머로 사정해 주기를 간절히 바라며</span>, 조금이라도 스며들기를 기대한다.
			<</if>>
		<</if>>
	<</widget>>

	<<widget "effectsman-xchange">>
		<<set $xchange.heat.controlActive to false>>
		/*Heat Message */
		<<if $xchange.heat.systemOn and playerHeatMinArousal() and $position isnot "stalk">>
			/* A combined Alpha/Breeder/Omega body follows its dominant rut while its penis is usable. If caged, receptive heat can still take over. */
			<<set _alphaDominantHeat to !$statFreeze and !$hc and playerIsXChanged() and $xchange.pill.alphaEffect and $player.penisExist and !playerChastity("penis")>>
			<<set _heatVaginalTrigger to false>>
			<<set _heatAnalTrigger to false>>
			<<if $player.vaginaExist and !playerChastity("vagina") and $vaginatarget isnot undefined>>
				<<set _vaginaNpc to $NPCList[$vaginatarget]>>
				<<set _vaginaNpcPenisLocked to (_vaginaNpc and _vaginaNpc.chastity and _vaginaNpc.chastity.penis and _vaginaNpc.chastity.penis.includes("chastity"))>>
				<<set _heatVaginalTrigger to _vaginaNpc isnot undefined and _vaginaNpc.penis isnot "none" and $vaginastate isnot "othermouth" and !_vaginaNpcPenisLocked>>
			<</if>>
			/* Omega (and other butt-pregnancy) heat also answers to the anus */
			<<if canBeMPregnant() and !playerChastity("anus") and $anustarget isnot undefined>>
				<<set _anusNpc to $NPCList[$anustarget]>>
				<<set _anusNpcPenisLocked to (_anusNpc and _anusNpc.chastity and _anusNpc.chastity.penis and _anusNpc.chastity.penis.includes("chastity"))>>
				<<set _heatAnalTrigger to _anusNpc isnot undefined and _anusNpc.penis isnot "none" and $anusstate isnot "othermouth" and !_anusNpcPenisLocked>>
			<</if>>
			<<if (_heatVaginalTrigger or _heatAnalTrigger) and !_alphaDominantHeat>>
				<<breeder-heat>>
			<<elseif !_alphaDominantHeat and !($player.vaginaExist and !playerChastity("vagina")) and !(canBeMPregnant() and !playerChastity("anus"))>>
				/* Every eligible breeding hole is locked behind chastity: heat rails against the device instead of going quiet */
				<<set _heatLockedNpcPresent to $NPCList.some(npc => npc && npc.active === "active" && npc.penis !== "none" && !(npc.chastity && npc.chastity.penis && npc.chastity.penis.includes("chastity")))>>
				<<if _heatLockedNpcPresent>>
					<<breeder-heat-chastity>>
				<</if>>
			<</if>>
		<</if>>
		<<if $xchange.heat.message or $xchange.heat.bypassAsk>>
			<<set $xchange.heat.controlActive to true>>
		<</if>>
		<<if $xchange.heat.message>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">발정기가 당신을 집어삼킨다.</span> <span class="gold">욕정이 당신의 행동을 지배한다.</span>
			<<else>>
				<span class="red">번식하고 싶은 압도적인 욕구가 당신을 덮친다.</span> <span class="gold">욕정이 당신의 행동을 지배한다.</span>
			<</if>>
			<<set $xchange.heat.message to false>>
		<</if>>
		<<encounterIdentityEffects>>
	<</widget>>

	<<widget "arousal-moan">>
		<<set _gain to _args[0]>>
		<<set _sensitivity to _args[1]>>
		<<if $settings.arousalMoanEnabled and _gain gte 400 and _sensitivity gt 1>>
			<<set _penetrating to playerIsPenetrating()>>
			<<set _penetrated to playerIsPenetrated()>>
			/* Being penetrated (or any non-penetrative arousal, e.g. masturbation/petting) moans; actively penetrating someone grunts instead. Doing both at once (e.g. double-dipping) fires both lines. */
			<<set _showMoan to _penetrated or !_penetrating>>
			<<set _showGrunt to _penetrating>>

			<<if _showMoan>>
				<<if $pleasure lt $pleasuremax * 0.2 and $orgasmcurrent lt 1>>
				<<elseif $pleasure lt $pleasuremax * 0.4 and $orgasmcurrent lt 1>>
					<<switch $speechcycle>>
						<<case 0>>
							"음-음!"
						<<case 1>>
							"읍..."
						<<case 2>>
							"으..."
						<<case 3>>
							"음-음!"
						<<case 4>>
							"으..."
						<<default>>
							"읍..."
					<</switch>>
					<span class="pink">입술 사이로 먹먹한 신음이 새어 나온다.</span>
				<<elseif $pleasure lt $pleasuremax * 0.6 and $orgasmcurrent lt 1>>
					<<switch $speechcycle>>
						<<case 0>>
							"아-아!<<hearticon>>"
						<<case 1>>
							"음...<<hearticon>>"
						<<case 2>>
							"으...<<hearticon>>"
						<<case 3>>
							"아-아!<<hearticon>>"
						<<case 4>>
							"으... 아...<<hearticon>>"
						<<default>>
							"음...<<hearticon>>"
					<</switch>>
					<span class="pink">당신은 나직이 신음한다.</span>
				<<elseif $pleasure lt $pleasuremax * 0.8>>
					<<switch $speechcycle>>
						<<case 0>>
							"아-아!...<<hearticon>> 아...<<hearticon>>"
						<<case 1>>
							"음...<<hearticon>> 흐!<<hearticon>>"
						<<case 2>>
							"으...<<hearticon>> 아!<<hearticon>>"
						<<case 3>>
							"하...<<hearticon>> 하...<<hearticon>>"
						<<case 4>>
							"으...<<hearticon>> 아!<<hearticon>>"
						<<default>>
							"하...<<hearticon>> 음...!<<hearticon>>"
					<</switch>>
					<span class="pink">당신은 리듬에 맞춰 신음하고 있다.</span>
				<<elseif $pleasure lte $pleasuremax>>
					<<switch $speechcycle>>
						<<case 0>>
							"아-아...!<<hearticon>> 하...<<hearticon>> 음...!<<hearticon>>"
						<<case 1>>
							"아...!<<hearticon>> 으...!<<hearticon>> 음...!<<hearticon>>"
						<<case 2>>
							"씨발...<<hearticon>> 오...<<hearticon>> 음...!<<hearticon>>"
						<<case 3>>
							"하...<<hearticon>> 으...!<<hearticon>> 아-아...!<<hearticon>>"
						<<case 4>>
							"아!<<hearticon>> 아!<<hearticon>> 씨발!<<hearticon>>"
						<<default>>
							"아...!<<hearticon>> 하...<<hearticon>> 오...!<<hearticon>>"
					<</switch>>
					<<if $pleasure is $pleasuremax>>
						<span class="pink">절정이 다가온다.</span>
					<<else>>
						<span class="pink">당신은 걷잡을 수 없이 헐떡인다.</span>
					<</if>>
				<</if>>
			<</if>>

			<<if _showGrunt>>
				<<if $pleasure lt $pleasuremax * 0.2 and $orgasmcurrent lt 1>>
				<<elseif $pleasure lt $pleasuremax * 0.4 and $orgasmcurrent lt 1>>
					<<switch $speechcycle>>
						<<case 0>>
							"흐..."
						<<case 1>>
							"칫..."
						<<case 2>>
							"으."
						<<case 3>>
							"흐..."
						<<case 4>>
							"칫..."
						<<default>>
							"흐..."
					<</switch>>
					<span class="pink">낮게 끙 하는 소리가 입술 사이로 새어 나온다.</span>
				<<elseif $pleasure lt $pleasuremax * 0.6 and $orgasmcurrent lt 1>>
					<<switch $speechcycle>>
						<<case 0>>
							"하..."
						<<case 1>>
							"으..."
						<<case 2>>
							"씨발..."
						<<case 3>>
							"하..."
						<<case 4>>
							"흐... 으..."
						<<default>>
							"으..."
					<</switch>>
					<span class="pink">당신은 숨죽여 끙끙댄다.</span>
				<<elseif $pleasure lt $pleasuremax * 0.8>>
					<<switch $speechcycle>>
						<<case 0>>
							"하!... 하!"
						<<case 1>>
							"으! 흐!"
						<<case 2>>
							"씨발... 으!"
						<<case 3>>
							"흐... 흐..."
						<<case 4>>
							"으! 하!"
						<<default>>
							"하... 흐!"
					<</switch>>
					<span class="pink">당신은 몸을 부딪칠 때마다 끙끙댄다.</span>
				<<elseif $pleasure lte $pleasuremax>>
					<<switch $speechcycle>>
						<<case 0>>
							"하...! 흐! 씨발...!"
						<<case 1>>
							"으...! 흐...! 씨발!"
						<<case 2>>
							"씨발... 으! 으...!"
						<<case 3>>
							"흐... 하! 씨발...!"
						<<case 4>>
							"하! 하! 씨발!"
						<<default>>
							"으...! 음... 씨발!"
					<</switch>>
					<<if $pleasure is $pleasuremax>>
						<span class="pink">절정이 다가온다.</span>
					<<else>>
						<span class="pink">당신은 이를 악물고 끙끙댄다.</span>
					<</if>>
				<</if>>
			<</if>>

			<<set $speechcycle to random(0,7)>>
			<<if $speechcycle gte 7>>
				<<set $speechcycle to 0>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "willpowercaption">>
		<<if Number.isFinite($xchange.willpowerPoints)>>
			<<set _willpowerRestLeft to willpowerRestAllowanceLeft()>>
			<<set _willpowerTitle to "의지력: " + $xchange.willpowerPoints.toFixed(2)>>
			<<if _willpowerRestLeft gt 0>><<set _willpowerTitle += String.fromCharCode(10) + "오늘 휴식으로 " + Math.round(_willpowerRestLeft) + "만큼 더 회복할 수 있습니다.">><</if>>
			<div id="willpowercaption" @title="_willpowerTitle">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					의지력:
					<<if $options.showCaptionText is true>>
						<<if $xchange.willpowerPoints gte $willpowermax * (6/5)>>
							<span class="gold">당신은 강철 같은 의지를 지녔다.</span>
						<<elseif $xchange.willpowerPoints gte $willpowermax>>
							<span class="green">당신은 단호하다.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 4>>
							<span class="teal">당신은 끈질기다고 느낀다.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 3>>
							<span class="lblue">당신은 결심이 섰다고 느낀다.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 2>>
							<span class="blue">당신은 굳은 각오를 느낀다.</span>
						<<elseif $xchange.willpowerPoints gte $willpowermax / 5>>
							<span class="purple">당신은 주춤거리고 있다.</span>
						<<elseif $xchange.willpowerPoints gte 1>>
							<span class="pink">당신은 동요하고 있다.</span>
						<<else>>
							<span class="red">당신은 굴복한다.</span>
						<</if>>
					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<amcstatbarinverted $xchange.willpowerPoints $willpowermax _showCaptionText>>
				<div style="clear:both;"></div>
			</div>
		<</if>>
	<</widget>>

	<<widget "willpowercombatdifficulty">>
		<<if !$settings.blindStatsEnabled and $settings.skillCheckStyle isnot "skillname">>
			<<set _difficulty to 100>>
			<<if $xchange.willpowerSystemEnabled is 1 and ($arousal gte ($arousalmax * 3 / 5) or $orgasmcount gt 0)>>
				<<set _difficulty to Math.clamp(Math.floor(currentSkillValue('willpower')) / 800, 0, 1) * (100 - Math.clamp(Math.floor(($temple_burden or 0) + bloatedSkillPenalty() + blindSkillFailureChance()), 0, 100))>>
			<</if>>
			<<if _difficulty gte 100>>
				<span class="green">(매우 쉬움)</span>
			<<elseif _difficulty gte 80>>
				<span class="teal">(쉬움)</span>
			<<elseif _difficulty gte 60>>
				<span class="lblue">(보통)</span>
			<<elseif _difficulty gte 40>>
				<span class="blue">(까다로움)</span>
			<<elseif _difficulty gte 20>>
				<span class="purple">(어려움)</span>
			<<elseif _difficulty gt 0>>
				<span class="pink">(매우 어려움)</span>
			<<else>>
				<span class="red">(불가능)</span>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "willpowercombatcheck">>
		<<if $xchange.willpowerSystemEnabled is 1>>
			<<if $arousal gte ($arousalmax * 3 / 5) or $orgasmcount gt 0>>
				<<silently>><<willpowerdifficulty 1 800>><</silently>>
				<<if $willpowerSuccess>>
					<<willpowersuccess>>
				<<else>>
					<<willpowerfailure>>
				<</if>>
			<<else>>
				<<set $willpowerSuccess to 1>>
			<</if>>
		<<else>>
			<<set $willpowerSuccess to 1>>
		<</if>>
	<</widget>>

	<<widget "willpowercheck">>
		<<if _args[0] isnot undefined>>
			<<set _difficulty to _args[0]>>
		<<else>>
			<<set _difficulty to 1000>>
		<</if>>
		<<silently>><<willpowerdifficulty 1 _difficulty>><</silently>>
		<<if $xchange.willpowerSystemEnabled is 1>>
			<<if $willpowerSuccess>>
				<<willpowersuccess>>
			<<else>>
				<<willpowerfailure>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "willpowersuccess">>
		<<willpower-spending $xchange.willpowerSuccessCost>>
	<</widget>>

	<<widget "willpowerfailure">>
		<<willpower-spending $xchange.willpowerFailureCost>>
	<</widget>>

	<<widget "willpower-spending">>
		<<if $statFreeze>><<exit>><</if>>
		<<if _args[0] is undefined>>
			<<set _willpowerExpenditure to 25>>
		<<else>>
			<<set _willpowerExpenditure to _args[0]>>
		<</if>>

		<<set $xchange.willpowerPoints -= _willpowerExpenditure>>
		<<willpowerpoints-clamp>>
	<</widget>>

	<<widget "willpower-recovery">>
		<<if $statFreeze>><<exit>><</if>>
		<<if _args[0] is undefined>>
			<<set _willpowerRecovery to 25>>
		<<else>>
			<<set _willpowerRecovery to _args[0]>>
		<</if>>

		<<set $xchange.willpowerPoints += _willpowerRecovery>>
		<<willpowerpoints-clamp>>
	<</widget>>

	<<widget "willpowerpoints-clamp">>
		<<set $xchange.willpowerPoints to Math.clamp($xchange.willpowerPoints, 0, Math.max(200, $willpower))>>
		<<if typeof updateDynamicStatCaps is "function">><<run updateDynamicStatCaps()>><</if>>
	<</widget>>

	<<widget "willpower-orgasm">>
		<<set _deniedOrgasm to _args[0]>>
		<!-- Breeder/omega's higher cost is suspended during Gwylan's ritual, matching the pleasure() denial gate being suspended there too. -->
		<<if _deniedOrgasm or (!$sexRitual and playerIsXChanged() and ($xchange.pill.breederEffect or $xchange.pill.omegaEffect))>>
			<<set _willpowerExpenditure to 25 * $orgasmcount>>
		<<elseif $masturbating or $consensual is 1>>
			<<set _willpowerExpenditure to 5 * $orgasmcount>>
		<<else>>
			<<set _willpowerExpenditure to 10 * $orgasmcount>>
		<</if>>
		<<willpower-spending _willpowerExpenditure>>
	<</widget>>

	<<widget "location-danger">>
		<<set _locationDanger to 0>>
		<<if $location is "town">>
			<<switch $bus>>
				<<case "barb">>
					<<set _locationDanger to 500>>
				<<case "cliff">>
					<<set _locationDanger to 500>>
				<<case "connudatus">>
					<<set _locationDanger to 1000>>
				<<case "danube">>
					<<set _locationDanger to 0>>
				<<case "domus">>
					<<set _locationDanger to 500>>
				<<case "elk">>
					<<set _locationDanger to 2000>>
				<<case "harvest">>
					<<set _locationDanger to 1500>>
				<<case "high">>
					<<set _locationDanger to 1000>>
				<<case "mer">>
					<<set _locationDanger to 1000>>
				<<case "nightingale">>
					<<set _locationDanger to 1000>>
				<<case "oxford">>
					<<set _locationDanger to 1000>>
				<<case "starfish">>
					<<set _locationDanger to 1000>>
				<<case "wolf">>
					<<set _locationDanger to 500>>
			<</switch>>	

		<<elseif $location is "alley">>
			<<switch $bus>>
				<<case "commercial">>
					<<set _locationDanger to 1500>>
				<<case "industrial">>
					<<set _locationDanger to 2000>>
				<<case "park">>
					<<set _locationDanger to 1000>>
				<<case "residential">>
					<<if $town_projects.thicket is 4>>
						<<set _locationDanger to 500>>
					<<else>>
						<<set _locationDanger to 1000>>
					<</if>>

			<</switch>>

		<<elseif $location is "flats">>
			<<set _locationDanger to 1000>>
			
		<<elseif $location is "canals">>
			<<set _locationDanger to 1500>>

		<</if>>
	<</widget>>

	<<widget "chitchat">>
		<<= either(
			`"...그래서 그 패거리한테 그랬지. '미쳤어? 내가 그딴 짓을 할 리가 없잖아!'" <<he>>【은는】 분개하며 이야기한다.`,
			`"...믿어져? 경찰이 진짜로 그런 짓을 했다니까. 농담 아니야." <<he>>【은는】 황당한 이야기에 어이가 없다는 듯 말한다.`,
			`"...그러다 개가 와서는 거기에 박아 넣고 미친 듯이 쑤셔 대더라고. 완전 정신 나갔지." <<he>>【은는】 이야기를 하면서 얼굴이 살짝 상기된다.`,
			`"...그러다 그 미친놈이 칼을 꺼내서 다들 위협하기 시작하는 거야..." <<he>>【은는】 이야기의 공포가 스며들도록 잠시 뜸을 들인다.`,
			`"...그래서 문을 열었더니 웬 남자가 발기한 채로 그냥 서 있는 거야..." <<his>> 뺨이 그때를 떠올리며 살짝 붉어진다.`,
			`"...그러다 어떤 사서가 불쌍한 놈 이마에 '도서 범죄자'라고 쓰기 시작하는 거야. 그거 보고 다 같이 빵 터진 거 맹세한다니까..." <<he>>【은는】 크게 웃는다.`,
			`"...그러더니 레이튼이 그걸 전부 사진으로 찍었어! 불쌍한 애가 울기 직전이었는데..." <<he>>【은는】 안쓰러운 듯 한숨을 쉰다.`,
			`"...그러다 이 멍청이가 영문도 모르고 음료를 마셨는데, 세상에, 빌어먹을 여자로 변한 거야! 그리고 씨발, 그 몸이 얼마나 죽였는지 몰라..." <<he>>【은는】 터져 버릴 것처럼 신이 나서 이야기한다.`,
			`"...그래서 반 애 하나한테 알약을 먹어 보라고 부추겼거든. 나중에는 친구들이 전부 굶주린 하이에나처럼 그 새 몸에 침을 질질 흘리더라고!..." <<he>>【은는】 자기는 그런 것 위에 있다는 듯 우월한 태도로 이야기한다.`,
			`"...어떤 사람이 담력 시험으로 한밤중에 호수 깊이 들어갔다가 다시는 보이지 않았다고 하더라..." 유령처럼 창백해진 <<he>>【은는】 이게 실제 있었던 이야기라고 우긴다.`,
			`"...그러니까 버튼을 전부 동시에 누르면 사실상 승리를 보장하는 필살기를 쓸 수 있어..." <<he>>【은는】 <<his>> 고급 전략과 통찰을 몇 가지 공유한다.`,
			`"...그러다 손님이 그 빵을 한 입 먹었는데. 눈이 대번에 몽롱해지더니 평생 가장 행복한 순간이라는 듯이 통째로 게걸스럽게 먹어 치우더라고..." <<he>>【은는】 마치 <<himself>>【이가】 맛본 것 같은 얼굴로 말한다.`,
			`"...그리고 우리는 나올 때까지 그것한테 쫓겼어. 그 뒤에 다들 백지장처럼 하얘졌지..." <<he>>【은는】 <<his>> 어리석은 용기를 뽐내듯 자랑스럽게 웃는다.`,
			`"...그러다 이끼 같은 걸 냄새 맡았거든. 몇 분 뒤에 우리 둘 다 너무 달아올라서 제대로 생각도 못 하겠더라고..." <<he>>【은는】 그때의 느낌을 떠올리며 수줍어하는 듯하다.`,
			`"...그런데 듣자 하니 이 사람은 학대를 즐겼대. 거의 기절할 때까지 목이 졸리면 오르가슴이 폭발한다나..." <<he>>【은는】 믿기지 않는다는 듯 이야기한다.`,
			`"...내가 내기에 져서 X-체인지 알약 하나를 먹어 봤거든. 다음 날 아침에 목소리가 완전히 달라져 있더라고. 다시는 안 해." <<he>>【은는】 <<his>> 목을 문지르며 말한다.`,
			`"...그래서 나는 머리에 교통 콘 하나만 쓴 채 알몸으로 국가를 부르고 있었지. 내가 어쩌다 거기 있었는지는 묻지 마." <<he>>【은는】 어깨를 으쓱하며 뻔뻔하게 웃는다.`,
			`"...그런데 누가 진짜로 오이를 <i>거기에</i> 넣은 거야. 몇 주 동안 샐러드를 못 먹었어." <<he>>【은는】 그때를 떠올리며 몸서리친다.`,
			`"...그러다 쌍둥이가 파티 한복판에서 옷을 바꿔 입었어, 글쎄. 다시 나왔을 때 다들 정신줄을 놓았다니까..." <<he>>【은는】 분명 재미있다는 듯 회상한다.`,
			`"...그러다 한창 분위기가 달아오를 때 화재 경보가 울려서, 다들 반쯤 벗은 채로 눈 속으로 뛰쳐나가야 했어." <<he>>【은는】 그 난장판을 떠올리며 고개를 저으며 킥킥댄다.`
		)>>
	<</widget>>

<<widget "cheesy-pickup-line">>
	<<print [
		`"${$player.gender_appearance is "f" ? "아가씨" : "총각"}, 완전 귀여운데. 근데 그건 너에 대해 제일 시시한 부분일 것 같아."`,
		`"어이, 귀염둥이! 이름이 뭐야?"`,
		`"저기, ${$NPCList[0].gender is "m"
			? "내 자지가 방금 죽었어. 네 엉덩이에 묻어 줘도 될까?"
			: "내 배관이 좀 새는데. 와서 좀 봐 줄래?"}"`,
		`"실례지만, 네가 내 다음 ${$player.gender_appearance is "f" ? "여자" : "남자"}랑 너무 닮아서 눈길이 가네."`,
		`"어이, 자기! 내 무릎에 앉아서 제일 먼저 솟아오르는 것에 대해 얘기해 볼까?"`,
		`"어이, 내 손이 차가운데. 네 바지 속에서 녹여도 될까?"`,
		`"윙크하고 호랑이처럼 박는 게 뭔지 알아?"`,
		`"몸 좋다고 하면, 그 몸을 나한테 갖다 대 줄래?"`,
		`"오늘 밤 우리가 섹스하게 될 거라는 걸 내가 어떻게 아는지 알아? 내가 너보다 힘이 세거든."`,
		`"${$worn.lower.plural ? "그" : "그"} ${$worn.lower.name}【을를】 입은 모습이 죽여주는데. 그 엉덩이 좀 나눠 줄래?"`,
		`"널 보면서 숨을 쉴 수가 없어... 제발 그 아름다움으로 나를 구원해 줘."`,
		`"${$player.gender_appearance is "f"
			? "다리 예쁘네. 몇 시에 문 열어?"
			: "저기, 집배원 양반... 그 소포 나한테 오는 거야?"}"`,
		`"있잖아, 내가 너라면 나랑 섹스하겠어. 당장."`,
		`"솔직히 말해 봐, 원래 이렇게 유혹적이야, 아니면 내가 운 좋은 날에 만난 거야?"`,
		`"여기 덥나, 아니면 네가 날 쳐다보는 눈빛 때문인가?"`,
		`"네 몸은 원더랜드야? 난 완전히 길을 잃었거든."`,
		`"너 캠프파이어야? 너무 뜨거워서 스모어 말고 너를 더 맛보고 싶은데."`,
		`"마술사야? 널 볼 때마다 다른 사람은 다 사라지고 내 위에 올라탄 네 모습만 보이거든."`,
		`"소꿉놀이할래? 내가 문이 될 테니까 넌 밤새도록 날 쾅쾅 닫아도 돼."`,
		`"가까이 와. 네가 내 이름을 신음할 때 어떤 얼굴인지 보고 싶어."`
	].random()>>

	<<if $NPCList[0].skills.security gte 800>>
		<<arousal 500>><<ggarousal>>
	<<elseif $NPCList[0].skills.security gte 400>>
		<<arousal 200>><<garousal>>
	<</if>>
<</widget>>

	<<widget "pleasurecaption">>
		<<if Number.isFinite($pleasure)>>
			<div id="pleasurecaption" @title="'쾌락: ' + $pleasure.toFixed(2)">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					쾌감:
					<<if $options.showCaptionText is true>>
						<<if $pleasure gte $pleasuremax>>
							<span class="red">터지기 직전이다.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 4>>
							<span class="pink">절정이 차오른다.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 3>>
							<span class="purple">몸이 달아오른다.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
							<span class="blue">몸이 뜨겁다.</span>
						<<elseif $pleasure gte $pleasuremax / 5>>
							<span class="lblue">온몸이 짜릿하다.</span>
						<<elseif $pleasure gte 1>>
							<span class="teal">몸이 간지럽다.</span>
						<<else>>
							<span class="green">평소와 같다.</span>
						<</if>>
					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<glowstatbar 0 $pleasure $pleasuremax _showCaptionText>>
			</div>
		<</if>>
	<</widget>>

	<<widget "enemypleasure">>
		<<set _change to _args[0]>>
		<<set _arousalModifier to Math.clamp(($enemyarousal || 0) / ($enemyarousalmax || 1), 0.1, 1)>>
		<<set _enemySexModifier to _enemies gt 1 or $NPCList[0].gender isnot "m" or _change lt 0 or $timer? 1 : 0.5>>
		<<set $enemypleasure += _change * _arousalModifier * _enemySexModifier>>
	<</widget>>

	<<widget "enemypleasure-edge">>
		<<set _change to _args[0]>>
		<<set _initialpleasure to $enemypleasure>>

		<<enemypleasure _change>>
		<<set $enemypleasure to Math.clamp($enemypleasure, Math.min(_initialpleasure, $enemypleasuremax / 5), $enemypleasuremax)>>
	<</widget>>

	<<widget "xchangeSkinColourVariableCombine">>
		<<if _xchangeSkinTone is "no">><<set _xchangeSkinShade to "change">><</if>>
		<<set $xchange.customisedSkinColour to _xchangeSkinTone + _xchangeSkinShade>>
	<</widget>>

	<<widget "demonReleaseOption">>
		<<if demonPurityBurnPending()
			and playerCannotSelfClimax()
			and $awareness gte 0
			and !pcAreArmsBound("both")>>
			<<skinicon "masturbate">><<link "스스로 절정에 이르도록 몰아붙인다 (0:15)" _args[0]>><<pass 15>><</link>>
			<br>
		<</if>>
	<</widget>>

	<<widget "demonForcedRelease">>
		더는 미룰 수 없다. 당신은 쾌감을 위해서가 아니라 그저
		끝내기 위해 스스로를 거칠고 빠르게 몰아붙이고, 몸이 굴복한다. 피부 아래의 타는 듯한 열기가 잦아든다.
		<<orgasm>>
		<<purity -1>>
		<<set $orgasmcurrent to 0>>
	<</widget>>
