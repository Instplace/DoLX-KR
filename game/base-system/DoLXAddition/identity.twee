:: X-Change Gender Identity Widgets [widget]

<!-- LEGACY -->
	<<widget "genderidentity-orgasm">>
		<<if $player.vaginaExist>>
			<<identitySelector "Vagina">>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -2 1>><<trauma -2>>
				<</if>>
			<</if>>
		<</if>>
		<<set _manlyUse to ["othervagina", "otheranus", "othermouth", "tentacle"]>>
		<<if $player.penisExist and _manlyUse.includes($penisuse)>>
			<<set _penis to identityCharacteristicCategory("Penis")>>
			<<identitySelector _penis>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -2 1>><<trauma -2>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "genderidentity">>
		<<if _args[0] and $xchange.genderIdentityEnabled is true and $xchange.giAutoEnabled is true>>
			/* If it's a dream, reduce change to 10% */
			<<set _multiplier to $statFreeze isnot true ? 2 : 0.2>> 
			<<set _range to ($xchange.giRange is undefined ? 1500 : $xchange.giRange)>>
			<<set _identityCapFloor to Math.round(_range * 0.625)>>

			/* These traits use the player's original sex and should not flip after X-Change. Positive values move identity towards feminine, negative towards masculine. */
			<<set _origSex to playerOriginalSex()>>
			<<set _towardsOppositeSex to (_origSex is "m" ? _args[0] > 0 : _args[0] < 0)>>
			<<if $backgroundTraits.includes("crossdresser") and !$background.transgender>><<set _multiplier *= _towardsOppositeSex ? 1.25 : 0.50 >><</if>>
			<<if $backgroundTraits.includes("genderAnxious")>><<set _multiplier *= _towardsOppositeSex ? 0.50 : 1.25 >><</if>>

			<<set $genderidentity += _args[0] * _multiplier>>
			<<set $genderidentity to Math.clamp($genderidentity,0, _range)>>
			<<if $identityCap>>
				<<if ($genderidentity < _identityCapFloor)>>
					<<set $identityCapMessage to true>><<set $effectsmessage to 1>>
					<<stress 10>><<trauma 10>>
				<</if>>
				<<set $genderidentity to Math.clamp($genderidentity,_identityCapFloor, _range)>>
			<</if>>
		<</if>>
	<</widget>>

	/* Yesterday's outfit line in the daily report, printed by xchange.js from $genderIdentityMessage. */
	<<widget "genderidentity-text">>
		<<if $xchange.genderIdentityEnabled>>
			<<if _args[0] is "f">>
				<span class="pink">어제, 당신은 여성스럽게 입었다.</span>
			<<elseif _args[0] is "m">>
				<span class="blue">어제, 당신은 남성스럽게 입었다.</span>
			<</if>>
		<</if>>
	<</widget>>


<!-- AELXER'S IDENTITY -->
	<<widget "identitySettings">>
		/* Imports and the Random start set reject/accepted/preferred independently, which can leave impossible combinations on screen. */
		<<run identityNormalisePresentation()>>

		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">정체성 규칙:</span><br>
				<ul class="small-description">
					<li><b>수용:</b> 수용한 특징은 부정적인 영향을 주지 않습니다. 각 분류에서 수용한 특징 하나를 선호로 고를 수도 있습니다. 선호하는 특징을 가지고 있으면 스트레스와 트라우마가 조금 줄어듭니다.</li>
					<li><b>성별 불쾌감:</b> 수용하지 않은 특징을 가지고 있으면 성별 불쾌감이 생기고, 스트레스와 트라우마가 늘어납니다.</li>
					<li><b>내성:</b> 가지고 있지만 수용하지 않은 특징에 대한 내성이 매일 천천히 쌓입니다. 거부하지 않은 대명사를 듣는 것도 내성을 쌓습니다. 내성이 최대가 되면 그 특징은 수용 상태가 됩니다.</li>
					<li><b>거부:</b> 거부한 특징은 트라우마를 주지 않지만, 그 특징에 대한 내성도 쌓을 수 없습니다. 거부한 특징의 성별 불쾌감이 최대에 이르게 두는 것은 위험합니다.</li>
					<li><b>마지못함:</b> 거부한 특징의 성별 불쾌감이 최대에 이르고 의지력이 바닥나면, 어쩔 수 없이 그 특징을 참고 지내게 됩니다. 이때는 트라우마가 생길 수 있지만, 반복되는 성별 불쾌감이 현재 의지력을 더는 깎지 않습니다. 마지못함 상태에서는 그 특징을 거부하거나 수용할 수 없습니다. 마지못함을 없애려면 그 특징을 더는 가지지 않게 되어야 하고, 필요하면 선호에서 해제한 뒤 내성이 떨어질 때까지 기다리십시오. 그 후에는 원한다면 다시 거부할 수 있습니다.</li>
				</ul>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				성별 표현
			</div>

			<div class="settingsToggleItem">
				<span class="gold">대명사 </span> <mouse class="tooltip linkBlue">(?)<span>이 설정은 게임 글에서 당신의 캐릭터에게 쓰이는 대명사와 성별 표현을 정합니다. 수용하지 않은 특징은 성별 불쾌감을 일으킵니다. 대명사 종류를 여러 개 선호할 수 있습니다. 세 가지를 모두 선호하면 동적 대명사 모드를 쓸 수 있습니다.</span></mouse>
				<br><span class="small-description">현재 사용 중: <span id="pronoun-current-label"><<= pronounSummaryLabel()>></span></span>
				<br>
				남성적:
				<br> 
				<label data-target='["identity.presentation.pronouns.masculine.acceptance", "identity.presentation.pronouns.masculine.reject"]' data-disabledif="V.identity.presentation.pronouns.masculine.acceptance && !V.identity.presentation.pronouns.masculine.reject" class="red">거부 <<checkbox "$identity.presentation.pronouns.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredMasculine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredMasculine || V.identity.init">비수용 <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.masculine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.masculine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.masculine.acceptance" class="green">선호 <<checkbox "$identity.presentation.pronouns.preferredMasculine" false true autocheck>></label>
				<br>
				여성적:
				<br>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance", "identity.presentation.pronouns.feminine.reject"]' data-disabledif="V.identity.presentation.pronouns.feminine.acceptance && !V.identity.presentation.pronouns.feminine.reject" class="red">거부 <<checkbox "$identity.presentation.pronouns.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredFeminine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredFeminine || V.identity.init">비수용 <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.feminine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.feminine.acceptance" class="green">선호 <<checkbox "$identity.presentation.pronouns.preferredFeminine" false true autocheck>></label>
				<br>
				뉴트럴:
				<br> 
				<label data-target='["identity.presentation.pronouns.neutral.acceptance", "identity.presentation.pronouns.neutral.reject"]' data-disabledif="V.identity.presentation.pronouns.neutral.acceptance && !V.identity.presentation.pronouns.neutral.reject" class="red">거부 <<checkbox "$identity.presentation.pronouns.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredNeutral", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredNeutral || V.identity.init">비수용 <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.neutral.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.neutral.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.neutral.acceptance" class="green">선호 <<checkbox "$identity.presentation.pronouns.preferredNeutral" false true autocheck>></label>
				<br>

				<<run updatePronounSummary()>>

				<div data-target='["identity.presentation.pronouns.preferredMasculine", "identity.presentation.pronouns.preferredFeminine", "identity.presentation.pronouns.preferredNeutral"]' data-disabledif="!(V.identity.presentation.pronouns.preferredMasculine && V.identity.presentation.pronouns.preferredFeminine && V.identity.presentation.pronouns.preferredNeutral)">
					<span class="gold">선호 대명사의 기준: </span>
					<br> 
					<label>현재 성별 <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "body" autocheck>></label> |
					<label>의상 <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "clothing" autocheck>></label> |
					<label>외모 <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "appearance" autocheck>></label> |
					<label>자세 <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "posture" autocheck>></label>
				</div>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">성별 외모 </span> <mouse class="tooltip linkBlue">(?)<span>수용하지 않은 특징은 성별 불쾌감을 일으킵니다. 전체적인 외모는 몸, 머리카락, 옷, 자세를 아우릅니다. 중성적이란 뚜렷하게 남성적이지도 여성적이지도 않다는 뜻입니다.</span></mouse>
				<br>
				남성적:
				<br> 
				<label data-target='["identity.presentation.appearance.masculine.acceptance", "identity.presentation.appearance.masculine.reject"]' data-disabledif="V.identity.presentation.appearance.masculine.acceptance && !V.identity.presentation.appearance.masculine.reject" class="red">거부 <<checkbox "$identity.presentation.appearance.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'm' || V.identity.init">비수용 <<radiobutton "$identity.presentation.appearance.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.masculine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.appearance.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.masculine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.masculine.acceptance" class="green">선호 <<radiobutton "$identity.presentation.appearance.preferred" "m" autocheck>></label>
				<br>
				여성적:
				<br> 
				<label data-target='["identity.presentation.appearance.feminine.acceptance", "identity.presentation.appearance.feminine.reject"]' data-disabledif="V.identity.presentation.appearance.feminine.acceptance && !V.identity.presentation.appearance.feminine.reject" class="red">거부 <<checkbox "$identity.presentation.appearance.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'f' || V.identity.init">비수용 <<radiobutton "$identity.presentation.appearance.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.feminine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.appearance.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.feminine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.feminine.acceptance" class="green">선호 <<radiobutton "$identity.presentation.appearance.preferred" "f" autocheck>></label>
				<br>
				중성적:
				<br>
				<label data-target='["identity.presentation.appearance.neutral.acceptance", "identity.presentation.appearance.neutral.reject"]' data-disabledif="V.identity.presentation.appearance.neutral.acceptance && !V.identity.presentation.appearance.neutral.reject" class="red">거부 <<checkbox "$identity.presentation.appearance.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.appearance.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.neutral.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.appearance.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.neutral.acceptance"]' data-disabledif="!V.identity.presentation.appearance.neutral.acceptance" class="green">선호 <<radiobutton "$identity.presentation.appearance.preferred" "n" autocheck>></label>
				<br>
			</div>
			<div class="settingsToggleItem identity-clothing-settings">
				<span class="gold">의상 선호 </span> <mouse class="tooltip linkBlue">(?)<span>수용하지 않은 의상 스타일은 옷을 갈아입을 때와 입고 있는 동안 성별 불쾌감을 일으킵니다. 선호하는 스타일은 입고 있는 동안 편안함을 줍니다. 중성적은 남성적으로도 여성적으로도 보이지 않는 옷을 선호한다는 뜻입니다. "상관없음"을 고르면 의상으로 인한 성별 불쾌감과 편안함이 사라집니다.</span></mouse>
				<br>
				남성적:
				<br>
				<label data-target='["identity.presentation.clothing.masculine.acceptance", "identity.presentation.clothing.masculine.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.masculine.acceptance && !V.identity.presentation.clothing.masculine.reject)" class="red">거부 <<checkbox "$identity.presentation.clothing.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'm' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.clothing.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.masculine.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.masculine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.clothing.masculine.acceptance" true autocheck>></label> |
				<</if>>
				/* Deliberately still clickable while Neutral: these two are the only way back out of it. */
				<label data-target='["identity.presentation.clothing.masculine.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.masculine.acceptance" class="green">선호 <<radiobutton "$identity.presentation.clothing.preferred" "m" autocheck>></label>
				<br>
				여성적:
				<br>
				<label data-target='["identity.presentation.clothing.feminine.acceptance", "identity.presentation.clothing.feminine.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.feminine.acceptance && !V.identity.presentation.clothing.feminine.reject)" class="red">거부 <<checkbox "$identity.presentation.clothing.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'f' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.clothing.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.feminine.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.feminine.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.clothing.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.feminine.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.feminine.acceptance" class="green">선호 <<radiobutton "$identity.presentation.clothing.preferred" "f" autocheck>></label>
				<br>
				중성적:
				<br>
				<label data-target='["identity.presentation.clothing.neutral.acceptance", "identity.presentation.clothing.neutral.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.neutral.acceptance && !V.identity.presentation.clothing.neutral.reject)" class="red">거부 <<checkbox "$identity.presentation.clothing.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'u' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.clothing.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.neutral.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.neutral.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.clothing.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.neutral.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.neutral.acceptance" class="green">선호 <<radiobutton "$identity.presentation.clothing.preferred" "u" autocheck>></label>
				<br>
				<label class="teal">상관없음 <<radiobutton "$identity.presentation.clothing.preferred" "n" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>당신에게 옷은 그냥 옷일 뿐입니다.</span></mouse>
				<br>

				/* Clothing controls have side effects that a click alone wouldn't produce, since clicking only repaints the setting rather than re-rendering the passage:
				  - switching to Neutral has to park both options as accepted right away, so the masculine/feminine "Preferred" radios stay a valid way back out instead of leaving the player stuck on Neutral;
				  - character creation previews the starting outfit, which is chosen from this preference;
				  - rejecting the style already being worn has to land immediately. */
				<<run (function () {
					if (setup.clothingPreferenceChangeInstalled) return;
					setup.clothingPreferenceChangeInstalled = true;
					const preferenceInput = Util.slugify("identity.presentation.clothing.preferred");
					$(document).on("change", ".identity-clothing-settings input", function () {
						if ((this.name || "").endsWith(preferenceInput)) {
							Wikifier.wikifyEval("<<normaliseNeutralClothing>><<startingPlayerImageUpdate>>");
						}
						clothingIdentityChangeCheck();
					});
				})();>>
			</div>
			<div class="settingsToggleItem identity-makeup-settings">
				<span class="gold">화장 선호 </span> <mouse class="tooltip linkBlue">(?)<span>화장을 하는 것과 민낯으로 있는 것에 대해 어떻게 느끼는지 고릅니다. 지금 얼굴에 한 화장이 어느 특징이 적용되는지를 정합니다. NPC 화장 간섭 설정에 따라, 인간 NPC는 동의 없는 만남에서 얼굴이 드러나면 남성 캐릭터에게 억지로 화장을 시키거나 여성 캐릭터의 화장을 지울 수 있습니다.</span></mouse>
				<br>
				화장함:
				<br>
				<label data-target='["identity.presentation.makeup.wearing.acceptance", "identity.presentation.makeup.wearing.reject", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || (V.identity.presentation.makeup.wearing.acceptance && !V.identity.presentation.makeup.wearing.reject)" class="red">거부 <<checkbox "$identity.presentation.makeup.wearing.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'wearing' || V.identity.presentation.makeup.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.makeup.wearing.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.makeup.wearing.reject", "identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || V.identity.presentation.makeup.wearing.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.makeup.wearing.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.makeup.wearing.acceptance", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred !== 'n' && !V.identity.presentation.makeup.wearing.acceptance" class="green">선호 <<radiobutton "$identity.presentation.makeup.preferred" "wearing" autocheck>></label>
				<br>
				민낯:
				<br>
				<label data-target='["identity.presentation.makeup.bare.acceptance", "identity.presentation.makeup.bare.reject", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || (V.identity.presentation.makeup.bare.acceptance && !V.identity.presentation.makeup.bare.reject)" class="red">거부 <<checkbox "$identity.presentation.makeup.bare.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'bare' || V.identity.presentation.makeup.preferred === 'n' || V.identity.init">비수용 <<radiobutton "$identity.presentation.makeup.bare.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.makeup.bare.reject", "identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || V.identity.presentation.makeup.bare.reject || V.identity.init">수용 <<radiobutton "$identity.presentation.makeup.bare.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.makeup.bare.acceptance", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred !== 'n' && !V.identity.presentation.makeup.bare.acceptance" class="green">선호 <<radiobutton "$identity.presentation.makeup.preferred" "bare" autocheck>></label>
				<br>
				<label class="teal">상관없음 <<radiobutton "$identity.presentation.makeup.preferred" "n" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>화장과 민낯은 당신의 정체성에 영향을 주지 않습니다. NPC는 여전히 화장을 하거나 지울 수 있습니다.</span></mouse>
				<<run (function () {
					if (setup.makeupPreferenceChangeInstalled) return;
					setup.makeupPreferenceChangeInstalled = true;
					const preferenceInput = Util.slugify("identity.presentation.makeup.preferred");
					$(document).on("change", ".identity-makeup-settings input", function () {
						if ((this.name || "").endsWith(preferenceInput)) Wikifier.wikifyEval("<<normaliseMakeupPreference>>");
					});
				})();>>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				몸
			</div>

		<div class="settingsToggleItemWide">
			<span class="gold bold">몸 정체성 항목:</span><br>
				<label class="gi-body-toggle" data-gi-key="giBreastSizeEnabled" data-gi-box="gi-box-breasts" data-target='["xchange.giBreastSizeEnabled"]'>가슴 크기 <<checkbox "$xchange.giBreastSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giAssSizeEnabled" data-gi-box="gi-box-ass" data-target='["xchange.giAssSizeEnabled"]'>엉덩이 크기 <<checkbox "$xchange.giAssSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="gi성기Enabled" data-gi-box="gi-box-genitals" data-target='["xchange.gi성기Enabled"]'>성기 <<checkbox "$xchange.gi성기Enabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giHairLengthEnabled" data-gi-box="gi-box-hair" data-target='["xchange.giHairLengthEnabled"]'>머리카락 길이 <<checkbox "$xchange.giHairLengthEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giBodySizeEnabled" data-gi-box="gi-box-bodysize" data-target='["xchange.giBodySizeEnabled"]'>체격 <<checkbox "$xchange.giBodySizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="gi가임력Enabled" data-gi-box="gi-box-fecundity" data-target='["xchange.gi가임력Enabled"]'>가임력 <<checkbox "$xchange.gi가임력Enabled" false true autocheck>></label>
				<mouse class="tooltip linkBlue">(?)<span>성별 불쾌감과 내성에 적용할 몸 항목을 고릅니다. 끄면 그 분류는 숨겨지고 아무 영향도 주지 않습니다.</span></mouse>
		</div>

		<<run (function () {
			function syncFromState() {
				$(".gi-body-toggle").each(function () {
					var key = this.getAttribute("data-gi-key");
					var boxId = this.getAttribute("data-gi-box");
					var enabled = State.variables.xchange && State.variables.xchange[key];
					var box = document.getElementById(boxId);
					if (box) box.style.display = enabled ? "" : "none";
				});
			}

			if (setup.giBodyToggleInstalled) {
				setTimeout(syncFromState, 0);
				return;
			}
			setup.giBodyToggleInstalled = true;

			$(document).on("change", ".gi-body-toggle input[type=checkbox]", function () {
				var label = this.closest(".gi-body-toggle");
				if (!label) return;
				var boxId = label.getAttribute("data-gi-box");
				var box = document.getElementById(boxId);
				if (box) box.style.display = this.checked ? "" : "none";
			});

		/* Mark category as configured once the player interacts with anything inside it.
		Use click for inputs so selecting "Unaccepted" (false->false) still counts as chosen. */
		function markGiConfigured(el) {
			var box = el.closest(".settingsToggleItem[data-gi-config]");
			if (!box) return;
			var ckey = box.getAttribute("data-gi-config");
			if (!ckey) return;
			if (!State.variables.xchange) State.variables.xchange = {};
			State.variables.xchange[ckey] = true;
		}

		/* inputs (checkbox/radio) */
		$(document).on("click", ".settingsToggleItem[data-gi-config] input", function () {
			markGiConfigured(this);
		});

		/* selects */
		$(document).on("change", ".settingsToggleItem[data-gi-config] select", function () {
			markGiConfigured(this);
		});
			setTimeout(syncFromState, 0);
		})();>>

			<div class="settingsToggleItem" id="gi-box-breasts" data-gi-config="giBreastSizeConfigured" style="display:none;">
				<span class="gold">가슴 크기 </span> <mouse class="tooltip linkBlue">(?)<span>수용하지 않은 가슴 크기는 성별 불쾌감을 일으킵니다. 온전한 바인더와 그 밖의 가슴 모양을 잡아 주는 옷은 가슴을 덮고 있는 동안 가슴이 어떻게 인식되는지에 영향을 줍니다.</span></mouse>
