				<<edenicon>><<link [[에덴의 오두막|Eden Cabin]]>><<cheats-teleport-function>><</link>><br>
				<<foresticon "churchyard">><<link [[교회 묘지|Churchyard]]>><<cheats-teleport-function>><</link>><br>
				<<icon "wolf-cave-entrance.png">><<link [[늑대 동굴|Wolf Cave]]>><<cheats-teleport-function>><</link>><br>
				<br>
