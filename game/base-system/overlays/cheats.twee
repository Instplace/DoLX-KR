:: Cheats [widget]
<<widget "cheats">>
	<<link [[확인|$passage]]>><<set $cheatReload to true>><</link>>
	<br>
	이벤트 중이거나 주변에 NPC가 있을 때 확인하면 문제가 발생할 수 있습니다.
	<br>
	치트가 현재 씬에 즉시 적용되기를 원할 때만 필요합니다.
	<hr>
	<div id="cheatsShown"><<cheats-characterStats>></div>

	<div class="settingsGrid">
		<input type="button" class="toTop options" value="페이지 맨 위로" onclick="$('#customOverlayContent').scrollTop(0)"/>
	</div>
<</widget>>

<<widget "cheatVirginityToggle">>
	<<set _type to _args[0]>>
	<<set _id to `stats${_type}virginity`>>
	<<capture _type _id>>
		<span @id="_id"><<= ($player.virginity[_type] is true ? "보존됨" : "상실됨: " + ($player.virginity[_type] is false ? "알 수 없음" : ($player.virginity[_type] is "unknown" ? "알 수 없음" : window.KR.gatPersonNameDictKR($player.virginity[_type]))))>></span> |
		<span @id="_id + 'link'"><<link `($player.virginity[_type] is true ? "상실 처리" : "복구")`>>
			<<if $player.virginity[_type] is true>>
				<<set $player.virginity[_type] to "unknown">>
				<<if $player.virginity.temple isnot false and ["penile","vaginal"].includes(_type)>>
					<<set $player.virginity.temple to "unknown">>
				<</if>>
				<<run setup.xChangeRecordActiveBodyVirginity()>>
				<<run $(`#${_id}link .link-internal`).html("Restore")>>
				<<run $(`#${_id}`).html("Taken by unknown")>>
			<<else>>
				/* Restore */
				<<set $player.virginity[_type] to true>>
				<<if $player.virginity.temple isnot false and ["penile","vaginal"].includes(_type)>>
					<<set $player.virginity.temple to true>>
				<</if>>
				<<run setup.xChangeRecordActiveBodyVirginity()>>
				<<run $(`#${_id}link .link-internal`).html("상실 처리")>>
				<<run $(`#${_id}`).html("보존됨")>>
			<</if>>
		<</link>></span>
	<</capture>>
<</widget>>


<<widget "cheatParasiteToggle">>
	<<set _bodypart to _args[0]>>
	<<set _parasiteTypes to setup.parasiteTypesPerBodypart[_bodypart]>>

	<<print window.KR.getBodypartKr(_bodypart)>>:
	<<capture _bodypart, _parasiteTypes, _i, _temp>>
		<<for _i = 0; _i < _parasiteTypes.length; _i++>>
			<span @id="_parasite" @class="_parasiteTypes[_i] is $parasite[_bodypart].name || _parasiteTypes[_i] is 'none' and !$parasite[_bodypart].name ? 'goldLink' : 'link' ">
				<<link `(_parasiteTypes[_i] is 'none' ? '없음' : window.KR.getCreatureTypeKr(_parasiteTypes[_i]))`>>
					<<removeparasite _bodypart>>
					<<set _temp to _parasiteTypes[_i]>>
					<<set _parasiteTypes[_i] to _parasiteTypes[0]>>
					<<set _parasiteTypes[0] to _temp>>
					<<if _temp isnot "none">>
						<<parasite _bodypart _temp>>
					<</if>>
					<<updatesidebarimg>>
					<<replace `"#"+ _bodypart`>><<cheatParasiteToggle _bodypart>><</replace>>
				<</link>>
			</span>
			<<if _i < _parasiteTypes.length - 1>> |<</if>>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatBodyLiquid">>
	<<set _semen to _args[0]>>
	<<set _label to _semen is "goo" ? "slime" : _semen>>
	<div class="settingsToggleItem">
		<span class="gold"><<print window.KR.getFluidKr(_semen)>></span>
		<br>

		<<capture _type _semen>>
			<<link `'모두 추가: ' + window.KR.getFluidKr(_semen)`>>
				<<for _type range ["neck","rightarm","leftarm","thigh","bottom","tummy","chest","face","hair","feet","vaginaoutside","vagina","penis","anus","mouth"]>>
					<<bodyliquid _type _semen 5>><<run $(`#stats${_type}${_semen}`).html(Math.trunc($player.bodyliquid[_type][_semen]))>>
				<</for>>
				<<updatesidebarimg>>
				<<set _id to "#cheatLiquids-" + _semen>>
				<<replace _id>><<cheatBodyliquidElement _semen>><</replace>>
			<</link>>
		<</capture>> |

		<<capture _type _semen>>
			<<link `'모두 제거: ' + window.KR.getFluidKr(_semen)`>>
				<<for _type range ["neck","rightarm","leftarm","thigh","bottom","tummy","chest","face","hair","feet","vaginaoutside","vagina","penis","anus","mouth"]>>
					<<bodyliquid _type _semen -5>><<run $(`#stats${_type}${_semen}`).html(Math.trunc($player.bodyliquid[_type][_semen]))>>
				<</for>>
				<<updatesidebarimg>>
				<<set _id to "#cheatLiquids-" + _semen>>
				<<replace _id>><<cheatBodyliquidElement _semen>><</replace>>
			<</link>>
		<</capture>>
		<br>
		<<set _id to "cheatLiquids-" + _semen>>
		<span @id="_id">
			<<cheatBodyliquidElement _semen>>
		</span>
	</div>
<</widget>>

<<widget "cheatBodyliquidElement">>
	<<set _semen to _args[0]>>
	<<set _options to {
			max: 5,
			step: 1,
			values: [_semen],
			activeButtons: ["single", "minMax"],
			percentage: false,
			reverse: true,
			css: {display: "inline-block", "margin-bottom": "0"}
		}>>
	<<numberStepper "목" $player.bodyliquid.neck[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.neck[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "오른팔" $player.bodyliquid.rightarm[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.rightarm[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "왼팔" $player.bodyliquid.leftarm[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.leftarm[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "허벅지" $player.bodyliquid.thigh[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.thigh[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "엉덩이" $player.bodyliquid.bottom[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.bottom[arr[0]] = value; Wikifier.wikifyEval("<<wetnessCalculate>><<updatesidebarimg>>") }}>>
	<<numberStepper "배" $player.bodyliquid.tummy[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.tummy[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "가슴" $player.bodyliquid.chest[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.chest[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "얼굴" $player.bodyliquid.face[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.face[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "머리카락" $player.bodyliquid.hair[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.hair[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "발" $player.bodyliquid.feet[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.feet[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "음순" $player.bodyliquid.vaginaoutside[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.vaginaoutside[arr[0]] = value; Wikifier.wikifyEval("<<wetnessCalculate>><<updatesidebarimg>>") }}>>
	<<numberStepper "보지" $player.bodyliquid.vagina[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.vagina[arr[0]] = value; Wikifier.wikifyEval("<<wetnessCalculate>><<updatesidebarimg>>") }}>>
	<<numberStepper "자지" $player.bodyliquid.penis[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.penis[arr[0]] = value; Wikifier.wikifyEval("<<wetnessCalculate>><<updatesidebarimg>>") }}>>
	<<numberStepper "애널" $player.bodyliquid.anus[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.anus[arr[0]] = value; Wikifier.wikifyEval("<<wetnessCalculate>><<updatesidebarimg>>") }}>>
	<<numberStepper "입" $player.bodyliquid.mouth[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.mouth[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
<</widget>>

<<widget "cheats-characterStats">>
	<div class="settingsGrid">
		<div class="settingsHeader options">플레이어</div>
		<div class="settingsToggleItemWide">
			<span class="gold">기타</span>
			<br>
			<<numberStepper "💷 돈" $money {
					activeButtons: ["single", "double", "triple", "quad", "penta"],
					step: 1000,
					max: 100000000000,
					colorArr:["--yellow"],
					percentage: false,
					valueFormat: (value) => `<b>${formatMoney(value)}</b>`,
					callback: (value) => {
						const difference = value - V.money;
						V.moneyStats.cheats.earned += difference;
						V.money = value;
					}
			}>>

			<<if $location is "prison">>
				<<set $prison.teeth to $prison.teeth or 0>>
				<<numberStepper "🦷 치아" $prison.teeth {callback: (value) => V.prison.teeth = value, disableMinMax: true, step: 1, max: 1000000, colorArr:["--yellow"], percentage: false}>>
			<</if>>

			<<numberStepper "용의 별" `$dragonStar || 0` {callback: value => V.dragonStar = value, min: 0, max: 99, step: 1, percentage: false}>>
			<<numberStepper "무한 스프레이" `$infinitespray ? 1 : 0` {
				callback: value => {
					if (value === 1 && !V.infinitespray) Wikifier.wikifyEval("<<spray 5>>");
					V.infinitespray = value;
				},
				min: 0, max: 1, step: 1, percentage: false,
				valueFormat: value => value ? "켜짐" : "꺼짐"
			}>>
			💤 <<link [[지금 기절한다|$passage]]>><<set $stress to $stressmax>><</link>>
			| <span class="description">현재 위치에서 기절 연출을 즉시 시작합니다.</span>

			<<if $debug>>
				페로몬 (디버그): <span id="statsalluretest"><<= $alluretest ? "켜짐" : "꺼짐">></span> |
				<<link "변경">>
					<<if $alluretest is 1>>
						<<set $alluretest to 0>>
					<<else>>
						<<set $alluretest to 1>>
					<</if>>
					<<replace "#statsalluretest">><<= $alluretest ? "On" : "Off">><</replace>>
				<</link>>
				<br>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">신체</span> <mouse class="tooltip linkBlue">(?)<span>플레이어의 생식기를 변경하면 플레이어에게 묻어있는 음란한 체액을 씻어내고, 생식기 기생충을 제거하여 존재하지 않는 신체 부위에 남아있지 않도록 합니다.</span></mouse>
			<br>
			생식기:
			<span id="statsGender">
				<<cheatsSex>>
			</span>
			<br>
			<<set _gender_body_words to {"m": "남성적", "f": "여성적", "a": "어느쪽도 아님"}>>
			체형: <mouse class="tooltip linkBlue">(?)<span>얼마나 여성적이거나 남성적으로 보이는지에 기여합니다. 일반적인 게임 플레이에서, 특수 의류를 통해 여성화되거나 남성화되지 않는 한, 플레이어의 체형은 성별 외형에 기여하지 않습니다.</span></mouse>:
			<span id="statsBodyType">
				<<cheatsBody>>
			</span>
			<br>
			<<set _bodysize_words to ["극소","아주 작음","작음","보통","키 큼","큼","거대함"]>>
			체격:
			<span id="statsBodySize">
				<<cheatsBodySize>>
			</span>
			<br>
			몸매:
			<span id="statsBodyShape">
				<<cheatsBodyShape>>
			</span>
			<<if setup.faceStyleOptions.length gt 1>>
				<br>
				얼굴 스타일:
				<span id="statsFaceStyle">
					<<cheatsFaceStyle>>
				</span>
			<</if>>
			<br>
			태도:
			<span id="statsDemeanour">
				<<cheatsDemeanour>>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">첫 경험</span>
			<br>
			<<set _virginity to clone($player.virginity)>>
			<<if $player.vaginaExist or $player.virginity.vaginal isnot true>>
				질: <<cheatVirginityToggle "vaginal">>
				<br>
			<</if>>
			<<if $player.penisExist or $player.virginity.penile isnot true>>
				자지: <<cheatVirginityToggle "penile">>
				<br>
			<</if>>
			애널: <<cheatVirginityToggle "anal">>
			<br>
			입: <<cheatVirginityToggle "oral">>
			<br>
			손잡기: <<cheatVirginityToggle "handholding">>
			<br>
			첫 키스: <<cheatVirginityToggle "kiss">>
			<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
				<br>
				신전 서약: <<cheatVirginityToggle "temple">>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">상태</span>
			<br>
			<<set _state to ["pain", "arousal", "tiredness", "stress", "trauma", "drunk", "drugged", "hallucinogen"]>>

			<<link "새로고침">>
				<<set $cheatReload to true>>
				<<set $control = 1000>><<clamp>>
				<<for _i range _state>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<set $xchange.willpowerPoints = $willpower>><<clamp>>
				<<replace "#cheatstate">><<cheatSection "state">><</replace>>
				<<updatesidebarimg>>
			<</link>> |

			<<link "망가뜨리기">>
				<<set $cheatReload to true>>
				<<set $control = 0>><<clamp>>
				<<for _i range _state>>
					<<set V[_i] to 20000>><<clamp>>
				<</for>>
				<<set $xchange.willpowerPoints = 0>><<clamp>>
				<<replace "#cheatstate">><<cheatSection "state">><</replace>>
				<<updatesidebarimg>>
			<</link>>
			<br><br>
			<div id="cheatstate">
				<<cheatSection "state">>
			</div>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">체액:</span>
			<<link "다시 채우기">>
				<<set $semen_amount to $semen_volume>>
				<<set $milk_amount to $milk_volume>>
				<<replace "#fluids">><<cheats-fluids>><</replace>>
			<</link>> | <<link "비우기">>
				<<set $semen_amount to 0>>
				<<set $milk_amount to 0>>
				<<replace "#fluids">><<cheats-fluids>><</replace>>
			<</link>>
			<br>
<span class="gold">모유 분비:</span> <span id="statslactatingspray"><<= ($lactating is 1 ? "예" : "아니요")>></span> | <<link "전환">><<set $lactating to ($lactating is 1 ? 0 : 1)>><<set $lactation_pressure to $lactating * 100>><<replace "#statslactatingspray">><<= ($lactating is 1 ? "예" : "아니요")>><</replace>><<updatesidebarimg>><</link>>
			<br><br>
			<span id="fluids"><<cheats-fluids>></span>
			<<numberStepper "모유량" $milk_volume {
				callback: value => {
					V.milk_volume = value;
					V.milk_amount = Math.min(V.milk_amount, V.milk_volume);
					Wikifier.wikifyEval("<<replace '#fluids'>><<cheats-fluids>><</replace>>");
				},
				step: 10,
				valueFormat: value => Math.round(value) + "ml",
				percentage: false, min: 24, max: $milk_max * $AMCTraits.milk
			}>>
			<<if $player.penisExist>>
				<<numberStepper "정액량" $semen_volume {
					callback: value => {
						V.semen_volume = value;
						V.semen_amount = Math.min(V.semen_amount, V.semen_volume);
						Wikifier.wikifyEval("<<replace '#fluids'>><<cheats-fluids>><</replace>>");
					},
					step: 10,
					valueFormat: value => Math.round(value) + "ml",
					percentage: false, max: semenCapacityMax()
				}>>
			<</if>>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">의류</div>
		<div class="settingsToggleItemWide">
			<<link "모든 특수 의류 해금">>
				<<run for(const c in V.specialClothes) {if (V.specialClothes[c].unlocked === 0) V.specialClothes[c].unlocked = 1}>>
			<</link>>
			<br>
			<span class="description">옷의 내구도가 0이 되면 찢어집니다. 이 상태로 치트 메뉴를 닫으면 옷이 완전히 파괴되며, 다시는 복구할 수 없습니다.</span>
			<br>
		</div>
		<div class="settingsToggleItemWide">
			<<if $godClothes is 0>>
				<<link [[자동 수리 활성화|$passage]]>><<set $godClothes to 1>><</link>>
			<<elseif $godClothes is 1>>
				<<link [[자동 수리 비활성화|$passage]]>><<set $godClothes to 0>><</link>>
			<</if>>
			<br>
			<span class="description">의상은 여전히 망가질 수 있으며, 이 기능은 게임 내 1초가 지날 때마다 의상 내구도만 복구합니다.</span>
			<br>
		</div>
		<<set _cl_slots to ["upper", "lower", "under_upper", "under_lower", "over_upper", "over_lower", "genitals"]>>
		<<if $worn.face.type.includesAny("face_covering", "gag", "mask")>>
			<<run _cl_slots.push("face")>>
		<</if>>
		<<set $_clothes to []>>

		<<if $worn.over_upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_upper "over_upper">><<= $worn.over_upper.name.toUpperFirst()>> 내구도:</span>

				<<set _overupperintegritymax to getSetupClothing('over_upper', $worn.over_upper)?.integrity_max || 200>>
				<<numberslider "$worn.over_upper.integrity" `Math.min($worn.over_upper.integrity, _overupperintegritymax)` 0 _overupperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.over_upper, "over_upper") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_upper "over_upper">><<= $worn.over_upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$overupperwet" $overupperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('overupperwet', value),
					value: v => wetnessWord('overupper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("겉옷 상의")>>
		<</if>>
		<<if $worn.over_lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<<set _overlowerintegritymax to getSetupClothing('over_lower', $worn.over_lower)?.integrity_max || 200>>
				<span class="gold"><<clothingicon $worn.over_lower "over_lower">><<= $worn.over_lower.name.toUpperFirst()>> 내구도:</span>
				<<numberslider "$worn.over_lower.integrity" `Math.min($worn.over_lower.integrity, _overlowerintegritymax)` 0 _overlowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.over_lower, "over_lower") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_lower "over_lower">><<= $worn.over_lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$overlowerwet" $overlowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('overlowerwet', value),
					value: v => wetnessWord('overlower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("겉옷 하의")>>
		<</if>>

		<<if $worn.upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.upper "upper">><<= $worn.upper.name.toUpperFirst()>> 내구도:</span>
				<<set _upperintegritymax to getSetupClothing('upper', $worn.upper)?.integrity_max || 200>>
				<<numberslider "$worn.upper.integrity" `Math.min($worn.upper.integrity, _upperintegritymax)` 0 _upperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.upper, "upper") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.upper "upper">><<= $worn.upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$upperwet" $upperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('upperwet', value),
					value: v => wetnessWord('upper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("상의")>>
		<</if>>

		<<if $worn.lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.lower "lower">><<= $worn.lower.name.toUpperFirst()>> 내구도:</span>
				<<set _lowerintegritymax to getSetupClothing('lower', $worn.lower)?.integrity_max || 200>>
				<<numberslider "$worn.lower.integrity" `Math.min($worn.lower.integrity, _lowerintegritymax)` 0 _lowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.lower, "lower") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.lower "lower">><<= $worn.lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$lowerwet" $lowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('lowerwet', value),
					value: v => wetnessWord('lower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("하의")>>
		<</if>>

		<<if $worn.under_lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_lower "under_lower">><<= $worn.under_lower.name.toUpperFirst()>> 내구도:</span>
				<<set _underlowerintegritymax to getSetupClothing('under_lower', $worn.under_lower)?.integrity_max || 200>>
				<<numberslider "$worn.under_lower.integrity" `Math.min($worn.under_lower.integrity, _underlowerintegritymax)`  0 _underlowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.under_lower, "under_lower") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_lower "under_lower">><<= $worn.under_lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$underlowerwet" $underlowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('underlowerwet', value),
					value: v => wetnessWord('underlower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("속옷 하의")>>
		<</if>>

		<<if $worn.under_upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_upper "under_upper">><<= $worn.under_upper.name.toUpperFirst()>> 내구도:</span>
				<<set _underupperintegritymax to getSetupClothing('under_upper', $worn.under_upper)?.integrity_max || 200>>
				<<numberslider "$worn.under_upper.integrity" `Math.min($worn.under_upper.integrity, _underupperintegritymax)` 0 _underupperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.under_upper, "under_upper") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_upper "under_upper">><<= $worn.under_upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$underupperwet" $underupperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('underupperwet', value),
					value: v => wetnessWord('underupper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("속옷 상의")>>
		<</if>>

		<<if $worn.genitals.integrity gte 1>>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold"><<clothingicon $worn.genitals "genitals">><<= $worn.genitals.name.toUpperFirst()>> 내구도:</span>
				<<set _genitalsintegritymax to getSetupClothing('genitals', $worn.genitals)?.integrity_max || 200>>
				<<numberslider "$worn.genitals.integrity" `Math.min($worn.genitals.integrity, _genitalsintegritymax)` 0 _genitalsintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.genitals, "genitals") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
		<<else>>
			<<set $_clothes.push("정조대")>>
		<</if>>

		<<if $worn.face.type.includesAny("face_covering", "gag", "mask")>>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold"><<clothingicon $worn.face "face">><<= $worn.face.name.toUpperFirst()>> 내구도:</span>

				<<set _faceintegritymax to getSetupClothing('face', $worn.face)?.integrity_max || 200>>
				<<numberslider "$worn.face.integrity" `Math.min($worn.face.integrity, _faceintegritymax)` 0 _faceintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.face, "face") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
		<<else>>
			<<set $_clothes.push("가면 또는 재갈")>>
		<</if>>
		<div class="settingsToggleItemWide">
			당신은 <span class="gold"><<= $_clothes.join(", ")>></span>【을를】 입고 있지 않습니다.

			<br>
			<label>자동 수선 <<checkbox "$cheatClothes" false true autocheck>></label> |
			/* Don't show links if player doesn't have anything to fix/destroy */
			<<if $_clothes.length lt 8>>
				<<link "모두 고치기">>
					<<run _cl_slots.forEach((slot) => {
						if (V.worn[slot].name === "naked") return;
						V.worn[slot].integrity = clothingData(slot, V.worn[slot], "integrity_max");
						cheatsUpdateSlider(
							`#numberslider-input-worn${slot.replace('_', '-')}integrity`,
							V.worn[slot].integrity
						);
					})>>
					<<updatesidebarimg>>
				<</link>> |
				<<link "모두 망가뜨리기">>
					/* not using ruined widgets to avoid side effects until confirmation */
					<<run _cl_slots.forEach((slot) => {
						if (V.worn[slot].name === "naked") return;
						V.worn[slot].integrity = 0;
						cheatsUpdateSlider(
							`#numberslider-input-worn${slot.replace('_', '-')}integrity`,
							V.worn[slot].integrity
						);
					})>>
					<<updatesidebarimg>>
				<</link>>
			<</if>>
			/* Don't show unless the player is wearing clothes that can be drenched or dried */
			<<if !$_clothes.includesAll("겉옷 상의", "겉옷 하의", "상의", "하의", "속옷 하의", "속옷 상의")>>
				| <<link "모두 말리기">>
					<<dry_full>>
					<<run _cl_slots.slice(0, 6).forEach((slot) => {
						if (V.worn[slot].name === 'naked') return;
						const wetnessProp = slot.replace('_', '') + 'wet';
						V[wetnessProp + 'stage'] = 0;
						cheatsUpdateSlider(`#numberslider-input-${wetnessProp}`, V[wetnessProp]);
					})>>
					<<updatesidebarimg>>
				<</link>> |
				<<link "모두 적시기">>
					<<run _cl_slots.slice(0, 6).forEach((slot) => {
						if (V.worn[slot].name === 'naked') return;
						const wetnessProp = slot.replace('_', '') + 'wet';
						V[wetnessProp] = 200;
						V[wetnessProp + 'stage'] = 3;
						cheatsUpdateSlider(`#numberslider-input-${wetnessProp}`, V[wetnessProp]);
					})>>
					<<updatesidebarimg>>
				<</link>>
			<</if>>
			<br><br>
			<span class="gold">구속구:</span>
			<br>
			<span class="description"> 팔을 결박하면 손에 든 아이템이 파괴됩니다. 발에 족쇄를 채우면 신발이 파괴됩니다.</span>
			<br>
			<<icon "clothes/gag.png">><<link "재갈">><<facewear "gag">><<updatesidebarimg>><</link>> | <<link "눈가리개">><<facewear "blindfold">><<updatesidebarimg>><</link>> | <<link "재갈과 눈가리개">><<facewear "gag and blindfold">><<updatesidebarimg>><</link>> | <<link "팔 결박">><<bind>><<updatesidebarimg>><</link>> | <<link "발 족쇄">><<shackle_feet>><<updatesidebarimg>><</link>>
			<br>
			<<undobindingsicon>> <<link "모든 구속 풀기">><<unbind>><<if $worn.face.type.includes("gag") or $worn.face.type.includes("blindfold")>><<set $worn.face.type.push("broken")>><<faceruined>><</if>><<updatesidebarimg>><</link>>

			<<if $debug>>
				<br><br>
				<span class="gold">옷장에 추가:</span>
				<br>
				<span class="description">디버그: 입력된 ID의 의류를 옷장으로 보냅니다.</span>
				<br>
				<<listbox "_slot" autoselect>>
					<<optionsfrom Object.fromEntries(setup.clothingLayer.body.map(s => [window.KR.getClothingSlotKr(s), s]))>>
				<</listbox>>
				<<set _clothesID to 1>>
				<<numberbox "_clothesID" 1>>
				<br>
				<<link "보내기">>
					<<if !between(_clothesID, 1, setup.clothes[_slot].length - 1)>>
						<<replace "#ClothesSendResult">>작동하지 않았습니다!<</replace>>
					<<else>>
						<<shopbuyv2 _slot "buy" "send" _clothesID 1>>
						<<replace "#ClothesSendResult">><<= setup.clothes[_slot][_clothesID].name>>【을를】 옷장에 보냈습니다!<</replace>>
					<</if>>
				<</link>>
				<br>
				<span id="ClothesSendResult"></span>
			<</if>>
		</div>
	</div>
	<hr>
	<div class="cheatsGrid">
		<div class="settingsHeader options">특성</div>
		<div class="settingsToggleItem">
			<<set _core to ["purity", "beauty", "physique", "willpower", "awareness", "promiscuity", "exhibitionism", "deviancy", "genderidentity"]>>
			<<if numberOfEarSlime()>><<set _core.push("earSlime.corruption")>><</if>>
			<span class="gold">핵심 특성</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _core>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<replace "#characteristics">><<cheatSection "characteristics">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _core>>
					<<set V[_i] to 50000>><<clamp>>
				<</for>>
				<<replace "#characteristics">><<cheatSection "characteristics">><</replace>>
			<</link>>
			<br><br>
			<span id="characteristics">
				<<cheatSection "characteristics">>
			</span>
			<hr>
			<span class="gold">보조 특성</span>
			<br>
			대화 태도:
			<span id="statsSpeechAttitude">
				<<cheatsSpeechAttitude>>
			</span>
			<br>
			<span class="description">대화 태도를 변경하면 순종성도 함께 변경됩니다.</span>
			<<numberStepper "순종" $submissive "submissive" {max: 2000}>>
			<<numberStepper "마조히즘" $masochism "masochism" {max: 1000}>>
			<<numberStepper "사디즘" $sadism "sadism" {max: 1000}>>

			<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
				<<numberStepper "은총" $grace "grace">>
			<</if>>
		</div>

		<div class="settingsToggleItem">
			<<set _skills to ["skulduggery", "skulduggeryday", "danceskill", "swimmingskill", "athletics", "tending", "housekeeping", "brawling", "footwork", "striking", "kicking"]>>
			<span class="gold">핵심 스킬</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _skills>>
					<<if _i isnot "brawling" and _i isnot "footwork" and _i isnot "striking" and _i isnot "kicking">>
						<<set V[_i] to 0>><<clamp>>
					<<else>>
						<<set $combatExtended[_i] to 0>><<clamp>>
					<</if>>
				<</for>>
				<<replace "#coreSkills">><<cheatSection "skills">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _skills>>
					<<if _i isnot "brawling" and _i isnot "footwork" and _i isnot "striking" and _i isnot "kicking">>
						<<set V[_i] to 20000>><<clamp>>
					<<else>>
						<<set $combatExtended[_i] to 20000>><<clamp>>
					<</if>>
				<</for>>
				<<replace "#coreSkills">><<cheatSection "skills">><</replace>>
			<</link>>
			<br><br>
			<span id="coreSkills">
				<<cheatSection "skills">>
			</span>
			<hr>
			<<set _subjects to ["english", "maths", "science", "history"]>>
			<span class="gold">학교 과목</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _subjects>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<adjust_school_traits>>
				<<exam_difficulty>>
				<<replace "#schoolSkills">><<cheatSection "school">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _subjects>>
					<<set V[_i] to 2000>><<clamp>>
				<</for>>
				<<adjust_school_traits>>
				<<exam_difficulty>>
				<<replace "#schoolSkills">><<cheatSection "school">><</replace>>
			<</link>>
			<br><br>
			<span id="schoolSkills">
				<<cheatSection "school">>
			</span>
		</div>

		<div class="settingsToggleItem">
			<<set _sexSkills to ["seduction", "oral", "vaginal", "penile", "anal", "hand", "feet", "bottom", "thigh", "chest"]>>
			<span class="gold">성적 스킬</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _sexSkills>>
					<<set V[`${_i}skill`] to 0>><<clamp>>
				<</for>>
				<<replace "#cheatsSex">><<cheatSection "sex">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _sexSkills>>
					<<set V[`${_i}skill`] to 2000>><<clamp>>
				<</for>>
				<<replace "#cheatsSex">><<cheatSection "sex">><</replace>>
			<</link>>
			<br><br>

			<span id="cheatsSex">
				<<cheatSection "sex">>
			</span>
		</div>

		<div class="settingsToggleItem">
			<<set V.cheats to V.cheats or {}>>
			<<set _hypnosis to ["scream", "cover", "deviancy", "crossdressing"]>>
			<span class="gold">최면 특성</span><br>
			<<link "모두 0으로 설정">>
				<<for _i range _hypnosis>>
					<<set V.hypnosis_traits[_i] to 0>><<clamp>>
				<</for>>
				<<replace "#hypnosis">><<cheatSection "hypnosis">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _hypnosis>>
					<<set V.hypnosis_traits[_i] to 5>><<clamp>>
				<</for>>
				<<replace "#hypnosis">><<cheatSection "hypnosis">><</replace>>
			<</link>>

			<br><br>
			<span id="hypnosis">
				<<cheatSection "hypnosis">>
			</span>
		</div>


		<div class="settingsToggleItem">
			<span class="gold">X-체인지 알약</span>
			<br>
			<div id="cheat-xchange-pills">
				<<if !$statFreeze>>
					<<if $xchange.pill.active>>
						<<cheatXchange>>
					<<else>>
						<<if playerIsPregnant()>>
							<span class="red"><b>주의!</b></span><br>임신 중에 X-체인지 알약을 먹으면 임신 상태가 손상될 수 있습니다. 먼저 임신을 끝내는 것을 고려하시고, 그렇지 않다면 책임은 본인에게 있습니다.
						<</if>>
						<br><br>
						<<link "성별 반전 알약 복용">><<set $xchange._cheatDose to true>><<xchange-dose-deliberate>><<take-xchange 3 "genderflip">><<xchange-dose-deliberate-end>><<run delete $xchange._cheatDose>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
						<br>
						<<link "시시/부치 알약 복용">><<set $xchange._cheatDose to true>><<take-xchange 3 "crossdress">><<run delete $xchange._cheatDose>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
						<br>
						<<link "양성화 알약 복용">><<set $xchange._cheatDose to true>><<xchange-dose-deliberate>><<take-xchange 3 "herm">><<xchange-dose-deliberate-end>><<run delete $xchange._cheatDose>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
						<br>
						<<link "그레이 알약 복용 (효과만)">><<set _grayNoEffects to []>><<save-body>><<xchange-effects 3 _grayNoEffects>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
						<br>
					<</if>>
				<<else>>
					능력치가 동결되어 있거나 사이드 스토리를 진행하는 중에는 X-체인지 알약을 적용할 수 없습니다.
				<</if>>
			</div>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">성향</span>
			<br>
			<<set $_traits to {"choke": $choketrait, "milkdrank" : $milkdranktrait, "vore" : $voretrait, "crittermagnet": $crittermagnettrait, "tentacle" : $tentacletrait, "bestiality" : $bestialitytrait, "rape" : $rapetrait, "molest" : $molesttrait, "ejac" : $ejactrait, "orgasm" : $orgasmtrait, "penis_addict": $penis_addict_trait, "hole_addict": $hole_addict_trait}>>
			<<set _traitValue to {"1": "켜짐", "-1": "비활성화", "0": "꺼짐"}>>

			절정 중독: <span id="statsorgasmtrait" @class="$orgasmtrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["orgasm"].toString()]>></span> |
			<<link "변경">>
				<<set $orgasmtrait += 1>>
				<<if $orgasmtrait gte 2>>
					<<set $orgasmtrait to -1>>
				<</if>>
				<<replace "#statsorgasmtrait">>
					<<set _orgasmtrait to _traitValue[$orgasmtrait.toString()]>>
					<<= _orgasmtrait>>
					<<changeCheatClass "#statsorgasmtrait" _orgasmtrait>>
				<</replace>>
			<</link>>
			<br>

			자지 중독자: <span id="statspenisaddicttrait" @class="$penis_addict_trait is 1 ? 'green' : 'red'"><<= $penis_addict_trait is 1 ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if $penis_addict_trait is 1>>
					<<set $penis_addict_trait to 0>>
					<<if $hole_addict_trait is -1>><<set $hole_addict_trait to 0>><</if>>
				<<else>>
					<<set $penis_addict_trait to 1>>
					<<set $hole_addict_trait to -1>>
				<</if>>
				<<replace "#statspenisaddicttrait">>
					<<set _penis_addict_trait to $penis_addict_trait is 1 ? "On" : "Off">>
					<<= _penis_addict_trait>>
					<<changeCheatClass "#statspenisaddicttrait" _penis_addict_trait>>
				<</replace>>
				<<replace "#statsholeaddicttrait">>
					<<set _hole_addict_trait to $hole_addict_trait is 1 ? "On" : "Off">>
					<<= _hole_addict_trait>>
					<<changeCheatClass "#statsholeaddicttrait" _hole_addict_trait>>
				<</replace>>
			<</link>>
			<br>

			구멍 중독자: <span id="statsholeaddicttrait" @class="$hole_addict_trait is 1 ? 'green' : 'red'"><<= $hole_addict_trait is 1 ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if $hole_addict_trait is 1>>
					<<set $hole_addict_trait to 0>>
					<<if $penis_addict_trait is -1>><<set $penis_addict_trait to 0>><</if>>
				<<else>>
					<<set $hole_addict_trait to 1>>
					<<set $penis_addict_trait to -1>>
				<</if>>
				<<replace "#statsholeaddicttrait">>
					<<set _hole_addict_trait to $hole_addict_trait is 1 ? "On" : "Off">>
					<<= _hole_addict_trait>>
					<<changeCheatClass "#statsholeaddicttrait" _hole_addict_trait>>
				<</replace>>
				<<replace "#statspenisaddicttrait">>
					<<set _penis_addict_trait to $penis_addict_trait is 1 ? "On" : "Off">>
					<<= _penis_addict_trait>>
					<<changeCheatClass "#statspenisaddicttrait" _penis_addict_trait>>
				<</replace>>
			<</link>>
			<br>

			구강 집착: <span id="statsoralfixationtrait" @class="$oral_fixation_trait is 1 ? 'green' : 'red'"><<= $oral_fixation_trait is 1 ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<set $oral_fixation_trait to $oral_fixation_trait is 1 ? 0 : 1>>
				<<replace "#statsoralfixationtrait">>
					<<set _oral_fixation_trait to $oral_fixation_trait is 1 ? "On" : "Off">>
					<<= _oral_fixation_trait>>
					<<changeCheatClass "#statsoralfixationtrait" _oral_fixation_trait>>
				<</replace>>
			<</link>>
			<br>

			정액받이: <span id="statsejactrait" @class="$ejactrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["ejac"].toString()]>></span> |
			<<link "변경">>
				<<set $ejactrait += 1>>
				<<if $ejactrait gte 2>>
					<<set $ejactrait to -1>>
				<</if>>
				<<replace "#statsejactrait">>
					<<set _ejactrait to _traitValue[$ejactrait.toString()]>>
					<<= _ejactrait>>
					<<changeCheatClass "#statsejactrait" _ejactrait>>
				<</replace>>
			<</link>>
			<br>

			노리개: <span id="statsmolesttrait" @class="$molesttrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["molest"].toString()]>></span> |
			<<link "변경">>
				<<set $molesttrait += 1>>
				<<if $molesttrait gte 2>>
					<<set $molesttrait to -1>>
				<</if>>
				<<replace "#statsmolesttrait">>
					<<set _molesttrait to _traitValue[$molesttrait.toString()]>>
					<<= _molesttrait>>
					<<changeCheatClass "#statsmolesttrait" _molesttrait>>
				<</replace>>
			<</link>>
			<br>

			육변기: <span id="statsrapetrait" @class="$rapetrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["rape"].toString()]>></span> |
			<<link "변경">>
				<<set $rapetrait += 1>>
				<<if $rapetrait gte 2>>
					<<set $rapetrait to -1>>
				<</if>>
				<<replace "#statsrapetrait">>
					<<set _rapetrait to _traitValue[$rapetrait.toString()]>>
					<<= _rapetrait>>
					<<changeCheatClass "#statsrapetrait" _rapetrait>>
				<</replace>>
			<</link>>
			<br>

			암캐: <span id="statsbestialitytrait" @class="$bestialitytrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["bestiality"].toString()]>></span> |
			<<link "변경">>
				<<set $bestialitytrait += 1>>
				<<if $bestialitytrait gte 2>>
					<<set $bestialitytrait to -1>>
				<</if>>
				<<replace "#statsbestialitytrait">>
					<<set _bestialitytrait to _traitValue[$bestialitytrait.toString()]>>
					<<= _bestialitytrait>>
					<<changeCheatClass "#statsbestialitytrait" _bestialitytrait>>
				<</replace>>
			<</link>>
			<br>

			사냥감: <span id="statstentacletrait" @class="$tentacletrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["tentacle"].toString()]>></span> |
			<<link "변경">>
				<<set $tentacletrait += 1>>
				<<if $tentacletrait gte 2>>
					<<set $tentacletrait to -1>>
				<</if>>
				<<replace "#statstentacletrait">>
					<<set _tentacletrait to _traitValue[$tentacletrait.toString()]>>
					<<= _tentacletrait>>
					<<changeCheatClass "#statstentacletrait" _tentacletrait>>
				<</replace>>
			<</link>>
			<br>

			동물 자석: <span id="statscrittermagnettrait" @class="$crittermagnettrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["crittermagnet"].toString()]>></span> |
			<<link "변경">>
				<<set $crittermagnettrait += 1>>
				<<if $crittermagnettrait gte 2>>
					<<set $crittermagnettrait to -1>>
				<</if>>
				<<replace "#statscrittermagnettrait">>
					<<set _crittermagnettrait to _traitValue[$crittermagnettrait.toString()]>>
					<<= _crittermagnettrait>>
					<<changeCheatClass "#statscrittermagnettrait" _crittermagnettrait>>
				<</replace>>
			<</link>>
			<br>

			맛있는: <span id="statsvoretrait" @class="$voretrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["vore"].toString()]>></span> |
			<<link "변경">>
				<<set $voretrait += 1>>
				<<if $voretrait gte 2>>
					<<set $voretrait to -1>>
				<</if>>
				<<replace "#statsvoretrait">>
					<<set _voretrait to _traitValue[$voretrait.toString()]>>
					<<= _voretrait>>
					<<changeCheatClass "#statsvoretrait" _voretrait>>
				<</replace>>
			<</link>>
			<br>

			우유 중독자: <span id="statsmilkdranktrait" @class="$milkdranktrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["milkdrank"].toString()]>></span> |
			<<link "변경">>
				<<set $milkdranktrait += 1>>
				<<if $milkdranktrait gte 2>>
					<<set $milkdranktrait to -1>>
				<</if>>
				<<replace "#statsmilkdranktrait">>
					<<set _milkdranktrait to _traitValue[$milkdranktrait.toString()]>>
					<<= _milkdranktrait>>
					<<changeCheatClass "#statsmilkdranktrait" _milkdranktrait>>
				<</replace>>
			<</link>>
			<br>

			호색한: <span id="statslustful" @class="$backgroundTraits.includes('lustful') is true ? 'green' : 'red'"><<= $backgroundTraits.includes("lustful") is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("lustful")>>
					<<set $backgroundTraits.pushUnique("lustful")>><<set $specialClothesEffects.bimbo.total to 1200>>
				<<else>>
					<<set $backgroundTraits.delete("lustful")>><<if $specialClothesEffects.bimbo.total gt 1000>><<set $specialClothesEffects.bimbo.total to 1000>><</if>>
				<</if>>
				<<replace "#statslustful">>
					<<set _lustful to $backgroundTraits.includes("lustful") is true ? "켜짐" : "꺼짐">>
					<<= _lustful>>
					<<changeCheatClass "#statslustful" _lustful>>
				<</replace>>
			<</link>>
			<br>

			크로스드레서: <span id="statscrossdresser" @class="$backgroundTraits.includes('crossdresser') and !$background.transgender ? 'green' : 'red'"><<= $backgroundTraits.includes("crossdresser") and !$background.transgender ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("crossdresser") or $background.transgender>>
					<<set $backgroundTraits.pushUnique("crossdresser")>><<set $crossdressingTrait to 100>>
					<<set $background.transgender to false>><<set $background.crossdresser to true>>
					<<set $backgroundTraits.delete("genderAnxious")>><<set $background.genderAnxious to false>>
				<<else>>
					<<set $backgroundTraits.delete("crossdresser")>><<if $crossdressingTrait gt 80>><<set $crossdressingTrait to 80>><</if>>
					<<set $background.crossdresser to false>>
				<</if>>
				<<updateGenderTraitCheats>>
			<</link>>
			<br>

			트랜스젠더: <span id="statstransgender" @class="$background.transgender is true ? 'green' : 'red'"><<= $background.transgender is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$background.transgender>>
					<<set $background.transgender to true>><<set $background.crossdresser to false>>
					<<set $backgroundTraits.pushUnique("crossdresser")>><<set $crossdressingTrait to 100>>
					<<set $backgroundTraits.delete("genderAnxious")>><<set $background.genderAnxious to false>>
				<<else>>
					<<set $background.transgender to false>>
					<<set $backgroundTraits.delete("crossdresser")>><<if $crossdressingTrait gt 80>><<set $crossdressingTrait to 80>><</if>>
				<</if>>
				<<updateGenderTraitCheats>>
			<</link>>
			<br>

			성별 불안: <span id="statsgenderanxious" @class="$backgroundTraits.includes('genderAnxious') ? 'green' : 'red'"><<= $backgroundTraits.includes("genderAnxious") ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("genderAnxious")>>
					<<set $backgroundTraits.pushUnique("genderAnxious")>><<set $background.genderAnxious to true>>
					<<set $background.transgender to false>>
					<<set $backgroundTraits.delete("crossdresser")>><<if $crossdressingTrait gt 80>><<set $crossdressingTrait to 80>><</if>>
					<<set $background.crossdresser to false>>
				<<else>>
					<<set $backgroundTraits.delete("genderAnxious")>><<set $background.genderAnxious to false>>
				<</if>>
				<<updateGenderTraitCheats>>
			<</link>>
			<br>

			원예가: <span id="statsgreenthumb" @class="$backgroundTraits.includes('greenthumb') is true ? 'green' : 'red'"><<= $backgroundTraits.includes("greenthumb")is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("greenthumb")>>
					<<set $backgroundTraits.pushUnique("greenthumb")>>
				<<else>>
					<<set $backgroundTraits.delete("greenthumb")>>
				<</if>>
				<<replace "#statsgreenthumb">>
					<<set _greenthumb to $backgroundTraits.includes("greenthumb") is true ? "켜짐" : "꺼짐">>
					<<= _greenthumb>>
					<<changeCheatClass "#statsgreenthumb" _greenthumb>>
				<</replace>>
			<</link>>
			<br>

			질식기호증: <span id="statschoke" @class="$choketrait is 1 ? 'green' : 'red'"><<= _traitValue[$_traits["choke"].toString()]>></span> |
			<<link "변경">>
				<<set $choketrait += 1>>
				<<if $choketrait gte 2>>
					<<set $choketrait to 0>>
				<</if>>
				<<replace "#statschoke">>
					<<set _choketrait to _traitValue[$choketrait.toString()]>>
					<<= _choketrait>>
					<<changeCheatClass "#statschoke" _choketrait>>
				<</replace>>
			<</link>>
			<br>

			식물 애호가: <span id="statsplantlover" @class="$backgroundTraits.includes('plantlover') is true ? 'green' : 'red'"><<= $backgroundTraits.includes("plantlover")is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("plantlover")>>
					<<set $backgroundTraits.pushUnique("plantlover")>>
					<<set $nectar_addiction to 200>>
					<<set $nectar_timer to 21>>
				<<else>>
					<<set $backgroundTraits.delete("plantlover")>>
					<<set $nectar_addiction to 0>>
					<<set $nectar_timer to 0>>
				<</if>>
				<<replace "#statsplantlover">>
					<<set _plantlover to $backgroundTraits.includes("plantlover") is true ? "켜짐" : "꺼짐">>
					<<= _plantlover>>
					<<changeCheatClass "#statsplantlover" _plantlover>>
				<</replace>>
			<</link>>
			<br>
			초연함: <span id="statsdetached" @class="$backgroundTraits.includes('detached') is true ? 'green' : 'red'"><<= $backgroundTraits.includes("detached") is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				<<if !$backgroundTraits.includes("detached")>>
					<<set $backgroundTraits.pushUnique("detached")>>
					<<set $background.detached to true>>
				<<else>>
					<<set $backgroundTraits.delete("detached")>>
					<<set $background.detached to false>>
				<</if>>
				<<replace "#statsdetached">>
					<<set _detached to $backgroundTraits.includes("detached") is true ? "On" : "Off">>
					<<= _detached>>
					<<changeCheatClass "#statsdetached" _detached>>
				<</replace>>
			<</link>>
			<br>
			자폐 스펙트럼: <span id="statsautism" @class="$backgroundTraits.includes('autism') is true ? 'green' : 'red'"><<= $backgroundTraits.includes("autism") is true ? "켜짐" : "꺼짐">></span> |
			<<link "변경">>
				/* $background.autism is the character-creation input, $backgroundTraits the live state. Keep both in step. */
				<<if !$backgroundTraits.includes("autism")>>
					<<set $backgroundTraits.pushUnique("autism")>>
					<<set $background.autism to true>>
					<<run initAutismSpectrumState()>>
				<<else>>
					<<set $backgroundTraits.delete("autism")>>
					<<set $background.autism to false>>
					<<run delete $autismSpectrum>>
					<<run autismEnforceTalentLimits()>>
				<</if>>
				<<replace "#statsautism">>
					<<set _autism to $backgroundTraits.includes("autism") is true ? "On" : "Off">>
					<<= _autism>>
					<<changeCheatClass "#statsautism" _autism>>
				<</replace>>
				<<replace "#statsautismload">><<autismLoadCheat>><</replace>>
			<</link>>
			<br>
			<span id="statsautismload"><<autismLoadCheat>></span>
			<br>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">명성</div>
		<div class="settingsToggleItem">
			<<set _positiveFames to ["good", "business", "scrap", "social", "model"]>>
			<<set _negativeFames to ["exhibitionism", "prostitution", "bestiality", "sex", "rape", "pregnancy", "impreg"]>>
			<span class="gold">부정적인 명성</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _negativeFames>>
					<<set $fame[_i] to 0>>
				<</for>>
				<<fameclamp>>
				<<replace #cheatsNegative>><<cheatSection "negative">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _negativeFames>>
					<<set $fame[_i] to 4000>>
				<</for>>
				<<fameclamp>>
				<<replace #cheatsNegative>><<cheatSection "negative">><</replace>>
			<</link>>
			<br><br>
			<span id="cheatsNegative">
				<<cheatSection "negative">>
			</span>
			<hr>
			<span class="gold">긍정적인 명성</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _positiveFames>>
					<<set $fame[_i] to 0>>
				<</for>>
				<<fameclamp>>
				<<replace #cheatsPositive>><<cheatSection "positive">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _positiveFames>>
					<<set $fame[_i] to 4000>>
				<</for>>
				<<fameclamp>>
				<<replace #cheatsPositive>><<cheatSection "positive">><</replace>>
			<</link>>
			<br><br>
			<span id="cheatsPositive">
				<<cheatSection "positive">>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">범죄</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _cr range Object.keys(setup.crimeNames)>>
					<<capture _cr>>
						<<set C.crime[_cr] to 0>>
						<<replace "#cheatsCrime">><<cheatSection "crime">><</replace>>
					<</capture>>
				<</for>>
			<</link>> |
			<<link "모두 최대로 설정">>
				<<for _cr range Object.keys(setup.crimeNames)>>
					<<capture _cr>>
						<<set C.crime[_cr] to 10000>>
						<<replace "#cheatsCrime">><<cheatSection "crime">><</replace>>
					<</capture>>
				<</for>>
			<</link>>
			<br><br>
			<span id="cheatsCrime">
				<<cheatSection "crime">>
			</span>
			<hr>
			<span class="gold">범죄 이벤트</span>
			<br>
			<span id="statscrimeevents"><<listCrimeCheats>></span>
			<<link "범죄 이벤트 지우기">><<crimeClearEvent "all">><<replace #statscrimeevents>><<listCrimeCheats>><</replace>><</link>>
		</div>
	</div>
<</widget>>

<<widget "updateGenderTraitCheats">>
	<<replace "#statscrossdresser">>
		<<set _crossdresser to $backgroundTraits.includes("crossdresser") and !$background.transgender ? "On" : "Off">>
		<<= _crossdresser>>
		<<changeCheatClass "#statscrossdresser" _crossdresser>>
	<</replace>>
	<<replace "#statstransgender">>
		<<set _transgender to $background.transgender is true ? "On" : "Off">>
		<<= _transgender>>
		<<changeCheatClass "#statstransgender" _transgender>>
	<</replace>>
	<<replace "#statsgenderanxious">>
		<<set _genderanxious to $backgroundTraits.includes("genderAnxious") ? "On" : "Off">>
		<<= _genderanxious>>
		<<changeCheatClass "#statsgenderanxious" _genderanxious>>
	<</replace>>
<</widget>>

<<widget "cheat-set-pill-duration">>
	/* args[0]: duration in hours (number), or the string "permanent" */
	<<if _args[0] is "permanent">>
		/* Force the permanence setting on, otherwise xchange.js force-reverts permanent pills on the next tick */
		<<set $xchange.pillPermanence to 1>>
		<<xchange-setpermanent>>
	<<else>>
		<<set $xchange.pill.duration to _args[0]>>
		<<set $xchange.pill.countdown to 0>>
		<<unset $xchange.pill.shouldHaveEnded>>
		<<unset $xchange.pill.resistanceFakeout>>
	<</if>>
<</widget>>

<<widget "cheatXchange">>
	<<if xchangePregnancyBlocksRevert()>>
		<span class="red"><b>주의!</b><br></span>임신 중에 "알약 강제 종료"를 사용하면 임신 상태가 손상될 수 있습니다. 먼저 임신을 끝내는 것을 고려하시고, 그렇지 않다면 책임은 본인에게 있습니다.
		<br>
	<</if>>
	<<linkreplace "알약 강제 종료">>알약을 강제로 종료했습니다<<run setup.xChangeRecordActiveBodyVirginity()>><<xchange-restore "force">><<updatesidebarimg>><</linkreplace>>
	<br><br>
	알약 지속 시간: <<if pillIsPermanent()>><span class="green">영구</span><<else>><span class="teal"><<print-pillduration>></span><</if>>
	<br>
	지속 시간 설정:
	<<link "1일">><<cheat-set-pill-duration 24>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "3일">><<cheat-set-pill-duration 72>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "1주일">><<cheat-set-pill-duration 168>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "1개월">><<cheat-set-pill-duration 720>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "영구">><<cheat-set-pill-duration "permanent">><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
	<br><br>
	시시/부치: <span id="xchange-crossdress"><<= $xchange.pill.genderificationEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.genderificationEffect to $xchange.pill.genderificationEffect? false : true>><<replace "#xchange-crossdress">><<= $xchange.pill.genderificationEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	레지스턴스: <span id="xchange-resistance"><<= $xchange.pill.resistanceEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.resistanceEffect to $xchange.pill.resistanceEffect? false : true>><<set $xchange.pill.resistanceChance to 100>><<replace "#xchange-resistance">><<= $xchange.pill.resistanceEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	컨티뉴: <span id="xchange-continue"><<= $xchange.pill.continueEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.continueEffect to $xchange.pill.continueEffect? false : true>><<replace "#xchange-continue">><<= $xchange.pill.continueEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	오메가:
	<span id="xchange-omega"><<= $xchange.pill.omegaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">><<if $xchange.pill.omegaEffect>><<xchange-removeeffect "omega">><<else>><<xchange-addeffect "omega">><</if>><<replace "#xchange-omega">><<= $xchange.pill.omegaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	<<if $player.sex isnot "m" or (playerIsXChanged() and $xchange.pill.hermEffect)>>
		베타:
		<span id="xchange-beta"><<= $xchange.pill.betaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
		<<link "변경">><<if $xchange.pill.betaEffect>><<xchange-removeeffect "beta">><<else>><<xchange-addeffect "beta">><</if>><<replace "#xchange-beta">><<= $xchange.pill.betaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
		브리더:
		<span id="xchange-breeder"><<= $xchange.pill.breederEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
		<<link "변경">><<if $xchange.pill.breederEffect>><<xchange-removeeffect "breeder">><<else>><<xchange-addeffect "breeder">><</if>><<replace "#xchange-breeder">><<= $xchange.pill.breederEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
		가임:
		<span id="xchange-fertile"><<= $xchange.pill.fertile ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
		<<link "변경">><<if $xchange.pill.fertile>><<xchange-removeeffect "fertile">>	<<else>><<xchange-addeffect "fertile">>	<</if>>
		<<replace "#xchange-fertile">><<= $xchange.pill.fertile ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
	<</if>>
	<<if $player.sex isnot "f" or (playerIsXChanged() and $xchange.pill.hermEffect)>>
		불: <span id="xchange-bull"><<= $xchange.pill.bullEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.bullEffect to $xchange.pill.bullEffect? false : true>><<replace "#xchange-bull">><<= $xchange.pill.bullEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
		알파:
		<span id="xchange-alpha"><<= $xchange.pill.alphaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
		<<link "변경">><<if $xchange.pill.alphaEffect>><<xchange-removeeffect "alpha">><<else>><<xchange-addeffect "alpha">><</if>><<replace "#xchange-alpha">><<= $xchange.pill.alphaEffect ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
	<</if>>
	열정: <span id="xchange-passion"><<= $xchange.pill.passionEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.passionEffect to $xchange.pill.passionEffect? false : true>><<replace "#xchange-passion">><<= $xchange.pill.passionEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	멍청한 암캐: <span id="xchange-bitch"><<= $xchange.pill.dumbBitchEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.dumbBitchEffect to $xchange.pill.dumbBitchEffect? false : true>><<replace "#xchange-bitch">><<= $xchange.pill.dumbBitchEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br>
	<<if $portalPantiesEnabled>>
		포털: <span id="xchange-portal"><<= $xchange.pill.portalEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.portalEffect to $xchange.pill.portalEffect? false : true>><<set $xchange.pill.portalEffectTimer to $xchange.pill.duration>><<replace "#xchange-portal">><<= $xchange.pill.portalEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
		<br>
	<</if>>

	/* New effects */
	순수함:
	<span id="xchange-innocence"><<= $innocencestate is 1 ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $innocencestate is 1>>
			<<xchange-removeeffect "innocence">>
		<<else>>
			<<xchange-addeffect "innocence">>
		<</if>>
		<<replace "#xchange-innocence">><<= $innocencestate is 1 ? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	공포 독소: <span id="xchange-feartoxin"><<= $xchange.pill.feartoxinEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $xchange.pill.feartoxinEffect>>
			<<xchange-removeeffect "feartoxin">>
		<<else>>
			<<xchange-addeffect "feartoxin">>
		<</if>>
		<<replace "#xchange-feartoxin">><<= $xchange.pill.feartoxinEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	부풀기: <span id="xchange-swell"><<= $xchange.pill.swellEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $xchange.pill.swellEffect>>
			<<xchange-removeeffect "swell">>
		<<else>>
			<<xchange-addeffect "swell">>
		<</if>>
		<<replace "#xchange-swell">><<= $xchange.pill.swellEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	빔보: <span id="xchange-bimbo"><<= $xchange.pill.bimboEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $xchange.pill.bimboEffect>>
			<<xchange-removeeffect "bimbo">>
		<<else>>
			<<xchange-addeffect "bimbo">>
		<</if>>
		<<replace "#xchange-bimbo">><<= $xchange.pill.bimboEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	컴큐어: <span id="xchange-cumcure"><<= $xchange.pill.cumcureEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $xchange.pill.cumcureEffect>>
			<<xchange-removeeffect "cumcure">>
		<<else>>
			<<xchange-addeffect "cumcure">>
		<</if>>
		<<replace "#xchange-cumcure">><<= $xchange.pill.cumcureEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	하이퍼 퍼틸리티: <span id="xchange-hyperfertility"><<= $xchange.pill.hyperFertilityEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> |
	<<link "변경">>
		<<if $xchange.pill.hyperFertilityEffect>>
			<<xchange-removeeffect "fertility">>
		<<else>>
			<<xchange-addeffect "fertility">>
		<</if>>
		<<replace "#xchange-hyperfertility">><<= $xchange.pill.hyperFertilityEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>>
	<</link>>
	<br>
	X-텐드: <span id="xchange-xtend"><<= $xchange.pill.xtendEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.xtendEffect to $xchange.pill.xtendEffect? false : true>><<set $xchange.pill.xtendTracker to {orgasmed: 0, penisSizeGains: 0}>><<replace "#xchange-xtend">><<= $xchange.pill.xtendEffect? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br><br>

	효과 알려짐: <span id="xchange-spike"><<= $xchange.pill.effectsKnown? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">></span> | <<link "변경">><<set $xchange.pill.effectsKnown to $xchange.pill.effectsKnown? false : true>><<replace "#xchange-spike">><<= $xchange.pill.effectsKnown? "<span class=\"green\">켜짐</span>" : "<span class=\"red\">꺼짐</span>">><</replace>><</link>>
	<br><br>
<</widget>>

<<widget "cheats-fluids">>
	<<numberStepper "모유량" $milk_amount "milk_amount" {
		max: $milk_volume,
		step: 10,
		valueFormat: (value, percentage) => `<b>${Math.round(percentage)}%</b> (${Math.round(value)}ml)`
	}>>
	<<if $player.penisExist>>
		<<numberStepper "정액량" $semen_amount "semen_amount" {
			max: $semen_volume,
			step: 10,
			valueFormat: (value, percentage) => `<b>${Math.round(percentage)}%</b> (${Math.round(value)}ml)`
		}>>
	<</if>>
<</widget>>

<<widget "cheats-characterVisual">>
	<div class="settingsGrid">
		<div class="settingsHeader options">
            피부색
        </div>
        <div class="settingsToggleItem">
            <span class="gold">뉴트럴:</span><br>
            <<link [[밝은|$passage]]>><<set $player.skin.color to "light">><</link>> |
            <<link [[중간|$passage]]>><<set $player.skin.color to "medium">><</link>> |
            <<link [[어두운|$passage]]>><<set $player.skin.color to "dark">><</link>> |
            <<link [[갸루|$passage]]>><<set $player.skin.color to "gyaru">><</link>>
        </div>
        <div class="settingsToggleItem">
            <span class="gold">웜:</span><br>
            <<link [[밝은|$passage]]>><<set $player.skin.color to "rlight">><</link>> |
            <<link [[중간|$passage]]>><<set $player.skin.color to "rmedium">><</link>> |
            <<link [[어두운|$passage]]>><<set $player.skin.color to "rdark">><</link>> |
            <<link [[갸루|$passage]]>><<set $player.skin.color to "rgyaru">><</link>>
        </div>
        <div class="settingsToggleItem">
            <span class="gold">골든:</span><br>
            <<link [[밝은|$passage]]>><<set $player.skin.color to "glight">><</link>> |
            <<link [[중간|$passage]]>><<set $player.skin.color to "gmedium">><</link>> |
            <<link [[어두운|$passage]]>><<set $player.skin.color to "gdark">><</link>> |
            <<link [[갸루|$passage]]>><<set $player.skin.color to "ggyaru">><</link>>
        </div>
        <div class="settingsToggleItem">
            <span class="gold">올리브:</span><br>
            <<link [[밝은|$passage]]>><<set $player.skin.color to "ylight">><</link>> |
			<<link [[중간|$passage]]>><<set $player.skin.color to "ymedium">><</link>> |
            <<link [[어두운|$passage]]>><<set $player.skin.color to "ydark">><</link>> |
            <<link [[갸루|$passage]]>><<set $player.skin.color to "ygyaru">><</link>>
        </div>
        <div class="settingsToggleItem">
            <span class="gold">쿨:</span><br>
            <<link [[밝은|$passage]]>><<set $player.skin.color to "blight">><</link>> |
            <<link [[중간|$passage]]>><<set $player.skin.color to "bmedium">><</link>> |
            <<link [[어두운|$passage]]>><<set $player.skin.color to "bdark">><</link>> |
            <<link [[갸루|$passage]]>><<set $player.skin.color to "bgyaru">><</link>>
        </div>
		<<set _tan to Skin.totalTan>>
		<div class="numberslider-inline">
			<label><span class="gold">초기 태닝:</span>
			<<numberslider "_tan" _tan 0 100 1 {
				onInputChange: value => {
					Skin.color.setTan(value);
					Wikifier.wikifyEval("<<updatesidebarimg>>");
				},
				value: v => `${v}%`
			}>>
			</label>
		</div>
		<div class="settingsHeader options">플레이어</div>
		<div class="settingsToggleItemWide">
			<span class="gold">머리 길이</span>
			<br>
			<<if $passage is "Hairdressers Seat">>
				미용실에 있을 때는 머리 치트가 비활성화됩니다.
				<br><br>
			<<else>>
				<<numberStepper "머리 길이" $hairlength {max: 1000, callback: value => {V.hairlength = value; calchairlengthstage(); wikifier("updatesidebarimg")}}>>
				<<numberStepper "앞머리 길이" $fringelength {max: 1000, callback: value => {V.fringelength = value; calchairlengthstage(); wikifier("updatesidebarimg")}}>>

				<<if $hairtest is 1 or $debug>>
					<<foldout false "_cheatsFoldoutNatural">>
						<span class="gold">원래 머리색 (DEBUG)</span>
						<<set _bar to false>>
						<<for _i = 0; _i < setup.colours.hair.length; _i++>>
							<<if setup.colours.hair[_i].natural>>
								<<if _bar>>|<</if>>
								<label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiovar "$naturalhaircolour" setup.colours.hair[_i].variable>> <<updatesidebarimg>><</radiovar>></label>
								<<set _bar to true>>
							<</if>>
						<</for>>
						<br><br>
					<</foldout>>
				<</if>>

				<<foldout false "_cheatsFoldoutDye">>
					<span class="gold">머리 염색</span>
					<label>없음 <<radiovar "$haircolour" $naturalhaircolour>> <<updatesidebarimg>><</radiovar>></label>
					<<for _i = 0; _i < setup.colours.hair.length; _i++>>
						<<if setup.colours.hair[_i].dye>>
							| <label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiovar "$haircolour" setup.colours.hair[_i].variable>> <<updatesidebarimg>><</radiovar>></label>
						<</if>>
					<</for>>
					<br>
					투톤:
					<label>활성화 <<radiovar "$hairColourStyle" "gradient">> <<updatesidebarimg>><</radiovar>></label>
					<label>비활성화 <<radiovar "$hairColourStyle" "simple">> <<updatesidebarimg>><</radiovar>></label>
					<br>
					투톤 스타일: <<listbox "$hairColourGradient.style" autoselect>>
								<<option "연한 투톤" "low-ombre">>
								<<option "진한 투톤" "high-ombre">>
								<<option "반반 투톤" "split">>
								<<option "앞머리 브릿지" "face-frame">>
							<</listbox>>
					<br><br>
				<</foldout>>

				<<foldout false "_cheatsFoldoutFringe">>
					<span class="gold">앞머리 염색</span>
					<label>없음 <<radiovar "$hairfringecolour" $naturalhaircolour>> <<updatesidebarimg>><</radiovar>></label>
					<<for _i = 0; _i < setup.colours.hair.length; _i++>>
						<<if setup.colours.hair[_i].dye>>
							| <label><span @class="setup.colours.hair[_i].csstext"><<= setup.colours.hair[_i].name_cap>></span> <<radiovar "$hairfringecolour" setup.colours.hair[_i].variable>> <<updatesidebarimg>><</radiovar>></label>
						<</if>>
					<</for>>
					<br>
					투톤:
					<label>활성화 <<radiovar "$hairFringeColourStyle" "gradient">> <<updatesidebarimg>><</radiovar>></label>
					<label>비활성화 <<radiovar "$hairFringeColourStyle" "simple">> <<updatesidebarimg>><</radiovar>></label>
					<br>
					투톤 스타일: <<listbox "$hairFringeColourGradient.style" autoselect>>
								<<option "낮은 옴브레" "low-ombre">>
								<<option "높은 옴브레" "high-ombre">>
								<<option "반반 염색" "split">>
								<<option "얼굴 주변 하이라이트" "face-frame">>
							<</listbox>>
					<br><br>
				<</foldout>>
			<</if>>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">눈동자 색</span>
			<br>
 			<<set _bar to false>>
			<<set _temp_list to []>>
 			<<for _i = 0; _i < setup.colours.eyes.length; _i++>>
				<<if setup.colours.eyes[_i].natural and !_temp_list.includes(setup.colours.eyes[_i].name)>>
 					<<if _bar>>|<</if>>
					<<set _eyeItem to setup.colours.eyes[_i]>>
					<<set _eyeColourName to (function(item) {
						try { return window.colorNameTranslate(item.variable, "spaced name"); } catch (e) {}
						try { return window.colorNameTranslate(window.colorNamer(item.canvasfilter.blend), "spaced name"); } catch (e) {}
						return item.name;
					})(_eyeItem)>>
					<label>
						<span @class="setup.colours.eyes[_i].csstext">
							<<= _eyeColourName>>
						</span>
 						<<radiovar "$eyeselected" setup.colours.eyes[_i].variable>>
 							<<cheatMenuEyesSelected>>
						<</radiovar>>
						<<set _temp_list.push(setup.colours.eyes[_i].name)>>
					</label>
					<<set _bar to true>>
				<</if>>
			<</for>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">주근깨</span>
			<br>
			얼굴: <label>비활성화됨 <<radiobutton "$player.skin.faceFreckles" false autocheck>></label>
			| <label>활성화됨 <<radiobutton "$player.skin.faceFreckles" true autocheck>></label>
			<br>
			몸: <label>비활성화됨 <<radiobutton "$player.skin.bodyFreckles" "none" autocheck>></label>
			| <label>상반신 <<radiobutton "$player.skin.bodyFreckles" "upper" autocheck>></label>
			| <label>전신 <<radiobutton "$player.skin.bodyFreckles" "full" autocheck>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">가슴 크기</span>
			<<set _breastsText to ["납작함", "봉긋함", "아주 작음", "작음", "탱탱함", "적당함", "풍만함", "큼", "넉넉함", "거대함", "엄청 큼", "초거대", "터무니없이 큼"]>>
			<<numberslider "$player.breastsize" $player.breastsize  0 _breastsText.length-1 1 {
				onInputChange: value => {
					wikifier("<<updatesidebarimg false>>");
				},
				value: v => {
					return T.breastsText[v];
				}
			}>>
			<br><br>

			<span class="gold">엉덩이 크기</span>
			<<set _buttsText to ["가냘픔", "날씬함", "적당함", "푹신함", "부드러움", "둥긂", "통통함", "큼", "거대함"]>>
			<<numberslider "$player.bottomsize" $player.bottomsize  0 _buttsText.length-1 1 {
				onInputChange: value => {
					wikifier("<<updatesidebarimg false>>");
				},
				value: v => {
					return T.buttsText[v];
				}
			}>>

			<<if $player.penisExist>>
				<br><br>
				<span class="gold">자지 크기</span>
				<<set _penisText to ["극소형", "소형", "아주 작음", "작음", "보통", "큼", "거대함"]>>
				<<numberslider "$player.penissize" $player.penissize 0 6 1 {
				onInputChange: value => {
					wikifier("<<updatesidebarimg false>>");
				},
				value: v => {
					return T.penisText[v];
				}
			}>>
				<<if $debug>>
					<br>
					<span class="description">고환 크기 (DEBUG):
					<<link "〈">><<set $ballssize -= 1>><<clamp>><<replace "#statsballssize">><<= Math.trunc($ballssize)>><</replace>> <<updatesidebarimg>><</link>> |
					<span id="statsballssize"><<= Math.trunc($ballssize)>></span>
					| <<link "〉">><<set $ballssize += 1>><<clamp>><<replace "#statsballssize">><<= Math.trunc($ballssize)>><</replace>> <<updatesidebarimg>><</link>></span>
				<</if>>
			<</if>>
			<br><br>
			<label>알몸 가리기 (당황했을 때만): <<checkbox "$dontHide" true false autocheck>>
			<<run $(() => $('#checkbox-donthide').on('change', e => wikifier('<<updatesidebarimg>>')))>></label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">민감도</span>
			<<numberStepper "입 민감도" $mouthsensitivity "mouthsensitivity" {
				min: 1, max: 4, step: 0.1, reverse: true,
				valueFormat: value => `<b>${round(value, 2)}</b> (${sensitivityString(value)})`
			}>>
			<<numberStepper "가슴 민감도" $breastsensitivity "breastsensitivity" {
				min: 1, max: 4, step: 0.1, reverse: true,
				valueFormat: value => `<b>${round(value, 2)}</b> (${sensitivityString(value)})`
			}>>
			<<numberStepper "생식기 민감도" $genitalsensitivity "genitalsensitivity" {
				min: 1, max: 4, step: 0.1, reverse: true,
				valueFormat: value => `<b>${round(value, 2)}</b> (${sensitivityString(value)})`
			}>>
			<<numberStepper "엉덩이 민감도" $bottomsensitivity "bottomsensitivity" {
				min: 1, max: 4, step: 0.1, reverse: true,
				valueFormat: value => `<b>${round(value, 2)}</b> (${sensitivityString(value)})`
			}>>
		</div>
	</div>
	<<if $settings.parasitesEnabled>>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader options">기생충</div>
			<div class="settingsToggleItemWide">
				<<set _penis to $player.penisExist ? "penis" : "clit">>
				<div id="nipples"><<cheatParasiteToggle "nipples">></div>
				<div @id="_penis"><<cheatParasiteToggle _penis>></div>
				<div id="bottom"><<cheatParasiteToggle "bottom">></div>
				<div id="left_thigh"><<cheatParasiteToggle "left_thigh">></div>
				<div id="right_thigh"><<cheatParasiteToggle "right_thigh">></div>
				<div id="left_arm"><<cheatParasiteToggle "left_arm">></div>
				<div id="right_arm"><<cheatParasiteToggle "right_arm">></div>
				<div id="tummy"><<cheatParasiteToggle "tummy">></div>
				<<if playerIsPregnant() and $player.sex is "m" and numberOfEarSlime()>>
					<div class="red">남성으로 임신 중에는 귀 슬라임을 제거할 수 없습니다.</div>
				<<else>>
					<div id="left_ear"><<cheatParasiteToggle "left_ear">></div>
					<div id="right_ear"><<cheatParasiteToggle "right_ear">></div>
				<</if>>
			</div>
		</div>
	<</if>>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">체액</div>
		<<cheatBodyLiquid "semen">>
		<<cheatBodyLiquid "goo">>
		<<cheatBodyLiquid "nectar">>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">변신</div>
		<div class="settingsToggleItem">
			<span class="gold">변신 종류</span>
			<br>
			<span class="description">한 번에 동물 하나와 신성한 변신 하나만 가질 수 있습니다.</span>
			<br>
			<<tficon "angel">>천사: <<link "설정">><<clearDivineTransformations>><<angelTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<angelTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "fallenangel">>타락 천사: <<link "설정">><<clearDivineTransformations>><<set $specialTransform to 1>>
			<<set $fallenangel to 2>><<set $fallenangeltf to 1>><<set $transformationParts.fallenAngel.halo to ($transformationParts.angel.halo is "traditional" ? "traditional" : "default")>><<set $transformationParts.fallenAngel.wings to ($transformationParts.angel.wings is "classic" ? "classic" : "default")>><<updatesidebarimg>><</link>> | <<link "해제">><<fallenButNotOut 99>><<updatesidebarimg>><</link>><br>
			<<tficon "demon">>악마: <<link "설정">><<clearDivineTransformations>><<demonTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<demonTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "wolf">>늑대: <<link "설정">><<clearAnimalTransformations>><<wolfTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<wolfTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "cat">>고양이: <<link "설정">><<clearAnimalTransformations>><<catTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<catTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "cow">>젖소: <<link "설정">><<clearAnimalTransformations>><<cowTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<cowTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "bird">>새: <<link "설정">><<clearAnimalTransformations>><<harpyTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<harpyTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "fox">>여우: <<link "설정">><<clearAnimalTransformations>><<foxTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<foxTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "bear">>곰: <<link "설정">><<clearAnimalTransformations>><<bearTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<bearTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "waterdragon">>수룡: <<link "설정">><<clearAnimalTransformations>><<waterdragonTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<waterdragonTransform 99>><<updatesidebarimg>><</link>><br>
			<<tficon "bunny">>토끼: <<link "설정">><<clearAnimalTransformations>><<bunnyTransform>><<updatesidebarimg>><</link>> | <<link "해제">><<bunnyTransform 99>><<updatesidebarimg>><</link>><br>
		</div>
	<div class="settingsToggleItem">
		<span class="gold">변신 포인트</span>
		<br>
		<span class="description">천사와 고양이는 완전한 변신에 50포인트가 필요하며, 다른 변신들은 30포인트가 필요합니다. 타락 천사는 수용을 위해 30포인트가 필요합니다.</span>
		<<for _tf range ["angel", "fallenangel", "demon", "wolf", "cat", "cow", "bird", "fox", "bear", "waterdragon", "bunny"]>>
			<<capture _tf>>
				<<set _name to (_tf is "fallenangel" ? "Fallen Angel" : _tf)>>
				<<set _title to `<<tficon _tf>> ${toTitleCase(_name)}`>>
				<<set _varName to (_tf is "fallenangel" ? "fallenbuild" : `${_tf}build`)>>
				<<numberStepper _title `V[T.varName]` {
					callback: (value, arr) => {
						V[arr[0]] = value;
						Wikifier.wikifyEval("<<transformationAlteration>><<updatesidebarimg>>");
					},
					max: 100, percentage: false, colorArr: ["--teal", "--purple"], values: [T.varName]
				}>>
			<</capture>>
		<</for>>
		<<unset _cr>>
	</div>
<</widget>>

<<widget "cheatMenuEyesSelected">>
	<<set $leftEyeColour to $eyeselected>>
	<<set $rightEyeColour to $eyeselected>>
	<<updatesidebarimg>>
<</widget>>

<<widget "cheats-npcs">>
	<div class="settingsGrid">
		<div class="settingsHeader options">NPC 첫 경험</div>
		<div class="settingsToggleItemWide">
			NPC의 첫 경험을 기본값으로 재설정:
			<br>
			<<listbox "_npcId" autoselect>>
				<<optionsfrom Object.fromEntries($NPCNameList.map(id => [window.KR?.personNameDict?.[id] || id, id]))>>
			<</listbox>>
			<br><br>
			<<link "확인">>
				<<initNNPCVirginity $NPCNameList.indexOf(_npcId)>>
				<<if $npc.includes(_npcId)>>
					<<set $NPCList[$npcrow[$npc.indexOf(_npcId)]].virginity to C.npc[_npcId].virginity>>
				<</if>>
				<<for _virginType, _virginList range $virginTaken>>
					<<run _virginList.delete(_npcId)>>
				<</for>>
				<<replace "#npcvirgin">><br><<= _npcId>>의 첫 경험 상태가 복구되었습니다.<</replace>>
			<</link>>
			<span id="npcvirgin"></span>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">주요 인간관계</div>
		<div class="settingsToggleItem">
			<span class="gold">로빈</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Robin.love` { callback: value => { C.npc.Robin.love = value } }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Robin.lust` { callback: value => { C.npc.Robin.lust = value } }>>
			<<numberStepper "<<symbol confidence>> 자신감" `C.npc.Robin.dom` { callback: value => { C.npc.Robin.dom = value } }>>
			<<numberStepper "<<symbol trauma>> 트라우마" `C.npc.Robin.trauma` { callback: value => { C.npc.Robin.trauma = value }, reverse: true }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">휘트니</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Whitney.love` { callback: value => { C.npc.Whitney.love = value }, max: 30 }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Whitney.lust` { callback: value => { C.npc.Whitney.lust = value } }>>
			<<numberStepper "<<symbol dominance-whitney>> 지배욕" `C.npc.Whitney.dom` { callback: value => { C.npc.Whitney.dom = value }, max: 20 }>>
			|<<if ["dungeon", "pillory"].includes(C.npc.Whitney.state)>>
				<<link [[휘트니를 복귀시킨다|$passage]]>><<reclaimWhitney>><</link>> |
			<<else>>
				<<link [[휘트니를 퇴장시킨다|$passage]]>><<dismissWhitney>><</link>> |
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">에덴</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Eden.love` { callback: value => { C.npc.Eden.love = value }, max: 200 }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Eden.lust` { callback: value => { C.npc.Eden.lust = value } }>>
			<<numberStepper "<<symbol dominance>> 지배욕" `C.npc.Eden.dom` { callback: value => { C.npc.Eden.dom = value }, max: 150}>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">카일라</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Kylar.love` { callback: value => { C.npc.Kylar.love = value } }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Kylar.lust` { callback: value => { C.npc.Kylar.lust = value } }>>
			<<numberStepper "<<symbol jealousy>> 질투" `C.npc.Kylar.rage` { callback: value => { C.npc.Kylar.rage = value }, reverse: true }>>
			|<<if $kylar_mad isnot 1>>
				<<link [[납치 활성화|$passage]]>><<set $kylar_mad to 1>><</link>> |
			<<elseif $kylar_mad is 1>>
				<<link [[납치 비활성화|$passage]]>><<set $kylar_mad to 0>><</link>> |
			<</if>>
			<<if C.npc.Kylar.state is "prison">>
				<<link [[카일라를 복귀시킨다|$passage]]>><<reclaimKylar>><</link>> |
			<<elseif C.npc.Kylar.state is "active">>
				<<link [[카일라를 퇴장시킨다|$passage]]>><<dismissKylar>><</link>> |
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">에이버리</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Avery.love` { callback: value => { C.npc.Avery.love = value } }>>
			<<numberStepper "<<symbol rage>> 분노" `C.npc.Avery.rage` { callback: value => { C.npc.Avery.rage = value }, reverse: true }>>
			<<numberStepper "<<symbol dominance>> 지배욕" `C.npc.Avery.dom` { callback: value => { C.npc.Avery.dom = value } }>>
			<<if !$avery_mansion>>
				<<if C.npc.Avery.state is "dismissed">>
					| <<link [[에이버리를 복귀시킨다|$passage]]>><<unDismissAvery>><</link>> |
				<<elseif C.npc.Avery.state is "active">>
					| <<link [[에이버리를 퇴장시킨다|$passage]]>><<dismissAvery>><</link>> |
				<</if>>
			<<else>>
				<<if $avery_fate is undefined>>
					에이버리의 운명이 정해지지 않았습니다.
				<<else>>
					에이버리의 현재 상태: <<print $avery_fate>>
				<</if>>
				<br>

				<<linkreplace "에이버리의 운명을 고르십시오">>
					에이버리의 운명을 고르십시오:
					<br>
					<<if $avery_fate is "saved" or $avery_fate is "rescued">>
						<span class="gold">에이버리를 구한다 (현재)</span>
						<br>
					<<else>>
						<<link [[에이버리를 구한다|$passage]]>>
							<<set _previousAveryFate to $avery_fate>>
							<<set $avery_fate to "saved">>
							<<set C.npc.Remy.title to "scarred">>
							<<if _previousAveryFate is "ascended">>
								<<if $auriga_scar isnot undefined and $auriga_scar gte 1>>
									<<set $auriga_scar-->>
								<</if>>
								<<set C.npc.Avery.title to (C.npc.Avery.pronoun is "m" ? "businessman" : "businesswoman")>>
								<<set C.npc.Harper.title to "doctor">>
							<</if>>
							<<if $avery_mansion_fire_time gte 1>>
								<<set $avery_mansion_fire_time to 0>>
							<</if>>
							<<unDismissAvery>>
						<</link>>
						<br>
						이 선택은 <span class="lblue">'에이버리의 구원자' 특성을 부여합니다.</span>
						<<if $avery_fate is "ascended" and $auriga_scar isnot undefined and $auriga_scar gte 1>>
							<br>
							이 선택은<<if $auriga_scar is 1>> <span class="lblue">'엘크의 흉터' 특성을 제거합니다.</span><<else>> <span class="lblue">엘크 특성을 약화시킵니다.</span><</if>>
						<</if>>
						<br>
					<</if>>

					<<if $avery_fate is "ascended">>
						<span class="gold">에이버리를 승천시킨다 (현재)</span>
						<br>
					<<else>>
						<<link [[에이버리를 승천시킨다|$passage]]>>
							<<set _previousAveryFate to $avery_fate>>
							<<set $avery_fate to "ascended">>
							<<set C.npc.Avery.title to "crimson hound">>
							<<set C.npc.Harper.title to "silver fox">>
							<<set C.npc.Remy.title to "high elk">>
							<<if (_previousAveryFate is "rescued" or _previousAveryFate is "saved") and $avery_injury isnot undefined>>
								<<unset $avery_injury>>
							<</if>>
							<<if $auriga_scar is undefined>>
								<<set $auriga_scar to 0>>
							<</if>>
							<<set $auriga_scar++>>
							<<if $avery_mansion_fire_time gte 1>>
								<<set $avery_mansion_fire_time to 0>>
							<</if>>
							<<unDismissAvery>>
						<</link>>
						<br>
						이 선택은<<if $auriga_scar is undefined or $auriga_scar lte 0>> <span class="red">'엘크의 흉터' 특성을 부여합니다.</span><<else>> <span class="red">엘크 특성을 악화시킵니다.</span><</if>>
						<<if $avery_fate is "rescued" or $avery_fate is "saved">>
							<br>
							이 선택은 <span class="red">'에이버리의 구원자' 특성을 제거합니다.</span>
						<</if>>
						<br>
					<</if>>

					<<if $avery_fate is "fallen">>
						<span class="gold">에이버리를 타락하게 둔다 (현재)</span>
						<br>
					<<else>>
						<<link [[에이버리를 타락하게 둔다|$passage]]>>
							<<set _previousAveryFate to $avery_fate>>
							<<set $avery_fate to "fallen">>
							<<set C.npc.Remy.title to "scarred">>
							<<if (_previousAveryFate is "rescued" or _previousAveryFate is "saved") and $avery_injury isnot undefined>>
								<<unset $avery_injury>>
							<</if>>
							<<dismissAvery "hard">>
							<<if _previousAveryFate is "ascended">>
								<<if $auriga_scar isnot undefined and $auriga_scar gte 1>>
									<<set $auriga_scar-->>
								<</if>>
								<<set C.npc.Avery.title to (C.npc.Avery.pronoun is "m" ? "businessman" : "businesswoman")>>
								<<set C.npc.Harper.title to "doctor">>
							<</if>>
						<</link>>

						<<if $avery_fate is "ascended" and $auriga_scar isnot undefined and $auriga_scar gte 1>>
							<br>
							이 선택은<<if $auriga_scar is 1>> <span class="lblue">'엘크의 흉터' 특성을 제거합니다.</span><<else>> <span class="lblue">엘크 특성을 약화시킵니다.</span><</if>>
						<</if>>
						<<if $avery_fate is "rescued" or $avery_fate is "saved">>
							<br>
							이 선택은 <span class="red">'에이버리의 구원자' 특성을 제거합니다.</span>
						<</if>>
						<br>
					<</if>>

					<<if $avery_fate is "kicked">>
						<span class="gold">에이버리를 쫓아낸다 (현재)</span>
						<br>
					<<else>>
						<<link [[에이버리를 쫓아낸다|$passage]]>>
							<<set _previousAveryFate to $avery_fate>>
							<<set $avery_fate to "kicked">>
							<<set C.npc.Remy.title to "scarred">>
							<<if (_previousAveryFate is "rescued" or _previousAveryFate is "saved") and $avery_injury isnot undefined>>
								<<unset $avery_injury>>
							<</if>>
							<<dismissAvery "hard">>
							<<if _previousAveryFate is "ascended">>
								<<if $auriga_scar isnot undefined and $auriga_scar gte 1>>
									<<set $auriga_scar-->>
								<</if>>
								<<set C.npc.Avery.title to (C.npc.Avery.pronoun is "m" ? "businessman" : "businesswoman")>>
								<<set C.npc.Harper.title to "doctor">>
							<</if>>
						<</link>>

						<<if $avery_fate is "ascended" and $auriga_scar isnot undefined and $auriga_scar gte 1>>
							<br>
							이 선택은<<if $auriga_scar is 1>> <span class="lblue">'엘크의 흉터' 특성을 제거합니다.</span><<else>> <span class="lblue">엘크 특성을 약화시킵니다.</span><</if>>
						<</if>>
						<<if $avery_fate is "rescued" or $avery_fate is "saved">>
							<br>
							이 선택은 <span class="red">'에이버리의 구원자' 특성을 제거합니다.</span>
						<</if>>
						<br>
					<</if>>
				<</linkreplace>>
			<</if>>
		</div>

		<div class="settingsToggleItem">
			<span class="gold">알렉스</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Alex.love` { callback: value => { C.npc.Alex.love = value } }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Alex.lust` { callback: value => { C.npc.Alex.lust = value } }>>
			<<numberStepper "<<symbol dominance>> 지배욕" `C.npc.Alex.dom` { callback: value => { C.npc.Alex.dom = value }, min: -50 }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">거대 매</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc["Great Hawk"].love` { callback: value => { C.npc["Great Hawk"].love = value } }>>
			<<numberStepper "<<symbol dominance>> 지배욕" `C.npc["Great Hawk"].dom` { callback: value => { C.npc["Great Hawk"].dom = value } }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">검은 늑대</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc["Black Wolf"].love` { callback: value => { C.npc["Black Wolf"].love = value }, max: 150 }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">시드니</span>
			<<set _purity to C.npc.Sydney.purity gt 0 ? "purity" : "corruption">>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Sydney.love` { callback: value => { C.npc.Sydney.love = value }, max: 150 }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Sydney.lust` { callback: value => { C.npc.Sydney.lust = value } }>>
			<span id="sydneypurity">
				<<sydneyPurity>>
			</span>
			<span id="sydneydesc" class="description">
				시드니의 <<= _purity is "purity" ? "순결도를 0% 이하로" : "타락도를 0% 초과로">> 설정하면 <<= _purity is "purity" ? "타락" : "순결">> 상태로 변경됩니다.
			</span>
		</div>
		<<if modLISelected("Poppy")>><div class="settingsToggleItem">
			<span class="gold">포피</span>
			<<numberStepper "<<symbol love>> 애정" `C.npc.Poppy.love` { callback: value => { C.npc.Poppy.love = value }, max: 100 }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Poppy.lust` { callback: value => { C.npc.Poppy.lust = value }, max: 100 }>>
			<span id="poppytemper"><<poppyTemper>></span><span id="poppydesc" class="description"><<poppyTemperDesc>></span>
		</div><</if>>
		/* Gwylan's love is a calculated value and any change added here would not stick. */
		<<if $gwylanSeen?.includes("yearning")>>
			<div class="settingsToggleItem">
				<span class="gold">그윌란</span>
				<span id="gwylandesc" class="description">
					그윌란의 애정도는 여러 이벤트에서 합산되어 계산되므로, 치트로 임의 설정할 수 없습니다.
				</span>
				<<numberStepper "<<symbol lust>> 욕정" `C.npc.Gwylan.lust` { callback: value => { C.npc.Gwylan.lust = value } }>>
				<<numberStepper "<<symbol yearning>> 갈망" `C.npc.Gwylan.dom` { callback: value => { C.npc.Gwylan.dom = value }, max: 150 }>>
			</div>
		<</if>>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options"><span class="gold">베일리 확장</span></div>
		<<cheats-bailey>>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">관심 인물</div>
		<div class="settingsToggleItem">
			<span class="gold">메이슨</span>
			<<numberStepper "<<symbol love>> <<print setup.loveAlias.Mason()>>" `C.npc.Mason.love` { callback: value => { C.npc.Mason.love = value }, max: 50 }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Mason.lust` { callback: value => { C.npc.Mason.lust = value }, max: 100 }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">제퍼</span>
			<<numberStepper "<<symbol love>> <<print setup.loveAlias.Zephyr()>>" `C.npc.Zephyr.love` { callback: value => { C.npc.Zephyr.love = value } }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Zephyr.lust` { callback: value => { C.npc.Zephyr.lust = value }, max: 100 }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">퀸</span>
			<<numberStepper "<<symbol love>> 퀸 애정" `C.npc.Quinn.love` { callback: value => { C.npc.Quinn.love = value } }>>
			<<numberStepper "<<symbol lust>> 욕정" `C.npc.Quinn.lust` { callback: value => { C.npc.Quinn.lust = value }, max: 100 }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">모드 NPC</span>
			<<numberStepper "<<symbol love>> 라일리 <<print setup.loveAlias.라일리()>>" `(V.NPCName[V.NPCNameList.indexOf("라일리")]?.love ?? C.npc.라일리.love) * 2` { max: 100, callback: value => { const raw = Math.clamp(Math.round(value / 2), 0, 50); C.npc.라일리.love = raw; const npc = V.NPCName[V.NPCNameList.indexOf("라일리")]; if (npc) npc.love = raw;}}>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">교사들</span>
			<<numberStepper "<<symbol love>> 시리스 <<print setup.loveAlias.Sirris()>>" `C.npc.Sirris.love` { callback: value => { C.npc.Sirris.love = value } }>>
			<<numberStepper "<<symbol love>> 도렌 <<print setup.loveAlias.Doren()>>" `C.npc.Doren.love` { callback: value => { C.npc.Doren.love = value } }>>
			<<numberStepper "<<symbol love>> 레이튼 <<print setup.loveAlias.Leighton()>>" `C.npc.Leighton.love` { callback: value => { C.npc.Leighton.love = value } }>>
			<<numberStepper "<<symbol love>> 리버 <<print setup.loveAlias.River()>>" `C.npc.River.love` { callback: value => { C.npc.River.love = value }, max: 50 }>>
			<<numberStepper "<<symbol love>> 윈터 <<print setup.loveAlias.Winter()>>" `C.npc.Winter.love` { callback: value => { C.npc.Winter.love = value } }>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">기타 네임드 NPC</span>
			<<numberStepper "<<symbol love>> 브라이어 <<print setup.loveAlias.Briar()>>" `C.npc.Briar.love` { callback: value => { C.npc.Briar.love = value } }>>
			<<numberStepper "<<symbol love>> 찰리 <<print setup.loveAlias.Charlie()>>" `C.npc.Charlie.love` { callback: value => { C.npc.Charlie.love = value }, max: 50 }>>
			<<numberStepper "<<symbol love>> 데릴 <<print setup.loveAlias.Darryl()>>" `C.npc.Darryl.love` { callback: value => { C.npc.Darryl.love = value }, max: 50 }>>
			<<numberStepper "<<symbol love>> 하퍼 <<print setup.loveAlias.Harper()>>" `C.npc.Harper.love` { callback: value => { C.npc.Harper.love = value } }>>
			<<numberStepper "<<symbol love>> 모건 <<print setup.loveAlias.Morgan()>>" `C.npc.Morgan.love` { callback: value => { C.npc.Morgan.love = value } }>>
			<<numberStepper "<<symbol love>> 니키 <<print setup.loveAlias.Niki()>>" `C.npc.Niki.love` { callback: value => { C.npc.Niki.love = value } }>>
			<<numberStepper "<<symbol love>> 레미 <<print setup.loveAlias.Remy()>>" `C.npc.Remy.love` { callback: value => { C.npc.Remy.love = value } }>>
			<<numberStepper "<<symbol love>> 샘 <<print setup.loveAlias.Sam()>>" `C.npc.Sam.love` { callback: value => { C.npc.Sam.love = value }, max: 50 }>>
			<<numberStepper "<<symbol love>> 렌 <<print setup.loveAlias.Wren()>>" `C.npc.Wren.love` { callback: value => { C.npc.Wren.love = value }, max: 50 }>>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">희망 없는 순환</div>
		<<if $hc>>
			<div class="settingsToggleItemWide">
				<span class="gold">핸드의 의심</span>
				<br>
				<span class="description">포로로 잡은 자(핸드)가 당신을 얼마나 의심하는지를 나타냅니다. 몰래 움직이거나, 훔치거나, 건드린 흔적을 남기면 오르며, 100에 이르면 의심 엔딩이 발동합니다.</span>
				<br>|
				<<link "0으로 설정" $passage>><<set $hc.suspicion to 0>><<set $cheatReload to true>><</link>> |
				<<link "100으로 설정" $passage>><<set $hc.suspicion to 100>><<set $cheatReload to true>><</link>> |
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">마녀를 사랑함</span>
				<br>
				<span class="description">피의 사건에서 동료 죄수(마녀)를 살려 주고 사랑하기로 했는지 여부입니다. <<worldFemale '그녀의' '그의'>> 유대와 고유 엔딩을 좌우합니다.</span>
				<br>|
				<<link "사랑함으로 설정" $passage>><<set $hc.loved to true>><<set $cheatReload to true>><</link>> |
				<<link "사랑하지 않음으로 설정" $passage>><<set $hc.loved to false>><<set $cheatReload to true>><</link>> |
			</div>
		<<else>>
			<div class="settingsToggleItemWide grey">희망 없는 순환(뱀 그림의 지하 감옥) 안에 있을 때만 사용할 수 있습니다.</div>
		<</if>>
	</div>
		<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">평판</div>
		<<if $farm_stage gte 2>>
			<div class="settingsToggleItem">
				<<farmicon>><span class="gold">농장 상태</span>
				<<numberStepper "말의 존중" `V.farm.beasts.horses` { callback: value => { V.farm.beasts.horses = value }, min: -30, max: 30 }>>
				<<numberStepper "돼지의 존중" `V.farm.beasts.pigs` { callback: value => { V.farm.beasts.pigs = value }, min: -30, max: 30}>>
				<<numberStepper "소의 존중" `V.farm.beasts.cattle` { callback: value => { V.farm.beasts.cattle = value }, min: -30, max: 30 }>>
				<<numberStepper "개의 존중" `V.farm.beasts.dogs` { callback: value => { V.farm.beasts.dogs = value }, min: -30, max: 30 }>>
			</div>
			<div class="settingsToggleItem">
				<<farmicon>><span class="gold">농장 진행도</span>
				<br>
				<<if $farm_stage gte 12>>
					모든 밭을 <span class="green">개간했습니다</span>.
				<<else>>
					<span id="farmYard"><<cheatsRep "farm">></span>
				<</if>>
				<<if $farm_stage gte 5>>
					<hr>
					<<numberStepper "레미의 위협도" `V.farm.aggro` { reverse: true, callback: value => { V.farm.aggro = value; Wikifier.wikifyEval("<<replace #farmAggro>><<cheatsRep aggro>><</replace>>") } }>>
					<span id="farmAggro"><<cheatsRep "aggro">></span>
				<</if>>
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<<wolfcaveicon "pup">><span class="gold">늑대 무리</span>
			<br>
			<<if $syndromewolves is 1>>
				지위: <span id="wolfpackleader"><<cheatsRep "wolfpackleader">></span>
			<</if>>
			<<numberStepper "신뢰" $wolfpacktrust "wolfpacktrust" {max: 30}>>
			<<numberStepper "공포" $wolfpackfear "wolfpackfear" {max: 30}>>
			<<if $syndromewolves is 1>>
				<<numberStepper "조화" $wolfpackharmony "wolfpackharmony" {max: 20}>>
				<<numberStepper "흉포함" $wolfpackferocity "wolfpackferocity" {max: 20}>>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<<schoolicon "building">><span class="gold">학교</span>
			<<numberStepper "지위" $cool "cool" {max: V.coolmax}>>
			<<numberStepper "비행도" $delinquency "delinquency" {max: 1000, reverse: true}>>
			<hr>
			<<if $player.penisExist and $player.vaginaExist>>
				<<numberStepper "성기 소문" $schoolrep.herm { callback: value => {V.schoolrep.herm = value; Wikifier.wikifyEval("<<replace '#repherm'>><<cheatsRep herm>><</replace>>")}, max: 5, step: 1, percentage: false, reverse: true, activeButtons: ["single", "minMax"] }>>
				<span id="repherm"><<cheatsRep "herm">></span>
			<<else>>
				<<numberStepper "여장/남장 소문" $schoolrep.crossdress { callback: value => {V.schoolrep.crossdress = value; Wikifier.wikifyEval("<<replace '#repcrossdress'>><<cheatsRep crossdress>><</replace>>")}, max: 5, step: 1, percentage: false, reverse: true, activeButtons: ["single", "minMax"] }>>
				<span id="repcrossdress"><<cheatsRep "crossdress">></span>
			<</if>>
		</div>
		<<if ["asylum", "prison"].includes($location)>>
			<div class="settingsToggleItem">
				<<if $location is "asylum">>
					<<asylumicon "cell">><span class="gold">정신병원</span>
					<<numberStepper "지위" $asylumstatus "asylumstatus">>
					<<numberStepper "의심" $asylumsuspicion "asylumsuspicion">>
				<<elseif $location is "prison">>
					<<policeicon>><span class="gold">감옥</span>
					<<numberStepper "경비원" $prison.guards { callback: value => { V.prison.guards = value } }>>
					<<numberStepper "수감자" $prison.inmates { callback: value => { V.prison.inmates = value } }>>
					<<numberStepper "수감자 희망" $prison.hope { callback: value => { V.prison.hope = value } }>>
					<<numberStepper "수감자 반란" $prison.reb { callback: value => { V.prison.reb = value } }>>
					<<numberStepper "감시자 우호도" $prison.watchers_friend { callback: value => { V.prison.watchers_friend = value } }>>
				<</if>>
			</div>
		<</if>>
		<<if $docks and $docks.hired>>
			<div class="settingsToggleItem">
				<<docksicon>><span class="gold">부두</span>
				<<numberStepper "지위" $docks.status { callback: value => { V.docks.status = value } }>>
			</div>
		<</if>>
		<<if $pirate_rank gte 0>>
			<div class="settingsToggleItem">
				<<mericon>><span class="gold">해적</span>
				<br>
				지위: <span id="pirate_rank"><<cheatsRep "pirate_rank">></span>
				<<numberStepper "지위" $pirate_status "pirate_status">>
			</div>
		<</if>>
		<<if $pound>>
			<div class="settingsToggleItem">
				<<poundicon>><span class="gold">유기동물 보호소</span>
				<<numberStepper "지위" $pound.status { callback: value => { V.pound.status = value } }>>
				<<numberStepper "유기동물 만족도" $stray_happiness "stray_happiness">>
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<<homeicon>><span class="gold">고아원</span>
			<<numberStepper "희망" $orphan_hope "orphan_hope" {max: 50}>>
			<<numberStepper "반항심" $orphan_reb "orphan_reb" {max: 50}>>
		</div>
	</div>
<</widget>>

<<widget "sydneyPurity">>
	<<if C.npc.Sydney.purity gt 0>>
		<<numberStepper "<<symbol purity>> 순결도" `C.npc.Sydney.purity` {
			callback: value => {
				C.npc.Sydney.purity = value;
				if (value < 0) {
					C.npc.Sydney.corruption = Math.abs(value);
					value = 0;
					Wikifier.wikifyEval("<<replace '#sydneypurity'>><<sydneyPurity>><</replace>>");
				}
			},
			min: -100, max: 100, step: 1, percentage: false,
			valueFormat: value => `<b>${value}%</b>`
		}>>
	<<else>>
		<<numberStepper "<<symbol corruption>> 타락도" `C.npc.Sydney.corruption` {
			callback: value => {
				C.npc.Sydney.corruption = value;
				if (value < 0) {
					C.npc.Sydney.purity = Math.abs(value);
					value = 0;
					Wikifier.wikifyEval("<<replace '#sydneypurity'>><<sydneyPurity>><</replace>>");
				}
			},
			min: -100, max: 50, step: 1, percentage: false, reverse: true, reverseButtons: true,
			valueFormat: value => `<b>${value*2}%</b>`
		}>>
	<</if>>
<</widget>>

<<widget "cheatsRep">>
	<<switch _args[0]>>
		<<case "aggro">>
			<<if $farm.aggro gte 100>>
				<span class="red">레미의 패거리들이 대놓고 활동하며, 농장과 사업을 노골적으로 방해하고 있습니다.</span>
			<<elseif $farm.aggro gte 60>>
				<span class="pink">농장이 밤낮으로 방해를 받고 있습니다.</span>
			<<elseif $farm.aggro gte 40>>
				<span class="purple">농장이 밤마다 방해를 받고 있습니다.</span>
			<<elseif $farm.aggro gte 20>>
				<span class="blue">무언가가 농장 동물들을 겁주고 있습니다.</span>
			<<elseif $farm.aggro gte 10>>
				<span class="lblue">농장 주변에서 무단 침입의 흔적이 발견되었습니다.</span>
			<<elseif $farm.aggro gte 1>>
				<span class="teal">낯선 사람들이 농장을 지켜보는 것이 목격되었습니다.</span>
			<<else>>
				<span class="green">농장은 평화롭습니다.</span>
			<</if>>
		<<case "farm">>
			<<if $farm_stage lt 12>>
				<<set _clearing to (100 - $farm.clearing)>>
				<<set _percent=Math.floor((_clearing/100)*100)>>
				밭 중 하나가 개간 중입니다,
				<<if $farm.clearing lte 0>>
					<span class="green">식물을 심을 준비가 되었습니다!</span>
					<div class="meter">
					<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 20>>
					<span class="teal">식물을 심을 준비가 거의 끝났습니다.</span>
					<div class="meter">
					<<print '<div class="tealbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 40>>
					<span class="lblue">그리고 사람의 손길이 닿은 태가 나기 시작합니다.</span>
					<div class="meter">
					<<print '<div class="lbluebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 60>>
					<span class="blue">그리고 곳곳에 흙이 드러났습니다.</span>
					<div class="meter">
					<<print '<div class="bluebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 80>>
					<span class="purple">하지만 여전히 덤불이 무성합니다.</span>
					<div class="meter">
					<<print '<div class="purplebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 99>>
					<span class="pink">하지만 거의 진전이 없습니다.</span>
					<div class="meter">
					<<print '<div class="pinkbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<else>>
					<span class="red">하지만 잡초가 정글처럼 우거져 있습니다.</span>
					<div class="meter">
					<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<</if>>
				<br>
			<<elseif $farm.waterField is 1 and !$farm.build_finished.includes("water field 2")>>
				<<set _clearing to (1200 - $farm.clearing)>>
				<<set _percent=Math.floor((_clearing/1200)*100)>>
				수경지를 굴착하고 모양을 잡는 중입니다.
				<<if $farm.clearing lte 0>>
					<span class="green">다음 단계로 넘어갈 준비가 되었습니다!</span>
					<div class="meter">
					<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 240>>
					<span class="teal">거의 다 파냈습니다.</span>
					<div class="meter">
					<<print '<div class="tealbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 480>>
					<span class="lblue">상당한 진전이 있었습니다.</span>
					<div class="meter">
					<<print '<div class="lbluebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 720>>
					<span class="blue">굴착이 한창 진행 중입니다.</span>
					<div class="meter">
					<<print '<div class="bluebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 960>>
					<span class="purple">하지만 아직 옮겨야 할 흙이 많습니다.</span>
					<div class="meter">
					<<print '<div class="purplebar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<elseif $farm.clearing lte 1199>>
					<span class="pink">하지만 진행이 더딥니다.</span>
					<div class="meter">
					<<print '<div class="pinkbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<<else>>
					<span class="red">하지만 현장은 아직 손도 대지 않았습니다.</span>
					<div class="meter">
					<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
					</div>
				<</if>>
				<br>
			<</if>>
			<<if $farm.clearing gt 0>>
				| <<farmicon "clear yard">><<link "밭 개간하기">><<set $farm.clearing to 0>><<replace "#farmYard">><<cheatsRep "farm">><</replace>><</link>>
			<<else>>
				<span class="green">알렉스와 대화하여 농장 진행도를 올리십시오.</span>
			<</if>>
		<<case "crossdress">>
			<<set _crossdressing to $player.gender isnot $player.sex ? "여장/남장 의혹" : "여장/남장">>
			<<set _knows to $player.gender isnot $player.sex ? "사실이라고 믿고 있습니다" : "알고 있습니다">>
			<<switch $schoolrep.crossdress>>
				<<case 5>><span class="red">당신의 <<= _crossdressing>>【은는】 학교에 공공연하게 알려졌습니다. 선생님을 포함해 모든 사람이 당신의 비밀을 <<= _knows>>.</span>
				<<case 4>><span class="pink">당신의 <<= _crossdressing>>에 대한 소문이 학교 전체에 퍼지고 있습니다.</span>
				<<case 3>><span class="purple">당신의 <<= _crossdressing>>에 대한 소문이 퍼지면서 학교에서 인기 있는 화젯거리가 되었습니다.</span>
				<<case 2>><span class="blue">당신의 _crossdressing 에 대한 이야기가 학교에 은밀하게 떠돌고 있습니다.</span>
				<<case 1>><span class="lblue">학교의 몇몇 무리에서 당신의 <<= _crossdressing>>에 대해 수군대기 시작했습니다.</span>
				<<default>><span class="green">학교에서 당신에 대한 소문은 전혀 없습니다.</span>
			<</switch>>
		<<case "herm">>
			<<switch $schoolrep.herm>>
				<<case 5>><span class="red">선생님들을 포함해, 학교의 모든 사람이 당신의 독특한 성기에 대해 알고 있습니다.</span>
				<<case 4>><span class="pink">당신의 독특한 성기에 대한 소문이 학교 전체에 퍼졌습니다.</span>
				<<case 3>><span class="purple">다들 반신반의하고는 있지만, 남성과 여성의 부위를 모두 가진 학생이 있다는 뒷이야기가 학교에 무성합니다.</span>
				<<case 2>><span class="blue">남성과 여성의 부위를 모두 가진 학생이 있다는 소문이 학교에 떠돌고 있습니다.</span>
				<<case 1>><span class="lblue">학교의 몇몇 무리에서 남성과 여성의 부위를 모두 가진 학생에 대해 수군대기 시작했습니다.</span>
				<<default>><span class="green">학교에서 당신에 대한 소문은 전혀 없습니다.</span>
			<</switch>>
		<<case "wolfpackleader" "pirate_rank">>
			<<set _ranks to _args[0] is "pirate_rank" ? {0: "쓰레기", 1: "선원"} : {0: "무리 동료", 1: "무리 우두머리"}>>
			<<capture _i, _ranks>>
				<<for _i to 0; _i lt Object.keys(_ranks).length; _i++>>
					<span @class="V[_args[0]] is _i ? 'goldLink' : 'unselected'">
						<<link _ranks[_i]>>
							<<set V[_args[0]] to _i>>
							<<replace `"#" + _args[0]`>><<cheatsRep _args[0]>><</replace>>
						<</link>>
					</span>
					<<= _i < Object.keys(_ranks).length - 1 ? "|" : "">>
				<</for>>
			<</capture>>
		<<default>>
	<</switch>>
<</widget>>

<<widget "cheats-teleport">>
	<div class="settingsGrid">
		<div class="settingsHeader options">순간이동</div>
		<<if ["Clothing Shop", "Forest Shop", "School Library Shop", "Adult Shop Store"].includes($passage)>>
			<div class="settingsToggleItemWide">
				<span class="red">옷가게에서 순간이동하면 옷장이 고장 날 수 있습니다.</span> 순간이동하기 전에 상점을 나가십시오.
			</div>
		<<elseif ["Livestock Field"].includes($passage)>>
			<div class="settingsToggleItemWide">
				<span class="red">배드 엔딩에서 순간이동하면 여러 문제가 발생할 수 있습니다.</span> 순간이동하기 전에 탈출하십시오.
			</div>
		<<elseif setup.majorAreas.includes($passage) and $event is undefined>>
			<div class="settingsToggleItemWide">
			<b>일반 필드가 아닌 다른 곳에서 순간이동하면 버그가 발생할 수 있습니다.</b>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">도시 건물</span>
				<br>
				<<homeicon>><<link [[고아원|Orphanage]]>><<cheats-teleport-function>><</link>>
				<br>
