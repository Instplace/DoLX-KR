				<<compoundicon>><<link [[엘크 가의 단지|Elk Compound]]>><<cheats-teleport-function>><</link>><br>
				<<asylumicon  "cell">><<link [[정신병원|Asylum Cell]]>><<cheats-teleport-function>><</link>><br>
				<<if $waterDragonLab and $waterDragonLab.active>>
					<<hospitalicon>><<link [[연구소 실험|Water Dragon Lab]]>><<cheats-teleport-function>><</link>><br>
				<<else>>
					<<hospitalicon>><<link [[연구소 실험|Water Dragon Lab Intro]]>><<cheats-teleport-function>><</link>><br>
				<</if>>
				<<icon "avery_dungeon.png">><<link [[지하 창관|Underground Cell]]>><<if not $undergroundbrothel?.active>><<set $undergroundbrothel to {"active": true, "time": 0, "timepass": true, "water": 0, "escape": 0}>><</if>><<cheats-teleport-function>><</link>><br>
				<<if $livestock.intro isnot true>>
					<<icon "grass.png">><<link [[지하 농장|Livestock Intro]]>><<cheats-teleport-function>><</link>><br>
				<<else>>
					<<icon "grass.png">><<link [[지하 농장|Livestock Cell]]>><<cheats-teleport-function>><</link>><br>
				<</if>>
				<<icon "hookah_smoke.png">><<link [[촉수 평원|Tentacle Plains]]>><<cheats-teleport-function>><</link>><br>
				<<icon "vent_eyes.png">><<link [[밤의 괴물 소굴|Monster Tower]]>><<cheats-teleport-function>><</link>><br>
				<<birdicon "tower">><<link [[거대 매의 탑|Bird Tower]]>><<cheats-teleport-function>><</link>><br>
				<<prisonicon "cell">><<link [[감옥 독방|Prison Cell]]>><<prison_init>><<set $prison.time to Math.trunc(crimeSumCurrent() / 250)>><<crimeClear "all">><<if $prison_intro isnot 1>><<generate_relaxed_guard 0>><<generate_anxious_guard 1>><<generate_veteran_guard 2>><<generate_methodical_guard 3>><<generate_scarred_inmate 4>><<generate_tattooed_inmate 5>><<set $prison_intro to 1>><</if>><<cheats-teleport-function>><</link>><br>
			</div>
		<<else>>
			<div class="settingsToggleItemWide">
				<span class="red">현재 순간이동 시 세이브 파일이 망가지거나 이벤트가 진행 중인 지역에 있습니다.</span> 순간이동하기 전에 일반 필드로 돌아가십시오.
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "cheats-teleport-function">>
	<<silently>><<endevent>><<endcombat>><</silently>>
	<<if $waterDragonLab and $waterDragonLab.active>><<waterDragonLabCleanup false>><</if>>
	<<set _lastBadEnd to $badEndStats.last()>>
	<<if _lastBadEnd?.trackedStart and _lastBadEnd.trackedEnd is undefined>>
		<<badEndTrackingEnd _lastBadEnd.source { reason: "teleportCheater" }>>
	<</if>>
	<<if $waterdragonJourneyDay>>
		<<set $waterdragonJourneyDay to 0>>
	<</if>>
	<<run Menagerie.returnHome()>>
	<<if $passage is "Island" or $passage.startsWith("Island ") or $location is "island">>
		<<island_end>>
	<</if>>
	<<switch $passage>>
		<<case "Underground Cell">>
			<<dungeonescape>>
		<<case "Asylum" "Asylum Cell">>
			<<asylumescape>>
		<<case "Prison Cell">>
			<<prison_bondage_removal>>
	<</switch>>
<</widget>>

<<widget "cheats-other">>
	<div class="settingsGrid">
		<div class="settingsHeader options">시간과 날씨</div>
		<div class="settingsToggleItem">
			<span class="gold">시간 진행:</span>
			<br>
			<<link [[15분|$passage]]>><<pass 15>><</link>>
			<br>
			<<link [[30분|$passage]]>><<pass 30>><</link>>
			<br>
			<<for _i, _hr range [1, 2, 3, 6, 8, 12, 16, 24]>>
				<<capture _hr>>
					<<= _i gt 0 ? "<br>" : "">>
					<<set _hours to _hr + "시간">>
					<<link [[_hr _hours|$passage]]>>
						<<set $timeSkip to 1>>
						<<set _days to Math.floor(_hr / 24)>>
						<<set _remHours to _hr % 24>>
						<<if _days gt 0>>
							<<for _j to 0; _j lt _days; _j++>>
								<<pass 1 day>>
							<</for>>
						<</if>>
						<<if _remHours gt 0>>
							<<pass _remHours hour>>
						<</if>>
						<<unset $timeSkip>>
					<</link>>
					/* <<= _i lt 7 ? "<br>" : "">> */
				<</capture>>
			<</for>>
			<br>
			<<for _i, _dy range [2, 3, 4, 5, 6, 7, 14, 28]>>
				<<capture _dy, _i>>
					<<link [[_dy + "일"|$passage]]>>
						<<set $timeSkip to 1>>
						<<for _j to 0; _j lt _dy; _j++>>
							<<pass 1 day>>
						<</for>>
						<<unset $timeSkip>>
					<</link>>
					<<= _i lt 7 ? "<br>" : "">>
				<</capture>>
			<</for>>
			<hr>

			<<foldout false "_cheatsExpiredHistoryFoldout">>
				<span class="grey">만료된 패시지:</span>
				<<set _cheatsHistoryPassageTitles to State.expired>>
				<<for _i to 0; _i lt _cheatsHistoryPassageTitles.length; _i++>>
					<<= _i gt 0 ? "<br>" : "">>
					<<print (_i - _cheatsHistoryPassageTitles.length) + ':\t'>>
					<span class="grey"><<print _cheatsHistoryPassageTitles[_i]>></span>
				<</for>>
			<</foldout>>

			<<foldout false "_cheatsHistoryNavigationFoldout">>
				<span class="gold">현재 패시지: """[[""" <<print $passage>> """]]"""</span>
				<<set _cheatsHistoryPassageTitles to State.history.map((e) => e.title)>>
				<<for _i to 0; _i lt _cheatsHistoryPassageTitles.length; _i++>>
					<<= _i gt 0 ? "<br>" : "">>
					<<print _i + ':\t'>>
					<<if _i === State.activeIndex>>
						<span class="gold"><<print _cheatsHistoryPassageTitles[_i]>></span>
					<<else>>
						<<capture _i>>
							<<link _cheatsHistoryPassageTitles[_i]>><<cheatsHistoryNavigation _i true>><</link>>
						<</capture>>
					<</if>>
				<</for>>
			<</foldout>>

			<<link "뒤로">><<cheatsHistoryNavigation `State.activeIndex - 1` true>><</link>> |
			<<link "앞으로">><<cheatsHistoryNavigation `State.activeIndex + 1` true>><</link>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">현재 날씨:</span>
			<br>
			<span id="cheatsWeather"><<cheatsWeather>></span>
			<br>
			<br>
			<<cheatsFog>>
			<span class="description">이 설정을 변경하면 최소 6시간 동안 날씨가 변경되며, 이후 원래 날씨 시뮬레이션으로 돌아갑니다.</span>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">온도</span>
			<br>
			<span class="description">기본 온도를 다음 날까지 올리거나 내립니다. 이후 시간이 지남에 따라 점진적으로 원래 온도로 돌아갑니다.<br>
			기본 온도는 시간대 등 다른 요인의 영향을 계속 받으며, 하루 종일 일정하게 유지되지는 않습니다.</span>
			<<numberStepper "외부 온도" `Weather.toSelected(Weather.temperature)` {
				callback: value => {
					Weather.Temperature.set(V.options.fahrenheit ? Weather.Temperature.toCelsius(value) : value);
					Weather.Temperature.set(V.options.fahrenheit ? Weather.Temperature.toCelsius(value) : value, new DateTime(Time.date).addDays(1));
				},
				min: -60, max: 60, step: 0.1, colorArr: ["--blue", "--teal", "--yellow", "--orange", "--red"], percentage: false,
				valueFormat: value => round(value, 1) + (V.options.fahrenheit ? "°F" : "°C"),
				activeButtons: ["single", "double", "triple"]
			}>>
			<span class="description">게임 시간으로 최소 1분이 지나면 변경 사항이 표시됩니다.</span>
		</div>
	</div>

	<div class="settingsGrid">
		<div class="settingsHeader options">농사와 요리</div>
		<div class="settingsToggleItem">
			<span class="gold">🌱 씨앗</span><br>
			<<link [[모든 씨앗 해금|$passage]]>><<set $cheatReload to true>><<run unlockAllSeeds()>><</link>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">📖 조리법</span><br>
			<<link [[모든 조리법 해금|$passage]]>><<set $cheatReload to true>><<learn_recipe_all>><</link>>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">🥕 재료</span><br>
			<<link [[모든 재료 100개 얻기|$passage]]>><<set $cheatReload to true>>
				<<for _ingredient range Object.keys(setup.foodstuff)>>
					<<set $foodstuff[_ingredient].amount += 100>>
				<</for>>
			<</link>>
		</div>
	</div>

	<div class="settingsGrid">
		<div class="settingsHeader options">거대 매의 탑</div>
		<<if $bird and $bird.materials>>
			<div class="settingsToggleItem">
				<span class="gold">🪵 자재</span><br>
				<<link [[탑 자재 100개 얻기|$passage]]>><<set $cheatReload to true>>
					<<for _birdMat range ["wood", "fabric", "sticks", "leaves", "junk", "lurkers", "leather", "feathers"]>>
						<<set $bird.materials[_birdMat] += 100>>
					<</for>>
				<</link>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">💎 귀중품</span><br>
				<<link [[탑 귀중품 20개 얻기|$passage]]>><<set $cheatReload to true>>
					<<set $bird.materials.valuables ||= {}>>
					<<for _birdVal range ["bracelet", "wallet", "ring", "watch", "necklace", "antique bullet"]>>
						<<set $bird.materials.valuables[_birdVal] ||= 0>>
						<<set $bird.materials.valuables[_birdVal] += 20>>
					<</for>>
				<</link>>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">🗼 탑 진행</span><br>
				<<link [[탑 즉시 완성|$passage]]>><<set $cheatReload to true>>
					<<run Object.assign($bird.upgrades, {
						mirror: 1, tools: 1, tarp: 1, telescope: 1,
						shelter: 3, nest: 3, firepit: 3, pot: 3,
						rack: 3, snare: 1, decor: 4, wardrobe: 1
					})>>
					<<run Object.assign($bird.hunts, {
						unlocked: true, lurkers: true, materials: true, valuables: true, estate: "unlocked"
					})>>
					<<if $bird.firepit>><<run upgradeBirdFirepit()>><</if>>
				<</link>>
				| <span class="description">전설의 전리품 이벤트를 계속 열어 둡니다.</span>
			</div>
		<<else>>
			<div class="settingsToggleItemWide grey">거대 매의 탑 이야기를 진행하면 이 치트가 해금됩니다.</div>
		<</if>>
	</div>

	<div class="settingsGrid">
		<div class="settingsHeader options">학교 수영장</div>
		<<numberStepper "🏊 알몸 수영 횟수" $swimnudecounter {callback: value => V.swimnudecounter = value, min: 0, max: 100, step: 1, percentage: false}>>
		<span class="description">10을 넘으면 레이튼의 알몸 수영 벌칙 이벤트가 발동합니다.</span>
	</div>

	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">임신</div>
			<<if !$settings.parasitePregnancyEnabled>>
				<div class="settingsToggleItemWide">
					<span class="gold">기생충 임신</span>
					<br>
					이 치트에 접근하려면 설정에서 기생충 임신을 활성화해야 합니다.
				</div>
			<<else>>
				<div @class="$player.vaginaExist ? 'settingsToggleItem' : 'settingsToggleItemWide'">
					<<if $sexStats.anus.pregnancy.type is "parasite" or $sexStats.anus.pregnancy.type is null>>
						<div id="cheatsParasiteOptions-anus"><<cheatsParasiteOptions "anus">></div>
					<<else>>
						<span class="gold">애널 기생충 임신</span>
						<br>
						현재 <<= window.KR.getBeastTypeKr($sexStats.anus.pregnancy.type)>> 아이를 임신 중이므로 애널 기생충을 임신할 수 없습니다.
					<</if>>
				</div>
				<<if $player.vaginaExist>>
					<div class="settingsToggleItem">
						<<if ($sexStats.vagina.pregnancy.type is "parasite" or $sexStats.vagina.pregnancy.type is null)>>
							<div id="cheatsParasiteOptions-vagina"><<cheatsParasiteOptions "vagina">></div>
						<<elseif !($sexStats.vagina.pregnancy.type is "parasite" or $sexStats.vagina.pregnancy.type is null)>>
							<span class="gold">질 기생충 임신</span>
							<br>
							현재 <<= window.KR.getBeastTypeKr($sexStats.vagina.pregnancy.type)>> 아이를 임신 중이므로 질 기생충을 임신할 수 없습니다.
						<</if>>
					</div>
				<</if>>
			<</if>>
		<<if ($settings.playerPregnancyBeastEnabled or $settings.playerPregnancyHumanEnabled)>>
			<div class="settingsToggleItem" id="cheatsPregnancyOptions">
				<<cheatsPregnancyOptions>>
			</div>
			<div class="settingsToggleItem" id="cheatsImpregOptions">
				<<cheatsImpregOptions>>
			</div>
		<<else>>
			<div class="settingsToggleItem">
				<span class="gold">일반 임신 (기생충 아님)</span>
				<br>
				이 치트에 접근하려면 설정에서 임신을 활성화해야 합니다.
			</div>
			<div class="settingsToggleItem">
				<span class="gold">수정</span>
				<br>
				이 치트에 접근하려면 설정에서 임신을 활성화해야 합니다.
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "cheatsHistoryNavigation">>
	<<if typeof _args[0] is "number">>
		<<if !(_args[1] === true) or State.history[_args[0]]?.title === "Start">>
			<<run Engine.goTo(_args[0])>>
			<<exit>>
		<</if>>
		<<set setup.cheatsHistoryNavigation to {offsetY: $("#customOverlayContent").scrollTop() || 0}>>
		<<run Engine.goTo(_args[0])>>
		<<overlayReplace "cheats">>
		<<replace #cheatsShown>><<cheats-other>><</replace>>
		<<run $("#customOverlayContent").scrollTop(setup.cheatsHistoryNavigation.offsetY)>>
		<<set delete setup.cheatsHistoryNavigation>>
	<</if>>
<</widget>>

<<widget "cheatsParasiteOptions">>
    <<capture _args, _anal, _type>>
        <<set $_pregnancy to $sexStats[_args[0]].pregnancy>>
        <<set _anal to _args[0] is "anus" ? "애널" : "질">>
        <<set _slots to maxParasites(_args[0])>>
        <<set $_aPregnancy to $sexStats[_args[0]].pregnancy>>
        <<set _parasiteTypes to ["eels", "slimes", "fish", "snake", "worms", "tentacle", "lurker", "wasp", "bee", "squid", "vine", "slug", "maggots", "spiders"]>>
        <<set $_linkName to "현재 " + (_args[0] is "anus" ? "애널" : "질") + " 기생충 임신 삭제">>

		<span class="gold"><<= (_args[0] is "anus" ? "애널" : "질")>> 기생충 임신</span>
		<br>
		최대 <<number _slots>>마리의 <<=_anal>> 기생충을 수용할 수 있습니다.
		<<if $_pregnancy.fetus.length lt maxParasites(_args[0])>>
			<br><br>
			<<if $_aPregnancy.type is "parasite" or $_aPregnancy.type is null>>
				임신시킬 기생충:
				<br>
				<<for _i, _type range _parasiteTypes>>
					<<set _parasiteName to window.KR.getCreatureTypeKr(_type.endsWith('s') ? _type.slice(0, -1) : _type)>>
					<<link _parasiteName>>
						<<impregnateParasite _type true _args[0]>><<cheatsParasite _args[0] _hermaphrodite>>
						<<set _hermaphrodite to false>>
					<</link>>
					<<= _i lt _parasiteTypes.length - 1 ? "|" : "">>
				<</for>>
				<br>
				<<if $_pregnancy.motherStatus lt 2>>
					<label><<checkbox "_hermaphrodite" false true autocheck>> 후타나리</label>
				<<else>>
					당신의 <<=_args[0] is "anus" ? "항문" : "질">>에는 한 번에 한 마리의 후타나리 기생충만 품을 수 있습니다.
				<</if>>
			<<else>>
				현재 <<=_anal>> 임신 중이라 기생충을 품을 수 없습니다.
			<</if>>
			<br>
		<<else>>
			더 이상 <<= _anal>> 기생충을 임신할 수 없습니다.
		<</if>>
		<hr>
		<<for _i to 0; _i lt maxParasites(_args[0]); _i++>>
			<<if $_aPregnancy.fetus[_i] isnot undefined>>
				<<set _fetus to $_aPregnancy.fetus[_i]>>
				<<set _fetusStats to (_fetus && _fetus.stats && typeof _fetus.stats === "object" && !Array.isArray(_fetus.stats)) ? _fetus.stats : {}>>
				<<set _fetusGender to _fetusStats.gender || "unknown">>
				<<set _fetusCreature to _fetus.creature || "unknown">>

				<<if _fetus.fertilised>>
					<<= _anal.toUpperFirst()>> <<=_i+1>>번째 슬롯은 <<print window.KR.getGenderKR(_fetusGender)>> <<print window.KR.getCreatureTypeKr(_fetusCreature)>>【을를】 임신 중입니다.
					<br>
				<<else>>
					<<= _anal.toUpperFirst()>> <<=_i+1>>번째 슬롯에 수정 가능한 <<print window.KR.getGenderKR(_fetusGender)>> <<print window.KR.getCreatureTypeKr(_fetusCreature)>> 알이 있습니다.
					<br>
				<</if>>
			<<else>>
				<<= _anal.toUpperFirst()>> <<=_i+1>>번째 슬롯은 비어 있습니다.
				<br>
			<</if>>
		<</for>>
				<<set _p0 to $sexStats[_args[0]].pregnancy>>
		<<set _fetus0 to (_p0 && _p0.fetus && Array.isArray(_p0.fetus)) ? _p0.fetus : []>>
		<<set _hasAny0 to _fetus0.some(f => f != null)>>
		<<set _needsReset0 to _hasAny0 || (_p0 && _p0.type) || (_p0 && _p0.motherStatus > 0)>>

		<<if _needsReset0>>
			<<link $_linkName>>
				<<set _p to $sexStats[_args[0]].pregnancy>>
				<<set _fetusArr to (_p && _p.fetus && Array.isArray(_p.fetus)) ? _p.fetus : []>>
				<<set _hasAny to _fetusArr.some(f => f != null)>>

				/* Allow clearing when there is anything to clear, or when state is inconsistent (type/motherStatus set without fetus). */
				<<if _hasAny or _p.type or (_p.motherStatus gt 0)>>
					<<set _p.fetus to []>>
					<<set _p.type to null>>
					<<if _p.motherStatus gt 0>><<set _p.motherStatus to 0>><</if>>
				<<else>>
					<<run console.warn("[X-Change cheat] Clear parasite pregnancy hidden/disabled state mismatch:", {slot: _args[0], type: _p && _p.type, fetusLen: _fetusArr.length, motherStatus: _p && _p.motherStatus})>>
				<</if>>

				<<replace `"#cheatsParasiteOptions-" + _args[0]`>><<cheatsParasiteOptions _args[0]>><</replace>>
			<</link>>
		<<else>>
			<span class="disabled" style="opacity:0.6"><<= $_linkName>></span>
		<</if>>
	<</capture>>
<</widget>>

<<widget "cheatsParasite">>
	<<set $_pregnancy to $sexStats[_args[0]].pregnancy>>
	<<if $pregnancyStats.parasiteDoctorEvents lt 2>>
		<<set $pregnancyStats.parasiteDoctorEvents to 2>>
	<</if>>

	<<if _args[1]>>
		<<set $_pregnancy.motherStatus to 2>>
		<<set $_pregnancy.fetus.last().stats.gender to "Hermaphrodite">>
		<<set $_pregnancy.fetus.last().stats.lastEgg to Math.floor($_pregnancy.fetus.last().stats.growth / 3)>>
	<<else>>
		<<if $_pregnancy.motherStatus is 0>>
			<<set $_pregnancy.motherStatus to 1>>
		<</if>>
	<</if>>
	<<fertiliseParasites _args[0]>>
	<<replace `"#cheatsParasiteOptions-" + _args[0]`>><<cheatsParasiteOptions _args[0]>><</replace>>
<</widget>>

<<widget "cheatsPregnancyOptions">>
	<span class="gold">일반 임신 (기생충 아님)</span>
	<br>
	<<set _womb to ($player.vaginaExist ? "vagina" : "anus")>>
	<<set _eligible to ["Avery", "Eden", "Harper", "Kylar", "Morgan", "Robin", "Whitney", "Black Wolf", "Alex", "Wren", "Sydney", "Great Hawk", "Poppy"]>>
	<<set _impregnatableNPC to []>>
	<<set _impregnatorNPC to []>>
	<<set _pregnantNPC to {}>>
	<<for _pregEnabled range $NPCName.filter(npc => npc.pregnancy and npc.pregnancy.enabled isnot undefined)>>
		<<if playerPregnancyPossibleWith(_pregEnabled.nam)>>
			<<set _impregnatorNPC.push($NPCName.indexOf(_pregEnabled))>>
		<</if>>
		<<if NPCPregnancyPossibleWithPlayer(_pregEnabled.nam)>>
			<<set _impregnatableNPC.push($NPCName.indexOf(_pregEnabled))>>
		<</if>>
	<</for>>
	<<if $player.vaginaExist or playerCanCarryAnally()>>
		<<set _menstruation to $sexStats.vagina.menstruation>>
		<<if !playerIsPregnant()>>
			임신하지 않았습니다.
			<br><br>
			<<if $settings.fertilityCycleEnabled>>
				<div class="settingsGrid">
					<div class="settingsHeader options">월경</div>
					<<numberStepper "🩸 주기 일차" _menstruation.currentDay {
						callback: value => V.sexStats.vagina.menstruation.currentDay = value,
						min: 0, max: _menstruation.currentDaysMax, step: 1, percentage: false,
						valueFormat: value => `${Math.trunc(value)}일째 / 총 ${V.sexStats.vagina.menstruation.currentDaysMax}일`
					}>>
					<div class="settingsToggleItem">
						<span class="gold">🥚 배란</span><br>
						<<link "지금 배란">>
							<<set _menstruation.currentDay to _menstruation.stages[2]>>
							<<replace "#cheatsPregnancyOptions">><<cheatsPregnancyOptions>><</replace>>
						<</link>>
					</div>
				</div>
				<hr>
			<</if>>
		<</if>>
		<<if playerIsPregnant()>>
			임신 중입니다.
			/* Beta gives two vaginal wombs, so the player can be carrying more than one record at once. */
			<<set _activePregnancies to getActivePregnancies("pc")>>
			<<for _pregnancy range _activePregnancies>>
				<<capture _pregnancy>>
					<<set _pregLabel to _activePregnancies.length gt 1 ? (_pregnancy.orifice is "anus" ? "Anal pregnancy" : wombLabel(_pregnancy)) + " progress" : "Pregnancy progress">>
					<<set _pregId to _pregnancy.pregnancyId>>
					<<numberStepper _pregLabel pregnancyProgress(_pregnancy) {
						callback: value => {
							const preg = V.pregnancies[_pregId]; if (preg) { const term = getDueDate(preg) - preg.conceivedDate; preg.conceivedDate = Time.date.timeStamp - value * term; }
							Wikifier.wikifyEval("<<updatesidebarimg>>");
						},
						min: 0, max: 0.99, step: 0.05,
						colorArr: ["--teal", "--pink"], activeButtons: ["single", "double"]
					}>>
					<<if _activePregnancies.length gt 1>>
						<<link [[이것만 지운다|$passage]]>>
							<<run clearPregnancyRecord(_pregId)>>
						<</link>>
						<br>
					<</if>>
				<</capture>>
			<</for>>
			<br><br>
			<<link [[현재 임신 초기화하기|$passage]]>>
				<<run clearPlayerPregnancies()>>
				<<set $cumLoads to { vagina: [], anus: [] }>>
				<<set $pendingPregnancies to { vagina: null, vagina2: null, anus: null }>>
				<<restartMenstruationCycle>>
				<<set _menstruation.currentState to "normal">>
				<<set _menstruation.recoveryTime to null>>
				<<set _menstruation.recoveryTimeStart to null>>
				<<set _menstruation.recoveryStage to null>>
				<<run delete C.npc.Alex.pregnancy.pcKnowledge>>
				<<run delete C.npc.Alex.pregnancy.test>>
				<<run delete C.npc.Alex.pregnancy.ultraSound>>
				<<run delete C.npc.Alex.pregnancy.sample>>
				<<run delete C.npc.Alex.pregnancy.ultraSoundPics>>
				<<if C.npc.Poppy>>
					<<run delete C.npc.Poppy.pregnancy.pcKnowledge>>
					<<run delete C.npc.Poppy.pregnancy.test>>
					<<run delete C.npc.Poppy.pregnancy.ultraSound>>
					<<run delete C.npc.Poppy.pregnancy.ultraSoundPics>>
					<<run delete C.npc.Poppy.pregnancy.ultrasoundShown>>
					<<run delete C.npc.Poppy.pregnancy.paternityRequested>>
					<<run delete C.npc.Poppy.pregnancy.sample>>
				<</if>>
			<</link>>
			<br>
		<</if>>
		/* A free Beta second womb can still conceive, so these stay open while the first one carries. */
		<<if !playerIsPregnant() or betaSecondWombOpen()>>
			<<if $settings.playerPregnancyHumanEnabled or $settings.playerPregnancyBeastEnabled>>
				<<if betaSecondWombOpen()>>
					두 번째 자궁이 아직 비어 있습니다.
					<br>
				<</if>>
				<<if $settings.pregnancyType is "realistic">>
					<<set _stored to $cumLoads[_womb].filter(loadIsLive).length>>
					당신에게는 임신 가능성에 영향을 주는 저장된 정액이 <span id="cheatSpermSources"><span class="gold">_stored</span>개</span> 있습니다.
					<br><br>
				<</if>>
				다음으로부터 임신하기:
				<br>
				<<if $settings.playerPregnancyHumanEnabled>>
					<<link [[무작위 사람|$passage]]>> /* checks if males or females have penises, if there is no people with penises a foreigner impregnates PC */
					<<set _impregnator to either("arbitrary", "aimless", "by-the-way", "casual", "driftless", "hit-or-miss", "fluky", "promiscuous", "slapdash", "irresponsible", "careless", "negligent") + " cheater ">>
					<<if $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance lt 100>>
						<<set _impregnator += either("man", "boy", "woman", "girl")>>
					<<elseif $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance gt 99>>
						<<set _impregnator += either("woman", "girl")>>
					<<elseif $settings.femaleNPCPenisChance lt 1 and $settings.maleNPCVaginaChance lt 100>>
						<<set _impregnator += either("man", "boy")>>
					<<else>>
						<<set _impregnator += "foreigner">>
					<</if>>
					<<playerPregnancy _impregnator "human" true _womb undefined true>>
					<</link>>
				<</if>>
				<<if $settings.playerPregnancyBeastEnabled>>
					<<if $settings.playerPregnancyHumanEnabled>>
						|
					<</if>>
					<<link [[늑대|$passage]]>>
					<<if monsterChanceForType("wolf") gte random(1, 100) and ($hallucinations gte 1 or !monsterHallucinationsOnlyForType("wolf"))>>
						<<if $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance lt 100>>
							<<set _impregnator to either("cheater wolfboy", "cheater wolfgirl")>>
						<<elseif $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance gt 99>>
							<<set _impregnator to "cheater wolfgirl">>
						<<elseif $settings.femaleNPCPenisChance lt 1 and $settings.maleNPCVaginaChance lt 100>>
							<<set _impregnator to "cheater wolfboy">>
						<<else>>
							<<set _impregnator to "foreign cheater wolfperson">>
						<</if>>
						<<if _impregnator is "cheater wolfgirl">><<set _spermType to "wolfgirl">><<else>><<set _spermType to "wolfboy">><</if>>
					<<else>>
						<<if beastMaleChanceForType("wolf") gt 0>> /* checks if there are male wolves, if not a foreigner wolf impregnates PC */
							<<set _impregnator to "cheater wolf">>
						<<else>>
							<<set _impregnator to "cheater foreign wolf">>
						<</if>>
						<<set _spermType to "wolf">>
					<</if>>
					<<playerPregnancy _impregnator _spermType true _womb undefined true>>
					<</link>>
				<</if>>
				<<for _pregEnabled range _impregnatorNPC>>
					<<set _actor to $NPCName[_pregEnabled]>>
					<<if !_eligible.includes(_actor.nam)>>
						<<continue>>
					<</if>>
					<<switch _actor.nam>>
						<<case "Black Wolf">>
							<<if resolveIfNamedBeastIsMonster("blackwolf")>>
								<<set _spermType to (C.npc["Black Wolf"].pronoun is "f" ? "wolfgirl" : "wolfboy")>>
							<<else>>
								<<set _spermType to "wolf">>
							<</if>>
						<<case "Great Hawk">>
							<<if resolveIfNamedBeastIsMonster("greathawk")>>
								<<set _spermType to "harpy">>
							<<else>>
								<<set _spermType to "hawk">>
							<</if>>
						<<default>><<set _spermType to "human">>
					<</switch>>
					<<capture _actor, _spermType, _womb>>
					| <<link [[`<<print window.KR.gatPersonNameDictKR(_actor.nam)>>`|$passage]]>>
						<<playerPregnancy _actor.nam _spermType true _womb undefined true>>
					<</link>>
					<</capture>>
				<</for>>
				<<if $player.penisExist>>
					| <<link [[자기 자신|$passage]]>>
					<<playerPregnancy "pc" "human" true _womb undefined true>>
					<</link>>
				<</if>>
				<br><br>
				<<if $settings.pregnancyType is "realistic">>
					다음으로부터 정액 추가하기:
					<br>
					<<if $settings.playerPregnancyHumanEnabled>>
						<<link "익명의 기증자">> /* The sperm owner is always the same, anonymous donor, so it helps pregnancy from only one source */
							<<sceneInseminate _womb "anonymous donor" "human" "deep">>
							<<replace "#cheatSpermSources">><<set _stored to $cumLoads[_womb].filter(loadIsLive).length>><span class="gold">_stored</span>개의 저장된 정액<</replace>>
						<</link>>
						| <<link "무작위 사람">> /* checks if males or females have penises, if there is no people with penises a foreigner inseminates PC */
							<<set _impregnator to either("arbitrary", "aimless", "by-the-way", "casual", "driftless", "hit-or-miss", "fluky", "promiscuous", "slapdash", "irresponsible", "careless", "negligent") + " cheater ">>
							<<if $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance lt 100>>
								<<set _impregnator += either("man", "boy", "woman", "girl")>>
							<<elseif $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance gt 99>>
								<<set _impregnator += either("woman", "girl")>>
							<<elseif $settings.femaleNPCPenisChance lt 1 and $settings.maleNPCVaginaChance lt 100>>
								<<set _impregnator += either("man", "boy")>>
							<<else>>
								<<set _impregnator += "foreigner">>
							<</if>>
							<<sceneInseminate _womb _impregnator "human" "deep">>
							<<replace "#cheatSpermSources">><<set _stored to $cumLoads[_womb].filter(loadIsLive).length>><span class="gold">_stored</span>개의 저장된 정액<</replace>>
						<</link>>
					<</if>>
					<<if $settings.playerPregnancyBeastEnabled>>
						<<if $settings.playerPregnancyHumanEnabled>>
							|
						<</if>>
						<<link "늑대">>
							<<if monsterChanceForType("wolf") gte random(1, 100) and ($hallucinations gte 1 or !monsterHallucinationsOnlyForType("wolf"))>>
								<<if $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance lt 100>>
									<<set _impregnator to either("cheater wolfboy", "cheater wolfgirl")>>
								<<elseif $settings.femaleNPCPenisChance gt 0 and $settings.maleNPCVaginaChance gt 99>>
									<<set _impregnator to "cheater wolfgirl">>
								<<elseif $settings.femaleNPCPenisChance lt 1 and $settings.maleNPCVaginaChance lt 100>>
									<<set _impregnator to "cheater wolfboy">>
								<<else>>
									<<set _impregnator to "foreign cheater wolfperson">>
								<</if>>
								<<if _impregnator is "cheater wolfgirl">><<set _spermType to "wolfgirl">><<else>><<set _spermType to "wolfboy">><</if>>
							<<else>>
								<<if beastMaleChanceForType("wolf") gt 0>> /* checks if there are male wolves, if not a foreigner wolf inseminates PC */
									<<set _impregnator to "cheater wolf">>
								<<else>>
									<<set _impregnator to "foreign cheater wolf">>
								<</if>>
								<<set _spermType to "wolf">>
							<</if>>
							<<sceneInseminate _womb _impregnator _spermType "deep">>
							<<replace "#cheatSpermSources">><<set _stored to $cumLoads[_womb].filter(loadIsLive).length>><span class="gold">_stored</span>개의 저장된 정액<</replace>>
						<</link>>
					<</if>>
					<<for _pregEnabled range _impregnatorNPC>>
						<<set _actor to $NPCName[_pregEnabled]>>
						<<if !_eligible.includes(_actor.nam)>>
							<<continue>>
						<</if>>
						<<switch _actor.nam>>
							<<case "Black Wolf">>
								<<if resolveIfNamedBeastIsMonster("blackwolf")>>
									<<set _spermType to (C.npc["Black Wolf"].pronoun is "f" ? "wolfgirl" : "wolfboy")>>
								<<else>>
									<<set _spermType to "wolf">>
								<</if>>
							<<case "Great Hawk">>
								<<if resolveIfNamedBeastIsMonster("greathawk")>>
									<<set _spermType to "harpy">>
								<<else>>
									<<set _spermType to "hawk">>
								<</if>>
							<<default>><<set _spermType to "human">>
						<</switch>>
						<<capture _actor, _spermType, _womb>>
						| <<link `window.KR.gatPersonNameDictKR(_actor.nam)`>>
							<<sceneInseminate _womb _actor.nam _spermType "deep">>
							<<replace "#cheatSpermSources">><<set _stored to $cumLoads[_womb].filter(loadIsLive).length>><span class="gold">_stored</span>개의 저장된 정액<</replace>>
						<</link>>
						<</capture>>
					<</for>>
					<<if $player.penisExist>>
						| <<link "자기 자신">>
							<<sceneInseminate _womb "pc" "human" "deep">>
							<<replace "#cheatSpermSources">><<set _stored to $cumLoads[_womb].filter(loadIsLive).length>><span class="gold">_stored</span>개의 저장된 정액<</replace>>
						<</link>>
					<</if>>
					<br>
					<<set _implantDays to PregnancyConstants.implantationWindow / TimeConstants.secondsPerDay>>
					<<link "가장 최근 저장된 정액으로 강제 수정">>
						<<if $cumLoads[_womb].length and availablePlayerPregnancySlot(_womb) isnot null>>
							<<run recordPendingPregnancy(_womb, $cumLoads[_womb].last())>>
							<<replace "#cheatForcePick">><span class="green">수정 대기 상태가 기록되었습니다</span> (<<= _implantDays>>일 뒤에 착상되니, 시간을 넘겨 확인하세요)<</replace>>
						<<else>>
							<<replace "#cheatForcePick">><span class="red">저장된 정액이 필요하며, 이미 진행 중인 임신이나 대기 중인 수정이 없어야 합니다</span><</replace>>
						<</if>>
					<</link>>
					<span id="cheatForcePick" class="description">(<<= _implantDays>>일 뒤에 착상되니, 시간을 넘겨 확인하세요)</span>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		당신은 임신할 수 없습니다.
	<</if>>
<</widget>>

<<widget "cheatsImpregOptions">>
	<span class="gold">수정</span>
	<<set _fertileNPC to _impregnatableNPC.filter(npcIndex => _eligible.includes($NPCName[npcIndex].nam) and !getActivePregnancies($NPCName[npcIndex].nam).length)>>
	<<if $player.penisExist and _fertileNPC.length>>
		<br>
		당신은 <span class="gold">_fertileNPC.length</span>명의 가임기 NPC【을를】 임신시킬 수 있습니다.
		<br><br>
		<<for _pregEnabled range _fertileNPC>>
			<<set _actor to $NPCName[_pregEnabled]>>
			<<set _actorNameNoSpace to _actor.nam.replace(" ","")>>
			<<if !_eligible.includes(_actor.nam) or getActivePregnancies(_actor.nam).length>>
				<<continue>>
			<</if>>
			<<set _fertileNPC += 1>>
			<<= _actor.nam>>:
			<br>
			<<capture _actor>>
				<<set _linkText to "임신시키기">>
				<<link [[_linkText|$passage]]>>
					<<namedNpcPregnancy _actor.nam "pc" "human" true true>>
				<</link>>
				<<if $settings.fertilityCycleEnabled>>
					- <<link [[주기를 가임기로 설정|$passage]]>>
						<<set _actor.pregnancy.cycleDay to _actor.pregnancy.cycleDangerousDay - 1>>
					<</link>>
				<</if>>
			<</capture>>
			<br>
		<</for>>
	<<else>>
		<br>
		<<if !$player.penisExist>>
			당신은 지금 자지가 없어서 어떤 NPC도 임신시킬 수 없습니다.
		<<else>>
			당신은 지금 어떤 NPC도 임신시킬 수 없습니다.
		<</if>>
		<<if $settings.npcPregnancyEnabled is false>>
			<br>
			<span class="red">설정에서 NPC 임신이 꺼져 있습니다.</span>
		<</if>>
	<</if>>

	<<for _pregEnabled range $NPCName>> /* Checks for any pregnant named NPC. */
		<<if npcIsPregnant(_pregEnabled.nam)>>
			<<set _pregnantNPC[_pregEnabled.nam] to $NPCName.indexOf(_pregEnabled)>>
		<</if>>
	<</for>>

	<<if Object.keys(_pregnantNPC).length>>
		<hr>
		<span class="gold">임신한 NPC</span>
		<br>
		<<listbox "_pregnantNPCId" autoselect>>
			<<optionsfrom _pregnantNPC>>
		<</listbox>>
		<br><br>
		<div id="cheatPregnancyNPC">
			<<cheatPregnancyNPC _pregnantNPCId>>
		</div>
		<<cheatPregnancyNPCReset>>
	<</if>>
<</widget>>

<<widget "cheatPregnancyNPCStepper">>
<<set _pregRecord to getActivePregnancies($NPCName[_args[0]].nam)[0]>>
<<numberStepper "임신 진행도 (일)" daysAlong(_pregRecord) {
	callback: (value, arr) => {
		const rec = getActivePregnancies(V.NPCName[arr[0]].nam)[0];
		rec.conceivedDate = Time.date.timeStamp - value * TimeConstants.secondsPerDay;
		Wikifier.wikifyEval("<<updatesidebarimg>>");
	},
	values: [_args[0]],
	min: 0, max: (getDueDate(_pregRecord) - _pregRecord.conceivedDate) / TimeConstants.secondsPerDay - 0.5,
	colorArr: ["--teal", "--pink"], activeButtons: ["single", "double"]
}>>
<</widget>>
<<widget "cheatPregnancyNPC">>
	<<set _pregRecord to getActivePregnancies($NPCName[_args[0]].nam)[0]>>
	<<set _term to getDueDate(_pregRecord) - _pregRecord.conceivedDate>>
	<<set $_fatherName to pregnancyNameCorrection(_pregRecord.donor)>>
	<<set _species to childBaseSpecies(_pregRecord.donorSpecies)>>
	<<switch _species>>
		<<case "wolf">><<set _speciesKr to "늑대 새끼">>
		<<case "hawk">><<set _speciesKr to "매의 알">>
		<<default>><<set _speciesKr to "아기">>
	<</switch>>
	<<print window.KR.gatPersonNameDictKR($NPCName[_args[0]].nam)>>【은는】 <<= _speciesKr>>【을를】 임신했습니다. 아버지는 <<= _pregRecord.donor === "pc" ? "당신" : $_fatherName.toUpperFirst()>>입니다.
	<span id="cheatNPCPregnancyProgress">
		<<cheatPregnancyNPCStepper _args[0]>>
	</span>
	<br>

	<<link "임신 초기">>
		<<set _pregRecord.conceivedDate to Time.date.timeStamp - _term * .05>>
		<<replace "#cheatNPCPregnancyProgress">><<cheatPregnancyNPCStepper _args[0]>><</replace>>
	<</link>> -
	<<link "임신 중기">>
		<<set _pregRecord.conceivedDate to Time.date.timeStamp - _term * .35>>
		<<replace "#cheatNPCPregnancyProgress">><<cheatPregnancyNPCStepper _args[0]>><</replace>>
	<</link>> -
	<<link "임신 말기">>
		<<set _pregRecord.conceivedDate to Time.date.timeStamp - _term * .7>>
		<<replace "#cheatNPCPregnancyProgress">><<cheatPregnancyNPCStepper _args[0]>><</replace>>
	<</link>> -
	<<link "임신 막달">>
		<<set _pregRecord.conceivedDate to Time.date.timeStamp - _term>>
		<<replace "#cheatNPCPregnancyProgress">><<cheatPregnancyNPCStepper _args[0]>><</replace>>
	<</link>>
	<br><br>

	<<link [[임신 지우기|$passage]]>>
		<<run clearPregnancyRecord(_pregRecord.pregnancyId)>>
		<<set $NPCName[_args[0]].pregnancy.cycleDay to 1>>
		<<if _pregnantNPCId is 25>><<run delete C.npc.Alex.pregnancy.selfKnowledge>><</if>>
	<</link>>
<</widget>>

/* Load is the whole Autism Spectrum trait in one number, so testing it needs a way to set it. */
<<widget "autismLoadCheat">>
	<<if $backgroundTraits.includes("autism")>>
		<<set _state to ensureAutismSpectrumState()>>
		부하: <span @class="_state.phase is 'burnout' ? 'red' : _state.phase is 'settled' ? 'green' : 'gold'"><<= autismLoadPercent()>>% (<<= ({burnout: "번아웃", strained: "버거움", settled: "안정"})[_state.phase] || _state.phase.toUpperFirst()>>)</span>
		<<numberStepper "부담 설정" _state.load {step: 5, min: 0, max: 100, percentage: false, callback: value => {
			autismSetLoad(value);
			Wikifier.wikifyEval("<<replace '#statsautismload'>><<autismLoadCheat>><</replace>>");
		}}>>
		<<if autismInMeltdown()>>
			| <span class="red">멜트다운 중</span>
		<</if>>
		<br>
		마스킹: <span class="purple"><<= autismMaskingLevel()>>%</span>
		<<numberStepper "마스킹 설정" _state.masking {step: 5, min: 0, max: 100, percentage: false, callback: value => {
			autismSetMasking(value);
			Wikifier.wikifyEval("<<replace '#statsautismload'>><<autismLoadCheat>><</replace>>");
		}}>>
	<</if>>
<</widget>>

<<widget "changeCheatClass">>
	<<for _class range ["red", "pink", "purple", "blue", "lblue", "teal", "green", "gold"]>>
		<<removeclass _args[0] _class>>
	<</for>>
	<<if _args[1] is "켜짐">><<addclass _args[0] "green">>
	<<elseif ["꺼짐", "비활성화"].includes(_args[1])>><<addclass _args[0] "red">>
	<<else>><<addclass _args[0] _statColour>>
	<</if>>
<</widget>>

<<widget "cheatsBody">>
	<<set _bodyTypes to ["남성적", "여성적", "중성적"]>>

	<<capture _i>>
		<<for _i = 0; _i < _bodyTypes.length; _i++>>
			<span @class="$player.gender_body is _bodyTypes[_i].charAt(0) ? 'goldLink' : 'unselected'">
				<<link _bodyTypes[_i].toUpperFirst()>>
					<<set $player.gender_body to _bodyTypes[_i].charAt(0)>>
					<<replace "#statsBodyType">><<cheatsBody>><</replace>><<updatesidebarimg>>
				<</link>>
			</span>	<<= _i lt _bodyTypes.length - 1 ? "|" : "">>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatsBodySize">>
	<<set _steps to [-1, 0, 1, 2, 2.5, 3, 4]>>
	<<set _label to ["Miniature", "Tiny", "Small", "Normal", "Tall", "Large", "Giant"]>>

	<<set _physMax to {
		"-1": 3000,
		"0":  6000,
		"1":  8000,
		"2":  10000,
		"2.5": 12000,
		"3":  14000,
		"4":  15000
	}>>

	<<for _i = 0; _i < _steps.length; _i++>>
		<<set _val to _steps[_i]>>
		<<set _txt to _label[_i]>>
		<<set _newMax to _physMax[String(_val)]>>

		<<capture _val _txt _newMax>>
			<span @class="$bodysize is _val ? 'goldLink' : 'link'">
				<<link _txt>>
					<<set $bodysize to _val>>

					<<set _physique_max_old to $physiquesize>>
					<<set $physiquesize to _newMax>>
					<<if _physique_max_old isnot undefined and _physique_max_old gt 0>>
						<<set $physique *= ($physiquesize / _physique_max_old)>>
					<</if>>

					<<replace "#statsBodySize">><<cheatsBodySize>><</replace>><<updatesidebarimg>>
				<</link>>
			</span> <<= _i lt _steps.length - 1 ? "|" : "">>
		<</capture>>
	<</for>>
<</widget>>

<<widget "cheatsBodyShape">>
	<<set _bodyShapeLabelsKr to {
		"classic": "평범한",
		"slender": "슬림한",
		"curvy": "잘록한",
		"soft": "푹신한"
	}>>
	<<capture _i, _bodyShapeLabelsKr>>
		<<for _i = 0; _i < setup.bodyShapes.length; _i++>>
			<span @class="$player.bodyshape is setup.bodyShapes[_i] ? 'goldLink' : 'unselected'">
				<<link `_bodyShapeLabelsKr[setup.bodyShapes[_i]] || (setup.bodyShapes[_i] is "andro" ? "중성적" : setup.bodyShapes[_i].toUpperFirst())`>>
					<<set $player.bodyshape to setup.bodyShapes[_i]>>
					<<replace "#statsBodyShape">><<cheatsBodyShape>><</replace>><<updatesidebarimg>>
				<</link>>
			</span>	<<= _i lt setup.bodyShapes.length - 1 ? "|" : "">>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatsFaceStyle">>
	<<set _faceStyles to Object.values(setup.faceStyleOptions)>>

	<<capture _i>>
		<<for _i = 0; _i < _faceStyles.length; _i++>>
			<span @class="$facestyle is _faceStyles[_i] ? 'goldLink' : 'unselected'">
				<<link _faceStyles[_i].toUpperFirst()>>
					<<set $facestyle to _faceStyles[_i]>>
					<<set $facevariant to "default">>
					<<replace "#statsFaceStyle">><<cheatsFaceStyle>><</replace>><<updatesidebarimg>>
					<<replace "#statsDemeanour">><<cheatsDemeanour>><</replace>><<updatesidebarimg>>
				<</link>>
			</span> <<= _i lt _faceStyles.length - 1 ? "|" : "">>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatsDemeanour">>
	<<set _style to V.facestyle>>

	/* Validate style */
	<<if _style is undefined or !setup.faceVariantOptions or !setup.faceVariantOptions[_style]>>
		<<set _style to "default">>
		<<set $facestyle to "default">>
		<<set $facevariant to "default">>
	<</if>>

	<<set _raw to setup.faceVariantOptions[_style]>>

	/* Normalise to a label -> value lookup */
	<<set _faceOpts to {}>>
	<<if Array.isArray(_raw)>>
		<<for _i = 0; _i < _raw.length; _i++>>
			<<set _v to _raw[_i]>>
			<<run _faceOpts[_v.toUpperFirst()] = _v>>
		<</for>>
	<<else>>
		<<set _faceOpts to _raw || {}>>
	<</if>>

	<<if Object.keys(_faceOpts).length is 0>>
		이 얼굴형에 쓸 수 있는 얼굴 변형이 없습니다.
	<<else>>
		<<listbox "$facevariant" autoselect>>
			<<optionsfrom _faceOpts>>
		<</listbox>>
		<<run $(() => {
			$("#listbox-facevariant")
				.off("change.cheatsdemeanour")
				.on("change.cheatsdemeanour", () => Wikifier.wikifyEval('<<updatesidebarimg>>'));
		})>>
	<</if>>
<</widget>>

<<widget "cheatsSpeechAttitude">>
	<<set _submissiveness = {
		meek: 1500,
		shy: 1250,
		polite: 1000,
		docile: 1400,
		neutral: 1000,
		confident: 700,
		bratty: 500,
		cruel: 250,
		flamboyant: 1000,
		special: 800,
		capricious: 1000,
		fickle: 1000
	}>>
	<<set _attitude = ["meek", "shy", "polite", "docile", "neutral", "confident", "bratty", "cruel", "flamboyant", "special", "capricious", "fickle"]>>

	<<capture _i, _submissiveness, _attitude>>
		<<for _i = 0; _i < _attitude.length; _i++>>
			<span @class="$speech_attitude is _attitude[_i] ? 'goldLink' : 'link'">
				<<link _attitude[_i].toUpperFirst()>>
					<<set $speech_attitude to _attitude[_i]>>
					<<set $speech_attitude_special to _attitude[_i]>>
					<<set $submissive to _submissiveness[_attitude[_i]]>>
					<<replace "#statsSpeechAttitude">><<cheatsSpeechAttitude>><</replace>>
				<</link>>
			</span><<= _i lt _attitude.length - 1 ? "|" : "">>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatsWeather">>
	<<set _weatherTypes to ["clear", "lightClouds", "heavyClouds", "lightPrecipitation", "heavyPrecipitation", "storm", "thunderstorm"]>>
	<<set _dayState to Weather.bloodMoon ? "blood" : Weather.dayState === "night" ? "night" : "day">>
	<<capture _i, _weatherState, _dayState, _name, _iconType, _weatherIcon>>
		<<for _i = 0; _i < _weatherTypes.length; _i++>>
			<<set _weatherState to _weatherTypes[_i]>>
			<<set _iconType = resolveValue(setup.WeatherGeneration.weatherTypes.find(w => w.name === _weatherState).iconType, "clear")>>

			<<set _weatherIcon to `<<iconUi 'weather/${_dayState}_${_iconType}.png'>>`>>

			<<set _weatherName to window.KR.getWeatherStateKr(_weatherState)>>
			<<= _weatherIcon.replace("none", "rain")>>
			<span @class="Weather.name is _weatherState ? 'goldLink' : 'unselected'">
				<<link _weatherName>>
					<<set Weather.set(_weatherState, true, 6 * 60)>>
					<<replace "#cheatsWeather">><<cheatsWeather>><</replace>>
				<</link>>
			</span>
			<<= _i lt _weatherTypes.length - 1 ? "<br>" : "">>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatsFog">>
	<<numberStepper "안개" `Weather.FogGeneration.getFog()` {
		callback: value => {
			Weather.FogGeneration.setFog(value);
		},
		min: 0, max: 1, step: 0.1, colorArr: ["--blue"], percentage: false,
		valueFormat: value => round(value, 1),
		activeButtons: ["single", "double"]
	}>>
<</widget>>

<<widget "cheatsSex">>
	<<set _reasons to []>>
	<<if $sexStats.vagina.menstruation.currentState isnot "normal">><<set _reasons.push($sexStats.vagina.menstruation.currentState is "recovering" ? "이전 임신에서 아직 회복 중이기 때문" : "현재 임신 중이기 때문")>><</if>>
	<<if $earSlime.growth gt 50>><<set _reasons.push("귀 슬라임이 너무 자랐기 때문")>><</if>>
	<<if _inWardrobe>>
		<<if _reasons.length gte 1>>
			<span class="gold"><<= ($player.penisExist and $player.vaginaExist) ? "양성" : $player.penisExist ? "자지" : $player.vaginaExist ? "보지" : "">></span>
			| <<= _reasons.join(", ")>> 이 설정을 변경할 수 없습니다.
		<<else>>
			<<if $player.penisExist and !$player.vaginaExist>>
				<span class="gold">자지</span> |
			<<else>>
				<<link "자지">>
					<<wash>>
					<<removeparasite clit>>
					<<removeparasite penis>>
					<<set $vaginause to "none">>
					<<set $vaginastate to "none">>
					<<set $penisuse to 0>>
					<<set $penisstate to 0>>
					<<set $player.sex to "m">>
					<<set $player.ballsExist to true>>
					<<set $player.penisExist to true>>
					<<set $player.vaginaExist to false>>
					<<set $sexStats.vagina.menstruation.running = false>>
					<<run window.ejectOrphanVaginalDildo?.()>>
					<<updatesidebarimg>>
					<<replace "#statsGender">><<cheatsSex>><</replace>>
				<</link>> |
			<</if>>
			<<if $player.vaginaExist and !$player.penisExist>>
				<span class="gold">보지</span>
			<<else>>
				<<link "보지">>
					<<wash>>
					<<removeparasite clit>>
					<<removeparasite penis>>
					<<set $vaginause to 0>>
					<<set $vaginastate to 0>>
					<<set $penisuse to "none">>
					<<set $penisstate to "none">>
					<<set $player.sex to "f">>
					<<set $player.ballsExist to false>>
					<<set $player.penisExist to false>>
					<<set $player.vaginaExist to true>>
					<<set $sexStats.vagina.menstruation.running = true>>
					<<updatesidebarimg>>
					<<replace "#statsGender">><<cheatsSex>><</replace>>
				<</link>> 
			<</if>>
		<</if>>
	<<else>>
		<span class="gold"><<= ($player.penisExist and $player.vaginaExist) ? "양성" : $player.penisExist ? "자지" : $player.vaginaExist ? "보지" : "">></span> | <<if _reasons.length gte 1>><<= _reasons.join(", ")>> 성기를 변경할 수 없습니다. 원래 이 설정은<<else>>이 설정은<</if>> 옷장에 접근할 때만 변경할 수 있습니다.
	<</if>>
<</widget>>

<<widget "cheatSection">>
	<<switch _args[0]>>
		<<case "state">>
			<<if $tirednessMaxScalingToggle>>
				<<set C.tiredness.max to 2000 + Math.floor(currentSkillValue("physique", 2, 1) / 32)>>
			<<else>>
				<<set C.tiredness.max to 2000>>
			<</if>>
			<<if $stressMaxScalingToggle>>
				<<set $stressmax to 10000 + Math.floor(($xchange.willpowerSystemEnabled === 1 ? Math.max(0, Number($xchange.willpowerPoints) || 0) : currentSkillValue("willpower", 0, 1)) * 5)>>
			<<else>>
				<<set $stressmax to 10000>>
			<</if>>
			<<numberStepper "고통" $pain { callback: value => { V.cheatReload = true; V.pain = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 200, reverse: true}>>
			<<numberStepper "흥분도" $arousal { callback: value => { V.cheatReload = true; V.arousal = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 10000, reverse: true}>>
			<<numberStepper "의지력" `isNaN($xchange.willpowerPoints) ? Math.max(200, $willpower || 0) : $xchange.willpowerPoints` { callback: value => { V.cheatReload = true; V.xchange.willpowerPoints = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: Math.max(200, $willpower)}>>
			<<numberStepper "피로도" $tiredness { callback: value => { V.cheatReload = true; V.tiredness = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: C.tiredness.max, reverse: true}>>
			<<numberStepper "스트레스" $stress { callback: value => { V.cheatReload = true; V.stress = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: $stressmax, reverse: true}>>
			<<numberStepper "트라우마" $trauma { callback: value => { V.cheatReload = true; V.trauma = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 5000, reverse: true}>>
			<<numberStepper "통제력" $control { callback: value => { V.cheatReload = true; V.control = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 1000}>>
			<<numberStepper "취기" $drunk { callback: value => { V.cheatReload = true; V.drunk = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: $drunkmax, reverse: true}>>
			<<numberStepper "약물" $drugged { callback: value => { V.cheatReload = true; V.drugged = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 1000, reverse: true}>>
			<<numberStepper "환각제" $hallucinogen { callback: value => { V.cheatReload = true; V.hallucinogen = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }, max: 1000, reverse: true}>>
		<<case "crime">>
			<<for _cr range Object.keys(setup.crimeNames)>>
				<<capture _cr>>
					<<numberStepper toTitleCase(setup.crimeNames[_cr]) $crime[_cr].current { callback: (value, arr) => { V.crime[arr[0]].current = value }, max: 10000, step: 10, reverse: true, percentage: false, values: [_cr]}>>
				<</capture>>
			<</for>>
			<<unset _cr>>
		<<case "negative">>
			<<numberStepper "성적" $fame.sex { callback: value => { V.fame.sex = value }, max: 2000 * $AMCTraits.sexFame, reverse: true, percentage: false}>>
			<<numberStepper "매춘" $fame.prostitution { callback: value => { V.fame.prostitution = value }, max: 2000 * $AMCTraits.prostitutionFame, reverse: true, percentage: false}>>
			<<numberStepper "강간" $fame.rape { callback: value => { V.fame.rape = value }, max: 2000 * $AMCTraits.rapeFame, reverse: true, percentage: false}>>
			<<numberStepper "수간" $fame.bestiality { callback: value => { V.fame.bestiality = value }, max: 2000 * $AMCTraits.bestialityFame, reverse: true, percentage: false}>>
			<<numberStepper "임신" $fame.pregnancy { callback: value => { V.fame.pregnancy = value }, max: Math.clamp(playerNormalPregnancyTotal() * $AMCTraits.pregnancyFame,1,8) * 250, step: 2000 / 100, percentage: false, reverse: true}>>
			<<numberStepper "수정" $fame.impreg { callback: value => { V.fame.impreg = value }, max: 2000 * $AMCTraits.impregFame, reverse: true, percentage: false}>>
			<<numberStepper "노출" $fame.exhibitionism { callback: value => { V.fame.exhibitionism = value }, max: 2000 * $AMCTraits.exhibitionismFame, reverse: true, percentage: false}>>
			<<numberStepper "X-체인지 명성" $xchange_fame { callback: value => { V.xchange_fame = Math.clamp(value, 0, 1000) }, max: 1000, reverse: true, percentage: false}>>
			<<if playerNormalPregnancyTotal() lt 8>>
				<span class="description"><<set _pregsNeeded to Math.trunc(8-playerNormalPregnancyTotal())>>
				당신의 임신 명성은 당신이 겪은 임신 횟수에 의해 제한됩니다. 최대 임신 명성에 도달하려면 <span class="gold"><<number _pregsNeeded>></span>번 더 임신해야 합니다.</span>
			<</if>>
		<<case "positive">>
			<<numberStepper "전투" $fame.scrap { callback: value => { V.fame.scrap = value }, max: 2000 * $AMCTraits.scrapFame, percentage: false}>>
			<<numberStepper "친절" $fame.good { callback: value => { V.fame.good = value }, max: 2000 * $AMCTraits.goodFame, percentage: false}>>
			<<numberStepper "사업" $fame.business { callback: value => { V.fame.business = value }, max: 2000 * $AMCTraits.businessFame, percentage: false}>>
			<<numberStepper "사교" $fame.social { callback: value => { V.fame.social = value }, max: 2000 * $AMCTraits.socialFame, percentage: false}>>
			<<numberStepper "모델" $fame.model { callback: value => { V.fame.model = value }, max: 2000 * $AMCTraits.modelFame, percentage: false}>>
		<<case "skills">>
			<<numberStepper "속임수" $skulduggery "skulduggery" {max: amcDisplayCap($skulduggery, 1000, $AMCTraits.skulduggery), percentage: false}>>
			<<numberStepper "춤" $danceskill "danceskill" {max: amcDisplayCap($danceskill, 1000, $AMCTraits.dancing), percentage: false}>>
			<<numberStepper "수영" $swimmingskill "swimmingskill" {max: amcDisplayCap($swimmingskill, 1000, $AMCTraits.swimming), percentage: false}>>
			<<numberStepper "체육" $athletics "athletics" {max: amcDisplayCap($athletics, 1000, $AMCTraits.athletics), percentage: false}>>
			<<numberStepper "관리" $tending "tending" {max: amcDisplayCap($tending, 1000, $AMCTraits.tending), percentage: false}>>
			<<numberStepper "가사" $housekeeping "housekeeping" {max: amcDisplayCap($housekeeping, 1000, $AMCTraits.housekeeping), percentage: false}>>
			<<numberStepper "난투" $combatExtended.brawling { callback: value => { V.combatExtended.brawling = value },max: amcDisplayCap($combatExtended.brawling, 1000, $AMCTraits.brawling), percentage: false}>>
			<<numberStepper "풋워크" $combatExtended.footwork { callback: value => { V.combatExtended.footwork = value },max: amcDisplayCap($combatExtended.footwork, 1000, $AMCTraits.footwork), percentage: false}>>
			<<numberStepper "타격" $combatExtended.striking { callback: value => { V.combatExtended.striking = value },max: amcDisplayCap($combatExtended.striking, 1000, $AMCTraits.striking), percentage: false}>>
			<<numberStepper "발차기" $combatExtended.kicking { callback: value => { V.combatExtended.kicking = value },max: amcDisplayCap($combatExtended.kicking, 1000, $AMCTraits.kicking), percentage: false}>>
		<<case "school">>
			/* normally, school traits are adjusted by the widget "school_skill_change" */
			<<numberStepper "<<scienceicon>> 과학" $science "science" {
				callback: (value) => wikifier('adjust_school_traits'),
				max: amcDisplayCap($science, 1000, $AMCTraits.science), percentage: false
			}>>
			<<numberStepper "<<mathicon>> 수학" $maths "maths" {
				callback: (value) => wikifier('adjust_school_traits'),
				max: amcDisplayCap($maths, 1000, $AMCTraits.maths), percentage: false
			}>>
			<<numberStepper "<<englishicon>> 영어" $english "english" {
				callback: (value) => wikifier('adjust_school_traits'),
				max: amcDisplayCap($english, 1000, $AMCTraits.english), percentage: false
			}>>
			<<numberStepper "<<historyicon>> 역사" $history "history" {
				callback: (value) => wikifier('adjust_school_traits'),
				max: amcDisplayCap($history, 1000, $AMCTraits.history), percentage: false
			}>>
		<<case "characteristics">>
			<<numberStepper "<<tficon angel>> 순결도" $purity "purity" {max: 1000}>>
			<<numberStepper "<<symbol beauty>> 미모" $beauty "beauty" {max: amcDisplayCap($beauty, 10000, $AMCTraits.beauty), percentage: false}>>
			<<numberStepper "<<symbol physique>> 체격" $physique "physique" { max: amcDisplayCap($physique, $physiquesize, $AMCTraits.physique), percentage: false, callback: (value) => { State.variables.xchange = State.variables.xchange || {}; State.variables.xchange.physiqueCheatTarget = value; if (typeof window.updatePhysique === "function") { try { window.updatePhysique(); } catch (e) {} } } }>>
			<<numberStepper "<<symbol willpower>> 의지력" $willpower "willpower" {max: amcDisplayCap($willpower, 1000, $AMCTraits.willpower), percentage: false}>>
			<<numberStepper "<<symbol awareness>> 인식" $awareness "awareness" {min: -200, max: 1000, reverse: true}>>
			<<numberStepper "<<symbol promiscuity>> 음란도" $promiscuity "promiscuity" {reverse: true}>>
			<<numberStepper "<<symbol exhibitionism>> 노출증" $exhibitionism "exhibitionism" {reverse: true}>>
			<<numberStepper "<<symbol deviancy>> 이상성욕" $deviancy "deviancy" {reverse: true}>>
			<<if numberOfEarSlime()>>
				<<numberStepper "<<symbol corruption>> 타락도" $earSlime.corruption { callback: value => {V.earSlime.corruption = value; Wikifier.wikifyEval("<<updatesidebarimg>>")}, reverse: true}>>
			<</if>>
		<<case "sex">>
			<<numberStepper "유혹" $seductionskill "seductionskill" {max: amcDisplayCap($seductionskill, 1000, $AMCTraits.seductionskill), percentage: false}>>
			<<numberStepper "가슴" $chestskill "chestskill" {max: amcDisplayCap($chestskill, 1000, $AMCTraits.chestskill), percentage: false}>>
			<<numberStepper "엉덩이" $bottomskill "bottomskill" {max: amcDisplayCap($bottomskill, 1000, $AMCTraits.bottomskill), percentage: false}>>
			<<if $player.vaginaExist>><<numberStepper "보지" $vaginalskill "vaginalskill" {max: amcDisplayCap($vaginalskill, 1000, $AMCTraits.vaginalskill), percentage: false}>><</if>>
			<<if $player.penisExist>><<numberStepper "자지" $penileskill "penileskill" {max: amcDisplayCap($penileskill, 1000, $AMCTraits.penileskill), percentage: false}>><</if>>
			<<numberStepper "허벅지" $thighskill "thighskill" {max: amcDisplayCap($thighskill, 1000, $AMCTraits.thighskill), percentage: false}>>
			<<numberStepper "입" $oralskill "oralskill" {max: amcDisplayCap($oralskill, 1000, $AMCTraits.oralskill), percentage: false}>>
			<<numberStepper "손" $handskill "handskill" {max: amcDisplayCap($handskill, 1000, $AMCTraits.handskill), percentage: false}>>
			<<numberStepper "애널" $analskill "analskill" {max: amcDisplayCap($analskill, 1000, $AMCTraits.analskill), percentage: false}>>
			<<numberStepper "발" $feetskill "feetskill" {max: amcDisplayCap($feetskill, 1000, $AMCTraits.feetskill), percentage: false}>>
		
		<<case "hypnosis">>
			<br>
			<<set V.cheats to V.cheats or {}>>
			<<numberStepper "갈망" $hypnosis_traits.scream {callback: value => { V.hypnosis_traits.scream = value }, step: 1, max: 5, percentage: false}>>
			<<numberStepper "노출" $hypnosis_traits.cover {callback: value => { V.hypnosis_traits.cover = value }, step: 1, max: 5, percentage: false}>>
			<<numberStepper "이상성욕" $hypnosis_traits.deviancy {callback: value => { V.hypnosis_traits.deviancy = value }, step: 1, max: 5, percentage: false}>>
			<<numberStepper "크로스드레싱" $hypnosis_traits.crossdressing {callback: value => { V.hypnosis_traits.crossdressing = value }, step: 1, max: 5, percentage: false}>>
		<<default>>
			에러: 스킬 문제.
	<</switch>>
<</widget>>
