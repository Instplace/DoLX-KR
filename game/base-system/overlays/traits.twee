					has: $anxiety gte 1,
					text: "스트레스가 시간이 지나도 저절로 감소하지 않음.",
					textColour: () => V.controlled === 0 ? "red" : "black",
				},
				{
					name: () => V.controlled === 0 ? "심각한 불안 장애" : "통제된 심각한 불안 장애",
					colour: () => V.controlled === 0 ? "red" : "blue",
					has: $anxiety gte 2,
					text: "스트레스가 시간이 지나면서 증가함.",
					textColour: () => V.controlled === 0 ? "red" : "black",
