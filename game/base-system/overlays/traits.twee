:: Traits [widget]
<<widget "traits">>
	<<if $sexStats?.pills>>
		<<set _pills to $sexStats.pills.pills>>
	<</if>>
	<<set _amcTraitName to (name, stat) => `<mouse class='tooltip green'>${name}<span>
		보정치:
		<ul>
			<li class='green'>${stat} 포인트 상한 +100%.</li>
		</ul>
	</span></mouse>`>>
	<<set _traitLists to [
		{
			title: "일반 특성",
			traits: [
				{
					name: "어둠 속에서 더듬거림",
					colour: "red",
					has: blindSkillFailureChance() > 0,
					text: () => "눈이 가려져 있어 앞이 보이지 않는 채로 더듬거리느라 스킬 판정이 " + blindSkillFailureChance() + "% 확률로 실패합니다. 적응력을 쌓으면 이 확률이 차츰 사라집니다." + (pcHasBlindCane() ? " 지팡이가 남은 확률을 20% 줄여 주지만, 지팡이에 의지하면 적응 훈련 속도가 평소의 4분의 1로 느려집니다. 지팡이를 잃거나 부러뜨리면 이 도움이 사라집니다." : ""),
				},
				{
					name: "적응력",
					colour: "green",
					has: blindAdaptationStrength() > 0,
					text: () => {
						const text = ["시각 없이 연습한 정도: " + Math.floor(blindAdaptationStrength() * 100) + "%. 완전히 적응하면 실명 페널티가 사라집니다."];
						if (blindAdaptationStrength() < 1) text.push(pcHasBlindCane() ? "지팡이에 의지한 채 눈을 가리고 훈련하면 28일이 걸립니다. 동물 감각 보너스는 제외한 기간입니다." : "눈을 가리고 훈련하면 7일이 걸립니다. 동물 감각 보너스는 제외한 기간입니다.");
						if (V.blindAdaptation?.locked) {
							text.push("당신의 적응력은 고정되어 더 이상 사라지지 않습니다.");
						} else if (V.hypnosis_traits.adaptability) {
							text.push("최면에 의한 적응력 덕분에 이 진행도가 사라지지 않습니다.");
						} else {
							text.push("눈을 가리지 않으면 진행도가 사라집니다.");
							const senses = [
								["wolf", "늑대의 후각"], ["bear", "곰의 후각"], ["cat", "고양이의 반사 신경"],
								["fox", "여우의 청각"], ["bunny", "토끼의 청각"], ["waterdragon", "수룡의 반향 감각"],
								["bird", "하피의 평정"], ["cow", "젖소의 평정"]
							].filter(([animal]) => Transformations.effectiveLevel(animal) >= 2).map(([, sense]) => sense);
							if (senses.length) text.push("" + senses.join(", ") + " 보너스: 훈련 속도 증가, 감소 속도 둔화 (각각 +25%).");
						}
						if (Transformations.effectiveLevel("bird") >= 2 || Transformations.effectiveLevel("cow") >= 2) text.push("눈을 가리면 스트레스도 완화됩니다.");
						if (V.backgroundTraits.includes("insanity") && !V.insanityPermanent) text.push("눈을 가리면 얻게 된 광기로 인한 트라우마가 서서히 완화됩니다.");
						return text.join(" ");
					},
				},
				{
					name: () => "향수: " + Util.escapeMarkup(setup.perfumery.scent().name),
					colour: "purple",
					has: !!setup.perfumery.scent(),
					text: () => setup.perfumery.effects().join(" "),
				},
				{
					name: "순결한",
					colour: "green",
					has: playerCountsAsVirgin(),
					text: "순결도가 더 빨리 회복됩니다. 당신의 처녀와 동정은 꽤 가치 있을지도 모릅니다.",
				},
				{
					name: "순결 서약",
					colour: "blue",
					has: $player.virginity.temple is true or $player.virginity.temple is 1,
					text: "당신의 <<if $player.penisExist>>자지가 감싸지거나<</if>><<if $player.penisExist and $player.vaginaExist>>, 혹은 당신의 <</if>><<if $player.vaginaExist>>보지가 삽입당하면<</if>> 서약을 잃습니다. 신전이 이 사실을 알게 될 것입니다.",
				},
				{
					name: "깨진 서약",
					colour: "red",
					has: $player.virginity.temple isnot true and $player.virginity.temple isnot 1 and $temple_rank isnot "prospective" and $temple_rank isnot undefined,
					text: "신전이 이 사실을 알게 될 것입니다.",
				},
				{
					name: "신전의 짐: $temple_burden%",
					colour: "blue",
					has: $temple_burden gte 1,
					text: "당신은 세상에 퍼진 타락의 일부를 몸 안에 짊어지고 있습니다. 체격, 의지력, 체육, 춤, 속임수, 수영, 관리, 가사, 영어 스킬 판정이 $temple_burden% 확률로 자동 실패합니다.",
				},
				{
					name: "순결 부스트",
					colour: "green",
					has: $featsPurityBoost gt 0,
					text: () => {
						let dailyPurity = 1;
						if (Transformations.effectiveLevel("fallen") >= 2) dailyPurity -= 10;
						if (playerCountsAsVirgin()) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "매일 순결도를 얻고 있습니다.";
						if (dailyPurity + V.featsPurityBoost === 0) return "매일 순결도를 잃지 않고 있습니다.";
						return "매일 순결도를 덜 잃고 있습니다.";
					},
				},
				{
					name: "불결 부스트",
					colour: "red",
					has: $featsPurityBoost lt 0,
					text: () => {
						let dailyPurity = 1;
						if (Transformations.effectiveLevel("fallen") >= 2) dailyPurity -= 10;
						if (playerCountsAsVirgin()) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "매일 순결도를 덜 얻고 있습니다.";
						if (dailyPurity + V.featsPurityBoost === 0) return "매일 순결도를 얻지 못하고 있습니다.";
						return "매일 순결도를 잃고 있습니다.";
					},
				},
				{
					name: "가학 성향 강화",
					colour: "red",
					has: $featsSadismBoost gt 0,
					text: () => {
						let dailySadism = 1;
						if (dailySadism + V.featsSadismBoost > 0) return "매일 사디즘을 얻고 있습니다.";
						if (dailySadism + V.featsSadismBoost === 0) return "매일 사디즘을 얻지 못하고 있습니다.";
						return "매일 사디즘을 얻고 있습니다.";
					},
				},
				{
					name: "피학 성향 강화",
					colour: "pink",
					has: $featsMasochismBoost gt 0,
					text: () => {
						let dailyMasochism = 1;
						if (dailyMasochism + V.featsMasochismBoost > 0) return "매일 마조히즘을 얻고 있습니다.";
						if (dailyMasochism + V.featsMasochismBoost === 0) return "매일 마조히즘을 얻지 못하고 있습니다.";
						return "매일 마조히즘을 얻고 있습니다.";
					},
				},
				{
					name: () => [
						"<mouse class='tooltip'><span style='background: linear-gradient(to right, rgb(139, 0, 0) 0%, rgb(255, 60, 60) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: bold;'>광기</span><span>",
						"공기의 무게가 고문과도 같습니다. 당신은 더 이상 자신이 누구인지 알 수 없습니다.",
						"<br><br>",
						"보정치:",
						"<ul>",
						"<li class='red'>체격 상승량 -75%.</li>",
						"<li class='red'>수영 상승량 -75%.</li>",
						"<li class='red'>의지력 상승량 -75%.</li>",
						"<li class='red'>난투 상승량 -50%.</li>",
						"<li class='red'>풋워크 상승량 -25%.</li>",
						"<li class='red'>타격 상승량 -25%.</li>",
						"<li class='red'>발차기 상승량 -25%.</li>",
						"<li class='red'>체육 상승량 -25%.</li>",
						"<li class='red'>춤 상승량 -25%.</li>",
						"<li class='red'>학업 상승량 -50%.</li>",
						"<li class='red'>범죄도 상승량 +50%.</li>",
						"<li class='red'>불량도 상승량 +25%.</li>",
						V.background?.insanity === true ? "<li class='orange'>모든 캐릭터 재능을 강제로 활성화하고 모든 스킬 상한을 두 배로 늘립니다.</li>" : "",
						"<li class='orange'>민감도 증가가 크게 억제됩니다.</li>",
						"</ul>",
						"감소:",
						"<ul>",
						"<li class='red'>체격 감소량 +25%.</li>",
						"</ul>",
						"</span></mouse>",
					].join(""),
					colour: "red",
					has: $backgroundTraits.includes("insanity"),
					text: () => {
						const base = V.insanityPermanent
							? "정신병질이 깊이 뿌리내렸습니다. 어둠은 절대적이며, 이 부서진 환상이 이제 당신의 영원한 현실입니다."
							: "그림자가 스며들고 있습니다. 오래 이어진 트라우마가 당신의 인식을 산산조각 내, 예전의 당신이 누구였는지 흐릿해지고 있습니다.";
						return V.innocencestate === 1
							? base + " <i>순수함이 당신 정신의 부담을 덜어 줍니다.</i>"
							: base;
					},
				},
				{
					name: "<mouse class='tooltip lblue'>여장 취향<span>
						보정치:
						<ul>
							<li class='green'>원래 성별과 반대되는 성별 상승량 +25%.</li>
							<li class='red'>원래 성별과 일치하는 성별 상승량 -50%.</li>
							<li class='orange'>이 배율은 성 정체성 태도 설정을 무시하며, 설정과 상관없이 항상 적용됩니다.</li>
						</ul>
					</span></mouse>",
					colour: "pink",
					has: $backgroundTraits.includes("crossdresser") and !$background.transgender and playerOriginalSex() is "m",
					text: "소녀처럼 입고 있으면 스트레스가 더 빨리 줄고, 소년처럼 입고 있으면 더 느리게 줄어듭니다. 또한 자신을 소녀로 보는 것도 훨씬 쉬워집니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>여장 취향<span>
						보정치:
						<ul>
							<li class='green'>원래 성별과 반대되는 성별 상승량 +25%.</li>
							<li class='red'>원래 성별과 일치하는 성별 상승량 -50%.</li>
							<li class='orange'>이 배율은 성 정체성 태도 설정을 무시하며, 설정과 상관없이 항상 적용됩니다.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("crossdresser") and !$background.transgender and playerOriginalSex() is "f",
					text: "소년처럼 입고 있으면 스트레스가 더 빨리 줄고, 소녀처럼 입고 있으면 더 느리게 줄어듭니다. 또한 자신을 소년으로 보는 것도 훨씬 쉬워집니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>트랜스젠더<span class='green'>당신은 태어난 성별과 다른 성별이라는 것을 늘 알고 있었으며, 아무리 다르게 입어도 그것은 바뀌지 않습니다. (정체성은 세상이 정해 주는 것이 아니라 당신이 스스로 정하는 것입니다.)</span></mouse>",
					colour: "lblue",
					has: $background.transgender,
					text: "당신은 자신이 태어난 성별과 다른 성별이라는 것을 알고 있습니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>성별 불안<span>
						보정치:
						<ul>
							<li class='green'>원래 성별과 일치하는 성별 상승량 +25%.</li>
							<li class='red'>원래 성별과 반대되는 성별 상승량 -50%.</li>
							<li class='orange'>이 배율은 성 정체성 태도 설정을 무시하며, 설정과 상관없이 항상 적용됩니다.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("genderAnxious") and playerOriginalSex() is "m",
					text: "당신은 자신의 여성적인 면을 받아들이기가 더 어렵습니다. 소년처럼 입고 있으면 스트레스가 더 빨리 줄고, 소녀처럼 입고 있으면 더 느리게 줄어듭니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>성별 불안<span>
						보정치:
						<ul>
							<li class='green'>원래 성별과 일치하는 성별 상승량 +25%.</li>
							<li class='red'>원래 성별과 반대되는 성별 상승량 -50%.</li>
							<li class='orange'>이 배율은 성 정체성 태도 설정을 무시하며, 설정과 상관없이 항상 적용됩니다.</li>
						</ul>
					</span></mouse>",
					colour: "pink",
					has: $backgroundTraits.includes("genderAnxious") and playerOriginalSex() is "f",
					text: "당신은 자신의 남성적인 면을 받아들이기가 더 어렵습니다. 소녀처럼 입고 있으면 스트레스가 더 빨리 줄고, 소년처럼 입고 있으면 더 느리게 줄어듭니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>너드<span>
						Modifiers:
						<ul>
							<li class='green'>학업 상승량 +100%.</li>
							<li class='green'>의지력 상승량 +100%.</li>
							<li class='green'>좋은 명성 상승량 +100%.</li>
							<li class='green'>불량도 상승량 -75%.</li>
							<li class='green'>범죄도 상승량 -50%.</li>
							<li class='red'>체격 상승량 -75%.</li>
							<li class='red'>수영 상승량 -75%.</li>
							<li class='red'>난투 상승량 -50%.</li>
							<li class='red'>풋워크 상승량 -25%.</li>
							<li class='red'>타격 상승량 -25%.</li>
							<li class='red'>발차기 상승량 -25%.</li>
							<li class='red'>체육 상승량 -25%.</li>
							<li class='red'>춤 상승량 -25%.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>체격 감소량 +25%.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("nerd"),
					text: "학교에서 훨씬 빨리 배웁니다. 하지만 운동과 조금이라도 관련된 일에는 고전합니다. 또한 학교 내 지위를 올리기도 더 어렵습니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>불량 학생<span>
						Modifiers:
						<ul>
							<li class='green'>난투 상승량 +50%.</li>
							<li class='green'>속임수 상승량 +25%.</li>
							<li class='green'>학교 내 지위 상승량 +25%.</li>
							<li class='green'>풋워크 상승량 +25%.</li>
							<li class='green'>타격 상승량 +25%.</li>
							<li class='green'>발차기 상승량 +25%.</li>
							<li class='red'>범죄도 상승량 +50%.</li>
							<li class='red'>불량도 상승량 +25%.</li>
							<li class='red'>학업 상승량 -50%.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("delinquent"),
					text: "사람들이 당연하게 당신을 멋지다고 생각하므로 학교 내 지위가 더 쉽게 오릅니다. 속임수에도 재능이 있습니다. 하지만 학업에는 고전합니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>운동선수<span>
						Modifiers:
						<ul>
							<li class='green'>체격 상승량 +25%.</li>
							<li class='green'>체육 상승량 +25%.</li>
							<li class='green'>수영 상승량 +25%.</li>
							<li class='green'>춤 상승량 +10%.</li>
							<li class='red'>학업 상승량 -25%.</li>
						</ul>
						Decay:
						<ul>
							<li class='green'>체격 감소량 -75%.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("athlete"),
					text: "스포츠와 신체를 통한 자기표현에 뛰어납니다. 그래서 체격에도 그것이 드러납니다. 하지만 학업은 도무지 머리에 들어오지 않습니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>문란함<span>
						Modifiers:
						<ul>
							<li class='green'>유혹 상승량 +25%.</li>
							<li class='green'>섹스 스킬 상승량 +25%.</li>
							<li class='red'>성지식 상승량 +25%.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>성지식 감소량 -50%.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
					has: $backgroundTraits.includes("promiscuous"),
					text: "당신은 꽤 경험이 많습니다. 섹스 스킬과 유혹이 자연스럽게 몸에 뱄습니다. 하지만 그만큼 남들이 외면하는 것을 기이할 정도로 잘 알게 됩니다.",
				},
				{
					name: "<mouse class='tooltip lblue'>노출증<span>
						Modifiers:
						<ul>
							<li class='green'>노출 명성 상승량 -75%.</li>
							<li class='red'>성지식 상승량 +25%.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>성지식 감소량 -50%.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
