						};

						return `<mouse class='tooltip ${colour}'>${heading}: ${autismLoadPercent()}% 부하
							<span class='tooltiptext'>
								자폐 스펙트럼에서 비롯됩니다. 부하는 현재의 요구에 얼마나 대처하기 어려운지를 나타냅니다.
								<br><br>

								현재 효과:
								<ul>
									${effects[capacity] || effects.strained}
								</ul>

								<i class='red'>부하는 갑작스러운 변화, 인파, 소음, 한낮의 강한 빛, 더위, 불분명한 사회적 상황, 너무 오래 쉬지 못하는 것으로 늘어납니다.</i>
								<i class='green'>부하는 수면, 조용한 시간, 차분한 활동, 현재 관심사에 시간을 쓰는 것으로 줄어듭니다.</i>
								<i class='green'>헤드폰은 시끄러운 곳에서 소음 대부분을 막아 주고, 음악을 틀면 더 많이 막아 줍니다.</i>
								<br><br>
								오늘 <b class='gold'>${autismRecoveryLeftToday()}</b>만큼의 부하를 더 회복할 수 있습니다.
								<b class='gold'>${autismDeliberateLeftToday()}</b>는 의도적인 조절이 필요합니다.
								<br><br>
								의지력이 긴장과 번아웃이 시작되는 시점에 영향을 줍니다.
								<br>
								<b class='gold'>긴장: ${autismStrainedThreshold()}% 부하</b>
								<br>
								<b class='red'>번아웃: ${autismBurnoutThreshold()}% 부하</b>
								<br><br>
								<b class='red'>${autismMeltdownLoadValue()}% 부하</b>이면서 동시에 <b class='red'>${autismMeltdownStressPercent()}% 스트레스</b> 상태이면 멜트다운이 일어날 수 있습니다.
								<b class='red'>${autismLoadTraumaValue()}% 부하</b> 상태로 하루 종일 쉬지 못하면 트라우마가 생깁니다.
							</span>
						</mouse>`;
					},
					colour: () => {
						const capacity = autismSpectrumPhase();
						return capacity === "settled" ? "green" : capacity === "burnout" ? "red" : "gold";
					},
					has: playerHasAutismSpectrum(),
					text: () => {
						const capacity = autismSpectrumPhase();

						if (capacity === "settled") return "부하가 낮아 일상의 요구를 감당하기가 더 쉽습니다.";
						if (capacity === "burnout") return "부하가 매우 높아 상승량이 줄고 일부 활동이 더 해롭게 작용합니다.";
						return "부하가 충분히 높아 더 이상 낮은 부하의 이점을 받지 못합니다.";
					},
				},
				{
					name: () => {
						const items = autismObligationLabels();
						return `<mouse class='tooltip red'>미해결: ${items.length}
							<span class='tooltiptext'>
								자폐 스펙트럼에서 비롯됩니다. 알고 있지만 아직 처리하지 못한 일이나 문제입니다.
								<br><br>
								<ul>
									${items.map(item => `<li class='red'>${item.toUpperFirst()}</li>`).join("")}
								</ul>
								<b class='red'>미해결 항목은 처리하기 전까지 하루마다 부하를 더합니다.</b>
								항목을 처리하면 더 이상 부하를 더하지 않습니다.
							</span>
						</mouse>`;
					},
					colour: "red",
					has: playerHasAutismSpectrum() && autismObligationLabels().length > 0,
					text: "아직 처리해야 한다고 알고 있는 일들이 하루마다 부하를 더합니다.",
				},
				{
					name: () => {
						const masking = autismMaskingLevel();
						const colour = masking >= 70 ? "red" : masking >= 35 ? "gold" : "purple";
						const active = autismMaskingActive()
							? "<b class='gold'>지금 마스킹 중입니다.</b>"
							: "지금은 마스킹하지 않습니다.";
						const composure =
							autismComposureLeft() > 0
								? "<b class='green'>미리 마음의 준비를 했습니다. 앞으로 약 " +
									autismComposureLeft() +
									"분 동안 마스킹이 더 느리게 쌓입니다.</b>"
								: "";
						return `<mouse class='tooltip ${colour}'>마스킹: ${masking}%
							<span class='tooltiptext'>
								자폐 스펙트럼에서 비롯됩니다. 마스킹은 다른 사람들이 기대하는 모습에 맞추어 행동을 바꾸는 것을 뜻합니다.
								<br><br>
								${active}
								<br><br>
								보정치:
								<ul>
									<li class='red'>마스킹은 부하를 더합니다. 마스킹이 높을수록 부하가 더 빨리 쌓입니다.</li>
									<li class='red'>너무 오래 마스킹하면 과부하 중에 셧다운이 일어날 가능성이 커집니다.</li>
									<li class='green'>혼자 있을 때 마스킹을 멈추면 부하 일부가 사라지고 스트레스가 줄어듭니다.</li>
								</ul>
								마스킹은 낯선 사람 곁에서 더 빨리 쌓이고, 믿는 사람 곁에서는 더 느리게 쌓입니다.
								혼자 있거나 잠든 동안에는 쌓이지 않습니다. 잠을 자면 부하를 더하지 않고 마스킹이 줄어듭니다.
								함께 사는 사람들은 집에 있는 동안 곁에 있는 것으로 칩니다.
								<br><br>
								${composure}
							</span>
						</mouse>`;
					},
					colour: () => {
						const masking = autismMaskingLevel();
						return masking >= 70 ? "red" : masking >= 35 ? "gold" : "purple";
					},
					has: playerHasAutismSpectrum(),
					text: () => {
						const masking = autismMaskingLevel();

						if (!autismMaskingActive()) return masking > 0 ? "지금은 마스킹하지 않습니다. 회복하면서 마스킹 수준이 서서히 줄어들고 있습니다." : "마스킹하지 않습니다.";
						if (masking >= 70) return "마스킹이 주의력 대부분을 차지하고 있습니다.";
						if (masking >= 35) return "마스킹에 꾸준한 노력이 들어갑니다.";
						if (masking > 0) return "별다른 노력 없이 마스킹하고 있습니다.";
						return "마스킹을 시작하고 있습니다.";
					},
					meter: {
						has: playerHasAutismSpectrum(),
						value: autismMaskingLevel(),
						min: 0,
						max: 100,
						colour: "purplebar",
					},
				},
				{
					name: () => `<mouse class='tooltip gold'>현재 관심사: ${autismHyperfixationName().toUpperFirst()}
						<span class='tooltiptext'>
							자폐 스펙트럼에서 비롯됩니다. 앞으로 몇 주 동안 당신을 가장 강하게 끌어당기는 활동입니다.
							조절하는 데 도움이 될 수 있습니다.
							<br><br>
							보정치:
							<ul>
								<li class='green'>이 활동을 연습하면 스트레스와 부하가 줄어듭니다.</li>
								<li class='red'>갑자기 작업을 바꾸면 스트레스와 부하가 늘어납니다.</li>
								<li class='red'>2시간 넘게 쉬지 않고 연습하면 상승량이 최대 25% 줄어들 수 있습니다.</li>
								<li class='orange'>3시간 쉬면 이 연습 페널티가 사라집니다.</li>
								<li class='orange'>수업, 공부, 수영, 춤, 관리, 가사, 훈련이 연습으로 칩니다.</li>
							</ul>
						</span>
					</mouse>`,
					colour: "gold",
					has: playerHasAutismSpectrum(),
					text: () => {
