					},
				},
				{
					name: () => `<mouse class='tooltip red'>${autismOverloadForm() === "shutdown" ? "셧다운" : "멜트다운"}
						<span class='tooltiptext'>
							자폐 스펙트럼에서 비롯됩니다. 스트레스와 부하가 모두 매우 높아지면 멜트다운이나 셧다운이 일어날 수 있습니다.
							<br><br>
							보정치:
							<ul>
								<li class='red'>모든 활동의 상승량 -35%.</li>
								<li class='red'>갑작스러운 변화와 장시간 연습이 스트레스 대신 트라우마를 일으킵니다.</li>
								<li class='green'>현재 관심사가 여전히 스트레스와 부하를 줄여 줄 수 있습니다.</li>
								<li class='green'>스트레스가 70% 이하로 떨어지면 과부하가 끝납니다.</li>
							</ul>
							차분해지는 활동이 스트레스를 줄이는 데 도움이 됩니다.
						</span>
					</mouse>`,
					colour: "red",
					has: playerHasAutismSpectrum() && autismInMeltdown(),
					text: "압도당했습니다. 스트레스가 내려갈 때까지 다른 활동이 훨씬 어렵습니다.",
				},
				{
					name: () => V.submissive <= 850 ? "나무성애자" : "식물 애호가",
					colour: "lewd",
					has: $backgroundTraits.includes("plantlover"),
					text: "당신에게 식물은 전부입니다. 더 이상 환각 수치가 없어도 인간형 식물과 식물형 촉수를 마주칠 수 있습니다. 트라우마가 증가할수록 관리 스킬에 보너스를 받습니다.",
				},
				{
					name: "넥타르 중독",
					colour: "red",
					has: $backgroundTraits.includes("plantlover"),
					text: () =>
						"당신은 최음제와 알코올에 더 취약합니다. 넥타르에서 영양을 얻습니다. 넥타르를 마시면 몸에 활력이 돌아 체격이 오르고 스트레스가 줄어듭니다. 오랫동안 넥타르를 마시지 않으면 몸에 부담이 쌓여 결국 이 특성과 <<if $submissive lte 850>><span class='lewd'>나무성애자</span><<else>><span class='lewd'>식물 애호가</span><</if>> 특성이 사라집니다." +
						(wearingTidebloomRing()
							? " <span class='green'>조수꽃 반지를 끼고 있는 동안에는 이 특성이 유지됩니다.</span>"
							: "") +
						"<span class='hidden'></span>",
				},
				{
					name: () => {
						return (earSlimeThoughts() ? "내면의 목소리 집중: " : "귀 슬라임 집중: ") + $earSlime.focus;
					},
					colour: "lewd",
					has: $earSlime.focus and $earSlime.focus isnot "none",
					text: () => {
						let result;
						switch ($earSlime.focus) {
							case "pregnancy":
								result = `임신의 길을 선택했습니다. ${earSlimeThoughts() ? "머릿속의 목소리" : "귀 슬라임"}【이가】 임신과 관련된 특성을 증폭시키고, 다른 특성은 약화시킵니다.`;
								break;
							case "mixed":
								result = `임신과 임신시키기 사이의 길을 선택했습니다. ${earSlimeThoughts() ? "머릿속의 목소리" : "귀 슬라임"}【이가】 두 쪽 모두와 관련된 특성을 덜한 정도로 증폭시킵니다.`;
								break;
							case "impregnation":
								result = `임신시키기의 길을 선택했습니다. ${earSlimeThoughts() ? "머릿속의 목소리" : "귀 슬라임"}【이가】 타인을 임신시키는 일과 관련된 특성을 증폭시키고, 다른 특성은 약화시킵니다.`;
								break;
						}
						let parasites = [];
						if ($parasite.breasts?.name is "parasite") {
							if ($player.breastsize gte 1) {
								parasites.push("가슴");
							} else {
								parasites.push("흉부");
							}
						}
						if ($parasite.clit?.name is "parasite" or $parasite.penis?.name is "parasite") parasites.push("성기");
						if (parasites.length) result += ` 그 기생충들이 옷처럼 당신의 ${parasites.length === 1 ? parasites[0] : parasites.slice(0, -1).join(", ") + "와 " + parasites[parasites.length - 1]}【을를】 덮고 있습니다.`;
						return result;
					}
				},
				{
					name: "임신",
					colour: "lewd",
					has: playerIsPregnant() and playerAwareTheyArePregnant(),
					text: () => playerBellySize() lt 10 or playerNormalPregnancyTotal() gte 20 ? "임신 중입니다." : "임신 중입니다. 배가 커질수록 일부 스킬에 페널티를 받습니다.",
				},
				{
					name: "초보 어머니",
					colour: "lewd",
					has: playerNormalPregnancyTotal() is 1,
					text: "첫 아이를 출산했습니다. 임신으로 인한 신체적 페널티가 줄어듭니다.",
				},
				{
					name: "두 번째 어머니",
					colour: "lewd",
					has: playerNormalPregnancyTotal() is 2,
					text: "이제 아이를 두 번 출산했습니다. 임신으로 인한 신체적 페널티가 줄어듭니다.",
				},
				{
					name: "어머니",
					colour: "lewd",
					has: between(playerNormalPregnancyTotal(), 3, 7),
					text: "어머니로서 꽤 좋은 경험을 가지고 있습니다. 임신으로 인한 신체적 페널티가 적당히 줄어듭니다.",
				},
				{
					name: "부화장 어머니",
					colour: "lewd",
					has: between(playerNormalPregnancyTotal(), 8, 19),
					text: "아주, 아주 많은 아이를 낳았습니다. 임신으로 인한 신체적 페널티가 크게 줄어듭니다.",
				},
				{
					name: "가이아",
					colour: "gold",
					has: playerNormalPregnancyTotal() gte 20,
					text: "당신은 말 그대로 아이들의 왕국을 낳았습니다. 임신으로 인한 신체적 페널티가 없어집니다.",
