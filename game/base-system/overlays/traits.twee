		{
			title: "트라우마 특성",
			traits: [
				{
					name: () => {
						const opiumSuppressed = Array.isArray(V.backgroundTraits)
							&& V.backgroundTraits.includes("opiumaddict")
							&& !!V.poppyDrug?.insomniaSuppress;
						const pillSuppressed = typeof insomniaSuppressedBySleepAid === "function"
							&& insomniaSuppressedBySleepAid();
						if (V.hypnosis_traits.slumber || opiumSuppressed || pillSuppressed) return "억제된 불면증";
						return V.controlled === 0 ? "불면증" : "통제된 불면증";
					},
					colour: () => {
						const opiumSuppressed = Array.isArray(V.backgroundTraits)
							&& V.backgroundTraits.includes("opiumaddict")
							&& !!V.poppyDrug?.insomniaSuppress;
						const pillSuppressed = typeof insomniaSuppressedBySleepAid === "function"
							&& insomniaSuppressedBySleepAid();
						if (V.hypnosis_traits.slumber || opiumSuppressed || pillSuppressed) return "black";
						return V.controlled === 0 ? "red" : "blue";
					},
					has: $sleeptrouble gte 1
						or $hypnosis_traits.slumber
						or (Array.isArray($backgroundTraits) and $backgroundTraits.includes("opiumaddict") and $poppyDrug?.insomniaSuppress)
						or (typeof insomniaSuppressedBySleepAid === "function" and insomniaSuppressedBySleepAid()),
					text: () => {
						const opiumSuppressed = Array.isArray(V.backgroundTraits)
							&& V.backgroundTraits.includes("opiumaddict")
							&& !!V.poppyDrug?.insomniaSuppress;
						const pillSuppressed = typeof insomniaSuppressedBySleepAid === "function"
							&& insomniaSuppressedBySleepAid();

						if (V.hypnosis_traits.slumber || opiumSuppressed || pillSuppressed) {
							return "불면증이 억제되어 있습니다. 정상적으로 잠들 수 있습니다.";
						}
						return "잠을 자도 덜 쉬게 됩니다.";
					},
					textColour: () => {
						const opiumSuppressed = Array.isArray(V.backgroundTraits)
							&& V.backgroundTraits.includes("opiumaddict")
							&& !!V.poppyDrug?.insomniaSuppress;
						const pillSuppressed = typeof insomniaSuppressedBySleepAid === "function"
							&& insomniaSuppressedBySleepAid();
						return V.controlled === 0
							&& !V.hypnosis_traits.slumber
							&& !opiumSuppressed
							&& !pillSuppressed
							? "red"
							: "black";
					},
				},
				{
					name: "진정제 의존",
					colour: "red",
					has: typeof sleepAidDependenceLevel === "function" and sleepAidDependenceLevel() gte 1,
					text: () => sleepAidDependenceLevel() >= 2
						? "이제 수면제에 의존하고 있습니다. 수면제가 없으면 거의 잠들 수 없습니다."
						: "몸이 수면제에 익숙해지고 있습니다. 수면제가 없으면 잠을 잘 이루지 못합니다.",
					textColour: "red",
				},
				{
					name: "항우울제",
					colour: "blue",
					has: typeof antidepressantActive === "function" and antidepressantActive(),
					text: "스트레스가 더 느리게 오르지만, 더 빨리 피곤해집니다.",
					textColour: "black",
				},
				{
					name: () => V.controlled === 0 ? "악몽" : "통제된 악몽",
