	<<if playerHasVibratorRemote()>>
		<br><br>
		<span class="sti-vibe-line">
			<<sextoysicon>><b>바이브레이터:</b>
			<a class="sti-vibe-link" onclick="window.togglePlayerVibrator(this)"><<if playerVibratorOn()>>켜짐<<else>>꺼짐<</if>></a>
			<span class="sti-vibe-sep">|</span>
			<b>세기:</b>
			<a class="sti-vibe-link" onclick="window.changePlayerVibratorPower(-1, this.parentElement.querySelector('.sti-vibe-power'))">−</a>
			<a class="sti-vibe-power" onclick="window.changePlayerVibratorPower(1, this)"><<print $worn.vibrator.power>>/<<print $worn.vibrator.powerMax>></a>
			<a class="sti-vibe-link" onclick="window.changePlayerVibratorPower(1, this.parentElement.querySelector('.sti-vibe-power'))">+</a>
		</span>
	<</if>>
<</if>> /* if for special description in stat freeze */
	<br><br>
	<<bodywriting>>

	현재 바깥 기온은 <span class="teal"><<print Weather.toSelectedString(Weather.temperature, 0)>></span>입니다.
	<<print setup.WeatherDescriptions.extremeTemperature()>>
	<br><br>

	/* Temporary on-the-go controls for alt position clothing */
	<<foldout false _altclothingcharacteristics>>
		<span class="gold">의상 스타일 변경:</span>
		<ul>
		<<if $worn.face.name isnot "naked">>
			<li>$worn.face.name:<br>
			<<if wornSetupClothes("face").altposition>>
				<<toggleAltLink "face">>
				<<set _anyAltPositions to 1>>
			<</if>>
			<<toggleFaceLayer>>
			<<set _anyAltPositions to 1>>
			</li>
		<</if>>
		<<if $worn.neck isnot "naked">>
			<li>$worn.neck.name:<br>
			<<if wornSetupClothes("neck").altposition>>
				<<toggleAltLink "neck">>
			<</if>>
			/* <<toggleNeckTuck>> */
			<<set _anyAltPositions to 1>>
			</li>
		<</if>>
		<<if $worn.over_upper.name isnot "naked">>
			<li>$worn.over_upper.name:<br>
			<<if wornSetupClothes("over_upper").altposition>>
				<<toggleAltLink "over_upper">>
				<<set _anyAltPositions to 1>>
			<</if>>
			</li>
		<</if>>
		<<if $worn.upper.name isnot "naked">>
			<li>$worn.upper.name:<br>
			<<if $worn.lower.name isnot "naked" and $worn.upper.outfitPrimary is undefined and !setup.clothes.upper[clothesIndex("upper",$worn.upper)].notuck>>
				<<toggleUpperTuck>>
				<<set _anyAltPositions to 1>>
			<</if>>
			<<if isConnectedToHood("upper")>>
				<!-- If selected item is a hood or selected item has a secondary hood piece -->
				<<toggleHoodLink "outside">>
				<<set _anyAltPositions to 1>>
			<</if>>
			<<if wornSetupClothes("upper").altposition>>
				<<toggleAltLink "upper">>
				<<set _anyAltPositions to 1>>
			<</if>>
			<<if wornSetupClothes("upper").altsleeve and !($worn.upper.variable is "schoolcardigan" and $worn.upper.altposition isnot "alt")>>
				<<toggleAltSleeve>>
				<<set _anyAltPositions to 1>>
			<</if>>
			</li>
		<</if>>
		<<if $worn.feet.name isnot "naked" and $worn.lower.name isnot "naked" and !setup.clothes.feet[clothesIndex("feet",$worn.feet)].notuck and !setup.clothes.lower[clothesIndex("lower",$worn.lower)].notuck>>
			<li>$worn.lower.name:
			<<toggleLowerTuck>>
			<<set _anyAltPositions to 1>>
			</li>
		<</if>>
		<<if !_anyAltPositions>><li>선택할 수 있는 옵션이 없습니다.</li><</if>>
		</ul>
	<</foldout>>

	<div id="characteristics-display">

		<br>
		<span class="gold">핵심 특성</span>
		<div id="base-characteristics" class="characteristic-box-list">
			<!--Core skill configurations-->
			<<silently>>

				<!--GENDER IDENTITY -->
				<<if $xchange.genderIdentityEnabled>>
					<<if playerFeelsManlike()>>
						<<set _icon='misc/icon/male'>>
					<<elseif playerFeelsGirllike()>>
						<<set _icon='misc/icon/female'>>
					<<else>>
						<<set _icon='misc/icon/unisex'>>
					<</if>>
					<<set _genderConfig = { name : "성 정체성", icon : _icon, currentValue : $genderidentity, modifier: 100, modTypes: { good: [], bad: [] },
						states: [
							{ requiredValue: 0,		color: 'blue',	description: '당신은 남성이다.' },
							{ requiredValue: 1,		color: 'navy',	description: '당신은 스스로를 남성이라고 여긴다.' },
							{ requiredValue: 200,	color: 'lblue',	description: '당신은 대체로 스스로를 남성이라고 여긴다.' },
							{ requiredValue: 400,	color: 'teal',	description: '당신은 남성 쪽에 가깝다.' },
							{ requiredValue: 600,	color: 'green',	description: '당신은 논바이너리다.' },
							{ requiredValue: 900,	color: 'teal',	description: '당신은 여성 쪽에 가깝다.' },
							{ requiredValue: 1100,	color: 'lilac',	description: '당신은 대체로 스스로를 여성이라고 여긴다.' },
							{ requiredValue: 1300,	color: 'lewd',	description: '당신은 스스로를 여성이라고 여긴다.' },
							{ requiredValue: 1500,	color: 'pink',	description: '당신은 여성이다.' }
						]
					}>>
					<<if $xchange.giAutoEnabled is true>>
						<<set _giInfoText to "Routine events can change this, and it slowly moves each day toward the direction set by your Identity preferences. You can turn both off in the Attitudes settings.">>
					<<else>>
						<<set _giInfoText to "Routine Gender Identity changes are disabled. Specific story events can still change it. Turn on 'Update Gender Identity from your Identity system' in the Attitudes settings to allow routine changes and daily drift toward your Identity preferences.">>
					<</if>>
					<<set _genderConfig.name to '성 정체성 <mouse class="tooltip small-description">[정보]<span>' + _giInfoText + '</span></mouse>'>>
				<</if>>


				<!--PURITY-->
				<<if _hasDemon>>
					<<set _purityIcon='ui/tf-demon'>>
				<<elseif _hasFallen>>
					<<set _purityIcon='ui/tf-fallen-angel'>>
				<<else>>
					<<set _purityIcon='ui/tf-angel'>>
				<</if>>
				
				
				<<set _purityConfig = { name : "순결함", icon : _purityIcon, displayType : "level", currentValue : $purity, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'red', description: '당신은 돌이킬 수 없이 더럽혀졌다.'},{ requiredValue: 1, level: 1, color: 'red', description: '당신은 철저히 더럽혀진 기분을 느낀다.'},{ requiredValue: 500, level: 2, color: 'pink', description: '당신은 더럽혀졌다고 느낀다.'},{ requiredValue: 600, level: 3, color: 'purple', description: '당신은 약간 더럽혀졌다고 느낀다.'},{ requiredValue: 700, level: 4, color: 'blue', description: '당신은 오염된 기분을 느낀다.'},{ requiredValue: 800, level: 5, color: 'lblue', description: '당신은 살짝 오염된 기분을 느낀다.'},{ requiredValue: 900, level: 6, color: 'teal', description: "당신은 자신이 완전히 순수하지는 않다고 느낀다."},{ requiredValue: 1000, level: 7, color: 'green', description: '당신은 천사와도 같다.'}					]
				}>>

				<!--AWARENESS-->
				<<set _awarenessConfig = { name : "성지식", icon : "ui/sym-awareness", displayType : "level", currentValue : $awareness, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
						{ requiredValue: -200,	level: 0, color: 'green',	description: $innocencestate === 1 ? '당신은 순수하다.' : '당신은 성에 대해 거의 아무것도 모른다.'},
						{ requiredValue: 1,		level: 1, color: 'teal',	description: '당신은 거의 완전히 순수하다.'},
						{ requiredValue: 100,	level: 2, color: 'lblue',	description: '성에 대해 어느 정도 이해하고 있다.'},
						{ requiredValue: 200,	level: 3, color: 'blue',	description: '성에 대해 일반적인 수준으로 이해하고 있다.'},
						{ requiredValue: 300,	level: 4, color: 'purple',	description: '성적 타락에 대한 지식이 평범한 사람들의 수준을 뛰어넘는다.'},
						{ requiredValue: 400,	level: 5, color: 'pink',	description: '당신은 극소수만이 아는 은밀한 것들을 목격했다.'},
						{ requiredValue: 500,	level: 6, color: 'red',		description: '당신은 깊은 타락의 심연을 들여다보았다.'},
						{ requiredValue: 1000,	level: 7, color: 'red',		description: '당신의 이해는 초월적이다.'}
					]
				}>>

				<!--PHYSIQUE-->
				<<if $AMCTraits.physique is 2 or $physique gt $physiquesize>>
					<<set _physiqueConfig = { skill: "physique", name : "체격", icon : "ui/sym-physique", displayType : "level", currentValue : $physique, maxValue: Math.max($physiquesize * $AMCTraits.physique, $physique), modifier: 100, modTypes: { good: [], bad: [] },
						states : [
							{ requiredValue:	0,							level: 0, color: 'red',		description: `당신의 몸은 ${$player.bodyshape === "soft" ? "영양실조 상태다" : "여위었다"}.`},
							{ requiredValue:	$physiquesize / 7,			level: 1, color: 'pink',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "말랑하다" : "마른 편이다"}.`},
							{ requiredValue:	($physiquesize / 7) * 2,	level: 2, color: 'purple',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "부드럽고 유연하다" : "가냘프다"}.`},
							{ requiredValue:	($physiquesize / 7) * 3,	level: 3, color: 'blue',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "균형 잡혀 있다" : "날씬하다"}.`},
							{ requiredValue:	($physiquesize / 7) * 4,	level: 4, color: 'lblue',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "튼튼하고" : "날씬하며"} 건강하다.`},
							{ requiredValue:	($physiquesize / 7) * 5,	level: 5, color: 'teal',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "다부지고" : "탄탄하고"} 탄력이 있다.`},
							{ requiredValue:	($physiquesize / 7) * 6,	level: 6, color: 'green',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "건장하고" : "탄탄하고"} 강력하다.`},
							{ requiredValue:	($physiquesize / 7) * 7,	level: 7, color: 'green',	description: '당신의 몸은 조각처럼 다듬어져 있고 탄탄하다.'},
							{ requiredValue:	($physiquesize / 7) * 8,	level: 8, color: 'gold',	description: '당신의 몸은 조각처럼 뚜렷하고 위압적이다.'},
							{ requiredValue:	($physiquesize / 7) * 9,	level: 9, color: 'gold',	description: '당신의 몸은 단련되어 근육질이다.'},
							{ requiredValue:	($physiquesize / 7) * 10,	level: 10, color: 'gold',	description: '당신의 몸은 근육이 선명하고 우람하다.'},
							{ requiredValue:	($physiquesize / 7) * 11,	level: 11, color: 'gold',	description: '당신의 몸은 근육이 뚜렷하고 헤라클레스 같다.'},
							{ requiredValue:	($physiquesize / 7) * 12,	level: 12, color: 'lustful',description: '당신의 몸은 강력하고 더할 나위 없이 건강하다.'},
							{ requiredValue:	($physiquesize / 7) * 13,	level: 13, color: 'lustful',description: '당신의 몸은 힘과 활력의 정점이다.'}
						]
					}>>
				<<else>>
					<<set _physiqueConfig = { skill: "physique", name : "체격", icon : "ui/sym-physique", displayType : "level", currentValue : $physique, maxValue: $physiquesize, modifier: 100, modTypes: { good: [], bad: [] },
						states : [
							{ requiredValue:	0,							level: 0, color: 'red',		description: `당신의 몸은 ${$player.bodyshape === "soft" ? "영양실조 상태다" : "여위었다"}.`},
							{ requiredValue:	$physiquesize / 7,			level: 1, color: 'pink',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "말랑하다" : "마른 편이다"}.`},
							{ requiredValue:	($physiquesize / 7) * 2,	level: 2, color: 'purple',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "부드럽고 유연하다" : "가냘프다"}.`},
							{ requiredValue:	($physiquesize / 7) * 3,	level: 3, color: 'blue',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "균형 잡혀 있다" : "날씬하다"}.`},
							{ requiredValue:	($physiquesize / 7) * 4,	level: 4, color: 'lblue',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "튼튼하고" : "날씬하며"} 건강하다.`},
							{ requiredValue:	($physiquesize / 7) * 5,	level: 5, color: 'teal',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "다부지고" : "탄탄하고"} 탄력이 있다.`},
							{ requiredValue:	($physiquesize / 7) * 6,	level: 6, color: 'green',	description: `당신의 몸은 ${$player.bodyshape === "soft" ? "건장하고" : "탄탄하고"} 강력하다.`}
						]
					}>>
				<</if>>
				<!--WILLPOWER-->
				<<if $AMCTraits.willpower is 2 or $willpower gt $willpowermax>>
					<<set _willpowerConfig = { skill: "willpower", name : "의지력", icon : "ui/sym-trauma", displayType : "level", currentValue : $willpower, maxValue: Math.max($willpowermax * $AMCTraits.willpower, $willpower), modifier: 100, modTypes: { good: [], bad: [] },
						states : [
							{ requiredValue:	0,							level: 0, color: 'red',		description: '당신은 소심하다.'},
							{ requiredValue:	$willpowermax / 7,			level: 1, color: 'pink',	description: '당신은 소극적이다.'},
							{ requiredValue:	($willpowermax / 7) * 2,	level: 2, color: 'purple',	description: '당신은 신중하다.'},
							{ requiredValue:	($willpowermax / 7) * 3,	level: 3, color: 'blue',	description: '당신은 굳건하다.'},
							{ requiredValue:	($willpowermax / 7) * 4,	level: 4, color: 'lblue',	description: '당신은 단호하다.'},
							{ requiredValue:	($willpowermax / 7) * 5,	level: 5, color: 'teal',	description: '당신은 집요하다.'},
							{ requiredValue:	($willpowermax / 7) * 6,	level: 6, color: 'green',	description: '당신의 의지는 강철 같다.'},
							{ requiredValue:	($willpowermax / 7) * 7,	level: 7, color: 'green',	description: '당신은 꿋꿋하다.'},
							{ requiredValue:	($willpowermax / 7) * 8,	level: 8, color: 'gold',	description: '당신은 흔들림이 없다.'},
							{ requiredValue:	($willpowermax / 7) * 9,	level: 9, color: 'gold',	description: '당신은 불굴이다.'},
							{ requiredValue:	($willpowermax / 7) * 10,	level: 10, color: 'gold',	description: '당신은 굽힐 줄 모른다.'},
							{ requiredValue:	($willpowermax / 7) * 11,	level: 11, color: 'gold',	description: '당신의 의지는 아다만타이트 같다.'},
							{ requiredValue:	($willpowermax / 7) * 12,	level: 12, color: 'lustful',description: '당신의 의지는 무적이다.'},
							{ requiredValue:	($willpowermax / 7) * 13,	level: 13, color: 'lustful',description: '당신의 의지는 타이탄 같다.'}
						]
					}>>
				<<else>>
					<<set _willpowerConfig = { skill: "willpower", name : "의지력", icon : "ui/sym-trauma", displayType : "level", currentValue : $willpower, maxValue: $willpowermax, modifier: 100, modTypes: { good: [], bad: [] },
						states : [
							{ requiredValue:	0,							level: 0, color: 'red',		description: '당신은 소심하다.'},
							{ requiredValue:	$willpowermax / 7,			level: 1, color: 'pink',	description: '당신은 소극적이다.'},
							{ requiredValue:	($willpowermax / 7) * 2,	level: 2, color: 'purple',	description: '당신은 신중하다.'},
							{ requiredValue:	($willpowermax / 7) * 3,	level: 3, color: 'blue',	description: '당신은 굳건하다.'},
							{ requiredValue:	($willpowermax / 7) * 4,	level: 4, color: 'lblue',	description: '당신은 단호하다.'},
							{ requiredValue:	($willpowermax / 7) * 5,	level: 5, color: 'teal',	description: '당신은 집요하다.'},
							{ requiredValue:	($willpowermax / 7) * 6,	level: 6, color: 'green',	description: '당신의 의지는 강철 같다.'}
						]
					}>>
				<</if>>
				<<if $xchange.willpowerSystemEnabled is 1 and Number.isFinite($xchange.willpowerPoints) and $xchange.willpowerPoints lt Math.max(200, $willpower)>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("spent willpower")>>
				<</if>>
				<<if numberOfEarSlime() gte 2 and $earSlime.growth gt 50>>
					<<set _willpowerConfig.modTypes.bad.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<<elseif numberOfEarSlime() gte 2>>
					<<set _willpowerConfig.modTypes.bad.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
				<<if Math.round($hallucinogen / 250) gt 0 and $substanceRebalance is 1>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("환각제")>>
				<</if>>
				<<if $DoLPTFBuffs is 1>>
					<<if $TFWolfBuffs is 1>>
						<<set _willpowerConfig.modTypes.good.pushUnique("야생의 정령")>>
					<</if>>
					<<if $TFCatBuffs is 1>>
						<<set _willpowerConfig.modTypes.good.pushUnique("고양이의 장난기")>>
					<</if>>
					<<if $TFCowBuffs is 1>>
						<<set _willpowerConfig.modTypes.bad.pushUnique("자연의 양육자")>>
					<</if>>
					<<if $TFBearBuffs is 1>>
						<<set _willpowerConfig.modTypes.good.pushUnique("곰의 힘")>>
					<</if>>
					<<if $TFBunnyBuffs is 1>>
						<<set _willpowerConfig.modTypes.bad.pushUnique("토끼의 민첩함")>>
					<</if>>
					<<if $TFWolfBuffs is 1>>
						<<set _physiqueConfig.modTypes.good.pushUnique("spirit of the wild")>>
					<</if>>
					<<if $TFCatBuffs is 1>>
						<<set _physiqueConfig.modTypes.bad.pushUnique("felinous mischief")>>
					<</if>>
					<<if $TFCowBuffs is 1>>
						<<set _physiqueConfig.modTypes.good.pushUnique("nature's nurturer")>>
					<</if>>
					<<if $TFBearBuffs is 1>>
						<<set _physiqueConfig.modTypes.good.pushUnique("ursine strength")>>
					<</if>>
					<<if $TFBirdBuffs is 1>>
						<<set _physiqueConfig.modTypes.bad.pushUnique("sky's embrace")>>
					<</if>>
					<<if $TFFoxBuffs is 1>>
						<<set _physiqueConfig.modTypes.bad.pushUnique("vixen's guile")>>
					<</if>>
					<<if $TFBunnyBuffs is 1>>
						<<set _physiqueConfig.modTypes.bad.pushUnique("lapine's celerity")>>
					<</if>>
				<</if>>

				<!--BEAUTY-->
				<<set _beautyConfig = { name : "미모 [고정]", icon : "ui/sym-beauty", displayType : "level", currentValue : getEffectiveBeauty(), maxValue: Math.max($beautymax * $AMCTraits.beauty, getEffectiveBeauty()), modifier: 100, modTypes: { good: [], bad: [] },
					states : [
						{ requiredValue: 0, level: 0, color: 'red', description: '당신은 평범하다.'},
						{ requiredValue:	$beautymax / 7,			level: 1, color: 'pink',	description: '당신은 귀엽다.'},
						{ requiredValue:	($beautymax / 7) * 2,	level: 2, color: 'purple',	description: '당신은 예쁘다.'},
						{ requiredValue:	($beautymax / 7) * 3,	level: 3, color: 'blue',	description: '당신은 매력적이다.'},
						{ requiredValue:	($beautymax / 7) * 4,	level: 4, color: 'lblue',	description: '당신은 아름답다.'},
						{ requiredValue:	($beautymax / 7) * 5,	level: 5, color: 'teal',	description: '당신은 눈부시게 매혹적이다.'},
						{ requiredValue:	($beautymax / 7) * 6,	level: 6, color: 'green',	description: '당신의 아름다움은 경이롭다.'},
						{ requiredValue:	($beautymax / 7) * 7,	level: 7, color: 'green',	description: '당신은 사람을 끌어당긴다.'},
						{ requiredValue:	($beautymax / 7) * 8,	level: 8, color: 'gold',	description: '당신은 눈이 번쩍 뜨일 만큼 아름답다.'},
						{ requiredValue:	($beautymax / 7) * 9,	level: 9, color: 'gold',	description: '당신은 넋을 빼앗는다.'},
						{ requiredValue:	($beautymax / 7) * 10,	level: 10, color: 'gold',	description: '당신은 황홀하다.'},
						{ requiredValue:	($beautymax / 7) * 11,	level: 11, color: 'gold',	description: '당신은 시선을 사로잡는다.'},
						{ requiredValue:	($beautymax / 7) * 12,	level: 12, color: 'lustful',description: '당신은 숨이 멎을 만큼 아름답다.'},
						{ requiredValue:	($beautymax / 7) * 13,	level: 13, color: 'lustful',description: '당신의 아름다움은 신성마저 뛰어넘는다.'}
					]
				}>>
				<<set _beautyConfig.name to `미모 <mouse class="tooltip small-description">[고정]<span>당신의 기본 미모는 X-체인지 알약으로만 바뀝니다. 위생 관리와 화장으로 얻는 일시적 상승은 더해질 수 있습니다.</span></mouse>`>>

				<!--PROMISCUITY-->
				<<set _promiscuityConfig = { name : "음란", icon : "ui/sym-lust", displayType : "level", currentValue : $promiscuity, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 정숙하고 순결하다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 얌전하다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신은 성적으로 호기심이 많다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '성적인 접촉에 대한 생각이 당신을 흥분시킨다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '당신은 성적인 접촉을 갈망한다.'},{ requiredValue: 75, level: 5, color: 'pink', description: '당신은 걸레다.'},{ requiredValue: 95, level: 6, color: 'red', description: '당신의 성욕은 끝이 없다.'}					]
				}>>

				<!--EXHIBITIONISM-->
				<<set _exhibitionismConfig = { name : "노출증", icon : "ui/sym-exhibitionism", displayType : "level", currentValue : $exhibitionism, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 수줍음이 많다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 부끄러움을 탄다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신은 성적인 시선을 즐긴다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '당신은 음란한 시선을 즐긴다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '몸을 노출하는 것에 흥분을 느낀다.'},{ requiredValue: 75, level: 5, color: 'pink', description: '당신은 수치심을 모른다.'},{ requiredValue: 95, level: 6, color: 'red', description: '몸을 드러낸다는 생각만으로도 통제할 수 없는 욕망에 휩싸인다.'}					]
				}>>

				<!--DEVIANCY-->
				<<set _deviancyConfig = { name : "이상성욕", icon : "ui/sym-deviancy", displayType : "level", currentValue : $deviancy, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 특이한 취향에 거부감을 느낀다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 평범하다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신의 취향은 약간 독특하다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '당신의 취향은 충격적이다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '당신의 욕망은 터무니없이 스캔들 같다.'},{ requiredValue: 75, level: 5, color: 'pink', description: "남들은 상상도 못 할 짓들을 갈망한다."},{ requiredValue: 95, level: 6, color: 'red', description: '입에 담기도 힘든 행위를 열렬히 갈구한다.'}					]
				}>>

				<<for _statConfig range [_promiscuityConfig, _exhibitionismConfig, _deviancyConfig]>>
					<<if drunkSexStatModifier(_statConfig.currentValue) gte 1>>
						<<set _statConfig.modTypes.good.pushUnique("술기운")>>
					<</if>>
					<<if hallucinogenSexStatModifier(_statConfig.currentValue) gte 1>>
						<<set _statConfig.modTypes.good.pushUnique("환각제")>>
					<</if>>
					<<if heatRutSexStatModifier(_statConfig.name.toLowerCase()) gte 1>>
						<<if playerHeatMinArousal() gt 0>><<set _statConfig.modTypes.good.pushUnique("in heat")>><</if>>
						<<if playerRutMinArousal() gt 0>><<set _statConfig.modTypes.good.pushUnique("in rut")>><</if>>
					<</if>>
				<</for>>

				<<if effectiveDrunk() gt 0>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("술기운")>>
				<</if>>
				<<if $drugged gt 0>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("최음제")>>
				<</if>>
				<<if fatigueSkillPenaltyFraction() gt 0>>
					<<set _physiqueConfig.modTypes.bad.pushUnique("피로")>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("피로")>>
				<</if>>
				<<if xchangeBodyAdjustmentPenalty() gt 0>>
					<<set _physiqueConfig.modTypes.bad.pushUnique("낯선 몸")>>
				<</if>>
			<</silently>>

			<<characteristic-box _purityConfig>>
			<<characteristic-box _beautyConfig>>
			<<characteristic-box _physiqueConfig>>
			<<characteristic-box _willpowerConfig>>
			<<characteristic-box _awarenessConfig>>
			<<characteristic-box _promiscuityConfig>>
			<<characteristic-box _exhibitionismConfig>>
			<<characteristic-box _deviancyConfig>>
			<<if $xchange.genderIdentityEnabled>>
				<<characteristic-box _genderConfig>>
			<</if>>
		</div>

		<!--Common states for skills with grades-->
		<<silently>>
			<<set _basicSkillGrades=[
{ requiredValue: 0, level: "F-", color: 'red'},				{ requiredValue: 1,		level: "F",		color: 'pink'},
				{ requiredValue: 200,	level: "D",		color: 'purple'},
				{ requiredValue: 400,	level: "C",		color: 'blue'},
				{ requiredValue: 600,	level: "B",		color: 'lblue'},
				{ requiredValue: 800,	level: "A",		color: 'teal'},
				{ requiredValue: 1000,	level: "S",		color: 'green'},
				{ requiredValue: 1500,	level: "SS",	color: 'gold'},
				{ requiredValue: 2000,	level: "SSS",	color: 'lustful'}
			]>>
			<<set _detailedSkillGrades=[
{ requiredValue: 0, level: "F-", color: 'red'},				{ requiredValue: 1,		level: "F",		color: 'pink'},
				{ requiredValue: 100,	level: "F+",	color: 'pink'},
				{ requiredValue: 200,	level: "D",		color: 'purple'},
				{ requiredValue: 300,	level: "D+",	color: 'purple'},
				{ requiredValue: 400,	level: "C",		color: 'blue'},
				{ requiredValue: 500,	level: "C+",	color: 'blue'},
				{ requiredValue: 600,	level: "B",		color: 'lblue'},
				{ requiredValue: 700,	level: "B+",	color: 'lblue'},
				{ requiredValue: 800,	level: "A",		color: 'teal'},
				{ requiredValue: 900,	level: "A+",	color: 'teal'},
				{ requiredValue: 1000,	level: "S",		color: 'green'},
				{ requiredValue: 1250,	level: "S+",	color: 'green'},
				{ requiredValue: 1500,	level: "SS",	color: 'gold'},
				{ requiredValue: 1750,	level: "SS+",	color: 'gold'},
				{ requiredValue: 2000,	level: "SSS",	color: 'lustful'}
			]>>
		<</silently>>

		<br>
		<span class="gold">스킬</span>
		<div id="base-skills" class="characteristic-box-list" @style="($parasite.left_ear.name == 'slime' || $parasite.right_ear.name == 'slime') ? '--min-width: 30%;' : ''">
			<!--Additional skills configurations-->
			<<silently>>
				<<set _corruptionConfig =	{ name : "오염도",	displayType : "none",	currentValue : $earSlime.corruption,	modifier: 100, modTypes: { good: [], bad: [] },		meterColor: $earSlime.startedThreats ? "purple" : "blue", secondValue: $earSlime.growth / 2, secondMeterColor: "red"}>>
				<<set _skulduggeryConfig =	{ skill: "skulduggery", name : "속임수", displayType : "grade",	currentValue : $skulduggery,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _dancingConfig =		{ skill: "danceskill", name : "춤",		displayType : "grade",	currentValue : $danceskill,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _swimmingConfig =		{ skill: "swimmingskill", name : "수영",	displayType : "grade",	currentValue : $swimmingskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _athleticsConfig =	{ skill: "athletics", name : "체육",	displayType : "grade",	currentValue : $athletics,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _tendingConfig =		{ skill: "tending", name : "관리",		displayType : "grade",	currentValue : $tending,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _housekeepingConfig =	{ skill: "housekeeping", name : "가사",displayType : "grade",	currentValue : $housekeeping,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<if $danceStudio?.training?.masteryUntil gt $timeStamp>>
					<<set _dancingConfig.modTypes.good.pushUnique("recent grade mastery")>>
				<</if>>
				<<if $danceStudio?.training?.injuryUntil gt $timeStamp>>
					<<if $danceStudio.training.injury is "hard">>
						<<set _dancingConfig.modTypes.bad.pushUnique("dance injury")>>
					<<elseif $danceStudio.training.injury is "light">>
						<<set _dancingConfig.modTypes.bad.pushUnique("sore feet")>>
					<</if>>
				<</if>>
				<<if $combatExtended.brawlingToggle is 1>>
					<<set _brawlingConfig =	{ name : "Brawling",	displayType : "grade",	currentValue : $combatExtended.brawling,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
					<<if $options.statNerf lt 100>>
						<<set _brawlingConfig.modifier to Math.round(_brawlingConfig.modifier * ($options.statNerf / 100))>>
						<<set _brawlingConfig.modTypes.bad.pushUnique("stat nerf")>>
					<</if>>
				<</if>>

				<<if $combatExtended.footworkToggle is 1>>
					<<set _footworkConfig =	{ name : "Footwork",	displayType : "grade",	currentValue : $combatExtended.footwork,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
					<<if $options.statNerf lt 100>>
						<<set _footworkConfig.modifier to Math.round(_footworkConfig.modifier * ($options.statNerf / 100))>>
						<<set _footworkConfig.modTypes.bad.pushUnique("stat nerf")>>
					<</if>>
				<</if>>
				<<if $combatExtended.strikingToggle is 1>>
					<<set _strikingConfig =	{ name : "Striking",	displayType : "grade",	currentValue : $combatExtended.striking,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
					<<if $options.statNerf lt 100>>
						<<set _strikingConfig.modifier to Math.round(_strikingConfig.modifier * ($options.statNerf / 100))>>
						<<set _strikingConfig.modTypes.bad.pushUnique("stat nerf")>>
					<</if>>
				<</if>>
				<<if $combatExtended.kickingToggle is 1>>
					<<set _kickingConfig =	{ name : "Kicking",	displayType : "grade",	currentValue : $combatExtended.kicking,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
					<<if $options.statNerf lt 100>>
						<<set _kickingConfig.modifier to Math.round(_kickingConfig.modifier * ($options.statNerf / 100))>>
						<<set _kickingConfig.modTypes.bad.pushUnique("stat nerf")>>
					<</if>>
				<</if>>
				<<set _bellySize to playerBellySize()>>
				<<if _bellySize gte 10 and playerNormalPregnancyTotal() lt 20>>
					<<set _dancingConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
				<</if>>
				<<if xchangeBodyAdjustmentPenalty() gt 0>>
					<<set _skulduggeryConfig.modTypes.bad.pushUnique("unfamiliar body")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("unfamiliar body")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("unfamiliar body")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("unfamiliar body")>>
				<</if>>
				<<if $transformationParts.traits.chase isnot "disabled">>
					<<set _athleticsConfig.modTypes.good.pushUnique("추격의 전율")>>
				<</if>>
				<<if $transformationParts.traits.strongFeet isnot "disabled">>
					<<set _dancingConfig.modTypes.good.pushUnique("strong feet")>>
					<<set _athleticsConfig.modTypes.good.pushUnique("strong feet")>>
				<</if>>
				<<if $worn.hands.type.includes("sticky_fingers")>>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("나쁜 손버릇")>>
				<</if>>
				<<if $transformationParts.traits.sharpEyes isnot "disabled">>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("예리한 눈")>>
				<</if>>
				<<if $transformationParts.traits.leviathan isnot "disabled">>
					<<set _swimmingConfig.modTypes.good.pushUnique("용의 우아함")>>
				<</if>>
				<<if $worn.under_upper.type.includesAny("dance", "naked") and $worn.under_lower.type.includesAny("dance", "naked")
				and $worn.upper.type.includesAny("dance", "naked")and $worn.lower.type.includesAny("dance", "naked")>>
					<<if [$worn.under_upper.type, $worn.under_lower.type, $worn.upper.type, $worn.lower.type].flat().includes("dance")>>
						<<set _dancingConfig.modTypes.good.pushUnique("댄스 복장")>>
					<<else>>
						<<set _dancingConfig.modTypes.good.pushUnique("알몸")>>
					<</if>>
				<</if>>
				<<if $worn.under_upper.type.includesAny("swim", "naked") and $worn.under_lower.type.includesAny("swim", "naked")
				and $worn.upper.type.includesAny("swim", "naked") and $worn.lower.type.includesAny("swim", "naked")>>
					<<if $worn.under_upper.type.includes("swim") or $worn.under_lower.type.includes("swim")
					or $worn.upper.type.includes("swim") or $worn.lower.type.includes("swim")>>
						<<set _swimmingConfig.modTypes.good.pushUnique("수영복")>>
					<<else>>
						<<set _swimmingConfig.modTypes.good.pushUnique("알몸")>>
					<</if>>
				<</if>>
				<<if $worn.feet.type.includes("swim")>>
					<<if currentSkillValue("feetskill", 1) gt 0>>
						<<set _swimmingConfig.modTypes.good.pushUnique("오리발")>>
					<</if>>
				<<elseif !$worn.feet.type.includes("naked")>>
					<<set _footwearMod to ($worn.feet.type.includes("heels") ? 0.8 : 0.9) + currentSkillValue("feetskill", 1) / 10000>>
					<<if _footwearMod gt 1>>
						<<set _swimmingConfig.modTypes.good.pushUnique(($worn.feet.type.includes("heels") ? "heels" : "shoes") + " (penalty reversed by Foot skill)")>>
					<<elseif _footwearMod lt 1>>
						<<set _swimmingConfig.modTypes.bad.pushUnique($worn.feet.type.includes("heels") ? "하이힐" : "신발")>>
					<</if>>
				<</if>>
				<<switch $location>>
					<<case "forest" "moor" "farm" "alex_farm">>
						<<if $worn.feet.type.includes("heels")>>
							<<set _athleticsConfig.modTypes.bad.pushUnique("하이힐")>>
						<</if>>
						<<if $worn.feet.type.includes("rugged") and currentSkillValue("feetskill", 1) gt 0>>
							<<set _athleticsConfig.modTypes.good.pushUnique("튼튼한 신발")>>
						<</if>>
				<</switch>>
				<<if $worn.feet.type.includes("shackle")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
				<</if>>
				<<if $worn.upper.type.includes("heavy") or $worn.lower.type.includes("heavy")>>
					<<if $physique / $physiquesize gt 1.5>>
						<<set _athleticsConfig.modTypes.good.pushUnique("<b>갑옷</b>")>>
					<<elseif $physique / $physiquesize lt 1.5>>
						<<set _athleticsConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
					<</if>>
					<<if $physique / $physiquesize gt 3>>
						<<set _swimmingConfig.modTypes.good.pushUnique("<b>갑옷</b>")>>
					<<elseif $physique / $physiquesize lt 3>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
					<</if>>
					<<if $physique / $physiquesize gt 3>>
						<<set _dancingConfig.modTypes.good.pushUnique("<b>갑옷</b>")>>
					<<elseif $physique / $physiquesize lt 3>>
						<<set _dancingConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
					<</if>>
				<</if>>
				<<if $worn.feet.type.includes("rugged") and currentSkillValue("feetskill", 1) gt 0>>
					<<set _tendingConfig.modTypes.good.pushUnique("rugged footwear")>>
				<</if>>
				<<if $backgroundTraits.includes("plantlover") and $trauma gt 0>>
					<<if $submissive lte 850>>
						<<set _tendingConfig.modTypes.good.pushUnique("수목애호증")>>
					<<else>>
						<<set _tendingConfig.modTypes.good.pushUnique("식물 애호가")>>
					<</if>>
				<</if>>
				<<if $worn.upper.type.includes("maid")>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.lower.type.includes("maid")>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.head.type.includes("maid")>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.handheld.type.includes("maid")>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("청소 도구")>>
				<</if>>
				<<if effectiveDrunk() gte 1 and $substanceRebalance is 1>>
					<<set _skulduggeryConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _tendingConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _housekeepingConfig.modTypes.bad.pushUnique("술기운")>>
				<</if>>
				<<if Math.round($hallucinogen / 250) gt 0 and $substanceRebalance is 1>>
					<<set _skulduggeryConfig.modTypes.bad.pushUnique("환각제")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("환각제")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("환각제")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("환각제")>>
					<<set _tendingConfig.modTypes.bad.pushUnique("환각제")>>
					<<set _housekeepingConfig.modTypes.bad.pushUnique("환각제")>>
				<</if>>
				<<if $DoLPTFBuffs is 1>>
					<<if $TFWolfBuffs is 1>>
						<<set _dancingConfig.modTypes.good.pushUnique("야생의 정령")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("야생의 정령")>>
						<<set _housekeepingConfig.modTypes.bad.pushUnique("야생의 정령")>>
					<</if>>
					<<if $TFCatBuffs is 1>>
						<<set _skulduggeryConfig.modTypes.good.pushUnique("고양이의 장난기")>>
						<<set _dancingConfig.modTypes.good.pushUnique("고양이의 장난기")>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("고양이의 장난기")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("고양이의 장난기")>>
						<<set _housekeepingConfig.modTypes.bad.pushUnique("고양이의 장난기")>>
					<</if>>
					<<if $TFCowBuffs is 1>>
						<<set _dancingConfig.modTypes.bad.pushUnique("자연의 양육자")>>
						<<set _athleticsConfig.modTypes.bad.pushUnique("자연의 양육자")>>
						<<set _tendingConfig.modTypes.good.pushUnique("자연의 양육자")>>
					<</if>>
					<<if $TFBearBuffs is 1>>
						<<set _skulduggeryConfig.modTypes.bad.pushUnique("곰의 힘")>>
						<<set _dancingConfig.modTypes.bad.pushUnique("곰의 힘")>>
						<<set _swimmingConfig.modTypes.good.pushUnique("곰의 힘")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("곰의 힘")>>
						<<set _housekeepingConfig.modTypes.bad.pushUnique("곰의 힘")>>
					<</if>>
					<<if $TFBirdBuffs is 1>>
						<<set _skulduggeryConfig.modTypes.good.pushUnique("하늘의 품")>>
						<<set _dancingConfig.modTypes.good.pushUnique("하늘의 품")>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("하늘의 품")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("하늘의 품")>>
						<<set _housekeepingConfig.modTypes.good.pushUnique("하늘의 품")>>
					<</if>>
					<<if $TFFoxBuffs is 1>>
						<<set _skulduggeryConfig.modTypes.good.pushUnique("암여우의 교활함")>>
						<<set _dancingConfig.modTypes.good.pushUnique("암여우의 교활함")>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("암여우의 교활함")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("암여우의 교활함")>>
					<</if>>
					<<if $TFBunnyBuffs is 1>>
						<<set _dancingConfig.modTypes.good.pushUnique("토끼의 민첩함")>>
						<<set _athleticsConfig.modTypes.good.pushUnique("토끼의 민첩함")>>
					<</if>>
					<<if $TFWaterDragonBuffs is 1>>
						<<set _swimmingConfig.modTypes.good.pushUnique("용의 우아함")>>
					<</if>>
				<</if>>
				<<if $moorLuck gt 0>>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _dancingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _swimmingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _athleticsConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _tendingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("<i>????</i>")>>
				<</if>>
				<<if $options.statNerf lt 100>>
					<<set _skulduggeryConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _tendingConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _housekeepingConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<</if>>
				<<if $sciencetrait gt 0>>
					<<set _tendingConfig.modTypes.good.pushUnique("science knowledge")>>
				<<elseif $sciencetrait lt 0>>
					<<set _tendingConfig.modTypes.bad.pushUnique("science knowledge")>>
				<</if>>
				<<if fatigueSkillPenaltyFraction() gt 0>>
					<<set _skulduggeryConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _dancingConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _tendingConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _housekeepingConfig.modTypes.bad.pushUnique("fatigued")>>
				<</if>>
			<</silently>>
			<<characteristic-box _skulduggeryConfig>>
			<<characteristic-box _dancingConfig>>
			<<characteristic-box _swimmingConfig>>
			<<characteristic-box _athleticsConfig>>
			<<characteristic-box _tendingConfig>>
			<<characteristic-box _housekeepingConfig>>
			<<if $combatExtended.brawlingToggle is 1>>
				<<characteristic-box _brawlingConfig>>
			<</if>>
			<<if $combatExtended.footworkToggle is 1>>
				<<characteristic-box _footworkConfig>>
			<</if>>
			<<if $combatExtended.strikingToggle is 1>>
				<<characteristic-box _strikingConfig>>
			<</if>>
			<<if $combatExtended.kickingToggle is 1>>
				<<characteristic-box _kickingConfig>>
			<</if>>
			<<if numberOfEarSlime()>>
				<<characteristic-box _corruptionConfig>>
			<</if>>
		</div>

		<br>
		<span class="gold">섹스 스킬</span>
		<!--Sex skills configurations-->
		<<silently>>
			<<if (V.substanceRebalance == 1)>>
				<<set _drugMod to 1 + V.drugged / 250>>
			<<else>>
				<<set _drugMod to 1 + V.drugged / 1000>>
			<</if>>
			<<set _seductionConfig =	{ skill: "seductionskill", name : "유혹",	displayType : "grade",	currentValue : $seductionskill, modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<<set _oralConfig =			{ skill: "oralskill", name : "입",		displayType : "grade",	currentValue : $oralskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("mouth")}>>
			<<set _chestConfig =		{ skill: "chestskill", name : "가슴",		displayType : "grade",	currentValue : $chestskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("breast") * _drugMod}>>
			<<set _handsConfig =  		{ skill: "handskill", name : "손",    	displayType : "grade", 	currentValue : $handskill,  	modifier: 100, modTypes: { good: [], bad: [] }, 	states : _basicSkillGrades, 	sensitivity : getGeneralSensitivity("hands")}>>
			<<set _buttocksConfig =		{ skill: "bottomskill", name : "엉덩이",	displayType : "grade",	currentValue : $bottomskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("bottom") * _drugMod}>>
			<<set _analConfig =			{ skill: "analskill", name : "애널",		displayType : "grade",	currentValue : $analskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("bottom") * _drugMod}>>
			<<set _thighsConfig =   	{ skill: "thighskill", name : "허벅지",   	displayType : "grade", 	currentValue : $thighskill, 	modifier: 100, modTypes: { good: [], bad: [] }, 	states : _basicSkillGrades, 		sensitivity : getGeneralSensitivity("thighs")}>>
			<<set _feetConfig =     	{ skill: "feetskill", name : "발",     	displayType : "grade", 	currentValue : $feetskill,  	modifier: 100, modTypes: { good: [], bad: [] }, 	states : _basicSkillGrades, 	sensitivity : getGeneralSensitivity("feet")}>>
			<<if $player.penisExist>>
				<<set _penileConfig =	{ skill: "penileskill", name : "자지",		displayType : "grade",	currentValue : $penileskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("genital") * _drugMod}>>
			<</if>>
			<<if playerHasStrapon()>>
				<<set _penileConfig =	{ skill: "penileskill", name : "페니스 밴드",displayType : "grade",	currentValue : $penileskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<</if>>
			<<if $player.vaginaExist>>
				<<set _vaginalConfig =	{ skill: "vaginalskill", name : "보지",		displayType : "grade",	currentValue : $vaginalskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : getSensitivity("genital") * _drugMod}>>
			<</if>>
			
			<<if $drunk gt 0 and $drunk lt 480>>
				<<set _seductionConfig.modTypes.good.pushUnique($drunk lt 240 ? "tipsy" : "drunken confidence")>>
			<<elseif $drunk gt 480>>
				<<set _seductionConfig.modTypes.bad.pushUnique("drunk")>>
			<</if>>
			<<if $earSlime.growth gt 50 and !V.earSlime.defyCooldown>>
				<<set _seductionConfig.modTypes.good.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
			<</if>>
			<<if $earSlime.growth gt 100 and $earSlime.focus is "pregnancy">>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.good.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
				<<if $player.penisExist or playerHasStrapon()>>
					<<set _penileConfig.modTypes.bad.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
				<<if !$player.vaginaExist>>
					<<set _analConfig.modTypes.good.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
			<</if>>
			<<if $earSlime.growth gt 100 and $earSlime.focus is "impregnation">>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.bad.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
				<<if $player.penisExist or playerHasStrapon()>>
					<<set _penileConfig.modTypes.good.pushUnique(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
				<</if>>
			<</if>>
			<<if Transformations.partActive("traits", "dragonTongue")>>
				<<set _oralConfig.modTypes.good.pushUnique("dragon tongue")>>
			<</if>>
			<<if playerHeatMinArousal()>>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.good.pushUnique("발정기")>>
				<</if>>
				<<if playerCanCarryAnally()>>
					<<set _analConfig.modTypes.good.pushUnique(playerAwareTheyCanBePregnant() ? "발정기" : "<i>????</i>")>>
				<</if>>
			<</if>>
			<<if playerRutMinArousal() and ($player.penisExist or playerHasStrapon())>>
				<<set _penileConfig.modTypes.good.pushUnique("러트")>>
			<</if>>
			<<if effectiveDrunk() gte 1 and $substanceRebalance is 1>>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.bad.pushUnique("술기운")>>
				<</if>>
				<<if $player.penisExist or playerHasStrapon()>>
					<<set _penileConfig.modTypes.bad.pushUnique("술기운")>>
				<</if>>
				<<set _analConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _oralConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _chestConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _handsConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _buttocksConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _thighsConfig.modTypes.bad.pushUnique("술기운")>>
				<<set _feetConfig.modTypes.bad.pushUnique("술기운")>>
			<</if>>
			<<if Math.round($hallucinogen / 250) gt 0 and $substanceRebalance is 1>>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.bad.pushUnique("환각제")>>
				<</if>>
				<<if $player.penisExist or playerHasStrapon()>>
					<<set _penileConfig.modTypes.bad.pushUnique("환각제")>>
				<</if>>
				<<set _analConfig.modTypes.bad.pushUnique("환각제")>>
				<<set _seductionConfig.modTypes.bad.pushUnique("환각제")>>
			<</if>>
			<<if $DoLPTFBuffs is 1>>
				<<if $TFCatBuffs is 1>>
					<<set _seductionConfig.modTypes.good.pushUnique("고양이의 장난기")>>
				<</if>>
				<<if $TFCowBuffs is 1>>
					<<set _seductionConfig.modTypes.good.pushUnique("자연의 양육자")>>
				<</if>>
				<<if $TFBearBuffs is 1>>
					<<set _seductionConfig.modTypes.bad.pushUnique("곰의 힘")>>
				<</if>>
				<<if $TFBirdBuffs is 1>>
					<<set _seductionConfig.modTypes.good.pushUnique("하늘의 품")>>
				<</if>>
				<<if $TFFoxBuffs is 1>>
					<<set _seductionConfig.modTypes.good.pushUnique("암여우의 교활함")>>
				<</if>>
			<</if>>

			<<if $options.statNerf lt 100>>
				<<set _seductionConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _oralConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _chestConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _handsConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _buttocksConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _analConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _thighsConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<set _feetConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<<if $player.penisExist || playerHasStrapon()>>
					<<set _penileConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<</if>>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<</if>>
			<</if>>
			<<if fatigueSkillPenaltyFraction() gt 0>>
				<<set _seductionConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _oralConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _chestConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _handsConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _buttocksConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _analConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _thighsConfig.modTypes.bad.pushUnique("fatigued")>>
				<<set _feetConfig.modTypes.bad.pushUnique("fatigued")>>
				<<if $player.penisExist || playerHasStrapon()>>
					<<set _penileConfig.modTypes.bad.pushUnique("fatigued")>>
				<</if>>
				<<if $player.vaginaExist>>
					<<set _vaginalConfig.modTypes.bad.pushUnique("fatigued")>>
				<</if>>
			<</if>>
		<</silently>>
		<<if $options.images is 1>>
			<div id="player-body">
				<<player-base-body>>
			</div>
			<div id="sex-diagram">

				<div class="characteristic-box-list left-column">
					<div class="sex-diagram-box">
						<<characteristic-box _seductionConfig>>
						<div class="connector-box"></div>
					</div>
					<div class="sex-diagram-box">
						<<characteristic-box _chestConfig>>
						<<connector-box 52 35 5>>
					</div>
					<div class="sex-diagram-box">
						<<characteristic-box _buttocksConfig>>
						<<connector-box 37 50 13>>
					</div>
					<<if $player.vaginaExist>>
						<div class="sex-diagram-box">
							<<characteristic-box _vaginalConfig>>
							<<connector-box 10 -3 0 true>>
						</div>
						<div class="sex-diagram-box">
							<<characteristic-box _thighsConfig>>
							<<connector-box 37 35 7 true>>
						</div>
					<<else>>
						<div class="sex-diagram-box">
							<<characteristic-box _thighsConfig>>
							<<connector-box 0 35 7>>
						</div>
					<</if>>
				</div>
				<div class="characteristic-box-list right-column">
					<div class="sex-diagram-box">
						<<connector-box 73 35 16>>
						<<characteristic-box _oralConfig>>
					</div>
					<div class="sex-diagram-box">
						<<connector-box 74 50 23>>
						<<characteristic-box _handsConfig>>
					</div>
					<<if $player.penisExist or playerHasStrapon()>>
						<div class="sex-diagram-box">
							<<connector-box 34 65 10>>
							<<characteristic-box _penileConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 2 50 20 true>>
							<<characteristic-box _analConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 5 50 25 true>>
							<<characteristic-box _feetConfig>>
						</div>
					<<else>>
						<div class="sex-diagram-box">
							<<connector-box 39 65 20>>
							<<characteristic-box _analConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 40 80 25>>
							<<characteristic-box _feetConfig>>
						</div>
					<</if>>
				</div>
			</div>
		<<else>>
			<div id="sex-skills" class="characteristic-box-list">
				<<characteristic-box _seductionConfig>>
				<<characteristic-box _oralConfig>>
				<<if $player.vaginaExist>>
					<<characteristic-box _vaginalConfig>>
				<</if>>
				<<if $player.penisExist>>
					<<characteristic-box _penileConfig>>
				<</if>>
				<<if playerHasStrapon()>>
					<<characteristic-box _penileConfig>>
				<</if>>
				<<characteristic-box _analConfig>>
				<<characteristic-box _handsConfig>>
				<<characteristic-box _feetConfig>>
				<<characteristic-box _thighsConfig>>
				<<characteristic-box _buttocksConfig>>
				<<characteristic-box _chestConfig>>
			</div>
		<</if>>

		<br>
		<span class="gold">학교 성적</span>
		<div id="school-grades" class="characteristic-box-list">
			<!--School grade configurations-->
			<<silently>>
				<<set _schoolGradeStates= [
					{ requiredValue: -1,	level: 'F',		color: 'red'},
					{ requiredValue: 0,		level: 'D',		color: 'purple'},
					{ requiredValue: 1,		level: 'C',		color: 'blue'},
					{ requiredValue: 2,		level: 'B',		color: 'lblue'},
					{ requiredValue: 3,		level: 'A',		color: 'teal'},
					{ requiredValue: 4,		level: 'A*',	color: 'green'},
					{ requiredValue: 5,		level: 'S',		color: 'gold'},
					{ requiredValue: 6,		level: 'S+',	color: 'gold'},
					{ requiredValue: 7,		level: 'SS',	color: 'gold'},
					{ requiredValue: 8,		level: 'SSS',	color: 'lustful'}
				]>>

				<<set _scienceConfig =	{ skill: "science", name : '과학', icon : 'misc/icon/science', displayType : "grade",	currentValue : $sciencetrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $science_exam,		showStars: true, starLevel: $science_star,	states : _schoolGradeStates}>>
				<<set _mathsConfig =	{ skill: "maths", name : '수학',	icon : 'misc/icon/math',	displayType : "grade",	currentValue : $mathstrait,		modifier: 100, modTypes: { good: [], bad: [] },	percent: $maths_exam,		showStars: true, starLevel: $maths_star,	states : _schoolGradeStates}>>
				<<set _englishConfig =	{ skill: "english", name : '영어', icon : 'misc/icon/english', displayType : "grade",	currentValue : $englishtrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $english_exam,		showStars: true, starLevel: $english_star,	states : _schoolGradeStates}>>
				<<set _historyConfig =	{ skill: "history", name : '역사', icon : 'misc/icon/history', displayType : "grade",	currentValue : $historytrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $history_exam,		showStars: true, starLevel: $history_star,	states : _schoolGradeStates}>>
				<<if effectiveDrunk() gte 1 and $substanceRebalance is 1>>
					<<set _scienceConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _mathsConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _englishConfig.modTypes.bad.pushUnique("술기운")>>
					<<set _historyConfig.modTypes.bad.pushUnique("술기운")>>
				<</if>>
				<<if $moorLuck gt 0>>
					<<set _scienceConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _mathsConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _englishConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _historyConfig.modTypes.good.pushUnique("<i>????</i>")>>
				<</if>>
				<<if $options.statNerf lt 100>>
					<<set _scienceConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _mathsConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _englishConfig.modTypes.bad.pushUnique("능력치 너프")>>
					<<set _historyConfig.modTypes.bad.pushUnique("능력치 너프")>>
				<</if>>
				<<if fatigueSkillPenaltyFraction() gt 0>>
					<<set _scienceConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _mathsConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _englishConfig.modTypes.bad.pushUnique("fatigued")>>
					<<set _historyConfig.modTypes.bad.pushUnique("fatigued")>>
				<</if>>
			<</silently>>

			<<characteristic-box _scienceConfig>>
			<<characteristic-box _mathsConfig>>
			<<characteristic-box _englishConfig>>
			<<characteristic-box _historyConfig>>
		</div>
		<div class="characteristic-box-extras">
			<<set _schoolPerformanceConfig = { currentValue : $school, preText: '당신의 전반적인 학교 성적은 ', modifier: 100, modTypes: { good: [], bad: [] }, states : [
					{ requiredValue: 0, color: 'red', description: '끔찍하다.'},
					{ requiredValue: 1,		color: 'pink',		description: '매우 나쁘다.'},
					{ requiredValue: 400,	color: 'purple',	description: '나쁘다.'},
					{ requiredValue: 800,	color: 'blue',		description: '나쁘지 않다.'},
					{ requiredValue: 1600,	color: 'lblue',		description: '좋다.'},
					{ requiredValue: 2800,	color: 'teal',		description: '훌륭하다.'},
					{ requiredValue: 4000,	color: 'green',		description: '모범적이다.'},
					{ requiredValue: 5000,	color: 'gold',		description: '뛰어나다.'},
					{ requiredValue: 6500,	color: 'gold',		description: '탁월하다.'},
					{ requiredValue: 8000,	color: 'lustful',		description: '비범하다.'}
				]
			}>>
			<<characteristic-text _schoolPerformanceConfig>>
			<br>
		</div>

		<br>
		<span class="gold">무기 스킬</span>
		<div id="prof" class="characteristic-box-list">
			<<silently>>
				<<set _sprayConfig =		{ name : "후추 스프레이",		displayType : "grade",	currentValue : $prof.spray,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _netConfig =			{ name : "그물",		displayType : "grade",	currentValue : $prof.net,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _batonConfig =		{ name : "봉",		displayType : "grade",	currentValue : $prof.baton,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _whipConfig =			{ name : "채찍",		displayType : "grade",	currentValue : $prof.whip,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _pickaxeConfig =		{ name : "곡괭이",	displayType : "grade",	currentValue : $prof.pickaxe,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _hiddenConfig =		{ name : "<i>????</i>",	displayType : "grade",	currentValue : 0,				modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
			<</silently>>
			<<characteristic-box _sprayConfig>>
			<<if $prof.net isnot undefined>>
				<<characteristic-box _netConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			<<if $prof.baton isnot undefined>>
				<<characteristic-box _batonConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			<<if $prof.whip isnot undefined>>
				<<characteristic-box _whipConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			<<if $prof.pickaxe isnot undefined>>
				<<characteristic-box _pickaxeConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
		</div>
	</div>

	<br>
	<span class="gold">불안감</span>
	<div class="description">불안감이 커질수록 타인의 시선을 감당하기 어려워지며, 스트레스가 더 크게 쌓이고 통제력을 잃기 쉬워집니다. 자신을 받아들이면 이 효과에 면역이 됩니다.</div>
	<br>
	/* Defensive: setup.penisSizes[$player.penissize] can be undefined for characters without a penis or after X-Change state mutations */
	<<set $_penisSize to (setup.penisSizes && setup.penisSizes[$player.penissize] ? window.KR.getPenisDescKr(setup.penisSizes[$player.penissize]).toUpperFirst() : "")>>
	<<if insecurityExists("penis_small")>>
		<span class="red">불안감: <<print $_penisSize>> 자지</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_penis_small/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_penis_small gte 1>>
			<span class="green">수용: <<print $_penisSize>> 자지</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_penis_small/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("penis_big")>>
		<span class="red">불안감: <<print $_penisSize>> 자지</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_penis_big/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_penis_big gte 1>>
			<span class="green">수용: <<print $_penisSize>> 자지</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_penis_big/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	/* Defensive: same pattern as $_penisSize above; guard against $player.breastsize being out of range or undefined. */
	<<set $_breastSize to (setup.breastsizes && setup.breastsizes[$player.breastsize] ? window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize]).toUpperFirst() : "")>>
	<<if insecurityExists("breasts_small")>>
		<span class="red">불안감: <<print $player.breastsize ? "$_breastSize 가슴" : "평평한 가슴">></span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_breasts_small/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_breasts_small gte 1>>
			<span class="green">수용: <<print $player.breastsize ? "$_breastSize 가슴" : "평평한 가슴">></span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_breasts_small/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("breasts_big")>>
	<span class="red">불안감: <<print $player.gender is "m" ? "남성" : $_breastSize>> 가슴</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_breasts_big/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_breasts_big gte 1>>
			<span class="green">수용: <<print $player.gender is "m" ? "남성" : $_breastSize>> 가슴</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_breasts_big/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("pregnancy")>>
		<<set $_bellyText to (playerAwareTheyArePregnant() ? "임신한 배" : "임신처럼 보이는 배")>>
		<span class="red">불안감: <<print $_bellyText>></span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_pregnancy/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_pregnancy gte 1>>
			<span class="green">수용: <<print $_bellyText>></span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_pregnancy/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("clear_climax")>>
		<span class="red">불안감: 투명한 절정</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_clear_climax/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_clear_climax gte 1>>
			<span class="green">수용: 투명한 절정</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_clear_climax/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>

	<br>
<</widget>>

<<widget "heatRutDisplay">><<silently>>
	<<set $_knowsTheyCanBecomePregnant to ($settings.playerPregnancyHumanEnabled or $settings.playerPregnancyBeastEnabled) and playerAwareTheyCanBePregnant()>>
	<<set $_heatArousal to playerHeatMinArousal()>>
	<<set $_rutArousal to playerRutMinArousal()>>

	<<if $_heatArousal or $_rutArousal>>
		<<set $_source to []>>
		<<set $_sourceText to "무언가">>
		<<set $_arousal to []>>
		<<set $_arousedText to "당신을 계속 달아오르게 하고 있다">>

		/* SourceText */
		<<if effectiveTransformationLevel("wolf") gte 2 or effectiveTransformationLevel("cat") gte 2 or (effectiveTransformationLevel("cow") gte 2) or effectiveTransformationLevel("fox") gte 2 or effectiveTransformationLevel("bear") gte 2 or effectiveTransformationLevel("bunny") gte 2>>
			<<run $_source.push("내면의 짐승")>>
		<</if>>
		<<if $earSlime.growth gt 50 and (($earSlime.focus is "pregnancy" and $_heatArousal) or ($earSlime.focus is "impregnation" and $_rutArousal))>>
			<<run $_source.push(earSlimeThoughts() ? "원치 않는 생각" : "귀 슬라임")>>
		<</if>>
		<<if !$statFreeze and $xchange isnot undefined and $xchange.pill isnot undefined and $xchange.pill.active and ($xchange.pill.fertile or $xchange.pill.breederEffect or $xchange.pill.bullEffect or $xchange.pill.omegaEffect or $xchange.pill.alphaEffect)>>
			<<run $_source.push("X-Change pill")>>
		<</if>>

		/* If arousal is active but no source was found, add a neutral fallback */
		<<if $_source.length is 0>>
			<<run $_source.push("body")>>
		<</if>>

		<<set $_sourceText to "Your " + formatList($_source, "and")>>

		/* arousedText */
		<<if $_heatArousal and $_knowsTheyCanBecomePregnant>>
			<<run $_arousal.push("발정기")>>
		<</if>>
		<<if $_rutArousal>>
			<<run $_arousal.push("러트")>>
		<</if>>

		<<if $_arousal.length>>
			<<set $_arousedText to "당신을 " + formatList($_arousal, "그리고") + " 상태로 몰아넣고 있다">>
		<</if>>
	<</if>>
<</silently>><<if $_sourceText>><<print $_sourceText>><<print $_source.length gte 2 ? "들이" : "【이가】">> <<print $_arousedText>>.<<if _args[0]>><br><br><</if>><</if>>
<</widget>>
