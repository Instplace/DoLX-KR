/*
IMPORTANT:
	When adding variables to the options menu, state variables must use the $options object.
	Otherwise changes won't be applied when options overlay is closed. See updateOptions().
 */

:: Options Overlay [widget]
<<widget "setupOptions">>
	<<if $options.ambience_volume is undefined>><<set $options.ambience_volume to 1>><</if>>
	<<if $options.npcVoiceoverAudio is undefined>><<set $options.npcVoiceoverAudio to 1>><</if>>
	<<if $options.showGameVersion is undefined>><<set $options.showGameVersion to true>><</if>>
	<<set _optionsEnabled to true>>
	<<set _optionsRefresh to false>>
	<<script>>
		settingsDisableElement();
		window.Theme.initControl();
		onInputChanged(() => {
			if(!T.optionsRefresh) T.optionsRefresh = true;
			if(T.globalThemeDefaults) Wikifier.wikifyEval("<<setFont true>>");
		});
	<</script>>
<</widget>>

<<widget "optionsDefaults">>
	<div class="settingsGrid">
		<div>
			<<button "모든 옵션을 기본값으로 저장">>
				<<set _toSaveDefaults to {}>>
				<<set $options.theme to Theme.getPreference()>>
				<<run exportSettingsWalk(settingsObjects("general").options, V.options, T.toSaveDefaults)>>
				<<run localStorage.setItem("dolDefaultGeneralSettings", JSON.stringify(T.toSaveDefaults))>>
				<<run localStorage.removeItem("dolDefaultThemeSettings")>>
				<<set _globalGeneralDefaults to _toSaveDefaults>>
				<<set _globalThemeDefaults to {}>>
				<<run $('[id^="optionsThemeDefault-"]').each(function () {
					const value = T.globalGeneralDefaults[this.id.substring("optionsThemeDefault-".length)];
					this.textContent = value === undefined ? "" : " 기본값: (" + value + ")";
				})>>
				<<replace "#optionsDefaultsStatus">>새 게임용 기본값을 저장했습니다.<</replace>>
			<</button>>
			<<button "저장된 기본값 삭제">>
				<<run localStorage.removeItem("dolDefaultGeneralSettings")>>
				<<run localStorage.removeItem("dolDefaultThemeSettings")>>
				<<set _globalGeneralDefaults to {}>>
				<<set _globalThemeDefaults to {}>>
				<<run $('[id^="optionsThemeDefault-"]').empty()>>
				<<replace "#optionsDefaultsStatus">>기본값을 초기화했습니다.<</replace>>
			<</button>>
			<span id="optionsDefaultsStatus" role="status"></span>
			<br><span class="small-description">기본값은 새 게임에 적용됩니다. 기존 세이브는 각자의 옵션을 그대로 유지합니다. 설정 내보내기에는 이 옵션들도 포함되어 다른 설치본으로 옮길 수 있습니다.</span>
		</div>
	</div>
<</widget>>

<<widget "optionsgeneral">>
	<<setupOptions>>
	<<set _globalGeneralDefaults to JSON.parse(localStorage.getItem("dolDefaultGeneralSettings"))>>
	<<if !_globalGeneralDefaults>>
		<<set _globalGeneralDefaults to {}>>
	<</if>>
	<<if !_globalThemeDefaults>>
		<<set _globalThemeDefaults to {}>>
	<</if>>
	<<if $debug>>
		/*<label><<checkbox "$notifyUpdate" false true autocheck>> Notify when there's a new game update available</label>
		<br>*/
		/*<<link "Check for updates">>
			<<run checkNewVersion()>>
		<</link>>
		<br><br>*/
	<</if>>
	<<optionsDefaults>>
	<div class="settingsGrid">
		<div class="settingsHeader options"><span class="gold">일반</span></div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.neverNudeMenus" false true autocheck>>
				메뉴에서 플레이어의 알몸 숨기기
			</label>
		</div>
		<div class="settingsToggleItem">
			<label data-disabledif="V.ironmanmode===true">
				<<checkbox "$options.autosaveDisabled" false true autocheck>> 잠잘 때 자동 저장 비활성화
			</label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">날짜 형식:</span><<optionsThemeDefault "dateFormat">>
			<br>
			<label class="en-GB"><<radiobutton "$options.dateFormat" "en-GB" autocheck>> dd/mm/yyyy</label> |
			<label class="en-US"><<radiobutton "$options.dateFormat" "en-US" autocheck>> mm/dd/yyyy</label> |
			<label class="zh-CN"><<radiobutton "$options.dateFormat" "zh-CN" autocheck>> yyyy/mm/dd</label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">온도 형식:</span><<optionsThemeDefault "fahrenheit">>
			<br>
			<label><<checkbox "$options.fahrenheit" false true autocheck>> 온도 단위로 화씨(F) 사용</label>
		</div>
		<div class="settingsToggleItem">
			<label data-disabledif="!StartConfig.enableLinkNumberify">
				<<checkbox "$options.numberify_enabled" 0 1 autocheck>> 번호가 매겨진 링크 네비게이션 활성화
			</label>
			<mouse class="tooltip-small linkBlue">(?)<span>키보드로 네비게이션을 할 수 있게 합니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			기상 후 옷차림 메뉴 스타일:
			<<listbox "$options.listboxOutfitsEnabled" autoselect>>
				<<option "라디오 버튼" false>>
				<<option "리스트 박스" true>>
			<</listbox>>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.clothingReplacementWarning" false true autocheck>>
				의류 교체 경고 활성화
			</label>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.showAllStatMeters" false true autocheck>>
				사이드바 스탯 게이지를 항상 표시
			</label>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">사이드바</div>
		<div class="settingsToggleItem">
			<span class="gold">시간 형식:</span>
			<br>
			<label><<radiobutton "$options.timestyle" "military" autocheck>> 24시간제</label> |
			<label><<radiobutton "$options.timestyle" "ampm" autocheck>> 12시간제</label>
		</div>
		<<script>>
			if ($("#condomsSidebar").length > 0) {
				T.condomDisplay = true
			}
		<</script>>
		<div class="settingsToggleItem">
			<span class="gold">콘돔 표시:</span>
			<br>
			<label><<radiovar "$options.condomsDisplay" "standard">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 표준</label> |
			<label><<radiovar "$options.condomsDisplay" "modded1">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 1</label> |
			<label><<radiovar "$options.condomsDisplay" "modded2">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 2</label> |
			<label><<radiovar "$options.condomsDisplay" "modded3">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 3</label> |
			<label><<radiovar "$options.condomsDisplay" "modded4">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 4</label> |
			<label><<radiovar "$options.condomsDisplay" "modded5">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 5</label> |
			<label><<radiovar "$options.condomsDisplay" "modded6">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 6</label> |
			<label><<radiovar "$options.condomsDisplay" "modded7">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 7</label> |
			<label><<radiovar "$options.condomsDisplay" "modded8">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 8</label> |
			<label><<radiovar "$options.condomsDisplay" "modded9">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 모드 9</label> |
			<label><<radiovar "$options.condomsDisplay" "none">><<if _condomDisplay>><<replace #condomsSidebar>><<condomsSidebar>><</replace>><</if>><</radiovar>> 숨김</label>
		</div>
		<<script>>
			if ($("#peppersprays").length > 0) {
				T.peppersprays = true
			}
		<</script>>
		<div class="settingsToggleItem">
			<span class="gold">후추 스프레이 표시:</span>
			<br>
			<label><<radiovar "$options.pepperSprayDisplay" "sprays">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 표준</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "compact">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 컴팩트</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded1">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 1</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded2">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 2</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded3">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 3</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded4">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 4</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded5">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 5</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded6">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 6</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded7">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 7</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded8">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 8</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "modded9">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 모드 9</label> |
			<label><<radiovar "$options.pepperSprayDisplay" "none">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 숨김</label>
			<br>
			<span class="gold">드래곤 별:</span>
			<label><<radiovar "$options.dragonStarDisplay" "show">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 표시</label> |
			<label><<radiovar "$options.dragonStarDisplay" "none">><<if _peppersprays>><<replace #peppersprays>><<peppersprays>><</replace>><</if>><</radiovar>> 숨김</label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">온도계 표시:</span>
			<br>
			<label><<radiovar "$options.thermometerDisplay" "">><<run Weather.Thermometer.load()>><</radiovar>> 표준</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded1">><<run Weather.Thermometer.load()>><</radiovar>> 모드 1</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded2">><<run Weather.Thermometer.load()>><</radiovar>> 모드 2</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded3">><<run Weather.Thermometer.load()>><</radiovar>> 모드 3</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded4">><<run Weather.Thermometer.load()>><</radiovar>> 모드 4</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded5">><<run Weather.Thermometer.load()>><</radiovar>> 모드 5</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded6">><<run Weather.Thermometer.load()>><</radiovar>> 모드 6</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded7">><<run Weather.Thermometer.load()>><</radiovar>> 모드 7</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded8">><<run Weather.Thermometer.load()>><</radiovar>> 모드 8</label> |
			<label><<radiovar "$options.thermometerDisplay" "modded9">><<run Weather.Thermometer.load()>><</radiovar>> 모드 9</label>
		</div>
		<div class="settingsToggleItem">
			<div id="nnpcDisplay">
				<<if $options.nnpcDisplay isnot 0 and $options.autoNNPCDisplay[$options.nnpcDisplay] isnot undefined and $options.autoNNPCDisplay[$options.nnpcDisplay].gender isnot undefined>><<set $options.nnpcDisplayGender to $options.autoNNPCDisplay[$options.nnpcDisplay].gender>><</if>>
				<<updatesidebarimg>>
				<span class="gold">네임드 NPC 표시:</span>
				<br>
				<label> 선호하는 표시 방식을 선택하십시오:
				<<listbox "$options.NnpcDisplaySystem" autoselect>>
					<<option "없음" "none">>
					<<option "바닐라" "vanilla">>
					<<option "DOLP" "dolp">>
				<</listbox>>
				<mouse class="tooltip linkBlue">(?)<span>바닐라 표시 방식은 옷을 벗길 수 있는 스프라이트와 더 반응성 좋은 캐릭터 같은 여러 기능을 제공합니다. 하지만 바닐라 스타일의 스프라이트에 의존해 작동하고 사용자 지정 옵션이 없어서, 대부분의 그래픽 모드와는 어울리지 않을 가능성이 높습니다. <br><br>대신 이전 버전에서 쓰던 모든 기능과 더 높은 해상도의 스프라이트를 제공하는 정통 DoLP NNPC 표시 방식을 선택할 수도 있습니다.<br><br>스프라이트를 교체하거나 직접 추가하려면, 바닐라 스프라이트는 "img/clothes/props/npc"에, DoLP 스프라이트는 "img/ui/nnpc"에 있습니다.</span></mouse>
				</label>
				<hr style="border-top: 1px dashed #888; margin-top:10px; margin-bottom:10px;">
				<span class="gold">DoLP 네임드 NPC 표시 설정:</span>
				<br>
				<div id="autonnpc">자동 모드: <label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<checkbox "$options.autoNNPCDisplay.enabled" false true autocheck>> <mouse class="tooltip linkBlue">(?)<span>네임드 NPC와 같은 장면에 있을 때 그 NPC가 나타나게 합니다.</span></mouse></label></div>
				<<set _options = {}>>
				<<set _options["None"] = 0>>
				<<set _options["Alex"] = "alex">>
				<<set _options["Avery"] = "avery">>
				<<set _options["Bailey"] = "bailey">>
				<<set _options["Black Wolf"] = "black_wolf">>
				<<set _options["Briar"] = "briar">>
				<<set _options["Charlie"] = "charlie">>
				<<set _options["Darryl"] = "darryl">>
				<<set _options["Doren"] = "doren">>
				<<set _options["Eden"] = "eden">>
				<<set _options["Great Hawk"] = "great_hawk">>
				<<set _options["Gwylan"] = "gwylan">>
				<<set _options["Harper"] = "harper">>
				<<set _options["Ivory Wraith"] = "ivory_wraith">>
				<<set _options["Jordan"] = "jordan">>
				<<set _options["Kylar"] = "kylar">>
				<<set _options["Landry"] = "landry">>
				<<set _options["Leighton"] = "leighton">>
				<<set _options["Luchifen"] = "luchifen">>
				<<set _options["Mason"] = "mason">>
				<<set _options["Morgan"] = "morgan">>
				<<set _options["Niki"] = "niki">>
				<<set _options["Quinn"] = "quinn">>
				<<set _options["Remy"] = "remy">>
				<<set _options["Riley"] = "riley">>
				<<set _options["River"] = "river">>
				<<set _options["Robin"] = "robin">>
				<<set _options["Sam"] = "sam">>
				<<set _options["Sirris"] = "sirris">>
				<<set _options["Sydney"] = "sydney">>
				<<set _options["Whitney"] = "whitney">>
				<<set _options["Winter"] = "winter">>
				<<set _options["Wren"] = "wren">>
				<<set _options["Zephyr"] = "zephyr">>
				<<set _options["Night Monster"] = "night_monster">>
				<<set _options["Poppy"] = "poppy">>
				<<set _options["Others"] = "others">>
				<<if Object.keys(_options).length > 1>>
					<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'">네임드 NPC:
						<div id="nnpc">
							<<listbox "$options.nnpcDisplay" autoselect>>
								<<optionsfrom _options>>
							<</listbox>>
						</div>
					</label>
				<</if>>
				레이어:
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayLayer" "front">><<updatesidebarimg>><</radiovar>> 앞</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayLayer" "back">><<updatesidebarimg>><</radiovar>> 뒤</label>
				<br>
				<div id="autoNNPCGenderOverride">
					<span id="autoNNPCGenderOverrideToggle">
						<<if $options.autoNNPCDisplay.enabled is true and $options.nnpcDisplay isnot 0 and $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
							성별 덮어쓰기: <label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<checkbox "$options.autoNNPCDisplay[$options.nnpcDisplay].genderOverride" false true autocheck>> <mouse class="tooltip linkBlue">(?)<span>성별 덮어쓰기를 켭니다. 네임드 NPC의 신체 성별 대신 원하는 성별의 스프라이트를 고를 수 있습니다.</span></mouse></label>
						<</if>>
					</span>
				</div>
				<span id="manualNNPC">
					<<if $options.autoNNPCDisplay.enabled is true and $options.nnpcDisplay isnot 0>>
						<<if $options.autoNNPCDisplay[$options.nnpcDisplay].genderOverride is true and $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
							성별:
							<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "male">><<updatesidebarimg>><</radiovar>> 남성</label> |
							<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "female">><<updatesidebarimg>><</radiovar>> 여성</label>
							<<if $options.nnpcDisplay is "night_monster">> | <label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
							<br>
						<</if>>
						/* Beast skin selector: always available for Black Wolf / Great Hawk
						   so the player can pick Monster form even when Auto Mode is enabled. */
						<<if $options.nnpcDisplay is "black_wolf" || $options.nnpcDisplay is "great_hawk">>
							피부:
							<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "pale">><<updatesidebarimg>><</radiovar>> 창백한</label> |
							<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "dark">><<updatesidebarimg>><</radiovar>> 어두운</label> |
							<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label>
							<br>
						<</if>>
					<<elseif $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
						성별:
						<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "male">><<updatesidebarimg>><</radiovar>> 남성</label> |
						<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "female">><<updatesidebarimg>><</radiovar>> 여성</label>
						<<if $options.nnpcDisplay is "night_monster">> | <label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplayGender" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
						<br>
						피부:
						<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "pale">><<updatesidebarimg>><</radiovar>> 창백한</label> |
						<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "dark">><<updatesidebarimg>><</radiovar>> 어두운</label>
						<<if $options.nnpcDisplay is "black_wolf" || $options.nnpcDisplay is "great_hawk">> | <label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySkin" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
						<br>
					<</if>>
				</span>
				슬롯:
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 0>><<updatesidebarimg>><</radiovar>> 없음</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 1>><<updatesidebarimg>><</radiovar>> 1</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 2>><<updatesidebarimg>><</radiovar>> 2</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 3>><<updatesidebarimg>><</radiovar>> 3</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 4>><<updatesidebarimg>><</radiovar>> 4</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 5>><<updatesidebarimg>><</radiovar>> 5</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 6>><<updatesidebarimg>><</radiovar>> 6</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 7>><<updatesidebarimg>><</radiovar>> 7</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 8>><<updatesidebarimg>><</radiovar>> 8</label> |
				<label data-target='["options.NnpcDisplaySystem"]' data-disabledif="V.options.NnpcDisplaySystem !== 'dolp'"><<radiovar "$options.nnpcDisplaySlot" 9>><<updatesidebarimg>><</radiovar>> 9</label>
				<span id="autoNNPCSave">
					<<if $options.autoNNPCDisplay.enabled is true and $options.nnpcDisplay isnot 0>>
						<br>
						<<link "저장">>
							<<if $options.autoNNPCDisplay[$options.nnpcDisplay] is undefined>>
								<<set $options.autoNNPCDisplay[$options.nnpcDisplay] to {}>>
							<</if>>
							<<set $options.autoNNPCDisplay[$options.nnpcDisplay].slot to $options.nnpcDisplaySlot>>
							<<set $options.autoNNPCDisplay[$options.nnpcDisplay].layer to $options.nnpcDisplayLayer>>
							<<set $options.autoNNPCDisplay[$options.nnpcDisplay].gender to $options.nnpcDisplayGender>>
							<<set $options.autoNNPCDisplay[$options.nnpcDisplay].skin to $options.nnpcDisplaySkin>>

						<</link>>
					<</if>>
				</span>
			</div>
		</div>
		<<script>>
		$(() =>
			$("#nnpcDisplay").on(
				"change",
				"select.macro-listbox, .macro-checkbox, .macro-radiovar",
				function () {

					Wikifier.wikifyEval(`
						/* Build a stable key */
						<<set _nnpcKey to $options.nnpcDisplay>>
						<<if _nnpcKey isnot 0>>
							<<set _nnpcKey to _nnpcKey.toLowerCase()>>
						<</if>>

						/* Ensure per-NPC settings object exists */
						<<if _nnpcKey isnot 0 and $options.autoNNPCDisplay[_nnpcKey] is undefined>>
							<<set $options.autoNNPCDisplay[_nnpcKey] to {}>>
						<</if>>

						/* Only sync from saved settings when NNPC dropdown changes */
						<<if $options._lastNNPCSelected is undefined>>
							<<set $options._lastNNPCSelected to 0>>
						<</if>>

						<<if $options.autoNNPCDisplay.enabled is true and _nnpcKey isnot 0 and $options._lastNNPCSelected isnot _nnpcKey>>
							<<if $options.autoNNPCDisplay[_nnpcKey].gender isnot undefined>>
								<<set $options.nnpcDisplayGender to $options.autoNNPCDisplay[_nnpcKey].gender>>
							<</if>>
							<<if $options.autoNNPCDisplay[_nnpcKey].skin isnot undefined>>
								<<set $options.nnpcDisplaySkin to $options.autoNNPCDisplay[_nnpcKey].skin>>
							<<elseif _nnpcKey is "black_wolf" or _nnpcKey is "great_hawk">>
								<<set $options.nnpcDisplaySkin to "monster">>
							<<else>>
								<<set _properNNPCName to _nnpcKey.split("_").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ")>>
								<<set $options.nnpcDisplaySkin to (C.npc[_properNNPCName]?.skinType isnot "ghost" and C.npc[_properNNPCName]?.skincolour gt 50 ? "dark" : "pale")>>
							<</if>>
							<<if $options.autoNNPCDisplay[_nnpcKey].slot isnot undefined>>
								<<set $options.nnpcDisplaySlot to $options.autoNNPCDisplay[_nnpcKey].slot>>
							<</if>>
							<<if $options.autoNNPCDisplay[_nnpcKey].layer isnot undefined>>
								<<set $options.nnpcDisplayLayer to $options.autoNNPCDisplay[_nnpcKey].layer>>
							<</if>>

							<<set $options._lastNNPCSelected to _nnpcKey>>
						<</if>>

						<<if $options.nnpcDisplayGender is "monster" and _nnpcKey isnot "night_monster">>
							<<set $options.nnpcDisplayGender to "male">>
						<</if>>

						/* Skin guards */
						<<if $options.nnpcDisplaySkin is "monster" and !(_nnpcKey is "black_wolf" || _nnpcKey is "great_hawk")>>
							<<set $options.nnpcDisplaySkin to "pale">>
						<</if>>
						<<if ($options.nnpcDisplaySkin isnot "pale") and ($options.nnpcDisplaySkin isnot "dark") and ($options.nnpcDisplaySkin isnot "monster")>>
							<<set $options.nnpcDisplaySkin to "pale">>
						<</if>>

						<<updatesidebarimg>>

						<<if _nnpcKey isnot 0>>

							<<replace #manualNNPC>>
								<<if $options.autoNNPCDisplay.enabled is true and $options.nnpcDisplay isnot 0>>
									<<if $options.autoNNPCDisplay[$options.nnpcDisplay].genderOverride is true and $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
										성별:
										<label><<radiovar "$options.nnpcDisplayGender" "male">><<updatesidebarimg>><</radiovar>> 남성</label> |
										<label><<radiovar "$options.nnpcDisplayGender" "female">><<updatesidebarimg>><</radiovar>> 여성</label>
										<<if $options.nnpcDisplay is "night_monster">> | <label><<radiovar "$options.nnpcDisplayGender" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
										<br>
									<</if>>
									/* Beast skin selector also surfaces in Auto Mode so Monster form is reachable. */
									<<if $options.nnpcDisplay is "black_wolf" || $options.nnpcDisplay is "great_hawk">>
										피부:
										<label><<radiovar "$options.nnpcDisplaySkin" "pale">><<updatesidebarimg>><</radiovar>> 밝은</label> |
										<label><<radiovar "$options.nnpcDisplaySkin" "dark">><<updatesidebarimg>><</radiovar>> 어두운</label> |
										<label><<radiovar "$options.nnpcDisplaySkin" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label>
										<br>
									<</if>>
								<<elseif $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
									성별:
									<label><<radiovar "$options.nnpcDisplayGender" "male">><<updatesidebarimg>><</radiovar>> 남성</label> |
									<label><<radiovar "$options.nnpcDisplayGender" "female">><<updatesidebarimg>><</radiovar>> 여성</label>
									<<if $options.nnpcDisplay is "night_monster">> | <label><<radiovar "$options.nnpcDisplayGender" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
									<br>
									피부:
									<label><<radiovar "$options.nnpcDisplaySkin" "pale">><<updatesidebarimg>><</radiovar>> 밝은</label> |
									<label><<radiovar "$options.nnpcDisplaySkin" "dark">><<updatesidebarimg>><</radiovar>> 어두운</label>
									<<if $options.nnpcDisplay is "black_wolf" || $options.nnpcDisplay is "great_hawk">> | <label><<radiovar "$options.nnpcDisplaySkin" "monster">><<updatesidebarimg>><</radiovar>> 괴물</label><</if>>
									<br>
								<</if>>
							<</replace>>

							<<replace #autoNNPCSave>>
								<<capture _nnpcKey>>
									<<link "저장">>
										<<set $options.autoNNPCDisplay[_nnpcKey].slot to $options.nnpcDisplaySlot>>
										<<set $options.autoNNPCDisplay[_nnpcKey].layer to $options.nnpcDisplayLayer>>
										<<set $options.autoNNPCDisplay[_nnpcKey].skin to $options.nnpcDisplaySkin>>
										<<set $options.autoNNPCDisplay[_nnpcKey].gender to $options.nnpcDisplayGender>>
									<</link>>
								<</capture>>
							<</replace>>

							<<replace #autoNNPCGenderOverrideToggle>>
								<<if $options.autoNNPCDisplay.enabled is true and $options.nnpcDisplay isnot 0 and $options.nnpcDisplay isnot "ivory_wraith" and $options.nnpcDisplay isnot "luchifen">>
									성별 덮어쓰기: <label><<checkbox "$options.autoNNPCDisplay[$options.nnpcDisplay].genderOverride" false true autocheck>> <mouse class="tooltip linkBlue">(?)<span>성별 덮어쓰기를 켭니다. 네임드 NPC의 신체 성별 대신 원하는 성별의 스프라이트를 고를 수 있습니다.</span></mouse></label>
								<</if>>
							<</replace>>

						<</if>>
					`);

					/* --------- FORCE RADIO DOTS TO MATCH THE LOADED VALUES --------- */
					setTimeout(() => {
						const root = $("#nnpcDisplay");
						if (!root.length) return;

						const slot = V.options.nnpcDisplaySlot;
						root.find("input[type=radio][name$='nnpcDisplaySlot'][value='" + slot + "']").prop("checked", true);

						const layer = V.options.nnpcDisplayLayer;
						root.find("input[type=radio][name$='nnpcDisplayLayer'][value='" + layer + "']").prop("checked", true);

						const gender = V.options.nnpcDisplayGender;
						root.find("input[type=radio][name$='nnpcDisplayGender'][value='" + gender + "']").prop("checked", true);

						const skin = V.options.nnpcDisplaySkin;
						root.find("input[type=radio][name$='nnpcDisplaySkin'][value='" + skin + "']").prop("checked", true);
					}, 0);
				}
			)
		);
		<</script>>


		<div class="settingsToggleItem">
			<label><<checkbox "$options.lowerHalo" false true autocheck>> 우산을 들고 있을 때 후광을 낮춘다.</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.tipdisable" true false autocheck>> 사이드바에 힌트 및 팁 표시 활성화</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.debugdisable" "t" "f" autocheck>> 추가 에러 메시지 활성화</label>
		</div>
		<div class="settingsToggleItem">
			사이드바가 닫혀 있을 때 스탯 표시:
			<<listbox "$options.sidebarStats" autoselect>>
				<<option "비활성화" "disabled">>
				<<option "제한됨" "limited">>
				<<option "모두 표시" "all">>
			<</listbox>>
			<div class="mobile-rec gold">모바일에서는 이 기능을 켜두는 것이 좋습니다!</div>
		</div>
		<div class="settingsToggleItem">
			사이드바가 닫혀 있을 때 시계 표시:
			<<listbox "$options.sidebarTime" autoselect>>
				<<option "비활성화" "disabled">>
				<<option "위" "top">>
				<<option "아래" "bottom">>
			<</listbox>>
			<div class="mobile-rec gold">모바일에서는 이 기능을 켜두는 것이 좋습니다!</div>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.clothingCaption" false true autocheck>> 사이드바에 옷차림 설명 표시</label>
			<span class="tooltip-anchor linkBlue" tooltip="비활성화해도 아바타 위에 마우스를 올리면 설명이 툴팁으로 표시됩니다.">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showCaptionText" false true autocheck>> 사이드바에 캡션 텍스트 표시</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showUiBar" false true autocheck>> 사이드바에 화살표 버튼 표시</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.bigCanvas" false true autocheck>> 사이드뷰 캔버스 확대</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showSidebarEffects" false true autocheck>> 플레이어 캔버스 주변에 효과 표시</label>
			<span class="tooltip-anchor linkBlue" tooltip="<span class='blue'>강우량, 수중 기포 등이 포함됩니다. 사이드바의 온도계를 클릭하면 일시적으로 숨겨 플레이어 캐릭터의 사진을 더 쉽게 찍을 수 있습니다!</span>">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showExactMeasurements" false true autocheck>> 정확한 수치 표시</label>
			<span class="tooltip-anchor linkBlue" tooltip="<span class='blue'>글에서 자지를 묘사할 때 정확한 길이를 표시합니다. 참고: NPC는 생성 단계에서만 이 설정의 영향을 받습니다.</span>">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">미끼 선택 방식:</span>
			<br>
			<label><<radiobutton "$options.fishingBaitSelection" "sidebar" autocheck>> 사이드바</label> |
			<label><<radiobutton "$options.fishingBaitSelection" "dropdown" autocheck>> 드롭다운</label>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">전투</div>
		<div class="settingsToggleItem">
			대상을 "자신"으로 지정:
			<label><<radiobutton "$options.targetYourself" false autocheck>> 비활성화</label> |
			<label><<radiobutton "$options.targetYourself" true autocheck>> 활성화</label>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.scrollRemember" false true autocheck>>
				전투 중 스크롤 위치 복구
			</label>
		</div>
		<div class="settingsToggleItemWide">
			전투 조작계:
			<<listbox "$options.combatControls" autoselect>>
				<<option "라디오 버튼" "radio">>
				<<option "라디오 버튼 (세로열)" "columnRadio">>
				<<option "리스트 (너비 제한 없음)" "lists">>
				<<option "리스트 (너비 제한 있음)" "limitedLists">>
			<</listbox>>
		</div>
	</div>

	<<if $map isnot undefined>>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader options">지도</div>
			<div class="settingsToggleItem">
				<label data-target="images"><<checkbox "$options.mapMovement" false true autocheck>> 지도 아이콘을 클릭/터치하여 지도 이동 활성화</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target="images" data-disabledif="V.options.images===0"><<checkbox "$options.mapLegacy" false true autocheck>> SVG 지도 비활성화. 마을 지도가 보이지 않을 경우 켜 주십시오.</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target="['images', 'maplegacy]" data-disabledif="V.options.images===0||V.options.mapLegacy"><<checkbox "$options.mapMarkers" false true autocheck>> 지도에 클릭 가능한 영역 표시</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target="images"><<checkbox "$options.mapTop" false true autocheck>> 지도 링크 위로 지도 위치 올리기</label>
			</div>
		</div>
	<</if>>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">오버레이</div>
		<div class="settingsToggleItemWide">
			<span class="gold">오버레이 메뉴의 닫기 버튼 위치:</span>
			<span class="tooltip-anchor linkBlue" tooltip="다음에 오버레이를 열 때 적용됩니다.">(?)</span>
			<br>
			<label><<radiobutton "$options.closeButtonMobile" false autocheck>> 표준</label> |
			<label><<radiobutton "$options.closeButtonMobile" true autocheck>> 모바일 (좌측)</label>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">추가 정보</div>
		<div class="settingsToggleItem">
			<span class="gold">화면 우측 상단에 패시지 수 표시:</span>
			<br>
			<label><<radiobutton "$options.passageCount" "disabled" autocheck>> 비활성</label>
			<br>
			<label><<radiobutton "$options.passageCount" "changes" autocheck>> 패시지 이동 횟수</label>
			<span class="tooltip-anchor linkBlue" tooltip="새 패시지로 이동한 총 횟수입니다. 대부분 링크 클릭으로 증가합니다. 설정 같은 패시지는 제외됩니다. 0.3.12.X 이하 버전에서는 추적되지 않습니다.">(?)</span>
			<br>
			<label><<radiobutton "$options.passageCount" "total" autocheck>> 총 패시지 수</label>
			<span class="tooltip-anchor linkBlue" tooltip="새 패시지가 로드된 총 횟수입니다. 대부분 링크 클릭으로 증가합니다. 설정 같은 패시지는 제외됩니다. 0.3.12.X 이하 버전에서는 추적되지 않습니다.">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">화면 우측 상단에 플레이 타임 표시:</span>
			<span class="tooltip-anchor linkBlue" tooltip="h:mm:ss 형식으로 표시됩니다. 게임을 몇 시간 동안 켜둔 채 저장하면 그 시간도 기록됩니다. 이를 피하려면 플레이를 끝내기 전에 저장하고, 다시 시작할 때 그 세이브를 불러오십시오. 0.3.13.X 이하 버전에서는 추적되지 않습니다.">(?)</span>
			<br>
			<label><<radiobutton "$options.playtime" false autocheck>> 비활성</label>
			<br>
			<label><<radiobutton "$options.playtime" true autocheck>> 활성</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showGameVersion" false true autocheck>> 오른쪽 위에 게임 버전 표시</label>
		</div>
	</div>

	<<if $passage isnot "Start">>
		<br>
		<<button "게임 재시작">>
			<<script>>
				SugarCube.UI.restart();
			<</script>>
		<</button>>
	<</if>>
<</widget>>

<<widget "optionstheme">>
	<<setupOptions>>
	<<set _globalThemeDefaults to JSON.parse(localStorage.getItem("dolDefaultThemeSettings"))>>
	<<if !_globalThemeDefaults>>
		<<set _globalThemeDefaults to {}>>
	<</if>>
	<<optionsDefaults>>
	<div class="settingsGrid">
		<div class="settingsHeader options">테마<<optionsThemeDefault "theme">></div>
		<div class="settingsToggleItemWide">
			<span class="gold">스타일:</span>
			<label><input type="radio" name="theme" value="system-default" /> 기본값</label> |
			<label><input type="radio" name="theme" value="dark" /> 다크</label> |
			<label><input type="radio" name="theme" value="arctic" /> 노르드</label> |
			<label><input type="radio" name="theme" value="zen" /> 젠번</label> |
			<label><input type="radio" name="theme" value="monokai" /> 모노카이</label> |
			<label><input type="radio" name="theme" value="storm" /> 스톰</label> |
			<label><input type="radio" name="theme" value="latte" /> 캣푸친 라떼</label> |
			<label><input type="radio" name="theme" value="frappe" /> 캣푸친 프라페</label> |
			<label><input type="radio" name="theme" value="macchiato" /> 캣푸친 마키아토</label> |
			<label><input type="radio" name="theme" value="mocha" /> 캣푸친 모카</label> |
			<label><input type="radio" name="theme" value="sea" /> 바다</label>
			<div class="small-description">테마 선택은 이 설치본 전체에서 공유됩니다. 다른 기본값과 함께 저장하거나 설정을 내보내어 다른 설치본으로 옮기십시오.</div>
		</div>
	</div>
	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader options">줄 간격</div>
		<div class="settingsToggleItem">
			패시지:
			<<listbox "$options.passageLineHeight" autoselect>>
				<<option "기본값" 0>>
				<<option "1" 1>>
				<<option "1.25" 1.25>>
				<<option "1.5" 1.5>>
				<<option "1.75" 1.75>>
				<<option "2" 2>>
			<</listbox>>
			<<optionsThemeDefault "passageLineHeight">>
		</div>
		<div class="settingsToggleItem">
			오버레이:
			<<listbox "$options.overlayLineHeight" autoselect>>
				<<option "기본값" 0>>
				<<option "1" 1>>
				<<option "1.25" 1.25>>
				<<option "1.5" 1.5>>
				<<option "1.75" 1.75>>
				<<option "2" 2>>
			<</listbox>>
			<<optionsThemeDefault "overlayLineHeight">>
		</div>
		<div class="settingsToggleItemWide">
			사이드바:
			<<listbox "$options.sidebarLineHeight" autoselect>>
				<<option "기본값" 0>>
				<<option "1" 1>>
				<<option "1.25" 1.25>>
				<<option "1.5" 1.5>>
				<<option "1.75" 1.75>>
				<<option "2" 2>>
			<</listbox>>
			<<optionsThemeDefault "sidebarLineHeight">>
		</div>
	</div>
	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader options">글꼴 크기</div>
		<div class="settingsToggleItem">
			패시지:
			<<listbox "$options.passageFontSize" autoselect>>
				<<option "기본값" 0>>
				<<option "10px" 10>>
				<<option "12px" 12>>
				<<option "14px" 14>>
				<<option "16px" 16>>
				<<option "18px" 18>>
				<<option "20px" 20>>
			<</listbox>>
			<<optionsThemeDefault "passageFontSize">>
		</div>
		<div class="settingsToggleItem">
			<mouse class="tooltip">오버레이<span class="blue">기본값은 패시지 글꼴 크기와 동일합니다.</span></mouse>:
			<<listbox "$options.overlayFontSize" autoselect>>
				<<option "기본값" 0>>
				<<option "10px" 10>>
				<<option "12px" 12>>
				<<option "14px" 14>>
				<<option "16px" 16>>
				<<option "18px" 18>>
				<<option "20px" 20>>
			<</listbox>>
			<<optionsThemeDefault "overlayFontSize">>
		</div>
		<div class="settingsToggleItemWide">
			사이드바:
			<<listbox "$options.sidebarFontSize" autoselect>>
				<<option "기본값" 0>>
				<<option "12px" 12>>
				<<option "14px" 14>>
				<<option "16px" 16>>
				<<option "18px" 18>>
				<<option "20px" 20>>
			<</listbox>>
			<<optionsThemeDefault "sidebarFontSize">>
		</div>
	</div>
	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader options">글꼴 스타일</div>
		<div class="settingsToggleItemWide">
			<<optionsThemeDefault "font">>
			<label><<radiobutton "$options.font" "" `$options.font is undefined ? 'checked' : 'autocheck'`>> 시스템 기본값 사용</label>
			<br>
			<span class="gold">산세리프:</span>
			<label class="Arial"><<radiobutton "$options.font" "Arial" autocheck>> Arial</label> |
			<label class="Verdana"><<radiobutton "$options.font" "Verdana" autocheck>> Verdana</label>
			<br>
			<span class="gold">세리프:</span>
			<label class="TimesNewRoman"><<radiobutton "$options.font" "TimesNewRoman" autocheck>> Times New Roman</label> |
			<label class="Georgia"><<radiobutton "$options.font" "Georgia" autocheck>> Georgia</label> |
			<label class="Garamond"><<radiobutton "$options.font" "Garamond" autocheck>> Garamond</label>
			<br>
			<span class="gold">모노스페이스:</span>
			<label class="CourierNew"><<radiobutton "$options.font" "CourierNew" autocheck>> Courier New</label> |
			<label class="LucidaConsole"><<radiobutton "$options.font" "LucidaConsole" autocheck>> Lucida Console</label> |
			<label class="Monaco"><<radiobutton "$options.font" "Monaco" autocheck>> Monaco</label>
			<br>
			<span class="gold">접근성:</span>
			<label class="OpenDyslexicMono"><<radiobutton "$options.font" "OpenDyslexicMono" autocheck>> OpenDyslexic Mono</label> |
			<label class="ComicSans"><<radiobutton "$options.font" "ComicSans" autocheck>> Comic Sans</label> |
			<label class="Lexend"><<radiobutton "$options.font" "Lexend" autocheck>> Lexend</label>
		</div>
	</div>
	<hr>

	<div class="settingsGrid">
		<div class="settingsHeader options">텍스트 애니메이션</div>
		<div class="settingsToggleItemWide">
			<label data-target="options.textAnimsAll">
				<<checkbox "$options.textAnimsAll" false true autocheck { onToggle: t => {
					$("#prevDrunk").replaceWith(Wikifier.wikifyEval('<span id="prevDrunk" @class="basicDrunkCss(3)">취기 흔들림</span>'));
					$("#prevHeat").replaceWith(Wikifier.wikifyEval('<span id="prevHeat" @class="basicJitterCss()">발정기/러트 떨림</span>'));
					$("#prevHypno").replaceWith(Wikifier.wikifyEval('<span id="prevHypno"><<hypnosisText "최면 나선">></span>'));
					setup.arcology.syncGlitch();
				}}>>
				모든 텍스트 애니메이션을 비활성화하려면 체크를 해제하십시오
			</label>
			<br>
			<label>
			<<checkbox "$options.textAnimsDrunk" false true autocheck { onToggle: t => {
				$("#prevDrunk").replaceWith(Wikifier.wikifyEval('<span id="prevDrunk" @class="basicDrunkCss(3)">취기 흔들림</span>'));
			}}>>
			<span id="prevDrunk" @class="basicDrunkCss(3)">취기 흔들림</span>
			</label>
			<br>
			<label>
			<<checkbox "$options.textAnimsHeat" false true autocheck { onToggle: t => {
				$("#prevHeat").replaceWith(Wikifier.wikifyEval('<span id="prevHeat" @class="basicJitterCss()">발정기/러트 떨림</span>'));
			}}>>
			<span id="prevHeat" @class="basicJitterCss()">발정기/러트 떨림</span>
			</label>
			<br>
			<label>
			<<checkbox "$options.textAnimsHypno" false true autocheck { onToggle: t => {
				$("#prevHypno").replaceWith(Wikifier.wikifyEval('<span id="prevHypno"><<hypnosisText "최면 나선">></span>'));
			}}>>
			<span id="prevHypno"><<hypnosisText "최면 나선">></span>
			</label>
			<br>
			<label>
			<<checkbox "$options.textAnimsGlitch" false true autocheck { onToggle: t => setup.arcology.syncGlitch() }>>
			<span class="luchifen-name" data-text="사이버네틱 효과">글리치 효과</span>
			</label>
		</div>
	</div>
<</widget>>

<<widget "optionsThemeDefault">>
	<<if _args[0]>>
		<span @id="'optionsThemeDefault-' + _args[0]">
			<<if _globalThemeDefaults?.[_args[0]] isnot undefined>> 기본값: (<<print _globalThemeDefaults[_args[0]]>>)
			<<elseif _globalGeneralDefaults?.[_args[0]] isnot undefined>> 기본값: (<<print _globalGeneralDefaults[_args[0]]>>)
			<</if>>
		</span>
	<</if>>
<</widget>>

<<widget "optionsperformance">>
	<<setupOptions>>
	<<optionsDefaults>>
	<div class="settingsGrid">
		<div class="settingsHeader options">오디오</div>
		<div class="settingsToggleItemWide">
			<label><<checkbox "$options.audio" 0 1 autocheck>> 오디오 활성화</label>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.muteonhide" 0 1 autocheck>> 화면이 가려지면 음소거</label>
			<mouse class="tooltip-small linkBlue">(?)<span>게임이 기기의 주 포커스에서 벗어났을 때(다른 탭으로 전환했거나 브라우저 창을 최소화했을 때) 게임 오디오를 자동으로 음소거합니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.npcVoiceoverAudio" 0 1 autocheck>> NPC 음성 활성화</label>
			<mouse class="tooltip-small linkBlue">(?)<span>NPC의 신음과 절정 소리를 활성화합니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceoverAudio" 0 1 autocheck>> 플레이어 음성 활성화</label>
			<mouse class="tooltip-small linkBlue">(?)<span>플레이어 캐릭터의 신음, 헐떡임, 절정 소리를 활성화합니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.postureAffectsVoice" 0 1 autocheck>> 성별 자세가 목소리에 영향</label>
			<mouse class="tooltip-small linkBlue">(?)<span>활성화하면 성별 자세를 어느 쪽 성별로 설정하든 몸의 타고난 목소리 대신 그 성별의 목소리가 쓰입니다.</span></mouse>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">몸 &amp; 정체성별 음성</span>
			<mouse class="tooltip-small linkBlue">(?)<span>몸/정체성 상태마다 어떤 음성을 쓸지, 그 상태에서 자신의 목소리를 음소거할지, 어떤 NPC 음성을 들을지 고릅니다. "시시"(여성스럽게 꾸민 남성)와 "부치"(남성스럽게 꾸민 여성)는 "성별 자세가 목소리에 영향"이 활성화되어 있을 때만 남성/여성과 달라집니다. 헤름 항목은 X-체인지 헤름 효과가 켜져 있는 동안에만 나타납니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceConfig.male.enabled" false true autocheck>> 남성</label>
			<<listbox "$options.voiceConfig.male.voice" autoselect>>
				<<option "여성 (헨타이)" "v1">><<option "여성 (서양)" "v2">><<option "남성" "m">>
			<</listbox>>
			NPC: <<listbox "$options.voiceConfig.male.npc" autoselect>>
				<<option "전체" "all">><<option "남성만" "m">><<option "여성만" "f">><<option "없음" "off">>
			<</listbox>>
		</div>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceConfig.female.enabled" false true autocheck>> 여성</label>
			<<listbox "$options.voiceConfig.female.voice" autoselect>>
				<<option "여성 (헨타이)" "v1">><<option "여성 (서양)" "v2">><<option "남성" "m">>
			<</listbox>>
			NPC: <<listbox "$options.voiceConfig.female.npc" autoselect>>
				<<option "전체" "all">><<option "남성만" "m">><<option "여성만" "f">><<option "없음" "off">>
			<</listbox>>
		</div>
		<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and xchangeGenderificationDirection() is "sissy">>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceConfig.sissy.enabled" false true autocheck>> 시시</label>
			<<listbox "$options.voiceConfig.sissy.voice" autoselect>>
				<<option "여성 (헨타이)" "v1">><<option "여성 (서양)" "v2">><<option "남성" "m">>
			<</listbox>>
			NPC: <<listbox "$options.voiceConfig.sissy.npc" autoselect>>
				<<option "전체" "all">><<option "남성만" "m">><<option "여성만" "f">><<option "없음" "off">>
			<</listbox>>
		</div>
		<</if>>
		<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and xchangeGenderificationDirection() is "butch">>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceConfig.butch.enabled" false true autocheck>> 부치</label>
			<<listbox "$options.voiceConfig.butch.voice" autoselect>>
				<<option "여성 (헨타이)" "v1">><<option "여성 (서양)" "v2">><<option "남성" "m">>
			<</listbox>>
			NPC: <<listbox "$options.voiceConfig.butch.npc" autoselect>>
				<<option "전체" "all">><<option "남성만" "m">><<option "여성만" "f">><<option "없음" "off">>
			<</listbox>>
		</div>
		<</if>>
		<<if playerIsHerm()>>
		<div class="settingsToggleItem">
			<label data-target="options.audio" data-disabledif="V.options.audio===0"><<checkbox "$options.voiceConfig.herm.enabled" false true autocheck>> 헤름</label>
			<<listbox "$options.voiceConfig.herm.voice" autoselect>>
				<<option "여성 (헨타이)" "v1">><<option "여성 (서양)" "v2">><<option "남성" "m">>
			<</listbox>>
			NPC: <<listbox "$options.voiceConfig.herm.npc" autoselect>>
				<<option "전체" "all">><<option "남성만" "m">><<option "여성만" "f">><<option "없음" "off">>
			<</listbox>>
		</div>
		<</if>>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target="options.audio" data-disabledif="V.options.audio===0">
			<span class="gold">전체 음량:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>게임 내 모든 오디오의 전체 음량을 조절합니다.</span></mouse>
			<<numberslider "$options.mastervolume" $options.mastervolume 0 1 0.01 {
				onInputChange: value => wikifier("<<master-audio-update>>"),
				value: () => Math.round($options.mastervolume * 100)+`%`
			}>>
			</label><br>
		</div>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target="options.audio" data-disabledif="V.options.audio===0">
			<span class="gold">배경 음악:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>배경 음악의 전체 음량을 조절합니다. 0%로 설정하면 배경 음악이 꺼집니다.</span></mouse>
			<<numberslider "$options.bgm_volume" $options.bgm_volume 0 1 0.01 {
				onInputChange: value => wikifier("<<master-audio-update>>"),
				value: () => Math.round($options.bgm_volume * 100)+`%`
			}>>
			</label><br>
		</div>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target="options.audio" data-disabledif="V.options.audio===0">
			<span class="gold">배경 효과음:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>배경 효과음(반복되는 섹스 소리 포함)의 전체 음량을 조절합니다.</span></mouse>
			<<numberslider "$options.bgs_volume" $options.bgs_volume 0 1 0.01 {
				onInputChange: value => wikifier("<<master-audio-update>>"),
				value: () => Math.round($options.bgs_volume * 100)+`%`
			}>>
			</label><br>
		</div>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target="options.audio" data-disabledif="V.options.audio===0">
			<span class="gold">환경음:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>날씨와 번개 같은 환경음을 배경 효과음과 별개로 조절합니다. 0%로 설정하면 환경음이 꺼집니다. 소리는 실내에서 더 작게 들립니다.</span></mouse>
			<<numberslider "$options.ambience_volume" $options.ambience_volume 0 1 0.01 {
				onInputChange: value => wikifier("<<master-audio-update>>"),
				value: () => Math.round($options.ambience_volume * 100)+`%`
			}>>
			</label><br>
		</div>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target="options.audio" data-disabledif="V.options.audio===0">
			<span class="gold">음성:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>캐릭터 음성(절정, 신음, 핥는 소리 등)의 전체 음량을 조절합니다.</span></mouse>
			<<numberslider "$options.voice_volume" $options.voice_volume 0 1 0.01 {
				onInputChange: value => wikifier("<<master-audio-update>>"),
				value: () => Math.round($options.voice_volume * 100)+`%`
			}>>
			</label><br>
		</div>
		<div class="settingsToggleItem numberslider-inline">
			<label data-target='["options.audio","options.voiceoverAudio"]' data-disabledif="V.options.audio===0 || V.options.voiceoverAudio===0">
			<span class="gold">전투 외 흥분 신음:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>교전이 아닌 상황에서 흥분이 최대치에 이르러 저절로 터져 나오는 플레이어의 신음 음량을 조절합니다. 0%로 설정하면 음소거됩니다. 전투 중 음성에는 영향이 없습니다.</span></mouse>
			<<numberslider "$options.nonCombatMoanVolume" $options.nonCombatMoanVolume 0 1 0.01 {
				onInputChange: value => wikifier("<<update-audio>>"),
				value: () => Math.round($options.nonCombatMoanVolume * 100)+`%`
			}>>
			</label><br>
		</div>
	</div>
	<hr>
	<<if StartConfig.enableImages is true>>
		<div class="settingsGrid">
			<div class="settingsHeader options">이미지</div>
			<div class="settingsToggleItem">
				<label><<checkbox "$options.images" 0 1 autocheck>> 이미지 활성화</label>
				<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>오래된 안드로이드 기기에서는 이미지가 제대로 불러와지지 않을 수 있습니다.</span>">(?)</span>
			</div>
			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.combatImages" 0 1 autocheck>> 전투 이미지 활성화</label>
			</div>

			<div class="settingsToggleItem" onchange="new Wikifier(null, '<<updatesidebarimg>>')">
				<label data-target='["options.images","options.altImgAlways"]' data-disabledif="V.options.images===0 || V.options.altImgAlways===1"><<checkbox "$options.useAltImg" 0 1 autocheck>> 성별에 따라 스프라이트 세트 교체:
					<<listbox "$options.altImgGender" autoselect>>
						<<option "여성" "f">>
						<<option "남성" "m">>
					<</listbox>>
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="When enabled, the game loads all its images from 'img2' instead of 'img' whenever your sex matches the selection. WARNING: You must supply your own 'img2' folder. Therefore, this does not work on Dolmods, or APKs without this built-in capability.">(?)</span>
			</div>

			<div class="settingsToggleItem" onchange="new Wikifier(null, '<<updatesidebarimg>>')">
				<label data-target='["options.images","options.useAltImg"]' data-disabledif="V.options.images===0 || V.options.useAltImg===1"><<checkbox "$options.altImgAlways" 0 1 autocheck>> 대체 스프라이트 세트를 항상 사용</label>
				<span class="tooltip-anchor linkBlue" tooltip="When enabled, the game always loads all its images from 'img2' instead of 'img', regardless of your body. This lets you pick your preferred spritepack without it changing when your gender changes. WARNING: You must supply your own 'img2' folder. Therefore, this does not work on Dolmods, or APKs without this built-in capability.">(?)</span>
			</div>

			<div class="settingsToggleItem">
				<label data-target='["options.images","options.combatImages"]' data-disabledif="V.options.images===0 || V.options.combatImages===0"><<checkbox "$options.showCombatImgWhileStanding" 0 1 autocheck>> 서 있는 동안에도 전투 이미지 표시</label>
				<span class="tooltip-anchor linkBlue" tooltip="When unchecked, hides the combat images while your PC still has stability remaining. The images show once again after you fall.">(?)</span>
			</div>

			<div class="settingsToggleItem">
				<label data-target='["options.images","options.combatImages"]' data-disabledif="V.options.images===0 || V.options.combatImages===0">
					성별이 다음일 때 전투 이미지 표시:
					<<listbox "$options.showCombatImgWhenGender" autoselect>>
						<<option "둘 다" "both">>
						<<option "여성" "f">>
						<<option "남성" "m">>
					<</listbox>>
					
					<span class="tooltip-anchor linkBlue" tooltip="Shows the combat images when your PC's current sex matches this selection">(?)</span>
				</label>
			</div>

			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.showCurrentSexIcon" 0 1 autocheck>> 사이드바에 성별 기호 표시</label>
			</div>

			<div class="settingsToggleItem">
				<label>사이드바 기호:
					<<listbox "$options.currentSexIconIdentity" autoselect>>
						<<option "신체 성별" 0>>
						<<option "성 정체성" 1>>
					<</listbox>>
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="Gender identity follows how you feel: boy, girl, or enby. The transgender background uses a trans symbol. Body sex includes pill effects.">(?)</span>
			</div>

			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.showPortalXray" 0 1 autocheck>> 포털 엑스레이 컷인 표시</label>
				<span class="tooltip-anchor linkBlue" tooltip="Shows xray images when a penetration happens due to a portal pill effect.">(?)</span>
			</div>

			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.silhouetteEnabled" false true autocheck>> NPC 실루엣 활성화</label>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader options">렌더링</div>
			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.weatherUpdate" false true autocheck>> 사이드바 날씨 렌더러 사용</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["options.images", "weatherupdate"]' data-disabledif="V.options.images===0||V.options.weatherUpdate===false"><<checkbox "$options.reflections" false true autocheck>> 물 반사 렌더링
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>오래된 기기에서는 성능 문제가 발생할 수 있습니다.</span>">(?)</span>
			</div>
			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0"><<checkbox "$options.bodySizeScaling" false true autocheck>> 사이드바 이미지를 체형 크기에 맞춰 조절
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>사이드바 캐릭터를 키에 따라 더 크게 또는 더 작게 표시합니다. 끄면 이미지 크기를 고정합니다.</span>">(?)</span>
			</div>
			<div class="description">변경 사항을 적용하려면 옵션 메뉴를 닫으십시오.</div>
		</div>
		<span class="gold">애니메이션</span>
		<div class="settingsGrid">
			<div class="settingsToggleItem">
				<label data-target="options.images" data-disabledif="V.options.images===0">
					<<checkbox "$options.sidebarAnimations" false true autocheck>> 사이드바 캐릭터 애니메이션
				</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target='["options.images", "sidebaranimations"]' data-disabledif="V.options.images===0||V.options.sidebarAnimations===false">
					<<checkbox "$options.blinkingEnabled" false true autocheck>> 눈 깜빡임 애니메이션
				</label>
			</div>
			<div class="settingsToggleItem">
				<label data-target="images" data-disabledif="V.options.images===0||V.options.combatImages===0">
					<<checkbox "$options.combatAnimations" false true autocheck>> 전투 애니메이션
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>비활성화하면 전투 중 성능이 향상될 수 있습니다.</span>">(?)</span>
			</div>
			<<if $eyelidTEST is true>>
				<div class="settingsToggleItem">
					<label data-target='["options.images", "sidebaranimations"]' data-disabledif="V.options.images===0||V.options.sidebarAnimations===false">
						<<checkbox "$options.halfClosedEnabled" false true autocheck>> 반쯤 감은 눈 그래픽 활성화
					</label>
				</div>
				<div class="description">
					흥분도가 높을 때 사이드바의 눈꺼풀을 반쯤 감은 모습으로 그립니다.
				</div>
			<</if>>
		</div>
		<hr>
		<div>
			<div class="settingsGrid" data-target='["images", "characterLightEnabled"]' data-disabledif="V.options.images===0||V.options.characterLightEnabled===false" oninput='Renderer.refresh(Renderer.locateModel("lighting", "sidebar"));'>
				<div class="settingsHeader options">캐릭터 조명</div>
				<div class="settingsToggleItem">
					<label>
						스포트라이트<br>
						<<numberslider "$options.lightSpotlight" $options.lightSpotlight 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						그라데이션<br>
						<<numberslider "$options.lightGradient" $options.lightGradient 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						발광<br>
						<<numberslider "$options.lightGlow" $options.lightGlow 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						평면<br>
						<<numberslider "$options.lightFlat" $options.lightFlat 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						색상 요소<br>
						<<numberslider "$options.lightTFColor" $options.lightTFColor 0 1 0.05>>
						<span class="description">천사/악마 변신 필요</span>
					</label>
				</div>
			</div>
			<div style="margin-left: 10px" onchange="new Wikifier(null, '<<replace #condomsSidebar>><<condomsSidebar>><</replace>>')">
				<label data-target="options.images" data-disabledif="V.options.images===0">
					<<checkbox "$options.characterLightEnabled" false true autocheck>> 캐릭터 조명 활성화
				</label>
			</div>
		</div>
		<hr>
		<div>
			<div class="settingsGrid" data-target='["images", "combatImages", "combatLightEnabled"]' data-disabledif="V.options.images===0||!V.options.combatImages||V.options.characterLightEnabled===false" oninput='Renderer.refresh(Renderer.locateModel("lighting", "combat-lighting"));Renderer.refresh(Renderer.locateModel("lighting", "combat-lighting-demo"));'>
				<div class="settingsHeader options">전투 시각 효과</div>
				<div class="settingsToggleItem d-flex justify-content-center lighting-demo-container">
					<div id="combatLightingDemo"><<setupCombatLightingDemo>></div>
					<div id="combatLightingToggle" onchange="new Wikifier(null, '<<updateCombatLightingDemo #combatLightingDemo>>')">
						<label data-target='["images", "combatImages"]' data-disabledif="V.options.images===0||!V.options.combatImages">
							<<checkbox "$options.combatLightEnabled" false true autocheck>> 전투 조명 활성화
						</label>
					</div>
				</div>
				<div class="settingsToggleItem d-flex justify-content-center boob-demo-container">
					<div id="closeBreastDemo"><<setupBreastjobDemo>></div>
					<div id="closeBreastToggle" onchange="new Wikifier(null, '<<replace #closeBreastDemo>><<setupBreastjobDemo>><</replace>>')">
						<label data-target='["images", "combatImages"]' data-disabledif="V.options.images===0||!V.options.combatImages">
							<<checkbox "$options.topdownBreastjob" false true autocheck>> 하향식 파이즈리 활성화 (큰 가슴 전용)
						</label>
					</div>
				</div>
				<div class="settingsToggleItem">
					<label>
						Y 오프셋<br>
						<<numberslider "$options.combatLightOffsetY" $options.combatLightOffsetY 0 128 1>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						스포트라이트 강도<br>
						<<numberslider "$options.combatLightSpotlight" $options.combatLightSpotlight 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						스포트라이트 너비<br>
						<<numberslider "$options.combatLightSpotlightX" $options.combatLightSpotlightX 0 128 1>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						스포트라이트 높이<br>
						<<numberslider "$options.combatLightSpotlightY" $options.combatLightSpotlightY 0 48 1>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						그라데이션<br>
						<<numberslider "$options.combatLightGradient" $options.combatLightGradient 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						발광<br>
						<<numberslider "$options.combatLightGlow" $options.combatLightGlow 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						평면<br>
						<<numberslider "$options.combatLightFlat" $options.combatLightFlat 0 1 0.05>>
					</label>
				</div>
				<div class="settingsToggleItem">
					<label>
						색상 요소<br>
						<<numberslider "$options.combatLightTFColor" $options.combatLightTFColor 0 1 0.05>>
						<span class="description">천사/악마 변신 필요</span>
					</label>
				</div>
			</div>
		</div>
	<<else>>
		<br>
		이미지 비활성화됨
	<</if>>
<</widget>>

<<widget "setupCombatLightingDemo">>
	<<run Renderer.refresh(Renderer.locateModel("lighting", "combat-lighting-demo"))>>
	<<selectmodel "lighting" "combat-lighting-demo">>
	<<configureCombatLighting>>
	<<if $passage isnot "Start" and $hairColourGradient isnot undefined>>
		<<rendermodel "lighting position-absolute z-hidden">>
		<<selectmodel "combatMainPc" "combatMainDemo">>
		<<rendermodel "combatMainPc">>
	<<else>>
		<<rendermodel "lighting z-hidden">>
	<</if>>
<</widget>>

<<widget "setupBreastjobDemo">>
	<<run Renderer.refresh(Renderer.locateModel("combatCloseDemo", "combat-boob-demo"))>>
	<<set T.breastjobDemo to true>>
	<<selectmodel "combatCloseDemo" "combat-boob-demo">>
	<<if $passage isnot "Start" and $hairColourGradient isnot undefined>>
		<<selectmodel "combatCloseDemo" "combatCloseDemo">>
		<<if $options.sidebarAnimations isnot false>>
			<<animatemodel "combatCloseDemo">>
		<<else>>
			<<rendermodel "combatCloseDemo">>
		<</if>>
	<<else>>
		<<rendermodel "combatCloseDemo z-hidden">>
	<</if>>
<</widget>>

<<widget "updateCombatLightingDemo">>
	<<if elementExists(_args[0])>>
		<<replace _args[0]>><<setupCombatLightingDemo>><</replace>>
	<</if>>
<</widget>>

<<widget "optionsadvanced">>
	<<setupOptions>>
	<div class="settingsGrid">
		<div class="settingsHeader options">고급 설정</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.numpad" false true autocheck>>
				숫자 키패드 활성화
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>번역 소프트웨어 때문에 링크가 깨지는 모바일 환경에서 유용합니다.</span>">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$options.useNarrowMarket" false true autocheck>>
				시장 인벤토리의 "좁은 화면" 버전 사용
			</label>
		</div>
		<div class="settingsToggleItem">
			<label><<checkbox "$options.showDebugRenderer" false true autocheck>> 렌더러 디버거 활성화</label>
		</div>
		<<if $debug or $options.showCombatTools>>
			<div class="settingsToggleItem">
				<label><<checkbox "$options.showCombatTools" false true autocheck>> 전투 도구 활성화</label>
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<label onclick="setTimeout(() => {toggleConfirmDialogUponTabClose();}, 100)">
				<<checkbox "$options.confirmDialogUponTabClose" false true autocheck>>
				탭을 닫을 때 확인 대화창 표시
			</label>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">능력치 너프 배율:</span>
			<mouse class="tooltip linkBlue">(?)<span>실패하면 어떻게 되는지 보고 싶을 때, 능력치를 약화시킵니다.</span></mouse>
			<<numberslider "$options.statNerf" $options.statNerf 0 100 1>>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">게임 화면 확대</div>
		<div class="settingsToggleItemWide">
			<span class="gold">확대 크기:</span>
			<span class="tooltip-anchor linkBlue" tooltip-width="460" tooltip="<span class='linkBlue'>게임 요소와 텍스트의 크기를 조절할 수 있습니다.</span><br><br><span class='red'>
						이 설정은 주의해서 사용하십시오! 변경된 화면에 만족할 때만 저장하십시오. 게임을 다시 로드하면 해당 저장 파일에서 마지막으로 사용된 값으로 재설정됩니다.
						기기 및 브라우저에 따라 설정이 완전히 깨지거나 예기치 않은 결과가 발생할 수 있습니다.
					</span>">(?)</span>
			<br>
			<span class="description red">일부 브라우저에서는 지원되지 않음</span>
			<br>
			<<numberslider "$options.zoom" $options.zoom 50 200 1>>
			<br><br>
			<input type="button" value="설정" onclick='zoom()'/>
			<input type="button" value="초기화" onclick='zoom(100)'/>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">히스토리 깊이</div>
		<<if not $ironmanmode>>
			<div class="settingsToggleItem">
				N-1 이전의 히스토리로 되돌아가기를 활성화합니다. 버그를 보고하거나 선택을 되돌릴 때 유용합니다.
				<hr>
				<label>
					<<checkbox "$options.historyControls" false true autocheck>> 사이드바에 히스토리 컨트롤 표시
				</label>
				<<if $debug is 1>>
					<span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>숫자 키패드의 /와 -로 패시지 기록을 오갈 수 있습니다. *는 새로운 난수로 패시지를 다시 불러옵니다.</span>">(?)</span>
				<</if>>
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<span class="gold">메모리에 저장된 상태:</span>
			<<numberslider "$options.maxStates" `$options.maxStates gt 100 ? 100 : $options.maxStates` 1 100 1>>
			<br><br>
		</div>
	</div>
<</widget>>

<<widget "optionsinformation">>
	<div class="p-2 text-align-center">
		<h3>관련자</h3>

		<div class="m-2">
			<span class="gold">제작자: </span><span>Vrelnir</span>
		</div>
	</div>

	<div class="p-2 text-align-center">
		<h3>X-체인지 모드</h3>

		<div class="m-2">
			<span class="lewd">제작자: </span><span>Akoz</span>
		</div>
		<div class="m-2">
			<span class="lewd">기여자: </span><span>Aelxer</span>
		</div>

	<div class="p-2 text-align-center">
		<h3>유용한 자료들</h3>
		<<linkinformation>>
		<div class="m-2">
			<p class="gold m-0">비공식 위키</p>
			[[바닐라|"https://degreesoflewdity.miraheze.org/wiki/Main_Page"]]<br>
			[[DoLP|"https://dolmodding.miraheze.org/wiki/DoL_Plus"]] | [[DoLX|"https://dolmodding.miraheze.org/wiki/DoL_Plus/X-Change"]]
		</div>
	</div>
<</widget>>

<<widget "setFont">>
	<<set _globalThemeDefaults to JSON.parse(localStorage.getItem("dolDefaultThemeSettings"))>>
	<<if !_globalThemeDefaults>>
		<<set _globalThemeDefaults to {}>>
	<</if>>
	<<removeclass "#passages" "passageMaxWidth50">>
	<<removeclass "#passages" "passageMaxWidth55">>
	<<removeclass "#passages" "passageMaxWidth60">>
	<<removeclass "#passages" "passageMaxWidth65">>
	<<removeclass "#passages" "passageMaxWidth70">>
	<<removeclass "#passages" "passageMaxWidth75">>
	<<if $options.passageMaxWidth>><<addclass "#passages" `"passageMaxWidth" + $options.passageMaxWidth`>><</if>>

	<<removeclass "#passages" "fontSize10">>
	<<removeclass "#passages" "fontSize12">>
	<<removeclass "#passages" "fontSize14">>
	<<removeclass "#passages" "fontSize16">>
	<<removeclass "#passages" "fontSize18">>
	<<removeclass "#passages" "fontSize20">>
	<<if $options.passageFontSize>><<addclass "#passages" `"fontSize" + $options.passageFontSize`>><</if>>

	<<removeclass "#story-caption" "fontSize12">>
	<<removeclass "#story-caption" "fontSize14">>
	<<removeclass "#story-caption" "fontSize16">>
	<<removeclass "#story-caption" "fontSize18">>
	<<removeclass "#story-caption" "fontSize20">>
	<<if $options.sidebarFontSize>><<addclass "#story-caption" `"fontSize" + $options.sidebarFontSize`>><</if>>

	<<if _args[0]>><!--For elements that are not sugarcube specific and wont be loaded when the widget is normally called-->
		<<removeclass "#customOverlay" "fontSize10">>
		<<removeclass "#customOverlay" "fontSize12">>
		<<removeclass "#customOverlay" "fontSize14">>
		<<removeclass "#customOverlay" "fontSize16">>
		<<removeclass "#customOverlay" "fontSize18">>
		<<removeclass "#customOverlay" "fontSize20">>
		<<if $options.overlayFontSize>><<addclass "#customOverlay" `"fontSize" + $options.overlayFontSize`>><</if>>
	<</if>>

	<<removeclass "#passages" "lineHeight1">>
	<<removeclass "#passages" "lineHeight125">>
	<<removeclass "#passages" "lineHeight15">>
	<<removeclass "#passages" "lineHeight175">>
	<<removeclass "#passages" "lineHeight2">>
	<<if $options.passageLineHeight>><<addclass "#passages" `"lineHeight" + $options.passageLineHeight.toString().replace('.','')`>><</if>>

	<<removeclass "#story-caption" "lineHeight1">>
	<<removeclass "#story-caption" "lineHeight125">>
	<<removeclass "#story-caption" "lineHeight15">>
	<<removeclass "#story-caption" "lineHeight175">>
	<<removeclass "#story-caption" "lineHeight2">>
	<<if $options.sidebarLineHeight>><<addclass "#story-caption" `"lineHeight" + $options.sidebarLineHeight.toString().replace('.','')`>><</if>>

	<<if _args[0]>>
		<<removeclass "#customOverlay" "lineHeight1">>
		<<removeclass "#customOverlay" "lineHeight125">>
		<<removeclass "#customOverlay" "lineHeight15">>
		<<removeclass "#customOverlay" "lineHeight175">>
		<<removeclass "#customOverlay" "lineHeight2">>
		<<if $options.overlayLineHeight>><<addclass "#customOverlay" `"lineHeight" + $options.overlayLineHeight.toString().replace('.','')`>><</if>>
	<</if>>

	<<removeclass "html" "Arial">>
	<<removeclass "html" "Verdana">>
	<<removeclass "html" "TimesNewRoman">>
	<<removeclass "html" "Georgia">>
	<<removeclass "html" "Garamond">>
	<<removeclass "html" "CourierNew">>
	<<removeclass "html" "LucidaConsole">>
	<<removeclass "html" "Monaco">>
	<<removeclass "html" "ComicSans">>
	<<removeclass "html" "OpenDyslexicMono">>
	<<removeclass "html" "Lexend">>
	<<if $options.font>><<addclass "html" $options.font>><</if>> <!--Adding to the body would remove it on changing passage-->
<</widget>>
