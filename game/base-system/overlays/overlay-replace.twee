		<<button "테마">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<optionstheme>><</replace>>
		<</button>>
		<<button "성능">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<optionsperformance>><</replace>>
		<</button>>
		<<button "고급">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<optionsadvanced>><</replace>>
		<</button>>
