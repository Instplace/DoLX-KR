:: FeatsUI [widget]
<<widget "feats">>
	<<updateFeats>>
	<br>
Degrees of Lewdity를 플레이하며 다양한 임무를 완수함으로써 <span class="gold">업적</span>을 얻게 됩니다. 더 많은 업적을 얻을수록 더 많은 <span class="gold">브렐 코인</span>을 얻습니다. 새로운 게임을 시작할 때 브렐 코인을 이용해 <span class="gold">업적 부스터</span>를 구매할 수 있습니다. 이 부스터들은 다음 게임 시 다양한 보너스를 제공합니다.
	<br><br>
	이 탭은 <span class="gold">가장 최근에 불러온 세이브</span>에서 해금된 모든 업적들을 보여주며, 이 정보는 다음 게임으로 인계됩니다. 브렐 코인은 하나의 게임 회차 내에서 누적되어 얻어집니다. <span class="red">여러 세이브 파일들을 넘나들며 플레이할 경우 획득한 코인과 잠금 해제된 업적들이 초기화되어 사라질 수 있습니다.</span>
	<br><br>
	모든 업적을 달성하기 위해서는 여러 번의 플레이가 필요합니다. 각기 다른 업적을 달성한 여러 세이브 파일이 존재한다면, 새로운 게임을 시작할 때 업적 부스터 창에 위치한 <span class="gold">모든 업적 불러오기</span> 버튼을 통해 여러 업적들을 병합할 수 있습니다. 100% 달성을 노리고 계시다면 참고해 주시길 바랍니다!
	<br><br>
	어떤 업적들은 조건을 달성하자마자 획득 표시가 뜨지만, 또 다른 업적들은 게임 내 시간이 다음 시간으로 넘어가야 표시됩니다. 그럼 즐거운 수집 시간 되시길 바랍니다!
	<br><br>

	<<if $feats.locked>>
		<span class="red">플레이 도중 치트를 사용한 기록이 있어 업적을 달성할 수 없습니다.</span>
	<<elseif $debug>>
		<span class="red">디버그 모드 중에는 업적을 달성할 수 없습니다.</span>
	<<elseif $replayScene isnot undefined>>
		<span class="red">리플레이 모드 중에는 업적을 달성할 수 없습니다.</span>
	<<elseif $feats.soft or $feats.pregnancyLocked or $feats.pregnancySillyLocked>>
		<span class="red">현재 게임에서는 몇몇 업적들의 해금이 제한됩니다.</span>
	<<else>>
		<span class="green">업적을 달성할 수 있습니다.</span>
	<</if>>
	<br><br>
	<<set _keysSetup to Object.keys(setup.feats)>>
	<<set _keysSave to Object.keys($feats.currentSave)>>
	<<set _keysAll to Object.keys($feats.allSaves).filter(f => !["points", "specialClothes", "seeds"].includes(f))>>
	현재 <<if $feats.allSaves.points isnot undefined>><span class="gold"><<print $feats.allSaves.points>></span><<else>><span class="red">0</span><</if>>개의 <<pluralise $feats.allSaves.points "브렐 코인" "브렐 코인">>【을를】 소지하고 있습니다.
	달성한 업적:
	<<if _keysSave.length gte 1>>현재 세이브 파일에서 총 <span class="gold"><<print _keysSave.length>></span>개의 <<pluralise _keysSave.length "업적" "업적">>【을를】 달성했으며, <</if>>
	전체 <span class="gold"><<print _keysSetup.length>></span>개 중 총 <<if _keysAll.length gte 1>><span class="gold"><<print _keysAll.length>></span><<else>><span class="red">0</span><</if>>개의 <<pluralise _keysAll.length "업적" "업적">>【을를】 해금했습니다.
	<br><br>
	<<set $feats.filter to "General">>
	필터 적용:
	<select id="featTypes" name="featTypes" onchange="V.feats.filter = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="General" selected>일반</option>
		<option value="Stats">스탯</option>
		<option value="Social">사교</option>
		<option value="Transformation">신체 변화</option>
		<option value="Discoveries-Town">발견 - 시내</option>
		<option value="Discoveries-Other">발견 - 시외</option>
		<option value="Special">특수</option>
		<option value="Pregnancy">임신</option>
		<option value="AMC Traits">애니 주인공 특성</option>
		<option value="Combat Extended">확장 전투</option>
		<option value="All">모두 보기</option>
		<option value="General" hidden="hidden" selected="selected">일반</option>
	</select>
	<br>
	<<set $feats.sort to "None">>
	정렬 기준:
	<select id="featSort" name="featSort" onchange="V.feats.sort = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="None" selected>없음</option>
		<option value="Date">날짜순</option>
		<option value="None" hidden="hidden" selected="selected">없음</option>
	</select>
	<br>
	<<set $feats.shownew to true>>
	<label><input type="checkbox" checked name="showNew" onchange="V.feats.shownew = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 신규 표시</label> |
	<<set $feats.showold to true>>
	<label><input type="checkbox" checked name="showOld" onchange="V.feats.showold = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 기존 표시</label> |
	<<set $feats.showmissing to true>>
	<label><input type="checkbox" checked name="showMissing" onchange="V.feats.showmissing = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 미달성 표시</label>
	<br><br>
	<div id="featsList">
		<<featsList>>
	</div>
<</widget>>

<<widget "featsList">>
	<<set _skip to []>>
	<<set _sorting to []>>
	<<for _i to 0; _i lt _keysSetup.length; _i++>>
		<<set _setup to setup.feats[_keysSetup[_i]]>>
		<<if !_setup.filter.includes($feats.filter)>>
			<<continue>>
		<</if>>
		<<if _keysSave.includes(_keysSetup[_i])>>
			<<if !$feats.shownew>><<continue>><</if>>
			<<set _owned to 2>>
			<<set _date to new Date($feats.currentSave[_keysSetup[_i]])>>
		<<elseif _keysAll.includes(_keysSetup[_i])>>
			<<if !$feats.showold>><<continue>><</if>>
			<<set _owned to 1>>
			<<set _date to new Date($feats.allSaves[_keysSetup[_i]])>>
		<<else>>
			<<if !$feats.showmissing>><<continue>><</if>>
			<<if _setup.hidden or _skip.includes(_setup.series)>>
				<<continue>>
			<</if>>
			<<if _setup.series isnot "">>
				<<set _skip.push(_setup.series)>>
			<</if>>
			<<set _owned to 0>>
			<<set _date to 0>>
		<</if>>
		<<set _sorting.push( { key: _keysSetup[_i], owned: _owned, date: _date } )>>
	<</for>>
	<<if $feats.sort is "Date">>
		<<set _sorting to _sorting.sort(function(a, b) { return b.date - a.date; })>>
	<</if>>
	<<for _i to 0; _i lt _sorting.length; _i++>>
		<<set _feat to _sorting[_i]>>
		<<set _setup to setup.feats[_feat.key]>>
		<div class="feat">
			<div class="featImage">
				<<if _feat.owned gt 0>>
					<<set _featType to ["copper", "silver", "gold", "platinum", "jeweled"][_setup.difficulty - 1]>>
					<img @src="'img/ui/coin-'+_featType+(_feat.owned is 1 ? '-dull':'')+'.png'" class="featCoin" @style="(_feat.owned is 1 ? 'filter:brightness(65%) contrast(85%);':'')">
				<<else>>
					<img class="dot">
				<</if>>
			</div>
			<div class="featText">
				<<if ($feats.pregnancyLocked and _setup.pregnancyLockable) or ($feats.pregnancySillyLocked and _setup.pregnancySillyLockable) or ($feats.soft and _setup.softLockable) or $feats.locked or ($gamemode is "soft" or $settings.allureModifier lt 1)>>
					<<set _titleColor to " lblue">>
				<<else>>
					<<set _titleColor to "">>
				<</if>>
				<<if _feat.owned gt 0 or _setup.hint is undefined>>
					<span @class="'title' + _titleColor"><<print (Scripting.evalTwineScript(_setup.altTitleCond ?? "false") && _feat.owned is 2) ? _setup.altTitle : _setup.title>></span>
					<span class="text"><<print (Scripting.evalTwineScript(_setup.altDescCond ?? "false") && _feat.owned is 2) ? _setup.altDesc : _setup.desc>></span>
				<<else>>
					<span @class="'title' + _titleColor">?????</span>
					<span class="text"><<print _setup.hint>></span>
				<</if>>
				<br>
				<<if _feat.owned is 2>>
					<span class="text">달성 일시: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<<elseif _feat.owned is 1>>
					<span class="text">최초 달성 일시: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<</if>>
			</div>
		</div>
	<</for>>
<</widget>>

/*Feat Points Menu*/
<<widget "featsPointsMenu">>
	<div id="featsStats" class="settingsToggleIndent">
		<<if $feats.allSaves.points is undefined or $feats.allSaves.points is 0>>
			당신은 평생 총 <span class="red">0 브렐 코인</span>을 얻었으며, 업적 부스터를 구매할 수 없습니다.
			<br>
			<span class="black small-description">이 내용이 잘못되었다면, 마지막 세이브를 로드하고 다시 시작해 주십시오.</span>
		<<else>>
			당신은 평생 총 <span class="green"><<print $feats.allSaves.points>> <<pluralise $feats.allSaves.points "브렐 코인" "브렐 코인">></span>【을를】 얻었습니다.
		<</if>>
	</div>
	/*Have to do this due to the `????` names*/
	<<set _listbox to '<<listbox "_upgradeNameID" autoselect>>'>>
	<<for $_i to 0; $_i lt _upgradeNames.length; $_i++>>
		<<if !$featsBoosts.hidden[_upgradeNames[$_i]]>>
			<<set _listbox += '<<option _visibleUpgradeNames[' + $_i + '] _visibleUpgradeIDs[' + $_i + ']>>'>>
		<</if>>
	<</for>>
	<<set _upgradeName to _upgradeNames[_upgradeNameID or 0]>>
	<<set _listbox += '<</listbox>>'>>
	<span class="gold settingsToggleIndent">업적 부스트:</span>
	<<print _listbox>>
	<<run $(() => {
		$('#featsPointsMenu > select.macro-listbox').off('change.featBoostJump').on('change.featBoostJump', () => {
			new Wikifier(null, '<<set _upgradeName to _upgradeNames[_upgradeNameID]>><<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>');
		});
	})>>

	<div class="settingsGridFeats">
		<div class="settingsHeader">
			<span id="featName"><<featName>></span>
			<br>
			<span style="font-size:80%;">
				<<link "이전">>
					<<set _upgradeNameID-->>
					<<if _upgradeNameID lt 0>>
						<<set _upgradeNameID to _upgradeNames.length - 1>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID-->>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>> |
				<<link "다음">>
					<<set _upgradeNameID++>>
					<<if _upgradeNameID gte _upgradeNames.length>>
						<<set _upgradeNameID to 0>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID++>>
							<<if (_upgradeNameID + 1) gte _upgradeNames.length>>
								<<set _upgradeNameID to 0>>
								<<break>>
							<</if>>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>>
			</span>
		</div>
		/*<<set _upgradeName to _upgradeNames[_upgradeNameID]>>*/
		<div @id="'feats-' + _upgradeName" class="settingsToggleItem">
			<<if _upgradeName is "sexRapeTraits">>
				<<sexRapeTraitsFeatUI>>
			<<elseif _upgradeName is "sexSkills">>
				<<sexSkillsFeatUI>>
			<<elseif _upgradeName is "basicSkills">>
				<<basicSkillsFeatUI>>
			<<elseif _upgradeName is "advancedTraits">>
				<<advancedTraitsFeatUI>>
			<<elseif _upgradeName is "transformations">>
				<<transformationsFeatUI>>
			<<elseif _upgradeName is "sadoMaso">>
				<<sadoMasoFeatUI>>
			<<elseif _upgradeName is "coreCharacteristics">>
				<<coreCharacteristicsFeatUI>>
			<<else>>
				<<featsMenu _upgradeName>>
			<</if>>
			<<if $featsBoosts.pointsUsed isnot 0>>
				<hr>
				구매한 업적 부스트:
				<ul>
					<<for $_i to 0; $_i lt _allUpgradeNames.length; $_i++>>
						<<if $featsBoosts.upgrades[_allUpgradeNames[$_i]] gt 0>>
							<li>
							<<switch _allUpgradeNames[$_i]>>
								<<case "randomClothing">>
									<<= (({"Either": "남녀 공용", "Male": "남성용", "Female": "여성용"})[$featsBoosts.clothingGender] || $featsBoosts.clothingGender)>> <<print $featsBoosts.name[_allUpgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "코인" "코인">>
								<<case "specialClothing">>
									특수 의류: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "코인" "코인">>
									<br>
										<<foldout false "_unlockedSets">>
											<span class="gold">해금된 세트</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.specialClothesSets)
												.filter(k => $featsBoosts.specialClothesSets[k])
												.map(k => `${setup.specialClothesSets[k].text}: <span class="gold">${setup.specialClothesSets[k].featCost * ($featsBoosts.upgradeDetails.specialClothing.purchased >= 3 ? 2 : 1)}</span> 코인`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<case "xchangePremiumPills">>
									X-체인지 프리미엄 알약: <span class="gold"><<print $featsBoosts.upgradeDetails[_allUpgradeNames[$_i]].purchased>></span> <<pluralise $featsBoosts.upgradeDetails[_allUpgradeNames[$_i]].purchased "팩" "팩">>
								<<case "seeds">>
									시작 씨앗: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "코인" "코인">>
									<br>
										<<foldout false "_unlockedSeed">>
											<span class="gold">해금된 씨앗</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.seeds)
												.filter(k => $featsBoosts.seeds[k])
												.map(k => `${setup.foodstuff[k].name}: <span class="gold">${setup.foodstuff[k].tending.featCost}</span> 코인`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<default>>
									<<= $featsBoosts.name[_allUpgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "코인" "코인">>
							<</switch>>
							</li>
						<</if>>
					<</for>>
				</ul>
				<<set _pointsRemaining to $feats.allSaves.points - $featsBoosts.pointsUsed>>
				당신에게는 업적 부스트에 사용할 수 있는 <span class="green"><<print _pointsRemaining>> <<pluralise _pointsRemaining "브렐 코인" "브렐 코인">></span>【이가】 남아 있습니다.
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "updateFeatName">>
	<<replace #featName>>
		<<featName>>
	<</replace>>
<</widget>>

<<widget "featName">>
	<<if _upgradeName is "sexRapeTraits">>
		<span class="gold">섹스·강간 특성</span>
	<<elseif _upgradeName is "sexSkills">>
		<span class="gold">섹스 스킬 등급</span>
	<<elseif _upgradeName is "basicSkills">>
		<span class="gold">기본 스킬 등급</span>
	<<elseif _upgradeName is "advancedTraits">>
		<span class="gold">특수 고급 특성</span>
	<<elseif _upgradeName is "transformations">>
		<span class="gold">변신</span>
	<<elseif _upgradeName is "sadoMaso">>
		<span class="gold">가학·피학</span>
	<<elseif _upgradeName is "coreCharacteristics">>
		<span class="gold">핵심 능력치 등급</span>
	<<else>>
		<<set _details to $featsBoosts.upgradeDetails[_upgradeName]>>
		<<if _details.max gte 1>>
		<<switch _upgradeName>>
			<<case "money">>
				<span class="gold">시작 소지금</span>
			<<case "grades">>
				<span class="gold">학교 성적 등급</span>
			<<case "purity">>
				<span class="gold">일일 순결함 상승치 증가</span>
			<<case "newLife">>
				<span class="gold">새로운 삶</span>
			<<case "aNewBestFriend">>
				<span class="gold">새로운 친구</span>
			<<case "randomClothing">>
				<span class="gold">무작위 옷 세트</span>
			<<case "tattoos">>
				<span class="gold">시작 문신</span>
			<<case "specialClothing">>
				<span class="gold">특수 의상</span>
			<<case "hopelessEndings">>
				<span class="gold">절망의 굴레 엔딩</span>
			<<case "xchangeGrayAgentTrait">>
				<span class="gold">X-체인지 그레이 에이전트</span>
			<<case "xchangePremiumPills">>
				<span class="gold">X-체인지 프리미엄 알약</span>
			<<case "seeds">>
				<span class="gold">시작 씨앗</span>
			<<case "sexToys">>
				<span class="gold">섹스 토이</span>
			<<case "orgasmTrait" "chokeTrait" "ejacTrait" "molestTrait" "rapeTrait" "bestialityTrait" "tentacleTrait" "critterMagnetTrait" "milkDrankTrait">>
				<span class="gold"><<print $featsBoosts.name[_upgradeName]>></span>
			<<case "divineTFs">>
				<span class="gold">신성한 변신</span>
			<<case "animalTFs">>
				<span class="gold">동물 변신</span>
			<<case "sadism" "masochism">>
			<span class="gold">일일 순결함 상승치 증가</span>
			<<case "adaptiveGenes">>
				<span class="gold">적응형 유전자</span>
			<<default>>
				<span class="gold" style="text-transform: capitalize;">시작 _upgradeName 등급</span>
		<</switch>>
		<<else>>
			<span class="red">?????</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "sexSkillsFeatUI">>
	섹스 스킬의 시작 등급을 구매합니다. 각 스킬은 고유한 해금 레벨, 최대 등급, 브렐 코인 비용을 가집니다.
	<div class="groupedFeatGrid">
		<<for _sexSkillName range _sexSkillUpgradeNames>>
			<div class="groupedFeatCard" @data-sex-skill="_sexSkillName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_sexSkillName].max>>
						<span class="gold"><<print _sexSkillName is "seduction" ? "Seduction" : $featsBoosts.name[_sexSkillName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _sexSkillName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "basicSkillsFeatUI">>
	기본 스킬의 시작 등급을 구매합니다. 각 스킬은 고유한 해금 레벨, 최대 등급, 브렐 코인 비용을 가집니다.
	<div class="groupedFeatGrid">
		<<for _basicSkillName range _basicSkillUpgradeNames>>
			<div class="groupedFeatCard" @data-basic-skill="_basicSkillName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_basicSkillName].max>>
						<span class="gold"><<print $featsBoosts.name[_basicSkillName].replace(" Grade", "")>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _basicSkillName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "advancedTraitsFeatUI">>
	특수 고급 특성과 강화를 원하는 대로 조합해 구매합니다. 각각 고유한 해금 레벨, 최대 단계, 브렐 코인 비용을 가집니다.
	<div class="groupedFeatGrid">
		<<for _advancedTraitName range _advancedTraitUpgradeNames>>
			<div class="groupedFeatCard" @data-advanced-trait="_advancedTraitName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_advancedTraitName].max>>
						<span class="gold"><<print $featsBoosts.name[_advancedTraitName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _advancedTraitName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "transformationsFeatUI">>
	신성한 변신, 동물 변신, 또는 둘 다를 구매합니다. 각 분류는 고유한 해금 조건과 브렐 코인 비용을 가집니다.
	<div class="groupedFeatGrid">
		<<for _transformationName range ["divineTFs", "animalTFs"]>>
			<div class="groupedFeatCard" @data-transformation="_transformationName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_transformationName].max>>
						<span class="gold"><<print $featsBoosts.name[_transformationName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _transformationName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "sadoMasoFeatUI">>
	하루마다 얻는 가학 성향 또는 피학 성향 상승을 구매하며, 원한다면 관련 특성을 하나 또는 둘 다 가진 채 시작할 수도 있습니다.
	<div class="groupedFeatGrid">
		<<for _sadoMasoBoostName range ["sadism", "masochism"]>>
			<div class="groupedFeatCard" @data-sado-maso-boost="_sadoMasoBoostName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_sadoMasoBoostName].max>>
						<span class="gold"><<print $featsBoosts.name[_sadoMasoBoostName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _sadoMasoBoostName>>
				</div>
			</div>
		<</for>>
		<<for _sadoMasoTraitName range ["sadistTrait", "masochistTrait"]>>
			<<set _sadoMasoTraitDetails to $featsBoosts.upgradeDetails[_sadoMasoTraitName]>>
			<<set _sadoMasoTraitPurchased to _sadoMasoTraitDetails.purchased gt 0>>
			<<set _canPurchaseSadoMasoTrait to _sadoMasoTraitPurchased or ($feats.allSaves.points - $featsBoosts.pointsUsed gte _sadoMasoTraitDetails.cost)>>
			<div class="groupedFeatCard" @data-sado-maso-trait="_sadoMasoTraitName">
				<div class="groupedFeatTitle">
					<<if _sadoMasoTraitDetails.max>>
						<span class="gold"><<print $featsBoosts.name[_sadoMasoTraitName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<if _sadoMasoTraitDetails.max>>
						<<if _sadoMasoTraitName is "sadistTrait">>
							당신의 반항적인 행동이 더 큰 고통을 줍니다. 고통을 주면 흥분이 오릅니다.
						<<else>>
							대부분의 고통에 대한 저항력을 얻습니다. 그런 고통은 대신 흥분을 높입니다.
						<</if>>
						<br>
						<label>
							<<if _sadoMasoTraitPurchased>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" checked onchange="const trait = this.dataset.sadoMasoTraitChoice; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 0; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + ' &quot;subtract&quot;>' + '>');">
							<<elseif _canPurchaseSadoMasoTrait>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" onchange="const trait = this.dataset.sadoMasoTraitChoice; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 1; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + '>' + '>');">
							<<else>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" disabled>
							<</if>>
							이 특성으로 시작
						</label>
						<div class="black small-description" style="margin-top:10px;">(<span class="gold"><<print _sadoMasoTraitDetails.cost>> <<pluralise _sadoMasoTraitDetails.cost "브렐 코인" "브렐 코인">></span> 필요)</div>
					<<else>>
						<span class="red"><<print $featsBoosts.missing[_sadoMasoTraitName]>></span>
					<</if>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "coreCharacteristicsFeatUI">>
	핵심 능력치의 시작 등급이나 일일 변화를 구매합니다. 각각 고유한 해금 레벨, 최대 단계, 브렐 코인 비용을 가집니다.
	<div class="groupedFeatGrid">
		<<for _characteristicName range _coreCharacteristicUpgradeNames>>
			<div class="groupedFeatCard" @data-core-characteristic="_characteristicName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_characteristicName].max>>
						<span class="gold"><<print $featsBoosts.name[_characteristicName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _characteristicName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "sexRapeTraitsFeatUI">>
	섹스 및 강간과 관련된 시작 특성을 원하는 대로 골라 구매합니다. 선택한 특성은 각각 정해진 브렐 코인을 소모합니다.
	<div style="margin-top:10px;">
		<<for _traitName range _traitUpgradeNames>>
			<<set _traitDetails to $featsBoosts.upgradeDetails[_traitName]>>
			<<set _traitPurchased to $featsBoosts.upgrades[_traitName] gt 0>>
			<<set _canPurchaseTrait to _traitPurchased or ($feats.allSaves.points - $featsBoosts.pointsUsed gte _traitDetails.cost)>>
			<<set _traitDescription to {
				orgasmTrait: "수많은 절정을 경험한 것이 생리학적 영향을 남겼습니다. 절정에 오르는 것은 더 힘들어지지만, 절정은 더 많은 스트레스를 해소합니다. 절정을 거듭할수록 해소되는 양이 줄어들고 결국 스트레스가 쌓이기도 하지만, 평소보다 훨씬 적습니다.",
				chokeTrait: "산소가 부족할 때의 감각을 사랑하게 되었습니다. 목이 졸리면 섹스에서 더 큰 쾌락을 느낍니다.",
				ejacTrait: "정액의 냄새에 익숙해졌고 이를 안정 효과로 삼을 수 있게 되었습니다. 얼마나 많은 슬라임과 정액이 당신을 덮고 있는지에 따라 매시간 스트레스가 감소합니다.",
				molestTrait: "심리적 트라우마를 잘 견뎌내는 방법을 배웠습니다. 이제 희롱당하더라도 통제력을 상실하지 않습니다 (강간은 여전히 통제력을 상실시킵니다).",
				rapeTrait: "너무 많이 강간당한 나머지 대처하는 법을 배웠습니다. 트라우마 증가량이 더 느려집니다.",
				bestialityTrait: "동물들이 계속해서 당신과 " + ($settings.pregnancySpeechEnabled ? "번식" : "교미") + "하려고 하다 보니 이젠 이골이 났습니다. 동물에게 공격당할 때 트라우마가 더 천천히 증가합니다.",
				tentacleTrait: "수많은 촉수들이 당신의 몸을 농락했습니다. 촉수에게 공격당할 때 트라우마가 더 천천히 증가합니다.",
				critterMagnetTrait: "무리 지어 다니는 작은 생물들에게 저항할 수 없습니다. 당신은 옷을 벗고 그들에게 굴복하며, 작은 생물과의 섹스는 스트레스와 트라우마를 풀어 줍니다.",
				milkDrankTrait: "신선한 모유의 영양을 온전히 이용할 수 있습니다. 마시면 몸에 활력이 돌고 체력이 상승합니다.",
			}[_traitName]>>
			<div class="settingsToggleItem">
				<label>
					<<if _traitPurchased>>
						<input type="checkbox" @data-trait="_traitName" checked onchange="const trait = this.dataset.trait; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 0; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + ' &quot;subtract&quot;>' + '>');">
					<<elseif _traitDetails.max and _canPurchaseTrait>>
						<input type="checkbox" @data-trait="_traitName" onchange="const trait = this.dataset.trait; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 1; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + '>' + '>');">
					<<else>>
						<input type="checkbox" @data-trait="_traitName" disabled>
					<</if>>
					<<if _traitDetails.max>>
						<span class="lewd"><<print $featsBoosts.name[_traitName]>></span>
						<span class="black small-description">(<span class="gold"><<print _traitDetails.cost>> <<pluralise _traitDetails.cost "VrelCoin">></span>)</span>
					<<else>>
						<span class="red">?????</span>
						<span class="black small-description"><<print $featsBoosts.missing[_traitName]>></span>
					<</if>>
				</label>
				<<if _traitDetails.max>>
					<span class="tooltip-anchor linkBlue" tabindex="0" @tooltip="_traitDescription" @data-trait-tooltip="_traitName">(?)</span>
				<</if>>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "featsMenu">>
	<<set _name to _args[0]>>
	<<set _nameKr to ({physique: "체격", willpower: "의지력", oral: "입", chest: "가슴", hands: "손", buttocks: "엉덩이", penile: "자지", anal: "애널", vaginal: "보지", feet: "발", thighs: "허벅지", promiscuity: "음란", exhibitionism: "노출증", deviancy: "이상성욕", skulduggery: "속임수", dancing: "춤", swimming: "수영", athletics: "체육", tending: "관리", housekeeping: "가사", seduction: "유혹"})[_name] || _name>>
	<<capture _name _nameKr>>
		<<set _details to $featsBoosts.upgradeDetails[_name]>>
		<<set _maxUpgrades to _details.max>>
		<<set _purchasedUpgrades to _details.purchased>>
		<<if _maxUpgrades>>
			<<if !$feats.allSaves.points>>
				<span class="red">이 업적 부스트를 구매하려면 브렐 코인을 획득하십시오!</span>
			<<else>>
				<<switch _name>>
					<<case "money">>
						당신은 <span class="green"> £<<= 5 + _purchasedUpgrades * _maxUpgrades * 25>>.00</span>의 자금으로 게임을 시작합니다.
					<<case "grades">>
						당신은
						<<switch _details.purchased>>
							<<case 4>><span class="green">A*</span>
							<<case 3>><span class="green">A</span>
							<<case 2>><span class="lblue">B</span>
							<<case 1>><span class="blue">C</span>
							<<default>><span class="purple">D</span>
						<</switch>>
						학점으로 게임을 시작합니다.
					<<case "purity">>
						<<if !_purchasedUpgrades>>
							당신은 항상 매일 <span class="green">1</span>점의 순결도를 얻습니다. 구매한 부스트 하나마다 매일 순결도 1점이 더 늘어납니다. 다른 효과 때문에 순결도가 줄어드는 날에도 합산되므로 하루를 순이득으로 마칠 수 있습니다. <i>당신의 행동에 따라 순결도 획득이 상쇄되거나 증폭될 수 있습니다.</i>
						<<else>>
							이 효과와 일일 기본 점수를 합쳐 매일 <span class="green"><<print 1 + _purchasedUpgrades>></span>점의 순결도를 얻습니다. 다른 효과는 그 위에 더해지며, 순결도를 잃게 하는 효과가 있어도 합계는 여전히 이득일 수 있습니다. <i>당신의 행동에 따라 순결도 획득이 상쇄되거나 증폭될 수 있습니다.</i>
						<</if>>
					<<case "impurity">>
						<<switch _purchasedUpgrades>>
							<<case 0>>
								당신은 항상 매일 <span class="green">1</span>점의 순결도를 얻습니다. 구매한 부스트 하나마다 매일 순결도 1점이 깎입니다. 일일 기본 점수를 모두 소모한 뒤에도 계속 순결도를 깎습니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
							<<case 1>>
								일일 순결도 변화는 <span class="red">0</span>입니다. 부스트가 일일 기본 점수를 모두 소모합니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
							<<default>>
								이 효과와 일일 기본 점수를 합쳐 매일 <span class="red"><<= _purchasedUpgrades - 1>></span>점의 순결도를 잃습니다. 다른 효과는 그 위에 더해집니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
						<</switch>>
					<<case "newLife">>
						당신은
						<span @class="$featsBoosts.upgrades.newLife ? 'green' : 'red'">
							<<= $featsBoosts.upgrades.newLife ? "기생충과 함께" : "기생충 없이">>
						</span>
						게임을 시작합니다.
					<<case "aNewBestFriend">>
						당신은
						<<switch $featsBoosts.upgrades.aNewBestFriend>>
							<<case 0>><<if earSlimeThoughts()>>머릿속 목소리<<else>>귀 슬라임<</if>> <span class='red'>없이</span> 게임을 시작합니다.
							<<case 10>><<if earSlimeThoughts()>>머릿속 목소리<<else>>귀 슬라임<</if>> <span class='green'>하나와 함께</span> 게임을 시작합니다.
							<<case 20>><<if earSlimeThoughts()>>머릿속 목소리<<else>>귀 슬라임<</if>> <span class='green'>두 개와 함께</span> 게임을 시작합니다.
						<</switch>>
					<<case "randomClothing">>
						무작위 의류 아이템 <span class="gold"><<= 3 * _purchasedUpgrades>></span>개를 가지고 게임을 시작합니다.
					<<case "tattoos">>
						<<if _purchasedUpgrades is 0>>
							문신이 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
							문신 <span class="green">1</span>개를 가지고 게임을 시작합니다.
						<<else>>
							문신 <span class="green">_purchasedUpgrades</span>개를 가지고 게임을 시작합니다.
						<</if>>
					<<case "specialClothing">>
						<<if _purchasedUpgrades is 0>>
							숲속 상점의 특수 의류가 <span class='red'>잠긴</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
							다른 세이브 파일에서 숲속 상점의 특수 의류 세트를 해금한 적이 있다면, <span class="teal">최대 절반</span>까지 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<<elseif _purchasedUpgrades is 2>>
							다른 세이브 파일에서 숲속 상점의 특수 의류 세트를 해금한 적이 있다면, <span class="teal">원하는 만큼</span> 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<<else>>
							이전에 해금한 특수 의류 세트를 <span class="teal">원하는 만큼</span> <span class="gold">정가의 두 배 브렐 코인</span>으로 구매해 <span class="green">일반 스토리 대사가 열린</span> 상태로 게임을 시작할 수 있습니다.
						<</if>>
					<<case "hopelessEndings">>
						<span class="gold">절망의 굴레</span> 엔딩을 구매하면 다음 게임에서 그림에서 <span class="green">바로 읽을</span> 수 있어, 전체 과정을 다시 플레이하지 않고도 보상을 받습니다. 전부, 일부, 또는 하나도 사지 않아도 됩니다. <i>엔딩이 어려울수록 비용이 더 듭니다.</i>
					<<case "xchangePremiumPills">>
						<<set _premiumPillTotal to _purchasedUpgrades * 5>>
						당신은
						<<if _premiumPillTotal>>
							약 서랍에 X-체인지 프리미엄 <<pluralise _premiumPillTotal "알약" "알약">>을 <span class="green"><<print _premiumPillTotal>></span>개 넣은 채 게임을 시작합니다.
						<<else>>
							X-체인지 프리미엄 알약이 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</if>>
					<<case "seeds">>
						<<if _purchasedUpgrades is 0>>
							씨앗이 <span class='red'>하나도 없는</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
