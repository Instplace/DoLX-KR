		<<set _bodyWritingOptions["Love Interests"]["Manifestation"] to "manifestation">>

		<<if ["dead","sold"].includes($wraith.offspring)>>
			<<set _bodyWritingOptions["Love Interests"]["Oathbreaker"] to "oathbreaker">>
		<<elseif $wraith.state isnot "haunt">>
			<<set _bodyWritingOptions["Love Interests"]["Memory"] to "memory">>
			<<set _bodyWritingOptions["Love Interests"]["Promise"] to "promise">>
			<<set _bodyWritingOptions["Love Interests"]["Pearl"] to "pearl">>
			<<set _bodyWritingOptions["Love Interests"]["Droplet"] to "droplet">>
		<</if>>

		<<if $wraith.state is "haunt">>
			<<set _bodyWritingOptions["Love Interests"]["Graverobber"] to "graverobber">>
			<<set _bodyWritingOptions["Love Interests"]["Vulture"] to "vulture">>
			<<set _bodyWritingOptions["Love Interests"]["Forsaker"] to "forsaker">>
		<<elseif $wraith.state is "despair">>
			<<set _bodyWritingOptions["Love Interests"]["Accomplice"] to "accomplice">>
		<</if>>
	<</if>>
	<<if isPossibleLoveInterest("Robin")>>
		<<set _bodyWritingOptions["Love Interests"]["로빈의 보호자"] to "robins_protector">>
		<<set _bodyWritingOptions["Love Interests"]["로빈과 나"] to "robin_and_i">>
		<<set _bodyWritingOptions["Love Interests"]["고아의 연인"] to "the_orphan_lover">>
		<<if ($player.penisExist or $player.gender_appearance is "m" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["로빈의 남자친구"] to "robins_boyfriend">>
		<</if>>
		<<if ($player.vaginaExist or $player.gender_appearance is "f" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["로빈의 여자친구"] to "robins_girlfriend">>
		<</if>>
	<</if>>
	<<if isPossibleLoveInterest("Whitney")>>
		<<set _bodyWritingOptions["Love Interests"]["휘트니의 애완동물"] to "whitneys_pet">>
		<<set _bodyWritingOptions["Love Interests"]["휘트니의 소유물"] to "property_of_whitney">>
		<<set _bodyWritingOptions["Love Interests"]["휘트니의 장난감"] to "whitneys_toy">>
		<<if ($player.penisExist or $player.gender_appearance is "m" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["휘트니의 남창"] to "whitneys_boyslut">>
		<</if>>
		<<if ($player.vaginaExist or $player.gender_appearance is "f" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["휘트니의 걸레"] to "whitneys_slut">>
		<</if>>
	<</if>>
	<<if isPossibleLoveInterest("Kylar")>>
		<<set _bodyWritingOptions["Love Interests"]["카일라의 집착"] to "kylars_obsession">>
		<<set _bodyWritingOptions["Love Interests"]["카일라를 영원히 사랑해"] to "love_kylar_forever">>
		<<set _bodyWritingOptions["Love Interests"]["카일라 전용"] to "reserved_for_kylar">>
		<<set _bodyWritingOptions["Love Interests"]["오직 카일라"] to "just_kylar">>
	<</if>>
	<<if isPossibleLoveInterest("Eden")>>
		<<set _bodyWritingOptions["Love Interests"]["에덴의 동반자"] to "edens_companion">>
		<<set _bodyWritingOptions["Love Interests"]["사냥꾼과 사냥감"] to "hunter_and_prey">>
		<<set _bodyWritingOptions["Love Interests"]["숲속은 외로워"] to "its_lonely_in_the_woods">>
		<<set _bodyWritingOptions["Love Interests"]["무언가 널 사냥하고 있다"] to "something_is_hunting_you">>
	<</if>>
	<<if isPossibleLoveInterest("Avery")>>
		<<set _bodyWritingOptions["Love Interests"]["에이버리의 트로피"] to "averys_trophy">>
		<<set _bodyWritingOptions["Love Interests"]["사랑스러움"] to "endearing">>
		<<if ($player.penisExist or $player.gender_appearance is "m" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["상류층 소년"] to "uptown_boy">>
		<</if>>
		<<if ($player.vaginaExist or $player.gender_appearance is "f" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["상류층 소녀"] to "uptown_girl">>
		<</if>>
		<<set _bodyWritingOptions["Love Interests"]["에이버리의 독점"] to "averys_monopoly">>
	<</if>>
	<<if isPossibleLoveInterest("Alex")>>
		<<set _bodyWritingOptions["Love Interests"]["알렉스의 파트너"] to "alexs_partner">>
		<<set _bodyWritingOptions["Love Interests"]["해 뜰 때부터 해 질 때까지"] to "sunrise_to_sunset">>
		<<set _bodyWritingOptions["Love Interests"]["건초 압축기"] to "hay_baler">>
		<<if ($player.penisExist or $player.gender_appearance is "m" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["카우보이"] to "cowboy">>
		<</if>>
		<<if ($player.vaginaExist or $player.gender_appearance is "f" or $backgroundTraits.includes("crossdresser"))>>
			<<set _bodyWritingOptions["Love Interests"]["카우걸"] to "cowgirl">>
		<</if>>
	<</if>>
	<<if isPossibleLoveInterest("Sydney")>>
		<<set _bodyWritingOptions["Love Interests"]["시드니의 구원자"] to "sydneys_savior">>
		<<set _bodyWritingOptions["Love Interests"]["시드니에게 묶임"] to "bound_to_sydney">>
		<<set _bodyWritingOptions["Love Interests"]["시드니가 날 웃게 해"] to "sydney_makes_me_smile">>
		<<if C.npc.Sydney.purity gt 1>>
			<<set _bodyWritingOptions["Love Interests"]["가장 순수한 사랑"] to "purest_love">>
		<<else>>
			<<set _bodyWritingOptions["Love Interests"]["음욕의 죄인들"] to "lusty_sinners">>
		<</if>>
	<</if>>
	<<if isPossibleLoveInterest("Black Wolf")>>
		<<set _bodyWritingOptions["Love Interests"]["검은 늑대의 암캐"] to "black_wolfs_bitch">>
		<<set _bodyWritingOptions["Love Interests"]["내 알파를 위해 전부"] to "all_for_my_alpha">>
		<<if $wolfpackleader is 1>>
			<<set _bodyWritingOptions["Love Interests"]["무리의 지도자"] to "leader_of_the_pack">>
		<</if>>
		<<set _bodyWritingOptions["Love Interests"]["늑대와 함께 달림"] to "runs_with_wolves">>
	<</if>>
	<<if isPossibleLoveInterest("Great Hawk")>>
		<<set _bodyWritingOptions["Love Interests"]["거대 매의 배우자"] to "great_hawks_spouse">>
		<<set _bodyWritingOptions["Love Interests"]["사랑으로 비상함"] to "soaring_with_love">>
		<<set _bodyWritingOptions["Love Interests"]["공포의 짝"] to "terrors_mate">>
		<<set _bodyWritingOptions["Love Interests"]["자유로운 새"] to "free_bird">>
	<</if>>
	<<if isPossibleLoveInterest("Gwylan")>>
		<<set _bodyWritingOptions["Love Interests"]["마녀의 피보호자"] to "witchs_ward">>
		<<set _bodyWritingOptions["Love Interests"]["마녀의 사역마"] to "witchs_familiar">>
		<<set _bodyWritingOptions["Love Interests"]["그윌란의 보물"] to "gwylans_treasure">>
		<<set _bodyWritingOptions["Love Interests"]["그윌란의 제자"] to "gwylans_apprentice">>
		<<set _bodyWritingOptions["Love Interests"]["영원한 갈망"] to "forever_yearning">>
	<</if>>
	<<if $syndromeBailey>>
		<<set _bodyWritingOptions["Love Interests"]["Bailey's Asset"] to "baileys_asset">>
		<<set _bodyWritingOptions["Love Interests"]["Bailey's Ward"] to "baileys_ward">>
		<<set _bodyWritingOptions["Love Interests"]["Property of Bailey"] to "property_of_bailey">>
		<<set _bodyWritingOptions["Love Interests"]["Bailey's Investment"] to "baileys_investment">>
		<<set _bodyWritingOptions["Love Interests"]["Debt Collector's Pet"] to "debt_collectors_pet">>
		<<if C.npc.Bailey.love gte 20>>
			<<set _bodyWritingOptions["Love Interests"]["Paid In Full"] to "paid_in_full">>
		<</if>>
		<<if C.npc.Bailey.love gte 30>>
			<<set _bodyWritingOptions["Love Interests"]["Bailey's Favourite"] to "baileys_favourite">>
		<</if>>
		<<if $baileyTitle isnot "Bailey">>
			<<set setup.bodywriting.baileys_good_boy.writing to $baileyTitle + "'s Good Boy">>
			<<set setup.bodywriting.baileys_good_girl.writing to $baileyTitle + "'s Good Girl">>
			<<if ($player.penisExist or $player.gender_appearance is "m" or $backgroundTraits.includes("crossdresser"))>>
				<<set _bodyWritingOptions["Love Interests"][$baileyTitle + "'s Good Boy"] to "baileys_good_boy">>
			<</if>>
			<<if ($player.vaginaExist or $player.gender_appearance is "f" or $backgroundTraits.includes("crossdresser"))>>
				<<set _bodyWritingOptions["Love Interests"][$baileyTitle + "'s Good Girl"] to "baileys_good_girl">>
			<</if>>
		<</if>>
	<</if>>
	<<if $baileydefeatedlewd gte 1>>
		<<set _bodyWritingOptions["Love Interests"]["Bailey's Trouble Maker"] to "baileys_trouble_maker">>
	<</if>>
	<<if ($speech_attitude is "bratty" or $speech_attitude is "cruel") and $syndromeBailey>>
		<<set _bodyWritingOptions["Love Interests"]["Bailey's Brat"] to "baileys_brat">>
	<</if>>
	<<if $debug>>
		<<set _bodyWritingOptions["Debug"] to setup.bodywriting>>
		<<set _debugBodywritingOptionsKeys to Object.keys(setup.bodywriting)>>
		<<link [[몸을 씻는다|$passage]]>>
			<<set $mirrorMenu to "skin">>
			<<wash>>
		<</link>>
		<<link [[손을 묶는다|$passage]]>>
			<<set $mirrorMenu to "skin">>
			<<bind>>
		<</link>><span class="black"> (손에 든 아이템이 파괴됩니다.)</span>
		<br/>
		<<print Object.values(setup.bodywriting).length>>개의 알려진 낙서 옵션.
	<</if>>
<</widget>>

<<widget "bodywritingMenuLinks">>
	<span class="gold bold">신체 낙서 추가:</span>
	<br>
	<div id="bodywritingMenuLinks">
		<<set _keys to Object.keys(_bodyWritingOptions)>>
		<<if !_keys.includes($bodywritingSet)>>
			<<set $bodywritingSet to "General">>
		<</if>>
		<<for _i to 0; _i lt _keys.length; _i++>>
			<<capture _i _keys _keyLabelsKr>>
				<div @id="'link-'+_keys[_i].replace(/ /g,'-')" @class="(_keys[_i] is $bodywritingSet ? 'no-numberify bodywritingSelected' : 'no-numberify bodywriting')">
				<<button `_keyLabelsKr[_keys[_i]] || _keys[_i]`>>
					<<removeclass `'#link-'+$bodywritingSet.replace(/ /g,'-')` "bodywritingSelected">>
					<<addclass `'#link-'+$bodywritingSet.replace(/ /g,'-')` "bodywriting">>
					<<set $bodywritingSet to clone(_keys[_i])>>
					<<addclass `'#link-'+$bodywritingSet.replace(/ /g,'-')` "bodywritingSelected">>
					<<replace "#bodywritingMenu">><<bodywritingMenu _args[0]>><</replace>>
				<</button>>
				</div>
			<</capture>>
		<</for>>
	</div>

	<br>
	<div id="bodywritingMenu" class="skinMenu no-numberify">
		<<bodywritingMenu _args[0]>>
	</div>
	<div class="skinMenu">
		<label data-target="options.images" data-disabledif="V.options.images===0">
			<<checkbox "$options.bodywritingImages" false true autocheck>> 낙서 이미지 활성화
		</label>
	</div>
<</widget>>

<<widget "bodywritingMenu">>
	<<if Object.keys(_bodyWritingOptions[$bodywritingSet]).length gt 0>>
		<<set _bodyPartOptions to {}>>
		<<if _args[0] isnot undefined>>
			<<set _bodyPartOptionsSkip to _args[0]>>
		<<else>>
			<<set _bodyPartOptionsSkip to ["back", "left_bottom", "right_bottom"]>>
		<</if>>
		<<for _label, _value range $skin>>
			<<if _bodyPartOptionsSkip.includes(_label)>>
				<<continue>>
			<<elseif Object.keys(_value).length is 0>>
				<<silently>><<bodypart _label>><</silently>>
				<<set _bodyPartOptions[_text_output.toUpperFirst()] to _label>>
			<</if>>
		<</for>>

		<<set _listBoxOptions to {}>>
		<<for _k, _v range _bodyWritingOptions[$bodywritingSet]>>
			<<if $bodywritingSet is "Debug">>
				<<set _label to (_v.writingKr ? _v.writingKr : _k)>>
				<<set _listBoxOptions[_label] to _v>>
			<<else>>
				<<set _listBoxOptions[_k] to _v>>
			<</if>>
		<</for>>

		<<if $debug>>
			적을 내용:
			<<listbox "_bodyWritingDebugSelected">>
				<<optionsfrom _listBoxOptions>>
			<</listbox>>
			모든 부위에 적용
			<<link [[확인|$passage]]>>
				<<set $mirrorMenu to "skin">>
				<<for _part, _value range $skin>>
					<<add_bodywriting _part _bodyWritingDebugSelected "pen">>
				<</for>>
			<</link>>
			<br />
			그릴 내용:
			<<listbox "_bodyWritingDebugSelected">>
				<<optionsfrom _listBoxOptions>>
			<</listbox>>
			커스텀 스프라이트가 있는 모든 부위에 적용

			<<link [[확인|$passage]]>>
				<<set $mirrorMenu to "skin">>
				<<for _part, _value range $skin>>
					<<if _bodyWritingDebugSelected.sprites and _bodyWritingDebugSelected.sprites.includes(_part)>>
						<<add_bodywriting _part _bodyWritingDebugSelected "pen">>
					<</if>>
				<</for>>
			<</link>>
			<br />
			<br />
		<</if>>

		<<if Object.keys(_bodyPartOptions).length gt 0>>
			적을 내용:
			<<listbox "_bodyWritingSelected">>
				<<optionsfrom _listBoxOptions>>
			<</listbox>>
			부위:
			<<listbox "_bodyPartSelected">>
				<<optionsfrom _bodyPartOptions>>
			<</listbox>>

			<<link [[확인|$passage]]>>
				<<set $mirrorMenu to "skin">>
				<<set $bodyWritingSelected to Object.keys(_bodyWritingOptions[$bodywritingSet])[Object.values(_bodyWritingOptions[$bodywritingSet]).indexOf(_bodyWritingSelected)]>>
				<<set $bodyPartSelected to _bodyPartSelected>>
				<<add_bodywriting _bodyPartSelected _bodyWritingSelected "pen">>
			<</link>>
		<<else>>
			<span class="blue">어디에 또 광고를 적을 수 있을지 모르겠다.</span>
		<</if>>
	<<else>>
		<span class="blue">이 종류의 낙서 옵션은 아직 해금되지 않았습니다.</span>
	<</if>>
<</widget>>

<<widget "hairDescription">>

<<set _hairTypeKr to setup.hairstyles.sides.find(s => s.variable is $hairtype)?.name || $hairtype>>
<<set _fringeTypeKr to setup.hairstyles.fringe.find(s => s.variable is $fringetype)?.name || $fringetype>>

	거울에 비친 머리를 확인한다.
	<<if $hairtype is "default" and $fringetype is "default">>
	당신의 머리는 현재 스타일이 지정되어 있지 않습니다. 옆머리는 당신의 몸 <<if $hairposition is "front">>앞으로<<else>>뒤로<</if>> 넘겨져 있습니다.
	당신의 머리는
	<<if $earsposition is "front">>
			<span class="gold">귀 뒤로 넘겨져 있으며</span>,
	<<else>>
			<span class="gold">귀 앞으로 내려와 있으며</span>,
	<</if>>
	현재 상태는
	<<if $ruffledisable is "t">>
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			흐트러지지 않게 고정되어 있습니다.
			<span class="black">당신의 헤어스타일은 망가지지 않습니다. <br> <i class="red">새로운 헤어스타일을 선택하면 다시 머리가 헝클어질 수 있습니다. <<print ($hairgelBottles is 0 ? "헤어 젤은 상점에서 구할 수 있습니다." : "헤어 젤을 다시 발라야 합니다.")>></i></span>
		</mouse>
	<<else>>
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			고정되어 있지 않습니다.
			<span class="black">특정 상황에서는 당신의 머리가 헝클어질 수 있습니다. <br> <i class="teal">헤어 젤을 바르면 머리가 흐트러지는 것을 방지할 수 있습니다.<<print ($hairgelBottles is 0 ? " 헤어 젤은 상점에서 구할 수 있습니다." : "")>></i> </span>
		</mouse>
	<</if>>
		<div class="no-numberify">
			<<link [[무작위 헤어스타일|$passage]]>>
				<<set _hairType to Object.values(_hairTypeByName)>>
				<<set $hairtype to _hairType[random(0,_hairType.length - 1)]>>
				<<set _fringeType to Object.values(_fringeTypeByName)>>
				<<set $fringetype to _fringeType[random(0,_fringeType.length - 1)]>>
				<<set $hairposition to ["front","back"][random(0,1)]>>
			<</link>>
			|
			<<switch $hairposition>>
				<<case "front">>
					<<link "옆머리를 몸 뒤로 넘긴다">>
						<<run State.setVar("$hairposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "옆머리를 몸 앞으로 넘긴다">>
						<<run State.setVar("$hairposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "옆머리를 몸 앞으로 넘긴다">>
						<<run State.setVar("$hairposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $earsposition>>
				<<case "front">>
					<<link "옆머리를 귀 앞으로 내린다">>
						<<run State.setVar("$earsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "옆머리를 귀 뒤로 넘긴다">>
						<<run State.setVar("$earsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "옆머리를 귀 뒤로 넘긴다">>
						<<run State.setVar("$earsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $tfearsposition>>
				<<case "front">>
					<<link "머리카락을 변이 귀 앞에 둔다">>
						<<run State.setVar("$tfearsposition", "middle")>>
						<<run Engine.show()>>
					<</link>>
				<<case "middle">>
					<<link "뒤쪽 머리카락을 변이 귀 앞에 둔다">>
						<<run State.setVar("$tfearsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "머리카락을 변이 귀 뒤로 넘긴다">>
						<<run State.setVar("$tfearsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "머리카락을 변이 귀 뒤로 넘긴다">>
						<<run State.setVar("$tfearsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $tfearshatposition>>
				<<case "through">>
					<<link "귀를 모자 아래로 집어넣는다">>
						<<run State.setVar("$tfearshatposition", "under")>>
						<<run Engine.show()>>
					<</link>>
				<<case "under">>
					<<link "귀를 모자 밖으로 내민다">>
						<<run State.setVar("$tfearshatposition", "through")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "귀를 모자 아래로 집어넣는다">>
						<<run State.setVar("$tfearshatposition", "under")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $browsposition>>
				<<case "front">>
					<<link "눈썹을 앞머리에 가려지게 한다">>
						<<run State.setVar("$browsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "눈썹을 앞머리 바깥으로 뺀다">>
						<<run State.setVar("$browsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "눈썹을 앞머리에 가려지게 한다">>
						<<run State.setVar("$browsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $earringsposition>>
				<<case "fringe">>
					<<link "귀걸이를 머리카락 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "귀걸이를 머리카락 앞에 둔다">>
						<<run State.setVar("$earringsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<case "front">>
					<<link "귀걸이를 앞머리 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "fringe")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "귀걸이를 앞머리 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "fringe")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			<br><br>
		</div>
	<<else>>
		<<if $hairtype is "default">>
			현재, 앞머리는 <span class="gold">_hairTypeKr</span> 스타일입니다. 옆머리는 <span class="gold">자연스럽게</span> 두었으며 몸 <<if $hairposition is "front">>앞으로<<else>>뒤로<</if>> 넘겨져 있습니다.
		<<elseif $fringetype is "default">>
			현재, 앞머리는 <span class="gold">자연스럽게</span> 두었습니다. 옆머리는 <span class="gold">_hairTypeKr</span> 스타일이며 몸 <<if $hairposition is "front">>앞으로<<else>>뒤로<</if>> 넘겨져 있습니다.
		<<else>>
			현재, 앞머리는 <span class="gold">_fringeTypeKr</span> 스타일입니다. 옆머리는 <span class="gold">_hairTypeKr</span> 스타일이며 몸 <<if $hairposition is "front">>앞으로<<else>>뒤로<</if>> 넘겨져 있습니다.
		<</if>>
			당신의 머리는
			<<if $earsposition is "front">>
				<span class="gold">귀 뒤로 넘겨져 있으며</span>,
			<<else>>
				<span class="gold">귀 앞으로 내려와 있으며</span>,
			<</if>>
			현재 상태는
			<<if $ruffledisable is "t">>
				<mouse class = "gold tooltip-small" style="border-bottom-color:white">
					흐트러지지 않게 고정되어 있습니다.
					<span class="black">당신의 헤어스타일은 망가지지 않습니다. <br> <i class="red">새로운 헤어스타일을 선택하면 다시 머리가 헝클어질 수 있습니다. <<print ($hairgelBottles is 0 ? "헤어 젤은 상점에서 구할 수 있습니다." : "헤어 젤을 다시 발라야 합니다.")>></i></span>
				</mouse>
			<<else>>
				<mouse class = "gold tooltip-small" style="border-bottom-color:white">
					고정되어 있지 않습니다.
					<span class="black">특정 상황에서는 당신의 머리가 헝클어질 수 있습니다. <br> <i class="teal">헤어 젤을 바르면 머리가 흐트러지는 것을 방지할 수 있습니다.<<print ($hairgelBottles is 0 ? " 헤어 젤은 상점에서 구할 수 있습니다." : "")>></i> </span>
				</mouse>
			<</if>>
		<div class="no-numberify">
			<<link [[무작위 헤어스타일|$passage]]>>
				<<set _hairType to Object.values(_hairTypeByName)>>
				<<set $hairtype to _hairType[random(0,_hairType.length - 1)]>>
				<<set _fringeType to Object.values(_fringeTypeByName)>>
				<<set $fringetype to _fringeType[random(0,_fringeType.length - 1)]>>
				<<set $hairposition to ["front","back"][random(0,1)]>>
			<</link>>
			|
			<<switch $hairposition>>
				<<case "front">>
					<<link "옆머리를 몸 뒤로 넘긴다">>
						<<run State.setVar("$hairposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "옆머리를 몸 앞으로 넘긴다">>
						<<run State.setVar("$hairposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "옆머리를 몸 앞으로 넘긴다">>
						<<run State.setVar("$hairposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $earsposition>>
				<<case "front">>
					<<link "옆머리를 귀 앞으로 내린다">>
						<<run State.setVar("$earsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "옆머리를 귀 뒤로 넘긴다">>
						<<run State.setVar("$earsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "옆머리를 귀 뒤로 넘긴다">>
						<<run State.setVar("$earsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $tfearsposition>>
				<<case "front">>
					<<link "머리카락을 변이 귀 앞에 둔다">>
						<<run State.setVar("$tfearsposition", "middle")>>
						<<run Engine.show()>>
					<</link>>
				<<case "middle">>
					<<link "뒤쪽 머리카락을 변이 귀 앞에 둔다">>
						<<run State.setVar("$tfearsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "머리카락을 변이 귀 뒤로 넘긴다">>
						<<run State.setVar("$tfearsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "머리카락을 변이 귀 뒤로 넘긴다">>
						<<run State.setVar("$tfearsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $tfearshatposition>>
				<<case "through">>
					<<link "귀를 모자 아래로 집어넣는다">>
						<<run State.setVar("$tfearshatposition", "under")>>
						<<run Engine.show()>>
					<</link>>
				<<case "under">>
					<<link "귀를 모자 밖으로 내민다">>
						<<run State.setVar("$tfearshatposition", "through")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "귀를 모자 아래로 집어넣는다">>
						<<run State.setVar("$tfearshatposition", "under")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $browsposition>>
				<<case "front">>
					<<link "눈썹을 앞머리에 가려지게 한다">>
						<<run State.setVar("$browsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "눈썹을 앞머리 바깥으로 뺀다">>
						<<run State.setVar("$browsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "눈썹을 앞머리에 가려지게 한다">>
						<<run State.setVar("$browsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			|
			<<switch $earringsposition>>
				<<case "fringe">>
					<<link "귀걸이를 머리카락 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "귀걸이를 머리카락 앞에 둔다">>
						<<run State.setVar("$earringsposition", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<case "front">>
					<<link "귀걸이를 앞머리 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "fringe")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "귀걸이를 앞머리 뒤에 둔다">>
						<<run State.setVar("$earringsposition", "fringe")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
		<br><br>
		</div>
	<</if>>
<</widget>>

<<widget "mirrorHair">>
	<<set _wraithMirror to false>>
	<<mirroricon>><<link "뒤로">><<updatesidebarimg>><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<<shopClothingFilterSettingsDefault>> /* Due to reusing the traits filtering */
	<br><br>
	<div id="hairDescription">
	<<hairDescription>>
	</div>

	<div id="hairgelLinks">
		<<hairgelLinks>>
	</div>

	<br>

	<<set _hairTypeByName to {}>>
	<<run setup.hairstyles.sides.sort((a, b) => {
		if (a.name === "natural") return -1;
		if (b.name === "natural") return 1;
		return a.name.localeCompare(b.name);
	}).forEach(style => {
		if (!V.shopClothingFilter.active || !V.shopClothingFilter.traits.length || style.type.find(type => V.shopClothingFilter.traits.includes(type))) {
			T.hairTypeByName[style.name] = style.variable;
		}
	})>>
	<<set _fringeTypeByName to {}>>
	<<run setup.hairstyles.fringe.sort((a, b) => {
		if (a.name === "natural") return -1;
		if (b.name === "natural") return 1;
		return a.name.localeCompare(b.name);
	}).forEach(style => {
		if (!V.shopClothingFilter.active || !V.shopClothingFilter.traits.length || style.type.find(type => V.shopClothingFilter.traits.includes(type))) {
			T.fringeTypeByName[style.name] = style.variable;
		}
	})>>

	<div id="hairContainer">
		<div class="containerHeader" class="no-numberify">
			<<mirrorhairdisplayLinks "hair">>
		</div>
		<<mirrorhairdisplay "$hairtype" "sides">>
	</div>
	<br><br>
<</widget>>

<<widget "hairgelLinks">>
	<div class="no-numberify">
	<<link [["마네킹 " + ($showMannequins ? "숨기기" : "보이기")|$passage]]>><<set $showMannequins to 1 - ($showMannequins or 0)>><</link>>
	<mouse class="tooltip-small linkBlue">(?)<span>헤어스타일 미리보기 이미지를 비활성화합니다. <i class="red">마네킹을 활성화하면 일부 기기에서 성능 문제가 발생할 수 있습니다.</i></span></mouse>
	<<if $hairgelBottles isnot undefined and $hairgelBottles gte 1>>
		| <<hairdressericon "gel">>
		<<if $ruffledisable is "f">>
			<<link "헤어젤 바르기">><<replace #hairDescription>><<hairgelApply>><</replace>><<replace #hairgelDesc>><<hairgelDesc>><</replace>><<replace#hairgelLinks>><<hairgelLinks>><</replace>><</link>>
		|
		<</if>>
		<div id="hairgelDesc" style="display:inline"><<hairgelDesc>></div>
	<</if>>
	</div>
<</widget>>

<<widget "hairgelApply">>
	<<if !pcAreArmsBound("any")>>
		<<set $ruffledisable to "t">>
		<<set $hairgelBottles += -1>>
	<</if>>
	<<hairDescription>>
	<<if pcAreArmsBound("both")>>
		<span class="red">두 팔이 모두 결박되어 있어</span>, 지금 상태로는 머리를 어떻게 손질할 수 없다.
		<hr>
	<<else>>
		<<wearProp "hairgel">><<updatesidebarimg>>
		당신은 손에 헤어젤을 듬뿍 짜내어 머리카락에 바른다. 정리를 마치자 머리가 단단히 고정되고 작은 젤 병은 텅 비었다. <span class="pink">헤어스타일을 바꾸면 <<print ($hairgelBottles is 0) ? "다시 구해야" : "다시 발라야">> 합니다.</span>
		<hr>
	<</if>>
<</widget>>

<<widget "hairgelDesc">>
	당신에게 헤어 젤이 <span class="gold">$hairgelBottles</span> <<pluralise $hairgelBottles "병" "병">> 남아 있다.
<</widget>>

<<widget "mirrorhairdisplay">>
	<<if _hairCategory isnot _args[0]>>
		<<set _perPage to $showMannequins ? 12 : 100>>
		<<set _page to 1>>
	<</if>>
	<<set _hairCategory to _args[0]>>
	<<mirrorhairOptions _args[1]>>

	<div id="hairContainerElements">
		<<mirrorhairdisplayElements _hairOptions>>
	</div>
	<div id="hairContainerPages" class="no-numberify">
		<<mirrorhairControls _args[1]>>
	</div>
<</widget>>

<<widget "mirrorhairControls">>
	<<if $showMannequins>>
		<div class="containerFooter">
			<div class="tab">
			<<if _page gt 1>>
				<<button '<span class="fa-icon fa-left"></span> 이전'>>
					<<if _page gt 1>><<set _page-->><</if>>
					<<mirrorhairOptions _args[0]>>
					<<replace "#hairContainerElements">><<mirrorhairdisplayElements _hairOptions>><</replace>>
					<<replace "#hairContainerPages">><<mirrorhairControls _args[0]>><</replace>>
				<</button>>
			<<else>>
				<button class="link-internal macro-button no-numberify buttonDisabled" disabled>이전</button>
			<</if>>
			</div>
			<div class="tab">
			<<if _page lt _pageMax>>
				<<button '다음 <span class="fa-icon fa-right"></span>'>>
					<<if _page lt _pageMax>><<set _page++>><</if>>
					<<mirrorhairOptions _args[0]>>
					<<replace "#hairContainerElements">><<mirrorhairdisplayElements _hairOptions>><</replace>>
					<<replace "#hairContainerPages">><<mirrorhairControls _args[0]>><</replace>>
				<</button>>
			<</if>>
			</div>
			<div class="tab">
				<div class="buttonPage">
					<<button '_page/_pageMax'>>
					<</button>>
				</div>
			</div>
		</div>
	<</if>>
<</widget>>

<<widget "mirrorhairTraits">>
	<div id="hairContainerFilter">
		<div class="tab">
				<<button "<span class='fa-icon fa-check'></span> 적용">>
					<<set $shopClothingFilter.active = true>>
					<<run updateMoment()>>
				<</button>>
				<<button "<span class='fa-icon fa-reset'></span> 필터 초기화">>
					<<shopClothingFilterReset>>
					<<replace "#hairContainerTraits">><<mirrorHairTraitList>><</replace>>
					<<run updateMoment()>>
				<</button>>
				<<button "<span class='fa-icon fa-selected'></span> 전체 선택/해제">>
					<<run toggleAllHairTraitsFilter()>>
				<</button>>
		</div>
	</div>
<</widget>>

<<widget "mirrorhairOptions">>
	<<set _hairOptions to {}>>
	<<run setup.hairstyles[_args[0]].forEach(style => {
		if (!V.shopClothingFilter.active || !V.shopClothingFilter.traits.length || style.type.find(type => V.shopClothingFilter.traits.includes(type))) T.hairOptions[style.name] = style.variable;
	})>>
	<<set _pageMax to Math.ceil(Object.keys(_hairOptions).length / _perPage)>>

	<<run Object.keys(_hairOptions).forEach((key, index) => {
	if (!between(index, T.perPage * (T.page - 1), (T.perPage * T.page) - 1)) {
			delete T.hairOptions[key];
		}
	})>>
<</widget>>

<<widget "mirrorhairdisplayLinks">>
	<div class="tab">
		<span @class="_args[0] is 'hair' ? 'tab-selected' : 'tab'">
			<<button "옆머리">>
				<<replace "#hairContainer">>
					<div class="containerHeader" class="no-numberify">
						<<mirrorhairdisplayLinks "hair">>
					</div>
					<<mirrorhairdisplay "$hairtype" "sides">>
				<</replace>>
			<</button>>
		</span>
	</div>
	<div class="tab">
		<span @class="_args[0] is 'fringe' ? 'tab-selected' : ''">
			<<button "앞머리">>
				<<replace "#hairContainer">>
					<div class="containerHeader" class="no-numberify">
						<<mirrorhairdisplayLinks "fringe">>
					</div>
					<<mirrorhairdisplay "$fringetype" "fringe">>
				<</replace>>
			<</button>>
		</span>
	</div>
	<div class="tab">
		<span @class="_args[0] is 'style' ? 'tab-selected' : ''">
			<<button "저장/로드">>
				<<replace "#hairContainer">>
					<div class="containerHeader" class="no-numberify">
						<<mirrorhairdisplayLinks "style">>
					</div>
					<<mirrorhairdisplaySave>>
				<</replace>>
			<</button>>
			<div id="hairContainerSave" class="no-numberify">
			</div>
		</span>
	</div>
	<div class="tab">
		<span @class="_args[0] is 'filter' ? 'tab-selected' : ''">
			<<button "필터">>
				<<replace "#hairContainer">>
					<div class="containerHeader" class="no-numberify">
						<<mirrorhairdisplayLinks "filter">>
					</div>
					<<mirrorhairdisplayFilter>>
				<</replace>>
			<</button>>
		</span>
	</div>
<</widget>>

<!-- Renders a hairstyle preview, reusing an already rendered one when the options match. -->
<<widget "hairstylemannequin">>
	<<script>>
		const cached = Renderer.cachedMannequin(T.modeloptions);
		if (cached) {
			output.append(cached);
		} else {
			const canvas = T.modelclass.createCanvas(false);
			T.modelclass.render(canvas, T.modeloptions, Renderer.defaultListener);
			canvas.canvas.className = "hairstyleMannequin";
			Renderer.pinCanvasDisplaySize(canvas.canvas, T.modelclass);
			Renderer.storeMannequin(T.modeloptions, canvas.canvas);
			output.append(canvas.canvas);
		}
	<</script>>
<</widget>>

<<widget "mirrorhairdisplayElements">>
	<div id="hairGridSides"
		@class="'no-numberify hairGrid' + ($options.images is 1 and $showMannequins is 1 ? ' hairGridMannequins' : '')">
		<<for _label, _hairName range _args[0]>>
			<<capture _hairCategory, _hairName>>
				<div
					@id="'hairGrid-' + _hairCategory.replace('$','') + '-' + _hairName.replace(/ /g,'')"
					@class="'gridItem' + (_hairName is V[_hairCategory.replace('$','')] ? ' selectedHair' : '')"
					@onclick="`wikifier('mirrorhairdisplayClick', '${T.hairCategory.replace('$','')}', '${T.hairName.replace(/ /g,'_')}');`"
				>
					<<if $options.images is 1 and $showMannequins is 1>>
						<<switch $player.breastsize>>
						<<case 12>>
							<<set _breastSize to 6>>
						<<case 8 9 10 11>>
							<<set _breastSize to 5>>
						<<case 6 7>>
							<<set _breastSize to 4>>
						<<case 4 5>>
							<<set _breastSize to 3>>
						<<case 3>>
							<<set _breastSize to 2>>
						<<case 1 2>>
							<<set _breastSize to 1>>
						<<default>>
							<<set _breastSize to 0>>
						<</switch>>
						<<selectmodel "main">>
						<<set _modeloptions.body_type = $player.bodyshape>>
						<<set _modeloptions.breast_size = _breastSize>>
						<<set _modeloptions.tanningEnabled to false>>
						<<set _modeloptions.skin_type = Skin.color.natural>>
						<<set _modeloptions.skin_tone = Skin.color.tan>>
						<<set _modeloptions.freckles = $player.skin.faceFreckles == true and !$makeup.concealer>>
						<<set _modeloptions.bodyFreckles to $player.skin.bodyFreckles>>
						<<set _modeloptions.mouth to 'neutral'>>
						<<set _modeloptions.facevariant = $facevariant>>
						<<set _modeloptions.left_eye = $makeup.eyelenses.left != 0 ? $makeup.eyelenses.left : $leftEyeColour>>
						<<set _modeloptions.right_eye = $makeup.eyelenses.right != 0 ? $makeup.eyelenses.right : $rightEyeColour>>
						<<showlayer "brows">>
						<<set _modeloptions.brows to "top">>
						<<set _modeloptions.brows_colour to ($makeup.browscolour != 0 ? $makeup.browscolour : $naturalhaircolour)>>
						<<if $browsDyeOption isnot "noChange" and $browsDyeOption isnot "removeDye">>
							<<set _modeloptions.brows_colour to $browsDyeOption>>
						<</if>>
						<<run dhmUtils.canvasSetup()>>
						<<set _modeloptions.hair_fringe_colour_style = $hairFringeColourStyle>>
						<<set _modeloptions.hair_colour_style = $hairColourStyle>>
						<<set _modeloptions.hair_sides_length to $hairlengthstage>>
						<<set _modeloptions.hair_sides_position to $hairposition>>
						<<set _modeloptions.hair_fringe_length to $fringelengthstage>>
						<<if _hairCategory is "$hairtype">>
							<<set _modeloptions.hair_sides_type to _hairName>>
							<<set _modeloptions.hair_fringe_type to $fringetype>>
						<<else>>
							<<set _modeloptions.hair_fringe_type to _hairName>>
							<<set _modeloptions.hair_sides_type to $hairtype>>
						<</if>>
						<<set _modeloptions.ears_position to $earsposition>>
						<div class="hairstyleMannequinBox"><<hairstylemannequin>></div>
					<</if>>
					<<print toTitleCase(_label)>>
				</div>
			<</capture>>
		<</for>>
	</div>
<</widget>>

<<widget "mirrorhairdisplayClick">>
	<<if _args[0] and _args[1]>>
		<<if Object.values(_hairOptions).includes(V[_args[0]])>>
			<<set _id to "#hairGrid-" + _args[0] + "-" + V[_args[0]].replace(/ /g,"")>>
			<<removeclass _id "selectedHair">>
		<</if>>
		<<set V[_args[0]] to _args[1].replace(/_/g," ")>>
		<<set _id2 to "#hairGrid-" + _args[0] + "-" + _args[1].replace(/_/g,"")>>
		<<set $ruffledisable to "f">>
		<<addclass _id2 "selectedHair">>
		<<updatesidebarimg>>
		<<replace #hairDescription>><<hairDescription>><</replace>>
		<<replace #hairgelLinks>><<hairgelLinks>><</replace>>
	<</if>>
<</widget>>

<<widget "mirrorhairdisplaySave">>
	<div id="hairContainerHairstyle">
		<<mirrorHairSaveOptions>>
	</div>
	<div id="hairContainerSave" class="no-numberify">
		<<mirrorHairSave>>
	</div>
<</widget>>

<<widget "mirrorHairSaveOptions">>
		<<if !$savedHairStyles>>
			<<set $savedHairStyles to {
				기본값: { hairtype:$hairtype, fringetype:$fringetype, hairposition:$hairposition }
			}>>
		<</if>>
		<div class="no-numberify saveHair">
		<span class="bold">헤어스타일 선택:</span>
			<hr style="border:none;margin:.25em 0">
			<<set _savedHairStylesKeys to Object.keys($savedHairStyles)>>
			<<if _savedHairStylesKeys.length gt 0>>
				<<listbox '_selectedSavedHairStyle'>>
					<<optionsfrom _savedHairStylesKeys>>
				<</listbox>>
			<</if>>
			<br>
		</div>
		<div class="no-numberify saveHair">
			<span class="bold" style="margin:.25em 0">새로운 헤어스타일 저장:</span>
			<hr style="border:none;margin:.25em 0">
			<label>이름: <<textbox "_hairStyleName" "">></label>
			<mouse class="tooltip linkBlue"> (?)<span>현재 헤어스타일을 저장하여 나중에 입을 수 있게 합니다. 이름이 중복되면 기존 스타일을 덮어씁니다.</span></mouse>
			<span id="textbox-error"></span>
		</div>
<</widget>>


<<widget "mirrorhairdisplayFilter">>
	<div id="hairContainerTraits" class="no-numberify">
		<<mirrorHairTraitList>>
	</div>
	<div id="hairContainerFilter">
		<<mirrorhairTraits>>
	</div>
<</widget>>

<<widget "mirrorHairTraitList">>
	<<set _shopLocation to "mirrorhair">>
	<div class="hairGridTraits">
		<div class="traitCategory">
			<<set _textureTraits to ["curly", "sleek", "wavy", "textured"]>>
			<span class="gold" style="padding-left:5px">질감:</span>
				<<for _trait range _textureTraits.sort()>>
					<<silently>><< _trait>><</silently>>
					<<set _traitObj to setup.hairDetails[_trait]>>
					<div class="filters-trait-row">
						<label>
							<<set _checked = $shopClothingFilter.traits.includes(_trait) ? 'checked="checked"' : ''>>
							<<clothingtrait _trait 'display_normal'>>
							<<print '<input type="checkbox" @id="_trait" @value="_trait" ' + _checked + ' onclick="window.shopClothingFilterToggleTrait(this.value)">'>>
							<<if !_traitObj.desc>>
								<<print _traitObj.name>>
							<<else>>
								<mouse class = "tooltip-small">
									<<print _traitObj.name>>
									<span class="black"><<print _traitObj.desc>></span>
								</mouse>
							<</if>>
						</label>
					</div>
				<</for>>
		</div>
		<div class="traitCategory">
			<span class="gold" style="padding-left:5px">스타일:</span>
			<<set _styleTraits to ["braids", "buns", "pigtails", "ponytail"]>>
				<<for _trait range _styleTraits.sort()>>
					<<silently>><< _trait>><</silently>>
					<<set _traitObj to setup.hairDetails[_trait]>>
					<div class="filters-trait-row">
						<label>
							<<set _checked = $shopClothingFilter.traits.includes(_trait) ? 'checked="checked"' : ''>>
							<<clothingtrait _trait 'display_normal'>>
							<<print '<input type="checkbox" @id="_trait" @value="_trait" ' + _checked + ' onclick="window.shopClothingFilterToggleTrait(this.value)">'>>
							<<if !_traitObj.desc>>
								<<print _traitObj.name>>
							<<else>>
								<mouse class = "tooltip-small">
									<<print _traitObj.name>>
									<span class="black"><<print _traitObj.desc>></span>
								</mouse>
							<</if>>
						</label>
					</div>
				<</for>>
		</div>
		<div class="traitCategory">
			<span class="gold" style="padding-left:5px">기타</span>
			<<set _otherTraits to ["loose","short"]>>
				<<for _trait range _otherTraits.sort()>>
					<<silently>><< _trait>><</silently>>
					<<set _traitObj to setup.hairDetails[_trait]>>
					<div class="filters-trait-row">
						<label>
							<<set _checked = $shopClothingFilter.traits.includes(_trait) ? 'checked="checked"' : ''>>
							<<clothingtrait _trait 'display_normal'>>
							<<print '<input type="checkbox" @id="_trait" @value="_trait" ' + _checked + ' onclick="window.shopClothingFilterToggleTrait(this.value)">'>>
							<<if !_traitObj.desc>>
								<<print _traitObj.name>>
							<<else>>
								<mouse class = "tooltip-small">
									<<print _traitObj.name>>
									<span class="black"><<print _traitObj.desc>></span>
								</mouse>
							<</if>>
						</label>
					</div>
				<</for>>
		</div>
	</div>
<</widget>>

<<widget "mirrorHairSave">>
	<div class="hairContainerSave">
	<<if _savedHairStylesKeys.length gt 0>>
	<div class="tab">
		<<button '<span class="fa-icon fa-check"></span> 착용'>>
			<<set $hairtype to $savedHairStyles[_selectedSavedHairStyle].hairtype>>
			<<set $fringetype to $savedHairStyles[_selectedSavedHairStyle].fringetype>>
			<<set $hairposition to $savedHairStyles[_selectedSavedHairStyle].hairposition>>
			<<set $ruffledisable to "f">>
			<<updatesidebarimg>>
		<</button>>
		<<button '<span class="fa-icon fa-overwrite"></span> 덮어쓰기'>>
			<<set $savedHairStyles[_selectedSavedHairStyle].hairtype to $hairtype>>
			<<set $savedHairStyles[_selectedSavedHairStyle].fringetype to $fringetype>>
			<<set $savedHairStyles[_selectedSavedHairStyle].hairposition to $hairposition>>
			<<updatesidebarimg>>
		<</button>>
		<<button '<span class="fa-icon fa-delete"></span> 삭제'>>
			<<if _selectedSavedHairStyle isnot "Default">>
				<<run $outfit.forEach((o) => {
					if(o.hairStyle === T.selectedSavedHairStyle){
						o.hairStyle = undefined;
					}
				})>>
				<<run delete $savedHairStyles[_selectedSavedHairStyle]>>
				<<updatesidebarimg>>
				<<replace #hairContainerHairstyle>><<mirrorHairSaveOptions>><</replace>>
			<</if>>
		<</button>>
		<<button '<span class="fa-icon fa-save"></span> 저장'>>
			<<if _hairStyleName is "">>
				<<replace "#textbox-error">><br> <span class="red">이름을 입력하세요.</span><</replace>>
			<<else>>
				<<replace "#textbox-error">><</replace>>
				<<set _hairStyleName to _hairStyleName.replace(/[^a-zA-Z\u4e00-\u9fa5\u3131-\u318E\uAC00-\uD7A30-9_-]+/g,"").substring(0,30)>>
				<<set $savedHairStyles[_hairStyleName] to { hairtype:$hairtype, fringetype:$fringetype, hairposition:$hairposition }>>
				<<replace #hairContainerHairstyle>><<mirrorHairSaveOptions>><</replace>>
			<</if>>
		<</button>>
	</div>
	<<else>>
	<div class="tab">
		<<button '<span class="fa-icon fa-save"></span> 저장'>>
			<<if _hairStyleName is "">>
				<<replace "#textbox-error">><br> <span class="red">이름을 입력하세요.</span><</replace>>
			<<else>>
				<<replace "#textbox-error">><</replace>>
				<<set _hairStyleName to _hairStyleName.replace(/[^a-zA-Z\u4e00-\u9fa5\u3131-\u318E\uAC00-\uD7A30-9_-]+/g,"").substring(0,30)>>
				<<set $savedHairStyles[_hairStyleName] to { hairtype:$hairtype, fringetype:$fringetype, hairposition:$hairposition }>>
				<<replace #hairContainerHairstyle>><<mirrorHairSaveOptions>><</replace>>
			<</if>>
		<</button>>
	</div>
	<</if>>
	</div>
<</widget>>

<<widget "mirrorMakeupPart">>
	<<set _itemType = _args[0]>>
	<<set _itemTypeKR = {
		lipstick: "립스틱",
		eyeshadow: "아이쉐도우",
		mascara: "마스카라",
		blusher: "블러셔"
	}[_itemType] || _itemType>>

	<<set _items = $makeup.owned[_itemType].filter(x => x.count > 0)>>
	<<cosmeticsicon _itemType>> <span class="gold bold"><<= _itemTypeKR>>:</span>
	<<if $makeup.owned[_itemType].length == 0>>
		<br>
		당신은 _itemTypeKR【을를】 가지고 있지 않다.
	<<elseif _items.length == 0>>
		<br>
		_itemTypeKR【을를】 다 썼다.
		<br>
	<</if>>
	<<if _items.length != 0 or $makeup[_itemType] != 0>>
		<<if $makeup[_itemType] != 0>>
			<<capture _itemType>>
			<span class="no-numberify">
				<<link "지운다">>
					<<if _itemType is "eyelenses">>
						<!-- A safety check for $makeup.eyelenses -->
						<<set $makeup.eyelenses to { left: 0, right: 0 }>>
					<<else>>
						<<set $makeup[_itemType] to 0>>
					<</if>>
					<<if _itemType == 'mascara'>>
						<<set $makeup.mascara_running = 0>>
					<</if>>
					<<exposure>>
					<<run Engine.show()>>
				<</link>>
			</span>
			<</capture>>
		<</if>>
		<div class="makeupList no-numberify capitalize">
			<<for _i, _item range _items>>
				<span @class="$makeup[_itemType] == _item.colour ? 'makeupWorn' : 'makeupItem'">
					<<capture _item, _itemType>>
						<<set _translatedName to setup.colours[_itemType]?.find(x => x.variable === _item.colour)?.name || setup.colourName(_item.colour)>>
						<<set _name to _translatedName + ` <span @class="_itemType+'-'+_item.colour.replace(/ /g, '-')"><span class="colour-sample"></span></span>
						× _item.count`>>
						<<button _name>>
							<<if $makeup[_itemType] !== _item.colour>>
								<<ccmodRemove _itemType>><<set $makeup[_itemType] = _item.colour>>
								<<set _item.count -= 1>>
								<<if _itemType == 'mascara'>>
									<<set $makeup.mascara_running = 0>>
								<</if>>
								<<exposure>>
							<</if>>
							<<set $mirrorMenu to "makeup">>
							<<replace #mirror>>
								<<if _itemType is "lipstick">>
									<<set _colour to _item.colour.replace(" waterproof", "")>>
									<<set _colour to _colour is "dark red" ? "jewel red" : _colour is "orange" ? "tangerine" : _colour>>
									<<wearProp _itemType _colour>>
								<<else>>
									<<wearProp _itemType>>
								<</if>>
								<<updatesidebarimg>>
								<<mirrorDisplay>>
							<</replace>>
						<</button>>
					<</capture>>
				</span>
			<</for>>
		</div>
	<</if>>
<</widget>>

<<widget "mirrorMakeup">>
	<<mirroricon>><<link "뒤로">><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<br><br>
	<div class="settingsGrid">
		<div class="settingsHeader">메이크업</div>
		<<set _makeup to []>>
		<<if $makeup.lipstick isnot 0>>
			<<set _lipstickName to setup.colours.lipstick?.find(x => x.variable === $makeup.lipstick)?.name || setup.colourName($makeup.lipstick)>>
			<<run _makeup.push(_lipstickName + " 립스틱")>>
		<</if>>
		<<if $makeup.eyeshadow isnot 0>>
			<<set _eyeshadowName to setup.colours.eyeshadow?.find(x => x.variable === $makeup.eyeshadow)?.name || setup.colourName($makeup.eyeshadow)>>
			<<run _makeup.push(_eyeshadowName + " 아이쉐도우")>>
		<</if>>
		<<if $makeup.blusher isnot 0>>
			<<set _blusherName to setup.colours.blusher?.find(x => x.variable === $makeup.blusher)?.name || setup.colourName($makeup.blusher)>>
			<<run _makeup.push(_blusherName + " 블러셔")>>
		<</if>>
		<<if $makeup.mascara isnot 0>>
			<<set _mascaraName to setup.colours.mascara?.find(x => x.variable === $makeup.mascara)?.name || setup.colourName($makeup.mascara)>>
			<<run _makeup.push(_mascaraName + " 마스카라")>>
		<</if>>
		<<if $makeup.concealer>>
			<<run _makeup.push($makeup.concealer is 2 ? "waterproof concealer" : "concealer")>>
		<</if>>
		<<for _slot range setup.ccmod.categories>>
			<<if ccmUtils.itemIsValid(ccmod.equipped[_slot])>>
				<<run _makeup.push(ccmUtils.colorNameFromPreset(ccmod.equipped[_slot].filterString) + " " + _slot)>>
			<</if>>
		<</for>>
		<<set _makeupNames to ["lipstick","eyeshadow","mascara","blusher","browscolour","eyelenses"]>>
		<<set _makeupData to ["lipstick","eyeshadow","mascara","blusher","hairdye","eyelenses"]>>
		<<set _ownsMakeup to _makeupData.some(item => $makeup.owned[item].some(colour => colour.count > 0))>>
		<<set _removableMakeup to _makeup.length gt 1 or (_makeup.length is 1 and !_makeup[0].endsWith("concealer"))>>

		<div class="settingsToggleItemWide">
			<<if _makeup.length gt 0>>
				당신은 <<=_makeup.reduce( (a, b, i, array) => a + ( i < array.length - 1 ? ', ' : (array.length > 2 ? ', 그리고 ' : ' 및 ') ) + b)>>【을를】 바르고 있다.
			<<else>>
				당신은 아무 화장도 하지 않았다.
			<</if>>

			<<if _ownsMakeup or _makeup.length gt 0 or $player.skin.faceFreckles == true>>
				<br><br>
				메이크업:
			<</if>>
			<<if _removableMakeup>>
				<<link [[모두 지운다|$passage]]>>
					<<set $makeup.lipstick to 0>>
					<<set $makeup.eyeshadow to 0>>
					<<set $makeup.mascara to 0>>
					<<set $makeup.blusher to 0>>
					<<set $makeup.eyelenses to { left: 0, right: 0 }>>
					<<ccmodRemoveAll>>
					<<set $makeup.mascara_running to 0>>
					<<exposure>>
				<</link>>
				<<if $makeup.concealer>>
					<mouse class="tooltip linkBlue">(?)<span>컨실러는 지워지지 않습니다.</span></mouse>
				<</if>>
				|
			<</if>>

			<<if _ownsMakeup>>
				<<link [[무작위로|$passage]]>>
					<<for _i to 0; _i lt _makeupNames.length; _i++>>
						<<set _ownedMakeup to $makeup.owned[_makeupData[_i]]>>
						<<if _makeupNames[_i] is "eyelenses">>
							<<set _rng to random(0, _ownedMakeup.length)>>
							<<set _lens to _rng is _ownedMakeup.length ? 0 : _ownedMakeup[_rng]>>
							<<set $makeup.eyelenses to { left: _lens, right: _lens }>>
						<<else>>
							<<set _rngset to []>>
							<<for _label, _value range _ownedMakeup>>
								<<if _value.count gt 0>>
									<<run _rngset.push(_label)>>
								<</if>>
							<</for>>
							<<run _rngset.push(_ownedMakeup.length)>>
							<<set _rng to _rngset[random(0, _rngset.length - 1)]>>
							<<if _rng is _ownedMakeup.length and _makeupNames[_i] is "browscolour">>
								/*Do Nothing*/
							<<elseif _rng is _ownedMakeup.length>>
								<<set $makeup[_makeupNames[_i]] to 0>>
							<<elseif _ownedMakeup[_rng].count gt 0 and $makeup[_makeupNames[_i]] isnot _ownedMakeup[_rng].colour>>
								<<set $makeup[_makeupNames[_i]] to _ownedMakeup[_rng].colour>>
								<<set _ownedMakeup[_rng].count-->>
							<</if>>
						<</if>>
					<</for>>
					<<exposure>>
				<</link>>
			<</if>>
			/* CONCEALER */
			<<if $player.skin.faceFreckles == true>>
				<<if _ownsMakeup>>|<</if>>
				<<if $makeup.concealer == 0>>
					<<link "컨실러로 주근깨를 가린다">>
						<<set $makeup.concealer = 1>>
						<<run Engine.show()>>
					<</link>> |
					<<link "방수 컨실러로 주근깨를 가린다">>
						<<set $makeup.concealer = 2>>
						<<run Engine.show()>>
					<</link>>
				<<else>>
					<<link "컨실러를 지운다">>
						<<set $makeup.concealer = 0>>
						<<run Engine.show()>>
					<</link>>
				<</if>>
			<</if>>
			<<if $makeup.presets is undefined>>
				<<set $makeup.presets to {}>>
			<</if>>
			<<if Object.keys($makeup.presets).length gt 0>>
				<br>
				프리셋:
				<<for _label, _value range $makeup.presets>>
					<<capture _label>>
						<<link _label>>
							<<replace "#makeupPresets">>
								<<makeupPresets _label>>
							<</replace>>
						<</link>>
						<<if _label != Object.keys(V.makeup.presets).slice(-1)[0]>>|<</if>>
					<</capture>>
				<</for>>
				<div id="makeupPresets"></div>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<<mirrorMakeupPart "lipstick">>
		</div>
		<div class="settingsToggleItem">
			<<mirrorMakeupPart "eyeshadow">>
		</div>
		<div class="settingsToggleItem">
			<<ccmodMirrorPart "lipstick">>
		</div>
		<div class="settingsToggleItem">
			<<ccmodMirrorPart "eyeshadow">>
		</div>
		<div class="settingsToggleItem">
			<<mirrorMakeupPart "mascara">>
		</div>
		<div class="settingsToggleItem">
			<<mirrorMakeupPart "blusher">>
		</div>
		<div class="settingsToggleItem">
			<<ccmodMirrorPart "mascara">>
		</div>
		<div class="settingsToggleItem">
			<<ccmodMirrorPart "blusher">>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold bold">새 메이크업 프리셋</span>
			<br>
			현재 하고 있는 화장을 저장합니다.
			<br>
			<<textbox "_newPresetName" "">>
			<br>
			<<link [[프리셋 저장|$passage]]>>
				<<set _newPresetName to _newPresetName.replace(/[^a-zA-Z\u4e00-\u9fa5\u3131-\u318E\uAC00-\uD7A3 0-9]+/g,"")>>
				<<set $makeup.presets[_newPresetName] to {
					lipstick_custom:	clone(ccmod.equipped.lipstick),
					eyeshadow_custom:	clone(ccmod.equipped.eyeshadow),
					mascara_custom:		clone(ccmod.equipped.mascara),
					blusher_custom:		clone(ccmod.equipped.blusher),
					lipstick:clone($makeup.lipstick),
					eyeshadow:clone($makeup.eyeshadow),
					mascara:clone($makeup.mascara),
					blusher:clone($makeup.blusher),
					browscolour:clone($makeup.browscolour),
					eyelenses:clone($makeup.eyelenses),
				}>>
			<</link>>
			<br><br>
			<<cosmeticOptionsButton>>
		</div>
		<<if !$simpleMirror>>
			<div class="settingsToggleItemWide">
				<<cosmeticsicon "contacts">>
				<<if $makeup.owned.eyelenses.length == 0 and $makeup.owned.custom_eyelenses.length == 0>>
					당신은 콘택트렌즈를 가지고 있지 않다.
				<<else>>
					<span class="gold bold">콘택트렌즈:</span>
					<<if $makeup.eyelenses.left != 0 || $makeup.eyelenses.right != 0>>
						<span class="no-numberify">
							<<link "뺀다">>
								<<set $makeup.eyelenses = { left: 0, right: 0 }>>
									<<replace #mirror>>
										<<updatesidebarimg>>
										<<mirrorDisplay>>
									<</replace>>
								<</link>>
						</span>
						<br>
						당신은
						<<if $makeup.eyelenses.left is $makeup.eyelenses.right>>
							<<set _leftLensName to setup.colours.eyes_map[$makeup.eyelenses.left]?.name || setup.colourName($makeup.eyelenses.left)>>
							<<= _leftLensName>> 콘택트렌즈를 양쪽 눈에 끼고 있다.
						<<elseif $makeup.eyelenses.left != 0 and $makeup.eyelenses.right != 0>>
							<<set _leftLensName to setup.colours.eyes_map[$makeup.eyelenses.left]?.name || setup.colourName($makeup.eyelenses.left)>>
							<<set _rightLensName to setup.colours.eyes_map[$makeup.eyelenses.right]?.name || setup.colourName($makeup.eyelenses.right)>>
							왼쪽 눈에 <<= _leftLensName>> 렌즈, 오른쪽 눈에 <<= _rightLensName>> 렌즈를 끼고 있다.
						<<else>>
							<<set _lens to $makeup.eyelenses.left != 0 ? $makeup.eyelenses.left : $makeup.eyelenses.right>>
							<<set _lensName to setup.colours.eyes_map[_lens]?.name || setup.colourName(_lens)>>
							<<set _eye to $makeup.eyelenses.left != 0 ? "left" : "right">>
							<<set _naturalEyeColour to _eye is "left" ? $rightEyeColour : $leftEyeColour>>
							<<set _naturalEyeName to setup.colours.eyes_map[_naturalEyeColour]?.name || setup.colourName(_naturalEyeColour)>>
							<<= _eye is "left" ? "왼쪽" : "오른쪽">> 눈에 <<= _lensName>> 렌즈를 끼고 있다. <<= _eye is "left" ? "오른쪽" : "왼쪽">> 눈은 당신의 본래 색상인 <<= _naturalEyeName>> 눈이다.
						<</if>>
					<<else>>
						<br>
						당신은 아무 콘택트렌즈도 끼지 않았다.
					<</if>>
					<br><br>

					콘택트렌즈 착용 위치:
					<label><<radiobutton "_contact_eye_selected" "Both" checked>> 양눈</label> |
					<label><<radiobutton "_contact_eye_selected" "Left eye">> 왼쪽 눈</label> |
					<label><<radiobutton "_contact_eye_selected" "Right eye">> 오른쪽 눈</label>
					<br>
					<div class="makeupList no-numberify capitalize">
						<<for _i, _colour range $makeup.owned.eyelenses>>
							<<switch _contact_eye_selected>>
								<<default>><<set _eye to "left">>
							<</switch>>
							<span @class="$makeup.eyelenses.left == _colour || $makeup.eyelenses.right == _colour ? 'makeupWorn' : 'makeupItem'">
								<<capture _colour>>
									<<set _colourName to setup.colours.eyes_map[_colour]?.name || setup.colourName(_colour)>>
									<<set _cssColour to setup.colours.eyes_map[_colour]?.csstext || _colour.replace(/ /g, '-')>>
									<<set _contactName to _colourName + ` <span @class="'eye-'+_cssColour"><span class="colour-sample bgcolour-eyes left-"></span></span>`>>

									<<button _contactName>>
										<<if _contact_eye_selected == "Both">>
											<<set $makeup.eyelenses = { left: _colour, right: _colour }>>
										<<elseif _contact_eye_selected == "Left eye">>
											<<set $makeup.eyelenses.left = _colour>>
										<<elseif _contact_eye_selected == "Right eye">>
											<<set $makeup.eyelenses.right = _colour>>
										<</if>>
										<<replace #mirror>>
											<<updatesidebarimg>>
											<<mirrorDisplay>>
										<</replace>>
									<</button>>
								<</capture>>
							</span>
						<</for>>
						/* I wish a fiery death on whoever made the custom contacts */
						<<for _i = 0; _i < $makeup.owned.custom_eyelenses.length; _i++>>
							<<run _colour = $makeup.owned.custom_eyelenses[_i]>>
							<<set _customEntry to null>>
							<<for _e = 0; _e < $custom_eyecolours.length; _e++>>
								<<if $custom_eyecolours[_e].variable == $makeup.owned.custom_eyelenses[_i]>>
									<<set _background_colour to clone($custom_eyecolours[_e].canvasfilter.blend)>>
									<<set _customEntry to $custom_eyecolours[_e]>>
								<</if>>
							<</for>>
							<span class="makeupItem">
								<<capture _colour _background_colour _customEntry>>
									<<set _colourSpaced to _customEntry?.name || setup.colourName(_colour)>>
									<<set _customName to
									`_colourSpaced [C] <span class="eye-custom"><span @style="'background:'+_background_colour" class="colour-sample"></span></span>`>>

									<<button _customName>>
										<<if _contact_eye_selected == "Both">>
											<<set $makeup.eyelenses = { left:_colour, right:_colour }>>
										<<elseif _contact_eye_selected == "Left eye">>
											<<set $makeup.eyelenses.left = _colour>>
										<<elseif _contact_eye_selected == "Right eye">>
											<<set $makeup.eyelenses.right = _colour>>
										<</if>>
										<<replace #mirror>>
											<<updatesidebarimg>>
											<<mirrorDisplay>>
										<</replace>>
									<</button>>
								<</capture>>
							</span>
						<</for>>
					</div>
				<</if>>
			</div>

			<div class="settingsToggleItemWide">
				<<cosmeticsicon "dyes">>
				<<set _dyes = $makeup.owned.hairdye.filter(x => x.count > 0)>>
				<<if _dyes.length == 0>>
					눈썹을 염색할 염색약이 없다.
				<<else>>
					<span class="gold bold">눈썹 색:</span>
					<br>
					<<if $makeup.browscolour != 0>>
						당신의 눈썹은 <<hairmapcolourtext $makeup.browscolour>>색 염색약으로 염색되어 있다. 원래의 <<hairmapcolourtext $naturalhaircolour>>색으로 되돌리려면 미용실에 가야 한다.
					<<else>>
						당신의 눈썹은 자연스러운 <<hairmapcolourtext $naturalhaircolour>>색이다.
					<</if>>
					<br><br>
					눈썹을 염색하는 데는 <span class="gold">0:15</span>분이 걸린다.
					<br>
					<<browsColourPreview>>
					<div class="makeupList no-numberify capitalize">
						<<for _i to 0; _i lt _dyes.length; _i++>>
							<<if $makeup.browscolour is _dyes[_i].colour or $naturalhaircolour is _dyes[_i].colour>>
								<<continue>>
							<</if>>
							<<set _displayName to (_dyes[_i].colour in setup.colours.hair_map ? setup.colours.hair_map[_dyes[_i].colour].name : _dyes[_i].colour.charAt(0).toUpperCase() + _dyes[_i].colour.slice(1)) + " ×" + _dyes[_i].count>>
							<<set _dyeName to _displayName + ` <span @class="'hair-' + _dyes[_i].colour.replace(/ /g, '-')"><span class="colour-sample bgcolour-hair colour-hair"></span></span>`>>
							<<capture _dyes _i>>
								<span @class="$browsDyeOption is _dyes[_i].colour ? 'makeupWorn' : 'makeupItem'">
									<<button _dyeName>>
										<<set $browsDyeOption to _dyes[_i].colour>>
										<<replace #mirror>>
											<<updatesidebarimg>>
											<<mirrorDisplay>>
										<</replace>>
									<</button>>
								</span>
							<</capture>>
						<</for>>
					</div>
				<</if>>
			</div>

		<</if>>
	</div>
<</widget>>

<<widget "makeupPresets">>
	<<set _presetChosen to $makeup.presets[_args[0]]>>
	<hr>
	프리셋: <<print _args[0]>><br><<ccmodMirrorMannequin _presetChosen>>
	<br>
	<<for $_label, $_value range _presetChosen>>
		<<switch $_label>>
			<<case "browscolour">>
				눈썹 염색: <<makeupPresetsItem "hairdye" $_value>>
			<<case "lipstick">>
				립스틱: <<if _presetChosen[$_label + '_custom'] isnot undefined and Object.keys(_presetChosen[$_label + '_custom']).length gt 1>> <<ccmodMirrorPresetItem _presetChosen $_label>> <<else>> <<makeupPresetsItem $_label $_value>> <</if>>
			<<case "eyeshadow">>
				아이섀도: <<if _presetChosen[$_label + '_custom'] isnot undefined and Object.keys(_presetChosen[$_label + '_custom']).length gt 1>> <<ccmodMirrorPresetItem _presetChosen $_label>> <<else>> <<makeupPresetsItem $_label $_value>> <</if>>
			<<case "mascara">>
				마스카라: <<if _presetChosen[$_label + '_custom'] isnot undefined and Object.keys(_presetChosen[$_label + '_custom']).length gt 1>> <<ccmodMirrorPresetItem _presetChosen $_label>> <<else>> <<makeupPresetsItem $_label $_value>> <</if>>
			<<case "blusher">>
				블러셔: <<if _presetChosen[$_label + '_custom'] isnot undefined and Object.keys(_presetChosen[$_label + '_custom']).length gt 1>> <<ccmodMirrorPresetItem _presetChosen $_label>> <<else>> <<makeupPresetsItem $_label $_value>> <</if>>
			<<case "eyelenses">>
				콘택트렌즈: <<makeupPresetsItem $_label $_value>>
		<</switch>>
		<<if not $_label.includes('custom')>><br><</if>>
	<</for>>
	<br>
	<<link [[프리셋 메이크업 적용|$passage]]>>
		<<for _makeupName range _makeupNames>>
			<<set _preset to _presetChosen[_makeupName]>> <<set _presetCustom to _presetChosen[_makeupName + '_custom']>>
			<<if _makeupName is "eyelenses">>
				<<if _preset.left is 0 and _preset.right is 0>>
					<<set $makeup.eyelenses to { left:0, right:0 }>>
				<<elseif $makeup.owned.eyelenses.includes(_preset.left) and $makeup.owned.eyelenses.includes(_preset.right)>>
					<<set $makeup.eyelenses to _preset>>
				<<elseif $makeup.owned.custom_eyelenses.includes(_preset.left) and $makeup.owned.custom_eyelenses.includes(_preset.right)>>
					<<set $makeup.eyelenses to _preset>>
				<</if>>
			<<elseif _preset is 0 and _makeupName is "hairdye">>
				/*Do Nothing*/
			<<elseif setup.ccmod.categories.includes(_makeupName) and ccmUtils.itemIsValid(_presetCustom)>>
				<<set _target to ccmod.owned[_makeupName].find(invMakeup => ccmUtils.itemCompare(_presetCustom, invMakeup) and not ccmUtils.itemIsEquipped(_makeupName, invMakeup) and invMakeup.count gt 0)>>
				<<if _target>>
					<<set _target.count-->>
					<<ccmodMirrorPresetApply _makeupName _presetCustom>>
				<</if>>
			<<elseif _preset is 0>>
				<<set $makeup[_makeupName] to 0>>
			<<else>>
				<<set _makeupName2 to (_makeupName is "browscolour" ? "hairdye" : _makeupName)>>
				<<set _target to $makeup.owned[_makeupName2].find(invMakeup => invMakeup.colour is _preset and invMakeup.colour isnot $makeup[_makeupName] and invMakeup.count gt 0)>>
				<<if _target>>
					<<set $makeup[_makeupName] to clone(_target.colour)>>
					<<set _target.count-->>
				<</if>>
			<</if>>
		<</for>>
		<<ccmodFixSlots>><<exposure>>
	<</link>> |
	<<link [[프리셋 삭제|$passage]]>>
		<<run delete $makeup.presets[_args[0]]>>
	<</link>>
<</widget>>

<<widget "makeupPresetsItem">>
	<<if _args[0] isnot undefined and _args[1] isnot undefined>>
		<<if _args[1] is 0 and _args[0] is "hairdye">>
			<span class="green">내추럴</span>
		<<elseif _args[1] is 0>>
			없음
		<<else>>
			<<if _args[0] is "eyelenses">>
				<<if _args[1].left == 0 && _args[1].right == 0>>
					없음
				<<elseif _args[1].left == _args[1].right>>
					<span class="green"><<print setup.colourName(_args[1].left)>> (보유 중)</span>
				<<else>>
					<<if _args[1].left == 0>>
						<<set _args[1].left to "없음">>
					<</if>>
					<<if _args[1].right == 0>>
						<<set _args[1].right to "없음">>
					<</if>>
					<span class="green"><<print setup.colourName(_args[1].left) + " (좌), " + setup.colourName(_args[1].right)+" (우)">></span>
				<</if>>
			<<else>>
				<<for $_i to 0; $_i lt $makeup.owned[_args[0]].length; $_i++>>
					<<if $makeup.owned[_args[0]][$_i].colour is _args[1]>>
						<<set _presetTranslatedName to setup.colours[_args[0]]?.find(x => x.variable === _args[1])?.name || _args[1].toUpperFirst()>>
						<<if $makeup.owned[_args[0]][$_i].count gt 0>>
							<span class="green"><<print _presetTranslatedName>> (<<print "×"+$makeup.owned[_args[0]][$_i].count>>)</span>
						<<else>>
							<span class="red"><<print _presetTranslatedName>> (× 0)</span>
						<</if>>
						<<break>>
					<</if>>
				<</for>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "browsColourPreview">>
	<span id="browsColourPreview">
	<<if $browsDyeOption isnot undefined and $browsDyeOption isnot "noChange">>
		<span @class="'hair-' + $browsDyeOption.replace(/ /g, '-')">
			<span class="colour-sample bgcolour-hair colour-hair"></span>
		</span>
		<br><<link "눈썹을 염색한다 (0:15)">>
			<<pass 15>>
			<<for _i to 0; _i lt $makeup.owned.hairdye.length; _i++>>
				<<if $makeup.owned.hairdye[_i].colour is $browsDyeOption and $makeup.owned.hairdye[_i].count gt 0>>
					<<set $makeup.owned.hairdye[_i].count-->>
					<<break>>
				<</if>>
			<</for>>
			<<set $makeup.browscolour to $browsDyeOption>>
			<<unset $browsDyeOption>>
			<<replace #mirror>>
				<<updatesidebarimg>>
				<<mirrorDisplay>>
			<</replace>>
		<</link>>
	<</if>>
	</span>
<</widget>>

<<widget "mirrorTransformation">>
	<<mirroricon>><<link "뒤로">><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<br>
	<i class="red"><b>참고:</b> 여기서 바꾼 설정이 적용되지 않는 것 같으면 거울을 닫았다가 다시 여십시오.</i>
	<br><br>

	__게놈 덤프__
	<br>
	<<link "변이를 초기화한다">><<set $mirrorMenu to "genomedump">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
	<br><br>

	<<tfcheck>>

	/* Description (which species' wording is used in body text). */
	<<if $tfDesc is undefined>><<set $tfDesc to { primary : "default" }>><</if>>
	<<tfDescValidList>>
	<<if $tfDescValid is undefined>><<set $tfDescValid to []>><</if>>
	<<if $tfDescValid.length > 0>>
		<div class="tf-description">
			__Description__<br>
			<<set _tfDescLabels to {
				"xenos"       : "제노스",
				"demon"       : "악마",
				"angel"       : "천사",
				"fallen"      : "타락 천사",
				"cat"         : "고양이",
				"cow"         : "소",
				"bear"        : "곰",
				"waterdragon" : "수룡",
				"wolf"        : "늑대",
				"harpy"       : "하피",
				"fox"         : "여우",
				"bunny"       : "토끼",
				"okami"       : "오카미",
				"kitsune"     : "키츠네",
				"seraphim"    : "세라핌",
				"bakunawa"    : "바쿠나와",
				"ryuujin"     : "류진",
				"melusine"    : "멜루신"
			}>>
			<<set _tfDescOrder to ["xenos", "demon", "angel", "fallen", "cat", "cow", "bear", "waterdragon", "wolf", "harpy", "fox", "bunny", "okami", "kitsune", "seraphim", "bakunawa", "ryuujin", "melusine"]>>
			<<set _tfDescOptions to { "기본값 (자동)" : "default" }>>
			<<for _tfDescKey range _tfDescOrder>>
				<<if $tfDescValid.includes(_tfDescKey)>>
					<<set _tfDescOptions[_tfDescLabels[_tfDescKey]] = _tfDescKey>>
				<</if>>
			<</for>>
			/* Combination (chimera) descriptions, appended after the single-species options.
			descriptionComboMenuLabel returns "" for plain single-species keys, so they are skipped here. */
			<<for _tfComboKey range $tfDescValid>>
				<<set _tfComboLabel to Transformations.descriptionComboMenuLabel(_tfComboKey)>>
				<<if _tfComboLabel isnot "">>
					<<set _tfDescOptions[_tfComboLabel] = _tfComboKey>>
				<</if>>
			<</for>>
			<label>다음과 같이 묘사됨:
				<<listbox "$tfDesc.primary" autoselect>>
					<<optionsfrom _tfDescOptions>>
				<</listbox>>
			</label>
			<br><br>
		</div>
	<</if>>

	<<set _angel to $transformationParts.angel>>
	<<set _fallen to $transformationParts.fallenAngel>>
	<<set _demon to $transformationParts.demon>>
	<<set _cat to $transformationParts.cat>>
	<<set _cow to $transformationParts.cow>>
	<<set _bear to $transformationParts.bear>>
	<<set _waterdragon to $transformationParts.waterdragon>>
	<<if _waterdragon is undefined>>
		<<set _waterdragon to {}>><<set _waterdragon.horns to "disabled">><<set _waterdragon.ears to "disabled">><<set _waterdragon.tail to "disabled">>
	<</if>>
	<<set _wolf to $transformationParts.wolf>>
	<<set _bird to $transformationParts.bird>>
	<<set _fox to $transformationParts.fox>>
	<<set _bunny to $transformationParts.bunny>>
	<<set _okami to $transformationParts.okami>>
	<<set _seraphim to $transformationParts.seraphim>>
	<<set _kitsune to $transformationParts.kitsune>>
	<<set _traits to $transformationParts.traits>>

	/* Mirror availability uses raw progression or permanent base unlocks.
	   Effective levels are intentionally not used here: a chimera must not unlock its base TF's mirror options. */
	<<set _tfStageUnlocked to (level, unlocked, required) => level gte required or unlocked is 1>>

	<<set _angelFullCheck to _tfStageUnlocked($angel, $angeltf, 6)>>
	<<set _fallenFullCheck to _tfStageUnlocked($fallenangel, $fallenangeltf, 2)>>
	<<set _fallenPlusFullCheck to _tfStageUnlocked($fallenangel, $fallenangelplustf, 4)>>
	<<set _demonFullCheck to _tfStageUnlocked($demon, $demontf, 6)>>
	<<set _catFullCheck to _tfStageUnlocked($cat, $cattf, 6)>>
	<<set _cowFullCheck to _tfStageUnlocked($cow, $cowtf, 6)>>
	<<set _bearFullCheck to _tfStageUnlocked($bear, $beartf, 6)>>
	<<set _waterdragonFullCheck to _tfStageUnlocked($waterdragon, $waterdragontf, 7)>>
	<<set _waterdragonUnlockedCheck to ($waterdragonCosmeticUnlocked is 1)>>
	<<set _waterdragonTraitsCheck to (_waterdragonFullCheck or _waterdragonUnlockedCheck)>>
	<<set _waterdragonSkinMenuCheck to (_waterdragonTraitsCheck or !["auto", "off"].includes($waterdragonSkinLock))>>
	/* Matches syncDemonSkin: the skin only shows while the demon TF is actually on, so neither does the menu. */
	<<set _demonSkinMenuCheck to ($demon gte 6)>>
	<<set _wolfFullCheck to _tfStageUnlocked($wolfgirl, $wolftf, 6)>>
	<<set _birdFullCheck to _tfStageUnlocked($harpy, $harpytf, 6)>>
	<<set _foxFullCheck to _tfStageUnlocked($fox, $foxtf, 6)>>
	<<set _bunnyFullCheck to _tfStageUnlocked($bunny, $bunnytf, 6)>>
	<<set _angelPartialCheck to _tfStageUnlocked($angel, $angeltf, 4)>>
	<<set _demonPartialCheck to _tfStageUnlocked($demon, $demontf, 4)>>
	<<set _catPartialCheck to _tfStageUnlocked($cat, $cattf, 4)>>
	<<set _cowPartialCheck to _tfStageUnlocked($cow, $cowtf, 4)>>
	<<set _bearPartialCheck to _tfStageUnlocked($bear, $beartf, 4)>>
	<<set _waterdragonPartialCheck to _tfStageUnlocked($waterdragon, $waterdragontf, 4)>>
	<<set _wolfPartialCheck to _tfStageUnlocked($wolfgirl, $wolftf, 4)>>
	<<set _birdPartialCheck to _tfStageUnlocked($harpy, $harpytf, 4)>>
	<<set _foxPartialCheck to _tfStageUnlocked($fox, $foxtf, 4)>>
	<<set _bunnyPartialCheck to _tfStageUnlocked($bunny, $bunnytf, 4)>>

	<<set _angelInitialCheck to _tfStageUnlocked($angel, $angeltf, 2)>>
	<<set _demonInitialCheck to _tfStageUnlocked($demon, $demontf, 2)>>
	<<set _catInitialCheck to _tfStageUnlocked($cat, $cattf, 2)>>
	<<set _cowInitialCheck to _tfStageUnlocked($cow, $cowtf, 2)>>
	<<set _bearInitialCheck to _tfStageUnlocked($bear, $beartf, 2)>>
	<<set _waterdragonInitialCheck to _tfStageUnlocked($waterdragon, $waterdragontf, 2)>>
	<<set _waterdragonMenuCheck to (_waterdragonInitialCheck or _waterdragonUnlockedCheck)>>
	<<set _wolfInitialCheck to _tfStageUnlocked($wolfgirl, $wolftf, 2)>>
	<<set _birdInitialCheck to _tfStageUnlocked($harpy, $harpytf, 2)>>
	<<set _foxInitialCheck to _tfStageUnlocked($fox, $foxtf, 2)>>
	<<set _bunnyInitialCheck to _tfStageUnlocked($bunny, $bunnytf, 2)>>
	<<set _birdTraitCheck to _tfStageUnlocked($harpy, $harpytf, 3)>>
	<<set _foxTraitCheck to _tfStageUnlocked($fox, $foxtf, 3)>>

	<<if _fallenPlusFullCheck or _wolfInitialCheck or _catInitialCheck or _foxInitialCheck or _bearInitialCheck or _birdInitialCheck or _cowFullCheck or _waterdragonMenuCheck or _bunnyInitialCheck or (_demonPartialCheck and hasSexStat("exhibitionism", 6))>>
		__Traits__<br>
		<<if _fallenPlusFullCheck>>
			강철 의지: <<checkbox "_traits.ironWill" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _wolfInitialCheck or _catInitialCheck or _foxInitialCheck or _bearInitialCheck or _waterdragonMenuCheck>>
			송곳니: <<checkbox "_traits.fangs" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _catInitialCheck or _birdInitialCheck or _foxInitialCheck or _waterdragonMenuCheck>>
			날카로운 눈: <<checkbox "_traits.sharpEyes" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _waterdragonMenuCheck>>
			용의 눈: <<checkbox "_traits.dragonEyes" "disabled" "default" autocheck>><br>
			용의 혀: <<checkbox "_traits.dragonTongue" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _birdTraitCheck or _foxTraitCheck>>
			평생의 짝: <<checkbox "_traits.mateForLife" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _foxPartialCheck>>
			추격의 짜릿함: <<checkbox "_traits.chase" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _bunnyInitialCheck>>
			튼튼한 발: <<checkbox "_traits.strongFeet" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _demonPartialCheck and hasSexStat("exhibitionism", 6)>>
			노출 시 과시: <<checkbox "_traits.flaunting" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _waterdragonTraitsCheck>>
			수중 폐: <<checkbox "_traits.aquatic" "disabled" "default" autocheck>><br>
		<</if>>
		<<if _cowFullCheck>>
			정액/모유 두 배 용량:
			<<if $semen_max isnot 6000>>
				<<link [[설정한다|$passage]]>><<set $semen_max to 6000>><<set $milk_max to 6000>><</link>>
			<<else>>
				<<link [[해제한다|$passage]]>><<set $semen_max to 3000>><<set $milk_max to 3000>><</link>>
			<</if>>
			<br>
			정액/모유 두 배 생산: <<checkbox "$cowDoubleProduction" 0 1 autocheck>><br>
		<</if>>
		<<if _tfStageUnlocked($cat, $cattf, 7)>>
			오드아이:
			<<if _cat.heterochromia isnot "default">>
				<<link [[설정한다|$passage]]>><<set _cat.heterochromia = "default">><<if V.custom_eyecolours.findIndex(c => c.variable && c.variable.startsWith("cat_tf_stage_")) === -1>><<run window.determineCatEyeStages()>><</if>><<set $original_colour = [$leftEyeColour, $rightEyeColour]>><<catHeterochromiaTF `$cat gte 7 ? Math.min($cat - 7, 3) : 3`>><<updatesidebarimg>><</link>>
			<<else>>
				<<link [[해제한다|$passage]]>><<set _cat.heterochromia = "disabled">><<set $leftEyeColour to $original_colour[0]>><<set $rightEyeColour to $original_colour[1]>><<catHeterochromiaTF "hide">><<updatesidebarimg>><</link>>
			<</if>>
			<br><br>
		<</if>>
		<<if $DoLPTFBuffs is 1>>
			<<if _wolfFullCheck>>
				야생의 정령: <<checkbox "$TFWolfBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _catFullCheck>>
				고양이의 장난기: <<checkbox "$TFCatBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _cowFullCheck>>
				자연의 양육자: <<checkbox "$TFCowBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _bearFullCheck>>
				곰의 힘: <<checkbox "$TFBearBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _waterdragonTraitsCheck>>
				용의 우아함: <<checkbox "$TFWaterDragonBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _birdFullCheck>>
				하늘의 품: <<checkbox "$TFBirdBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _foxFullCheck>>
				암여우의 교활함: <<checkbox "$TFFoxBuffs" 0 1 autocheck>><br>
			<</if>>
			<<if _bunnyFullCheck>>
				토끼의 민첩함: <<checkbox "$TFBunnyBuffs" 0 1 autocheck>><br>
			<</if>>
		<</if>>
		<<if $DoLPTFTempTolerance is 1>>
			/* Temp Tolerance */
			<<set _options = {}>> 
			<<set _options["없음"] = "disabled">>
			<<if _wolfFullCheck>>
				<<set _options["늑대"] = "wolf">>
				<<if _traits.tempTolerance is "wolf">>
					<<set _tempToleranceChoice to _options["늑대"]>>
				<</if>>
			<</if>>
			<<if _catFullCheck>>
				<<set _options["고양이"] = "cat">>
				<<if _traits.tempTolerance is "cat">>
					<<set _tempToleranceChoice to _options["고양이"]>>
				<</if>>
			<</if>>
			<<if _cowFullCheck>>
				<<set _options["젖소"] = "cow">>
				<<if _traits.tempTolerance is "cow">>
					<<set _tempToleranceChoice to _options["젖소"]>>
				<</if>>
			<</if>>
			<<if _bearFullCheck>>
				<<set _options["곰"] = "bear">>
				<<if _traits.tempTolerance is "bear">>
					<<set _tempToleranceChoice to _options["곰"]>>
				<</if>>
			<</if>>
			<<if _waterdragonTraitsCheck>>
				<<set _options["수룡"] = "waterdragon">>
				<<if _traits.tempTolerance is "waterdragon">>
					<<set _tempToleranceChoice to _options["수룡"]>>
				<</if>>
			<</if>>
			<<if _birdFullCheck>>
				<<set _options["새"] = "bird">>
				<<if _traits.tempTolerance is "bird">>
					<<set _tempToleranceChoice to _options["새"]>>
				<</if>>
			<</if>>
			<<if _foxFullCheck>>
				<<set _options["여우"] = "fox">>
				<<if _traits.tempTolerance is "fox">>
					<<set _tempToleranceChoice to _options["여우"]>>
				<</if>>
			<</if>>
			<<if _bunnyFullCheck>>
				<<set _options["토끼"] = "bunny">>
				<<if _traits.tempTolerance is "bunny">>
					<<set _tempToleranceChoice to _options["토끼"]>>
				<</if>>
			<</if>>
			<br>
			<<if !_tempToleranceChoice>>
				<<set _tempToleranceChoice to 0>>
			<</if>>
			<<if Object.keys(_options).length > 1>>
				<label>온도 내성:
					<div class="tf-tempTolerance">
						<<listbox "_tempToleranceChoice" autoselect>>
							<<optionsfrom _options>>
						<</listbox>>
					</div>
				</label>
				<br>
			<</if>>
		<</if>>
	<</if>>

	<<playerClawType>>
	<<if _clawTypes.length > 0>>
		<<set _clawLabels to { cat : "고양이", wolf : "늑대", fox : "여우", bear : "곰", waterdragon : "수룡" }>>
		<<set _clawOptions to {}>>
		<<for _claw range _clawTypes>>
			<<set _clawOptions[_clawLabels[_claw]] to _claw>>
		<</for>>
		<<set _clawChoice to _clawType>>
		<label>발톱:
			<div class="tf-claws">
				<<listbox "_clawChoice" autoselect>>
					<<optionsfrom _clawOptions>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* misc */
	<<set _options = {}>> 
	<<set _options["없음"] = 0>>
	<<if _angelFullCheck and _wolfFullCheck>>
		<<set _options["오카미"] = ["okami", "default"]>>
		<<if _okami.misc is "default">>
			<<set _miscChoice to _options["오카미"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _foxFullCheck>>
		<<set _options["키츠네"] = ["kitsune", "default"]>>
		<<if _kitsune.misc is "default">>
			<<set _miscChoice to _options["키츠네"]>>
		<</if>>
	<</if>>
	<<if !_miscChoice>>
		<<set _miscChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>혼합형 기타:
			<div class="tf-misc">
				<<listbox "_miscChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	<<if _demonSkinMenuCheck>>
		/* "auto" follows your tan. Choosing a colour locks it instead. */
		<<set _demonSkinChoice to ($demonSkinLock is "auto" ? (Skin.color.tan gte 66 ? "red" : Skin.color.tan gte 33 ? "purple" : "blue") : $demonSkinLock is "off" ? "none" : $demonSkinLock)>>
		<label>악마 피부:
			<div class="tf-demon-skin">
				<<listbox "_demonSkinChoice" autoselect>>
					<<option "없음" "none">>
					<<option "파란색" "blue">>
					<<option "보라색" "purple">>
					<<option "빨간색" "red">>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	<<if _waterdragonSkinMenuCheck>>
		<<set _waterDragonSkinChoice to ($waterdragonSkinLock is "auto" ? (_waterdragonFullCheck ? (Skin.color.tan gte 66 ? "blue" : Skin.color.tan gte 33 ? "purple" : "lilac") : "none") : $waterdragonSkinLock is "off" ? "none" : $waterdragonSkinLock)>>
		<label>수룡 피부:
			<div class="tf-waterdragon-skin">
				<<listbox "_waterDragonSkinChoice" autoselect>>
					<<option "없음" "none">>
					<<option "라일락" "lilac">>
					<<option "보라색" "purple">>
					<<option "파랑/청록" "blue">>
					<<option "하늘색" "skyblue">>
					<<option "연분홍" "pink">>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Cheeks */
	<<set _options = {}>> 
	<<set _options["없음"] = 0>>
	<<if _tfStageUnlocked($fox, $foxtf, 5)>>
		<<set _options["여우"] = ["fox", "default"]>>
		<<if _fox.cheeks is "default">>
			<<set _cheeksChoice to _options["여우"]>>
		<</if>>
	<</if>>
	<<if _tfStageUnlocked($wolfgirl, $wolftf, 5)>>
		<<set _options["늑대"] = ["wolf", "feral"]>>
		<<if _wolf.cheeks is "feral">>
			<<set _cheeksChoice to _options["늑대"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _foxFullCheck>>
		<<set _options["키츠네"] = ["kitsune", "default"]>>
		<<if _kitsune.cheeks is "default">>
			<<set _cheeksChoice to _options["키츠네"]>>
		<</if>>
	<</if>>
	<<if !_cheeksChoice>>
		<<set _cheeksChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>뺨:
			<div class="tf-cheeks">
				<<listbox "_cheeksChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Malar */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _birdInitialCheck>>
		<<set _options["새"] = ["bird", "default"]>>
		<<if _bird.malar is "default">>
			<<set _malarChoice to _options["새"]>>
		<</if>>
	<</if>>
	<<if !_malarChoice>>
		<<set _malarChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>광대뼈 줄무늬:
			<div class="tf-malar">
				<<listbox "_malarChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Pits */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if $settings.pubicHairEnabled>>
		<<if _wolfPartialCheck>>
			<<set _options["늑대"] = ["wolf", "default"]>>
			<<if _wolf.pits is "default">>
				<<set _pitsChoice to _options["늑대"]>>
			<</if>>
		<</if>>
	<</if>>
	<<if !_pitsChoice>>
		<<set _pitsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>겨드랑이:
			<div class="tf-pits">
				<<listbox "_pitsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Plumage and Fur */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _bearPartialCheck>>
		<<set _options["곰"] = ["bear", "default"]>>
		<<if _bear.plumage is "default">>
			<<set _plumageChoice to _options["곰"]>>
		<</if>>
	<</if>>
	<<if _birdPartialCheck>>
		<<set _options["새"] = ["bird", "default"]>>
		<<if _bird.plumage is "default">>
			<<set _plumageChoice to _options["새"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _birdFullCheck>>
		<<set _options["세라핌"] = ["seraphim", "default"]>>
		<<if _seraphim.plumage is "default">>
			<<set _plumageChoice to _options["세라핌"]>>
		<</if>>
	<</if>>
	<<if !_plumageChoice>>
		<<set _plumageChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>깃털과 털:
			<div class="tf-plumage">
				<<listbox "_plumageChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Pubes */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if $settings.pubicHairEnabled>>
		<<if _bearFullCheck>>
			<<set _options["곰"] = ["bear", "default"]>>
			<<if _bear.pubes is "default">>
				<<set _pubesChoice to _options["곰"]>>
			<</if>>
		<</if>>
		<<if _birdFullCheck>>
			<<set _options["새"] = ["bird", "default"]>>
			<<if _bird.pubes is "default">>
				<<set _pubesChoice to _options["새"]>>
			<</if>>
		<</if>>
		<<if _wolfPartialCheck>>
			<<set _options["늑대"] = ["wolf", "default"]>>
			<<if _wolf.pubes is "default">>
				<<set _pubesChoice to _options["늑대"]>>
			<</if>>
		<</if>>
	<</if>>
	<<if !_pubesChoice>>
		<<set _pubesChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>음모:
			<div class="tf-pubes">
				<<listbox "_pubesChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Ears */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _bearPartialCheck>>
		<<set _options["곰"] = ["bear", "default"]>>
		<<if _bear.ears is "default">>
			<<set _earsChoice to _options["곰"]>>
		<</if>>
	<</if>>
	<<if _bunnyPartialCheck>>
		<<set _options["토끼 - 기본"] = ["bunny", "default"]>>
		<<set _options["토끼 - 처진 귀"] = ["bunny", "lop"]>>
		<<if _bunny.ears is "default">>
			<<set _earsChoice to _options["토끼 - 기본"]>>
		<<elseif _bunny.ears is "lop">>
			<<set _earsChoice to _options["토끼 - 처진 귀"]>>
		<</if>>
	<</if>>
	<<if _catPartialCheck>>
		<<set _options["고양이"] = ["cat", "default"]>>
		<<if _cat.ears is "default">>
			<<set _earsChoice to _options["고양이"]>>
		<</if>>
	<</if>>
	<<if _cowPartialCheck>>
		<<set _options["젖소"] = ["cow", "default"]>>
		<<set _options["젖소 - 검은 얼룩"] = ["cow", "spotted-black"]>>
		<<set _options["젖소 - 갈색 얼룩"] = ["cow", "spotted-brown"]>>
		<<set _options["젖소 - 클래식"] = ["cow", "classic"]>>
		<<set _options["젖소 - 클래식 검은 얼룩"] = ["cow", "classic-spotted-black"]>>
		<<set _options["젖소 - 클래식 갈색 얼룩"] = ["cow", "classic-spotted-brown"]>>
		<<if _cow.ears is "default">>
			<<set _earsChoice to _options["젖소"]>>
		<<elseif _cow.ears is "spotted-black" or _cow.ears is "spotted black">>
			<<set _earsChoice to _options["젖소 - 검은 얼룩"]>>
		<<elseif _cow.ears is "spotted-brown" or _cow.ears is "spotted brown">>
			<<set _earsChoice to _options["젖소 - 갈색 얼룩"]>>
		<<elseif _cow.ears is "classic">>
			<<set _earsChoice to _options["젖소 - 클래식"]>>
		<<elseif _cow.ears is "classic-spotted-black">>
			<<set _earsChoice to _options["젖소 - 클래식 검은 얼룩"]>>
		<<elseif _cow.ears is "classic-spotted-brown">>
			<<set _earsChoice to _options["젖소 - 클래식 갈색 얼룩"]>>
		<<elseif _cow.ears isnot "disabled" and _cow.ears isnot "hidden">>
			<<run console.warn("Unknown cow ears value:", _cow.ears)>>
			<<set _earsChoice to _options["Cow"]>>
		<</if>>
	<</if>>
	<<if _foxPartialCheck>>
		<<set _options["Fox Default"] = ["fox", "default"]>>
		<<set _options["Fox Floppy"] = ["fox", "floppy"]>>
		<<if _fox.ears is "default">>
			<<set _earsChoice to _options["Fox Default"]>>
		<<elseif _fox.ears is "floppy">>
			<<set _earsChoice to _options["Fox Floppy"]>>
		<</if>>
	<</if>>
	<<if _wolfPartialCheck>>
		<<set _options["늑대 - 기본"] = ["wolf", "default"]>>
		<<set _options["늑대 - 야생"] = ["wolf", "feral"]>>
		<<if _wolf.ears is "default">>
			<<set _earsChoice to _options["늑대 - 기본"]>>
		<<elseif _wolf.ears is "feral">>
			<<set _earsChoice to _options["늑대 - 야생"]>>
		<</if>>
	<</if>>
	<<if _wolfFullCheck and _angelFullCheck>>
		<<set _options["오카미"] = ["okami", "default"]>>
		<<if _okami.ears is "default">>
			<<set _earsChoice to _options["오카미"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _foxFullCheck>>
		<<set _options["키츠네"] = ["kitsune", "default"]>>
		<<if _kitsune.ears is "default">>
			<<set _earsChoice to _options["키츠네"]>>
		<</if>>
	<</if>>
	<<if (_waterdragonPartialCheck or _waterdragonUnlockedCheck)>>
		<<set _options["수룡"] = ["waterdragon", "default"]>>
		<<set _options["수룡 - 보라색"] = ["waterdragon", "purple"]>>
		<<set _options["수룡 - 회색"] = ["waterdragon", "gray"]>>
		<<if _waterdragon.ears is "default">>
			<<set _earsChoice to _options["수룡"]>>
		<<elseif _waterdragon.ears is "purple">>
			<<set _earsChoice to _options["수룡 - 보라색"]>>
		<<elseif _waterdragon.ears is "gray">>
			<<set _earsChoice to _options["수룡 - 회색"]>>
		<</if>>
	<</if>>
	<<if !_earsChoice>>
		<<set _earsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>귀:
			<div class="tf-ears">
				<<listbox "_earsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Eyes */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _catInitialCheck or _birdInitialCheck or _foxInitialCheck>>
		<<set _options["새"] = ["bird", "default"]>>
		<<if _bird.eyes is "default">>
			<<set _eyesChoice to _options["새"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _birdFullCheck>>
		<<set _options["세라핌"] = ["seraphim", "default"]>>
		<<if _seraphim.eyes is "default">>
			<<set _eyesChoice to _options["세라핌"]>>
		<</if>>
	<</if>>
	<<if !_eyesChoice>>
		<<set _eyesChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>눈:
			<div class="tf-eyes">
				<<listbox "_eyesChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Halo */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _angelPartialCheck>>
		<<set _options["천사 - 기본"] = ["angel", "default"]>>
		<<set _options["천사 - 전통형"] = ["angel", "traditional"]>>
		<<set _options["천사 - 천상형"] = ["angel", "celestial"]>>
		<<if _angel.halo is "default">>
			<<set _haloChoice to _options["천사 - 기본"]>>
		<<elseif _angel.halo is "traditional">>
			<<set _haloChoice to _options["천사 - 전통형"]>>
		<<elseif _angel.halo is "celestial">>
			<<set _haloChoice to _options["천사 - 천상형"]>>
		<</if>>
	<</if>>
	<<if _tfStageUnlocked($fallenangel, $fallenangeltf, 1)>>
		<<set _options["타락 천사 - 기본"] = ["fallenAngel", "default"]>>
		<<set _options["타락 천사 - 천상형"] = ["fallenAngel", "celestial"]>>
		<<set _options["타락 천사 - 어두운 천상형"] = ["fallenAngel", "celestial-black"]>>
		<<set _options["타락 천사 - 용서받은 천상형"] = ["fallenAngel", "celestial-fallenplus"]>>
		<<set _options["타락 천사 - 전통형"] = ["fallenAngel", "traditional"]>>
		<<if _fallen.halo is "default">>
			<<set _haloChoice to _options["타락 천사 - 기본"]>>
		<<elseif _fallen.halo is "celestial">>
			<<set _haloChoice to _options["타락 천사 - 천상형"]>>
		<<elseif _fallen.halo is "celestial-black">>
			<<set _haloChoice to _options["타락 천사 - 어두운 천상형"]>>
		<<elseif _fallen.halo is "celestial-fallenplus">>
			<<set _haloChoice to _options["타락 천사 - 용서받은 천상형"]>>
		<<elseif _fallen.halo is "traditional">>
			<<set _haloChoice to _options["타락 천사 - 전통형"]>>
		<</if>>
	<</if>>
	<<if !_haloChoice>>
		<<set _haloChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>헤일로:
			<div class="tf-halo">
				<<listbox "_haloChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Divine Horns */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _demonInitialCheck>>
		<<set _options["악마 - 기본"] = ["demon", "default"]>>
		<<set _options["악마 - 서큐버스"] = ["demon", "succubus"]>>
		<<set _options["악마 - 클래식"] = ["demon", "classic"]>>
		<<if _demon.horns is "default">>
			<<set _divineHornsChoice to _options["악마 - 기본"]>>
		<<elseif _demon.horns is "succubus">>
			<<set _divineHornsChoice to _options["악마 - 서큐버스"]>>
		<<elseif _demon.horns is "classic">>
			<<set _divineHornsChoice to _options["악마 - 클래식"]>>
		<</if>>
	<</if>>
	<<if !_divineHornsChoice>>
		<<set _divineHornsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>신성 뿔:
			<div class="tf-divine-horns">
				<<listbox "_divineHornsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
				<span class="small-description">악마 색상:</span> <<gencolourselector "$transformationParts.demon.horns_colour">>
			</div>
		</label>
		<br>
	<</if>>

	/* Horns */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _cowInitialCheck>>
		<<set _options["젖소"] = ["cow", "default"]>>
		<<if _cow.horns is "default">>
			<<set _hornsChoice to _options["젖소"]>>
		<</if>>
	<</if>>
	<<if _tfStageUnlocked($waterdragon, $waterdragontf, 3) or _waterdragonUnlockedCheck>>
		<<set _options["수룡"] = ["waterdragon", "default"]>>
		<<set _options["수룡 - 짧은 형"] = ["waterdragon", "short"]>>
		<<if _waterdragon.horns is "default">>
			<<set _hornsChoice to _options["수룡"]>>
		<<elseif _waterdragon.horns is "short">>
			<<set _hornsChoice to _options["수룡 - 짧은 형"]>>
		<</if>>
	<</if>>
	<<if !_hornsChoice>>
		<<set _hornsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>뿔:
			<div class="tf-horns">
				<<listbox "_hornsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Divine Tail */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _demonPartialCheck>>
		<<set _options["악마 - 기본"] = ["demon", "default"]>>
		<<set _options["악마 - 임프"] = ["demon", "imp"]>>
		<<set _options["악마 - 클래식"] = ["demon", "classic"]>>
		<<set _options["악마 - 서큐버스"] = ["demon", "succubus"]>>
		<<if _demon.tail is "default">>
			<<set _divineTailChoice to _options["악마 - 기본"]>>
		<<elseif _demon.tail is "imp">>
			<<set _divineTailChoice to _options["악마 - 임프"]>>
		<<elseif _demon.tail is "classic">>
			<<set _divineTailChoice to _options["악마 - 클래식"]>>
		<<elseif _demon.tail is "succubus">>
			<<set _divineTailChoice to _options["악마 - 서큐버스"]>>
		<</if>>
	<</if>>
	<<if _wolfFullCheck and _angelFullCheck>>
		<<set _options["오카미"] = ["okami", "default"]>>
		<<if _okami.tail is "default">>
			<<set _divineTailChoice to _options["오카미"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _foxFullCheck>>
		<<set _options["키츠네"] = ["kitsune", "default"]>>
		<<if _kitsune.tail is "default">>
			<<set _divineTailChoice to _options["키츠네"]>>
		<</if>>
	<</if>>
	<<if !_divineTailChoice>>
		<<set _divineTailChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>신성 꼬리:
			<div class="tf-divine-tail">
				<<listbox "_divineTailChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
				<<if _demonPartialCheck>>
					<span class="small-description">악마 색상:</span> <<gencolourselector "$transformationParts.demon.tail_colour">>
				<</if>>
			</div>
		</label>
		<br>
	<</if>>

	/* Tail */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _bearFullCheck>>
		<<set _options["곰"] = ["bear", "default"]>>
		<<if _bear.tail is "default">>
			<<set _tailChoice to _options["곰"]>>
		<</if>>
	<</if>>
	<<if _birdPartialCheck>>
		<<set _options["새"] = ["bird", "default"]>>
		<<if _bird.tail is "default">>
			<<set _tailChoice to _options["새"]>>
		<</if>>
	<</if>>
	<<if _bunnyFullCheck>>
		<<set _options["Bunny Default"] = ["bunny", "default"]>>
		<<set _options["Bunny Fluffy"] = ["bunny", "fluffy"]>>
		<<if _bunny.tail is "default">>
			<<set _tailChoice to _options["Bunny Default"]>>
		<<elseif _bunny.tail is "fluffy">>
			<<set _tailChoice to _options["Bunny Fluffy"]>>
		<</if>>
	<</if>>
	<<if _catFullCheck>>
		<<set _options["고양이"] = ["cat", "default"]>>
		<<if _cat.tail is "default">>
			<<set _tailChoice to _options["고양이"]>>
		<</if>>
	<</if>>
	<<if _cowFullCheck>>
		<<set _options["젖소"] = ["cow", "default"]>>
		<<set _options["젖소 - 검은색"] = ["cow", "black"]>>
		<<if _cow.tail is "default">>
			<<set _tailChoice to _options["젖소"]>>
		<<elseif _cow.tail is "black">>
			<<set _tailChoice to _options["젖소 - 검은색"]>>
		<</if>>
	<</if>>
	<<if _foxFullCheck>>
		<<set _options["Fox Default"] = ["fox", "default"]>>
		<<set _options["Fox Fluffy"] = ["fox", "fluffy"]>>
		<<if _fox.tail is "default">>
			<<set _tailChoice to _options["Fox Default"]>>
		<<elseif _fox.tail is "fluffy">>
			<<set _tailChoice to _options["Fox Fluffy"]>>
		<</if>>
	<</if>>
	<<if _wolfFullCheck>>
		<<set _options["늑대 - 기본"] = ["wolf", "default"]>>
		<<set _options["늑대 - 야생"] = ["wolf", "feral"]>>
		<<if _wolf.tail is "default">>
			<<set _tailChoice to _options["늑대 - 기본"]>>
		<<elseif _wolf.tail is "feral">>
			<<set _tailChoice to _options["늑대 - 야생"]>>
		<</if>>
	<</if>>
	<<if _tfStageUnlocked($waterdragon, $waterdragontf, 6) or _waterdragonUnlockedCheck>>
		<<set _options["수룡 - 긴 보라색 형"] = ["waterdragon", "purple"]>>
		<<set _options["Water Dragon Long Blue"] = ["waterdragon", "default"]>>
		<<set _options["수룡 - 긴 회색 형"] = ["waterdragon", "gray"]>>
		<<set _options["Water Dragon Short Purple"] = ["waterdragon", "short"]>>
		<<set _options["Water Dragon Short Blue"] = ["waterdragon", "sblue"]>>
		<<set _options["수룡 - 짧은 회색 형"] = ["waterdragon", "sgray"]>>
		<<if _waterdragon.tail is "default">>
			<<set _tailChoice to _options["Water Dragon Long Blue"]>>
		<<elseif _waterdragon.tail is "short">>
			<<set _tailChoice to _options["Water Dragon Short Purple"]>>
		<<elseif _waterdragon.tail is "purple">>
			<<set _tailChoice to _options["수룡 - 긴 보라색 형"]>>
		<<elseif _waterdragon.tail is "gray">>
			<<set _tailChoice to _options["수룡 - 긴 회색 형"]>>
		<<elseif _waterdragon.tail is "sgray">>
			<<set _tailChoice to _options["수룡 - 짧은 회색 형"]>>
		<<elseif _waterdragon.tail is "sblue">>
			<<set _tailChoice to _options["Water Dragon Short Blue"]>>
		<</if>>
	<</if>>
	<<if !_tailChoice>>
		<<set _tailChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>꼬리:
			<div class="tf-tail">
				<<listbox "_tailChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Divine Wings */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _angelFullCheck>>
		<<set _options["천사 - 기본"] = ["angel", "default"]>>
		<<set _options["천사 - 케루브"] = ["angel", "cherub"]>>
		<<set _options["천사 - 클래식"] = ["angel", "classic"]>>
		<<if _angel.wings is "default">>
			<<set _divineWingsChoice to _options["천사 - 기본"]>>
		<<elseif _angel.wings is "cherub">>
			<<set _divineWingsChoice to _options["천사 - 케루브"]>>
		<<elseif _angel.wings is "classic">>
			<<set _divineWingsChoice to _options["천사 - 클래식"]>>
		<</if>>
	<</if>>
	<<if _demonFullCheck>>
		<<set _options["악마 - 기본"] = ["demon", "default"]>>
		<<set _options["악마 - 임프"] = ["demon", "imp"]>>
		<<set _options["악마 - 서큐버스"] = ["demon", "succubus"]>>
		<<if _demon.wings is "default">>
			<<set _divineWingsChoice to _options["악마 - 기본"]>>
		<<elseif _demon.wings is "imp">>
			<<set _divineWingsChoice to _options["악마 - 임프"]>>
		<<elseif _demon.wings is "succubus">>
			<<set _divineWingsChoice to _options["악마 - 서큐버스"]>>
		<</if>>
	<</if>>
	<<if _fallenFullCheck>>
		<<set _options["타락 천사 - 기본"] = ["fallenAngel", "default"]>>
		<<set _options["타락 천사 - 찢어진 날개"] = ["fallenAngel", "torn"]>>
		<<set _options["타락 천사 - 케루브"] = ["fallenAngel", "cherub"]>>
		<<set _options["타락 천사 - 어두운 케루브"] = ["fallenAngel", "cherub-black"]>>
		<<set _options["타락 천사 - 클래식"] = ["fallenAngel", "classic"]>>
		<<if _fallen.wings is "default">>
			<<set _divineWingsChoice to _options["타락 천사 - 기본"]>>
		<<elseif _fallen.wings is "torn">>
			<<set _divineWingsChoice to _options["타락 천사 - 찢어진 날개"]>>
		<<elseif _fallen.wings is "cherub">>
			<<set _divineWingsChoice to _options["타락 천사 - 케루브"]>>
		<<elseif _fallen.wings is "cherub-black">>
			<<set _divineWingsChoice to _options["타락 천사 - 어두운 케루브"]>>
		<<elseif _fallen.wings is "classic">>
			<<set _divineWingsChoice to _options["타락 천사 - 클래식"]>>
		<</if>>
	<</if>>
	<<if _fallenPlusFullCheck>>
		<<set _options["타락 천사 - 깃털 달린 케루브"] = ["fallenAngel", "cherub-fallenplus"]>>
		<<set _options["타락 천사 - 깃털 달린 형"] = ["fallenAngel", "fallenplus"]>>
		<<set _options["타락 천사 - 클래식 깃털 달린 형"] = ["fallenAngel", "classic-fallenplus"]>>
		<<if _fallen.wings is "cherub-fallenplus">>
			<<set _divineWingsChoice to _options["타락 천사 - 깃털 달린 케루브"]>>
		<<elseif _fallen.wings is "fallenplus">>
			<<set _divineWingsChoice to _options["타락 천사 - 깃털 달린 형"]>>
		<<elseif _fallen.wings is "classic-fallenplus">>
			<<set _divineWingsChoice to _options["타락 천사 - 클래식 깃털 달린 형"]>>
		<</if>>
	<</if>>
	<<if _wolfFullCheck and _angelFullCheck>>
		<<set _options["오카미"] = ["okami", "default"]>>
		<<if _okami.wings is "default">>
			<<set _divineWingsChoice to _options["오카미"]>>
		<</if>>
	<</if>>
	<<if _angelFullCheck and _birdFullCheck>>
		<<set _options["세라핌"] = ["seraphim", "default"]>>
		<<if _seraphim.wings is "default">>
			<<set _divineWingsChoice to _options["세라핌"]>>
		<</if>>
	<</if>>
	<<if !_divineWingsChoice>>
		<<set _divineWingsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>신성 날개:
			<div class="tf-divine-wings">
				<<listbox "_divineWingsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
				<<if _demonFullCheck>>
					<span class="small-description">악마 색상:</span> <<gencolourselector "$transformationParts.demon.wings_colour">>
				<</if>>
			</div>
		</label>
		<br>
	<</if>>

	/* Wings */
	<<set _options = {}>>
	<<set _options["없음"] = 0>>
	<<if _birdFullCheck>>
		<<set _options["새"] = ["bird", "default"]>>
		<<if _bird.wings is "default">>
			<<set _wingsChoice to _options["새"]>>
		<</if>>
	<</if>>
	<<if !_wingsChoice>>
		<<set _wingsChoice to 0>>
	<</if>>
	<<if Object.keys(_options).length > 1>>
		<label>날개:
			<div class="tf-wings">
				<<listbox "_wingsChoice" autoselect>>
					<<optionsfrom _options>>
				<</listbox>>
			</div>
		</label>
		<br>
	<</if>>

	/* Chimera */
	<span id="tf-chimera"><<renderTfChimera>></span>

	<br>
	<<if ($traumatized isnot undefined)>>
		__트라우마 눈__<br>
		<<link [[설정한다|$passage]]>><<set $traumaeyes to true>><<updatesidebarimg>><</link>> | <<link [[해제한다|$passage]]>><<set $traumaeyes to false>><<updatesidebarimg>><</link>><br>
		<br>
	<</if>>

	<div class="settingsToggleItemWide no-numberify">
		<span class="gold bold">레이어 조정:</span>
		<br>
		<<if !["demon", "cow", "waterdragon"].every(transform => T[transform].horns is "disabled")>>
			<<switch $hornslayer>>
				<<case "front">>
					<<link "뿔보다 머리 장식을 우선한다">>
						<<run State.setVar("$hornslayer", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "머리 장식보다 뿔을 우선한다">>
						<<run State.setVar("$hornslayer", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "머리 장식보다 뿔을 우선한다">>
						<<run State.setVar("$hornslayer", "front")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			<br>
		<</if>>
		<<if !["demon", "cat", "cow", "bear", "wolf", "bird", "fox", "bunny", "okami", "kitsune", "waterdragon"].every(transform => T[transform].tail is "disabled")>>
			<<switch $taillayer>>
				<<case "front">>
					<<link "꼬리를 뒤로 밀어넣는다">>
						<<run State.setVar("$taillayer", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "꼬리를 앞으로 빼낸다">>
						<<run State.setVar("$taillayer", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "꼬리를 뒤로 밀어넣는다">>
						<<run State.setVar("$taillayer", "back")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			<br>
		<</if>>
		<<if !["angel", "fallen", "demon", "bird", "okami", "seraphim"].every(transform => T[transform].wings is "disabled")>>
			<<switch $wingslayer>>
				<<case "front">>
					<<link "날개를 뒤로 젖힌다">>
						<<run State.setVar("$wingslayer", "back")>>
						<<run Engine.show()>>
					<</link>>
				<<case "back">>
					<<link "날개를 앞으로 빼낸다">>
						<<run State.setVar("$wingslayer", "front")>>
						<<run Engine.show()>>
					<</link>>
				<<default>>
					<<link "날개를 뒤로 젖힌다">>
						<<run State.setVar("$wingslayer", "back")>>
						<<run Engine.show()>>
					<</link>>
			<</switch>>
			<br>
		<</if>>
	</div>

	<<set _animalColourTfLabels to {
		wolf: "늑대",
		cat: "고양이",
		cow: "소",
		bird: "새",
		fox: "여우",
		bunny: "토끼",
		bear: "곰",
		waterdragon: "수룡"
	}>>
	<<set _animalColourPartLabels to {
		ears: "귀",
		tail: "꼬리",
		cheeks: "뺨 털",
		pits: "겨드랑이 털",
		pubes: "음모",
		horns: "뿔",
		wings: "날개",
		malar: "얼굴 깃털",
		plumage: "깃털과 털"
	}>>
	<<set _animalColourParts to []>>
	<<for _tf, _parts range Transformations.colourableAnimalParts>>
		<<for _part range _parts>>
			<<if Transformations.partActive(_tf, _part)>>
				<<set _colourPartLabel to _animalColourPartLabels[_part]>>
				<<if _tf is "bird" and _part is "pubes">>
					<<set _colourPartLabel to "음부 깃털">>
				<<elseif _tf is "bear" and _part is "plumage">>
					<<set _colourPartLabel to "몸 털">>
				<</if>>
				<<run _animalColourParts.push({
					label: _animalColourTfLabels[_tf] + " " + _colourPartLabel,
					target: "$transformationParts." + _tf + "." + _part + "_colour"
				})>>
			<</if>>
		<</for>>
	<</for>>

	<<if Transformations.chimeraActive("catsith") and $chimera?.catsith?.tail and Transformations.partActive("cat", "tail")>>
		<<if $transformationParts.catsith is undefined>>
			<<set $transformationParts.catsith to {}>>
		<</if>>
		<<run _animalColourParts.push({
			label: "캣시 무늬",
			target: "$transformationParts.catsith.pattern_colour"
		})>>
	<</if>>

	<<if _isMenuEnabled or _animalColourParts.length gt 0>>
		<details class="expandMenu tf-custom-colours">
			<summary class="expandMenu">변이 색상 사용자 지정</summary>
			<<if _animalColourParts.length gt 0>>
				<div class="colour-selector-list">
					<span class="small-description">동물 부위:</span><br>
					<<for _colourPart range _animalColourParts>>
						<label><<= _colourPart.label>>: <<gencolourselector _colourPart.target>></label><br>
					<</for>>
				</div>
			<</if>>
			<div class="menuWarning">
				색을 바꾸고 싶은 변이 부위의 체크박스를 선택하세요.
			</div>
			<div class="menuContent hidden">
				<<set _options to ['ffffff', 'ff0000', '00ff00', '0000ff', '590099', '000000']>>
				<<gencoloursquares _options>>
				<<gencolourpicker>>
				<br><<link "선택한 부위를 원래 색으로 되돌린다">><<run TransformationsInterface.clearSelectedColours()>><</link>>
			</div>
		</details>
	<</if>>

	<br>
	<<link "맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
	<br>
	/*
	<<link [[확인|$passage]]>>
		<<set $mirrorMenu to "transformation">>
		/* <<if _cat.heterochromia is "hidden">>
			<<catHeterochromiaTF "hide">>
		<<elseif $cat gte 7 and $cat lte 10>>
			<<catHeterochromiaTF `$cat - 7`>>
		<</if>>
	<</link>>
	*/
	<!-- Attach an event to every listbox item to update the PC on the sidebar. -->
	<<script>>
		jQuery('.passage').on('change', 'div.tf-claws select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<set $clawType = _clawChoice>>');
		});
		jQuery('.passage').on('change', 'div.tf-tempTolerance select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<set _traits.tempTolerance = _tempToleranceChoice>>');
		});
		jQuery('.passage').on('change', 'div.tf-misc select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearmisc>><<if _miscChoice isnot 0>><<set $transformationParts[_miscChoice[0]].misc = _miscChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-cheeks select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearcheeks>><<if _cheeksChoice isnot 0>><<set $transformationParts[_cheeksChoice[0]].cheeks = _cheeksChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-malar select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearmalar>><<if _malarChoice isnot 0>><<set $transformationParts[_malarChoice[0]].malar = _malarChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-pits select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearpits>><<if _pitsChoice isnot 0>><<set $transformationParts[_pitsChoice[0]].pits = _pitsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-plumage select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearplumage>><<if _plumageChoice isnot 0>><<set $transformationParts[_plumageChoice[0]].plumage = _plumageChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-pubes select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearpubes>><<if _pubesChoice isnot 0>><<set $transformationParts[_pubesChoice[0]].pubes = _pubesChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-ears select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearears>><<if _earsChoice isnot 0>><<set $transformationParts[_earsChoice[0]].ears = _earsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-eyes select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<cleareyes>><<if _eyesChoice isnot 0>><<set $transformationParts[_eyesChoice[0]].eyes = _eyesChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-halo select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearhalo>><<if _haloChoice isnot 0>><<set $transformationParts[_haloChoice[0]].halo = _haloChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-divine-horns select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<cleardivinehorns>><<if _divineHornsChoice isnot 0>><<set $transformationParts[_divineHornsChoice[0]].horns = _divineHornsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-horns select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearhorns>><<if _hornsChoice isnot 0>><<set $transformationParts[_hornsChoice[0]].horns = _hornsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-divine-tail select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<cleardivinetail>><<if _divineTailChoice isnot 0>><<set $transformationParts[_divineTailChoice[0]].tail = _divineTailChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-tail select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<cleartail>><<if _tailChoice isnot 0>><<set $transformationParts[_tailChoice[0]].tail = _tailChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-divine-wings select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<cleardivinewings>><<if _divineWingsChoice isnot 0>><<set $transformationParts[_divineWingsChoice[0]].wings = _divineWingsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-wings select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<clearwings>><<if _wingsChoice isnot 0>><<set $transformationParts[_wingsChoice[0]].wings = _wingsChoice[1]>><</if>>');
		});
		jQuery('.passage').on('change', 'div.tf-waterdragon-skin select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<set $waterdragonSkinLock to (_waterDragonSkinChoice is "none" ? "off" : _waterDragonSkinChoice)>><<syncWaterDragonSkin>>');
		});
		jQuery('.passage').on('change', 'div.tf-demon-skin select.macro-listbox', function (e) {
			Wikifier.wikifyEval('<<set $demonSkinLock to (_demonSkinChoice is "none" ? "off" : _demonSkinChoice)>><<syncDemonSkin>>');
		});
		jQuery('.passage').on('change', 'select.macro-listbox', function (e) {
			if (V.transformationParts.cat.heterochromia === "hidden") {
				Wikifier.wikifyEval('<<catHeterochromiaTF "hide">>');
			} else if (V.cat >= 7 && V.cat <= 10) {
				Wikifier.wikifyEval('<<catHeterochromiaTF `$cat - 7`>>')
			};
			Wikifier.wikifyEval('<<updatesidebarimg true>>');
			if (V.mirrorMenu == "transformation") {
				Wikifier.wikifyEval('<<replace #tf-chimera>><<renderTfChimera>><</replace>>');
			}
		});
	<</script>>
<</widget>>

<<widget "genomedump">>
	<<link "뒤로">><<set $mirrorMenu to "transformation">><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<br><br>
	<span class="red">경고: 지정한 변이의 발현 수치와 변이 수치가 초기화됩니다.
	<br><br>
	<i>변이를 완전히 마친 뒤에만 실행하는 것을 강력히 권장합니다.</i></span>
	<br><br>
	<<if $angelbuild gte 1>>
	천사 변이: <<link [[초기화한다|$passage]]>><<if $angeltf is 1>><<run $transformationHistory.pushUnique("genomeDump:angel")>><</if>><<angelTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $angeltf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $fallenangel gte 1>>
	타락 천사 변이: <<link [[초기화한다|$passage]]>><<fallenButNotOut 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $fallenangelplustf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $demonbuild gte 1>>
	악마 변이: <<link [[초기화한다|$passage]]>><<if $demontf is 1>><<run $transformationHistory.pushUnique("genomeDump:demon")>><</if>><<demonTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $demontf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $wolfbuild gte 1>>
	늑대 변이: <<link [[초기화한다|$passage]]>><<if $wolftf is 1>><<run $transformationHistory.pushUnique("genomeDump:wolf")>><</if>><<wolfTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $wolftf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $catbuild gte 1>>
	고양이 변이: <<link [[초기화한다|$passage]]>><<if $cattf is 1>><<run $transformationHistory.pushUnique("genomeDump:cat")>><</if>><<catTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $cattf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $cowbuild gte 1>>
	소 변이: <<link [[초기화한다|$passage]]>><<if $cowtf is 1>><<run $transformationHistory.pushUnique("genomeDump:cow")>><</if>><<cowTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $cowtf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $bearbuild gte 1>>
	곰 변이: <<link [[초기화한다|$passage]]>><<if $beartf is 1>><<run $transformationHistory.pushUnique("genomeDump:bear")>><</if>><<bearTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $beartf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $waterdragonbuild gte 1>>
	수룡 변이: <<link [[초기화한다|$passage]]>><<if $waterdragontf is 1>><<set $waterdragonCosmeticUnlocked to 1>><</if>><<waterdragonTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $waterdragontf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $birdbuild gte 1>>
	새 변이: <<link [[초기화한다|$passage]]>><<if $harpytf is 1>><<run $transformationHistory.pushUnique("genomeDump:harpy")>><</if>><<harpyTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $harpytf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $foxbuild gte 1>>
	여우 변이: <<link [[초기화한다|$passage]]>><<if $foxtf is 1>><<run $transformationHistory.pushUnique("genomeDump:fox")>><</if>><<foxTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $foxtf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
	<<if $bunnybuild gte 1>>
	바니 변이: <<link [[초기화한다|$passage]]>><<if $bunnytf is 1>><<run $transformationHistory.pushUnique("genomeDump:bunny")>><</if>><<bunnyTransform 99>><<set $tfDesc to { primary : "default" }>><<updatesidebarimg>><</link>><<if $bunnytf is 1>><span class="green">안전</span><<else>><span class="red">위험</span><</if>><br>
	<</if>>
<</widget>>


<<widget "renderTfChimera">>
	<<set _parts to $transformationParts>>
	<<if _parts is undefined>><<set _parts to {}>><</if>>

	<<set _demon to _parts.demon>><<if _demon is undefined>><<set _demon to {}>><</if>>
	<<set _cat to _parts.cat>><<if _cat is undefined>><<set _cat to {}>><</if>>
	<<set _cow to _parts.cow>><<if _cow is undefined>><<set _cow to {}>><</if>>
	<<set _waterdragon to _parts.waterdragon>><<if _waterdragon is undefined>><<set _waterdragon to {}>><</if>>
	<<set _wolf to _parts.wolf>><<if _wolf is undefined>><<set _wolf to {}>><</if>>
	<<set _fox to _parts.fox>><<if _fox is undefined>><<set _fox to {}>><</if>>
	<<set _angel to _parts.angel>><<if _angel is undefined>><<set _angel to {}>><</if>>
	<<set _fallen to _parts.fallenAngel>><<if _fallen is undefined>><<set _fallen to {}>><</if>>
	<<set _bird to _parts.bird>><<if _bird is undefined>><<set _bird to {}>><</if>>

	<<set _hiddenParts to ["disabled", "hidden"]>>
	<<set _demonPresent to ["horns", "tail", "wings"].some(p => _demon[p] isnot undefined and !_hiddenParts.includesAny(_demon[p]))>>
	<<set _angelPresent to ["halo", "wings"].some(p => _angel[p] isnot undefined and !_hiddenParts.includesAny(_angel[p]))>>
	<<set _waterDragonPresent to ["horns", "ears", "tail"].some(p => _waterdragon[p] isnot undefined and !_hiddenParts.includesAny(_waterdragon[p]))>>
	<<set _birdPresent to (_bird.wings isnot undefined and !_hiddenParts.includesAny(_bird.wings))>>
	<<set _demoncatTail to (_demon.tail isnot undefined and _cat.tail isnot undefined and !_hiddenParts.includesAny(_demon.tail, _cat.tail))>>
	<<set _fallenPresent to ["halo", "wings"].some(p => _fallen[p] isnot undefined and !_hiddenParts.includesAny(_fallen[p]))>>
	<<set _catsithEars to (_cat.ears isnot undefined and !_hiddenParts.includesAny(_cat.ears) and _fallenPresent)>>
	<<set _catsithTail to (_cat.tail isnot undefined and !_hiddenParts.includesAny(_cat.tail) and _fallenPresent)>>
	<<set _demoncowTail to (_demon.tail isnot undefined and _cow.tail isnot undefined and !_hiddenParts.includesAny(_demon.tail, _cow.tail))>>
	<<set _demonwolfTail to (_demon.tail isnot undefined and _wolf.tail isnot undefined and !_hiddenParts.includesAny(_demon.tail, _wolf.tail))>>
	<<set _demonfoxTail to (_demon.tail isnot undefined and _fox.tail isnot undefined and !_hiddenParts.includesAny(_demon.tail, _fox.tail))>>
	<<set _demonfoxEars to (_fox.ears isnot undefined and !_hiddenParts.includesAny(_fox.ears) and effectiveTransformationLevel("demon") gte 6)>>
	<<set _demoncowHorns to (_demon.horns isnot undefined and _cow.horns isnot undefined and !_hiddenParts.includesAny(_demon.horns, _cow.horns))>>
	<<set _demonharpyWings to (_demon.wings isnot undefined and _bird.wings isnot undefined and !_hiddenParts.includesAny(_demon.wings, _bird.wings))>>
	<<set _angelharpyWings to (_angel.wings isnot undefined and _bird.wings isnot undefined and !_hiddenParts.includesAny(_angel.wings, _bird.wings))>>
	<<set _fallenharpyWings to (_fallen.wings isnot undefined and _bird.wings isnot undefined and !_hiddenParts.includesAny(_fallen.wings, _bird.wings))>>
	<<set _bakunawaTail to (_demon.tail isnot undefined and _waterdragon.tail isnot undefined and !_hiddenParts.includesAny(_demon.tail, _waterdragon.tail))>>
	<<set _bakunawaHorns to (_demon.horns isnot undefined and _waterdragon.horns isnot undefined and !_hiddenParts.includesAny(_demon.horns, _waterdragon.horns))>>
	<<set _bakunawaEars to (_waterdragon.ears isnot undefined and !_hiddenParts.includesAny(_waterdragon.ears) and _demonPresent)>>
	<<set _ryuujinTail to (_waterdragon.tail isnot undefined and !_hiddenParts.includesAny(_waterdragon.tail) and _angelPresent)>>
	<<set _ryuujinHorns to (_waterdragon.horns isnot undefined and !_hiddenParts.includesAny(_waterdragon.horns) and _angelPresent)>>
	<<set _ryuujinHalo to (_angel.halo isnot undefined and !_hiddenParts.includesAny(_angel.halo) and _waterDragonPresent)>>
	<<set _melusineEars to (_waterdragon.ears isnot undefined and !_hiddenParts.includesAny(_waterdragon.ears) and _angelPresent and _birdPresent)>>
	<<set _melusineHorns to (_waterdragon.horns isnot undefined and !_hiddenParts.includesAny(_waterdragon.horns) and _angelPresent and _birdPresent)>>
	<<set _melusineTail to (_waterdragon.tail isnot undefined and !_hiddenParts.includesAny(_waterdragon.tail) and _angelPresent and _birdPresent)>>
	<<set _melusineHalo to (_angel.halo isnot undefined and !_hiddenParts.includesAny(_angel.halo) and _waterDragonPresent and _birdPresent)>>
	<<set _melusineWings to (_bird.wings isnot undefined and !_hiddenParts.includesAny(_bird.wings) and _angelPresent and _waterDragonPresent)>>
	<<set _chimeraEnabled to " hide">>
	<<if _demoncatTail or _catsithEars or _catsithTail or _demoncowHorns or _demoncowTail or _demonwolfTail or _demonfoxTail or _demonfoxEars or _demonharpyWings or _angelharpyWings or _fallenharpyWings or _bakunawaTail or _bakunawaHorns or _bakunawaEars or _ryuujinTail or _ryuujinHorns or _ryuujinHalo or _melusineEars or _melusineHorns or _melusineTail or _melusineHalo or _melusineWings>>
		<<set _chimeraEnabled to "">>
	<</if>>

	<div class="chimera<<=_chimeraEnabled>>">
		<span class="gold bold">키메라</span><br>
		<<if _demoncatTail>>
			/* Using kasha (cat + demon) chimera tail. */
			<label>카샤 꼬리:
				<<listbox "$chimera.demoncat.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _catsithEars>>
			/* Cat sith ears. Hiding these keeps the plain cat ears; it does not stop you being a cat sith. */
			<label>캣시 귀:
				<<listbox "$chimera.catsith.ears" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _catsithTail>>
			/* As above: art only. */
			<label>캣시 꼬리:
				<<listbox "$chimera.catsith.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demoncowHorns>>
			<label>악마 소 뿔:
				<<listbox "$chimera.demoncow.horns" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demoncowTail>>
			/* Using demon cow chimera tail. */
			<label>악마 소 꼬리:
				<<listbox "$chimera.demoncow.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demonwolfTail>>
			/* Using demon wolf chimera tail. */
			<label>악마 늑대 꼬리:
				<<listbox "$chimera.demonwolf.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demonfoxTail>>
			/* Using demon fox chimera tail. */
			<label>악마 여우 꼬리:
				<<listbox "$chimera.demonfox.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demonfoxEars>>
			/* Using demon fox chimera ears. */
			<label>악마 여우 귀:
				<<listbox "$chimera.demonfox.ears" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _demonharpyWings>>
			/* Using demon harpy chimera wings. */
			<label>악마 하피 날개:
				<<listbox "$chimera.demonharpy.wings" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _angelharpyWings>>
			/* Using angel harpy chimera wings. */
			<label>천사 하피 날개:
				<<listbox "$chimera.angelharpy.wings" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _fallenharpyWings>>
			/* Using fallen angel harpy chimera wings. */
			<label>타락 천사 하피 날개:
				<<listbox "$chimera.fallenharpy.wings" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _bakunawaTail>>
			/* Using Bakunawa (water dragon + demon) chimera tail. */
			<label>바쿠나와 꼬리:
				<<listbox "$chimera.bakunawa.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _bakunawaHorns>>
			/* Using Bakunawa (water dragon + demon) chimera horns. */
			<label>바쿠나와 뿔:
				<<listbox "$chimera.bakunawa.horns" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _bakunawaEars>>
			/* Using Bakunawa (water dragon + demon) chimera ears. */
			<label>바쿠나와 귀:
				<<listbox "$chimera.bakunawa.ears" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _ryuujinTail>>
			/* Using Ryuujin (water dragon + angel) chimera tail. */
			<label>류진 꼬리:
				<<listbox "$chimera.ryuujin.tail" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _ryuujinHorns>>
			/* Using Ryuujin (water dragon + angel) chimera horns. */
			<label>류진 뿔:
				<<listbox "$chimera.ryuujin.horns" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _ryuujinHalo>>
			/* Using Ryuujin (water dragon + angel) chimera halo. */
			<label>류진 헤일로:
				<<listbox "$chimera.ryuujin.halo" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _melusineEars>>
			/* Using Melusine (water dragon + angel + harpy) chimera ears. */
			<label>멜루신 귀:
				<<listbox "$chimera.melusine.ears" autoselect>>
					<<option "기본" "default">>
					<<option "보라색" "purple">>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _melusineHalo>>
			/* Using Melusine (water dragon + angel + harpy) chimera halo. */
			<label>멜루신 헤일로:
				<<listbox "$chimera.melusine.halo" autoselect>>
					<<option "기본" "default">>
					<<option "보라색" "purple">>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _melusineHorns>>
			/* Using Melusine (water dragon + angel + harpy) chimera horns. */
			<label>멜루신 뿔:
				<<listbox "$chimera.melusine.horns" autoselect>>
					<<option "기본" "default">>
					<<option "보라색" "purple">>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _melusineTail>>
			/* Using Melusine (water dragon + angel + harpy) chimera tail. */
			<label>멜루신 꼬리:
				<<listbox "$chimera.melusine.tail" autoselect>>
					<<option "기본" "default">>
					<<option "보라색" "purple">>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
		<<if _melusineWings>>
			/* Using Melusine (water dragon + angel + harpy) chimera wings.
			   Show/Hide only - the wings have no purple colourway art, unlike the other four pieces. */
			<label>멜루신 날개:
				<<listbox "$chimera.melusine.wings" autoselect>>
					<<option "표시" true>>
					<<option "숨김" false>>
				<</listbox>>
			</label>
			<br>
		<</if>>
	</div>
<</widget>>

<<widget "tfDescValidList">>
	/* Single source of truth for the Description chooser.
	   _present = actual body/visible-limb state for automatic descriptions.
	   _descOption = unlocked/allowed manual mirror choices. */
	<<set _baseTfPresent to (level, required, transformation, parts) => level gte required or parts.some(part => Transformations.partActive(transformation, part))>>

	<<set _present to {}>>
	<<set _present.demon to _baseTfPresent($demon, 6, "demon", ["horns", "tail", "wings"])>>
	<<set _present.angel to _baseTfPresent($angel, 6, "angel", ["halo", "wings"])>>
	<<set _present.fallen to _baseTfPresent($fallenangel, 2, "fallenAngel", ["halo", "wings"])>>
	<<set _present.wolf to _baseTfPresent($wolfgirl, 6, "wolf", ["tail"])>>
	<<set _present.cat to _baseTfPresent($cat, 6, "cat", ["tail"])>>
	<<set _present.cow to _baseTfPresent($cow, 6, "cow", ["tail"])>>
	<<set _present.harpy to _baseTfPresent($harpy, 6, "bird", ["wings"])>>
	<<set _present.fox to _baseTfPresent($fox, 6, "fox", ["tail"])>>
	<<set _present.bunny to _baseTfPresent($bunny, 6, "bunny", ["tail"])>>
	<<set _present.bear to _baseTfPresent($bear, 6, "bear", ["tail"])>>
	<<set _present.waterdragon to _baseTfPresent($waterdragon, 7, "waterdragon", ["horns", "ears", "tail"])>>
	<<set _present.okami to Transformations.chimeraActive("okami")>>
	<<set _present.kitsune to Transformations.chimeraActive("kitsune")>>
	<<set _present.seraphim to Transformations.chimeraActive("seraphim")>>
	<<set _present.bakunawa to Transformations.chimeraActive("bakunawa")>>
	<<set _present.ryuujin to Transformations.chimeraActive("ryuujin")>>
	<<set _present.melusine to Transformations.chimeraActive("melusine")>>
	<<set _present.kasha to Transformations.chimeraActive("kasha")>>
	<<set _present.catsith to Transformations.chimeraActive("catsith")>>

	/* Manual Description options may remain available from permanent unlock flags.
	   Automatic description uses _present only, so Genome Dump + hidden/disabled limbs reads as human on Default. */
	<<set _descOption to {}>>
	<<set _descOption.demon to (_present.demon or $demontf is 1)>>
	<<set _descOption.angel to (_present.angel or $angeltf is 1)>>
	<<set _descOption.fallen to (_present.fallen or $fallenangeltf is 1 or $fallenangelplustf is 1)>>
	<<set _descOption.wolf to (_present.wolf or $wolftf is 1)>>
	<<set _descOption.cat to (_present.cat or $cattf is 1)>>
	<<set _descOption.cow to (_present.cow or $cowtf is 1)>>
	<<set _descOption.harpy to (_present.harpy or $harpytf is 1)>>
	<<set _descOption.fox to (_present.fox or $foxtf is 1)>>
	<<set _descOption.bunny to (_present.bunny or $bunnytf is 1)>>
	<<set _descOption.bear to (_present.bear or $beartf is 1)>>
	<<set _descOption.waterdragon to (_present.waterdragon or $waterdragontf is 1 or $waterdragonCosmeticUnlocked is 1)>>
	<<set _descOption.okami to (_present.okami or (_descOption.wolf and _descOption.angel))>>
	<<set _descOption.kitsune to (_present.kitsune or (_descOption.fox and _descOption.angel))>>
	<<set _descOption.seraphim to (_present.seraphim or (_descOption.harpy and _descOption.angel))>>
	<<set _descOption.bakunawa to (_present.bakunawa or (_descOption.waterdragon and _descOption.demon))>>
	<<set _descOption.ryuujin to (_present.ryuujin or (_descOption.waterdragon and _descOption.angel))>>
	<<set _descOption.melusine to (_present.melusine or (_descOption.waterdragon and _descOption.angel and _descOption.harpy))>>
	<<set _descOption.kasha to (_present.kasha or (_descOption.cat and _descOption.demon))>>
	<<set _descOption.catsith to (_present.catsith or (_descOption.cat and _descOption.fallen))>>

	<<set _animalIds to ["wolf", "cat", "cow", "harpy", "fox", "bunny", "bear", "waterdragon"]>>
	<<set _nonAnimalIds to ["angel", "fallen", "demon"]>>
	<<set _animalN to _animalIds.filter(id => _present[id]).length>>
	<<set _nonAnimalN to _nonAnimalIds.filter(id => _present[id]).length>>
	<<set _present.xenos to (_animalN gte 1 and _nonAnimalN gte 1 and (_animalN + _nonAnimalN) gte 3)>>

	/* Same xenos rule, but for manual options/unlocks. */
	<<set _optionAnimalN to _animalIds.filter(id => _descOption[id]).length>>
	<<set _optionNonAnimalN to _nonAnimalIds.filter(id => _descOption[id]).length>>
	<<set _descOption.xenos to (_optionAnimalN gte 1 and _optionNonAnimalN gte 1 and (_optionAnimalN + _optionNonAnimalN) gte 3)>>

	<<set $tfDescValid to ["demon", "angel", "fallen", "cat", "cow", "bear", "waterdragon", "wolf", "harpy", "fox", "bunny", "okami", "kitsune", "seraphim", "bakunawa", "ryuujin", "melusine", "kasha", "catsith", "xenos"].filter(id => _descOption[id])>>

	/* Special named chimeras: their name already implies the celestial half, so no adjective and a single entry each (hellhound covers wolf + demon OR fallen). */
	<<if _descOption.wolf and (_descOption.demon or _descOption.fallen)>><<run $tfDescValid.push("hellhound")>><</if>>
	<<if _descOption.wolf and _descOption.angel>><<run $tfDescValid.push("dog")>><</if>>
	<<if _descOption.bunny and _descOption.demon>><<run $tfDescValid.push("jackalope")>><</if>>
	<<if _descOption.bunny and _descOption.angel>><<run $tfDescValid.push("moonrabbit")>><</if>>

	/* Generic animal + celestial blends (e.g. demonic cat, fallen fox).
	Wolf is excluded (always hellhound/dog); bunny only takes "fallen bunny" since demon/angel are the special names above. */
	<<set _comboCelestialIds to ["demon", "fallen", "angel"]>>
	<<set _genericComboAnimals to ["cat", "cow", "harpy", "fox", "bear", "waterdragon"]>>
	<<for _comboAnimal range _genericComboAnimals>>
		<<if _descOption[_comboAnimal]>>
			<<for _comboCelestial range _comboCelestialIds>>
				<<if _descOption[_comboCelestial]>>
					<<run $tfDescValid.push(_comboAnimal + "+" + _comboCelestial)>>
				<</if>>
			<</for>>
		<</if>>
	<</for>>
	<<if _descOption.bunny and _descOption.fallen>><<run $tfDescValid.push("bunny+fallen")>><</if>>

	/* Self-heal: if the saved choice is no longer valid, revert to automatic. */
	<<if $tfDesc is undefined>><<set $tfDesc to {}>><</if>>
	<<if $tfDesc.primary is undefined>><<set $tfDesc.primary to "default">><</if>>
	<<if $tfDesc.primary isnot "default" and !$tfDescValid.includes($tfDesc.primary)>>
		<<set $tfDesc.primary to "default">>
	<</if>>
<</widget>>
