<<widget "initnpcskin">>
	<<for _i to 0; _i lt $NPCName.length; _i++>>
		<<initnpcskinsingle _i _args[0]>>
	<</for>>
<</widget>>

<<widget "initnpcskinsingle">>
	<<set _i to _args[0]>>
	<<if $NPCName[_i].skincolour is undefined or $NPCName[_i].skincolour is "none" or _args[1] is "skincolour">>
		<<set $NPCName[_i].skincolour to randomSkinTone()>>
	<</if>>
<</widget>>

<<widget "initNPCBaseMaxOrgasm">>
    <<for _i to 0; _i lt $NPCName.length; _i++>>
        <<initNPCBaseMaxOrgasmSingle _i _args[0]>>
    <</for>>
<</widget>>

<<widget "initNPCBaseMaxOrgasmSingle">>
    <<set _i to _args[0]>>
	<<if !$NPCName[_i].maxOrgasms or $NPCName[_i].maxOrgasms is 0 or _args[1] is "base max orgasms">>
    	<<set $NPCName[_i].maxOrgasms to random(1, 5)>>
	<</if>>
<</widget>>

<<widget "initnpcgender">>
	<<for _i to 0; _i lt $NPCName.length; _i++>>
		<<initnpcgendersingle _i _args[0]>>
	<</for>>
<</widget>>

<<widget "initnpcgendersingle">>
	<<set _i to _args[0]>>

	<!-- Set Pronoun -->
	<<if !$NPCName[_i].pronoun or $NPCName[_i].pronoun is "none" or _args[1] is "genders">>
		<<if $passage is "Start">>
			<<if $player.sex is "m">>
				<<set _override to "m">>
			<<else>> <!-- if $player.sex is "f" -->
				<<set _override to "f">>
			<</if>>
			<<if $background.crossdresser is true>>
				<<set _override to (_override is "m" ? "f" : "m")>>
			<</if>>
		<</if>>
		<<if maleChance(_override) lt random(1, 100)>>
			<<set $NPCName[_i].pronoun to "f">>
		<<else>>
			<<set $NPCName[_i].pronoun to "m">>
		<</if>>
	<</if>>
	<!-- Set Gender -->
	<<if getActivePregnancy($NPCName[_i].nam, "vagina")>>
		<<if $NPCName[_i].gender isnot "h">>
			<<set $NPCName[_i].gender to "f">>
		<</if>>
	<<elseif !$NPCName[_i].gender or $NPCName[_i].gender is "none" or _args[1] is "genders">>
		<<if $NPCName[_i].pronoun is "m">>
			<<if random(0, 99) gte $settings.maleNPCVaginaChance>>
				<<set $NPCName[_i].gender to "m">>
			<<else>>
				<<set $NPCName[_i].gender to "f">>
			<</if>>
		<<elseif $NPCName[_i].pronoun is "f">>
			<<if random(0, 99) gte $settings.femaleNPCPenisChance>>
				<<set $NPCName[_i].gender to "f">>
			<<else>>
				<<set $NPCName[_i].gender to "m">>
			<</if>>
		<</if>>
	<</if>>
	<<if $NPCName[_i].nam is "Ivory Wraith">>
		<<set $NPCName[_i].pronoun to "i">>
	<</if>>

	<!-- Set Genital Existence -->
	<<if $NPCName[_i].type isnot "human">>
		<<set $NPCName[_i].penis to ($NPCName[_i].gender !== "f" ? 0 : "none")>>
		<<set $NPCName[_i].vagina to ($NPCName[_i].gender !== "m" ? 0 : "none")>>
	<<else>>
		<<set $NPCName[_i].penis to ($NPCName[_i].gender !== "f" ? "clothed" : "none")>>
		<<set $NPCName[_i].vagina to ($NPCName[_i].gender !== "m" ? "clothed" : "none")>>
	<</if>>

	<!-- Set breast defaults-->

	<<set _b_mod_lower to Math.clamp($settings.breastModifier, 0, 12)>>
	<<set _b_mod_upper to Math.clamp($settings.breastModifier + 12, 0, 12)>>

	<!-- can't use breastsize, since that would either break the numberslider
	or make one of the sizes always be randomised,
	but can use breastdesc not being changed from 0 as a substitute -->
	<<if $NPCName[_i].breastdesc is 0 or _args[1] is "breasts">>
		<<if $NPCName[_i].pronoun is "m">>
			<<set $NPCName[_i].breastsize to 0>>
		<<else>>
			<<set $NPCName[_i].breastsize to random(_b_mod_lower, _b_mod_upper)>>
		<</if>>
	<</if>>
	<<if $NPCName[_i].breastsize gt 0>>
		<<set _brdes to ["nipple","budding","tiny","small","pert","modest","full","large","ample","massive","huge","gigantic","enormous"]>>
		<<set $NPCName[_i].breastdesc to _brdes[$NPCName[_i].breastsize]+" breast">>
	<<else>>
		<<set $NPCName[_i].breastdesc to "nipple">>
	<</if>>
	<<set $NPCName[_i].breastsdesc to $NPCName[_i].breastdesc + "s">>

	<!-- Set pp to defaults-->

	/* New way to set upper and lower bounds.
	* This method makes use of all other slider positions, but does nothing when slider is between -1 and 1,
	* for a total of 15 unique positions vs the current method's 9. (max would be 17)
	* Changing the penis_mod slider to range from -7 to 7 would work to make every slider position unique here, but potentially affects unnamed npc generation.
	*/

	/*
	<<set _p_mod_upper to 8>><<set _p_mod_lower to 1>>
	<<if $settings.penisModifier gt 0>>
		<<set _p_mod_lower += $settings.penisModifier - 1>>
	<<elseif $settings.penisModifier lt 0>>
		<<set _p_mod_upper += $settings.penisModifier + 1>>
	<</if>>

	alternative way to write that:
	<<set _p_mod_lower to ($settings.penisModifier > 0 ? $settings.penisModifier : 1)>>
	<<set _p_mod_upper to ($settings.penisModifier < 0 ? 9 + $settings.penisModifier : 8)>>
	*/

	<<if $settings.penisModifier is 8>>/*Clumsy way to get average penis size setting working for NNPCs.*/
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 8>>
	<<elseif $settings.penisModifier gte 6>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 7>>
	<<elseif $settings.penisModifier gte 4>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 5>>
	<<elseif $settings.penisModifier gte 2>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 3>>
	<<elseif $settings.penisModifier gte 0>>
		<<set _p_mod_upper to 8>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -2>>
		<<set _p_mod_upper to 7>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -4>>
		<<set _p_mod_upper to 5>><<set _p_mod_lower to 1>>
	<<elseif $settings.penisModifier gte -6>>
		<<set _p_mod_upper to 3>><<set _p_mod_lower to 1>>
	<<else>>
		<<set _p_mod_upper to 1>><<set _p_mod_lower to 1>>
	<</if>>

	<<if $NPCName[_i].penissize is 0 or _args[1] is "penis">>
		<<if $NPCName[_i].gender is "f">>
			<<set $NPCName[_i].penissize to 0>>
			<<set $NPCName[_i].penisdesc to "none">>
		<<else>>
			<<switch random(_p_mod_lower, _p_mod_upper)>>
			<<case 8>>
				<<set $NPCName[_i].penisdesc to either("massive cock","huge cock","humongous cock","immense cock","gigantic cock","enormous cock")>>
				<<set $NPCName[_i].penissize to 4>>
			<<case 5 6 7>>
				<<set $NPCName[_i].penisdesc to either("thick cock","hefty cock","big cock","large cock","veiny cock","meaty cock")>>
				<<set $NPCName[_i].penissize to 3>>
			<<case 2 3 4>>
				<<set $NPCName[_i].penisdesc to "penis">>
				<<set $NPCName[_i].penissize to 2>>
			<<default>>
				<<set $NPCName[_i].penisdesc to either("tiny penis","pathetic cock","little penis","small penis","mini penis","micro penis")>>
				<<set $NPCName[_i].penissize to 1>>
			<</switch>>
		<</if>>
	<</if>>
	<!-- Set pp to size in case PC selected it-->
	<<if $NPCName[_i].penissize isnot 0>>
		<<switch $NPCName[_i].penissize>>
		<<case 5>>
			<<set $NPCName[_i].penisdesc to either("colossal cock","monstrous cock","towering cock","titanic cock","immense cock","gigantic cock")>>
		<<case 4>>
			<<set $NPCName[_i].penisdesc to either("massive cock","huge cock","humongous cock","immense cock","gigantic cock","enormous cock")>>
		<<case 3>>
			<<set $NPCName[_i].penisdesc to either("thick cock","hefty cock","big cock","large cock","veiny cock","meaty cock")>>
		<<case 1>>
			<<set $NPCName[_i].penisdesc to either("tiny penis","pathetic cock","little penis","small penis","mini penis","micro penis")>>
		<<default>>
			<<set $NPCName[_i].penisdesc to "penis">>
		<</switch>>
	<</if>>

	<<switch $NPCName[_i].nam>>
		<<case "Jordan">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "사제" : "사제")>>
		<<case "Leighton">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "교장" : "교장")>>
		<<case "Eden">> <<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "사냥꾼" : "사냥꾼")>>
		<<case "Avery">> <<if $avery_fate isnot "ascended">><<set $NPCName[_i].title to ($NPCName[_i].pronoun is "m" ? "사업가" : "사업가")>><</if>>
	<</switch>>

	<<generatePronouns $NPCName[_i]>>
<</widget>>

<<widget "initnpc">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<if $NPCName[_i].init is 0>> <!-- This prevents double-init from wiping variables -->
		<<set $NPCName[_i].init to 1>>

		<<set $NPCName[_i].trust to 0>>
		<<set $NPCName[_i].love to 0>>
		<<set $NPCName[_i].dom to 0>>
		<<set $NPCName[_i].lust to 0>>
		<<set $NPCName[_i].trauma to 0>>
		<<set $NPCName[_i].rage to 0>>
		<<set $NPCName[_i].state to "active">>
		<<set $NPCName[_i].purity to 0>>
		<<set $NPCName[_i].corruption to 0>>
		<<set $NPCName[_i].chastity to {penis:"", vagina:"", anus:""}>>
		<<set $NPCName[_i].name_known to 1>>
		<<if $NPCName[_i].skincolour is undefined>>
			<<set $NPCName[_i].skincolour to randomSkinTone()>>
		<</if>>
		<<generatePronouns $NPCName[_i]>>
		<<initNNPCClothes _nam>>
		<<initNNPCstrapon $NPCName[_i]>>

		/* initnpc doesn't modify $NPCList or do anything <<personselect>> does, but we still want to use pronoun-based widgets for intro text */
		<<set _lastPronoun to $pronoun>>
		<<set $pronoun to $NPCName[_i].pronoun>>

		<!-- Special Cases NNPC Variables, Introductions, Adjustments -->
		<<switch _nam>>
			<<case Kylar>>
				<<set C.npc.Kylar.state to 0>>
			<<case Robin>>
				<<set $robinSeen to []>>
				<<set $NPCName[_i].cdquest to 0>>
			<<case River>>
				//리버는 지역 학교에서 수학과 가사 실습을 가르친다. <<His>> <<if $pronoun is "m">>짧은<<else>>긴<</if>> 갈색 머리에는 회색이 섞여 있고, <<his>> 날카로운 파란 눈동자는 주변을 훑어본다. 학생들은 보통 리버의 수업 시간에 얌전한 편이다.//<br><br>
			<<case Leighton>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "교장" : "교장">>
				//레이튼은 지역 학교의 교장<<master>>이다. <<He>>【은는】 녹색 눈을 가졌고 <<if $pronoun is "m">>단정하게 관리된 회색이 섞인 검은 머리를 갖고<<else>>회색이 섞인 검은 머리를 뒤로 묶어 올리고<</if>> 있다. 키가 크고 위엄이 있으며, 학교 학생들에게 단호한 태도를 취한다.//<br><br>
			<<case Mason>>
				//메이슨은 지역 학교의 수영 교사이다. <<Hes>> 가장 젊은 교사이며, 학생들보다 겨우 몇 살 많을 뿐이다. <<His>> 탄탄한 몸은 수업 중에 자연스럽게 드러나지만, 누군가 자신을 훑어보는 것을 눈치채더라도 메이슨은 내색하지 않는다.//
				<<set $NPCName[_i].chastityKeyCarried to 0>> /* Mason is carrying the key to unlock Winter's Chastity belt. 1 is carried, 2 player knows it is carried */
				<<set $NPCName[_i].chastityRemoved to 0>> /* Number of chastity devices Mason has removed */
				<<set $NPCName[_i].chastityRemovalDeclined to 0>> /* Whether you've declined Mason's offer to remove it (prompts more passive checking). Resets when a device is removed */
			<<case Winter>>
				//윈터는 지역 학교에서 역사를 가르친다. <<Hes>> 나이가 지긋한 <<gentleman_npc>>이며, 깔끔하고 세련된 모습이다.//<br><br>
			<<case Doren>>
				//도렌은 지역 학교에서 영어를 가르친다. <<His>> 덥수룩한 붉은 머리<<if $pronoun is "m">>【와과】 턱수염<</if>>【은는】 사나운 인상을 강조한다.//<br><br>
				<<set $dorenSeen to []>>
			<<case Sirris>>
				//시리스는 지역 학교에서 과학을 가르친다. <<Hes>> 침착하고 인내심이 많아서, 때때로 교실이 어수선해지기도 한다.//<br><br>
			<<case Eden>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "사냥꾼" : "사냥">>
				<<set $NPCName[_i].name_known to 0>>
				<<set $edenSeen to []>>
			<<case Avery>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "비지니스맨" : "비지니스우먼">>
				<<if $averySeen is undefined>>
					<<set $averySeen to []>>
				<</if>>
				<<if $averyRejected is undefined>>
					<<set $averyRejected to {}>>
					<<set $weekly.averyRejected to {}>>
				<</if>>
			<<case Jordan>>
				<<set $NPCName[_i].title to $pronoun is "m" ? "사제" : "사제">>
			<<case Bailey>>
				<<set C.npc.Bailey.dom to 50>>
			<<case Whitney>>
				<<set C.npc.Whitney.dom to 10>>
				<<set $whitneySeen to []>>
				<<set V.whitney to {}>>
				<<set V.whitney.daysSinceCapture to 0>>
			<<case "Great Hawk">>
				<<set C.npc["Great Hawk"].dom to 50>>
			<<case Sydney>>
				<<set $NPCName[_i].purity to 100>>
				<<set $NPCName[_i].chastity to {penis:"chastity belt", vagina:"chastity belt", anus:"anal shield"}>>
				<<set $sydneySeen to []>>
				<<set $sydneyFirstSeen to "">>
				<<set $sydney to {
					glasses: "glasses",
					hair: "ponytail",
					swim: "school",
					sexTotal: 0,
					rank: "initiate",
				}>>
			<<case Alex>>
				<<set $alexSeen to []>>
			<<case "Ivory Wraith">>
				<<checkWraith>>
				<<set $genderknown.pushUnique("Ivory Wraith")>>
				<<set C.npc["Ivory Wraith"].lust to 0>>
				<<if $wraith.state is "haunt">>
					<<set C.npc["Ivory Wraith"].lust to 20>>
					<<if $wraithPrison?.vision>>
						<<set C.npc["Ivory Wraith"].lust -= 5>>
					<</if>>
				<</if>>
				<<set C.npc["Ivory Wraith"].skinType to "ghost">>
			<<case Remy>>
				<<if $remySeen is undefined>>
					<<set $remySeen to []>>
				<</if>>
			<<case Harper>>
				<<if $harperSeen is undefined>>
					<<set $harperSeen to []>>
				<</if>>
			<<case Wren>>
				<<if $wrenSeen is undefined>>
					<<set $wrenSeen to []>>
				<</if>>
			<<case Niki>>
				<<if $nikiSeen is undefined>>
					<<set $nikiSeen to []>>
				<</if>>
			<<case Poppy>>
				<<if $poppySeen is undefined>>
					<<set $poppySeen to []>>
				<<elseif !Array.isArray($poppySeen)>>
					<<set $poppySeen_legacy to $poppySeen>> 
					<<run console.warn("[Poppy migration] $poppySeen was not an array; moved to $poppySeen_legacy:", V.poppySeen)>>
					<<set $poppySeen to []>>
				<</if>>
				<<if $NPCName[_i].patience is undefined>>
					<<set $NPCName[_i].patience to 100>>
				<</if>>
				<<if $daily.poppy is undefined>>
					<<set $daily.poppy to {}>>
				<</if>>
				<!-- keeps intent explicit; JS also handles undefined safely -->
				<<if $poppyromance is undefined>>
					<<set $poppyromance to -1>>
				<</if>>
			<<case Gwylan>>
				<<set $gwylanSeen to []>>
				<<set $gwylanTalked to []>>
				<<set $gwylan to {
					progress: 0,
					stage: 0,
					sea: 0,
					wary: 0,
					robin: 0,
					purged: 0,
					timer: {},
					request: {},
					requestCount: 0,
					requestDone: false,
				}>>
				<<set $gwylan.timer.lastSeen to Time.date.timeStamp>>
			<<case Sam>>
				<<if $samSeen is undefined>>
					<<set $samSeen to []>>
				<</if>>
			<<default>>
		<</switch>>

		/* Restore $pronoun to its original state, to avoid side effects */
		<<set $pronoun to _lastPronoun>>
	<</if>>
<</widget>>

<<widget "initNNPCClothes">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_generation to (_args[1] ? _args[1] : "none")>>
	<<if !$NPCName[_i].outfits or $_generation is "reset" or $_generation is "update">>
		<<if $_generation isnot "update">>
			<<set $NPCName[_i].outfits to ["naked", "maleDefault", "femaleDefault"]>>
		<</if>>
		<<switch _nam>>
			<<case Poppy>>
				<<set $NPCName[_i].outfits.pushUnique(
					"poppyLatexF",
					"poppyTownM"
				)>>
			<<case Kylar>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchool", "femaleSchool",
					"maleSchoolSwim", "femaleSchoolSwim",
					"maleTown1", "femaleTown1", "maleWarm1", "femaleWarm1", "coldHoodie"
				)>>
			<<case Robin>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchool", "femaleSchool", "maleSchoolLong", "femaleSchoolLong",
					"maleSchoolSwimShirt", "femaleSchoolSwim",
					"maleTown1", "femaleTown1", "maleWarm1", "femaleWarm1", "coldPuffer", "pyjamas"
				)>>
			<<case Whitney>>
				<<set $NPCName[_i].outfits.pushUnique(
					"Whitney", "maleSchoolBlazer", "femaleSchoolBlazer",
					"maleSchoolSwim", "femaleSchoolSwim", "coldHoodie"
				)>>
			<<case Sydney>>
				<<set $NPCName[_i].outfits.pushUnique(
					"maleSchoolLong", "femaleSchoolLong",
					"maleSchoolSwimShirt", "femaleSchoolSwim",
					"neutralRobe", "coldTrench"
				)>>
			<<case Gwylan>>
				<<set $NPCName[_i].outfits.pushUnique(
					"gwylanTown", "gwylanCold", "maleWarm2", "femaleWarmTank",
					"witch", "gloomyTunic", "ritualRobes", "vintageMale", "vintageFemale"
				)>>
			<<case Alex>><<set $NPCName[_i].outfits.pushUnique("wildsFlannel", "AlexJorts", "AlexSkirt", "coldCoat")>>
			<<case Avery>><<set $NPCName[_i].outfits.pushUnique("business", "maleFormal1", "femaleFormal1", "pyjamas")>>
			<<case Eden>><<set $NPCName[_i].outfits.pushUnique("Eden")>>
			<<case Morgan>><<set $NPCName[_i].outfits.pushUnique("Morgan")>>
			<<case Briar>><<set $NPCName[_i].outfits.pushUnique("maleBriar", "femaleBriar")>>
			<<case Darryl>><<set $NPCName[_i].outfits.pushUnique("maleFormal1", "femaleFormal1")>>
			<<case Remy>><<set $NPCName[_i].outfits.pushUnique("ridingFormal")>>
			<<case Landry>><<set $NPCName[_i].outfits.pushUnique("maleLandry", "femaleLandry")>>
			<<case Charlie>><<set $NPCName[_i].outfits.pushUnique("dance")>>
			<<case Harper>><<set $NPCName[_i].outfits.pushUnique("doctor")>>
			<<case Jordan>><<set $NPCName[_i].outfits.pushUnique("jordanHabit")>>
			<<case Sirris>><<set $NPCName[_i].outfits.pushUnique("teacher", "townTurtleneck", "townCollar")>>
			<<case Doren>><<set $NPCName[_i].outfits.pushUnique("teacher", "townTrack", "townCollar")>>
			<<case River>><<set $NPCName[_i].outfits.pushUnique("teacher", "neutralRobe", "townCollar")>>
			<<case Winter>><<set $NPCName[_i].outfits.pushUnique("teacher")>>
			<<case Mason>><<set $NPCName[_i].outfits.pushUnique("teacher", "maleSchoolSwim", "neutralSwim", "townTrack")>>
			<<case Leighton>><<set $NPCName[_i].outfits.pushUnique("teacher", "maleFormal1", "femaleFormal1")>>
			<<case "Black Wolf" "Great Hawk" "Night Monster">><<set $NPCName[_i].outfits to ["naked"]>>
			<<case "Ivory Wraith">><<set $NPCName[_i].outfits to ["naked", "moonRobe"]>>
			<<case Bailey>><<set $NPCName[_i].outfits.pushUnique("townTurtleneck", "baileyJacket")>>
			<<case Riley>><<set $NPCName[_i].outfits.pushUnique("riley")>>
			<<case Niki>><<set $NPCName[_i].outfits.pushUnique("nikiCoat")>>
			<<case Quinn>><<set $NPCName[_i].outfits.pushUnique("quinnSuit", "quinnSkirtSuit", "quinnCoat", "quinnFurCoat")>>
			<<case Sam>><<set $NPCName[_i].outfits.pushUnique("samCardigan")>>
			<<case Wren>><<set $NPCName[_i].outfits.pushUnique("maleWren", "femaleWren")>>
			<<case Zephyr>><<set $NPCName[_i].outfits.pushUnique("Zephyr")>>
			<<default>>
				<!-- Maybe should be left as a default case for futureproofing?
				Assigns area-appropriate clothes without saving them to the NPC.
				If this does not run, named NPC will only have default and naked clothes.
				<<set $NPCName[_i].outfits to undefined>> -->
		<</switch>>
	<</if>>
	<<getNNPCClothes _nam>>
<</widget>>

<<widget "getNNPCClothes">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<if _nam is "Luchifen">>
		/* Their "t" pronoun matches no m/f clothing set, so random clothes come back empty. Name the neutral formal set. */
		<<npcClothesName $NPCName[_i] "neutralFormal">>
	<<elseif !$NPCName[_i].outfits>>
		<<generateNPCClothes $NPCName[_i]>>
		<<if $debug is 1>><<run console.log('Named NPC [', $NPCName[_i], '] generated with area-appropriate clothes due to a lack of outfits.')>><</if>>
	<<else>>
		<<switch _nam>>
			<<case Alex>>
				<<if $location is "alex_cottage" and Time.betweenHours(21, 5)>>
					<<if $NPCName[_i].pronoun is "m">>
						<<npcClothesName $NPCName[_i] "maleAlexSleep">>
					<<else>>
						<<npcClothesName $NPCName[_i] "femaleAlexSleep">>
					<</if>>
				<<else>>
					<<generateNPCClothes $NPCName[_i]>>
				<</if>>
			<<case Avery>>
				<<if $bus is "avery_bathroom" and ($avery_mansion.schedule is "bath" or $daily.avery.morning_bath is "bathing")>>
					<<npcClothesType $NPCName[_i] "naked">>
				<<elseif $location is "avery_mansion" and $avery_mansion?.schedule is "sleep">>
					<<npcClothesType $NPCName[_i] "sleep">>
				<<elseif Time.hour gte 18>>
					<<npcClothesType $NPCName[_i] "formal">>
				<<else>>
					<<npcClothesType $NPCName[_i] "business">>
				<</if>>
			<<case Poppy>>
				<!-- Example rule: late night = latex for female; otherwise use "poppy" type -->
				<<if Time.betweenHours(23, 6)>>
					<<if $NPCName[_i].pronoun is "f">>
						<<npcClothesName $NPCName[_i] "poppyLatexF">>
					<<else>>
						<<npcClothesName $NPCName[_i] "poppyTownM">>
					<</if>>
				<<else>>
					<<npcClothesType $NPCName[_i] "poppy">>
				<</if>>
			<<case Robin>>
				<<run getRobinCrossdressingStatus($NPCName[_i].crossdress)>>
				<<set $NPCName[_i].crossdressing to _robin_cd>>
				<<run statusCheck("Robin")>>
				<<switch _robin_location>>
					<<case "sleep">>
						<<npcClothesType $NPCName[_i] "sleep">>
					<<case "school">>
						<<npcClothesType $NPCName[_i] "school">>
					<<case "park">>
						<<npcClothesType $NPCName[_i] "cold">>
					<<case "halloween">>
						<<if $halloween_robin_costume>>
							<<npcClothesName $NPCName[_i] $halloween_robin_costume>>
						<<else>>
							<<generateNPCClothes $NPCName[_i]>>
						<</if>>
					<<default>>
						<<generateNPCClothes $NPCName[_i]>>
				<</switch>>
			<<case Sydney>>
				<<sydneySchedule>>
				<<switch _sydney_location>>
					<<case "temple">>
						<<npcClothesType $NPCName[_i] "temple">>
					<<case "school" "class" "lunch" "library">>
						<<npcClothesType $NPCName[_i] "school">>
					<<default>>
						<<generateNPCClothes $NPCName[_i]>>
				<</switch>>
			<<case Kylar>>
				<<if $kylar_clothes is "formal">>
					<<npcClothesType $NPCName[_i] "formal">>
				<<elseif $kylar_clothes is "goth">>
					<<npcClothesType $NPCName[_i] "formalRare">>
				<<elseif $kylar_clothes is "swimsuit">>
					<<npcClothesType $NPCName[_i] "beach">>
				<<else>>
					<<generateNPCClothes $NPCName[_i]>>
				<</if>>
			<<case Gwylan>>
				<<if gwylanSchedule() is "shop">>
					<<if $location is "forest_shop_garden" and ($beastRitual or $sexRitual)>>
						<<npcClothesName $NPCName[_i] "ritualRobes">>
					<<else>>
						<<npcClothesName $NPCName[_i] "gloomyTunic">>
					<</if>>
				<<else>>
					<<if Time.season is "winter">>
						<<npcClothesType $NPCName[_i] "cold">>
					<<else>>
						<<generateNPCClothes $NPCName[_i]>>
					<</if>>
				<</if>>
			<<case Eden Morgan Briar Landry Remy Riley Zephyr>>
				<<npcClothesType $NPCName[_i] _nam>>
			<<case Darryl>>
				<<npcClothesType $NPCName[_i] "formal">>
			<<case Charlie>>
				<<npcClothesType $NPCName[_i] "dance_studio">>
			<<case Harper>>
				<<npcClothesType $NPCName[_i] "hospital">>
			<<case Jordan>>
				<<npcClothesName $NPCName[_i] "jordanHabit">>
			<<case Mason>>
				<<npcClothesType $NPCName[_i] "beach">>
			<<case "Black Wolf" "Great Hawk" "Night Monster">>
				<<npcClothesType $NPCName[_i] "naked">>
			<<case "Ivory Wraith">>
				<<npcClothesType $NPCName[_i] "Wraith">>
			<<case Bailey>>
				<<if $location is "home">>
					<<npcClothesName $NPCName[_i] "townTurtleneck">>
				<<else>>
					<<generateNPCClothes $NPCName[_i]>>
				<</if>>
			<<default>>
				<<generateNPCClothes $NPCName[_i]>>
		<</switch>>
	<</if>>
	<<if $NPCName[_i].penis isnot "none">>
		<<set $NPCName[_i].penis to ($NPCName[_i].clothes.lower.name is "naked" ? 0 : "clothed")>>
	<</if>>
	<<if $NPCName[_i].vagina isnot "none">>
		<<set $NPCName[_i].vagina to ($NPCName[_i].clothes.lower.name is "naked" ? 0 : "clothed")>>
	<</if>>
	<<set $NPCName[_i].chest to ($NPCName[_i].clothes.upper.name is "naked" ? 0 : "clothed")>>
<</widget>>

<!-- addNNPCOutfit and removeNNPCOutfit should only ever be used on named NPCs! -->
<<widget "addNNPCOutfit">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_newNPCOutfit to _args[1]>>
	<<if _args[0] and _args[1]>>
		<<if !setup.npcClothesSets.some(set => set.name.includes($_newNPCOutfit))>>
			<<error {
				message	: `NPC (${_nam}) was given invalid outfit (Outfit name: ${$_newNPCOutfit}). Please inform the developer`,
				source	: Utils.GetStack()
			}>>
		<<elseif _i lt 0>>
			<<error {
				message	: `NPC (${_nam}) ${"is"} invalid (Must be a named NPC. check for typos!). Please inform the developer.`,
				source	: Utils.GetStack()
			}>>
		<<else>>
			<<if !$NPCName[_i].outfits>>
				<<set $NPCName[_i].outfits to ["naked", "maleDefault", "femaleDefault"]>>
			<</if>>
			<<set $NPCName[_i].outfits.pushUnique($_newNPCOutfit)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "removeNNPCOutfit">>
	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>
	<<set $_newNPCOutfit to _args[1]>>
	<<if _args[0] and _args[1]>>
		<<if _i lt 0>>
			<<error {
				message	: `NPC (${_nam}) ${"is"} invalid (Must be a named NPC. Check for typos!). Please inform the developer`,
				source	: Utils.GetStack()
			}>>
		<<elseif !$NPCName[_i].outfits>>
			<<error {
				message	: `NPC (${_nam}) attempted to remove outfit (Outfit name: ${$_newNPCOutfit}) while having no outfits. Please inform the developer`,
				source	: Utils.GetStack()
			}>>
		<<elseif !$NPCName[_i].outfits.some(x => x.includes($_newNPCOutfit))>>
			<<error {
				message	: `NPC (${_nam}) had non-existent outfit removed (Outfit name: ${$_newNPCOutfit}). Please inform the developer`,
				source	: Utils.GetStack()
			}>>
		<<else>>
			<<set $NPCName[_i].outfits.delete($_newNPCOutfit)>>
			<<if $NPCName[_i].outfits.length is 0>>
				<<set $NPCName[_i].outfits to undefined>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<!-- generates the strapon that the NNPC will use if the scene or rng calls for it. doesn't guarantee they will have it 100% of the time. -->
<<widget "initNNPCstrapon">>
	<<set $_npcName to _args[0]>>
	<<set $_name to $_npcName.nam>>
	<<switch $_name>>
		<<case "Whitney">>
			<<set $_npcName.strapons to [{"state": "worn", "color": "dark red", "size": 3, "description":"large dark red strap-on cock"}]>>
		<<default>>
			<<set $_npcName.strapons to []>>
	<</switch>>
<</widget>>

<!-- give an NNPC a *new* strapon -->
<!-- <<giveNNPCnewstrapon _npcNameSelect _straponSize _straponColour _straponShape _modifierOptions>> -->
<<widget "giveNNPCnewstrapon">>
	<<set $_name to _args[0]>>
	<<set $_npcName to $NPCName.find(npc => npc.nam === $_name)>>
	<<set $_index to $NPCName.findIndex(npc => npc.nam === $_name)>>
	<<if _newStrapon is undefined>>
		<<run throw new Error("giveNNPCnewstrapon was run when _newStrapon was undefined! Call generateNewStrapon first!")>>
	<<else>>
		<<set $_strapon to clone(_newStrapon)>>
		<!-- unset _newStrapon so that we can't accidentally dupe strapons. That's right, we're forcing you to generate multiple if you want identical ones. -->
		<<unset _newStrapon>>
	<</if>>

	<!-- if the nnpc's name is in the following list, they will refuse to accept a new strapon -->
	<<if !["Whitney"].includes($_name)>>
		<<if $_npcName.strapons is undefined or $_npcName.strapons.length is 0>>
			<<set $NPCName[$_index].strapons to [$_strapon]>>
		<<else>>
			<<set $NPCName[$_index].strapons.push($_strapon)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "npc">>
	/* Prepare the call for multiple Named NPCs at the same time.
	* We do this by changing all $NPCList[0] calls to $NPCList[x] in which x can be any temporary variable. In this case, we'll use _npcno.
	* We also give the option to set the Named NPC in any available row if so desired, by calling a second argument _args[1]. In case no _args[1] is passed, it will default to the first row.
	* We also now have the option to have the Named NPC be set into the first available slot instead, by setting the second argument _args[1] to a negative number, such as -1. However this will bypass the check for npcs that have broken free from a previous passage.
	* Remember: available rows go from 0 to 5 ($NPCList[0] to $NPCList[5]). No more than that.
	*/
	<<set $NPCList to $NPCList || []>>
	<<unset _overwrite>>

	<<if _args[1] lt 0>>
		<<for _controller to 0; _controller lte $NPCList.length; _controller++>>
			<<if _controller gte 6>>
				<!-- Since 6 is past our limit, we want to alert the user something went wrong. For simplicity, we'll set _npcno to 0 and overwrite $NPCList[0] -->
				<span class="red"> 오류: 활성된 NPC가 이미 6명 있습니다. 명명된 NPC를 위해 NPC 0을 비웁니다.</span>
				<<set _npcno to 0>>
				<<clearsinglenpc 0>>
				<<set _overwrite to true>>
				<<break>> <!-- Always remember to break the for loop when the condition is met -->
			<</if>>
			<!-- Active NPCs always have both gender and description. If either is missing, the slot is an incomplete/stale record and must be reused rather than leaving a hole. -->
			<<if !$NPCList[_controller] or !$NPCList[_controller].gender or !$NPCList[_controller].description>>
				<<set _npcno to clone(_controller)>>
				<<break>> <!-- Always remember to break the for loop when the condition is met -->
			<</if>>
		<</for>>
	<<elseif _args[1]>>
		<<set _npcno to _args[1] - 1>>
	<<else>>
		<<set _npcno to 0>>
	<</if>>

	<<if _npcno lt 0>>
		<<set _npcno to 0>>
	<<elseif _npcno gt 5>>
		<span class="red"> Error: Named NPC slot was out of range. Clamped to slot 5.</span>
		<<set _npcno to 5>>
	<</if>>
	<<if !$NPCList[_npcno]>>
		<<set $NPCList[_npcno] to clone(setup.baseNPC)>>
		<<run console.warn("NPCList[" + _npcno + "] missing before <<npc>> created empty slot.")>>
	<</if>>

	<!-- $enemyno must be left untouched here, or repeated same-NPC mentions silently inflate the enemy count over a playthrough, desyncing enemyhealth math (and the man-combat active-slot loop) in later fights. -->
	<<set _sameNpcInSlot to ($NPCList[_npcno].fullDescription is _args[0])>>

	<<if _npcno is 0 and $enemyno gte 1 and !_overwrite and !_sameNpcInSlot>>
		<<set $endeventerror to $lastgenerated>>
		<<endevent phaseless>>
		<<run EventSystem.clear()>>
	<</if>>

	<!-- The above branch only fires when $enemyno >= 1; this one covers the cold-entry case. -->
	<<if _npcno is 0 and !_overwrite and $enemyno is 0>>
		<<for _slotClean to 1; _slotClean lt 6; _slotClean++>>
			<<set $NPCList[_slotClean] to clone(setup.baseNPC)>>
			<<releaseNamedNpcSlot _slotClean>>
		<</for>>
		<<if EventSystem.count() gt 0>>
			<<run EventSystem.clear()>>
		<</if>>
		<<set $enemynomax to 0>>
	<</if>>

	<<set $lastgenerated to $passage>>

	<<set _nam to _args[0]>>
	<<set _i to $NPCNameList.indexOf(_nam)>>

	<!-- INTEGRITY GUARD: $NPCNameList and $NPCName are parallel arrays, so _i indexes both -->
	<<if _i lt 0 or !$NPCName[_i] or $NPCName[_i].nam isnot _nam>>
		<<if $bugNoticesShown is undefined>><<set $bugNoticesShown to {}>><</if>>
		<<set _namedRow to $NPCName.findIndex(row => row && row.nam === _nam)>>
		<<if _namedRow gte 0>>
			<<run console.warn("$NPCName/$NPCNameList index drift for " + _nam + ": list index " + _i + ", record at " + _namedRow + " (passage " + $passage + ")")>>
			<!-- Realign the whole list from the records' own .nam. -->
			<<set $NPCNameList to $NPCName.map(row => row ? row.nam : undefined)>>
			<<set _i to _namedRow>>
			<<if !$bugNoticesShown.dolx_nnpc_index_drift>>
				<<set $bugNoticesShown.dolx_nnpc_index_drift to true>>
				<span class="red"><b>A bug happened!</b> The named NPC list was out of sync but the game realigned it. Do report it to the Discord server!</span><br>
			<</if>>
		<<else>>
			<<run console.warn("no $NPCName record for " + _nam + " (passage " + $passage + ") - rebuilding a default row")>>
			<<if !$bugNoticesShown.dolx_nnpc_row_missing>>
				<<set $bugNoticesShown.dolx_nnpc_row_missing to true>>
				<span class="red"><b>A bug happened!</b> A named NPC's record was missing but the game rebuilt it. Do report it to the Discord server!</span><br>
			<</if>>
			<!-- Append rather than writing to _i: that row may belong to another NNPC, and overwriting it would destroy their relationship and body data. -->
			<<run $NPCName.push(clone(setup.baseNNPC))>>
			<<set _i to $NPCName.length - 1>>
			<<set $NPCName[_i].nam to _nam>>
			<<set $NPCName[_i].description to _nam>>
			<<set $NPCName[_i].init to 0>>
			<<set $NPCNameList to $NPCName.map(row => row ? row.nam : undefined)>>
		<</if>>
	<</if>>
	<!-- Named NPCs use binary or they/them pronouns; the Ivory Wraith uses "i" in initnpc.
	Anything else renders as an error or as the wrong word for the whole scene.
	Repair the pronoun alone: initnpcgendersingle would also rewrite genitals and breasts from .gender, which would strip a herm or X-Changed NPC of the body the player has already seen. -->
	<<if !["m", "f", "t"].includes($NPCName[_i].pronoun) and $NPCName[_i].nam isnot "Ivory Wraith">>
		<<run console.warn("" + _nam + " had an unusable pronoun (" + $NPCName[_i].pronoun + "); repairing (passage " + $passage + ")")>>
		<<if $NPCName[_i].gender is "m" or $NPCName[_i].gender is "f">>
			<<set $NPCName[_i].pronoun to $NPCName[_i].gender>>
		<<else>>
			<<set $NPCName[_i].pronoun to (maleChance() lt random(1, 100) ? "f" : "m")>>
		<</if>>
		<<generatePronouns $NPCName[_i]>>
	<</if>>

	<!-- Initialise NPC on first time called, introducing them to PC -->
	<<if $NPCName[_i].init isnot 1>>
		<<initnpc _nam>>
	<</if>>

	<!-- Determine what outfit the NPC should be wearing -->
	<<if !$NPCName[_i].outfits>>
		<<initNNPCClothes _nam>>
	<<else>>
		<<getNNPCClothes _nam>>
	<</if>>

	<<if !$NPCName[_i].strapons>>
		<<initNNPCstrapon $NPCName[_i]>>
	<</if>>
	<<set $NPCList[_npcno].virginity to $NPCName[_i].virginity>>

	<!-- Set global variables -->
	/* Both $npc and $npcnum will keep defined NPCs in the order they were defined.
	* DO NOT COMPARE NEITHER $npc NOR $npcnum TO $NPCList.
	* Since when defining an NPC one can choose in which row of $NPCList to put it, comparing them could result in mismatches.
	*/
	<!-- Prevent duplicate slot mappings, which can cause a single NPC to use "they" pronouns. -->
	<<releaseNamedNpcSlot _npcno>>
	<<set $npc.push(_nam)>>
	<<set $npcnum.push(_i)>>
	<<set $NPCList[_npcno].fullDescription to _nam>>
	<!-- Set a variable to be compared to $NPCList, for simplicity. The row indicates which NPC it is, value is where in $NPCList it was defined. -->
	<<set $npcrow.push(_npcno)>>

	<<if $npc.length gt 1>>
		<<set $pronoun to "t">> <!-- In case more than 1 Named NPC is defined, we set pronoun to "they". -->
	<<else>>
		<<set $pronoun to $NPCName[_i].pronoun>>
	<</if>>
	<!-- Set combat variables -->
	<<set $NPCList[_npcno].pronoun to $NPCName[_i].pronoun>>
	<<set $NPCList[_npcno].pronouns to clone($NPCName[_i].pronouns)>>
	<<set $NPCList[_npcno].startingSex to $NPCName[_i].startingSex>>
	<<set $NPCList[_npcno].gender to $NPCName[_i].gender>>
	<<set $NPCList[_npcno].type to $NPCName[_i].type>>

	/* Sets up named NPC multiple orgasms. Persistent Base max orgasms stays on $NPCName[_i].maxOrgasms.
	Temporary combat counters live on $npcOrgasmState, not $NPCList. */
	<<if $NNPCMultiOrgasmToggle is 1 and (!$NNPCMultiOrgasmGender or $NNPCMultiOrgasmGender is "all" or $NPCName[_i].gender is $NNPCMultiOrgasmGender)>>
		<<if !$NPCName[_i].maxOrgasms or $NPCName[_i].maxOrgasms lte 0>>
			<<initNPCBaseMaxOrgasmSingle _i>>
		<</if>>
		<<set _npcMaxOrgasms to $NPCName[_i].maxOrgasms>>
		<<if !_npcMaxOrgasms or _npcMaxOrgasms lte 0>>
			<<set _npcMaxOrgasms to 1>>
		<</if>>
		<<if $multiOrgasmLustScaling is 1>>
			<<set _npcLustBonus to Math.floor(($NPCName[_i].lust || 0) / 20)>>
			<<set _npcMaxOrgasms += _npcLustBonus>>
		<</if>>
		<<set _npcMaxOrgasms to Math.clamp(_npcMaxOrgasms, 1, 5)>>
		<<if _npcMaxOrgasms gt 1>>
			<<if !$npcOrgasmState or typeof $npcOrgasmState isnot "object" or Array.isArray($npcOrgasmState)>>
				<<set $npcOrgasmState to {}>>
			<</if>>
			<<set $npcOrgasmState[_npcno] to { max: _npcMaxOrgasms, count: 0 }>>
			<<set $setupMidOrgasm to true>>
		<</if>>
	<</if>>

	<<set $NPCList[_npcno].lefthand to 0>>
	<<set $NPCList[_npcno].righthand to 0>>
	<<set $NPCList[_npcno].mouth to 0>>
	<<set $NPCList[_npcno].anus to 0>>/* is not actually used anywhere */
	<<set $NPCList[_npcno].chest to 0>>

	<<set $NPCList[_npcno].traits to []>>

	<!-- dodgeChance must start numeric -->
	<<set $NPCList[_npcno].dodgeChance to 0>>

	<<switch _nam>>
	<<case "Eden" "Black Wolf" "Great Hawk">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 40>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 40>>
		<</if>>
	<<case "Bailey">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 40>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 40>>
		<</if>>
		<<set $NPCList[_npcno].traits.push("unforgiving")>>
	<<case "Avery">>
		<<if $auriga_artefact is "Avery">>
			<<set $NPCList[_npcno].health to 600>>
			<<set $NPCList[_npcno].healthmax to 600>>
			<<if $combatExtended.enemyBaseDodgeChance is 1>>
				<<set $NPCList[_npcno].dodgeChance to 30>>
			<</if>>
			<<if $combatExtended.enemyMartialArts is 1>>
				<<set $NPCList[_npcno].dodgeChance += 30>>
			<</if>>
		<<else>>
			<<set $NPCList[_npcno].health to 200>>
			<<set $NPCList[_npcno].healthmax to 200>>
			<<if $combatExtended.enemyBaseDodgeChance is 1>>
				<<set $NPCList[_npcno].dodgeChance to 20>>
			<</if>>
			<<if $combatExtended.enemyMartialArts is 1>>
				<<set $NPCList[_npcno].dodgeChance += 10>>
			<</if>>
		<</if>>
		<<if $avery_fate isnot "saved">>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
	<<case "Harper">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<set $NPCList[_npcno].traits.push("hypnotist")>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 5>>
		<</if>>
	<<case "Ivory Wraith">>
		<<statsWraith>>
		<<set $NPCList[_npcno].health to _wraithHP>>
		<<set $NPCList[_npcno].healthmax to _wraithHP>>
		<<set $NPCList[_npcno].traits to ["brooding", "watchful", "willful", "beautiful"]>>
		<<set _condomIgnore to true>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 30>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 30>>
		<</if>>
	<<case "Alex">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		/* Alex never thinks to bring a condom. */
		<<set _condomIgnore to true>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 25>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 20>>
		<</if>>
	<<case "Morgan">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<set $NPCName[_npcno].pregnancyAvoidance to random(0,100)>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 20>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 10>>
		<</if>>
		
	<<case "Gwylan">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<set $NPCName[_npcno].pregnancyAvoidance to 0>>
		<<set $NPCList[_npcno].traits.push("hypnotist", "willful", "deviant", "drug resistant")>>
		<<if $gwylan?.wary gte 5>>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
		<<set $NPCList[_npcno].skills to {}>>
		<<set $NPCList[_npcno].skills.security to 800>>
		<<set $NPCList[_npcno].skills.athletics to 800>>
		<<set _condomIgnore to true>><<set _strapIgnore to true>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 5>>
		<</if>>

	<<case "Leighton">>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<if $headblackmailed is 1>>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 20>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 10>>
		<</if>>

	<<case "Night Monster">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
		<<set $NPCList[_npcno].traits.push("drug resistant")>>
		<<set _condomIgnore to true>><<set _strapIgnore to true>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 40>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 40>>
		<</if>>

	<<case "Poppy">>
		<<set $NPCList[_npcno].health to 600>>
		<<set $NPCList[_npcno].healthmax to 600>>
		<<set $NPCList[_npcno].dodgeChance to 0>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 40>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 40>>
		<</if>>
		<<if !$NPCList[_npcno].traits.includes("unforgiving")>>
			<<set $NPCList[_npcno].traits.push("unforgiving")>>
		<</if>>

	<<default>>
		<<set $NPCList[_npcno].health to 200>>
		<<set $NPCList[_npcno].healthmax to 200>>
		<<if $combatExtended.enemyBaseDodgeChance is 1>>
			<<set $NPCList[_npcno].dodgeChance to 20>>
		<</if>>
		<<if $combatExtended.enemyMartialArts is 1>>
			<<set $NPCList[_npcno].dodgeChance += 10>>
		<</if>>
	<</switch>>

	<<set _buff to 0>>
	<<set $NPCList[_npcno].healthmax to Math.round($NPCList[_npcno].healthmax * ($nnpcHealthMult / 100))>>
	<<set _buffAmount to Math.floor(Time.days / $combatExtended.enemyDayScaling)>>
	<<if $combatExtended.enemyHealthDayScaling is 1>>
		<<if _buffAmount lte $combatExtended.enemyDayScalingLimit or $combatExtended.enemyInfiniteDayScaling is 1>>
			<<set _buff += _buffAmount * $combatExtended.enemyHealthDayScalingMult>>
		<<else>>
			<<set _buff += $combatExtended.enemyDayScalingLimit * $combatExtended.enemyHealthDayScalingMult>>
		<</if>>
	<</if>>
	<<set _buffAmount to Math.floor($enemiesDefeatedStat / $combatExtended.enemyDefeatScaling)>>
	<<if $combatExtended.enemyHealthDefeatScaling is 1>>
		<<if _buffAmount lte $combatExtended.enemyDefeatScalingLimit or $combatExtended.enemyInfiniteDefeatScaling is 1>>
			<<set _buff += _buffAmount * $combatExtended.enemyHealthDefeatScalingMult>>
		<<else>>
			<<set _buff += $combatExtended.enemyDefeatScalingLimit * $combatExtended.enemyHealthDefeatScalingMult>>
		<</if>>
	<</if>>
	<<set $NPCList[_npcno].healthmax to Math.round($NPCList[_npcno].healthmax * (1 + (_buff / 100)))>>
	<<set $NPCList[_npcno].health to $NPCList[_npcno].healthmax>>

	<<set $NPCList[_npcno].breastsize to $NPCName[_i].breastsize>>
	<<set $NPCList[_npcno].breastsdesc to $NPCName[_i].breastsdesc>>
	<<set $NPCList[_npcno].breastdesc to $NPCName[_i].breastdesc>>
	<<set $NPCList[_npcno].vagina to $NPCName[_i].vagina>>

	<<if $settings.breastFeedingEnabled and (_nam is "Morgan" or _nam is "Gwylan" or npcIsPregnant(_nam)) and $NPCName[_i].pronoun is "f" and $NPCName[_i].breastsize gt 0>>
		<<set $NPCList[_npcno].lactation to 1>>
	<</if>>

	<<set $NPCList[_npcno].penis to $NPCName[_i].penis>>
	<<set $NPCList[_npcno].penissize to $NPCName[_i].penissize>>
	<<set $NPCList[_npcno].penisdesc to $NPCName[_i].penisdesc>>

	<<set $NPCList[_npcno].chastity to clone($NPCName[_i].chastity)>>
	<<set $NPCList[_npcno].clothes to clone($NPCName[_i].clothes)>>
	<!-- Most persistent named-NPC records have no combat chest state. Keep the combat-safe zero set above unless a scene/NPC explicitly provides one. -->
	<<set $NPCList[_npcno].chest to clone($NPCName[_i].chest ?? 0)>>

	<<if $NPCList[_npcno].penis is "none" and $NPCName[_i].strapons?.length gt 0 and random(0,99) lt $settings.straponChance>>
		<<set $NPCList[_npcno].penis to $NPCList[_npcno].vagina>>
		<<set $NPCList[_npcno].vagina to "none">>
		<<set $NPCList[_npcno].gender to "m">>
		<<set $_strapon to clone($NPCName[_i].strapons.random())>>
		<<setNPCStrapon $NPCList[_npcno] $_strapon>>
	<</if>>

	<<set $NPCList[_npcno].skincolour to $NPCName[_i].skincolour>>
	<<set $NPCList[_npcno].skinType to $NPCName[_i].skinType>>

	<<set $NPCList[_npcno].insecurity to $NPCName[_i].insecurity>>
	<<set $NPCList[_npcno].description to $NPCName[_i].title>>

	<<set $NPCList[_npcno].insecurity to $NPCName[_i].insecurity>>
	<<set $NPCList[_npcno].description to $NPCName[_i].title>>

	<<set $NPCList[_npcno].adult to $NPCName[_i].adult>>
	<<set $NPCList[_npcno].teen to $NPCName[_i].teen>>

	<<set $NPCList[_npcno].location to {
		head: 0,
		genitals: 0,
	}>>

	<<set $NPCList[_npcno].bold to 0>>
	<<set $NPCList[_npcno].condom to false>>
	<<set $NPCList[_npcno].pregnancyAvoidance to $NPCName[_i].pregnancyAvoidance>>
	<<set $NPCList[_npcno].name_known to $NPCName[_i].name_known>>

	<<if $settings.condomLevel gte 2>>
		<!-- 50 is the threshold for named NPCs bringing their own condoms, do not change -->
		<<if ($NPCList[_npcno].pregnancyAvoidance gte 50 and !_condomIgnore)>>
			<<set $NPCList[_npcno].condom to {
				willUse: true,
				state: (random(0,100) gt 98 ? "defective" : "normal"),
				type: "plain",
				colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
				worn: false
			}>>
		<!-- Kylar brings their own sabotaged condoms -->
		<<elseif _nam is "Kylar">>
			<<set $NPCList[_npcno].condom to {
				willUse: false,
				state: "sabotaged",
				type: "plain",
				colour: setup.colours.condom[random(0, (setup.colours.condom.length -1))].csstext,
				worn: false
			}>>
		<</if>>
	<</if>>

	<!-- Whitney and Avery should wear strap-ons based on strap-on chance -->
	<<if $NPCList[_npcno].penis is "none" and (_nam is "Whitney" or _nam is "Avery") and !_strapIgnore and random(0,99) lt $settings.straponChance>>
		<<npcstrapon _npcno>>
	<</if>>

	<<if _nam is "Sydney" and $sydney_toy isnot undefined>>
		<<giveNPCsextoy _npcno $sydney_toy>>
	<</if>>

	<!-- Following sections adjusted for the changes converting from $claws to .claws -->

	<!-- Adjust for Beast type NNPCs: Black Wolf -->
	<!-- Changed all instances of zeroes (0) to _npcno in the event multi-beast is properly implemented -->
	<<if $NPCList[_npcno].type is "wolf">>
		<<set $beastname to "blackwolf">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if resolveIfNamedBeastIsMonster("blackwolf")>>
			<<set $NPCList[_npcno].monster to "monster">>
			<<set $monster to 1>><<set _monsterOverride to true>>
			<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "wolfgirl" : "wolfboy")>>
			<<set $NPCList[_npcno].lefthand to 0>>
			<<set $NPCList[_npcno].righthand to 0>>
			<<run delete $NPCList[_npcno].claws>>
		<<else>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "claws">>
		<</if>>
	<</if>>

	<!-- Adjust for Beast type NNPCs: Great Hawk -->
	<<if $NPCList[_npcno].type is "hawk">>
		<<set $beastname to "greathawk">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if resolveIfNamedBeastIsMonster("greathawk")>>
			<<set $NPCList[_npcno].monster to "monster">>
			<<set $monster to 1>><<set _monsterOverride to true>>
			<<set $NPCList[_npcno].type to "harpy">>
			<<set $NPCList[_npcno].lefthand to 0>>
			<<set $NPCList[_npcno].righthand to 0>>
			<<run delete $NPCList[_npcno].claws>>
		<<else>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "talons">>
		<</if>>
	<</if>>

	<!-- Adjust for Night Monster -->
	<<if $NPCList[_npcno].fullDescription is "Night Monster">>
		<<set $beastname to "nightmonster">>
		<<set $NPCList[_npcno].lefthand to "none">>
		<<set $NPCList[_npcno].righthand to "none">>
		<<set $NPCList[_npcno].stance to "approach">>
		<<if resolveIfNamedBeastIsMonster("nightmonster")>>
			<<set $NPCList[_npcno].monster to "monster">>
			<<set $monster to 1>><<set _monsterOverride to true>>
			<<set $NPCList[_npcno].type to ($NPCList[_npcno].pronoun is "f" ? "horned woman" : "horned man")>>
			<<set $NPCList[_npcno].lefthand to 0>>
			<<set $NPCList[_npcno].righthand to 0>>
			<<run delete $NPCList[_npcno].claws>>
		<<else>>
			<<set $NPCList[_npcno].monster to 0>>
			<<set $NPCList[_npcno].pronoun to "i">>
			<<set $NPCList[_npcno].claws to "claws">>
		<</if>>
	<</if>>

	<<if !_sameNpcInSlot and $enemyno lt 6>><<set $enemyno += 1>><</if>>
	<!-- $enemynomax is the peak NPC count for this encounter and must be >= $enemyno at all times.
	The npc widget reaches the live count by direct increment, not through generateNPC (where the npc-generation.twee fix lives), so the peak bump has to happen here too. -->
	<<if $enemynomax lt $enemyno>><<set $enemynomax to $enemyno>><</if>>

	<<if $NPCList[0].monster is "monster" or _monsterOverride>>
		<<set $monster to 1>>
	<<else>>
		<<set $monster to 0>>
	<</if>>

	/*Run pregnancy Checks*/
	<<if playerIsPregnant() and playerBellyVisible(true) and _nam isnot "Robin">>
		<<setKnowsAboutPregnancy "pc" _args[0]>>
	<</if>>
	<<if npcIsPregnant(_args[0]) and npcBellyVisible(_args[0])>>
		<<setKnowsAboutPregnancy _args[0] "pc">>
	<</if>>

	<<set $NPCList[_npcno].index to _npcno>>
	<!-- Reusing the same named NPC across consecutive passages keeps the NPC live, but the old event entry still belongs to the preceding passage.
	Replace that one entry before registering the current passage; otherwise one NPC becomes two entries for the same slot. -->
	<<if _sameNpcInSlot>><<run EventSystem.pop(_npcno)>><</if>>
	<<run EventSystem.push($passage, _npcno, $timeStamp)>>
	<<set $index to _npcno>>

	<<unset _strapIgnore>>
	<<unset _condomIgnore>>
<</widget>>

<<widget "npcrelationship">>
	<!-- Robin, Avery, Kylar are unique and are treated differently -->
	<<set _i to V.NPCName.findIndex(i => i.nam === _args[0])>>
	<<if _i !== -1>>
		<<set _npc to _args[0]>>
	<<else>>
		<<error { message: "<<npcrelationship>>에 잘못된 인수가 전달되었습니다" }>>
	<</if>>
	<<if $NPCName[_i].init is 1>>
		<<relationshiptext>>
		<br>
	<</if>>
<</widget>>

<<widget "npcincr">>
	<!-- Arguments passed are NNPC name, variable type, and value (+/-)-->
	<<set _nam to _args[0]>>
	<<set _var to _args[1]>>
	<<set _val to _args[2]>>
	<<if _args[3]>>
		<<set _cheat to _args[3]>>
	<</if>>

	<!--
		do NOT change this to reference setup.NPCNameList: this check exists to make sure whenever a new NNPC is added,
		calling npcincr with them throws an error until the implemented adds clamps to <<relationshipClamp>>
		and adds their name to relevant whitelists (and blacklists, if they don't use love or dom) below.

		if you're reading this, there's a decent chance that means you!
		head over to game/base-system/widgets.twee and give this new NNPC relevant clamps before whitelisting them below.
	-->
	<<set _validNNPCNames to ["Avery","Bailey","Briar","Charlie","Darryl","Doren","Eden","Gwylan","Harper","Jordan","Kylar","Landry","Leighton","Mason","Morgan","River","Robin","Sam","Sirris","Whitney","Winter","Black Wolf","Niki","Quinn","Remy","Alex","Great Hawk","Wren","Sydney","Ivory Wraith","Zephyr","Poppy","Riley","Luchifen"]>>
	<<if !_validNNPCNames.includes(_nam)>>
		<<error { message: "NNPC '" + _nam + "' is not whitelisted for use with <<npcincr>>"}>>
	<</if>>
	<<set _i to $NPCNameList.indexOf(_nam)>>

	<<set _isPoppy to _nam is "Poppy">>
	<<if _isPoppy>>
		<<if $NPCName[_i].timer is undefined>><<set $NPCName[_i].timer to {}>><</if>>
		<<if $NPCName[_i].timer.lastPatienceDecay is undefined>><<set $NPCName[_i].timer.lastPatienceDecay to Time.date.timeStamp>><</if>>
	<</if>>

	<<switch _var>>
	<<case love>>
		<<if modLISelected("Poppy") and _isPoppy>><<run statusCheck("Poppy")>><</if>>
		<<if $valentines and Time.monthDay is 14 and (setup.loveInterestNpc.includes(_nam) or (modLISelected("Poppy") and _isPoppy))>>
			<<set _val += _val>>
		<</if>>
		<!-- Detached: love builds slower and fades slower. -->
		<<if !_cheat>>
			<<set _val to detachedLoveScale(_val)>>
		<</if>>
		<<if modLISelected("Poppy") and _isPoppy and _val gt 0 and !_cheat>>
			<<if T.poppyLoveGainAllowed>>
				<<set $NPCName[_i].love += _val>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].love += _val>>
		<</if>>
	<<case dom>>
		<<if ["Sydney", "Black Wolf", "Ivory Wraith"].includes(_nam)>>
<<error { message: "<<npcincr>> attempted to modify dom for " + _nam + ", who has no dom clamp" }>>
		<</if>>
		<<if _nam is "Gwylan" and _val gt 0>>
			<<set $_stage to Math.floor($NPCName[_i].dom / 25)>>
			<<if $_stage gte 1 and !$gwylanSeen?.includes("yearning") or $_stage gte 3 and !$gwylanSeen?.includes("partners") or $gwylan?.wary gt 1>>
				<!-- No increase -->
			<<else>>
				<<set $NPCName[_i].dom += _val>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].dom += _val>>
		<</if>>
	<<case trust>>
		<<if _nam isnot "Eden">>
			<<error { message: "<<npcincr>>【이가】 에덴이 아닌 다른 대상의 신뢰도를 수정하려고 시도했습니다. (" + _nam + ")" }>>
		<</if>>
		<<set $NPCName[_i].trust += _val>>
	<<case lust>>
		<<if modLISelected("Poppy") and _isPoppy>><<run statusCheck("Poppy")>><</if>>
		<<set _lustwhitelist to setup.lustWhitelist>>
		<<if !_lustwhitelist.includes(_nam)>>
			<<error { message: "<<npcincr>>【이가】 화이트리스트에 없는 NPC의 욕망을 수정하려고 시도했다 " + _nam + ". 화이트리스트에 추가하기 전에 <<relationshipClamp>>에서 욕망 제한을 설정했는지 확인하세요." }>>
		<</if>>
		<<if $valentines and Time.monthDay is 14 and (setup.loveInterestNpc.includes(_nam) or (modLISelected("Poppy") and _isPoppy))>>
			<<set _val += _val>>
		<</if>>
		<<if modLISelected("Poppy") and _isPoppy and _val gt 0 and !_cheat>>
			<<if T.poppyLustUnlocked>>
				<<set $NPCName[_i].lust += _val>>
				<<set _lustincr to 1>>
			<</if>>
		<<elseif _nam is "Sydney" and !_sydneyChastity and _val gt 0 and !_cheat>>
			<<set $NPCName[_i].lust += (_val + 1)>>
			<<set _lustincr to 1>>
		<<else>>
			<<set $NPCName[_i].lust += _val>>
			<<set _lustincr to 1>>
		<</if>>
	<<case patience>>
		<<if _isPoppy>>
			<<if $NPCName[_i].patience is undefined>>
				<<set $NPCName[_i].patience to 100>>
			<</if>>

			/* Signed temper stat: +100 (max patience) to -100 (max anger) */
			<<set $NPCName[_i].patience += _val>>

			<<if $NPCName[_i].patience gt 100>>
				<<set $NPCName[_i].patience to 100>>
			<<elseif $NPCName[_i].patience lt -100>>
				<<set $NPCName[_i].patience to -100>>
			<</if>>
		<<else>>
			<span class="red">NPCINCR 오류 - 인내심은 포피 전용입니다</span><br><br>
		<</if>>

	<<case anger>>
		<<if _isPoppy>>
			/* Anger is the negative side of patience */
			<<npcincr Poppy patience `-_val`>>
		<<else>>
			<span class="red">NPCINCR 오류 - 분노는 포피 전용입니다</span><br><br>
		<</if>>
	<<case rage>>
		<<if !["Avery", "Kylar"].includes(_nam)>>
			<<error { message: "<<npcincr>>【이가】 에이버리나 카일라가 아닌 다른 대상의 분노를 수정하려고 시도했습니다. (" + _nam + ")" }>>
		<</if>>
		<<set $NPCName[_i].rage += _val>>
	<<case trauma>>
		<<if !["Robin", "Whitney"].includes(_nam)>>
			<<error { message: "<<npcincr>>【이가】 로빈이나 휘트니가 아닌 다른 대상의 트라우마를 수정하려고 시도했습니다. (" + _nam + ")" }>>
		<</if>>
		<<if _nam is "Robin" and _val lt 0>>
			<<set $NPCName[_i].trauma += Math.round(_val * ($robinTraumaMultiplier || 1))>>
			<<if $NPCName[_i].trauma lt 0>>
				<<set $NPCName[_i].trauma = 0>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].trauma += _val>>
			<<if $NPCName[_i].trauma gt 100>>
				<<set $NPCName[_i].trauma = 100>>
			<</if>>
		<</if>>
	<<case purity>>
		<<if _nam isnot "Sydney">>
			<<error { message: "<<npcincr>>【이가】 시드니가 아닌 다른 대상의 순결도를 수정하려고 시도했습니다. (" + _nam + ")" }>>
		<</if>>
		<<if $NPCName[_i].corruption gt 0>>
			<<set $NPCName[_i].corruption -= _val>>
			<<if $NPCName[_i].corruption lte 0>>
				<<if $purityEvent is 1>>
					<<set _rollover to -$NPCName[_i].corruption>>
					<<set $NPCName[_i].purity += (_rollover + 4)>>
					<<set $NPCName[_i].corruption = 0>>
					<<set $purityRollover to 1>>
				<<else>>
					<<set $NPCName[_i].corruption = 1>>
				<</if>>
			<</if>>
		<<else>>
			<<set $NPCName[_i].purity += _val>>
			<<if $NPCName[_i].purity lte 0>>
				<<if $corruptionEvent is 1>>
					<<set _rollover to -$NPCName[_i].purity>>
					<<set $NPCName[_i].corruption += (_rollover + 10)>>
					<<set $NPCName[_i].purity = 0>>
					<<set $corruptionRollover to 1>>
				<<else>>
					<<set $NPCName[_i].purity = 1>>
				<</if>>
			<</if>>
			<<if $NPCName[_i].purity gte 100 and ($NPCName[_i].virginity.vaginal isnot true or $NPCName[_i].virginity.penile isnot true)>>
				<<set $NPCName[_i].purity = 99>>
			<</if>>
		<</if>>
		<<if $NPCName[_i].purity lte 50 and _val lt 0 and _lustincr isnot 1>>
			<<npcincr Sydney lust 1>>
		<</if>>
		<<unset $purityEvent>>
		<<unset $corruptionEvent>>
	<<default>>
		<span class="red">NPCINCR 오류 - 알 수 없는 변수 _var</span>
		<br><br>
	<</switch>>
<<relationshipClamp>>
<</widget>>

<<widget "npcset">>
	<!-- Sets selected NNPC variables using NNPC name-->
	<!-- Arguments passed are NNPC name, variable type, value -->

	<<set _nam to _args[0]>>
	<<set _var to _args[1]>>
	<<set _val to _args[2]>>

	<<set _i to $NPCNameList.indexOf(_nam)>>

	<<switch _var>>
		<<case love>>
			<<set $NPCName[_i].love to _val>>
		<<case dom>>
			<<set $NPCName[_i].dom to _val>>
		<<case trust>>
			<<set $NPCName[_i].trust to _val>>
		<<case lust>>
			<<set $NPCName[_i].lust to _val>>
		<<case rage>>
			<<set $NPCName[_i].rage to _val>>
		<<case state>>
			<<set $NPCName[_i].state to _val>>
		<<case init>>
			<<set $NPCName[_i].init to _val>>
		<<case trauma>>
			<<set $NPCName[_i].trauma to _val>>
		<<case purity>>
			<<set $NPCName[_i].purity to _val>>
		<<case corruption>>
			<<set $NPCName[_i].corruption to _val>>
		<<case patience>>
			<<set $NPCName[_i].patience to _val>>
			<<if $NPCName[_i].patience gt 100>>
				<<set $NPCName[_i].patience to 100>>
			<<elseif $NPCName[_i].patience lt -100>>
				<<set $NPCName[_i].patience to -100>>
			<</if>>
			<<set $NPCName[_i].anger to Math.max(0, -$NPCName[_i].patience)>>
		<<case anger>>
			<<set $NPCName[_i].anger to Math.max(0, Math.min(100, Number(_val) || 0))>>
			<<set $NPCName[_i].patience to -$NPCName[_i].anger>>
		<<default>>
			<span class="red">NPCSET 오류 - 알 수 없는 값 _var</span>
			<br><br>
	<</switch>>
<</widget>>

<<widget "relationshiptext">>
	<!-- Special cases for LIs + Wraith -->
	<<switch _npc>>
		<<case Robin>>
			로빈은
			<<if $robin.timer.hurt gte 2 or $robinbreakupCooldown gte 2>>
				<span class="red">배신감</span>을 느낀다.
			<<elseif $robin.timer.hurt gte 1 or $robinbreakupCooldown gte 1>>
				<span class="purple">갈등</span>을 느낀다.
			<<elseif $robinromance is 1>>
				<<if $NPCName[_i].trauma gte 80>>
					<<if $NPCName[_i].lust gte 50>>
						당신을 향한 <span class="red">갈망에 잠식되어 있다</span>.
					<<else>>
						당신 없이는 <span class="red">아무것도 아니다</span>.
					<</if>>
				<<elseif $NPCName[_i].dom gte 40>>
					당신을 <span class="lewd">무척 아낀다</span>.
				<<else>>
					당신을 <span class="lewd">사랑한다</span>.
				<</if>>
			<<elseif $NPCName[_i].trauma gte 80>>
				<span class="red">트라우마</span>에 시달린다.
			<<elseif $NPCName[_i].trauma gte 40>>
				<span class="red">고통</span>스러워한다.
			<<elseif $NPCName[_i].trauma gte 10>>
				<span class="purple">괴로워</span>한다.
			<<elseif $NPCName[_i].dom gte 80>>
				당신을 <span class="teal">지켜 주고 싶어 한다</span>.
			<<elseif $NPCName[_i].dom gte 20>>
				당신을 <span class="teal"><<nnpc_his "Robin">> 가장 친한 친구</span>라고 생각한다.
			<<else>>
				당신을 <span class="teal">동경한다</span>.
			<</if>>
		<<case Avery>>
			에이버리는
			<<if $NPCName[_i].state is "dismissed">>
				<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
					<span class="black">몰락했다.</span>
				<<else>>
					<span class="red">이제 당신에게서 마음을 접었다.</span>
				<</if>>
			<<elseif $NPCName[_i].rage gte 96 and $averyragerevealed is 1 and $dateCount.Avery gte 2 and !$avery_mansion>>
				당신을 <span class="red">포기했다</span>.
			<<elseif $NPCName[_i].love gte 60>>
				<<if $NPCName[_i].rage gte 60>>
					당신 때문에 <span class="pink">격분해 있다</span>.
				<<elseif $NPCName[_i].rage gte 20>>
					당신에게 <span class="blue">더 짧은 목줄</span>을 채우고 싶어 한다.
				<<else>>
					당신을 <span class="green">귀하게 여긴다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].rage gte 60>>
					당신에게 <span class="pink">몹시 화가 나 있다</span>.
				<<elseif $NPCName[_i].rage gte 20>>
					당신을 <span class="purple">소유물</span>로 본다.
				<<else>>
					당신을 <span class="teal">귀엽다</span>고 생각한다.
				<</if>>
			<<else>>
				<<if $NPCName[_i].rage gte 60>>
					당신을 <span class="pink">건방지다</span>고 생각한다.
				<<elseif $NPCName[_i].rage gte 20>>
					당신을 <span class="blue">버릇없는 애</span>라고 생각한다.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Kylar>>
			카일라는
			<<if $NPCName[_i].state is "prison" and $location isnot "prison">>
				<span class="red">수감되어 있다</span>.
			<<elseif $NPCName[_i].love gte 80>>
				<<if $NPCName[_i].rage gte 90>>
					<span class="red">히스테리에 빠져 있다</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					당신에게 <span class="pink">집착하고 있다</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					당신에게 <span class="blue">집착하고 있다</span>.
				<<else>>
					is <span class="green">head over heels for you</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].rage gte 90>>
					<span class="red">히스테리에 빠져 있다</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					당신에게 <span class="pink">푹 빠져 있다</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					당신에게 <span class="purple">푹 빠져 있다</span>.
				<<else>>
					<span class="teal">likes you.</span>
				<</if>>
			<<elseif $NPCName[_i].love gte 30>>
				<<if $NPCName[_i].rage gte 90>>
					<span class="red">히스테리에 빠져 있다</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					당신에게 <span class="pink">홀딱 반해 있다</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					당신에게 <span class="purple">홀딱 반해 있다</span>.
				<<else>>
					is <span class="lblue">curious about you</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].rage gte 90>>
					<span class="red">히스테리에 빠져 있다</span>.
				<<elseif $NPCName[_i].rage gte 60>>
					당신에게 <span class="pink">매달리고 있다</span>.
				<<elseif $NPCName[_i].rage gte 30>>
					당신에게 <span class="purple">매달리고 있다</span>.
				<<else>>
					is <span class="blue">indifferent about you</span>.
				<</if>>
			<</if>>
		<<case Whitney>>
			휘트니는
			<<if $NPCName[_i].state is "dungeon">>
				<span class="red">사라졌다</span>.
			<<elseif $whitneyRescueStatus isnot undefined>>
				<<if $whitneyRescueStatus is "humiliated" and !$whitneyRescueTimer>>
					<span class="red">취약해져 있다</span>.
				<<elseif $whitneyRescueStatus is "humiliated">>
					<span class="red">굴욕을 당한 상태다</span>.
				<<elseif $whitneyRescueStatus is "shaken">>
					<span class="pink">불안하고 동요하고 있다</span>.
				<<elseif $whitneyRescueStatus is "grateful">>
					<span class="green">고마워하고 있다</span>.
				<</if>>
			<<elseif [1,2].includes($whitney_orphanage_special_seen)>>
					feels <span class="red">rejected</span>.
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].lust gte 60>>
					<span class="lewd">좀 놀아 볼 생각</span>이다.
				<<else>>
					<<if $NPCName[_i].dom gte 20>>
						당신을 <span class="lewd">소유했다</span>고 여긴다.
					<<elseif $NPCName[_i].dom lte 8 or $loft_whitney gte 6>>
						thinks you're <span class="green"><<nnpc_his "Whitney">> <<girlfriend "Whitney">></span>.
					<<else>>
						당신을 <span class="lewd"><<nnpc_his "Whitney">> 애완동물</span>로 여긴다.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love lte 5>>
				<<if $NPCName[_i].lust gte 60>>
						당신이 <span class="pink"><<= $NPCName[_i].dom gte 18 ? "애원하게 만들고" : "애원하는 걸 듣고">></span> 싶어 한다.
				<<else>>
					<<if $NPCName[_i].dom gte 20>>
						당신을 <span class="red">한심하다</span>고 생각한다.
					<<elseif $NPCName[_i].dom lte 7>>
						<<if $NPCName[_i].dom lte 2 and $NPCName[_i].love lte 2>>
							당신에게 <span class="red">앙심을 품고 있다</span>.
						<<else>>
							당신을 <span class="red"><<nnpc_his "Whitney">> 지위를 위협하는 존재</span>로 본다.
						<</if>>
					<<else>>
						당신을 <span class="red">괴짜</span>라고 생각한다.
					<</if>>
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 20>>
					당신을 <span class="teal">괴롭히기 좋은 상대</span>로 여긴다.
				<<elseif $NPCName[_i].dom lte 8>>
					당신을 <span class="purple">짜증 나는 존재</span>로 여긴다.
				<<else>>
					당신을 <span class="pink">만만한 표적</span>으로 여긴다.
				<</if>>
			<</if>>
		<<case Eden>>
			에덴은
			<<if $syndromeeden gte 1>>
				<<if $edenfreedom gte 1 and $location isnot "cabin" and ($edenfreedom is 1 and $edendays gt 2 or $edenfreedom is 2 and $edendays gt 7)>>
					<<if $edenfreedom is 1 and $edendays gte 4 or $edenfreedom is 2 and $edendays gte 10>>
						당신이 <span class="red">집으로 돌아오길</span> 바란다.
					<<else>>
						당신을 <span class="blue">걱정하고 있다</span>.
					<</if>>
				<<else>>
					/* edenfreedom checks here should be replaced with trust stat later. edenfreedom = 2 is high trust, 1 is med trust, 0 is low trust. */
					<<if $NPCName[_i].love gte 150>>
						<<if $edenfreedom is 2>>
							당신이 <span class="green"><<nnpc_hers "Eden">></span>라는 걸 안다.
						<<elseif $edenfreedom is 1>>
							당신이 <span class="teal"><<nnpc_him "Eden">>에게 복종할 거라고 확신한다</span>.
						<<else>>
							당신을 <span class="blue"><<nnpc_hers "Eden">> 것으로 두고 싶어 한다</span>.
						<</if>>
					<<elseif $NPCName[_i].love gte 75>>
						<<if $edenfreedom is 2>>
							당신이 <span class="blue"><<nnpc_him "Eden">> 곁에 있어야 한다</span>고 안다.
						<<elseif $edenfreedom is 1>>
							당신이 <span class="purple"><<nnpc_him "Eden">>에게 복종하길</span> 바란다.
						<<else>>
							당신이 <span class="pink"><<nnpc_hers "Eden">> 것임을 상기시키고 싶어 한다</span>.
						<</if>>
					<<else>>
						<<if $edenfreedom is 2>>
							당신이 <span class="purple"><<nnpc_him "Eden">> 곁에 있어야 한다</span>고 안다.
						<<elseif $edenfreedom is 1>>
							당신을 <span class="pink"><<nnpc_him "Eden">>에게 복종하게 만들 것이다</span>.
						<<else>>
							당신을 <span class="red"><<nnpc_hers "Eden">> 것으로 만들고 싶어 한다</span>.
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $location is "cabin">>
					당신을 <span class="red">붙잡아 두고 싶어 한다</span>.
				<<else>>
					당신을 <span class="red">다시 사냥할 것이다</span>.
				<</if>>
			<</if>>
		<<case Sydney>>
			시드니는
			<<if $sydneyromance is 1>>
				<<if $NPCName[_i].purity gt 80>>
					<<if $NPCName[_i].lust gte 60>>
						당신밖에 <span class="lewd">생각하지 못한다</span>.
					<<else>>
						말로 다 못 할 만큼 <span class="lewd">당신을 사랑한다</span>.
					<</if>>
				<<elseif $NPCName[_i].purity gte 40>>
					<<if $NPCName[_i].lust gte 30>>
						당신의 손길을 <span class="lewd">갈망한다</span>.
					<<else>>
						당신에게 <span class="lewd">묶여 있다고 느낀다</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 40>>
					<<if $NPCName[_i].lust gte 20>>
						당신에게 <span class="lewd"><<if $NPCName[_i].virginity.vaginal is true and $NPCName[_i].virginity.penile is true>>처음을 빼앗기고<<else>>더럽혀지고<</if>> 싶어 한다</span>.
					<<else>>
						말로 다 못 할 만큼 <span class="lewd">당신을 사랑한다</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					<<if $NPCName[_i].lust gte 10>>
						당신의 손길을 <span class="lewd">애타게 원한다</span>.
					<<else>>
						당신에게 <span class="lewd">속해 있다</span>.
					<</if>>
				<<else>>
					당신을 <span class="lewd">사랑한다</span>.
				<</if>>
			<<elseif $sydney.heartbroken>>
				<span class="red">상심했다</span>.
			<<elseif $NPCName[_i].love gte 60>>
				<<if $NPCName[_i].purity gte 50>>
					<<if $purity lte 500 or (effectiveTransformationLevel("demon") gte 6)>>
						당신을 <span class="blue">구해주고 싶어 한다.</span>
					<<elseif $temple_rank is "monk" or $temple_rank is "priest" or (effectiveTransformationLevel("angel") gte 6)>>
						당신을 <span class="green">영감을 주는 존재</span>로 여긴다.
					<<elseif $temple_rank is "initiate">>
						당신을 <span class="green">신동</span>으로 여긴다.
					<<else>>
						당신을 <span class="green">매우 좋아한다</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					당신에게 <span class="lewd">영향을 받고 있다</span>.
				<<else>>
					<span class="purple">마음이 찢기듯 흔들린다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 30>>
				<<if $NPCName[_i].purity gte 50>>
					<<if $purity lte 500 or (effectiveTransformationLevel("demon") gte 6)>>
						당신을 <span class="blue">그릇된 길에 빠졌다</span>고 생각한다.
					<<elseif $temple_rank is "monk" or $temple_rank is "priest" or (effectiveTransformationLevel("angel") gte 6)>>
						당신을 <span class="teal">동경한다</span>.
					<<elseif $temple_rank is "initiate">>
						당신을 <span class="teal">동등한 사람</span>으로 본다.
					<<else>>
						당신과 함께 있는 것을 <span class="teal">즐긴다</span>.
					<</if>>
				<<elseif $NPCName[_i].corruption gte 10>>
					당신을 <span class="pink">더 알고 싶어 한다</span>.
				<<else>>
					<span class="purple">갈등하고 있다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 10>>
				<<if $sydneySeen and $sydneySeen.includes("initiate")>>
					<<if $purity lte 500 or (effectiveTransformationLevel("demon") gte 6)>>
						당신이 <span class="pink">길을 잃었다고</span> 생각한다.
					<<else>>
						당신을 <span class="lblue">자랑스럽게 여긴다</span>.
					<</if>>
				<<else>>
					당신에게 <span class="lblue">흥미를 느낀다</span>.
				<</if>>
			<<else>>
				<<if $sydneySeen and $sydneySeen.includes("initiate")>>
					<<if $purity lte 500 or (effectiveTransformationLevel("demon") gte 6)>>
						당신을 <span class="red">이단</span>이라고 생각한다.
					<<elseif $sydney.rank is "initiate" and $temple_rank is "initiate">>
						다른 <span class="blue">입문자를 알게 되어 기뻐한다</span>.
					<<else>>
						다른 <span class="blue">신도를 알게 되어 기뻐한다</span>.
					<</if>>
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Alex>>
			알렉스는
			<<if $alex_countdown is undefined and $farm_stage gte 7>>
				<<if $NPCName[_i].lust gte 60>>
					해가 <<if Time.dayState is "night">>뜰<<else>>질<</if>> 때까지 <span class="lewd">올라타고 싶어 한다</span>.
				<<elseif $NPCName[_i].dom gte 30>>
					<span class="lewd">주도권을 쥐고 있다</span>.
				<<elseif $NPCName[_i].dom lte -30>>
					당신에게 <span class="lewd">의지한다</span>.
				<<else>>
					당신을 <span class="lewd"><<nnpc_his "Alex">> 동반자</span>로 여긴다.
				<</if>>
			<<elseif $farm_stage gte 6>>
				<<if $NPCName[_i].dom gte 30>>
					<span class="pink">주도권을 잡고 있다</span>.
				<<elseif $NPCName[_i].dom lte -30>>
					당신에게 <span class="teal">기댄다</span>.
				<<else>>
					더없이 <span class="blue">고마워한다</span>.
				<</if>>
			<<elseif $farm_stage gte 5>>
				<<if $NPCName[_i].dom gte 10>>
					당신을 <span class="blue">존중한다</span>.
				<<elseif $NPCName[_i].dom lte -10>>
					당신을 <span class="blue">감탄하며 본다</span>.
				<<else>>
					당신에게 <span class="blue">고마워한다</span>.
				<</if>>
			<<elseif $farm_stage gte 4>>
				<<if $NPCName[_i].dom gte 10>>
					당신을 <span class="green">책임감 있다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte -10>>
					당신을 <span class="green">유능하다</span>고 생각한다.
				<<else>>
					당신이 곁에 있는 걸 <span class="green">좋아한다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 10>>
				도움을 받아 <span class="green">기뻐한다</span>.
			<<elseif $NPCName[_i].love lte -10>>
				<<if $NPCName[_i].lust gte 10>>
					당신을 <span class="purple">변태</span>라고 생각한다.
				<<elseif $NPCName[_i].dom gte 10>>
					<span class="red">새 농장 일꾼</span>을 원한다.
				<<else>>
					당신을 <span class="red">골칫거리</span>로 여긴다.
				<</if>>
			<<else>>
				당신에 대해 특별한 생각은 없다.
			<</if>>
		<<case "Ivory Wraith">>
			<<if $wraith>>
				<<if $wraith.hunt and !$wraith.type>>
					원혼은
					<<if $wraith.state is "haunt">>
						당신을 <span class="red">맹렬히 사냥하고 있다</span>.
					<<else>>
						당신을 <span class="blue">따라다니고 있다</span>.
					<</if>>
				<<elseif _rngWraithLineChance is 1>>
					<<if !_rngWraithLine>>
						<<set _rngWraithLine to true>>
						<<silently>><<speechWraith "lines">><</silently>>
					<</if>>
					_line1
				<<else>>
					원혼은
					<<if $wraith.state is "haunt">>
						<<if $NPCName[_i].lust gte 18>>
							<span class="red">광기에 차 있다</span>.
						<<elseif $NPCName[_i].lust gte 14>>
							<span class="pink">격노했다</span>.
						<<else>>
							<span class="purple">원한을 품고 있다</span>.
						<</if>>
					<<elseif $wraith.state is "despair">>
						<<if $NPCName[_i].lust gte 18>>
							<span class="red">광기에 차 있다</span>.
						<<elseif $NPCName[_i].lust gte 14>>
							<span class="pink">고뇌하고 있다</span>.
						<<else>>
							<span class="purple">우울해한다</span>.
						<</if>>
					<<else>>
						<<if $NPCName[_i].lust gte 15>>
							당신에게 <span class="purple">집착하고 있다</span>.
						<<elseif $NPCName[_i].lust gte 6>>
							당신에게 <span class="purple">흥미를 느낀다</span>.
						<<else>>
							당신을 <span class="blue">흥미로운 구경거리</span>로 여긴다.
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<case "Great Hawk">>
			거대 매는
			<<if $syndromebird is 1>>
				<<if $NPCName[_i].love gte 60>>
					<<if $NPCName[_i].dom gte 50>>
						당신을 <span class="lewd"><<if resolveIfNamedBeastIsMonster("greathawk")>><<nnpc_his "Great Hawk">><<else>>자신의<</if>> <<wife>></span>로 삼았다.
					<<elseif $NPCName[_i].dom gte 20>>
						당신을 <span class="lewd"><<if resolveIfNamedBeastIsMonster("greathawk")>><<nnpc_his "Great Hawk">><<else>>자신의<</if>> <<wife>></span>라고 생각한다.
					<<else>>
						당신을 <span class="lewd">좋은 <<wife>></span>라고 생각한다.
					<</if>>
				<<elseif $NPCName[_i].love gte 20>>
					<<if $NPCName[_i].dom gte 50>>
						당신이 <span class="red"><<if resolveIfNamedBeastIsMonster("greathawk")>><<nnpc_his "Great Hawk">><<else>>자신의<</if>> 애정에 답해 주길</span> 바란다.
					<<elseif $NPCName[_i].dom gte 20>>
						<span class="red">몹시 괴로워한다</span>.
					<<else>>
						당신의 애정을 <span class="red">간절히 원한다</span>.
					<</if>>
				<<else>>
					<<if $NPCName[_i].dom gte 50>>
						당신을 <span class="teal">짝</span>으로 원한다.
					<<elseif $NPCName[_i].dom gte 20>>
						<span class="teal">외로워한다</span>.
					<<else>>
						당신에게 <span class="teal">푹 빠져 있다</span>.
					<</if>>
				<</if>>
			<<else>>
				당신이 <span class="red">영원히 머물길</span> 바란다.
			<</if>>
		<<case "Black Wolf">>
			검은 늑대는
			<<if $syndromewolves is 1>>
				<<if $NPCName[_i].love gte $npclovehigh>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						<<print resolveIfNamedBeastIsMonster("blackwolf") ? "확실히" : "왠지">> 당신이 <span class="lewd"><<if resolveIfNamedBeastIsMonster("blackwolf")>><<nnpc_his "Black Wolf">><<else>>자신의<</if>> 짝</span>인 것을 자랑스러워한다.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						<<print resolveIfNamedBeastIsMonster("blackwolf") ? "확실히" : "왠지">> 당신이 <span class="lewd"><<if resolveIfNamedBeastIsMonster("blackwolf")>><<nnpc_his "Black Wolf">><<else>>자신의<</if>> 짝</span>이라 기뻐한다.
					<<else>>
						당신을 <span class="lewd"><<if resolveIfNamedBeastIsMonster("blackwolf")>><<nnpc_his "Black Wolf">><<else>>자신의<</if>> 짝</span>으로 생각한다.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						당신이 <span class="red">무리에서 나가길</span> 바란다.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						당신을 <span class="red">경계한다</span>.
					<<else>>
						당신을 <span class="red">형편없는 무리 동료</span>라고 생각한다.
					<</if>>
				<<else>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						당신을 <span class="pink">강한 무리 동료</span>라고 생각한다.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						당신을 <span class="teal">가치 있는 무리 동료</span>라고 생각한다.
					<<else>>
						무리 안에서 당신의 자리를 <span class="teal">소중히 여긴다</span>.
					<</if>>
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte $npclovehigh>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						당신이 <span class="green">강력한 무리 동료</span>가 될 거라고 생각한다.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						당신이 <span class="green">소중한 무리 동료</span>가 될 거라고 생각한다.
					<<else>>
						당신이 <span class="green">좋은 무리 동료</span>가 될 거라고 생각한다.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						당신이 <span class="red">약한 무리 동료</span>가 될 거라고 생각한다.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						당신이 <span class="red">쓸모없는 무리 동료</span>가 될 거라고 생각한다.
					<<else>>
						당신이 <span class="red">형편없는 무리 동료</span>가 될 거라고 생각한다.
					<</if>>
				<<else>>
					<<if $wolfpackferocity gt $wolfpackharmony>>
						당신과 <span class="pink">드잡이하고 싶어 한다</span>.
					<<elseif $wolfpackharmony gt $wolfpackferocity>>
						당신과 <span class="teal">더 많은 시간을 보내고 싶어 한다</span>.
					<<else>>
						당신에 대해 특별한 생각은 없다.
					<</if>>
				<</if>>
			<</if>>
		<<case Poppy>>
			<<set _i to $NPCNameList.indexOf("Poppy")>>
			<<run statusCheck("Poppy")>>

			<<set _love to $NPCName[_i].love>><<set _lust to $NPCName[_i].lust>>
			<<set _pat to (typeof T.poppyPatience === "number" ? T.poppyPatience : 100)>>

			포피는
			<<if $NPCName[_i].state is "dismissed">>
				당신과 <span class="red">엮이고 싶어 하지 않는다</span>.
			<<else>>
				<!-- High love lust lines (only when patience isn't low) -->
				<<if _love gte 67 and T.poppyLustUnlocked and _pat gte 34 and _lust gte 67>>
					당신에게 <span class="pink">당장이라도 덤벼들 준비가 되어 있다</span>.
				<<elseif _love gte 67 and T.poppyLustUnlocked and _pat gte 34 and _lust gte 34>>
					당신을 <span class="purple">갈망한다</span>.
				<<elseif _love gte 67>>
					<<if _pat gte 67>>
						당신을 <span class="green">몹시 아낀다</span>.
					<<elseif _pat gte 34>>
						당신을 <span class="teal">신경 쓴다</span>.
					<<elseif _pat gte 20>>
						당신을 <span class="blue">이것저것 챙기며 야단법석을 떤다</span>.
					<<elseif _pat gte 10>>
						당신을 <span class="purple">이해하지 못한다</span>.
					<<elseif _pat gte 1>>
						당신을 <span class="pink">구제불능</span>이라고 생각한다.
					<<else>>
						당신을 <span class="red">치워버리고 싶어 한다</span>.
					<</if>>
				<<elseif _love gte 34>>
					<<if _pat gte 67>>
						당신을 <span class="green">귀엽다</span>고 생각한다.
					<<elseif _pat gte 34>>
						당신을 <span class="teal">걱정한다</span>.
					<<elseif _pat gte 20>>
						당신에게 <span class="blue">슬슬 참을성이 바닥나고 있다</span>.
					<<elseif _pat gte 10>>
						당신을 <span class="purple">짜증 나는 사람</span>이라고 생각한다.
					<<elseif _pat gte 1>>
						thinks you're <span class="pink">getting on <<nnpc_his "Poppy">> nerves</span>.
					<<else>>
						당신을 <span class="red">치워버리고 싶어 한다</span>.
					<</if>>
				<<else>>
					<<if _pat gte 67>>
						당신에게 <span class="teal">호기심을 느낀다</span>.
					<<elseif _pat gte 34>>
						당신을 <span class="lblue">참아준다</span>.
					<<elseif _pat gte 20>>
						당신에게 <span class="blue">슬슬 참을성이 바닥나고 있다</span>.
					<<elseif _pat gte 10>>
						당신을 <span class="purple">짜증 나는 사람</span>이라고 생각한다.
					<<elseif _pat gte 1>>
						thinks you're <span class="pink">getting on <<nnpc_his "Poppy">> nerves</span>.
					<<else>>
						당신을 <span class="red">치워버리고 싶어 한다</span>.
					<</if>>
				<</if>>
			<</if>>
		<<case Gwylan>>
			<<run statusCheck("Gwylan")>>
			<<if isGwylanAbsent() is "nobody">><span class="red">아무도</span><<else>>그윌란은<</if>>
			<<if C.npc.Gwylan.state is "scorned">>
				<<if $yearningLetter is 2>>
					숲속 상점에서 당신을 <span class="blue">기다리고 있다</span>.
				<<elseif $gwylanSeen?.includes("yearning_pub")>>
					<span class="pink">토라져 있다</span>.
				<<else>>
					당신의 애정을 <span class="red">매정하게 거절했다</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("ritual_sex") and $gwylan?.timer.ritual and Time.date.dayDifference(new DateTime($gwylan.timer.ritual)) lte 0>>
				<<if $gwylan.hunting gte 2>>
					<<if $gwylanSeen?.includes("romance")>>
						더는 <span class="red">당신 없이는 해낼 수 없다</span>.
					<<else>>
						당신을 <span class="red">찾고 있다</span>.
					<</if>>
				<<elseif _gwylanStatus.includesAny("heat") and _gwylanTF.known>>
					당신과 <span class="lewd">짝짓기하길 갈망한다</span>.
				<<elseif _gwylanStatus.includesAny("aroused", "lust")>>
					숲속 상점에서 당신을 <span class="lewd">간절히 기다리고 있다</span>.
				<<else>>
					당신과 <span class="blue">의식을 치를 준비가 되어 있다</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("romance")>>
				<<if isGwylanAbsent() is "nobody">>
					집에 없다.
				<<elseif $gwylan.taken>>
					<<if $gwylan.taken is "scarred">>
						<span class="red">세상으로부터 당신을 지키고, 당신으로부터 세상을 지킬 것이다</span>.
					<<elseif C.npc.Gwylan.dom gte 140>>
						당신을 <span class="lewd">영원히 어리광 부리게 해 주고 싶어 한다</span>.
					<<else>>
						당신을 <span class="lewd">보살필 것이다</span>.
					<</if>>
				<<elseif $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						당신의 배신으로 <span class="red">망가졌다</span>.
					<<else>>
						당신에게 <span class="red">실망했다</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 140>>
					당신 생각을 <span class="forest-green">멈추지 못한다</span>.
				<<elseif C.npc.Gwylan.dom gte 110>>
					당신 생각을 <span class="green">멈추지 못한다</span>.
				<<elseif C.npc.Gwylan.dom gte 80>>
					온종일 당신을 <span class="green">생각한다</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					당신을 <span class="green">자주 생각한다</span>.
				<<else>>
					당신을 <span class="teal">다정하게 떠올린다</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("partners")>>
				<<if $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						<span class="red">배신감</span>을 느낀다.
					<<else>>
						당신에게 <span class="red">실망했다</span>.
					<</if>>
				<<elseif _gwylanStatus.includes("wantsPregnancy")>>
					당신에게 <span class="pink">푹 빠져 있다</span>.
				<<elseif C.npc.Gwylan.dom gte 140>>
					<span class="witchbloom">갈등하는 듯하다</span>.
				<<elseif _gwylanStatus.includes("heat")>>
					<<if _gwylanTF.known>>
						<span class="pink"><<if C.npc.Gwylan.gender is "m">>러트<<else>>발정기<</if>> 상태다</span>.
					<<else>>
						당신 곁에서 <span class="pink">이상하게 행동한다</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 110>>
					당신 생각을 <span class="green">멈추지 못한다</span>.
				<<elseif C.npc.Gwylan.dom gte 80>>
					온종일 당신을 <span class="green">생각한다</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					당신을 <span class="green">자주 생각한다</span>.
				<<else>>
					당신을 <span class="teal">다정하게 떠올린다</span>.
				<</if>>
			<<elseif $gwylanSeen?.includes("yearning") and C.npc.Gwylan.dom gte 25>>
				<<if $gwylan?.wary gte 2 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					<<if $avery_fate is "ascended" and $auriga_scar gte 1>>
						<span class="red">배신감</span>을 느낀다.
					<<else>>
						당신을 <span class="red">경계한다</span>.
					<</if>>
				<<elseif C.npc.Gwylan.dom gte 75 and $dateCount?.GwylanSex gte 5>>
					당신의 접근에 <span class="pink">넘어가고 있다</span>.
				<<elseif _gwylanStatus.includes("lust")>>
					<span class="pink">흔들리고 있다</span>.
				<<elseif C.npc.Gwylan.dom gte 50>>
					당신과 함께하는 시간을 <span class="teal">즐긴다</span>.
				<<else>>
					모든 게 <span class="purple">예전처럼 돌아가길</span> 바란다.
				<</if>>
			<<else>>
				<<if $gwylan?.wary gt 1 && ($brownFoxRevealed or $gwylanSeen?.includes("auriga_scar"))>>
					당신을 <span class="red">경계한다</span>.
				<<elseif _gwylanStatus.includes("aroused")>>
					당신과 점점 가까워지는 것을 <span class="pink">불안해한다</span>.
				<<elseif _gwylanLovePercent gte 70>>
					당신에게 <span class="green">특별한 무언가가 있음을 안다</span>.
				<<elseif _gwylanLovePercent lt 55 and $gwylanTalked?.length gte 6 and !$daily.gwylan.clothesTalk>>
					당신의 이야기를 <span class="blue">더 듣고 싶어 한다</span>.
				<<elseif _gwylanLovePercent gte 50>>
					당신에게 <span class="teal">특별한 무언가가 있다고 생각한다</span>.
				<<elseif _gwylanLovePercent gte 30>>
					당신에게 <span class="lblue">매료되어 있다</span>.
				<<elseif _gwylanLovePercent gte 20 or $avery_mansion>>
					당신에게 <span class="blue">호기심을 느낀다</span>.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>

		<!-- Persons of interest -->

		<<case Bailey>>
			베일리는
			<<if isRentDue() or isBaileyLookingForPlayer()>>
				<span class="red">거둬 갈 준비가 되어 있다</span>.
			<<elseif $NPCName[_i].love gte 50>>
				<<if C.npc.Bailey.dom gte 70>>
					<<if $syndromeBailey>>knows <span class="bailey-red">you belong to <<nnpc_him "Bailey">></span>.<<else>>thinks <span class="bailey-red">you belong to <<nnpc_him "Bailey">></span>.<</if>>
				<<elseif C.npc.Bailey.dom lte 30>>
					thinks you're <span class="red">in over your head</span>.
				<<else>>
					당신이 <span class="blue">스스로를 건사할 수 있다</span>고 생각한다.
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if C.npc.Bailey.dom gte 70>>
					thinks you're <span class="bailey-red"><<nnpc_hers "Bailey">> to spend</span>.
				<<elseif C.npc.Bailey.dom lte 30>>
					thinks you're almost more <span class="blue">trouble than you're worth</span>.
				<<else>>
					당신을 상품으로 여긴다.
				<</if>>
			<<else>>
				<<if C.npc.Bailey.dom gte 70>>
					considers you <span class="bailey-red">an investment</span>.
				<<elseif C.npc.Bailey.dom lte 30>>
					thinks you're <span class="pink">a little shit</span>.
				<<else>>
					당신을 미끼로 여긴다.
				<</if>>
			<</if>>
			<<if $syndromeBailey>>
				<br><span class="bailey-stockholm">You are not going anywhere.</span>
			<</if>>
		<<case Briar>>
			브라이어는
			<<if $brothelshowdata?.missed>>
				당신을 <span class="red">찾고 있다</span>.
			<<elseif $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].dom gte 25>>
					당신을 <span class="green"><<nnpc_his "Briar">> 스타</span>로 여긴다.
				<<else>>
					당신의 성공을 <span class="teal">흡족해한다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].dom gte 25>>
					당신이 <span class="blue">끝까지 해낼 수 있다</span>고 생각한다.
				<<else>>
					당신에게 <span class="blue">자질이 있다</span>고 생각한다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신을 <span class="red">흔해 빠진 창녀</span>라고 생각한다.
				<<else>>
					당신을 <span class="red">프로답지 못하다</span>고 생각한다.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					당신이 <span class="purple">더 열심히 일하길</span> 바란다.
				<<else>>
					당신에게 <span class="pink">별 감흥이 없다</span>.
				<</if>>
			<</if>>
		<<case Charlie>>
			찰리는
			<<if $danceskill gte 800>>
				<<if $NPCName[_i].love gte 35>>
					당신을 <span class="green"><<nnpc_his "Charlie">> 스타 제자</span>로 여긴다.
				<<else>>
					당신의 재능을 <span class="teal">알아본다</span>.
				<</if>>
			<<elseif $danceskill gte 400>>
				<<if $NPCName[_i].love gte 35>>
					수업에서 당신을 보길 <span class="teal">기대한다</span>.
				<<else>>
					당신의 잠재력을 <span class="blue">보고 있다</span>.
				<</if>>
			<<elseif $danceskill gte 200>>
				<<if $NPCName[_i].love gte 35>>
					당신을 가르치게 되어 기뻐한다.
				<<else>>
					당신이 발전하도록 돕고 싶어 한다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신을 <span class="red">건방진 학생</span>으로 여긴다.
			<<else>>
				기초부터 알려 주고 싶어 한다.
			<</if>>
		<<case Darryl>>
			데릴은
			<<if $NPCName[_i].love gte 40>>
				<<if $NPCName[_i].dom gte 25>>
					당신을 <span class="green">안전하게 지키고 싶어 한다</span>.
				<<else>>
					당신이 <span class="teal"><<nnpc_his "Darryl">> 삶에 있어 줘서 고마워한다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 20>>
				<<if $NPCName[_i].dom gte 25>>
					당신이 이용당하고 있지 않을까 <span class="blue">걱정한다</span>.
				<<else>>
					당신에게서 <span class="blue">위안을 느낀다</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신에게 <span class="red">실망했다</span>.
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					당신이 조심하고 있길 바란다.
				<<else>>
					당신에게 성장할 여지가 있다고 생각한다.
				<</if>>
			<</if>>
		<<case Doren>>
			도렌은
			<<if $dorenintro gte 1>>
				<<if $NPCName[_i].love gte 50>>
					당신을 <span class="green">살펴 준다</span>.
				<<else>>
					기꺼이 <span class="teal">당신의 말을 들어 주려 한다</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신에게 <span class="red">더 나은 모습을 기대한다</span>.
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					다른 학생들도 당신 같은 열정이 있길 <span class="green">바란다</span>.
				<<elseif $NPCName[_i].love gte 25>>
					당신을 <span class="teal">훌륭한 학생</span>으로 여긴다.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Harper>>
			하퍼는
			<<if $awareness gte 400>>
				<<if $NPCName[_i].love gte 50>>
					당신을 <span class="red">치료하고 싶어 안달이다</span>.
				<<else>>
					당신을 <span class="red">연구하고 싶어 한다</span>.
				<</if>>
			<<elseif $awareness gte 200>>
				<<if $NPCName[_i].love gte 50>>
					당신의 경과를 <span class="blue">주의 깊게 지켜보고 있다</span>.
				<<else>>
					당신의 안녕을 <span class="blue">걱정하고 있다</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신을 <span class="red">한심하다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					당신을 <span class="red">짜증 난다</span>고 생각한다.
				<<else>>
					당신을 <span class="red">형편없다</span>고 생각한다.
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					당신이 무사해 <span class="green">기뻐한다</span>.
				<<else>>
					당신의 상태를 <span class="green">확인하고 싶어 한다</span>.
				<</if>>
			<</if>>
		<<case Jordan>>
			조던은
			<<if $NPCName[_i].love gte 50>>
				당신을 <span class="green">신앙의 소중한 일원</span>으로 여긴다.
			<<elseif $NPCName[_i].love gte 25>>
				당신의 헌신에 <span class="teal">감명받았다</span>.
			<<else>>
				당신을 위해 기도한다.
			<</if>>
		<<case Landry>>
			<<set $_mickey to $mickeyPub gte 2>>
			랜드리<<if $_mickey>>【와과】 미키<</if>>【은는】
			<<if $moneyStats?.pubStolenGoods?.earned gte 800000>>
				<<if $pub_task_stat gte 25>>
					당신이 <span class="green"><<if $_mickey>>그들<<else>><<nnpc_his "Landry">><</if>> 편이라 기뻐한다</span>.
				<<else>>
					<<if $_mickey>><span class="teal">당신의 재주에 감탄한다</span>.<<else>><span class="teal">당신의 손버릇에 감탄한다</span>.<</if>>
				<</if>>
			<<elseif $moneyStats?.pubStolenGoods?.earned gte 400000>>
				<<if $pub_task_stat gte 25>>
					당신을 <span class="teal">도움 되는 사람</span>으로 여긴다.
				<<else>>
					당신을 <span class="teal">돈 되는 사람</span>으로 여긴다.
				<</if>>
			<<elseif $moneyStats?.pubStolenGoods?.earned gte 100000>>
				<<if $pub_task_stat gte 25>>
					당신을 <span class="blue">쓸모 있는 사람</span>으로 여긴다.
				<<else>>
					당신에게 좋은 성과를 기대한다.
				<</if>>
			<<else>>
				당신에 대해 특별한 생각은 없다.
			<</if>>
		<<case Leighton>>
			레이튼은
			<<if $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].dom gte 20>>
					<<if $headdrive is 1>>
						당신 전용 <span class="red">폴더</span>를 가지고 있다.
					<<else>>
						당신에게 <span class="lewd">특별한 관심</span>을 보인다.
					<</if>>
				<<else>>
					<<if $delinquency gte 400>>
						당신의 평판을 알고 있다.
					<<else>>
						당신을 <span class="lewd">모범생</span>으로 여긴다.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].dom gte 20>>
					당신을 <span class="lewd">열정적인 학습자</span>로 본다.
				<<else>>
					<<if $delinquency gte 400>>
						당신의 평판을 알고 있다.
					<<else>>
						당신이 학구적이라는 것을 알아본다.
					<</if>>
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신에게 <span class="red">따끔한 가르침이 필요하다</span>고 생각한다.
			<<else>>
				<<if $NPCName[_i].dom gte 20>>
					당신에게 <span class="lewd">실습 교육이 필요하다</span>고 생각한다.
				<<else>>
					<<if $delinquency gte 400>>
						당신의 평판을 알고 있다.
					<<else>>
						당신을 지켜보고 있다.
					<</if>>
				<</if>>
			<</if>>
		<<case Mason>>
			메이슨은
			<<if $NPCName[_i].love gte 35>>
				<<if $NPCName[_i].lust gte 40>>
					당신을 <span class="lewd"><<nnpc_his "Mason">> 머릿속에서 떨쳐 내지 못한다</span>.
				<<else>>
					당신이 여기까지 온 것을 <span class="green">자랑스럽게 여긴다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 15>>
				<<if $NPCName[_i].lust gte 30>>
					당신에게 <span class="lewd">흥미</span>가 있다.
				<<else>>
					당신이 잘되길 바란다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신이 <span class="red">스스로를 몰아붙이길</span> 바란다.
			<<else>>
				<<if $NPCName[_i].lust gte 20>>
					당신을 <span class="lewd">성가신 존재</span>로 여긴다.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Morgan>>
			모건은
			<<if $NPCName[_i].love gte 50>>
				당신을 <span class="red">탐낸다</span>.
			<<elseif $NPCName[_i].love gte 25>>
				당신을 <span class="pink">되찾고 싶어 한다</span>.
			<<else>>
				당신을 <span class="purple">원한다</span>.
			<</if>>
		<<case River>>
			리버는
			<<if $NPCName[_i].love gte 40>>
				당신이 <span class="green">크게 될 것</span>이라고 생각한다.
			<<elseif $NPCName[_i].love gte 20>>
				당신을 <span class="teal">눈여겨본다</span>.
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신에게 <span class="red">더 나은 모습을 기대한다</span>.
			<<else>>
				<<if $soup_kitchen_known is 1>>
					당신에 대해 <span class="blue">확신하지 못한다</span>.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Sam>>
			샘은
			<<if $chef_state gte 1>>
				<<if $chef_state gte 9>>
					당신에게 <span class="gold">더할 나위 없이 만족한다</span>.
				<<elseif $chef_sus gte 50>>
					당신의 과정에 대해 <span class="pink">의문을 품고 있다</span>.
				<<elseif $NPCName[_i].love gte 25>>
					당신을 <span class="green">이달의 직원</span>으로 여긴다.
				<<else>>
					당신이 셰프로 잘 자리 잡길 <span class="teal">기대한다</span>.
				<</if>>
			<<else>>
				<<if $NPCName[_i].love gte 10>>
					당신을 <span class="teal">믿기 시작했다</span>.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Sirris>>
			시리스는
			<<if $adultshopunlocked>>
				<<if $NPCName[_i].love gte 50>>
					<<if $sydneyromance gte 1 and $sydneySeen?.includes("parent") and pregnancyCompatible("Sydney") and $rng gte 51>>
						<span class="green">손주를 바란다</span>.
					<<else>>
						당신이 해 준 모든 일에 <span class="teal">감사해한다</span>.
					<</if>>
				<<else>>
					당신을 <span class="teal">사려 깊다</span>고 생각한다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신이 <span class="red">더 잘할 수 있다는 것을 안다</span>.
			<<else>>
				<<if $NPCName[_i].love gte 50>>
					다른 학생들도 당신 같은 열정이 있길 <span class="green">바란다</span>.
				<<elseif $NPCName[_i].love gte 25>>
					당신을 <span class="teal">훌륭한 학생</span>으로 여긴다.
				<<else>>
					<<if $adultshopintro>>
						당신의 도움이 <span class="blue">필요할지도 모른다</span>.
					<<else>>
						당신에 대해 특별한 생각은 없다.
					<</if>>
				<</if>>
			<</if>>
		<<case Winter>>
			윈터는
			<<if $NPCName[_i].love gte 75>>
				<<museumAntiqueText>>
				<<set $_antiquesFound to Object.entries($museumAntiques.antiques).filter(([name, status]) => _museumAntiqueText[name] && status !== "notFound").length>>
				<<set $_paintingsFound to Object.values($museumAntiques.paintings).filter(status => status !== "notFound").length>>
				<<set $_totalFound to $_antiquesFound + $_paintingsFound>>
				<<if $_totalFound is $museumAntiques.maxCount + Object.values($museumAntiques.paintings).length>>
					당신을 <span class="green">동료 역사학자</span>로 본다.
				<<else>>
					당신을 <span class="green"><<nnpc_his "Winter">> 조수</span>로 여긴다.
				<</if>>
			<<elseif $NPCName[_i].love gte 50>>
				역사를 존중하는 당신의 태도에 <span class="teal">감명받았다</span>.
			<<elseif $NPCName[_i].love gte 25>>
				당신의 도움에 <span class="teal">감사해한다</span>.
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신을 <span class="red">건방지다</span>고 생각한다.
			<<else>>
				당신에 대해 특별한 생각은 없다.
			<</if>>
		<<case Niki>>
			니키는
			<<if $photo_known gte 2>>
				<<if $NPCName[_i].love gte 50>>
					<<if $fame.model gte 2000>>
						당신을 <span class="green"><<nnpc_his "Niki">> 뮤즈</span>로 여긴다.
					<<else>>
						당신을 <span class="green">프로</span>로 여긴다.
					<</if>>
				<<elseif $NPCName[_i].love gte 25>>
					당신을 <span class="teal">동료</span>로 여긴다.
				<<elseif $NPCName[_i].love lte $npclovelow>>
					당신을 <span class="red">불쾌한 사람</span>으로 여긴다.
				<<else>>
					당신을 <span class="blue">초보자</span>로 여긴다.
				<</if>>
			<<else>>
				당신에 대해 특별한 생각은 없다.
			<</if>>
		<<case Quinn>>
			퀸은
			<<if $NPCName[_i].love gte 50>>
				<<if $NPCName[_i].lust gte 40>>
					당신을 <span class="red">멋지다</span>고 생각한다.
				<<else>>
					당신을 <span class="pink">감시하고 있다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 25>>
				<<if $NPCName[_i].lust gte 30>>
					당신에게 <span class="purple">흥미를 품었다</span>.
				<<else>>
					당신을 <span class="blue"><<nnpc_his "Quinn">> 레이더망에 올려 두었다</span>.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				당신을 <span class="red">형편없다</span>고 생각한다.
			<<else>>
				<<if $NPCName[_i].lust gte 20>>
					당신을 <span class="blue"><<nnpc_his "Quinn">> 머릿속 한구석에 담아 두고 있다</span>.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
		<<case Remy>>
			레미는
			<<if $livestock.intro isnot undefined>>
				<<if $NPCName[_i].love gte 50>>
					<<if $NPCName[_i].dom gte 25>>
						당신을 <span class="red">무리의 자랑</span>으로 여긴다.
					<<else>>
						당신이 그렇게 반항적이지 않았으면 한다.
					<</if>>
				<<elseif $NPCName[_i].love gte 25>>
					<<if $NPCName[_i].dom gte 25>>
						당신의 생산량에 <span class="pink">만족한다</span>.
					<<else>>
						당신에게 <span class="purple">분수를 알려 줄 생각</span>이다.
					<</if>>
				<<elseif $NPCName[_i].love lte $npclovelow>>
					<<if $NPCName[_i].dom gte $npcdomhigh>>
						당신이 가진 만큼 <span class="red">모조리 짜낼 것이다</span>.
					<<elseif $NPCName[_i].dom lte $npcdomlow>>
						당신을 <span class="red">꺾어 놓기로 작정했다</span>.
					<<else>>
						당신을 <span class="red">고집 센 <<pcow>></span>라고 생각한다.
					<</if>>
				<<else>>
					<<if $NPCName[_i].dom gte 25>>
						당신의 산출량을 <span class="purple">늘리는 데 전념한다</span>.
					<<else>>
						당신은 <span class="red">꺾여야 한다</span>고 생각한다.
					<</if>>
				<</if>>
			<<else>>
				당신에 대해 특별한 생각은 없다.
			<</if>>
		<<case Wren>>
			렌은
			<<if $NPCName[_i].love gte 35>>
				<<if $NPCName[_i].dom gte 25>>
					당신을 <span class="green">재미있다</span>고 여긴다.
				<<else>>
					무엇이든 <span class="green">해 볼 생각</span>이다.
				<</if>>
			<<elseif $NPCName[_i].love gte 15>>
				<<if $NPCName[_i].dom gte 25>>
					당신에게 <span class="teal">흥미를 느낀다</span>.
				<<else>>
					당신을 <span class="teal">재미있다</span>고 생각한다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신은 <span class="red">믿을 수 없다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					당신을 <span class="red">사기꾼</span>이라고 생각한다.
				<<else>>
					당신을 <span class="red">골칫거리</span>로 여긴다.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte 25>>
					당신을 <span class="pink">귀엽지만 지루하다</span>고 생각한다.
				<<else>>
					당신 곁에서는 조심스럽게 군다.
				<</if>>
			<</if>>
		<<case Luchifen>>
			/* Hidden stranger: name shown only as a glowing "???", and no opinion line until the player has drawn their interest.
			   After the island reveal the line follows the invitation story first, then their Favor. */
			<<if $xchange.arcology and $xchange.arcology.redeem and $xchange.arcology.redeem.stage is "silent">>
				<<silverName>> <span class="red">won't acknowledge you.</span>
			<<elseif $xchange.arcology and $xchange.arcology.redeem and $xchange.arcology.redeem.stage is "arena">>
				<<silverName>> is waiting to see you <span class="gold">become champion</span>.
			<<elseif $xchange.silverStranger and $xchange.silverStranger.nameKnown>>
				<<if $NPCName[_i].love gte 30>>
					<<silverName>> <span class="green">keeps you close</span>, somehow.
				<<elseif $NPCName[_i].love gte 10>>
					<<silverName>> <span class="teal">approves of you</span>.
				<<else>>
					<<silverName>> is watching what you do.
				<</if>>
			<<elseif $NPCName[_i].love gt 0>>
				<<silverName>> wants to know more about you.
			<</if>>
		<<case Zephyr>>
			제퍼는
			<<if $NPCName[_i].love gte 75>>
				<<if $pirate_rank is 1>>
					당신이 <span class="green">세상을 보길</span> 바란다.
				<<else>>
					당신에게 <span class="green">세상을 보여 줄 것이다</span>.
				<</if>>
			<<elseif $NPCName[_i].love gte 50>>
				당신과 함께하는 <span class="teal"><<nnpc_his "Zephyr">> 모험을 즐긴다</span>.
			<<else>>
				당신을 온실 속 화초처럼 여긴다.
			<</if>>
		<<case Riley>>
			Riley
			<<if $mmaGymAssessmentPassed is 1 or $mmaGymAccessUnlocked is 1>>
				<<if $NPCName[_i].love gte 45>>
					looks <span class="gold">proud of you</span>.
				<<else>>
					thinks you've <span class="green">grown strong</span>.
				<</if>>
			<<elseif $mmaConditioningUnlocked is 1 or $mmaSparUnlocked is 1>>
				thinks you're <span class="teal">still need more training</span>.
			<<else>>
				thinks you <span class="red">need help getting stronger</span>.
			<</if>>

		<!-- Default cases -->
		<<default>>
			<<print window.KR.gatPersonNameDictKR(_npc)>>【은는】 
			<<if $NPCName[_i].love gte $npclovehigh>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신을 <span class="green">사랑스럽다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					당신을 <span class="green">영감을 주는 사람</span>으로 여긴다.
				<<else>>
					당신을 <span class="green">기분 좋은 사람</span>으로 여긴다.
				<</if>>
			<<elseif $NPCName[_i].love lte $npclovelow>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신을 <span class="red">한심하다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					당신을 <span class="red">짜증 난다</span>고 생각한다.
				<<else>>
					당신을 <span class="red">형편없다</span>고 생각한다.
				<</if>>
			<<else>>
				<<if $NPCName[_i].dom gte $npcdomhigh>>
					당신을 <span class="pink">귀엽다</span>고 생각한다.
				<<elseif $NPCName[_i].dom lte $npcdomlow>>
					당신을 <span class="teal">동경한다</span>.
				<<else>>
					당신에 대해 특별한 생각은 없다.
				<</if>>
			<</if>>
	<</switch>>
<</widget>>

<<widget "push_nnpc_genderknown">>
	<!-- Can be used in any situation to let all active named NPCs known the player's gender -->
	<!-- Use _args[0] to ignore clothing -->
	<!-- Won't ignore the chastity belt's "hidden" property (for now) -->
	<<if _args[0] or $exposed gte 2>>
		<<if !playerChastity("hidden")>>
			<<for _npc range $npc>>
				<<if $genderknown.includes(_npc) and !$xchange.known.includes(_npc) and $xchange.expectedGenderBy[_npc] isnot $player.sex>>
					<<run $xchange.known.pushUnique(_npc)>>
				<</if>>
			<</for>>
			<<run $npc.forEach(npc => $genderknown.pushUnique(npc))>>
			<<run $npc.forEach(npc => $xchange.expectedGenderBy[npc] = $player.sex)>>
		<</if>>
	<</if>>
<</widget>>
