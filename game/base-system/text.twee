<<widget "hes">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
	<</if>>
	<<if $pronoun is "m">>
		<<set _text_output to "그는">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "그녀는">>
	<<elseif $pronoun is "i">>
		<<set _text_output to "그것은">>
	<<elseif $pronoun is "n">>
		<<set _text_output to "그 사람은">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "그들은">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class="red">[에러: "hes"에서 알 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[에러: "hes"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "his">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
	<</if>>
	<<if $pronoun is "m">>
		<<set _text_output to "그의">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "그녀의">>
	<<elseif $pronoun is "i">>
		<<set _text_output to "그것의">>
	<<elseif $pronoun is "n">>
		<<set _text_output to "그의">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "그들의">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class=\"red\">[에러: \"his\"에서 알 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class=\"red\">[에러: \"his\"에서 정의되지 않은 대명사]</span>`>>
