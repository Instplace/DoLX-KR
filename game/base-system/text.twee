<<widget "crime">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">범죄</span>
		<<if _args[0]>>
			<<crimeType _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "crimes">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">범죄</span>
		<<if _args[0]>>
			<<set $_crimeTypes to _args>>
			<<set $_crimeDisplay to []>>
			<<for $_crimeKey range $_crimeTypes>>
				<<if !setup.crimeNames[$_crimeKey]>>
					<<run Errors.report("추가 불법 범죄가 표시됨: " + $_crimeKey)>>
				<<else>>
					<<set $_crimeDisplay.push(toTitleCase(setup.crimeNames[$_crimeKey]))>>
				<</if>>
			<</for>>
			<span class="red">(<<print formatList($_crimeDisplay)>>)</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "combatcrime">>
	<<if !$settings.blindStatsEnabled>>
		<span class="red">범죄</span>
		<<if _args[0]>>
			<<crimeType _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "gcrime">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">+ 범죄도</span>
		<<if _args[0]>>
			<<crimeType _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "ggcrime">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">+ + 범죄도</span>
		<<if _args[0]>>
			<<crimeType _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "gggcrime">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">+ + + 범죄도</span>
		<<if _args[0]>>
			<<crimeType _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "crimeType">>
	<<if _args[0]>>
		<<set $_crimeType to _args[0]>>
		<<if !setup.crimeNames[$_crimeType] and $_crimeType isnot "???">>
			<<run Errors.report("추가 불법 범죄가 표시됨: " + $_crimeType)>>
		<<else>>
			<<if $_crimeType isnot "???">>
				<<set $_crimeType to setup.crimeNames[$_crimeType].toUpperFirst()>>
			<</if>>
			<span class="red">($_crimeType)</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "gspray">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="green">+ 후추 스프레이 1개</span>
	<</if>>
<</widget>>

<<widget "gspraymax">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="gold">+ 후추 스프레이 용량 1</span>
	<</if>>
<</widget>>

<<widget "gcondoms">>
	<<set $_condomGain to (_args[0] ? _args[0] : 1)>>
	<<set $_damagedCondomGain to _args[1] is "damaged">>
	<<if $condoms eq undefined>><<set $condoms to 0>><</if>>
	<<set $condoms += $_condomGain>>
	<<if $_damagedCondomGain>>
		<<if $damagedCondoms eq undefined>><<set $damagedCondoms to 0>><</if>>
		<<set $damagedCondoms += $_condomGain>>
	<</if>>
	<<if !$settings.blindStatsEnabled>> |
		<span class="pink">+ $_condomGain <<if $_damagedCondomGain>>낡은 <</if>>콘돔</span>
	<</if>>
<</widget>>

<<widget "defianttext">>
	<<if !$settings.blindStatsEnabled>> |
		<<if _args[0]>>
			<<if (effectiveTransformationLevel("wolf") gte 6) and $submissive gt _args[0]>>
				<span @class="'def ' + basicJitterCss()">반항적인</span>
			<<else>>
				<span class="def">반항적인</span>
			<</if>>
		<<else>>
			<span class="def">반항적인</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "submissivetext">>
