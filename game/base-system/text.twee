<<widget "lassie">><<silently>>
	<<set _playerPronoun to npcAddressPronoun("Doren")>>
	<<if _playerPronoun is "n">>
		<<set _text_output to "꼬마">>
	<<elseif C.npc.Doren.love gte 50>>
		<<set _text_output to (_playerPronoun is "m" ? "꼬마 녀석" : "꼬마 아가씨")>>
	<<else>>
		<<set _text_output to (_playerPronoun is "m" ? "녀석" : "아가씨")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "Lassie">><<silently>>
	<<lassie>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcSex">><<silently>>
	<!-- A herm is a body with both sets of genitals, not a third value of $player.sex. -->
	<<if $player.penisExist and $player.vaginaExist>>
		<<set _text_output to "양성구유자">>
	<<else>>
		<<switch $player.sex>>
		<<case "f">><<set _text_output to "소녀">>
		<<case "m">><<set _text_output to "소년">>
		<<default>><<set _text_output to "사람">>
		<</switch>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcGender">><<silently>>
	<<set _text_output to playerGenderWord()>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcGenderher">><<silently>>
	<<set _text_output to playerGenderPossessive()>>
<</silently>><<print _text_output>><</widget>>

<<widget "genitals_are">><<silently>>
	<<if _args[0]>>
		<<genitals _args[0]>>
	<<else>>
		<<genitals>>
	<</if>>
	<<if $player.penisExist and $player.vaginaExist and (!playerChastity() or _args[0] isnot undefined)>>
		<<set _text_output += "">>
	<<else>>
		<<set _text_output += "">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "genitalsensitivity">><<silently>>
	<<if (V.substanceRebalance == 1)>>
		<<set _drugMod to 1 + V.drugged / 250>>
	<<else>>
		<<set _drugMod to 1 + V.drugged / 1000>>
	<</if>>
	<<if getSensitivity("genital") * _drugMod > 3.5>>
		<<set _text_output to "민감한 ">>
	<<elseif getSensitivity("genital") * _drugMod >= 2.5>>
		<<set _text_output to "여린 ">>
	<<elseif getSensitivity("genital") * _drugMod >= 1.5>>
		<<set _text_output to "잘 느끼는 ">>
	<<else>>
		<<set _text_output to "">>
	<</if>>
	<<set _genitalSensitivityDescribed to true>>
<</silently>><<print _text_output>><</widget>>

<!--
	Optional parameter [0] possible values:
	0 or omitted or null - display chastity, virginity, arousal, and pubes
	1 - omit chastity, display virginity, arousal, and pubes
	2 - omit chastity, virginity, arousal, sensitivity, and pubes
 -->
<<widget "genitals">><<silently>>
	<<if playerChastity("hidden") and !_args[0] and _chastityBreak isnot 1>>
		<<set _text_output to $worn.genitals.name>>
	<<else>>
		<<if _args[0] is 2>>
			<<set _text_output to "">>
		<<else>>
			<<genitalsensitivity>>
		<</if>>
		<<if $player.penisExist>>
			<<if _args[0] isnot 1 and _args[0] isnot 2>>
				<<if $worn.genitals.name is "chastity parasite">>
					<<set _text_output += "봉인된 ">>
				<<elseif playerChastity("cage")>>
					<<set _text_output += "구속된 ">>
				<</if>>
			<</if>>
			<<if $player.virginity.penile is true and _args[0] isnot 2>>
				<<set _text_output += "순결한 ">>
			<</if>>
			<<if $player.vaginaExist and $parasite.clit.name is "parasite" and _args[0] isnot 2>>
				<<set _text_output += "기생하는 ">>
			<</if>>
			/* _args[0] is a flag to prevent .pluck() from altering state random when calling from overlays */
			<<set _text_output += penisNames().pluck(_args[0])>>
		<</if>>
		<<if $player.vaginaExist>>
			<<if $player.penisExist>>
				<<set _text_output += "【와과】 ">>
			<</if>>
			<<if _args[0] isnot 2>>
				<<if $vaginaWetness gte 75 and $settings.pubicHairEnabled and $pblevel gte 8>>
					<<set _text_output += $player.penisExist ? "눈에 띄게 흥분하고 덥수룩한 " : "눈에 띄게 흥분한 덥수룩한 ">>
				<<elseif $vaginaWetness gte 75>>
					<<set _text_output += "눈에 띄게 흥분한 ">>
				<<elseif $settings.pubicHairEnabled and $pblevel gte 8>>
					<<set _text_output += "덥수룩한 ">>
				<</if>>
				<<if $player.virginity.vaginal is true>>
					<<set _text_output += "virgin ">>
				<</if>>
			<</if>>
			/* _args[0] is a flag to prevent .pluck() from altering state random when calling from overlays */
			<<set _text_output += pussyNames().pluck(_args[0])>>
		<</if>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<!-- optionally takes 2 parameters: what to add after the text for singular/plural -->
<<widget "genitalsandbreasts">>
	<<genitals>> <<if $player.breastsize gte 1>>그리고 <<breasts>><</if>>
	<<if _args[0] isnot undefined and _args[1] isnot undefined>>
		<<if ($player.penisExist and $player.vaginaExist) or $player.breastsize gte 1>>
			_args[1]
		<<else>>
			_args[0]
		<</if>>
	<</if>>
<</widget>>

<<widget "sydneyWarning">>
	<<if !$settings.blindStatsEnabled>>
		<<if _args[0] is "corrupt" and $corruptionEvent is 1 and C.npc.Sydney.corruption is 0 and (C.npc.Sydney.purity - 10) lt 0>>
			| <span class="purple">이 행동으로 시드니를 타락시킬 수 있습니다</span>
		<<elseif _args[0] is "purify" and $purityEvent is 1 and C.npc.Sydney.purity is 0 and (C.npc.Sydney.corruption - 10) lt 0>>
			| <span class="teal">이 행동으로 시드니를 순결하게 만들 수 있습니다</span>
		<<else>>
			<<switch _warnstate>>
				<<case 1>>
					<<if $purityEvent is 1 and C.npc.Sydney.purity is 0 and (C.npc.Sydney.corruption - 2) lt 0>>
						| <span class="teal">이 행동으로 시드니를 순결하게 만들 것입니다</span>
					<</if>>
				<<case 2>>
					<<if $purityEvent is 1 and C.npc.Sydney.purity is 0 and (C.npc.Sydney.corruption - 5) lt 0>>
						| <span class="teal">이 행동으로 시드니를 순결하게 만들 것입니다</span>
					<</if>>
				<<case 3>>
					<<if $purityEvent is 1 and C.npc.Sydney.purity is 0 and (C.npc.Sydney.corruption - 10) lt 0>>
						| <span class="teal">이 행동으로 시드니를 순결하게 만들 것입니다</span>
					<</if>>
				<<case -1>>
					<<if $corruptionEvent is 1 and C.npc.Sydney.corruption is 0 and (C.npc.Sydney.purity - 2) lt 0>>
						| <span class="purple">이 행동으로 시드니를 타락시킬 것입니다</span>
					<</if>>
				<<case -2>>
					<<if $corruptionEvent is 1 and C.npc.Sydney.corruption is 0 and (C.npc.Sydney.purity - 5) lt 0>>
						| <span class="purple">이 행동으로 시드니를 타락시킬 것입니다</span>
					<</if>>
				<<case -3>>
					<<if $corruptionEvent is 1 and C.npc.Sydney.corruption is 0 and (C.npc.Sydney.purity - 10) lt 0>>
						| <span class="purple">이 행동으로 시드니를 타락시킬 것입니다</span>
					<</if>>
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "gsydneytoy">>
	<<if $sydney_toy is undefined>>
		| <span class="purple">시드니는 <<print window.KR.getToolKr(_args[0])>>【을를】 나중에 쓰려고 간직할 것입니다</span>
	<<elseif $sydney_toy isnot _args[0]>>
		| <span class="purple">시드니는 원래 있던 <<print window.KR.getToolKr($sydney_toy)>> 대신 <<print window.KR.getToolKr(_args[0])>>【을를】 나중에 쓰려고 간직할 것입니다</span>
	<</if>>
<</widget>>

<<widget "flight_text">>
	<<if $statdisable is "f">> |
		<<if Transformations.hasFlightWings() and $birdFly gte 1>>
			<<if $plucked>>
				<span class="grey">다듬어진 날개</span>
			<<else>>
				<span class="gold">튼튼한 날개</span>
			<</if>>
		<<elseif Transformations.hasWings()>>
			<span class="gold">날개</span>
		<</if>>
	<</if>>
<</widget>>

<!-- Awareness -->

<<widget "combataware">>
	<<if !$settings.blindStatsEnabled>>
		<<set _color to ["","teal","lblue","blue","purple","pink"][_args[0]]>>
		<span @class="_color">성지식 _args[0]</span>
	<</if>>
<</widget>>

<!-- Exhibitionism -->

<<widget "exhibitionist">>
	<<if !$settings.blindStatsEnabled>> |
		<<if hasSexStat("exhibitionism", _args[0]) and !hasSexStat("exhibitionism", _args[0], false) and $awareness lt 0>>
			<<set _classList to basicInnocenceCss()>>
		<<elseif hasSexStat("exhibitionism", _args[0], 1) and !hasSexStat("exhibitionism", _args[0], false) and $drunk gte 1>>
			<<set _classList to basicDrunkCss()>>
		<<else>>
			<<set _classList to ["","teal","lblue","blue","purple","pink","red"][_args[0]]>>
		<</if>>
		<<set _classList += " " + getLargestSexStatModifierCssClasses("exhibitionism", _args[0])>>
		<<if _args[0] is 6>>
			<span @class="_classList">!노출증 6!</span>
		<<else>>
			<span @class="_classList">노출증 _args[0]</span>
		<</if>>
		<<if _desperateaction>>
			| <span class="red">필사적인 행동</span>
		<</if>>
	<</if>>
<</widget>>

