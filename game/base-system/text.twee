<<widget "victimgirl">>
	<<if $settings.maleVictimChance is 0>>
		<<set _text_output to "소녀">>
	<<elseif $settings.maleVictimChance is 100>>
		<<set _text_output to "소년">>
	<<elseif perceivedGender() is "m">>
		<<set _text_output to "소년">>
	<<else>>
		<<set _text_output to "소녀">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "victimgirls">>
	<<if $settings.maleVictimChance is 0>>
		<<set _text_output to "소녀들">>
	<<elseif $settings.maleVictimChance is 100>>
		<<set _text_output to "소년들">>
	<<elseif perceivedGender() is "m">>
		<<set _text_output to "소년들">>
	<<else>>
		<<set _text_output to "소녀들">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "lass">><<silently>>
	<<set _playerPronoun to npcAddressPronoun(_args[0])>>
	<<set _text_output to (_playerPronoun is "m" ? "녀석" : _playerPronoun is "f" ? "아가씨" : "젊은이")>>
	<<misgender _playerPronoun>>
<</silently>><<print _text_output>><</widget>>

