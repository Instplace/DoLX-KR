	<<set _text_output to (_playerPronoun is "m" ? "아빠" : _playerPronoun is "f" ? "엄마" : "부모")>><<gendercheck _playerPronoun>>
<</silently>>_text_output<</widget>>

<<widget "pMum">><<silently>>
	<<pmum _args[0]>><<capitalise>>
<</silently>>_text_output<</widget>>

