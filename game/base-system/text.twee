<<widget "hairmapcolourtext">>
	<<set _hairMapRecord to setup.guessColourInMap(setup.colours.hair_map, _args[0])>>
	<<if _hairMapRecord>>
		<<print _hairMapRecord.name>>
	<<elseif _args[0] and !_colour>>
		<<print _args[0]>>
	<<else>>
		<<print _colour>>
	<</if>>
<</widget>>

<<widget "haircolourtext">>
	<<if $hairColourStyle == "gradient">>
		<<set _color1 to $dhmod.hair.is_custom ? $dhmod.hair.colors[1] : $hairColourGradient.colours[1]>>
		<<set _color2 to $dhmod.hair.is_custom ? $dhmod.hair.colors[0] : $hairColourGradient.colours[0]>>
		<<hairmapcolourtext _color1>>【와과】 <<hairmapcolourtext _color2>>
	<<else>>
		<<set _color to $dhmod.hair.is_custom ? $dhmod.hair.colors[0] : $haircolour>>
		<<hairmapcolourtext _color>>
	<</if>>
<</widget>>

<<widget "hairfringecolourtext">>
	<<if $hairFringeColourStyle == "gradient">>
		<<set _color1 to $dhmod.fringe.is_custom ? $dhmod.fringe.colors[1] : $hairFringeColourGradient.colours[1]>>
		<<set _color2 to $dhmod.fringe.is_custom ? $dhmod.fringe.colors[0] : $hairFringeColourGradient.colours[0]>>
		<<hairmapcolourtext _color1>>【와과】 <<hairmapcolourtext _color2>>
	<<else>>
		<<set _color to $dhmod.fringe.is_custom ? $dhmod.fringe.colors[0] : $hairfringecolour>>
		<<hairmapcolourtext _color>>
	<</if>>
<</widget>>

<<widget "charles">><<silently>>
	<<if $wraith.mimic is "Morgan" and $wraith.state is "haunt" and random(1,3) is 1>>
		<<set _text_output to "도굴꾼">>
	<<else>>
		<<set _text_output to (perceivedGender() is "m" ? "찰스" : "샤를린")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcexposetext">><<silently>>
	<<person>><<set _person to _text_output>>
	<<his>><<set _his to _text_output>>
	<<if $pronoun is "m">>
		<<set _text_output to _person + "【은는】 " + _his + " 바지 지퍼를 내리고, ">>
	<<else>>
		<<set _text_output to _person + "【은는】 " + _his + " 치마를 들어 올리며, ">>
	<</if>>
	<<if $NPCList[0] and $NPCList[0].penis isnot "none">>
		<<set _text_output to _text_output + _his + " 발기한 자지를 드러낸다.">>
	<<else>>
		<<set _text_output to _text_output + _his + " 젖은 보지를 드러낸다.">>
	<</if>>
<</silently>>_text_output<</widget>>

