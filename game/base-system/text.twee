<<widget "prostate">><<silently>>
	<<if $player.vaginaExist>>
		<<set _text_output to "자궁">>
	<<else>>
		<<set _text_output to "전립선">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "bitch">><<silently>>
	<<if perceivedGender() is "m">>
		<<set _text_output to "암캐">>
	<<else>>
		<<set _text_output to "창녀">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "Bitch">><<silently>>
	<<bitch>><<capitalise>>
<</silently>>_text_output<</widget>>

<<widget "bitch_pirate">><<silently>>
	<<if perceivedGender() is "m">>
		<<set _text_output to "개">>
	<<else>>
		<<set _text_output to "암캐">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "bastard">><<silently>>
	<<if perceivedGender() is "m">>
		<<set _text_output to "새끼">>
	<<else>>
		<<set _text_output to "창녀">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "cunt">><<silently>>
	<<if perceivedGender() is "m">>
		<<set _text_output to "자지">>
	<<else>>
		<<set _text_output to "보지">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "Ladies_gentlemen">><<silently>>
	<<if maleChance() gte 100>>
		<<set _text_output to "신사분들">>
	<<elseif maleChance() lte 0>>
		<<set _text_output to "숙녀분들">>
	<<else>>
		<<set _text_output to "신사 숙녀 여러분">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "teaful">>
	당신은 차를 한 잔 따르며
<</widget>>

<<widget "tearful">>
<<speechresolve>>
	<<if $trauma gte $traumamax>>
		흐리멍덩하고 공허한 눈으로,
	<<elseif $trauma gte ($traumamax / 5) * 4>>
		<<if $stress gte ($stressmax / 5) * 4>>
			<<if $arousal gte ($arousalmax /5) * 4>>
				<<if $pain gte 100>>
					어둠의 촉수들이 당신의 피부를 후려치고 꿈틀거리며,
				<<elseif $pain gte 40>>
					어둠의 촉수들이 당신의 피부에 대고 꿈틀거리며,
				<<else>>
					기이한 안개가 당신을 감싸고 가장 민감한 부위들을 파고들며,
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					어둠의 덩어리가 쫓아와 당신의 엉덩이를 찌르고 찰싹 때리며,
				<<elseif $pain gte 40>>
					환영의 목소리들이 당신을 조롱하는 소리를 들으며,
				<<else>>
					그림자가 당신을 에워싸는 듯한 느낌에,
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					어둠의 촉수들이 당신의 피부를 채찍질하고 베어내며,
				<<elseif $pain gte 40>>
					어둠의 촉수들이 당신을 찌르며,
				<<else>>
					그림자 속에서 당신을 지켜보는 눈동자가 보이는 듯하며,
				<</if>>
			<</if>>
		<<elseif $stress gte $stressmax / 5>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<if $pain gte 100>>
					고문받은 몸과 마음이 더 많은 벌을 갈망하며,
				<<elseif $pain gte 40>>
					폭력적인 섹스의 환상이 밀려오며,
				<<else>>
					고문받은 마음이 더 많은 벌을 갈망하며,
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					아무것도 당신을 해치려 하지 않는 것에 놀라며,
				<<elseif $pain gte 40>>
					아무것도 당신을 강간하려 하지 않는 것에 놀라며,
				<<else>>
					아무것도 당신에게 박으려 하지 않는 것에 놀라며,
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					자신이 겪는 고통이 마땅하다고 느끼며,
				<<elseif $pain gte 40>>
					당신을 스토킹하는 형상들을 상상하며,
				<<else>>
					누군가 당신을 지켜보고 있다는 느낌에,
				<</if>>
			<</if>>
		<<else>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<if $pain gte 100>>
					성적으로 고문당하는 생각들이 밀려오며,
				<<elseif $pain gte 40>>
					구속된 채 채찍질당하는 생각들이 밀려오며,
				<<else>>
					성노예가 되는 생각들이 밀려오며,
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					폭력적으로 강간당하는 생각들이 밀려오며,
				<<elseif $pain gte 40>>
					잔혹하게 강간당하는 생각들이 밀려오며,
				<<else>>
					강간당하는 생각들이 밀려오며,
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					자신이 겪는 고통이 전적으로 마땅하다고 느끼며,
				<<elseif $pain gte 40>>
					정신적, 육체적으로 고통받고 있음에도,
				<<else>>
					자신이 완전히 쓸모없게 느껴지며,
				<</if>>
			<</if>>
		<</if>>
	<<elseif $trauma gte ($traumamax / 5) * 2>>
		<<if $stress gte ($stressmax / 5) * 4>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						자신의 악랄한 일부가 겪고 있는 고통을 음미하며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						자신의 성난 일부가 고통이 영향을 주도록 내버려 두지 않으며,
					<<elseif _speechAttitudeResolved is "docile">>
						자신의 조용하고 순종적인 일부가 고통을 받아들이며,
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						자신의 작고 겁먹은 일부가 겪고 있는 고통을 음미하며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						수치스러워하는 자신의 일부가 고통을 너무나 예민하게 느끼며,
					<<else>>
						자신의 일부가 겪고 있는 고통을 음미하며,
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						마음이 자신을 배신한다는 사실에 눈물을 흘리며 분노하고,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						미쳐가고 있다는 사실에 눈물을 흘리며 화가 나서,
					<<elseif _speechAttitudeResolved is "docile">>
						미쳐가고 있을까 봐 조용히 걱정하며 눈물을 흘리고,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						생각을 가지런히 하려 애써도 눈물이 흐르며,
					<<else>>
						미쳐가고 있다는 걱정에 눈물을 흘리며,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						미쳐가고 있다는 생각에 분노하면서도,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						미쳐가고 있다는 생각에 화가 나면서도,
					<<elseif _speechAttitudeResolved is "docile">>
						미쳐가고 있을까 봐 조용히 걱정하면서도,
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						미쳐가고 있다는 생각에 겁에 질리면서도,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하려 애쓰면서도 정신이 어떻게 될까 두려워하며,
					<<else>>
						미쳐가고 있다는 걱정이 들면서도,
					<</if>>
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					무언가 공격할지도 모른다는 두려움에도 불구하고,
				<<elseif $pain gte 40>>
					무언가 덮쳐올지도 모른다는 두려움에도 불구하고,
				<<else>>
					공황의 가장자리에 내몰린 기분을 느끼며,
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						상처받고 취약해진 데다 앙심으로 가득 찬 상태임에도 불구하고,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						상처받았지만 약해 보이기를 거부하면서도,
					<<elseif _speechAttitudeResolved is "docile">>
						상처받고 순하게 취약해진 상태임에도 불구하고,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						상처받았지만 약한 모습을 보이지 않으려 애쓰면서도,
					<<else>>
						상처받고 취약해진 상태임에도 불구하고,
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						얼굴에 흐른 눈물이 원망스러우며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						얼굴에 흐른 눈물을 성난 듯 깜빡여 털어내며,
					<<elseif _speechAttitudeResolved is "docile">>
						얼굴에 흐른 눈물이 신경 쓰여 시선을 내리며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						얼굴에 흐른 눈물을 숨기려 애쓰며,
					<<else>>
						얼굴에 흐른 눈물이 자꾸 의식되며,
					<</if>>
				<<else>>
					예상치 못한 모든 움직임에 깜짝 놀라며,
				<</if>>
			<</if>>
		<<elseif $stress gte $stressmax / 5>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<if $pain gte 100>>
					상처받고 수치스러움을 느끼며,
				<<elseif $pain gte 40>>
