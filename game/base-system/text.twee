<</silently>><<print _text_output>><</widget>>

<<widget "gentleman_bnpc">><<silently>>
	<<if typeof _args[0] is "number">>
		<<set _na to _args[0]>>
	<<elseif $enemyno gte 0>>
		<<set _na to $enemyno-1>>
	<<else>>
		<<set _na to 0>>
	<</if>>
	<<if $NPCList[_na].monster is "monster">>
		<<if $NPCList[_na].pronoun is "m">>
			<<set _text_output to "신사">>
		<<elseif $NPCList[_na].pronoun is "f">>
			<<set _text_output to "숙녀">>
		<<else>>
			<<set _text_output to "귀하신 분">>
		<</if>>
	<<else>>
		<<set _text_output to "귀하신 분">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "lord">><<silently>>
	<<set _text_output to ($pronoun is "m" ? "주인님" : "주인님")>>
<</silently>><<print _text_output>><</widget>>

<<widget "Lord">><<silently>>
	<<lord>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "girlfriend">><<silently>>
	/* Prints the player's side of a relationship. Pass the speaking NPC's name so the term follows how that NPC addresses the player; no argument means narration or the player's own words, which use their own pronouns. */
	<<set _playerPronoun to (_args[0] ? npcAddressPronoun(_args[0]) : playerPronoun())>>
	/* No <<misgender>> here on purpose: these terms are also printed by status panels and journal
	   entries, which re-render on their own and would charge dysphoria for simply opening a menu. */
	<<set _text_output to (_playerPronoun is "m" ? "남자친구" : _playerPronoun is "f" ? "여자친구" : "애인")>>
<</silently>><<print _text_output>><</widget>>

<<widget "partnerfriend">><<silently>>
	/* Prints the gender of the player's assumed hetero partner. Pass an NPC name to gate this on whether that NPC actually knows the player's identity (falls back to perceivedGender() otherwise). */
	<<set _playerPronoun to (_args[0] ? npcAddressPronoun(_args[0]) : playerPronoun())>>
	<<set _text_output to (_playerPronoun is "m" ? "여자친구" : _playerPronoun is "f" ? "남자친구" : "애인")>>
<</silently>><<print _text_output>><</widget>>

<<widget "friend">><<silently>>
	<<if $robinromance is 1>>
		/* Robin is the only speaker of this line, so the partner term matches <<girlfriend "Robin">>. */
		<<girlfriend "Robin">>
	<<elseif _args[0] is "bff">>
		<<set _text_output to "가장 친한 친구">>
	<<else>>
		<<set _text_output to "친구">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "girls">><<silently>>
	<<set _playerPronoun to npcAddressPronoun(_args[0])>>
	<<set _text_output to (_playerPronoun is "m" ? "남자애들" : _playerPronoun is "f" ? "여자애들" : "애들")>>
	<<misgender _playerPronoun>>
<</silently>><<print _text_output>><</widget>>

