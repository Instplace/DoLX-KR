				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						흥분한 신체의 반응에 격분하면서도,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						흥분한 신체의 반응에 분노하면서도,
					<<elseif _speechAttitudeResolved is "docile">>
						흥분한 신체의 반응에 기가 눌리면서도,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						흥분한 신체의 반응에 수치스러워하면서도,
					<<else>>
						흥분한 신체의 반응에 굴욕감을 느끼면서도,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						흥분한 신체의 반응에 격분하면서도,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						흥분한 신체의 반응에 분노하면서도,
					<<elseif _speechAttitudeResolved is "docile">>
						흥분한 신체의 반응에 부끄러워 움츠러들면서도,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						흥분한 신체의 반응에 당황하면서도,
					<<else>>
						흥분한 신체의 반응에 당혹감을 느끼면서도,
					<</if>>
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						동요하고, 상처받고, 원망으로 쓰라린 채,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						동요하고 상처받았지만 반항심을 잃지 않으려 애쓰며,
					<<elseif _speechAttitudeResolved is "docile">>
						동요하고, 상처받고, 기가 죽은 채,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하는데도 동요하고 상처받은 채,
					<<else>>
						동요하고 상처받은 채,
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						당신의 몸이 고통스럽게, 거의 비웃기라도 하듯 찌릿거리며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						당신의 몸이 의지와 상관없이 고통스럽게 찌릿거리며,
					<<elseif _speechAttitudeResolved is "docile">>
						당신의 몸이 고통스럽게 찌릿거리는 것을 참으며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하는데도 당신의 몸이 고통스럽게 찌릿거리며,
					<<else>>
						당신의 몸이 고통스럽게 찌릿거리며,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						자신 안의 음란한 열기가 앙심 어리게 신경 쓰이는 상태로,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						자신 안의 음란한 열기가 신경 쓰이지만 움츠러들지 않는 상태로,
					<<elseif _speechAttitudeResolved is "docile">>
						자신 안의 음란한 열기 아래에서 작아진 기분으로,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						자신 안의 음란한 열기에 몹시 수치스러워하며,
					<<else>>
						자신 안의 음란한 열기가 신경 쓰이는 상태로,
					<</if>>
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					<<if $water is 1>>
						<<if _speechAttitudeResolved is "cruel">>
							분노에 찬 눈물이 물속으로 씻겨 내려가며,
						<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
							분노 어린 눈물이 물속으로 씻겨 내려가며,
						<<elseif _speechAttitudeResolved is "docile">>
							조용한 눈물이 물속으로 씻겨 내려가며,
						<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
							마음을 가다듬기도 전에 눈물이 씻겨 내려가는 채로,
						<<else>>
							물속으로 눈물이 씻겨 내려가는 채로,
						<</if>>
					<<else>>
						<<if _speechAttitudeResolved is "cruel">>
							분노에 찬 눈물로 얼굴이 뒤덮인 채,
						<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
							분노 어린 눈물로 얼굴이 뒤덮인 채,
						<<elseif _speechAttitudeResolved is "docile">>
							고개를 숙인 얼굴이 눈물로 뒤덮인 채,
						<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
							침착해 보려 애써도 얼굴이 젖은 채,
						<<else>>
							눈물로 뒤덮인 얼굴로,
						<</if>>
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						만신창이가 된 기분이지만, 앙심으로 멈추지 않고 계속 움직이며,
					<<elseif _speechAttitudeResolved is "docile">>
						만신창이가 된 기분이지만, 조용히 스스로를 몰아붙여 나아가며,
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						만신창이가 된 기분이지만, 최선을 다해 계속 나아가려 하며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						만신창이가 된 기분이지만, 소란을 피우지 않겠다고 다짐하며,
					<<else>>
						만신창이가 된 기분이지만, 그럼에도 불구하고 최선을 다하겠다고 다짐하며,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						그럼에도 앙심이 남아 걸음을 늦추지 못하며,
					<<elseif _speechAttitudeResolved is "docile">>
						그럼에도 조용히 스스로를 몰아붙여 나아가며,
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						그럼에도 최선을 다해 계속 나아가려 하며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						그럼에도 불구하고 침착함을 유지하겠다고 다짐하며,
					<<else>>
						그럼에도 불구하고 최선을 다하겠다고 다짐하며,
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						고문받은 몸이 분노와 흥분으로 떨리며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						고문받은 몸이 분노와 흥분으로 떨리며,
					<<elseif _speechAttitudeResolved is "docile">>
						고문받은 몸이 어쩔 도리 없이 흥분으로 떨리며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하는데도 고문받은 몸이 흥분으로 떨리며,
					<<else>>
						고문받은 몸이 흥분으로 떨리며,
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						분노에 찬 눈물이 상기된 뺨을 타고 흘러내리며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						분노 어린 눈물이 상기된 뺨을 타고 흘러내리며,
					<<elseif _speechAttitudeResolved is "docile">>
						조용한 눈물이 상기된 뺨을 타고 흘러내리며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하는데도 눈물이 상기된 뺨을 타고 흘러내리며,
					<<else>>
						상기된 뺨을 타고 눈물이 흘러내리며,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						당신의 몸이 분노와 흥분으로 떨리며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						당신의 몸이 분노와 흥분으로 떨리며,
					<<elseif _speechAttitudeResolved is "docile">>
						당신의 몸이 어쩔 도리 없이 흥분으로 떨리며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						침착함을 유지하는데도 당신의 몸이 흥분으로 떨리며,
					<<else>>
						당신의 몸이 흥분으로 떨리며,
					<</if>>
				<</if>>
			<<elseif $arousal gte $arousalmax / 5>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						당신의 몸이 아프고 찌릿거려 분노에 불을 붙이며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						당신의 몸이 의지와 상관없이 아프고 찌릿거리며,
					<<elseif _speechAttitudeResolved is "docile">>
						당신의 몸이 어쩔 도리 없이 아프고 찌릿거리며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						의연함을 유지하는데도 당신의 몸이 아프고 찌릿거리며,
					<<else>>
						당신의 몸이 아프고 찌릿거리며,
					<</if>>
				<<elseif $pain gte 40>>
					<<if _speechAttitudeResolved is "cruel">>
						당신의 몸이 화가 날 만큼 민감해진 채,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						당신의 몸이 민감해졌지만 그것을 인정하지 않으려 하며,
					<<elseif _speechAttitudeResolved is "docile">>
						당신의 몸이 민감하고 취약해진 채,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						조심스러운 침착함을 유지하는데도 당신의 몸이 민감해진 채,
					<<else>>
						당신의 몸이 민감해진 채,
					<</if>>
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						꼴려하고, 그런 자신에게 화가 치밀며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						고집스러운 자존심에도 불구하고 꼴려하며,
					<<elseif _speechAttitudeResolved is "docile">>
						어쩔 도리 없이 꼴려하며,
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						수치스러울 만큼 꼴려하며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						자신의 뜻과 달리 주체할 수 없이 꼴려하며,
					<<else>>
						꼴려하며,
					<</if>>
				<</if>>
			<<else>>
				<<if $pain gte 100>>
					<<if _speechAttitudeResolved is "cruel">>
						온몸이 쑤시지만 앙심이 당신을 계속 움직이게 하며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						온몸이 쑤시지만 억지로 앞으로 나아가며,
					<<elseif _speechAttitudeResolved is "docile">>
						온몸이 쑤시지만 순순히 견디며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						온몸이 쑤시지만 품위를 지키려 애쓰며,
					<<else>>
						온몸이 쑤신 채,
					<</if>>
				<<elseif $pain gte 40>>
					<<elseif $pain gte 40>>
					<<if $leftarm is "bound" and $rightarm is "bound">>
						<<if _speechAttitudeResolved is "cruel">>
							분노에 찬 눈물을 깜빡이며 참아내고,
						<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
							화가 섞인 눈물을 깜빡이며 참아내고,
						<<elseif _speechAttitudeResolved is "docile">>
							조용한 눈물을 깜빡이며 참아내고,
						<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
							눈물을 깜빡이며 참아내고 침착해 보이려 하며,
						<<else>>
							눈물을 깜빡이며 참아내고,
						<</if>>
					<<elseif _speechAttitudeResolved is "cruel">>
						분노에 찬 눈물을 닦아내며,
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						화가 섞인 눈물을 닦아내며,
					<<elseif _speechAttitudeResolved is "docile">>
						고개도 들지 않은 채 눈물을 닦아내며,
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						눈물을 닦아내고 침착해 보이려 하며,
					<<else>>
						눈물을 닦아내며,
					<</if>>
				<<elseif $worn.neck.name is "ivory necklace" and !pcAreArmsBound("both") and !_rubbedNecklace>>
					<<set _rubbedNecklace to true>>
					목걸이를 움켜쥐며,
				<<elseif $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1 and !pcAreArmsBound("both") and !_rubbedNecklace>>
					<<set _rubbedNecklace to true>>
					목걸이의 하트를 쓰다듬으며,
				<<elseif $worn.neck.name is "love locket" and [$loveInterest.primary, $loveInterest.secondary, $loveInterest.tertiary].includes($worn.neck.photo) and !$NPCList.find(npc => npc.fullDescription === $worn.neck.photo) and !_rubbedNecklace>>
					당신은 로켓을 손에 쥔 채
				<<else>>
					<<if _speechAttitudeResolved is "cruel">>
						당신은 앙심 어린 결의로 움직이며
					<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "confident")>>
						당신은 턱을 치켜든 채 시간을 지체하지 않고
					<<elseif _speechAttitudeResolved is "docile">>
						당신은 조용히 스스로를 몰아붙이며
					<<elseif (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
						당신은 용기가 꺾이기 전에 서둘러 나아가며
					<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
						당신은 마음을 가다듬고 나아가며
					<<else>>
						당신은 시간을 지체하지 않고
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "slithers">>
	<<rng>>
	<<if $rng gte 96>>
		미끄러진다.
	<<elseif $rng gte 91>>
		몸부림친다.
	<<elseif $rng gte 86>>
		꿈틀거린다.
	<<elseif $rng gte 81>>
		요동친다.
	<<elseif $rng gte 76>>
		기어다닌다.
	<<elseif $rng gte 71>>
		미끄러진다.
	<<elseif $rng gte 66>>
		살금살금 움직인다.
	<<elseif $rng gte 61>>
		활강한다.
	<<elseif $rng gte 56>>
		미끄러진다.
	<<elseif $rng gte 51>>
		버둥거린다.
	<<elseif $rng gte 46>>
		꿈틀거린다.
	<<elseif $rng gte 41>>
		뒤틀린다.
	<<elseif $rng gte 36>>
		경련한다.
	<<elseif $rng gte 31>>
		부르르 떤다.
	<<elseif $rng gte 26>>
		떨린다.
	<<elseif $rng gte 21>>
		흠칫거린다.
	<<elseif $rng gte 16>>
		기어다닌다.
	<<elseif $rng gte 11>>
		퍼덕거린다.
	<<elseif $rng gte 6>>
		구불구불 기어다닌다.
	<<elseif $rng gte 1>>
		미끄러진다.
	<</if>>
<</widget>>

<<widget "slithering">>
	<<rng>>
	<<if $rng gte 96>>
		미끄러지는
	<<elseif $rng gte 91>>
		몸부림치는
	<<elseif $rng gte 86>>
		꿈틀거리는
	<<elseif $rng gte 81>>
		요동치는
	<<elseif $rng gte 76>>
		기어가는
	<<elseif $rng gte 71>>
		미끄러지는
	<<elseif $rng gte 66>>
		살금살금 움직이는
	<<elseif $rng gte 61>>
		활강하는
	<<elseif $rng gte 56>>
		미끄러지는
	<<elseif $rng gte 51>>
		버둥거리는
	<<elseif $rng gte 46>>
		꿈틀거리는
	<<elseif $rng gte 41>>
		뒤틀리는
	<<elseif $rng gte 36>>
		경련하는
	<<elseif $rng gte 31>>
		부르르 떠는
	<<elseif $rng gte 26>>
		떨리는
	<<elseif $rng gte 21>>
		흠칫거리는
	<<elseif $rng gte 16>>
		기어다니는
	<<elseif $rng gte 11>>
		퍼덕거리는
	<<elseif $rng gte 6>>
		구불구불 기어다니는
	<<elseif $rng gte 1>>
		미끄러지는
	<</if>>
<</widget>>

<<widget "wallet">><<silently>>
	<<if !isNaN(_args[0]) and $NPCList[_args[0]]?.clothes?.set>>
		<<set $_clothesSet to $NPCList[_args[0]].clothes.set>>
	<</if>>
	<<if $location is "island">>
		<<set _text_output to "옷">>
	<<elseif ["maleSchoolSwim", "maleSchoolSwimShirt", "femaleSchoolSwim", "maleSwim1", "maleSwim2", "femaleSwim1", "femaleSwim2", "neutralSwim", "divingSuit"].includes($_clothesSet)>>
