<<widget "daylight">>
	<<if Weather.dayState is "day">>
		<<set _text_output to "햇빛">>
	<<elseif Weather.dayState is "dawn">>
		<<set _text_output to "여명의 빛">>
	<<elseif Weather.dayState is "dusk">>
		<<set _text_output to "황혼의 빛">>
	<<else>>
		<<if Time.hour is 9 or Time.season is "summer">>
			<<set _text_output to "땅거미">>
		<<else>>
			<<set _text_output to "밤바람">>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "printChastity">>
	$worn.genitals.name
<</widget>>

<<widget "beast_jaws_text">>
	<<if $NPCList[_n].type is "hawk">>
		<<set _text_output to "부리">>
	<<else>>
		<<set _text_output to "아가리">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_Jaws_text">>
	<<if $NPCList[_n].type is "hawk">>
		<<set _text_output to "부리">>
	<<else>>
		<<set _text_output to "아가리">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_teeth_text">>
	<<if $NPCList[_n].type is "hawk">>
		<<set _text_output to "부리">>
	<<else>>
		<<set _text_output to "이빨">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_claws_text">>
	<<if $NPCList[_n].type is "hawk">>
		<<set _text_output to "발톱">>
	<<else>>
		<<set _text_output to ({claws:"발톱", hooves:"발굽", flippers:"지느러미", talons:"발톱"})[$NPCList[_n].claws] || $NPCList[_n].claws>>
		<!-- <<set _text_output to "claws">> -->
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_growls_text">>
	<<set $_type to _args[0] ? _args[0] : $NPCList[_n].type>>
	<<if ["hawk","harpy"].includes($_type)>>
		<<set _text_output to "꽥꽥거린다">>
	<<elseif $_type.includes("pig")>>
		<<set _text_output to "꿀꿀거린다">>
	<<elseif $_type.includes("dolphin")>>
		<<set _text_output to "딸깍거린다">>
	<<elseif $_type.includes("spider")>>
		<<set _text_output to "찍찍거린다">>
	<<elseif $_type.includes("lizard")>>
		<<set _text_output to "쉭쉭거린다">>
	<<elseif ["boar","horse","centaur"].includes($_type)>>
		<<set _text_output to "씩씩거린다">>
	<<else>>
		<<set _text_output to "으르렁거린다">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_growling_text">>
	<<set $_type to _args[0] ? _args[0] : $NPCList[_n].type>>
	<<if ["hawk","harpy"].includes($_type)>>
		<<set _text_output to "꽥꽥거림">>
	<<elseif $_type.includes("pig")>>
		<<set _text_output to "꿀꿀거림">>
	<<elseif $_type.includes("dolphin")>>
		<<set _text_output to "딸깍거림">>
	<<elseif $_type.includes("spider")>>
		<<set _text_output to "찍찍거림">>
	<<elseif $_type.includes("lizard")>>
		<<set _text_output to "쉭쉭거림">>
	<<elseif ["boar","horse","centaur"].includes($_type)>>
		<<set _text_output to "씩씩거림">>
	<<else>>
		<<set _text_output to "으르렁거림">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "dress">>
	<<if $worn.upper.set is $worn.lower.set>>
		<<if wornSetupClothes("lower").skirt is 1>>
			<<set _text_output to "드레스">>
		<<else>>
			<<set _text_output to "옷">>
		<</if>>
	<<else>>
		<<set _text_output to "상의">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "skirt">>
	<<if $worn.upper.set is $worn.lower.set>>
		<<if wornSetupClothes("lower").skirt is 1>>
			<<set _text_output to "원피스">>
		<<else>>
			<<set _text_output to "옷">>
		<</if>>
	<<else>>
		<<if wornSetupClothes("lower").skirt is 1>>
			<<set _text_output to "스커트">>
		<<else>>
			<<set _text_output to "하의">>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "panties">>
	<<if $worn.under_upper.set is $worn.under_lower.set>>
		<<set _text_output to "속옷">>
	<<else>>
		<<if wornSetupClothes("under_lower").skirt is 1>>
			<<set _text_output to "치마">>
		<<else>>
			<<if $worn.under_lower.gender is "f">>
				<<if random(1, 2) is 2>>
					<<set _text_output to "팬티">>
				<<else>>
					<<set _text_output to "속바지">>
				<</if>>
			<<else>>
				<<set _text_output to "팬티">>
			<</if>>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "bra">>
	<<if $worn.under_upper.set is $worn.under_lower.set>>
		<<set _text_output to "속옷">>
	<<else>>
		<<if $worn.under_upper.gender is "f" and wornSetupClothes("under_upper").state_base is "midriff">>
			<<set _text_output to "브래지어">>
		<<else>>
			<<set _text_output to "상의">>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "npcPenis">><<silently>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenis-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis is "chastity cage">>
		<<set _text_output to "구속된 자지">>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<switch $NPCList[$_npcGen].penissize>>
			<<case 5>><<set _text_output to either("엄청난 페니스 밴드","괴물 같은 페니스 밴드","우뚝 솟은 페니스 밴드","거대한 페니스 밴드")>>
			<<case 4>><<set _text_output to either("커다란 페니스 밴드","큼직한 페니스 밴드","묵직한 페니스 밴드","굉장한 페니스 밴드")>>
			<<case 3>><<set _text_output to either("두꺼운 페니스 밴드","육중한 페니스 밴드","튼튼한 페니스 밴드","큼직한 페니스 밴드")>>
			<<case 1>><<set _text_output to either("작은 페니스 밴드","조그만 페니스 밴드","가느다란 페니스 밴드")>>
			<<default>><<set _text_output to either("페니스 밴드","자지 모양 페니스 밴드","장난감 자지")>>
		<</switch>>
	<<else>>
		<<set _text_output to window.KR.getPenisDescKr($NPCList[$_npcGen].penisdesc)>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcPenisSimple">><<silently>>
	<<if $enemynomax is 1>>
		<<set _args[0] to 0>>
	<</if>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenisSimple-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis is "chastity cage">>
		<<set _text_output to "구속된 자지">>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<set _text_output to either("페니스 밴드","페니스 모양 밴드","장난감 자지","의족 같은 인조 자지")>>
	<<else>>
		<<set _text_output to either("자지","자지","자지","육봉")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcPenisColored">>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<set $_ppcolor to "tan">>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenisColored-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set $_ppcolor to "grey">>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<set $_ppcolor to $NPCList[$_npcGen].strapon.color>>
		<<if $_ppcolor is "fleshy">><<set $_ppcolor to "tan">><</if>>
		<<switch $NPCList[$_npcGen].penissize>>
			<<case 5>><<set _text_output to either("엄청난 페니스 밴드","괴물 같은 페니스 밴드","우뚝 솟은 페니스 밴드","굵직한 페니스 밴드")>>
			<<case 4>><<set _text_output to either("커다란 페니스 밴드","큼직한 페니스 밴드","묵직한 페니스 밴드","굉장한 페니스 밴드")>>
			<<case 3>><<set _text_output to either("두꺼운 페니스 밴드","육중한 페니스 밴드","튼튼한 페니스 밴드","큼직한 페니스 밴드")>>
			<<case 1>><<set _text_output to either("작은 페니스 밴드","조그만 페니스 밴드","가느다란 페니스 밴드")>>
			<<default>><<set _text_output to either("페니스 밴드","페니스 모양 밴드","장난감 자지")>>
		<</switch>>
	<<else>>
		<<set _text_output to window.KR.getPenisDescKr($NPCList[$_npcGen].penisdesc)>>
	<</if>>
	<span @class=$_ppcolor><b><<print _text_output>></b></span>
<</widget>>

