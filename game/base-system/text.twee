<<widget "master">><<silently>>
	<<set _text_output to ($pronoun is "m" ? "주인님" : "주인님")>>
<</silently>>_text_output<</widget>>

<<widget "Master">><<silently>>
	<<master>><<capitalise>>
<</silently>>_text_output<</widget>>

