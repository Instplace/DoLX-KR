<<widget "genderedTF">><<silently>>
	<<set _playerPronoun to npcAddressPronoun(_args[1])>>
	/* KR: 동물 이름(영어 인자)을 한국어로 바꿔 소년/소녀/수인을 붙인다. 소는 카우보이/카우걸. */
	<<set _tfAnimal to String(_args[0]).toLowerCase()>>
	<<if _tfAnimal is "cow">>
		<<set _text_output to (_playerPronoun is "m" ? "카우보이" : _playerPronoun is "f" ? "카우걸" : "소 수인")>>
	<<elseif _tfAnimal is "lover">>
		<<set _text_output to "연인">>
	<<else>>
		<<set _tfKr to ({wolf: "늑대", cat: "고양이", fox: "여우", bear: "곰", bird: "새", harpy: "하피", dog: "개", bunny: "토끼", rabbit: "토끼", dragon: "용"})[_tfAnimal] || _args[0]>>
		<<set _text_output to _tfKr + (_playerPronoun is "m" ? "소년" : _playerPronoun is "f" ? "소녀" : " 수인")>>
	<</if>>
	<<misgender _playerPronoun>>
<</silently>><<print _text_output>><</widget>>

