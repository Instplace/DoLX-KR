<!--_args[0] - uses "pc", the named npc's name, or a number-->
<!--_args[1] - forces the pregnancy description-->
<<widget "bellyDescription">><<silently>>
	<<if !isNaN(_args[0])>>
		<<set $_size to _args[0]>>
	<<elseif _args[0] is "pc">>
		<<set $_size to $bellySizeDebug || playerBellySize()>>
		<<set $_pregnant to ($bellySizeDebug isnot undefined) || playerIsPregnant()>>
	<<elseif C.npc[_args[0]]>>
		<<set $_size to npcBellySize(_args[0])>>
		<<set $_pregnant to npcIsPregnant(_args[0])>>
	<</if>>

	<<if $_pregnant or _args[1]>>
		<<switch $_size>>
			<<case 7 8 9 10 11>><<set $_text_output to "살짝 부른 배">>
			<<case 12 13 14>><<set $_text_output to "점점 불러오는 배">>
			<<case 15 16 17 18>><<set $_text_output to "임신한 배">>
			<<case 19 20 21 22 23 24>><<set $_text_output to "만삭의 배">>
			<<default>><<set $_text_output to "배">>
		<</switch>>
	<<else>>
		<<switch $_size>>
			<<case 7 8 9 10 11>><<set $_text_output to "부푼 배">>
			<<case 12 13 14>><<set $_text_output to "부어오른 배">>
			<<case 15 16 17 18>><<set $_text_output to "커다란 배">>
			<<case 19 20 21 22 23 24>><<set $_text_output to "불룩한 배">>
			<<default>><<set $_text_output to "배">>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>>$_text_output<</if>><</widget>>

<<widget "semen">><<silently>>
	<<if $player.penisExist>>
		<<set _text_output to "정액">>
	<<else>>
		<<set _text_output to "음탕한 액체">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "mouthsensitivity">><<silently>>
	<<if getSensitivity("mouth") > 3.5>>
		<<set _text_output2 to "민감한 ">>
	<<elseif getSensitivity("mouth") >= 2.5>>
		<<set _text_output2 to "여린 ">>
	<<elseif getSensitivity("mouth") >= 1.5>>
		<<set _text_output2 to "잘 느끼는 ">>
	<<else>>
		<<set _text_output2 to "">>
	<</if>>
	<<set _mouthSensitivityDescribed to true>>
<</silently>><<print _text_output2>><</widget>>

<<widget "breastsensitivity">><<silently>>
	<<if (V.substanceRebalance == 1)>>
		<<set _drugMod to 1 + V.drugged / 250>>
	<<else>>
		<<set _drugMod to 1 + V.drugged / 1000>>
	<</if>>
	<<if getSensitivity("breasts") * _drugMod > 3.5>>
		<<set _text_output2 to "민감한 ">>
	<<elseif getSensitivity("breasts") * _drugMod >= 2.5>>
		<<set _text_output2 to "여린 ">>
	<<elseif getSensitivity("breasts") * _drugMod >= 1.5>>
		<<set _text_output2 to "잘 느끼는 ">>
	<<else>>
		<<set _text_output2 to "">>
	<</if>>
	<<set _breastSensitivityDescribed to true>>
<</silently>><<print _text_output2>><</widget>>

<<widget "bottomsensitivity">><<silently>>
	<<if (V.substanceRebalance == 1)>>
		<<set _drugMod to 1 + V.drugged / 250>>
	<<else>>
		<<set _drugMod to 1 + V.drugged / 1000>>
	<</if>>
	<<if getSensitivity("bottom") * _drugMod > 3.5>>
		<<set _text_output2 to "민감한 ">>
	<<elseif getSensitivity("bottom") * _drugMod >= 2.5>>
		<<set _text_output2 to "여린 ">>
	<<elseif getSensitivity("bottom") * _drugMod >= 1.5>>
		<<set _text_output2 to "잘 느끼는 ">>
	<<else>>
		<<set _text_output2 to "">>
	<</if>>
	<<set _bottomSensitivityDescribed to true>>
<</silently>><<print _text_output2>><</widget>>

<<widget "nipple">>
	<<if !_breastSensitivityDescribed>><<breastsensitivity>><</if>><<print "젖꼭지">>
<</widget>>

<<widget "nipples">>
	양쪽 <<nipple>>
<</widget>>

<<widget "breastsizedesc">><<silently>>
	<<set $_breastsize to (_args[0] isnot undefined ? _args[0] : $player.breastsize)>>
	<<if Number.isInteger($_breastsize)>>
		<<set _text_output to window.KR.getBreastSizeKr(setup.breastsizes[$_breastsize])>>
			<<elseif $options.debugdisable is "f">>
		<<set _text_output to "<span class='red'>오류 - breastsizedesc의 _args[0] 값이 숫자가 아닙니다</span>">>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "breasts">>
	<<silently>>
		<<if Number.isInteger($player.breastsize)>>
			<<if $player.breastsize lte 0>>
				<<set _text_output to "유두만 있는 가슴">>
			<<else>>
				<<set _text_output to `${window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize])} `>>
				<<if !_breastSensitivityDescribed or _args[0]>><<silently>><<breastsensitivity>><</silently>><<set _text_output += _text_output2>><</if>>
				<<set _text_output += "가슴">>
			<</if>>
		<<elseif $options.debugdisable is "f">>
			<<set _text_output to "오류 - $$player.breastsize 값이 숫자가 아닙니다: $player.breastsize">>
		<</if>>
	<</silently>>
	<<print _text_output>>
<</widget>>

<<widget "breastssimple">><<silently>>
	<<if Number.isInteger($player.breastsize)>>
		<<if $player.breastsize lte 0>>
			<<set _text_output to "젖꼭지">>
		<<else>>
			<<set _text_output to "가슴">>
		<</if>>
	<<elseif $options.debugdisable is "f">>
		<<set _text_output to "오류 - $$player.breastsize 값이 숫자가 아닙니다">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "chest">><<silently>>
	<<if Number.isInteger($player.breastsize)>>
		<<if $player.breastsize lte 0>>
			<<set _text_output to "가슴">>
		<<else>>
			<<set _text_output to window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize]) + " 가슴">>
		<</if>>
	<<elseif $options.debugdisable is "f">>
		<<set _text_output to "오류 - $$player.breastsize 값이 숫자가 아님: $player.breastsize">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<!-- From an onlooker's perspective, chest-flattening clothing, such as a binder, flattens the visible chest -->
<<widget "chestseen">><<silently>>
	<<if Number.isInteger($player.breastsize)>>
		<<set _seen to apparentBreastSize()>>
		<<if _seen lte 0>>
			<<set _text_output to "chest">>
		<<else>>
			<<set _text_output to setup.breastsizes[_seen] + " breasts">>
		<</if>>
	<<elseif $options.debugdisable is "f">>
		<<set _text_output to "ERROR - $$player.breastsize is not a number: $player.breastsize">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "chestsimple">><<silently>>
	<<if Number.isInteger($player.breastsize)>>
		<<if $player.breastsize lte 0>>
			<<set _text_output to "가슴">>
		<<else>>
			<<set _text_output to "유방">>
		<</if>>
	<<elseif $options.debugdisable is "f">>
		<<set _text_output to "오류 - $$player.breastsize 값이 숫자가 아님: $player.breastsize">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "mouth">><<silently>>
	<<set _text_output to "입술">>
<</silently>><<if !_mouthSensitivityDescribed>><<mouthsensitivity>><</if>><<print _text_output>><</widget>>

<!-- Prints the current state of the player's under_upper clothing, assuping the over_upper clothing has been destroyed.
	The corresponding lower check is called "undies" -->
<<widget "undertop">><<silently>>
	<<if $worn.under_upper.exposed lte 0>>
		<<set _text_output to $worn.under_upper.name>>
	<<else>>
		<<breasts>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "underoutfit">><<silently>>
	<<outfitChecks>>
	<<undies>><<set $_secondhalf to _text_output>>
	<<undertop>>
	<!-- _text_output now has top (either worn under_upper name, or breasts desc) -->

	<<if !_underOutfit and $worn.under_lower.name isnot "naked">> <!-- Two separate items, not an outfit -->
		<<set _text_output += "【와과】 " + $_secondhalf>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "genitalstate">><<silently>>
	<<set _text_output to "">>
	<<if _args[0] is "penis" and $player.vaginaExist and $parasite.clit.name is "parasite">>
		<<set _text_output to "기생하는 ">>
	<<elseif _args[0] is "penis" and $earSlime.focus is "impregnation" and $earSlime.growth gte 100>>
		<<set _text_output to "뚝뚝 흐르는 ">>
	<<elseif _args[0] is "pussy" and $earSlime.focus is "pregnancy" and $earSlime.growth gte 100>>
		<<set _text_output to "뚝뚝 흐르는 ">>
	<<elseif $orgasmcount gte 23>>
		<<if $orgasmdown gte 1>>
			<<set _text_output to "고문받은 ">>
		<<else>>
			<<set _text_output to "지쳐버린 ">>
		<</if>>
	<<elseif $orgasmcount gte 9>>
		<<if $orgasmdown gte 1>>
			<<set _text_output to "경련하는 ">>
		<<else>>
			<<set _text_output to "피로한 ">>
		<</if>>
	<<else>>
		<<if $orgasmdown gte 1>>
			<<set _text_output to "경련하는 ">>
		<<else>>
			<<if $arousal gte ($arousalmax / 5) * 4>>
				<<set _text_output to "얼얼한 ">>
			<<elseif $arousal gte ($arousalmax / 5) * 3>>
				<<set _text_output to "sensitive ">>
			<<elseif $arousal gte ($arousalmax / 5) * 2>>
				<<set _text_output to "warm ">>
			<<elseif $arousal gte $arousalmax / 5>>
				<<set _text_output to "responsive ">>
			<<else>>
				<<set _text_output to "">>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "penis">>
		<<set _penisStateDescribed to true>>
	<<elseif _args[0] is "pussy">>
		<<set _pussyStateDescribed to true>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "bottom">><<silently>>
	<<set _text_output to ["가느다란", "날씬한", "보통의", "푹신한", "부드러운", "둥근", "통통한", "큰", "거대한"][Math.clamp(0, 8, $player.bottomsize)]>>
	/* _args[0] is a flag to prevent .pluck() from altering state random when calling from overlays */
	<<set _text_output to _text_output + [" 엉덩이", " 궁둥이", " 둔부"].pluck(_args[0])>>
<</silently>><<if !_bottomSensitivityDescribed>><<bottomsensitivity>><</if>><<print _text_output>><</widget>>

<<widget "bottomsimple">><<silently>>
	<<set _text_output to either("엉덩이", "궁둥이", "둔부")>>
<</silently>><<print _text_output>><</widget>>

<!-- Too small and too big outputs are intended as error messages
	so that it's more obvious what's wrong when people report bugs -->
<<widget "penissize">><<silently>>
	<<set $_size to $combat or $playerHasStraponOverride ? playerPenisSize() : $player.penissize>>
	<<set _measure to 8 + 3 * $_size + ($playerHasStraponOverride? 0 : (1000 - $penisgrowthtimer)/500)>>
	<<switch $_size>>
		<<case 0>><<set _text_output to "초소형">>
		<<case 1>><<set _text_output to "매우 작은">>
		<<case 2>><<set _text_output to "아주 작은">>
		<<case 3>><<set _text_output to "작은">>
		<<case 4>><<set _text_output to "">>
		<<case 5>><<set _text_output to "큰">>
		<<case 6>><<set _text_output to "엄청난">>
		<<default>><<set _text_output to "[Widget 'penissize' - Invalid Penis Value of - " + $_size + ($playerHasStraponOverride ? " - $playerHasStraponOverride is set" : "") + "]">>
	<</switch>>
	<<if $xchange.showExactMeasurements>>
		<<set _text_output to `${_measure.toFixed(2)} cm`>>
	<</if>>
	<<set _penisSizeDescribed to true>>
<</silently>><<print _text_output>><</widget>>

<!-- [0] - if truthy, genital sensitivity is omitted -->
<<widget "pussy">><<silently>>
	<<set _genital_state_text to "">>
	<<if !_pussyStateDescribed>>
		<<genitalstate "pussy">><<set _genital_state_text to _text_output>>
	<</if>>
	<<set _text_output to "">>
	<<if !_args[0] and !_genitalSensitivityDescribed>>
		<<genitalsensitivity>>
	<</if>>
	/* _args[1] is a flag to prevent .pluck() from altering state random when calling from overlays */
	<<set _text_output += _genital_state_text + pussyNames().pluck(_args[1])>>
<</silently>><<print _text_output>><</widget>>

<!-- [0] - if truthy, genital sensitivity is omitted -->
<<widget "clit">><<silently>>
	<<if $player.penisExist>>
		<<penis>>
	<<else>>
		<<set _text_output to "">>
		<<if !_args[0] and !_genitalSensitivityDescribed>>
			<<genitalsensitivity>>
		<</if>>
		<<set _text_output += "클리토리스">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<!-- [0] - if truthy, genital sensitivity is omitted -->
<<widget "penis">><<silently>>
	<!-- Size, skip if mentioned this passage already -->
	<<if _penisSizeDescribed and !_characteristicsOverride>>
		<<set _penissize_text to "">>
	<<else>>
		<<penissize>><<set _penissize_text to _text_output>>
		<<if _penissize_text isnot "">>
			<<set _penissize_text to _penissize_text + " ">>
		<</if>>
	<</if>>
	<!-- State, skip if mentioned this passage already -->
	<<if _penisStateDescribed>>
		<<set _genital_state_text to "">>
	<<else>>
		<<genitalstate "penis">><<set _genital_state_text to _text_output>>
	<</if>>
	<<set _text_output to "">>
	<!-- Sensitivity, skip if mentioned this passage already -->
	<<if !_args[0] and !_genitalSensitivityDescribed>>
		<<genitalsensitivity>>
	<</if>>
	/* _args[1] is a flag to prevent .pluck() from altering state random when calling from overlays */
	<<set _text_output += _penissize_text + _genital_state_text + penisNames().pluck(_args[1])>>

	<<if playerHasStrapon()>>
		<<if _args[0] isnot undefined and _args[0] is "strap-on" and $player.penisExist>>
			<!-- Do nothing. This is an override for wacky cases such as player masturbation -->
		<<else>>
			<<set _text_output to _penissize_text + "페니스 밴드">>
		<</if>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "reveal">>
	<<if _args[0]>>
		<<if _args[0] gte 900>>
			<span class="red">음란한</span>
		<<elseif _args[0] gte 700>>
			<span class="pink">외설적인</span>
		<<elseif _args[0] gte 500>>
			<span class="purple">유혹적인</span>
		<<elseif _args[0] gte 300>>
			<span class="blue">편안한</span>
		<<elseif _args[0] gte 200>>
			<span class="lblue">품위 있는</span>
		<<elseif _args[0] gte 100>>
			<span class="teal">단정한</span>
		<<else>>
			<span class="green">수수한</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "integrity">>
	<<if _args[0]>>
		<<if _args[1] is "cap">>
			<<if _args[0] gte 900>>
				<span class="green">질김</span>
			<<elseif _args[0] gte 500>>
				<span class="teal">튼튼함</span>
			<<elseif _args[0] gte 200>>
				<span class="lblue">견고함</span>
			<<elseif _args[0] gte 100>>
				<span class="blue">양호함</span>
			<<elseif _args[0] gte 50>>
				<span class="purple">연약함</span>
			<<elseif _args[0] gte 20>>
				<span class="pink">취약함</span>
			<<else>>
				<span class="red">엉성한</span>
			<</if>>

		<<else>>
			<<if _args[0] gte 900>>
				<span class="green">질긴</span>
			<<elseif _args[0] gte 500>>
				<span class="teal">튼튼한</span>
			<<elseif _args[0] gte 200>>
				<span class="lblue">견고한</span>
			<<elseif _args[0] gte 100>>
				<span class="blue">양호한</span>
			<<elseif _args[0] gte 50>>
				<span class="purple">약한</span>
			<<elseif _args[0] gte 20>>
				<span class="pink">취약한</span>
			<<else>>
				<span class="red">엉성한</span>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "strokes">>
	<<if $enemyanger gte ($enemyangermax / 5) * 4>>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			야만적으로 가지고 논다.
		<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 2>>
			악랄하게 가지고 논다.
		<<else>>
			거칠게 문지른다.
		<</if>>
	<<elseif $enemyanger gte ($enemyangermax / 5) * 2>>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			난폭하게 문지른다.
		<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 2>>
			단호하게 쓰다듬는다.
		<<else>>
			열정적으로 쓰다듬는다.
		<</if>>
	<<else>>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 2>>
			격렬하게 쓰다듬는다.
		<<else>>
			부드럽게 애무한다.
		<</if>>
	<</if>>
<</widget>>

<<widget "male">><<silently>>
	<<if $pronoun is "m">>
		<<set _text_output to "남성">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "여성">>
	<<elseif $pronoun>>
		<<set _text_output to "중성적">>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "male" 내에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "personsimple">><<silently>>
	<<if $NPCList[$index].type and $NPCList[$index].type isnot "human" and _args[0] isnot "normal">>
		<<set _text_output to window.KR.getBeastTypeKr($NPCList[$index].type)>>
	<<else>>
		<<set _text_output to "">>
	<</if>>
	<<if $role and $role isnot "normal" and _args[0] isnot "normal">>
		<<set _text_output += window.KR.getNpcRoleKr($role)>>
	<<elseif $pronoun is "m">>
		<<set _text_output += ($npcadult is 1 ? "남자" : "소년")>>
	<<elseif $pronoun is "f">>
		<<set _text_output += ($npcadult is 1 ? "여자" : "소녀")>>
	<<elseif $pronoun>>
		<<set _text_output += "사람">>
	<<else>>
		<<set _text_output += `<span class="red">[오류: "personsimple"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "personssimple">><<silently>>
	<<personsimple _args[0]>>
	<<set _text_output to _text_output + "의">>
<</silently>><<print _text_output>><</widget>>

<<widget "personname">><<silently>>
	<<if $NPCList[$index].name>>
		<<set _text_output to window.KR.gatPersonNameDictKR($NPCList[$index].name)>>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "personname"에서 정의되지 않은 이름]</span>`>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "person">><<silently>>
	<<if $index is "tentacles">>
		<<set $index to 0>>
	<</if>>
	<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description)) + " ">>
	<<if $NPCList[$index].type and $NPCList[$index].type isnot "human" and _args[0] isnot "normal">>
		<<set _text_output += window.KR.getBeastTypeKr($NPCList[$index].type)>>
	<</if>>
	<<if $npc_named is 1>>
		<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description))>>
	<<elseif $role and $role isnot "normal">>
		<<set _text_output += window.KR.getNpcRoleKr($role)>>
	<<elseif $pronoun is "m">>
		<<set _text_output += ($npcadult is 1 ? "남자" : "소년")>>
	<<elseif $pronoun is "f">>
		<<set _text_output += ($npcadult is 1 ? "여자" : "소녀")>>
	<<elseif $pronoun>>
		<<set _text_output += "사람">>
	<<else>>
		<<set _text_output += `<span class="red">[오류: "person"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "persons">><<silently>>
	<<person _args[0]>>
	<<set _text_output to _text_output + "의">>
<</silently>><<print _text_output>><</widget>>

<<widget "combatperson">><<silently>>
	/* _cpNpc keeps this widget safe on an empty or "tentacles" target slot */
	<<set _cpNpc to (($NPCList && $NPCList[$index]) ? $NPCList[$index] : null)>>
	<<if !_cpNpc>>
		<<set _text_output to "누군가">>
	<<elseif $npc_named is 1>>
		<<if _cpNpc.name_known is 1 and $description isnot "pale figure">>
			<<set _text_output to _cpNpc.fullDescription>>
		<<else>>
			<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description))>>
		<</if>>
	<<elseif _cpNpc.name_known is 1 and _cpNpc.name>>
		<<set _text_output to _cpNpc.name>>
	<<elseif $enemytype is "beast">>
		<<if $beastGroupFight is 1>>
			<<set _text_output to "the " + _cpNpc.fullDescription>>
		<<else>>
			<<set _text_output to "the " + _cpNpc.type>>
		<</if>>
	<<elseif $role and $role isnot "normal">>
		<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description)) + " " + window.KR.getNpcRoleKr($role)>>
	<<elseif $npcadult is 1>>
		<<if $pronoun is "m">>
			<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description)) + " 남자">>
		<<elseif $pronoun is "f">>
			<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description)) + " 여자">>
		<<else>>
			<<set _text_output to window.KR.getDescriptionKr(window.KR.getNpcTitleKr($description))>>
		<</if>>
	<<else>>
		<<set _text_output to "the " + _cpNpc.fullDescription>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "combatpersons">><<silently>>
	<<combatperson>>
	<<if (_text_output?.endsWith("s") or _text_output?.endsWith("sh")) and $NPCList[$index]?.name_known isnot 1>>
		<<set _text_output to _text_output>>
	<<else>>
		<<set _text_output to _text_output + "'s">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "combatPerson">><<silently>>
	<<combatperson>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "combatPersons">><<silently>>
	<<combatpersons>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "genderswapPlayer">>
	<!-- Note: You'll want to call this again when you're done, because its effects are visible on the sidebar caption if you leave it swapped, and we don't want that. -->
	<!-- Note 2: gender_appearance is recalculated at the start of each passage, so don't expect the effects to stick around. -->
	<<set $player.gender_appearance to ($player.gender_appearance is "f" ? "m" : "f")>>
<</widget>>

<<widget "genderswap">>
	<!-- Changes the current pronoun, without modifying the NPC it's referencing. Useful for crossdressing NPC dialogue. -->
	<!-- Usage: <<person1>><<genderswap>><<he>> -->
	<<if worldGenderOverrideActive() and ["m", "f"].includes($pronoun)>>
		<<set $pronoun to worldGenderOverrideForcedGender()>>
	<<else>>
		<!-- Cannot use genderswap when pronoun is anything other than "m" or "f". -->
		<<switch $pronoun>>
			<<case "m">> <<set $pronoun to "f">>
			<<case "f">> <<set $pronoun to "m">>
			<<default>> <<print `<span class="red">[오류: genderswap에서 잘못된 대명사, `+ $pronoun +`]</span>`>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "personselect">>
	<!-- This replaces calls person1 person2 etc. Used for NPC object calls -->
	<!-- Note calls are 0-5 corresponding to NPCs 1-6 -->
	<<if _args[0] is "tentacles">>
		<<set _n to 0>>
	<<else>>
		<<set _n to Number(_args[0])>>
		<<if isNaN(_n)>><<set _n to 0>><</if>>
	<</if>>
	<<set $index to _n>>
	<<if $bugNoticesShown is undefined>><<set $bugNoticesShown to {}>><</if>>
	<<if $NPCList is undefined>><<set $NPCList to []>><</if>>
	<<if !$NPCList[_n] or !$NPCList[_n].pronoun>>
		<<if !$bugNoticesShown.dolx_personselect_missing>>
			<<set $bugNoticesShown.dolx_personselect_missing to true>>
			<span class="red"><b>버그가 발생했습니다!</b> NPC-Personselect가 없지만 게임이 이를 복구했습니다. 디스코드 서버에 꼭 제보해 주십시오!</span><br>
		<</if>>
		<<run console.warn("personselect missing NPCList[" + _n + "] in " + $passage)>>
		/* Safe defaults so narration continues */
		<<set $npcadult to 1>><<set $pronoun to "m">><<set $description to "someone">><<set $role to "normal">><<set $npc_named to 0>>
	<<else>>
		<<run worldGenderOverrideNormalizeNpc($NPCList[_n])>>
		<<set $npcadult to $NPCList[_n].adult>>
		<<set $pronoun to $NPCList[_n].pronoun>>
		<<if $npcrow.includes(_n)>>
			<<set $description to $NPCName[$npcnum[$npcrow.indexOf(_n)]].title>>
			<<set $role to "normal">>
			<<set $npc_named to 1>>
			<<if $NPCName[$npcnum[$npcrow.indexOf(_n)]].nam is "Ivory Wraith">>
				<<set $description to "pale figure">>
			<</if>>
		<<else>>
			<<set $description to $NPCList[_n].description>>
			<<set $role to $NPCList[_n].role>>
			<<set $npc_named to 0>>
		<</if>>
	<</if>>
<</widget>>

<!-- Leaving person1-6 in place for legacy support as of v2.3-->
<<widget "person1">>
	<<personselect 0>>
<</widget>>

<<widget "person2">>
	<<personselect 1>>
<</widget>>

<<widget "person3">>
	<<personselect 2>>
<</widget>>

<<widget "person4">>
	<<personselect 3>>
<</widget>>

<<widget "person5">>
	<<personselect 4>>
<</widget>>

<<widget "person6">>
	<<personselect 5>>
<</widget>>

