:: Widgets Underground [widget]
<<widget "dungeonescape">>
	<!-- Every way out of the brothel runs through here, so this is where a contract is torn up. -->
	<<unset $undergroundbrothelhunt>>
	<<if $undergroundbrothelcontract>>
		<<storeon "underground_contract">>
		<<clearNPC "contract_master">>
		<<unset $contractWake>>
		<<if _args[0] isnot "contractServed">>
			<br>
			당신은 약속한 날짜보다 일찍 지하 창관을 떠났다. 계약은 취소된다. 일한 시간에 대한 대가는 지급되지 않는다.
			<br><br>
			<span class="red">창관이 당신을 쫓을 사람들을 보낼 것이다</span>. 일부 경찰관은 창관에서 돈을 받는다. 일주일 안에 그들에게 발각되면 다시 끌려간다. 남은 기간에 더해 무급으로 닷새를 더 복무하게 된다.
			<br><br>
			<<set $undergroundbrothelhunt to {
				"until": Time.days + 7,
				"remaining": Math.max(1, $undergroundbrothelcontract.end - Time.days),
				"penalty": $undergroundbrothelcontract.penalty
			}>>
		<</if>>
		<<unset $undergroundbrothelcontract>>
	<</if>>
	<!-- Reunion scenes trigger only after a week out of town. -->
	<<set _pcMissing to playerConsideredMissing()>>

	<<if $baileySold and _pcMissing>>
		<<set $baileyReunionScene to "dungeon">>
	<</if>>
	<!-- Bailey sold you here, so the weekends you spent locked up don't count against your deal. -->
	<<if $baileySold and $baileyMonogamous>>
		<<baileyWeekendVisitDone>>
	<</if>>

	<<if $whitneyromance is 1 and _pcMissing>>
		<<set $whitneyReunionScene to "dungeon">>
	<</if>>

	<<if C.npc.Kylar.love gte 50 and _pcMissing>>
		<<set $kylarReunionScene to "dungeon">>
	<</if>>

	<<if C.npc.Robin.init is 1 and _pcMissing>>
		<<if $hoursGoneFromHome gte 4 and !$undergroundbrothel.robin>>
			<<set $robinReunionScene to "dungeon">>
		<<elseif $undergroundbrothel.robinGone>>
			<<set $robinReunionScene to "dungeonRobin">>
		<</if>>
	<</if>>

	<<if $undergroundbrothel.robin>>
		<<set $robinmissing to 0>>
	<</if>>

	<<unset $baileySold>>
	<<unset $wraithUnderground>>
	<<set $undergroundbrothelescaped to true>>
	<<set $undergroundbrothel to {"escape": $undergroundbrothel.escape}>>
	<<unset $underground_shirt>>
<</widget>>

<<widget "undergroundCellOptions">>
	<<bedicon "zzz">><<link [[휴식 (1:00)|Underground Cell Rest]]>><<pass 1 hour>><<tiredness -12>><</link>><<ltiredness>>
	<br>
	<<if $undergroundbrothel.robin and !$undergroundbrothel.robinSpoke>>
		<<socialiseicon>><<link [[로빈과 대화한다 (0:10)|Underground Cell Robin Talk]]>><<pass 10>><<stress -4>><<trauma -4>><<npcincr Robin trauma -2>><</link>><<lstress>><<ltrauma>><<lrtrauma>>
		<br>
	<</if>>
	<<if $undergroundbrothel.escape is 0>>
		<<investigateicon>><<link [[나갈 길을 찾아본다|Underground Cell Look]]>><</link>>
	<<elseif $undergroundbrothel.escape gte 21>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>>
	<<elseif $undergroundbrothel.escape gte 19 and $physiquesize lte 15000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<elseif $undergroundbrothel.escape gte 18 and $physiquesize lte 12000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<elseif $undergroundbrothel.escape gte 17 and $physiquesize lte 10000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<elseif $undergroundbrothel.escape gte 16 and $physiquesize lte 8000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<elseif $undergroundbrothel.escape gte 14 and $physiquesize lte 6000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<elseif $undergroundbrothel.escape gte 13 and $physiquesize lte 3000>>
		<<getouticon "hole">><<link [[탈출한다|Underground Escape]]>><</link>><<small_text>>
	<<else>>
		<<getouticon "dig">><<link [[판다 (1:00)|Underground Cell Dig]]>><<pass 1 hour>><</link>>
	<</if>>
	<br>
	<<investigateicon>><<link [[문을 살펴본다|Underground Cell Lock]]>><</link>>
<</widget>>

<<widget "undergroundEscapeForestStart">>
	<<clotheson>>
	<<endcombat>>

	등골이 오싹해지며, 원초적인 본능이 경고를 보낸다. <span class="red">무언가가 당신을 사냥하고 있다.</span>
	<<set $foresthunt to 1>><<set $forestHunter to "Eden">><<badEndTrackingEnd "Underground Dungeon" { reason: "uDungeonDefeated" }>><<dungeonescape>>
	<br><br>
	<<specialClothesUnlock "set" "underground_brothel">>

	<<link [[다음|Forest]]>><<set $forest to 40>><</link>>
<</widget>>

<<widget "undergroundReturnToCell">>
	<<clearNPC handler>>

	<<tearful>> 당신은 매트리스 위에 앉는다.
	<<if _args[0] is "Robin">>
		적어도 로빈은 도망쳤다.
	<</if>>
	<<if $undergroundbrothelcontract>>
		<<stress -10>><<trauma -10>><<lstress>><<ltrauma>>
	<</if>>
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<if _args[0] is "skip">>
		<<set $eventskip to 1>>
	<</if>>

	<<if _args[0] is undefined or _args[0]>>
		<<if $undergroundbrothelcontract>>
			<<link [[다음|Underground Brothel Contract Quarters]]>><</link>>
		<<else>>
			<<link [[다음|Underground Cell]]>><</link>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "undergroundPlantFakeChoice">>
	"머리라도 다쳤어?" <<person2>><<person>>【이가】 투덜거린다. "<<pshe stranger>>【이가】 <<pverb "wants" "want" stranger>>원하든 말든 상관없어. <<pShes stranger>> 네 거야."
	<br><br>

	"아, 맞다! 이곳이 그런 식으로 돌아가는 걸 잊고 있었네!" <<person1>><<person>>【이가】 양손을 마주치더니 당신을 향해 달려든다.
	<br><br>

	<<link [[다음|Underground Plant Molestation]]>><<set $molestationstart to 1>><</link>>
<</widget>>

<<widget "averyUndergroundReunionReaction">>
	<<He>>【은는】 당신의 멱살을 <<if C.npc.Avery.rage gte 60>>홱 잡아채<<else>>붙잡아<</if>> 자신에게 끌어당긴다. <<He>>【이가】 다가와 귓가에 속삭인다.
	<<if C.npc.Avery.state is "dismissed">>
		"날 버린 건 큰 실수였어, 이 걸레야."
	<<elseif C.npc.Avery.rage gte 60>>
		<<if C.npc.Avery.love gte 60>>
			"너 같은 창녀가 <<goodgirl>>【이가】 되는 법을 배운 적이 없다니 참 유감이군."
		<<else>>
			"업보라고 생각해라, 이 건방진 걸레야. 이게 네게 <<goodgirl>>【이가】 되는 법을 가르쳐주겠지."
		<</if>>
	<<elseif C.npc.Avery.love gte 60>>
		<<if isLoveInterest("Avery")>>
			"이런 딱하기도 하지, <<pcpetname "Avery">>. 이번 주말엔 널 밖으로 데리고 나갈까 기대하고 있었는데."
		<<else>>
			"아쉽군, 너한테는 아주 훌륭한 잠재력이 있었는데 말이야."
		<</if>>
	<<else>>
		"네가 결국 오게 된 곳이 여기라니 안됐군. 언제나 창녀처럼 보이긴 했어."
	<</if>>
	<br><br>
<</widget>>

/* Once a day while the hunt lasts. Sets _brothelHuntCaught. */
<<widget "undergroundBrothelHuntRoll">>
	<<set _brothelHuntCaught to false>>
	<<if $undergroundbrothelhunt and !$daily.undergroundBrothelHunt>>
		<<set $daily.undergroundBrothelHunt to 1>>
		<<if Time.days gt $undergroundbrothelhunt.until or $undergroundbrothelcontract or ($undergroundbrothel and $undergroundbrothel.active)>>
			<<unset $undergroundbrothelhunt>>
		<<elseif random(1, 100) lte 15>>
			<<set _brothelHuntCaught to true>>
		<</if>>
	<</if>>
<</widget>>