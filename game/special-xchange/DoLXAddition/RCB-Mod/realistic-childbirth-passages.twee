            [["압박이 커지는 동안 경비원이 초조하게 지켜본다. 둘 다 무엇을 기대해야 할지 정확히 모른다는 것을 당신은 알 수 있다."],["default"]],
            [["한층 날카로운 진통에 다리가 움직인다. 경비원이 당신을 붙들어 주려 애쓴다."],["default"]],
            [["밀고 싶은 충동을 무시하기엔 너무 강해진다. 경비원이 숨을 쉬고 어서 하라고 말한다."],["default"]],
            [["진통마다 당신이 힘을 주는 동안 경비원이 근처를 맴돌며 쓸모 있어 보이려 애쓴다."],["default"]],
            [["경비원이 알이 보인다고 불쑥 말하더니, 제대로 받아 내려고 허둥댄다."],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["마지막으로 힘을 주자 알이 빠져나와 기다리던 경비원의 손에 놓인다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["당신은 마침내 알" + ($birth.fetuscount gt 1 ? "들을 모두 낳았다." : "을 낳았다.")],["default"]]
        ]
    },
    "bedroom":{
        "human":[
            [["진통이 오가는 동안 당신은 침대에 누워 힘을 아끼려 한다."],["default"]],
            [["진통이 강해진다. 당신은 침구를 움켜쥐고 아직 밀 때가 아니라고 스스로에게 되뇐다."],["default"]],
            [["몸이 속에서 차오르는 압박을 에워싸고 조인다."],["default"]],
            [["밀고 싶은 충동이 몸 안으로 서서히 스며들기 시작한다."],["default"]],
            [["당신은 진통에 맞춰 힘을 준다. 통증에 너무 매여 다른 것은 생각할 수 없다."],["default"]],
            [["아기가 보이기 시작한다. 당신은 숨을 몰아쉬고 떨면서 계속 민다."],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["마지막으로 힘을 주자 당신의 아이가 침구 위로 쑥 빠져나온다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "wolf":[
            [["새끼들이 몸속 낮은 곳에 자리 잡는 동안 당신은 침대에 누워 몸을 굳힌 채 거칠게 숨을 쉰다."],["default"]],
            [["진통이 강해진다. 몸이 움직이라고 재촉해도 당신은 기다려 보려 한다."],["default"]],
            [["압박이 골반을 타고 낮고 불편하게 옮겨 간다."],["default"]],
            [["몸이 밀라고 말한다. 당신은 침대에 몸을 버티며 자세를 잡는다."],["default"]],
            [["당신은 진통에 맞춰 힘을 주며 새끼가 나오도록 돕는다."],["default"]],
            [["새끼가 보이기 시작한다. 당신은 힘을 줄 때마다 몸이 벌어지는 것을 느낀다."],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["마지막으로 힘을 주자 새끼가 침구 위로 쑥 빠져나온다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "hawk":[
            [["당신은 짐승 같은 출산 충동을 어쩔 수 없이 느끼며 지저귄다."],["default"]],
            [["진통이 올 때마다 당신은 알을 짜내는 데 근육을 돕기라도 하려는 듯 제자리에서 몸을 흔든다."],["default"]],
            [["자궁경부에 일정한 압박이 차오르는 것이 느껴진다."],["default"]],
            [["진통과 함께 더 세게 밀고 싶은 충동이 느껴진다."],["default"]],
            [["밀고 싶은 충동이 한껏 치솟는다. 다른 것에는 집중할 수 없다."],["default"]],
            [["알이 당신의 " + ($birth.genital is "vagina" ? either("보지","씹구멍") : either("항문","괄약근")) + " 밖으로 불룩 튀어나온다. 이제 몇 번만 제대로 밀면 된다."],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["압박이 사라지자 당신은 해낸 일에 만족감을 느낀다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["결코 만만한 일은 아니었지만, 알" + ($birth.fetuscount gt 1 ? "들" : "") + "을 낳는 기분이 얼마나 좋았는지 생각하면 들뜬 마음을 숨길 수 없다."],["default"]]
        ]
    }
},
"stageInitial":{
