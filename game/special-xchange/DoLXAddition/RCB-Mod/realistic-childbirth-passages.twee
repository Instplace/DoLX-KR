	<<set setup.birthPrompts.stage["forest shop"] to {"human":[
		[["당신은 고통을 숨으로 견딘다. \"좋아, 그렇게 하면 돼.\" 그윌란이 말한다."],["default"]],
		[["또 한 번의 진통에 당신이 신음한다. 그윌란이 당신의 배를 문질러 준다. \"숨 쉬렴. 곧 지나갈 거야.\""],["default"]],
		[["그윌란이 당신의 다리 사이를 살핀다. 당신은 <<nnpc_his \"Gwylan\">> 손길에 몸을 굳힌다. \"아직이야, 얘야.\" <<nnpc_he \"Gwylan\">>【이가】 말한다."],["default"]],
		[["또 한 번의 진통이 닥치자 당신이 그윌란의 팔을 붙잡는다. \"내가 붙잡고 있어.\" <<nnpc_he \"Gwylan\">>【이가】 말한다."],["default"]],
		[["당신은 다리를 벌리고 힘을 준다. 그윌란이 당신 앞에 무릎을 꿇고 도울 준비를 한다."],["default"]],
		[["아기가 더 아래로 내려오는 것이 느껴진다. \"다시 밀어.\" 그윌란이 말한다. 당신은 이를 악물고 <<nnpc_he \"Gwylan\">>【이가】 시키는 대로 한다."],["default"]],
		[["아기가 당신을 활짝 벌린다. 당신이 비명을 지른다. \"천천히.\" 그윌란이 말한다. \"거의 다 왔어.\""],["default"]],
		[["갓난아기가 그윌란의 손 안에서 운다. 당신은 헐떡이며 베개에 몸을 기댄다."],["default"]],
		[["그윌란이 아기를 수건으로 싸는 동안 당신은 숨을 고른다. \"잠깐만, 얘야.\" <<nnpc_he \"Gwylan\">>【이가】 말한다."],["default"]],
		[["당신은 너무 지쳐 움직이지도 못하고 누워 있다. 그윌란이 당신을 닦아 주고 아기를 살핀다. \"다 끝났어.\" <<nnpc_he \"Gwylan\">>【이가】 말한다."],["default"]]
	]}>>
