:: Childbirth

/* Safety gate: validate $birth and migrate old versions before running the birth.
   Heavy logic lives in realistic-childbirth-init.js (setup.rcbBirthSafetyCheck). */
<<set _rcb to setup.rcbBirthSafetyCheck()>>
<<if _rcb.action is "eject">>
	/* $birth was missing or from an unsupported version, so the birth minigame can't run safely.
	Wind the encounter down through the normal end routing for the deduced location instead of leaving the player soft-locked. */
	<<include "Childbirth End">>
<<else>>

<<if $childbirthstart is 1 or $birth.filters is undefined or setup.birthPrompts is undefined or setup.birthDialog is undefined>>
	<<set _birthRebuildRuntime to ($childbirthstart is 1 or $birth.filters is undefined or setup.birthDialog is undefined)>>
	<!-- setup caches are not saved, so rebuilding them must not rewind an in-progress birth. -->
	<<if $childbirthstart is 1 or $birth.filters is undefined>>
	<<set $birth["version"] to setup.RCB_BIRTH_VERSION>>
	<<if $waterDragonBirthContext>>
		<<set $birth["fetuscount"] to $waterDragonBirthContext.count>>
		<<set $birth["father"] to $waterDragonBirthContext.fertilised ? "unknown" : "none">>
		<<set $birth["type"] to "hawk">>
		/* The caller already worked out which hole the clutch is coming from (an omega carries in the anus even with a vagina present). Only guess when it didn't say. */
		<<if !["vagina", "anus"].includes($birth.genital)>>
			<<if $player.vaginaExist>><<set $birth.genital to "vagina">><<else>><<set $birth.genital to "anus">><</if>>
		<</if>>
	<<elseif playerIsPregnant()>>
		<<set [_pregnancy,$birth.genital] to getPlayerPregnancyForBirth(true)>>
		<<if childBaseSpecies(_pregnancy.donorSpecies) is "hawk">>
			<<set $birth["fetuscount"] to getChildrenOf(_pregnancy.pregnancyId).length>>
			<<set $birth["father"] to "Great Hawk">>
			<<set $birth["type"] to "hawk">>
		<<else>>
			<<set $birth["fetuscount"] to getChildrenOf(_pregnancy.pregnancyId).length>>
			<<set $birth["father"] to _pregnancy.donor>>
			<<set $birth["type"] to childBaseSpecies(_pregnancy.donorSpecies)>>
		<</if>>
	<<else>>
		<<set $birth["fetuscount"] to $harpyEggs.count>>
		<<set $birth["father"] to "none">>
		<<set $birth["type"] to "hawk">>
		<<if $player.vaginaExist>>
			<<set $birth.genital to "vagina">>
		<<else>>
			<<set $birth.genital to "anus">>
		<</if>>
	<</if>>
	<<set $combat to 1>>
	<<set $birth["filters"] to {"dynamic":{},"static":{},"partner":{}}>>
	<<set _tagsToUpdate to []>>
	<<set $enemytype to "childbirth">>
	<<if $birth.stage is undefined>>
		<<set $birth["stage"] to 1>>
	<</if>>
	<<set $birth["stagechange"] to 1>>
	<<set $birth["progressrng"] to 1>>
	<<set $birth["stageprogress"] to 0>>
	<<set $birth["pace"] to 0>>
	<<set $birth["pushurge"] to 0>>
	<<set $birth["waveCeiling"] to 25>>
	<<set $birth["waveCount"] to 0>>
	<<set $birth["totalWaveCount"] to 0>>
	<<set $birth["stageWaveCount"] to 0>>
	<<set $birth["fetusmovement"] to 0>>
	<<set $birth["contractions"] to 0>>
	<<set $birth["delivered"] to 0>>
	<<if $childbirthstart is 1>>
		<!-- Early labour hurts and rattles the nerves, but it shouldn't wipe out a rested player on turn one. Raise pain to a floor and add to fatigue/stress instead of overwriting them. -->
		<<set $pain to Math.min(Number($painmax) || 200, Math.max(Number($pain) || 0, 100))>>
		<<set $tiredness to Math.min(Number($tirednessmax) || 2000, (Number($tiredness) || 0) + 500)>>
		<<set $stress to Math.min(Number($stressmax) || 10000, (Number($stress) || 0) + 1200)>>
		첫 번째 본격적인 진통이 방심한 당신을 덮친다. 배를 가로질러 등으로 조여 든다. 진통은 지나가지만, 남은 통증이 <span class="red">이것이 진짜라는 것</span>을 알려 준다.<<gggpain>><<ggstress>><<gtiredness>><br><br>
	<</if>>
	<<set $birth.movementodds to [[60,75,90,94,96,99,200,200],[50,70,85,90,93,96,200,200],[40,60,80,85,90,95,200,200],[30,40,50,70,80,90,200,200],[30,40,50,70,80,90,200,200],[30,40,50,70,80,90,200,200],[20,35,50,65,75,85,200,200],[0,0,0,0,0,0,200,200],[1,1,1,1,1,1,200,200],[1,1,1,1,1,1,200,200]]>>
	<<if $birth.inlobby is undefined>>
		<<switch $birth.location>>
		<<case "asylum" "wolf cave" "forest shop" "bedroom" "tower" "waterdragon_nest" "waterdragon_lab">>
			<<set $birth["inlobby"] to "">>
		<<case "hospital">>
			<<if ["Alex","Avery","Eden","Robin","Sydney","Whitney","Kylar","Poppy"].includes($birth.father) and knowsAboutPregnancy("pc", $birth.father)>>
				<<set $birth["inlobby"] to $birth.father>>
			<<else>>
				<<set $birth["inlobby"] to "">>
			<</if>>
		<<case "cottage">>
			<<set $birth["inlobby"] to "Alex">>
		<<case "prison">>
			<<if $birth.father is "Kylar" and $prison.kylar is "active">>
				<<set $birth["inlobby"] to "Kylar">>
			<<else>>
				<<set $birth["inlobby"] to "">>
			<</if>>
		<</switch>>
	<</if>>
	<<if $birth.partner is undefined>>
		<<set $birth["partner"] to "Alone">>
	<</if>>
	<<if $birth.calledPartner is undefined>>
		<<set $birth["calledPartner"] to 0>>
	<</if>>
	<<if $birth.epidural is undefined>>
		<<set $birth["epidural"] to 0>>
	<</if>>
	<<if $birth.type is "hawk">>
		<<set $position to "doggy">>
	<<else>>
		<<set $position to "missionary">>
		<<set $thighuse to "penis">>
		<<set $worn.lower.vagina_exposed to $worn.lower.anus_exposed>>
	<</if>>
	<</if>>
	<!--modloader commented out-->
	<!--modloader dummy dialog/prompts left disabled. Static childbirth text now lives in setup, not $birth.-->
	<!--Release note: setup.birthDialog and setup.birthPrompts are cached on setup. After changing childbirth prompt or dialog content, refresh the browser before continuing an in-progress birth.-->
	<<if setup.birthDialog is undefined or _birthRebuildRuntime>>
	<<run setup.birthDialog = {"randomFull":[
[[{"Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["진통 사이에 잠깐 숨을 돌릴 틈이 생긴다. 방 안은 당신의 숨소리 말고는 조용하다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["조여 오던 압박이 잠시 누그러든다. 곧 다시 올 것임을 당신은 안다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["당신은 숨을 세며 앞으로 얼마나 남았는지 생각하지 않으려 애쓴다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["둔한 경련이 한 차례 몸을 훑고 지나가다 사그라든다. 뒤따르는 정적이 믿기지 않는다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["당신은 몸을 뒤척이며 통증이 조금이라도 덜한 자세를 찾는다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["진통이 점점 날카로워지고, 간격도 짧아진다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["한층 강한 경련이 당신을 움켜쥔다. 그것이 놓아 주고 나서도 정신을 가다듬는 데 시간이 걸린다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["당신은 숨을 고르게 쉬려 하지만, 진통이 자꾸 호흡의 리듬을 깨뜨린다."],["default"]],{},1],
[[{"Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["통증과 통증 사이에 방 안이 무척 고요하게 느껴진다. 마치 당신과 함께 기다리고 있는 것처럼."],["default"]],{},1],
[[{"Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["몸이 다시 조여 온다. 이번에는 더 단단하게. 당신은 그저 버텨 낼 수밖에 없다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":1},{"Stage":3},{},{}],[["로빈【이가】 침대 곁에 바짝 붙어, 당신의 얼굴과 손을 번갈아 살피며 조심스러운 목소리로 필요한 게 없는지 묻는다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":1},{"Stage":3},{},{}],[["로빈【이가】 당신을 위해 웃어 보이려 하지만, 잘하고 있다고 다독이는 와중에도 <<nnpc_his \"Robin\">> 걱정이 얼굴에 그대로 드러난다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":1},{"Stage":3},{},{}],[["로빈【이가】 당신 옆의 침구를 매만지며, 손이 닿는 것마다 괜히 만지작거린다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":1},{"Stage":3},{},{}],[["로빈【이가】 진통 사이에 당신의 손을 가볍게 쥐고, 숨을 쉬라고, <<nnpc_him \"Robin\">>【와과】 함께 있으라고 일러 준다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":3},{"Stage":5},{},{}],[["다음 진통이 더 세게 닥치자 로빈【이가】 입을 다문다. 부탁하지 않았는데도 <<nnpc_his \"Robin\">> 손을 내어 준다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":3},{"Stage":5},{},{}],[["로빈【이가】 침을 삼키며 당신이 통증을 견디는 모습을 지켜본다. 더 힘들어 보일수록 곁에 바짝 붙는다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":3},{"Stage":5},{},{}],[["로빈【이가】 더 가까이 몸을 기울이고, 낮은 목소리로 진통이 몰아치는 동안에는 씩씩한 소리를 내려고 애쓰지 않아도 된다고 말한다."],["default"]],{},1],
[[{"Partner":"Robin","Stage":3},{"Stage":5},{},{}],[["진통이 가라앉는 동안 로빈【이가】 서툴지만 조심스러운 손길로 당신의 이마를 닦아 준다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":1},{"Stage":3},{},{}],[["휘트니【이가】 이 방이 이 상황을 더 나쁘게 만들기만 해 보라는 듯한 태도로 침대 곁에 서 있다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":1},{"Stage":3},{},{}],[["휘트니【이가】 당신의 숨소리에 혀를 차며 벌써부터 한심한 꼴 보이지 말라고 말하지만, 평소보다는 날이 덜 서 있다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":1},{"Stage":3},{},{}],[["휘트니【이가】 인상을 쓰며 모니터를 노려보다가, 당신이 아직 버티고 있는지 다시 확인한다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":1},{"Stage":3},{},{}],[["휘트니【이가】 당신이 붙잡을 수 있을 만큼만 가까이 맴돈다. 일부러 그런 게 아닌 척하면서."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":3},{"Stage":5},{},{}],[["진통이 당신에게서 신음을 끌어내자 휘트니의 비웃음이 사라지고, <<nnpc_he \"Whitney\">>【이가】 당신더러 <<nnpc_him \"Whitney\">>【을를】 보라고 다그친다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":3},{"Stage":5},{},{}],[["휘트니【이가】 <<nnpc_his \"Whitney\">> 입속으로 뭔가 중얼거리다가, 이번에는 더 또렷하게 당신이 잘 해내고 있다고 말한다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":3},{"Stage":5},{},{}],[["휘트니【이가】 난간 위로 몸을 숙이고, 거친 목소리를 낮춰 겁먹기 전에 숨부터 쉬라고 말한다."],["default"]],{},1],
[[{"Partner":"Whitney","Stage":3},{"Stage":5},{},{}],[["가장 힘든 순간에 휘트니의 손이 당신의 손을 찾아 쥔다. 당신이 흔들리지 않도록 붙잡아 줄 만큼 단단한 악력이다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":1},{"Stage":3},{},{}],[["카일라【이가】 곁에 걸터앉아 당신의 얼굴에 스치는 모든 변화를 살핀다. 고통이 닿기도 전에 막아 낼 수 있다는 듯이."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":1},{"Stage":3},{},{}],[["카일라【이가】 진통 사이사이에 당신의 이름을 부드럽고 불안하게 속삭이며, 바로 여기 있겠다고 약속한다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":1},{"Stage":3},{},{}],[["카일라【이가】 당신 팔 옆의 시트를 매만지고, 또 매만진다. 불안한 손이 할 일을 찾고 있다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":1},{"Stage":3},{},{}],[["카일라【이가】 문을 흘끔거리다가 다시 당신을 본다. 누가 <<nnpc_him \"Kylar\">>【을를】 데려가 버릴까 겁내는 것처럼."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":3},{"Stage":5},{},{}],[["당신이 몸에 힘을 주자 카일라【이가】 움찔하더니, 더 가까이 다가와 쥐고 있으라며 <<nnpc_his \"Kylar\">> 손을 내민다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":3},{"Stage":5},{},{}],[["카일라의 목소리는 떨리지만, 당신을 격려하는 동안에도 당신의 손을 쥔 <<nnpc_his \"Kylar\">> 손은 흔들리지 않는다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":3},{"Stage":5},{},{}],[["카일라【이가】 조심스럽고 떨리는 집중력으로 당신의 얼굴을 닦아 주며, 조금이라도 나아졌는지 살핀다."],["default"]],{},1],
[[{"Partner":"Kylar","Stage":3},{"Stage":5},{},{}],[["카일라【이가】 몸을 숙인다. 너무 가까울 정도로. 더 심해지면 말해 달라고 부탁하는 목소리에 걱정이 그대로 묻어난다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":1},{"Stage":3},{},{}],[["포피【이가】 당신의 손을 놓지 않은 채 엄지로 당신의 손가락 마디를 쓸며 잘하고 있다고 말한다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":1},{"Stage":3},{},{}],[["포피【이가】 천으로 당신의 이마를 톡톡 두드린다. 진통이 잦아든 사이에도 당신을 챙기느라 분주하다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":1},{"Stage":3},{},{}],[["포피【이가】 가까이 몸을 기울인다. 희미한 분 냄새가 <<nnpc_him \"Poppy\">>에게서 풍긴다. 포피【이가】 바로 여기 있다고 속삭인다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":1},{"Stage":3},{},{}],[["포피【이가】 당신의 얼굴에 떠오르는 고통의 기색을 하나도 놓치지 않고 살피며, 당신을 <<nnpc_his \"Poppy\">> 보석이라 부른다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":3},{"Stage":5},{},{}],[["진통이 정점에 이르자 포피의 손아귀가 당신의 손과 함께 조여들고, <<nnpc_his \"Poppy\">> 손마디가 하얗게 질린다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":3},{"Stage":5},{},{}],[["포피【이가】 목소리를 낮추고 <<nnpc_him \"Poppy\">>【와과】 함께 숨을 쉬라고 말한다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":3},{"Stage":5},{},{}],[["파도 사이사이에 포피【이가】 당신의 관자놀이에 입을 맞추고, 이 모든 게 보람 있을 거라고 약속한다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":3},{"Stage":5},{},{}],[["당신이 비명을 지르자 포피【이가】 잠시 흔들리지만, 이내 마음을 다잡고 당신의 손을 더 꽉 쥔다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":5},{"Stage":8},{},{}],[["포피【이가】 가장 힘든 순간에도 당신의 손을 잡고, 당신이 얼마나 자랑스러운지 말한다."],["default"]],{},1],
[[{"Partner":"Poppy","Stage":5},{"Stage":8},{},{}],[["포피【이가】 눈시울이 젖은 채 당신을 바라보며 당신의 이름을 몇 번이고 부른다."],["default"]],{},1],
[[{"Location":"hospital","Partner":"Alone"},{},{},{}],[["조산사가 심박 모니터를 확인한다. \"모두 정상이에요.\""],["default"]],{},-1],
[[{"Location":"hospital","Partner":"Alone"},{},{},{}],[["조산사가 당신에게 묻는다. \"아기 아버지는 어디 있나요?\""],["default"]],{"Stress":100},1],
[[{"Location":"hospital","Partner":"Alone"},{},{"test":1},{}],[["조산사가 당신에게 묻는다. \"제가 해 드릴 수 있는 게 있을까요?\""],["default"]],{},1],
[[{"Location":"hospital","Stage":1},{"Stage":5},{},{}],[["조산사가 침대 곁을 지키며 진통 사이의 고요한 시간 동안 당신을 다독인다."],["default"]],{},-1],
[[{"Location":"hospital","Stage":5},{"Stage":8},{},{}],[["조산사가 다음 파도가 밀려오는 것을 지켜본다. \"정점에 올랐을 때 같이 밀어요.\""],["default"]],{},-1],
[[{"Location":"hospital","Stage":5},{"Stage":8},{},{}],[["하퍼가 경과를 살핀 뒤 조산사에게 고개를 끄덕인다. \"계속 진행하세요. 내려오고 있습니다.\""],["default"]],{},-1],
[[{"Partner":"Robin"},{},{},{}],[["넌 정말 대단해!"],["default"]],{"Stress":-5},3],
[[{"Location":"bedroom","Partner":"Robin","FetusHawk":$birth.fetuscount},{},{},{}],[["로빈【은는】 입을 떡 벌린 채, 활짝 벌어진 당신의 구멍을 계속 쳐다보고 있다"],["default"]],{},-1],
[[{"Location":"cottage","Partner":"Alex","Stage":3},{},{"AlexTowels":1},{}],[["하퍼가 알렉스에게 돌아선다. \"수건이 더 필요한데, 가져다주시겠어요?\" 알렉스가 벌떡 일어나 대답한다. \"바로 가져올게요!\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{},{}],[["\"넌 할 수 있어, <<genderedTF \"cow\">>.\" 알렉스가 당신에게 자신감을 북돋아 주려 말한다. |","- 스트레스"],["default","green"]],{"Stress":-50},3],
[[{"Location":"cottage","Partner":"Alex","CottageNursery":1},{},{},{}],[["\"아기방에 준비는 다 해 뒀어. 걱정할 거 하나도 없어.\" 알렉스가 안심시키듯 말한다."],["default"]],{},2],
[[{"Location":"cottage","Partner":"Alone","CottageNursery":1},{"PartnerCalled":1},{},{}],[["\"곁에 누가 필요하시면 알렉스를 불러 드릴 수 있습니다.\" 하퍼가 차분하게 말하며, 혼자여도 괜찮다고 당신을 안심시킨다."],["default"]],{},2],
[[{"Location":"cottage","Partner":"Alex","Stage":2},{"CottageNursery":1},{"AlexUncertain":1},{}],[["알렉스의 표정에서 자신감은 별로 보이지 않는다. \"나... 우리 준비된 거 맞지?\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex","Stage":4},{},{},{}],[["\"숨 쉬어, 파트너. 계속 그렇게.\" 알렉스가 당신을 격려한다."],["default"]],{},-1],
[[{"Location":"cottage","Partner":"Alex","Stage":5},{},{},{}],[["알렉스가 최선을 다해 당신을 이끈다. \"넌 강한 사람이야, 해낼 수 있어. 밀고, 숨 쉬어.\""],["default"]],{},-1],
[[{"Location":"cottage","Partner":"Alex","Stress":80},{"Stage":5},{},{}],[["\"이봐, 파트너, 아주 잘하고 있어. 그래도 너무 무리하진 마.\" 알렉스가 걱정스러운 얼굴로 말한다."],["default"]],{"Stress":-10},1],
[[{"Location":"cottage","Partner":"Alex"},{},{},{}],[["\"저기, 의사 선생님? 제가 더 도울 일이 있을까요?\" 하퍼가 알렉스를 돌아본다. \"필요하면 말씀드리겠습니다. 지금은 없습니다.\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex","Stat1":10,"Love":70,"Stage":3},{"AlexWantsKids":1},{},{}],[["\"<<attaGirl>>. 대가족이 될 날이 얼른 왔으면 좋겠다.\" 알렉스가 말한다. 이번이 마지막 출산이 아닐지도 모른다는 뜻을 슬쩍 비친다."],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex","Love":70,"Lust":20,"Stage":3},{"Stat1":-10},{"AlexWantsKids":1},{}],[["\"<<attaGirl>>. 선생님? 낳고 나서 얼마나 기다려야 해요?\" 알렉스가 말한다. 이번이 마지막 출산이 아닐지도 모른다는 뜻을 슬쩍 비친다."],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{},{}],[["\"좀 어때, 파트너?\" 알렉스가 묻는다. \"필요하면 내 손을 더 세게 쥐어도 돼.\""],["default"]],{},-1],
[[{"Location":"cottage","Partner":"Alex","Epidural":3},{},{},{}],[["\"좀 나아졌어?\" 알렉스가 묻는다. \"슬슬 듣기 시작해.\" 당신은 대답하며, 더 빨리 들었으면 하고 바란다."],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex","Epidural":10},{},{},{}],[["\"으으, 훨씬 낫다.\" 당신이 알렉스에게 말한다. \"그 마취 주사 진짜 대단하네!\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{"AlexDayDream1":1},{}],[["\"생각해 봐.\" 알렉스가 당신의 정신을 돌려 보려고 말한다. \"곧 우리한테도 가족이 생기는 거야.\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{"AlexDayDream2":1},{"AlexDayDream1":1}],[["\"난 우리 엄마 아빠가 날 키운 것처럼 애들을 키우고 싶어.\" 알렉스가 계속 몽상에 잠긴다. \"꼬맹이들이 들판을 뛰어다니는 모습...\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{"AlexDayDream3":1},{"AlexDayDream2":1}],[["\"...들판을 좀 더 안전하게 만들어야겠다.\" 알렉스가 아이에게 이 일대가 얼마나 위험할 수 있는지 깨닫고 말한다. \"걱정 마, 그건 나중에 해도 시간 많아.\""],["default"]],{},1],
[[{"Location":"cottage","Partner":"Alex"},{},{},{"AlexDayDream3":1}],[["\"이 일대를 전부 길들일 수 있어, 우리가—\" 알렉스가 <<nnpc_his \"Alex\">> 꿈을 자랑하다가, 당신이 <<nnpc_his \"Alex\">> 손을 유난히 세게 쥐는 바람에 말이 끊긴다. \"나중에, 알렉스.\" 당신이 못 박는다. \"미안, 맞아, 지금에 집중해야지.\""],["default"]],{},1],
[[{"Location":"hospital","Partner":"Whitney"},{},{},{}],[["휘트니【이가】 침대 곁을 서성이며, 이 모든 게 기계 중 하나의 탓이라도 되는 것처럼 기계들을 노려본다."],["default"]],{},1],
[[{"Location":"wolf cave","Stage":1},{"Stage":3},{},{}],[["동굴 바닥이 차갑다. 진통 사이의 쉬는 시간조차 별 위안이 되지 않는다."],["default"]],{},1],
[[{"Location":"wolf cave","Stage":1,"Partner":"Black Wolf"},{"Stage":3},{},{}],[["검은 늑대가 <<bhis>> 머리를 당신 곁에 낮추고, 당신의 숨이 가빠지자 낮게 으르렁거린다."],["default"]],{"Stress":-10},1],
[[{"Location":"wolf cave","Stage":3},{"Stage":5},{},{}],[["동굴 깊은 곳에서 들리는 소리에 신경이 곤두서지만, 다음 진통이 닥쳐 돌아볼 틈이 없다."],["default"]],{"Stress":20},1],
[[{"Location":"wolf cave","Stage":5},{"Stage":8},{},{}],[["몸이 다시 힘을 주자 두 손이 거친 바닥을 긁는다. 새끼들이 파도가 칠 때마다 점점 더 아래로 내려온다."],["default"]],{},1],
[[{"Location":"prison","Stage":1},{"Stage":3},{},{}],[["감옥 침대가 당신의 몸 아래서 삐걱거린다. 얇은 침구는 엉덩이 쪽에 자리 잡은 통증을 거의 달래 주지 못한다."],["default"]],{},1],
[[{"Location":"prison","Stage":1,"Partner":"Alone"},{"Stage":3},{},{}],[["꼼꼼한 경비원이 걱정 어린 얼굴로 당신을 지켜본다. 실제보다 더 확신이 있어 보이려 애쓰면서."],["default"]],{},1],
[[{"Location":"prison","Stage":3},{"Stage":5},{},{}],[["감방 밖으로 발소리가 지나간다. 당신은 이를 악물고 숨을 쉰다. 얼마나 심한지 그들이 듣게 하고 싶지 않다."],["default"]],{"Stress":15},1],
[[{"Location":"prison","Stage":5},{"Stage":8},{},{}],[["당신이 힘을 줄 때마다 침대 틀이 덜컹거린다. 경비원이 너무 가까운 곳에서 더듬거리며 격려한다."],["default"]],{},1],
[[{"Location":"asylum","Stage":1},{"Stage":3},{},{}],[["방에서 소독약 냄새가 난다. 진통 사이의 틈조차 휴식이라기보다 기다림에 가깝게 느껴진다."],["default"]],{},1],
[[{"Location":"asylum","Stage":3},{"Stage":5},{},{}],[["하퍼의 차분한 목소리가 안개를 뚫고 들려온다. 침착하고 확신에 찬 목소리지만, 당신의 몸은 어느 쪽도 느끼지 못한다."],["default"]],{},1],
[[{"Location":"asylum","Stage":5},{"Stage":8},{},{}],[["다시 한 번 가혹한 파도에 힘을 주는 동안 구속구와 하얀 벽이 시야 가장자리에서 흐려진다."],["default"]],{"Stress":20},1],
[[{"Location":"tower","Stage":1},{"Stage":3},{},{}],[["알이 더 아래로 내려오는 동안 짚이 몸 아래서 부스럭거린다. 둥지는 따뜻하지만 압박을 덜어 주지는 못한다."],["default"]],{},1],
[[{"Location":"tower","Stage":3},{"Stage":5},{},{}],[["탑의 바람이 피부를 스치는 동안, 당신의 근육이 몸속의 매끈한 무게를 에워싸고 조여든다."],["default"]],{},1],
[[{"Location":"tower","Stage":5},{"Stage":8},{},{}],[["당신은 둥지에 손가락을 파묻고 힘을 준다. 고집스럽게 움직일 때마다 껍데기가 당신을 더 넓게 벌린다."],["default"]],{},1],
[[{"Location":"bedroom","Partner":"Alone","Stage":1},{"Stage":3},{},{}],[["이제 당신의 방도 아무 도움이 되지 않는다. 또 한 번의 진통을 견디는 동안 침구가 손 아래서 뒤엉킨다."],["default"]],{},1],
[[{"Location":"bedroom","Partner":"Alone","Stage":3},{"Stage":5},{},{}],[["당신은 문밖의 발소리에 귀를 기울이며, 참지 못하고 새어 나온 신음을 아무도 듣지 못했기를 바란다."],["default"]],{"Stress":15},1],
[[{"Location":"bedroom","Stage":5},{"Stage":8},{},{}],[["몸이 제멋대로 움직이며 세게 밀어내는 동안 침대가 꺼지며 삐걱거린다. 방 안에 혼자라고 해도 소용없다."],["default"]],{},1]
