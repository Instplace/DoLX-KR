    "foldOutside":[["당신은 왼손으로 근처에 있던 막대기를 느슨하게 잡는다."],["default"]],
    "foldRail":[["당신은 왼손으로 침대 옆 난간을 느슨하게 잡는다."],["default"]],
    "restSuccess":[
