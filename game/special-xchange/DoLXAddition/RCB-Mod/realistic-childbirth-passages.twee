"stage":{
    "hospital":{
        "human":[
            [["당신은 발걸이에 자리를 잡고, 다가올 일에 대비한다. 하퍼가 지금은 힘을 아껴 두라고 말한다."],["default"]],
            [["진통이 점점 강해지고 간격도 좁아지며 당신의 몸이 파도처럼 긴장한다. 하퍼가 모두 지극히 정상이라고 말한다."],["default"]],
            [["근육이 조여 드는 동안 하퍼가 발걸이가 당신을 안전하게 붙들고 있는지 확인한다. <<nnpc_He \"Harper\">>【은는】 알려 준다. \"아직 밀 때가 아닙니다.\""],["default"]],
            [["하퍼가 경과를 계속 지켜본다. 하지만 당신은 <<nnpc_him \"Harper\">>에게 거의 신경 쓸 수가 없다."],["default"]],
            [["당신은 하퍼에게 신경 쓸 겨를도 없이 계속 아이" + ($birth.fetuscount gt 1 ? "들을 낳는다." : "를 낳는다.")],["default"]],
            [["머릿속에서 모든 생각이 밀려난 채 당신은 계속 아이" + ($birth.fetuscount gt 1 ? "들을 낳는다." : "를 낳는다.")],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["하퍼가 <<nnpc_his \"Harper\">> 품으로 아기를 받아 낸다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["지친 당신은 몸이 무너져 내리는 것을 느끼고, 간호사들이 모두 무사한지 확인하러 서둘러 달려온다."],["default"]]
        ],
        "wolf":[
            [["당신은 발걸이에 자리를 잡고, 다가올 일에 대비한다. 하퍼가 지금은 힘을 아껴 두라고 말한다."],["default"]],
            [["진통이 점점 강해지고 간격도 좁아지며 당신의 몸이 파도처럼 긴장한다. 하퍼가 모두 지극히 정상이라고 말한다."],["default"]],
            [["근육이 조여 드는 동안 하퍼가 발걸이가 당신을 안전하게 붙들고 있는지 확인한다. <<nnpc_He \"Harper\">>【은는】 알려 준다. \"아직 밀 때가 아닙니다.\""],["default"]],
            [["하퍼가 경과를 계속 지켜본다. 하지만 당신은 <<nnpc_him \"Harper\">>에게 거의 신경 쓸 수가 없다."],["default"]],
            [["당신은 하퍼에게 신경 쓸 겨를도 없이 계속 새끼" + ($birth.fetuscount gt 1 ? "들을 낳는다." : "를 낳는다.")],["default"]],
            [["머릿속에서 모든 생각이 밀려난 채 당신은 계속 새끼" + ($birth.fetuscount gt 1 ? "들을 낳는다." : "를 낳는다.")],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["하퍼가 <<nnpc_his \"Harper\">> 품으로 새끼를 받아 낸다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["지친 당신은 몸이 무너져 내리는 것을 느끼고, 간호사들이 모두 무사한지 확인하러 서둘러 달려온다."],["default"]]
        ],
        "hawk":[
            [["하퍼가 임상적인 관심으로 당신의 진통을 지켜본다. 알은 몸속 낮은 곳에 자리 잡았지만 아직 나올 준비는 되지 않았다."],["default"]],
            [["압박이 꾸준히 커진다. 당신이 꿈틀거리고 싶은 충동과 싸우는 동안 하퍼가 변화를 기록한다."],["default"]],
            [["한층 날카로운 진통에 몸이 긴장한다. 하퍼가 경과를 확인하고 계속 숨을 쉬라고 말한다."],["default"]],
            [["하퍼가 알이 밀기 시작해도 될 만큼 내려왔다고 말한다. 당신의 몸도 동의하는 듯하다."],["default"]],
            [["하퍼가 지켜보는 가운데 당신이 힘을 준다. 알이 진통이 올 때마다 움직인다."],["default"]],
            [["하퍼가 알이 보이기 시작한다고 알리고, 받아 낼 준비를 한다."],["default"]],
            [["압박이 더 아래로 내려오며 퍼진다. 숨을 쉬고 계속 미는 것 말고는 할 수 있는 게 없다."],["default"]],
            [["마지막으로 힘을 주자 알이 당신에게서 빠져나와 기다리던 하퍼의 손에 놓인다."],["default"]],
            [["압박의 가장 심한 부분이 잠시 누그러든다. 다음 파도가 오기 전에 당신은 숨을 몇 번 들이쉰다."],["default"]],
            [["당신은 마침내 알" + ($birth.fetuscount gt 1 ? "들을 모두 낳았다." : "을 낳았다.")],["default"]]
        ]
    },
    "wolf cave":{
        "wolf":[
            [["당신은 진통 사이의 시간을 센다. 아직 견딜 만하니, 밀 때가 아니라는 걸 안다."],["default"]],
            [["아직 견딜 만하다. 지금 밀 때일 가능성은 낮다."],["default"]],
            [["통증이 커지고 있지만, 당신은 조금 더 기다릴 수 있을 것 같다."],["default"]],
            [["당신은 \"밀어\", \"숨 쉬어\"를 머릿속에 새기며 잘되기를 바란다."],["default"]],
            [["강한 진통과 함께 몸이 당신에게 밀라고 재촉한다."],["default"]],
            [["이 통증이 새끼들이 곧 나온다는 뜻이기를 당신은 바란다."],["default"]],
