            [["아직 끝나지 않았다. 또 다른 아이가 골반을 타고 내려온다."],["default"]],
            [["당신은 마침내 출산을 마쳤다!"],["default"]]
        ],
        "wolf":[
            [["하퍼가 다리 사이를 살피더니 알린다. \"2센티미터 열렸습니다.\" 겨우 2센티미터? 몸은 이미 몇 시간째 이러고 있고, 진통이 올 때마다 엉덩이가 조금씩 더 쑤신다."],["default"]],
            [["하퍼가 침착하게 말한다. \"5센티미터 열렸습니다.\" 곧 밀게 될 것 같지만, 아직 때는 아니다."],["default"]],
            [["진통이 치솟자 하퍼가 당신의 상태를 다시 확인한다."],["default"]],
            [["하퍼가 알려 준다. \"완전히 열렸습니다. 진통에 맞춰 함께 밀고, 숨 쉬는 것을 잊지 마세요.\""],["default"]],
            [["하퍼가 계속하라고 격려한다."],["default"]],
            [["하퍼가 \"새끼가 보입니다.\"라고 단언하며 당신의 강아지를 받아 낼 준비를 하는 소리가 들린다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 당신의 새끼가 당신에게서 빠져나온다."],["default"]],
            [["아직 끝나지 않았다. 또 다른 강아지가 골반을 타고 내려온다."],["default"]],
            [["당신은 마침내 출산을 마쳤다!"],["default"]]
        ],
        "hawk":[
            [["하퍼가 경과를 확인하며 알이 몸속에서 더 아래로 내려오는 것을 지켜본다. 껍데기가 한동안 아래를 짓누르고 있어서 당신은 벌써 아프다. 지금 하퍼가 해 줄 수 있는 일은 숨을 쉬며 견디라고 말하는 것뿐이다."],["default"]],
            [["압박이 더 집요해지자 하퍼가 변화를 기록한다."],["default"]],
            [["한층 강한 진통에 몸이 긴장한다. 하퍼가 계속 숨을 쉬라고 말한다."],["default"]],
            [["하퍼가 알이 밀 수 있을 만큼 내려왔다고 말하고, 당신의 몸이 또 한 번의 경련으로 답한다."],["default"]],
            [["하퍼가 손을 준비한 채 지켜보는 동안 당신이 힘을 준다."],["default"]],
            [["하퍼가 알이 보이기 시작한다고 알린다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 알이 하퍼의 기다리던 손으로 넘어간다."],["default"]],
            [["숨을 다 고르기도 전에 또 다른 알이 더 아래로 내려온다."],["default"]],
            [["당신은 마침내 알" + ($birth.fetuscount gt 1 ? "들을 모두 낳았다." : "을 낳았다.")],["default"]]
        ]
    },
    "prison":{
        "human":[
            [["꼼꼼한 경비원이 다리 사이를 살핀다. \"재는 도구가 없어서 짐작이지만, 2센티미터 정도 열린 것 같아.\" 당신은 제대로 된 도움 없이 꽤 오랫동안 산통을 겪고 있고, 몸은 이미 타격을 입었다."],["default"]],
            [["꼼꼼한 경비원이 초조하게 말한다. \"4센티? 5센티쯤 열렸나?\" 당신은 곧 밀게 될 거라고 예상한다."],["default"]],
            [["진통이 치솟고, 다리가 저절로 움직인다. 경비원이 당신 다리를 제자리에 붙들려고 애쓴다."],["default"]],
            [["꼼꼼한 경비원이 당신에게 말한다. \"때가 된 건가? 음. 그래, 밀기 시작해... 그리고 숨 쉬어, 늘 숨 쉬고.\""],["default"]],
            [["꼼꼼한 경비원이 계속하라고 격려한다."],["default"]],
            [["꼼꼼한 경비원이 \"아기가 나오고 있어, 거의 다 왔어!\"라고 단언하는 소리가 들린다. 경비원이 당신의 아이를 받아 낼 준비를 한다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 당신의 아이가 태어난다."],["default"]],
            [["아직 끝나지 않았다. 또 다른 아이가 골반을 타고 내려오는 것이 느껴진다"],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "wolf":[
            [["꼼꼼한 경비원이 다리 사이를 살핀다. \"재는 도구가 없어서 짐작이지만, 2센티미터 정도 열린 것 같아.\" 당신은 제대로 된 도움 없이 꽤 오랫동안 산통을 겪고 있고, 몸은 이미 타격을 입었다."],["default"]],
            [["꼼꼼한 경비원이 초조하게 말한다. \"4센티? 5센티쯤 열렸나?\" 당신은 곧 밀게 될 거라고 예상한다."],["default"]],
            [["진통이 치솟고, 다리가 저절로 움직인다. 경비원이 당신 다리를 제자리에 붙들려고 애쓴다."],["default"]],
            [["꼼꼼한 경비원이 더듬거린다. \"이건... 이건 강아지 머리 아닌가? 무-무슨... 아니, 됐어! 숨 쉬고 밀어!\""],["default"]],
            [["꼼꼼한 경비원이 계속하라고 격려한다."],["default"]],
            [["꼼꼼한 경비원이 \"당신, 어... 아기가 나오고 있어, 거의 다 왔어!\"라고 단언하는 소리가 들린다. 경비원이 당신의 별난 아이를 받아 낼 준비를 한다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 당신의 새끼가 태어난다."],["default"]],
            [["아직 끝나지 않았다. 또 다른 강아지가 골반을 타고 내려오는 것이 느껴진다"],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "hawk":[
            [["알이 더 아래로 내려오는 동안 경비원이 할 수 있는 한 경과를 살핀다. 껍데기가 한동안 몸속을 짓누르고 있어서 당신은 벌써 아프고 지쳤다. 당신은 할 수 있는 만큼 숨을 쉬며 견딘다."],["default"]],
            [["압박이 커지고, 경비원은 어찌해야 할지 점점 더 모르는 얼굴이 된다."],["default"]],
            [["한층 강한 진통에 다리가 움직인다. 경비원이 당신을 붙들어 주려 애쓴다."],["default"]],
            [["밀고 싶은 충동을 무시할 수 없게 된다. 경비원이 숨을 쉬라고 말한다."],["default"]],
            [["당신이 힘을 주는 동안 경비원이 준비하려고 애쓰며 근처를 맴돈다."],["default"]],
            [["경비원이 알이 보인다고 불쑥 말한다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 알이 경비원의 기다리던 손으로 미끄러져 들어간다."],["default"]],
            [["제대로 긴장을 풀기도 전에 또 다른 알이 더 아래로 내려온다."],["default"]],
            [["당신은 마침내 알" + ($birth.fetuscount gt 1 ? "들을 모두 낳았다." : "을 낳았다.")],["default"]]
        ]
    },
    "bedroom":{
        "human":[
            [["당신은 침대에 몸을 누이고 진통을 숨으로 견뎌 내려 한다. 진통은 한동안 커져 왔고, 앞으로 해야 할 일을 생각하는 것만으로도 엉덩이가 쑤신다."],["default"]],
            [["통증이 강해진다. 당신은 침구를 움켜쥐고 몸이 준비되기를 기다린다."],["default"]],
            [["편안해질 시간도 없이 당신은 담요를 걷어찬다."],["default"]],
            [["밀고 싶은 충동이 낮고 집요하게 차오르기 시작한다."],["default"]],
            [["당신은 침대에 몸을 버티며 다음 진통에 맞춰 힘을 준다."],["default"]],
            [["아기가 보이기 시작한다. 당신은 안간힘에 몸을 떨며 계속 민다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 당신의 아이가 침구 위로 쑥 빠져나온다."],["default"]],
            [["아직 끝나지 않았다. 또 다른 아이가 골반을 타고 내려온다."],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "wolf":[
            [["당신은 침대에 몸을 누이고 처음의 꾸준한 진통을 숨으로 견딘다. 새끼들이 쑤실 만큼 낮은 곳까지 내려와 있어서 지금은 쉬며 기다리는 것 말고는 할 일이 거의 없다."],["default"]],
            [["통증이 강해지는 동안 새끼들이 더 아래로 내려온다."],["default"]],
            [["골반으로 압박이 차오르며 오래 기다리지 않아도 된다고 알려 준다."],["default"]],
            [["밀고 싶은 충동이 들자 당신은 침대에 몸을 버틴다."],["default"]],
            [["당신은 다음 진통에 맞춰 힘을 주며 새끼가 나오도록 돕는다."],["default"]],
            [["새끼가 보이기 시작한다. 당신은 안간힘에 몸을 떨며 계속 민다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마지막으로 힘을 주자 새끼가 침구 위로 쑥 빠져나온다."],["default"]],
            [["아직 끝나지 않았다. 또 다른 새끼가 골반을 타고 내려온다."],["default"]],
            [["당신은 마침내 출산을 마쳤다."],["default"]]
        ],
        "hawk":[
            [["당신은 배 깊은 곳의 압박에 눈을 뜬다. 낯설고 묵직해서 목에서 지저귐이 새어 나올 정도다. 알은 이미 낮은 곳에 자리 잡았고, 경련이 올 때마다 당신은 지쳐 간다. 아직은 쉬며 숨을 쉬는 것 말고 할 일이 없다."],["default"]],
            [["당신은 진통이 뜻밖에도 편안하게 느껴진다. 알이 골반을 타고 내려오는 불룩함이 느껴지지만, 매끈한 모양과 발길질이 없다는 점 덕분에 알을 낳는 일이 출산보다 훨씬 쉬워 보인다."],["default"]],
            [["자궁경부가 아직 버티는 동안에도 낯선 늘어남이 느껴지는 듯하다. 아플 줄 알았지만 통증보다 더 기묘한, 몸이 당신보다 먼저 이해하는 듯한 깊은 압박이다."],["default"]],
            [["알의 끝부분이 벌써 당신의 " + ($birth.genital is "vagina" ? either("보지","씹구멍") : either("항문","괄약근")) + "【을를】 벌려 놓고 있지만, 알의 가장 넓은 부분은 아직 지나가지 못했다."],["default"]],
            [["여기까지의 수월함이 사라졌다. 당신은 알을 내보내려 애쓰고, 몸이 더 세게 밀라고 재촉한다."],["default"]],
            [["몸이 계속 알과 싸우고, 이 압박을 견디는 껍데기가 얼마나 단단한 걸까 궁금해진다."],["default"]],
            [["가장 넓은 부분이 지나가고 있다. 서두를 수는 없다. 몸이 시키는 대로 미는 수밖에 없다."],["default"]],
            [["마침내 당신의 " + ($birth.genital is "vagina" ? either("보지","씹구멍") : either("항문","괄약근")) + "에서 철퍽 하고 질척한 소리가 나며, 알이 다리 사이에 안전하게 내려앉는다."],["default"]],
            [["당신은 또 다른 알이 " + ($birth.genital is "vagina" ? "질" : "항문") + " 통로를 타고 내려오는 것을 느낀다."],["default"]],
            [["당신은 사타구니에 닿는 미약한 바람을 느끼고, 차가운 공기에 당신의 " + ($birth.genital is "vagina" ? either("보지","씹구멍") : either("항문","괄약근")) + "【이가】 여전히 벌어져 있다는 것을 깨닫는다. 당신은 반사적으로 조였다가 마침내 힘을 푼다."],["default"]]
        ]
    }
},
"movement":[
    ["당신의 " + ($birth.fetuscount gt 1 ? "아기들" : "아기") + "【은는】 잠시 잠잠하다.",
    "당신의 아이" + ($birth.fetuscount gt 1 ? "들이" : "가") + " 잠시 잠잠해져서 다행이다."],
    ["팔다리 하나가 당신을 밀어 대는 것이 느껴진다. 안에서 동요하고 있는 게 틀림없다.",
    "당신은 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + "에서 약간의 불편한 움직임을 느낀다."],
    ["당신은 " + ($birth.fetuscount-$birth.delivered gt 1 ? "아기들" : "아기") + "【이가】 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + " 속에서 불편하게 뒤척이는 것을 느낀다.",
    "당신의 " + ($birth.fetuscount-$birth.delivered gt 1 ? "아기들" : "아기") + "【이가】 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + " 속에서 몸을 비튼다."],
    ["당신의 " + ($birth.fetuscount-$birth.delivered gt 1 ? "아기들" : "아기") + "【이가】 당신의 " + ($birth.genital is "vagina" ? "자궁" : "항문") + " 수축에 저항한다.",
    "당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + " 속의 괴로운 움직임에 제발 어서 나와 줬으면 싶다."],
    ["당신은 " + ($birth.fetuscount-$birth.delivered gt 1 ? "아기들" : "아기") + "【이가】 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + "에 맞서 버티는 것을 느낀다.",
    "당신은 배가 불룩 솟는 것을 본다. 발 모양이 배 속에서 느끼는 통증과 들어맞는다."],
    [($birth.fetuscount gt 1 ? "아기 하나가" : "당신의 아기가") + " 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + "【을를】 걷어차고 밀어 댄다.",
    "극심한 통증이 몸을 관통한다. 아기가 불편해한다."],
    ["당신의 아기들이 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + "【을를】 거칠게 비틀고 밀어 댄다.",
    "극심한 통증이 당신의 " + ($birth.genital is "vagina" ? either("자궁","자궁") : either("항문","대장")) + "【을를】 뒤흔든다. 당신의 " + "아기가 마구 날뛰고 있다."],
