	<<set setup.birthPrompts.stageInitial["forest shop"] to {
		"human":[
			[["그윌란이 당신의 배에 손을 얹는다. \"시작됐어.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 고개를 끄덕이며 침착하려 애쓴다."],["default"]],
			[["그윌란이 당신의 다리 사이를 살핀다. \"다 괜찮아 보여.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 떨리는 숨을 내쉰다."],["default"]],
			[["한층 강한 진통에 당신이 몸을 앞으로 웅크린다. 그윌란이 지나갈 때까지 당신의 어깨를 붙잡아 준다."],["default"]],
			[["\"밀 때가 됐어.\" 그윌란이 말한다. 당신은 다리를 벌리고 깊게 숨을 들이쉰다."],["default"]],
			[["당신은 몸이 떨릴 때까지 힘을 준다. \"계속해.\" 그윌란이 당신의 엉덩이를 붙잡고 말한다."],["default"]],
			[["그윌란이 당신의 다리 사이를 들여다본다. \"<<if $birth.delivered is 0>>아기가<<else>>또 다른 아기가... <<= ordinalWritten($birth.delivered + 1)>> 아기가<</if>> 보여.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 다시 힘을 준다."],["default"]],
			[["아기가 당신을 활짝 벌린다. 당신은 비명을 지르며 그윌란의 손을 붙잡는다."],["default"]],
			[["당신은 마지막으로 힘을 준다. <<if $birth.delivered is 0>>아기가 쑥 빠져나오자 그윌란이 받아 든다.<<elseif $birth.delivered lt 5>><<= ordinalWritten($birth.delivered + 1)>> 아기가 쑥 빠져나오자 그윌란이 받아 들고, 방 안에 울음소리가 하나 더 늘어난다.<<else>>또 다른 아기가 기다리던 그윌란의 손으로 미끄러져 들어간다. \"아직 정신 있니, 얘야?\" <<nnpc_he \"Gwylan\">>【이가】 늘어나는 수건 더미를 잠깐 흘끗 보며 묻는다.<</if>>"],["default"]],
			[["또 다른 아기가 더 아래로 내려온다. 그윌란이 <<if $birth.delivered is 1>>갓난아기를 수건으로 싸는<<elseif $birth.delivered lt 6>>가장 최근의 아기를 다른 아기들 옆에 눕히는<<else>>점점 불어나는 신생아 무리 사이에 자리를 마련하는<</if>> 동안 당신이 신음한다."],["default"]],
			[["통증이 마침내 멎는다. \"끝났어.\" 그윌란이 말한다. 당신은 눈을 감고 쉰다."],["default"]]
		],
		"wolf":[
			[["그윌란이 당신의 배에 손을 얹는다. \"시작됐어.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 고개를 끄덕이며 침착하려 애쓴다."],["default"]],
			[["그윌란이 당신의 다리 사이를 살핀다. \"다 괜찮아 보여.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 떨리는 숨을 내쉰다."],["default"]],
			[["한층 강한 진통에 당신이 몸을 앞으로 웅크린다. 그윌란이 지나갈 때까지 당신의 어깨를 붙잡아 준다."],["default"]],
			[["\"밀 때가 됐어.\" 그윌란이 말한다. 당신은 다리를 벌리고 깊게 숨을 들이쉰다."],["default"]],
			[["당신은 몸이 떨릴 때까지 힘을 준다. \"계속해.\" 그윌란이 당신의 엉덩이를 붙잡고 말한다."],["default"]],
			[["그윌란이 당신의 다리 사이를 들여다본다. <<if $birth.delivered is 0>>\"첫 번째 새끼가 보여.\"<<elseif $birth.delivered lt 6>>\"<<= ordinalWritten($birth.delivered + 1)>> 새끼가 나와.\"<<else>>\"또 한 마리가 나와. 다 끝나면 제대로 세어 보자.\"<</if>> <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신은 다시 힘을 준다."],["default"]],
			[["새끼가 당신을 활짝 벌린다. 당신은 비명을 지르며 그윌란의 손을 붙잡는다."],["default"]],
			[["당신은 마지막으로 힘을 준다. 새끼가 쑥 빠져나오자 그윌란이 받아 든다. <<if $birth.delivered is 0>>\"한 마리.\" <<nnpc_he \"Gwylan\">>【이가】 말하며 꿈틀대는 새끼를 재빨리 수건으로 싼다.<<elseif $birth.delivered lt 5>>\"<<= ordinalWritten($birth.delivered + 1)>> 새끼야.\" <<nnpc_he \"Gwylan\">>【이가】 말하며 새끼를 형제들 옆에 안전하게 눕힌다.<<elseif $birth.delivered is 5>>\"여섯 마리.\" <<nnpc_he \"Gwylan\">>【이가】 말한다. 당신을 걱정하면서도 감탄한 목소리다.<<elseif $birth.delivered is 6>>\"여섯 번째야! 잠깐, 아니, 일곱...\" 그윌란이 수건에 싸인 새끼들을 둘러보며 서둘러 다시 센다. \"그래, 일곱 번째. 틀림없이 일곱 번째.\"<<else>>그윌란이 숫자를 말하려다 수건이 빼곡한 둥지를 보고 그만둔다. \"건강한 새끼 한 마리 더.\" <<nnpc_he \"Gwylan\">>【이가】 대신 말한다.<</if>>"],["default"]],
			[["또 다른 새끼가 더 아래로 내려온다. 그윌란이 <<if $birth.delivered is 1>>갓난 새끼를 수건으로 싸는<<elseif $birth.delivered lt 6>>가장 최근의 새끼를 형제들 옆에 눕히는<<else>>수건에 싸인 새끼들을 이리저리 옮기며 꿈틀거리는 한배 새끼를 조용히 다시 세는<</if>> 동안 당신이 신음한다."],["default"]],
			[["통증이 마침내 멎는다. \"끝났어.\" 그윌란이 말한다. 당신은 눈을 감고 쉰다."],["default"]]
		]
	}>>
	<<set setup.birthPrompts.bound["forest shop"] to ["그윌란이 속박을 풀어 주는 동안 오른팔이 묶인 끈에 대고 홱 움찔한다.","그윌란 덕에 오른팔이 고통스러운 속박에서 풀려난다.","그윌란이 속박을 풀어 주자 오른팔이 힘없이 늘어진다.","그윌란이 오른팔을 풀어 준다."]>>
	<<run setup.rcbNormalizeBirthPrompts()>>
	<</if>>



	<<if _birthRebuildRuntime>>
		<<set $birth["dialog"] to {"randomPool":[],"forcedPool":[],"randomQueue":[],"forcedQueue":[]}>>
	<<updateFilters "static">>
	<<updateFilters "partner">>
	<<updateFilters "initial">>
	<<applyDialogFilters "randomFull" "randomPool" "static">>
	<<applyDialogFilters "forcedFull" "forcedPool" "static">>
	<<applyDialogFilters "randomPool" "randomPool" "partner">>
	<<applyDialogFilters "forcedPool" "forcedPool" "partner">>
	<<resetLastOptions>>
	<<getCombatDefaultsType>>
	<</if>>
	
	<<unset _birthRebuildRuntime>>
<</if>>
<<if $finish is 1>>
	<<set $birth.giveup to 1>>
	<<set $birth.passout to 0>>
	당신은 진통마다 억지로 버티려는 것을 그만둔다. 몸은 당신의 지시 없이도 계속 산통을 이어 가고, 주변 사람들이 할 수 있는 만큼 대신 나선다.
	<br><br>
	<span id="next"><<link [[다음|Childbirth End]]>><</link>></span><<nexttext>>
<<else>>
	<<effects>>
	<<childbirtheffects>>
	<<Childbirth>>
	<<childbirthactions>>

	<<if $birth.stage gt 9>>
		<<set $birth.passout to 0>>
		<span id="next"><<link [[다음|Childbirth End]]>><</link>></span><<nexttext>>
	<<elseif $stress gte $stressmax>>
		<<set $birth.passout to 1>>
		<span id="next"><<link [[다음|Childbirth End]]>><</link>></span><<nexttext>>
	<<else>>
		<span id="next"><<link [[다음|Childbirth]]>><</link>></span><<nexttext>>
	<</if>>
<</if>>

<</if>> /* end safety-gate macro else */

:: Childbirth End
<<unset $childbirthstart>>
/* An unfertilised dragon clutch does not deliver the separate pregnancy the player may be carrying. */
<<if $waterDragonBirthContext?.fertilised isnot false>><<playerPrebirth>><</if>>
<<if $birth.giveup is 1 or $finish is 1>>
    <<if $finish is 1>><<encounterEndViolence>><</if>>
    더는 견딜 수 없다.
    <br><br>
	당신은 파도 하나하나를 다스리려는 노력을 놓아 버린다. 산통은 여전히 제 갈 길을 가고, 본능과 곁에서 이끌어 줄 만큼 가까이 있던 누군가의 도움으로 이어진다.
	<br><br>
	가장 힘든 순간이 마침내 지나가면, 당신은 할 수 있는 만큼 씻겨진 채 쑤시고 떨리고 기진맥진한 상태로 남겨진다.
<<elseif $birth.passout is 1>>
	힘이 한꺼번에 빠져나간다. 방이 흐려지고, 몸이 마침내 말을 듣지 않게 되면서 주변의 소리가 둔한 웅웅거림으로 미끄러져 간다.
	<br><br>
	정신이 돌아올 무렵에는 가장 힘든 부분이 끝나 있다. 누군가 할 수 있는 만큼 당신을 씻겨 놓았고, 남은 통증이 깊어서 숨 하나하나가 조심스럽다.
<<else>>
	<<if $birth.type isnot "hawk">>
		마지막 후진통에 몸이 떨린다. 누군가 당신을 씻기고, 아이<<if $birth.fetuscount gt 1>>들<</if>>도 살피고, 출혈이 줄어든 것을 확인한 뒤에야 쉬게 해 준다.
		<br><br>
		온몸이 쑤시고 기진맥진하고 휘청거리지만, 산통은 마침내 끝났다.
	<<else>>
		마지막 긴장이 몸에서 빠져나가, 당신은 기운이 없고 묘하게 가벼워진다. 당신이 씻겨지는 동안 알<<if $birth.fetuscount gt 1>>들이<</if>><<if $birth.fetuscount is 1>>이<</if>> 조심스레 수습된다.
		<br><br>
		근육이 후진통으로 여전히 떨리지만, 알 낳기는 마침내 끝났다.
	<</if>>
<</if>>
<br><br>
<!--modloader commented out-->
<<switch $birth.location>>
	<<case "hospital">>
<!--	<<link [[Next|Pregnancy Birth Hospital Alternate 3]]>><</link>> -->
		<<link [[다음|Pregnancy Birth Hospital 3]]>><<unset $birth>><</link>>
	<<case "wolf cave">>
<!--	<<link [[Next|Pregnancy Birth Wolf Cave Alternate 2]]>><</link>> -->
		<<link [[다음|Pregnancy Birth Wolf Cave 2]]>><<unset $birth>><</link>>
	<<case "forest shop">>
		<<if $birth.type is "wolf">>
			<<link [[다음|Pregnancy Birth Forest Shop Wolf]]>><<unset $birth>><</link>>
		<<else>>
			<<link [[다음|Pregnancy Birth Forest Shop 4]]>><<unset $birth>><</link>>
		<</if>>
	<<case "cottage">>
		<<link [[다음|Farm PC Birth 5]]>><<unset $birth>><</link>>
	<<case "asylum">>
		<<link [[다음|Pregnancy Birth Asylum 3]]>><<unset $birth>><</link>>
	<<case "prison">>
		<<if $birth.type is "human">>
			<<link [[다음|Pregnancy Birth Prison 3]]>><<unset $birth>><</link>>
		<<else>>
			<<link [[다음|Pregnancy Birth Prison Wolf]]>><<unset $birth>><</link>>
		<</if>>
	<<case "bedroom">>
		<<if $birth.partner is "Robin">>
<!--		<<link [[Next|Robin Bed Egg Laying Alternate]]>><</link>> -->
			<<link [[다음|Robin Bed Egg Laying]]>><<unset $birth>><</link>>
		<<elseif $birth.partner is "Kylar">>
			<<link [[다음|Kylar Bed Egg Laying]]>><<unset $birth>><</link>>
		<<else>>
			<<link [[다음|Solo Bed Egg Laying]]>><<unset $birth>><</link>>
		<</if>>
	<<case "tower">>
		<<link [[다음|Bird Tower Player Egg Laying Realistic End]]>><<unset $birth>><</link>>
	<<case "waterdragon_nest">>
		<<if $waterDragonBirthContext and $waterDragonBirthContext.fertilised>>
			<<link [[다음|Water Dragon Pregnancy Laying End]]>><</link>>
		<<else>>
			<<link [[다음|Water Dragon Egg Laying Realistic End]]>><</link>>
		<</if>>
	<<case "waterdragon_lab">>
		<<link [[다음|Water Dragon Lab Laying Realistic End]]>><</link>>
<</switch>>


:: Kylar Bed Egg Laying
<<effects>>
<<set [_eggnant, _eggnantGenital] to getPlayerPregnancyForBirth(true)>>
<<if playerIsPregnant() and childBaseSpecies(_eggnant.donorSpecies) is "hawk">>
	<<set $eggLayNumber to getChildrenOf(_eggnant.pregnancyId).length>>
<<else>>
	<<set $eggLayNumber to $harpyEggs.count>>
<</if>>

당신이 원래대로 돌아오자 카일라【이가】 안도의 한숨을 내쉰다.<br>
당신은 고개를 젓고 <<if Transformations.partActive("bird", "plumage")>>깃털을 부풀리며 <</if>><<if $eggLayNumber gte 2>>알들을 품에 안아 모은다<<else>>알을 집어 든다<</if>>. 머릿속은 새하얗고, 압도적인 모성의 행복감만이 가득하다.

<<if playerIsPregnant() and childBaseSpecies(_eggnant.donorSpecies) is "hawk">>
	<<set _eggIcon to $eggLayNumber>><<wearProp `"hawk egg " + Math.clamp(_eggIcon, 1, 3)`>>
	<span class="lewd">당신은 알이 수정되었다고 확신한다.</span> 당신은 그것을 당신의 둥지로 가져가야 한다. 당신은 <<number $eggLayNumber>>개의 수정된 새 <<birdicon "eggs">> <<pluralise $eggLayNumber "알" "알">> 집어 든다.
	<<if $eggLayNumber gte 2>>알들은 꽤 크며, 애초에 어떻게 이것들이 몸속에 다 들어차 있었는지 의아할 지경이다.<<else>>알은 꽤 크며, 낳을 때 왜 더 아프지 않았는지 의아할 지경이다.<</if>>
	<<pregnancyFeats "pc">>
	<<endPlayerPregnancy $location "inventory">>
	<<set $harpyEggsPrevent to 28>>
<<else>>
	<<wearProp "bird egg">>
	하지만 <<pluralise $eggLayNumber "알">>은 <span class="blue">수정되지 않았을 것</span>이 거의 확실하다. <<tending_pick bird_egg $eggLayNumber $eggLayNumber>>
	<<unset $harpyEggs>>
	<<set $harpyEggsPrevent to 14>>
<</if>>
<br><br>

<<link [[다음|Kylar Bed Egg Laying End]]>><<handheldon>><</link>>
<br>

:: Kylar Bed Egg Laying End
<<effects>>

<<He>>【은는】 화난 척하려 하지만, <<his>>
<<if C.npc.Kylar.dom lte 40>>
	당황한
<<else>>
	굶주린
<</if>>
말투가 <<him>>【을를】 배신한다. "내가 치우는 거 도와줄까?" <<He>>【은는】 분명히 그러고 싶어 한다. 당신이 괜찮다고, 잠시 혼자 있고 싶다고 말하자 <<he>>【이가】 당신의 방을 나간다.
<br><br>
<<set $wardrobe_location to "wardrobe">>
<<wardrobeSelection true>>
<<radiooutfits>>
<<unset $kylarbed>><<unset $eggLayNumber>>
<<endevent>><<endcombat>>
