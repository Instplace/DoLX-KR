	<<if setup.birthPrompts is undefined or _birthRebuildRuntime>>
	<<run setup.birthPrompts = {"mouthaction":{
    "finished":[["당신은 거칠게 헐떡이며 숨을 돌린다."],["default"]],
    "groan":[
        [["당신은 이를 악물고 신음한다."],["default"]],
        [["삼키기도 전에 낮은 신음이 새어 나온다."],["default"]],
        [["당신은 턱을 굳게 문 채 압박을 견디며 신음한다."],["default"]],
        [["진통이 길게 이어지는 동안 거친 소리가 당신에게서 새어 나온다."],["default"]]
    ],
    "groanWeak":[["당신은 신음과 흐느낌이 뒤섞인 소리를 낸다."],["default"]],
    "moan":[["당신은 " + ($birth.genital is "vagina" ? "uterus" : "anus") + "【이가】 경련하는 바람에 신음한다. 오르가슴 때문인지 진통 때문인지 알 수 없다."],["default"]],
    "askEpiduralHospitalTooLate":[["당신은 조산사에게 진통제를 달라고 애원한다. 조산사가 하퍼를 바라보지만 하퍼는 <<nnpc_his \"Harper\">> 고개를 젓는다. 조산사가 미안한 얼굴로 당신을 본다. \"미안해요, 이제 거의 다 됐어요. ","제때 듣지는 않을 거예요.\""],["default","red"]],
    "askEpiduralHospitalSuccess":[["당신은 곧 필요해질 것을 알기에 조산사에게 진통제를 달라고 애원한다. 조산사가 하퍼를 바라보고, 하퍼가 고개를 끄덕인다. 그들은 근처에 미리 준비해 둔 약을 가져와 하퍼에게 경막외 마취제를 건넨다."," 이것이 불편함을 훨씬 견딜 만하게 해 줄 것이다."],["default","green"]],
    "askEpiduralHospitalTooExpensive":[["당신은 조산사에게 진통제를 달라고 애원한다. 조산사가 측은한 눈으로 당신을 본다. \"정말 미안하지만 그건 보장이 안 돼요. 돈이 없으시다면 ","그냥 통증을 견디셔야 해요.\""],["default","red"]],
    "askEpiduralCottageTooLate":[["당신은 하퍼에게 진통제를 달라고 애원한다. 하퍼는 <<nnpc_his \"Harper\">> 고개를 뻣뻣하게 젓는다. ","\"소용없습니다. "," 곧 끝납니다.\""],["default","red","default"]],
    "askEpiduralCottageSuccess":[["당신은 곧 필요해질 것을 알기에 하퍼에게 진통제를 달라고 애원한다. 하퍼가 고개를 끄덕인다. \"비용이 들겠지만, 괜찮습니다.\" <<nnpc_He \"Harper\">>【은는】 근처에 미리 준비해 둔 약 쟁반으로 돌아서서 경막외 마취제를 집어 든다.","이것이 불편함을 훨씬 견딜 만하게 해 줄 것이다."],["default","green"]],
    "askEpiduralCottageTooExpensive":[["당신은 하퍼에게 진통제를 달라고 애원한다. <<nnpc_He \"Harper\">>【은는】 안쓰러운 눈으로 당신을 본다. \"추가 비용이 듭니다. 감당하실 수 없다면 ","통증을 참으셔야 합니다.\""],["default","red"]],
    "askEpiduralWolfCaveHallucinate":[["당신은 " + ({"Alex":"알렉스","Avery":"에이버리","Eden":"에덴","Robin":"로빈","Sydney":"시드니","Whitney":"휘트니","Kylar":"카일라","Gwylan":"그윌란","Poppy":"포피","Black Wolf":"검은 늑대","wolf":"늑대","Great Hawk":"거대 매"}[$birth.partner] || $birth.partner) + "에게 진통제를 달라고 애원한다. 동굴 밖에서 늑대소년이 \"내가 도울게!\" 하고 외치더니, 무언가를 찾으러 달려간다."],["default"]],
    "askEpiduralWolfCave":[["당신은 " + ({"Alex":"알렉스","Avery":"에이버리","Eden":"에덴","Robin":"로빈","Sydney":"시드니","Whitney":"휘트니","Kylar":"카일라","Gwylan":"그윌란","Poppy":"포피","Black Wolf":"검은 늑대","wolf":"늑대","Great Hawk":"거대 매"}[$birth.partner] || $birth.partner) + "에게 진통제를 달라고 애원한다. 밖에 있던 다른 늑대가 알아들은 듯 짖어 대답하더니 달려간다."],["default"]],
    "askEpiduralWolfCaveSuccess":[["그들이 붉은 버섯을 가지고 돌아온다. 이 버섯이 통증에 효과가 없다는 것을 당신은 알지만, ","진행을 앞당겨 주기를 바란다."],["default","green"]],
    "askEpiduralWolfCaveFail":[["그들이 분홍 버섯을 가지고 돌아온다. ","이것이 늑대에게 독이 된다는 것을 당신은 안다",". 그리고 새끼들에게 해가 될 수도 있는 것을 먹는다고 생각하니 끔찍한 기분이 든다."],["default","red","default"]],
    "askEpiduralBedroomSuccess":[["당신은 로빈에게 통증을 덜어 줄 만한 것을 부탁한다. <<nnpc_he \"Robin\">>【이가】 머뭇거리다가 서둘러 나가더니 진통제를 가지고 돌아온다."," 이것이 불편함을 조금은 견딜 만하게 해 줄 것이다."],["default","green"]],
    "askEpiduralBedroomFail":[["당신은 로빈에게 통증을 덜어 줄 만한 것을 부탁한다. <<nnpc_he \"Robin\">>【은는】 의사도 없이 아무거나 줘도 되는지 몰라 <<nnpc_his \"Robin\">> 두 손을 비비 꼰다."," 이것을 견뎌야 한다."],["default","red"]],
    "askPartnerBedroomFail":[["더 부를 사람이 없다. 이미 곁에 있는 사람은 이제 당신 곁을 떠나지 않을 것이고, 혼자라면 근처에 불러올 사람도 없다."],["default"]],
    "askPartnerHospitalSuccess":[["조산사가 대기 중이던 간호사에게 손짓한다. 간호사가 로비에서 아기 아버지를 데리러 나간다."],["default"]],
    "askPartnerHospitalFail":[["조산사가 당신에게 묻는다. \"아기 아버지가 근처에 있나요?\" 당신은 숨을 몰아쉬며 없다고 답한다. 조산사가 단언한다. \"곧 낳게 될 거예요. 당신이 무사하도록 최선을 다할게요.\""],["default"]],
    "askPartnerWolfCaveHallucinate":[["검은 늑대가 밖의 무리를 향해 크게 짖는다. \"아비는 어디 있나!?\""],["default"]],
    "askPartnerWolfCave":[["검은 늑대가 무리의 이목을 끌려고 계속 짖는다."],["default"]],
    "askPartnerPrisonSuccess":[["경비원이 근처 문간에 서 있던 사람에게 손짓한다. \"수감자를 데려와. 그게 우리가 해 줄 수 있는 최소한이야.\""],["default"]],
    "askPartnerPrisonFail":[["경비원이 당황한 얼굴로 당신을 본다. \"의사도 제때 못 데려오는데, 아기 아버지는 말할 것도 없지.\""],["default"]],
    "askPartnerCottageSuccess":[["하퍼가 당신의 요청을 받아들이고 서둘러 문으로 가서 외친다. \"알렉스! 당신이 필요합니다!\""],["default"]],
    "askPartnerCottageFail":[["하퍼가 의아한 얼굴로 당신을 본다. \"알렉스 말고는 수 마일 안에 아무도 없습니다. 아기 아버지는 말할 것도 없고요.\""],["default"]],
    "restSuccess":[
        [["당신은 깊고 차분하게 숨을 쉰다."],["default"]],
        [["당신은 천천히 숨을 들이쉬고, 공황이 덮치기 전에 내쉰다."],["default"]],
        [["당신은 조심스레 숨을 쉬며 마음을 다잡는다."],["default"]],
        [["당신은 잠시나마 호흡을 고르게 유지한다."],["default"]]
    ],
    "restFail":[
        [["당신은 호흡의 리듬을 잃고 신음한다."],["red"]],
        [["숨이 걸리며 쥐어짜는 신음이 된다."],["red"]],
        [["당신은 고르게 숨을 쉬려 하지만, 이어서 나온 소리는 갈라져 있다."],["red"]],
        [["진통이 공들인 호흡을 앗아 가고, 당신은 헐떡이게 된다."],["red"]]
    ]
},



"pelvisaction":{
    "finished":[["당신은 욱신거리는 골반을 쉬게 한다."],["default"]],
    "push":[
        [["당신은 "+($birth.genital is "vagina" ? "질로 힘껏 밀어낸다." : "항문으로 힘껏 밀어낸다.")],["default"]],
        [["당신은 맞서 싸우는 대신 압박에 맞춰 보려 하며 힘을 준다."],["default"]],
        [["당신은 자세를 다잡고 몸이 요구할 때 민다."],["default"]],
        [["당신은 숨이 걸린 채 압박에 짓눌리며 억지로 힘을 준다."],["default"]]
    ],
    "pushWeak":[["당신은 진통이 근육을 제멋대로 움직이게 내버려 둔 채 "+($birth.genital is "vagina" ? "질" : "항문")+ " 근육으로 힘없이 민다."],["default"]],
    "resistSuccess":[["당신은 밀고 싶은 충동을 참아 내며 호흡을 늦추는 데 성공한다."],["default"]],
    "resistFail":[["당신은 밀고 싶은 충동을 참으려 하지만, 몸이 어쨌든 힘을 준다."],["red"]],
    "restFail":[
        [["당신은 잠시 "+($birth.genital is "vagina" ? "질" : "항문")+"의 힘을 풀어 보려 한다. ","하지만 진통이 어쨌든 당신에게 힘을 주게 만든다."],["default","red"]],
        [["당신은 골반의 힘을 풀어 두려 한다. ","멈출 새도 없이 몸이 힘을 준다."],["default","red"]],
        [["당신은 압박을 견디며 쉬어 보려 한다. ","진통이 되레 당신을 억지로 조이게 만든다."],["default","red"]],
        [["당신은 숨 한 번 동안 힘을 뺀다. ","근육이 다시 경련해 당신에게서 힘을 짜낸다."],["default","red"]]
    ],
    "restSuccess":[
        [["당신은 시간을 들여 "+($birth.genital is "vagina" ? "질" : "항문")+" 근육의 힘을 푼다."],["default"]],
        [["당신은 진통이 허락하는 한 골반의 힘을 푼다."],["default"]],
        [["당신은 힘주기를 멈추고 잠시 근육을 쉬게 한다."],["default"]],
        [["당신은 힘을 빼고, 욱신거리는 근육에 숨 돌릴 틈을 준다."],["default"]]
    ]
},
