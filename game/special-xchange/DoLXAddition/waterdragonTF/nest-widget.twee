:: Water Dragon Nest Widgets [widget]

<<widget "waterDragonNestDefaults">>
	<<if !$waterDragonNest>>
		<<set $waterDragonNest to {discovered:false, eggsLaid:0, pastelEggsLaid:0, harperInterest:0, tended:0, labEggsLaid:0, labStays:0, harperDeal:0, hatched:0, labChoicePill:false, labChoicePillFound:false, cleanliness:0, decorations:[], decorationSlots:[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]}>>
	<<else>>
		<<if $waterDragonNest.discovered is undefined>><<set $waterDragonNest.discovered to false>><</if>>
		<<if $waterDragonNest.eggsLaid is undefined>><<set $waterDragonNest.eggsLaid to 0>><</if>>
		<<if $waterDragonNest.pastelEggsLaid is undefined>><<set $waterDragonNest.pastelEggsLaid to 0>><</if>>
		<<if $waterDragonNest.harperInterest is undefined>><<set $waterDragonNest.harperInterest to 0>><</if>>
		<<if $waterDragonNest.tended is undefined>><<set $waterDragonNest.tended to 0>><</if>>
		<<if $waterDragonNest.labEggsLaid is undefined>><<set $waterDragonNest.labEggsLaid to 0>><</if>>
		<<if $waterDragonNest.labStays is undefined>><<set $waterDragonNest.labStays to 0>><</if>>
		<<if $waterDragonNest.harperDeal is undefined>><<set $waterDragonNest.harperDeal to 0>><</if>>
		<<if $waterDragonNest.hatched is undefined>><<set $waterDragonNest.hatched to 0>><</if>>
		<<if $waterDragonNest.labChoicePill is undefined>><<set $waterDragonNest.labChoicePill to false>><</if>>
		<<if $waterDragonNest.labChoicePillFound is undefined>><<set $waterDragonNest.labChoicePillFound to false>><</if>>
		/* Re-armed on every load, so saves made before the beach could wash up an anti-Choice pill still qualify. */
		<<if $waterDragonNest.labChoicePill isnot true and $waterDragonNest.labChoicePillFound isnot true and $waterDragonNest.labStays gte 1 and $xchange?.pill?.choiceEffect>>
			<<set $waterDragonNest.labChoicePill to true>>
		<</if>>
		<<if $waterDragonNest.cleanliness is undefined>><<set $waterDragonNest.cleanliness to 0>><</if>>
		<<if !Array.isArray($waterDragonNest.decorations)>><<set $waterDragonNest.decorations to []>><</if>>
		<<if !Array.isArray($waterDragonNest.decorationSlots)>>
			<<set $waterDragonNest.decorationSlots to [null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]>>
		<<elseif $waterDragonNest.decorationSlots.length lt 15>>
			<<run V.waterDragonNest.decorationSlots.push(...Array(15 - V.waterDragonNest.decorationSlots.length).fill(null))>>
		<<elseif $waterDragonNest.decorationSlots.length gt 15>>
			<<set $waterDragonNest.decorationSlots to $waterDragonNest.decorationSlots.slice(0, 15)>>
		<</if>>
	<</if>>
	<<set $waterDragonNest.cleanliness to Math.clamp($waterDragonNest.cleanliness, 0, 100)>>
	/* Repair older clutches missing their incubation delay or left between the naming preview and hatch. */
	<<run (V.childRecords || []).filter(child => ["hawk", "human"].includes(child.species) && child.development?.dragonNest && child.bornDate === null).forEach(child => {
		const pregnancy = V.pregnancies?.[child.pregnancyId];
		if (pregnancy && pregnancy.deliveredDate !== null) child.species = "hawk";
		if (pregnancy && pregnancy.deliveredDate !== null && typeof pregnancy.hatchDelay !== "number") {
			pregnancy.hatchDelay = random(0, PregnancyConstants.birdHatchDelay);
		}
	})>>
	<<if !$pregnancyStats.humanToysUnlocked and ($childRecords || []).some(child => child.development?.dragonNest and child.species is "human" and child.bornDate isnot null)>>
		<<set $pregnancyStats.humanToysUnlocked to true>>
	<</if>>
<</widget>>

/* Keep the eggs broodable until Next records the hatch; the naming cards preview their human form. */
<<widget "waterDragonHatchUi">>
	<div class="settingsGrid m-0 childContainer">
		<<for _dnId range $eggsHatched>>
			<<set _egg to $childRecords[_dnId]>>
			<<capture _egg>>
				<div @id="'child-' + _egg.childId" class="childUi">
					<<birthChildElement _egg "human">>
				</div>
			<</capture>>
		<</for>>
	</div>
	<br>
	<<link [["다음 (00:20)"|_args[0]]]>>
		<<run $eggsHatched.forEach(id => {
			const child = V.childRecords[id];
			child.species = "human";
			child.features.beastTransform = "waterdragon";
			child.features.skinColour = "waterdragon";
			if (!child.name) child.name = generateBabyName(undefined, child.gender, child.childId);
			recordBirth(id);
		})>>
		<<set $pregnancyStats.humanToysUnlocked to true>>
		<<pass 20>>
	<</link>>
<</widget>>

<<widget "waterDragonDecorationArrange">>
		<div class="waterdragon-decoration-palette">
			<<set _dnPlacedDecorationIndices to $waterDragonNest.decorationSlots.filter(slot => slot isnot null)>>
			<<set _dnAvailableDecorationSymbols to []>>
			<<for _dnDecorationIndex to 0; _dnDecorationIndex lt $waterDragonNest.decorations.length; _dnDecorationIndex++>>
				<<if !_dnPlacedDecorationIndices.includes(_dnDecorationIndex)>><<run _dnAvailableDecorationSymbols.pushUnique($waterDragonNest.decorations[_dnDecorationIndex])>><</if>>
			<</for>>
			<<for _dnDecorationSymbol range _dnAvailableDecorationSymbols>>
				<<set _dnAvailableDecorationIndices to []>>
				<<for _dnDecorationIndex to 0; _dnDecorationIndex lt $waterDragonNest.decorations.length; _dnDecorationIndex++>>
					<<if $waterDragonNest.decorations[_dnDecorationIndex] is _dnDecorationSymbol and !_dnPlacedDecorationIndices.includes(_dnDecorationIndex)>><<run _dnAvailableDecorationIndices.push(_dnDecorationIndex)>><</if>>
				<</for>>
				<<set _dnDecorationChoiceIndex to _dnAvailableDecorationIndices[0]>>
				<<set _dnDecorationCount to _dnAvailableDecorationIndices.length>>
				<<capture _dnDecorationSymbol _dnDecorationChoiceIndex _dnDecorationCount>>
					<span @class="($waterDragonDecorationChoice isnot null and $waterDragonNest.decorations[$waterDragonDecorationChoice] is _dnDecorationSymbol ? 'selected ' : '') + (_dnDecorationCount gt 1 ? 'multiple' : '')">
						<<link _dnDecorationSymbol>>
							<<set $waterDragonDecorationChoice to _dnDecorationChoiceIndex>>
							<<replace "#waterdragon-decoration-arrange">><<waterDragonDecorationArrange>><</replace>>
						<</link>>
					</span>
				<</capture>>
			<</for>>
		</div>
		<br>
		<div class="waterdragon-decoration-board arranging">
			<<for _dnSlot to 0; _dnSlot lt 15; _dnSlot++>>
				<<set _dnPlacedIndex to $waterDragonNest.decorationSlots[_dnSlot]>>
				<<set _dnSlotSymbol to _dnPlacedIndex is null ? "＋" : $waterDragonNest.decorations[_dnPlacedIndex]>>
				<<capture _dnSlot _dnPlacedIndex _dnSlotSymbol>>
					<span @class="_dnPlacedIndex is null ? 'empty' : ''">
						<<link _dnSlotSymbol>>
							<<if $waterDragonDecorationChoice isnot null>>
								<<run V.waterDragonNest.decorationSlots = V.waterDragonNest.decorationSlots.map(slot => slot === V.waterDragonDecorationChoice ? null : slot)>>
								<<set $waterDragonNest.decorationSlots[_dnSlot] to $waterDragonDecorationChoice>>
								<<set $waterDragonDecorationChoice to null>>
							<<elseif _dnPlacedIndex isnot null>>
								<<set $waterDragonDecorationChoice to _dnPlacedIndex>>
								<<set $waterDragonNest.decorationSlots[_dnSlot] to null>>
							<</if>>
							<<replace "#waterdragon-decoration-arrange">><<waterDragonDecorationArrange>><</replace>>
						<</link>>
					</span>
				<</capture>>
			<</for>>
		</div>
<</widget>>

/* --- Shared egg-laying logic ---------------------------------------------------------------
   Used by the normal, realistic childbirth, and overdue laying scenes to avoid duplicate code.
   Results are stored in temp variables for the calling widget to use. */
/* Roll each egg separately for a pastel shell. */
<<widget "waterDragonEggPastelRoll">>
	<<set _dragonClutchSize to Math.clamp(Number(_args[0]) || 1, 1, 3)>>
	<<set _dragonPastelCount to 0>>
	<<for _dragonEggIndex to 0; _dragonEggIndex lt _dragonClutchSize; _dragonEggIndex++>>
		<<if random(1, 100) lte 23>><<set _dragonPastelCount++>><</if>>
	<</for>>
	<<set _dragonPlainCount to _dragonClutchSize - _dragonPastelCount>>
<</widget>>

/* Dragon egg laying now causes pain and arousal based on the number of eggs.
   "rough" is used for overdue laying away from the nest. */
<<widget "waterDragonEggStrain">>
	<<set _dragonStrainCount to Math.clamp(Number(_args[0]) || 1, 1, 3)>>
	<<set _dragonRough to _args[1] is "rough">>
	<<set _dragonArousal to (_dragonRough ? 2000 : 3000) + 1000 * (_dragonStrainCount - 1)>>
	<<set _dragonPain to (_dragonRough ? 22 : 14) + 6 * (_dragonStrainCount - 1)>>
	<<set _dragonFatigue to 6 * _dragonStrainCount>>
	<<arousal _dragonArousal>><<pain _dragonPain>><<tiredness _dragonFatigue>>
	<<gggarousal>><<if _dragonRough>><<gggpain>><<else>><<ggpain>><</if>><<gtiredness>>
	<<if $pleasure gte $pleasuremax>>
		<br><br>
		<<orgasm>>
		<<set $orgasmcurrent to 0>>
	<</if>>
<</widget>>

/* Hands over the clutch and records it. Reads the counts <<waterDragonEggPastelRoll>> set. */
<<widget "waterDragonEggReward">>
	<<waterDragonNestDefaults>>
	<<if _dragonPlainCount gte 1>>
		<<set _dragonPlainType to "water_dragon_egg">>
		<<foodstufficon _dragonPlainType>> <span class="green"><<print setup.foodstuff[_dragonPlainType].name>> <<if _dragonPlainCount is 1>>한<<else>><<print _dragonPlainCount>><</if>>개를 얻었다.</span><<tending_give _dragonPlainType _dragonPlainCount>>
	<</if>>
	<<if _dragonPastelCount gte 1>>
		<<set _dragonPastelType to "water_dragon_egg_pastel">>
		<<foodstufficon _dragonPastelType>> <span class="green"><<print setup.foodstuff[_dragonPastelType].name>> <<if _dragonPastelCount is 1>>한<<else>><<print _dragonPastelCount>><</if>>개를 얻었다.</span><<tending_give _dragonPastelType _dragonPastelCount>>
	<</if>>
	<<set $waterDragonNest.eggsLaid += _dragonClutchSize>>
	<<set $waterDragonNest.pastelEggsLaid += _dragonPastelCount>>
<</widget>>

<<widget "waterDragonEggLayEvent">>
	<<if _args[0] isnot "waterDragonNest" and Transformations.waterDragonEggsOverdue()>>
		<<set _dragonClutch to Math.clamp(Number($waterDragonEggs.count) || 1, 1, 3)>>
		<<set _dragonClutchSize to _dragonClutch>>
		<<set _dragonPastelCount to 0>>
		<<set _dragonPlainCount to _dragonClutch>>
		<<wearProp `"waterdragon egg " + _dragonClutch`>>
		당신은 어둠 속에서 무릎을 이미 끌어당긴 채 깨어난다. 바다로 이끄는 힘은 여전하지만, 당신의 몸은 그것을 기다리기를 그만두었다.
		<span class="red">당신은 이것을 너무 오래 품고 있었다.</span>
		<br><br>
		긁어모을 해초도, 몸을 버틸 따뜻한 돌도 없다. 당신은 있는 자리에서 네발로 엎드려 손에 닿는 것을 아무거나 깨물고 힘을 준다.
		<<waterDragonEggStrain _dragonClutch "rough">>
		<br><br>
		<<pluralise _dragonClutch "알이 느리고 힘겹게 나오고" "알들이 느리고 힘겹게 나오고">> 당신의 다리 옆에 <<pluralise _dragonClutch "툭 떨어진다" "툭 떨어진다">>. <<pluralise _dragonClutch "껍데기는" "껍데기들은">> 진주처럼 하얗고 아무 무늬가 없다. <<pluralise _dragonClutch "알" "알들">> 위로는 아무것도 반짝이지 않고, 어디에서도 표식이 밝아지지 않는다.
		<br><br>
		<span class="blue">여기서 일어나서는 안 되는 일이었다.</span> <<gtrauma>><<trauma 6>><<ggstress>><<stress 6>>
		<br><br>
		당신은 할 수 있는 만큼 몸을 닦고 <<pluralise _dragonClutch "알을" "알들을">> 들고 가려고 감싼다.
		<<waterDragonEggReward>>
		<<set $waterDragonEggs to Transformations.rollWaterDragonEggCycle()>>
	<<else>>
		/* Keep waking-effect branches to one line plus the link. */
		/* This link skips the normal bed exit, so return stored clothes first. */
		<<bedstorereturn>>
		<<if _args[0] is "waterDragonNest">>
			당신은 따뜻한 돌에 손을 얹은 채 깨어난다. 묵직한 무게가 아랫배 안쪽을 누르고,
			그것이 무슨 뜻인지 깨닫자 몸이 굳는다. <span class="navy">알이 준비되었다.</span>
			<br><br>
			이미 둥지에 있으니, 준비하는 것 말고는 할 일이 없다.
			<br><br>
			<<tficon "waterdragon">><<link [[둥지를 준비한다|Water Dragon Egg Laying]]>><</link>>
		<<else>>
			당신은 아랫배 안쪽의 낯선 무게에 갑자기 잠에서 깬다. 일어나 앉자 그것이 더 강해지고,
			당신은 손으로 배를 감싼다. 바다가 이곳에서 먼데도 파도 소리가 들린다.
			<br><br>
			<span class="blue">알이 준비되었다.</span> 당신은 해안 절벽에 가서 알을 안전하게 낳을 곳을 찾아야 한다는 것을 안다.
			<br><br>
			<<set _nestRoute to ($waterDragonNest and $waterDragonNest.discovered ? "Water Dragon Nest Discovery 2" : "Water Dragon Nest Discovery")>>
			<<tficon "waterdragon">><<link "이끌림을 따른다 (0:30)" _nestRoute>><<pass 30>><</link>>
		<</if>>
		<<exitAll>>
	<</if>>
<</widget>>

/* Rendered inline among other waking-effect one-liners (the effect.js warning already narrates the waters breaking), so keep it to a single line plus the link. */
<<widget "waterDragonPregnancyEvent">>
	/* As above: this link skips the usual "climb out of bed" step, so reclaim the bedtime stash before leaving. */
	<<bedstorereturn>>
	<<if _args[0] is "waterDragonNest">>
		당신은 진통이 몸을 조여 오는 가운데 깨어난다. 우묵한 곳 주위의 표식들이 그에 응답하듯 밝아지고,
		따뜻한 돌이 손 아래에서 움직인다. 당신은 <span class="navy">이미 있어야 할 곳에 있다</span>.
		<br><br>
		<<tficon "waterdragon">><<link [[우묵한 곳에 몸을 누인다|Water Dragon Pregnancy Labour]]>><</link>>
	<<else>>
		이것은 <span class="navy">수정되지 않은 알을 품을 때와는 전혀 다르다</span>. 알들이 몸속에서 움직이는 것이 느껴지고, 곧이어 해안 절벽으로 가야 한다는 강한 욕구가 몰려온다.
		<br><br>
		<<tficon "waterdragon">><<link [[이끌림을 따라 해안으로 간다|Water Dragon Pregnancy Journey]]>><<pass 30>><</link>>
	<</if>>
<</widget>>


:: Water Dragon Nest Wardrobe [exitCheckBypass]
<<location "beach">><<set $outside to 0>><<effects>>
당신은 유목 상자를 연다. 으깬 조개로 댄 안감이 옷에 물보라와 모래가 닿지 않게 해 준다.
<br><br>
<<set $wardrobe_location to "waterDragonNest">>
<<wardrobeSelection>>
<div id="wardrobewear"><<wardrobewear>></div>
<div id="wardrobeExits"><<wardrobeExits>></div>
<<wardrobe>>

:: Water Dragon Nest Settings [exitCheckBypass]
<<if $options.images is 1>>
	<span id="bannerStyle">
		<img class="resize" src="img/misc/banner.png">
	</span>
<</if>>
<<set $settingsExitPassage to "Water Dragon Nest">>
<<settings>>
