:: Pet Care
<<set $outside to 0>><<effects>><<petSync>>
<<set _p to Menagerie.getPet($petCareTarget)>>
<<set _def to Menagerie.speciesDef($petCareTarget)>>
<<if !_p or !_def>>
	여기에는 아무것도 없다.
	<br><br>
	<<link [[뒤로|Bedroom]]>><</link>>
<<else>>
	<<set _s to Menagerie.status($petCareTarget)>>
	<<if _p.where is "carried" and $petCareTarget is "snake">>
		당신은 빈 사육장으로 걸어간다. 사랑스러운 <<= _s.label>>【이가】 살짝 꿈틀거리며 <<= _def.carriedOn>> 쉭쉭거린다.
	<<elseif _p.where is "carried">>
		당신은 빈 유리병 쪽으로 걸어간다. 발에 달라붙어 있던 슬라임이 꾸르륵 소리를 내며 떨린다.
	<<elseif $petCareTarget is "snake">>
		당신은 뱀의 사육장으로 걸어가 안에 있는 사랑스러운 <<= _s.label>>【을를】 들여다본다.
	<<else>>
		당신은 <<= _s.label>>【이가】 들어 있는 유리병으로 걸어간다. 그것이 다가오는 당신을 보고 기쁜 듯 꾸르륵거린다.
	<</if>>
	<<set _mgLooks to _s.hunger gte Menagerie.Tuning.starvingThreshold ? "starving" : _s.hunger gte Menagerie.Tuning.hungryThreshold ? "hungry" : "healthy">>
	<<if _mgLooks is "starving">>
		<<if _p.where is "carried">>당신이 흘끗 보니<<else>>당신이 지켜보니<</if>>
		<<if $petCareTarget is "snake">>
			<<if _p.where is "carried">>당신의 뱀, 그 뱀은<<else>>그 뱀은<</if>>
		<<else>>
			<<if _p.where is "carried">>당신의 슬라임, 그 슬라임은<<else>>그 슬라임은<</if>>
		<</if>>
		<span class="red">굶주린 것 같다!</span>
	<<else>>
		<<if _p.where is "carried">>당신이 흘끗 보니<<else>>당신이 지켜보니<</if>>
		<<if $petCareTarget is "snake">>
			<<if _p.where is "carried">>당신의 뱀, 그 뱀은<<else>>그 뱀은<</if>>
		<<else>>
			<<if _p.where is "carried">>당신의 슬라임, 그 슬라임은<<else>>그 슬라임은<</if>>
		<</if>>
		꽤 <<if _mgLooks is "hungry">><span class="orange">배고파 보인다!</span><<else>><span class="green">건강해 보인다!</span><</if>>
	<</if>>
	<br><br>
	<<petCard $petCareTarget>>
	<<if _s.sick>>
		<span class="red">아프다</span>. 마지막으로 먹은 것 때문에 몸이 안 좋아진 모양이다.
		<br><br>
	<</if>>

	<<if _def.diet is "feed">>
		<<set _m to Menagerie.state()>>
		<span @class="_m.feed gt 0 ? 'gold' : 'red'">사료:</span> <<= _m.feed>>
		<<if _m.premiumFeed gt 0>>
			&nbsp;<span class="green">고급:</span> <<= _m.premiumFeed>>
		<</if>>
		<br>
		<<if _m.feed gt 0>>
			<<link [[먹이를 준다|Pet Feed]]>><<set $petFeedPremium to false>><</link>>
			<br>
		<</if>>
		<<if _m.premiumFeed gt 0>>
			<<link [[고급 사료를 먹인다|Pet Feed]]>><<set $petFeedPremium to true>><</link>>
			<br>
		<</if>>
		<<if _m.feed lte 0 and _m.premiumFeed lte 0>>
			<span class="red">먹일 것이 없다.</span>
			<br>
		<</if>>
	<<else>>
		/* A slime lives on what you produce, so feeding it is the encounter, and it can have
		   one whenever it needs one. The snake's is a separate thing it has to want, once a day. */
		<<link [[먹이를 준다|Pet Intimacy]]>><</link>>
		<br>
	<</if>>

	<<if Menagerie.playBlock($petCareTarget) is "">>
		<<link [[함께 논다|Pet Play]]>><</link>>
		<br>
	<</if>>

	<<if _def.diet is "feed" and Menagerie.intimacyBlock($petCareTarget) is "" and !$daily.petIntimacy>>
		<<link [[몸 위를 기어 다니게 둔다|Pet Intimacy]]>><<set $daily.petIntimacy to true>><</link>>
		<br>
	<</if>>

	<<if _p.where is "carried">>
		<<link [[다시 넣어 둔다|Pet Stow]]>><</link>>
		<br>
	<<elseif Menagerie.canCarry($petCareTarget)>>
		<<link [[데리고 다닌다|Pet Carry]]>><</link>>
		<br>
	<<elseif Menagerie.carried()>>
		<span class="red">이미 반려동물을 데리고 다니고 있다.</span>
		<br>
	<</if>>

	<br>
	<<link [[뒤로|Bedroom]]>><</link>>
<</if>>
<br>

:: emptySnakeTank
<<set $outside to 0>><<effects>>
당신은 아직 동물을 기다리고 있는 빈 테라리움으로 걸어간다.
<br><br>
<<link [[뒤로|Bedroom]]>><</link>>
<br>

:: Pet Feed
<<set $outside to 0>><<effects>>
<<set _def to Menagerie.speciesDef($petCareTarget)>>
<<set _s to Menagerie.status($petCareTarget)>>
<<if Menagerie.feed($petCareTarget, $petFeedPremium)>>
	<<if _def.diet is "feed">>
		당신은 침대 끝에 놓인 <<if $petFeedPremium>>고급 <</if>>사료 봉지를 열고, 간 고기로 만든 붉은 알갱이 몇 개를 꺼낸다.
		<<if _s.where is "carried">>
			당신은 어깨를 감고 있는 <<= _s.label>>에게 알갱이를 내민다. 그것은 쉭쉭거리다가 당신의 손에서 알갱이를 받아 하나씩 삼킨다.
		<<else>>
			당신은 알갱이를 테라리움에 떨어뜨린다. 당신의 <<= _s.label>>【이가】 알갱이 쪽으로 미끄러져 가서 하나씩 삼킨다.
		<</if>>
	<</if>>
<<else>>
	<span class="red">먹일 것이 없다.</span>
<</if>>
<br><br>
<<link [[다음|Pet Care]]>><</link>>
<br>

:: Pet Play
<<set $outside to 0>><<effects>>
<<set _s to Menagerie.status($petCareTarget)>>
<<if Menagerie.play($petCareTarget)>>
	<<if $petCareTarget is "snake">>
		당신은 <<= _s.label>>【을를】 두 손으로 들고 손가락 사이를 기어 다니게 둔다. 비늘이 피부에 차갑고 건조하게 닿는다. 뱀은 당신의 손목을 감고 혀를 날름거리며 그대로 쉰다.
	<<else>>
		당신은 <<= _s.label>>【을를】 손가락으로 지그시 눌러 살며시 쥔다. 몸이 당신의 두 손 둘레에서 모양을 바꾸며 부드럽게 꾸르륵 소리를 낸다. 작고 검은 눈이 당신을 올려다본다.
	<</if>>
	<br><br>
	<<if _s.bond gte 70>>
		<span class="green">당신 곁에 있는 걸 좋아한다.</span>
	<<elseif _s.bond gte 45>>
		<span class="teal">당신의 손 쪽으로 더 다가온다.</span>
	<<elseif _s.bond gte 20>>
		<span class="lblue">당신과 점점 편해지고 있다.</span>
	<<else>>
		<span class="purple">당신이 만지게 내버려 둔다.</span>
	<</if>>
<</if>>
<br><br>
<<link [[다음|Pet Care]]>><</link>>
<br>

:: Pet Carry
<<set $outside to 0>><<effects>>
<<set _def to Menagerie.speciesDef($petCareTarget)>>
<<set _s to Menagerie.status($petCareTarget)>>
<<if Menagerie.carry($petCareTarget)>>
	<<if $petCareTarget is "snake">>
		당신이 사육장에 손을 넣자 <<= _s.label>>【이가】 쉭쉭거리며 당신의 팔을 감고 목까지 미끄러져 올라간다.
	<<else>>
		당신은 꾸르륵거리는 동반자가 들어 있던 유리병을 집어 들고 천천히 뚜껑을 돌려 연다.
		뚜껑이 열리자 <<= _s.label>>【이가】 병 밖으로 기어 나와 팔을 타고 내려오더니, 당신의 발 쪽으로 흘러가 그곳에 달라붙는다.
	<</if>>
	<br><br>
	<<if _s.bond gte Menagerie.Tuning.supportMinBond>>
		이제 당신을 충분히 알아서 <span class="green">당신이 위협받으면 나설지도 모른다</span>.
	<<else>>
		<span class="purple">아직 당신을 충분히 알지 못해</span> 상황이 나빠져도 별 도움이 되지 못할 것이다.
	<</if>>
<</if>>
<br><br>
<<link [[다음|Bedroom]]>><</link>>
<br>

:: Pet Stow
<<set $outside to 0>><<effects>>
<<set _s to Menagerie.status($petCareTarget)>>
<<if Menagerie.stow($petCareTarget)>>
	<<if $petCareTarget is "snake">>
		당신은 두 손으로 뱀을 받치며 목에서 풀어 낸다. 사육장에 내려놓는 동안 뱀이 쉭쉭거린다.
	<<else>>
		당신은 몸을 숙여 발에서 <<= _s.label>>【을를】 떼어 낸다.
		그것은 당신이 떼어 내는 동안 꾸르륵거리며 손과 발 사이로 늘어난다. 전부 들어 올린 뒤에 당신은 그것을 유리병에 내려놓는다.
		<br><br>
		슬라임은 당신이 뚜껑을 다시 닫는 동안 병 안에서 꿈틀거리며 작은 눈을 당신 쪽으로 돌린다.
	<</if>>
<</if>>
<br><br>
<<link [[다음|Bedroom]]>><</link>>
<br>

:: Pocket Feed Pet
<<effects>>
<<set _petFoodBack to $petFoodReturn or "Bedroom">>
<<if $petFoodResult>>
	<<set _r to $petFoodResult>>
	<<set _food to setup.foodstuff[_r.key].singular>>
	<<set _pet to Menagerie.carried()>>
	<<set _snake to _pet and _pet.species is "snake">>
	<<switch _r.verdict>>
		<<case "eat">>
			<<if _snake>>
				당신은 <<= _r.label>>에게 <<= _food>> 한 조각을 내민다. 그것은 덥석 물어 삼킨다.
			<<else>>
				당신은 <<= _food>>【을를】 <<= _r.label>> 안에 넣는다. 그것이 음식을 감싸더니 아무것도 남지 않을 때까지 오므린다.
			<</if>>
			<br><br>
			<span class="green">당분간은 이거면 배가 찰 것이다.</span>
		<<case "sick">>
			<<if _snake>>
				당신은 <<= _r.label>>에게 <<= _food>> 한 조각을 내민다. 그것은 먹기는 하지만, 곧 당신의 손 위로 토해 내고는 가만히 누워 버린다.
			<<else>>
				당신은 <<= _food>>【을를】 <<= _r.label>> 안에 넣는다. 그것이 음식을 감싸더니 당신의 팔 위로 다시 밀어낸다. 몸이 흐려지고 눈이 보이지 않게 된다.
			<</if>>
			<br><br>
			<span class="red">아파 보인다</span>. 회복할 시간이 필요할 것이다.
		<<default>>
			<<if _snake>>
				당신은 <<= _r.label>>에게 <<= _food>> 한 조각을 내민다. 그것은 공기 냄새를 맡더니 고개를 돌리고 먹기를 거부한다.
			<<else>>
				당신은 <<= _r.label>>에게 <<= _food>>【을를】 내민다. 그것이 당신의 손에서 물러나며 거부한다.
			<</if>>
			<br>
			<span class="purple">그 음식을 원하지 않는다.</span>
	<</switch>>
	<br><br>
	<<link [[다음|_petFoodBack]]>>
		<<unset $petFoodResult $petFoodReturn>>
	<</link>>
<<else>>
	아무 일도 일어나지 않는다.
	<br><br>
	<<link [[다음|_petFoodBack]]>>
		<<unset $petFoodReturn>>
	<</link>>
<</if>>
<br>

:: Pet Recovered
<<effects>>
<<set _mgS to Menagerie.status($petRecoverTarget)>>
<<set _mgCause to _mgS.lostCause>>
<<run Menagerie.recover($petRecoverTarget)>>
<<if _mgCause is "drowned">>
	그것은 얕은 물속에 반쯤 수면 위로 드러난 채 누워 있다. 움직이지 않아서, 죽은 것 같기도 하다.
	<br><br>
	<<if $petRecoverTarget is "snake">>
		그때 몸이 살짝 움직인다. 당신은 물에서 뱀을 건져 올린다. 뱀은 너무 차갑고 지쳐서 당신을 감지도 못한 채 두 손 위에 힘없이 늘어진다.
	<<else>>
		그때 슬라임이 살짝 움직인다. 당신은 물에서 슬라임을 퍼 올려 손바닥에 올린다. 몸은 얇고 힘이 없으며, 표면에 눈이 천천히 떠오른다.
	<</if>>
<<elseif $petRecoverTarget is "snake">>
	당신은 쭈그려 앉아 팔을 내민다. 뱀은 혀로 공기를 날름거리며 가만히 있다. 몇 초 뒤 뱀이 당신의 손목으로 기어올라 팔을 따라 움직인다.
<<else>>
	당신은 쭈그려 앉아 손을 내민다. 슬라임은 잠시 기다리다가 당신의 손가락을 타고 손바닥 안으로 들어온다. 표면에 작고 검은 눈 두 개가 나타나 당신을 바라보며 조용히 꾸르륵거린다.
<</if>>
<br><br>
<<if _mgCause is "drowned">>
	<span class="red">굶주려서 몹시 약해져 있다.</span>
	회복하려면 며칠 동안 먹이와 보살핌이 필요할 것이다. 돌보기를 그만두면 다시 떠날 수도 있다.
<<elseif _mgCause is "neglect">>
	당신이 돌보기를 그만두어서 떠났지만, <span class="purple">그래도 돌아왔다</span>.
<<elseif _mgCause is "swept">>
	전보다 말랐고 여전히 차갑지만, <span class="green">살아 있다</span>.
<<else>>
	<span class="green">전보다 말랐지만, 살아 있다.</span>
<</if>>
집에 돌아오면 당신은 그것을 다시 사육장에 넣는다.
<br><br>
<<link [[다음|$petRecoverReturn]]>><</link>>
<br>

:: Pet Intimacy
<<set $outside to 0>><<effects>>
<<set _def to Menagerie.speciesDef($petCareTarget)>>
<<set _s to Menagerie.status($petCareTarget)>>
<<if _def.diet is "feed" and Menagerie.intimacyBlock($petCareTarget) isnot "">>
	관심이 없는 것 같다.
	<br><br>
	<<link [[뒤로|Pet Care]]>><</link>>
<<elseif _def.diet is "fluids" and playerChastity("hidden")>>
	당신의 <<= _s.label>>【이가】 당신의 사타구니에 몸을 대 보다가 포기한다. 정조대 때문에 먹이를 먹을 수 없다.
	<br><br>
	<<link [[뒤로|Pet Care]]>><</link>>
<<else>>
	<<if $petCareTarget is "snake">>
		당신은 <<= _s.label>>【을를】 꺼내 마음대로 움직이게 둔다. 그것은 당신의 쇄골 위를 미끄러지다가, 혀를 피부에 날름거리며 몸을 따라 내려가기 시작한다.
	<<elseif _s.where is "carried">>
		<<strip>>
		당신은 손을 뻗어 반려 슬라임을 집어 들고 바닥에 살며시 내려놓은 다음, 옷을 벗고 누워 그것을 기다린다. <<= _s.label>>【이가】 당신 위로 기어올라 피부 위로 퍼진다.
		<br><br>
		그것은 배가 고파서 당신의 몸에서 촉촉한 곳을 향해 움직이며 먹기 시작한다.
	<<else>>
		<<strip>>
		당신은 손을 뻗어 병뚜껑을 돌려 열고, 사랑스러운 슬라임이 기어 나오게 한다. 슬라임이 바닥에 닿자 당신은 옷을 모두 벗고, <<= _s.label>>【이가】 당신의 피부 위로 퍼진다.
		<br><br>
		그것은 배가 고파서 당신의 몸에서 촉촉한 곳을 향해 움직이며 먹기 시작한다.
	<</if>>
	<br><br>
	<<link [[다음|Pet Intimacy Swarm]]>><<set $swarmstart to 1>><</link>>
<</if>>
<br>

:: Pet Intimacy Swarm
<<if $swarmstart is 1>>
	<<unset $swarmstart>>
	<<set $combat to 1>>
	<<set $enemytype to "swarm">>
	<<consensual>>
	<<set $consensual to 1>>
	<<set $petEncounter to 1>>
	<<set $nochoke to 1>>
	<<if $petCareTarget is "snake">>
		<<swarminit "snakes" "뱀" "미끄러지듯 움직인다" "몸을 휘감는다" "밀어낸다" 1 0>>
	<<else>>
		<<swarminit "slimes" "슬라임" "꿈틀거리며 흐른다" "퍼져 나간다" "밀어낸다" 1 0>>
	<</if>>
	<<set $petIntimacyOrgasms to $orgasmcount>>
	<<set $petIntimacyTurns to 0>>
<</if>>
<<effects>>
<<set $petIntimacyTurns += 1>>
<<if $swarm.amount.chest lte 0 and $swarm.amount.genital[0] lte 0 and $swarm.amount.genital[1] lte 0 and $swarm.amount.butt[0] lte 0 and $swarm.amount.butt[1] lte 0 and $swarm.amount.active[4] gte 1>>
	<<set $swarm.amount.genital[0] to $swarm.amount.active[4]>>
	<<set $swarm.amount.active[4] to 0>>
<</if>>
<<swarmeffects>>
<<if $swarm.amount.genital[1] gte 1 and !playerChastity("hidden")>>
	<<arousal `Menagerie.Tuning.intimacyArousal` "genitals">>
<</if>>
<<swarm>>
<<swarmactions>>
<<if breederOrgasmDenied() and $orgasmcount lte $petIntimacyOrgasms>>
	<span class="pink">이것으로는 당신의 몸이 원하는 것을 얻을 수 없다.</span>
	<br><br>
<</if>>
<<if $orgasmcount gt $petIntimacyOrgasms or $petIntimacyTurns gte Menagerie.Tuning.intimacyTurns>>
	<span id="next"><<link [[다음|Pet Intimacy End]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Pet Intimacy Swarm]]>><</link>></span><<nexttext>>
<</if>>

:: Pet Intimacy End
<<set $outside to 0>><<effects>>
<<set _r to Menagerie.intimacyEnd($petCareTarget, $orgasmcount gt $petIntimacyOrgasms)>>
<<if _r>>
	<<if _r.satisfied>>
		<<if $petCareTarget is "snake">>
			당신의 <<= _r.label>>【이가】 멈추고 당신의 허벅지 옆에 몸을 말고 쉰다.
		<<else>>
			마침내 끝나자 슬라임이 통통 튀며 기쁜 듯 꾸르륵거린다.
			<br><br>
			당신의 <<= _r.label>>【이가】 당신에게서 미끄러져 내려와 마룻바닥에 자리를 잡는다. 슬라임이 아직 당신의 다리를 무릎까지 덮고 있다.
		<</if>>
	<<else>>
		<<if $petCareTarget is "snake">>
			당신의 <<= _r.label>>【이가】 시도를 그만두고 당신에게서 떨어져 따뜻한 곳을 찾아 떠난다.
		<<else>>
			당신의 <<= _r.label>>【이가】 당신에게서 미끄러져 내려와 마룻바닥 위로 퍼진다. 아직 배가 고프다.
		<</if>>
	<</if>>
	<br><br>
	<<if _r.fed>>
		<span class="gold">한동안은 먹이를 주지 않아도 된다.</span>
		<br>
	<<elseif $petCareTarget is "slime">>
		<span class="purple">아직 배가 고프다.</span>
		<br>
	<</if>>
	<<if _r.satisfied>>
		<span class="green">전보다 당신을 더 믿게 되었다.</span>
	<<else>>
		<span class="green">전보다 당신을 조금 더 믿게 되었다.</span>
	<</if>>
<</if>>
<<endcombat>><<clotheson>>
<<link [[다음|Bedroom]]>><</link>>
<br>
