:: Menagerie Widgets [widget]
/* Thin bridge between twee and Menagerie (01-menagerie.js). No game logic lives here. */

<<widget "petSync">>
	<<run Menagerie.sync()>>
<</widget>>

<<widget "petCard">>
	<<= Menagerie.petCardHtml(_args[0])>>
<</widget>>

<<widget "petIcon">>
	<<set _mgP to Menagerie.getPet(_args[0])>>
	<<set _mgDef to Menagerie.speciesDef(_args[0])>>
	<<if _mgP and _mgP.where is "home">>
		<<icon _mgDef.icon(_mgP.colour)>>
	<<else>>
		<<icon _mgDef.emptyIcon>>
	<</if>>
<</widget>>

<<widget "pet-combat-support">>
	<<if Menagerie.exists()>>
		<<set _mgPlan to Menagerie.combatSupport()>>
		<<if _mgPlan>>
			<<set _mgIndexWas to $index>>
			<<personselect _mgPlan.target>>
			<<set _mgNamed to namedNpcInSlot(_mgPlan.target)>>
			<br>
			<<if _mgPlan.act is "bolt">>
				<<petBolts _mgPlan>>
			<<else>>
				<<petAttacks _mgPlan _mgNamed>>
				<<petAttackReaction _mgPlan _mgNamed>>
			<</if>>
			<br><br>
			<<personselect _mgIndexWas>>
		<</if>>
	<</if>>
<</widget>>

<<widget "petBolts">>
	<<set _b to _args[0]>>
	<<if _b.species is "snake">>
		당신의 <<= _b.label>>【이가】 <span class="red">목에서 재빨리 미끄러져</span> 바닥으로 떨어진다.
		그것은 당신이 붙잡기 전에 소리에서 멀어지며 기어간다.
	<<else>>
		<span class="red">당신의 <<= _b.label>>【이가】 발에서 재빨리 미끄러져</span> 바닥으로 떨어진다.
		그것은 당신이 붙잡기 전에 소음에서 멀어져 움직인다.
	<</if>>
	<br>
	<span class="purple">당신을 충분히 알지 못해</span> 이런 소동 한가운데에 머물지 못한다.
<</widget>>

<<widget "petAttacks">>
	<<set _a to _args[0]>>
	<<if _a.act is "strike">>
		당신의 <<= _a.label>>【이가】 어깨에서 뛰어올라 <span class="green"><<if _args[1]>><<= _args[1]>><<else>><<person>><</if>>【을를】 송곳니로 문다.</span>
		<<if $enemyno gte 2>>
			<<set _thedamage to _a.power>>
			<<npcdamage _a.target>>
			<<set $enemyhealth -= _a.power>>
		<<else>>
			<<set $enemyhealth -= _a.power>>
			<<if $NPCList[_a.target] and Number.isFinite(Number($NPCList[_a.target].health))>>
				<<set $NPCList[_a.target].health to Math.max(0, Number($NPCList[_a.target].health) - _a.power)>>
			<</if>>
		<</if>>
	<<else>>
		당신의 <<= _a.label>>【이가】 발에서 튀어 올라 <<if _args[1]>><<= _args[1]>>의<<else>><<persons>><</if>> <span class="green">얼굴을 후려친다</span>.
		<<if $enemyno gte 2>>
			<<set _thedamage to _a.power>>
			<<npcdamage _a.target>>
			<<set $enemyhealth -= _a.power>>
		<<else>>
			<<set $enemyhealth -= _a.power>>
			<<if $NPCList[_a.target] and Number.isFinite(Number($NPCList[_a.target].health))>>
				<<set $NPCList[_a.target].health to Math.max(0, Number($NPCList[_a.target].health) - _a.power)>>
			<</if>>
		<</if>>
		<<if $pain gt 0>>
			<br>
			<span class="teal">스트레스가 줄어든다.</span><<lstress>><<stress -3>>
		<</if>>
	<</if>>
<</widget>>

<<widget "menagerieSocial">>
	<<if Menagerie.exists() and Menagerie.allPets().length>>
		<br>
		<span class="gold">반려동물</span>
		<div id="menagerie-relations" class="relation-box-list">
			<<= Menagerie.socialHtml()>>
		</div>
	<</if>>
<</widget>>

<<widget "petRunaway">>
	<<petSync>>
	<<set _mgFleds to Menagerie.takeFlightReports()>>
	<<if _mgFleds.length>>
		<<for _mgFled range _mgFleds>>
			<<if _mgFled.species is "snake">>
				<<if _mgFled.from is "carried">>
					당신이 방에 들어서자 <<= _mgFled.label>>【이가】 쉭쉭거리며 흥분해서 당신을 문다. 당신은 본능적으로 움찔하며 뒤로 넘어지고, 다시 눈을 떴을 때는 뱀이 더는 목에 없다.
					<br><br>
					당신은 뱀의 꼬리가 창문을 빠져나가 덤불 속으로 사라지기 직전의 모습을 간신히 본다.
				<<else>>
					당신이 방에 들어서니 테라리움 뚜껑이 밀려 열려 있다. <<= _mgFled.label>>【은는】 어디에도 보이지 않는다.
				<</if>>
			<<else>>
				<<if _mgFled.from is "carried">>
					당신이 방에 들어서자 <<= _mgFled.label>>【이가】 발에서 떨어지고, 당신이 붙잡을 틈도 없이 슬라임이 마룻바닥 틈으로 스며들어 사라진다.
				<<else>>
					당신이 방에 들어서니 슬라임이 든 병의 뚜껑이 바닥에 놓여 있다. 사랑하는 슬라임 동반자는 어디에도 보이지 않는다.
				<</if>>
			<</if>>
			<br><br>
		<</for>>
		<<link [[다음|Bedroom]]>><</link>>
		<br>
		<<exitAll>>
	<</if>>
<</widget>>

<<widget "petRoomLinks">>
	<<petSync>>
	<<for _mgPet range Menagerie.petsAtHome()>>
		<<capture _mgPet>>
			<<petIcon _mgPet.species>><<link `(({ blue: "파란", red: "빨간", brown: "갈색", green: "초록", pink: "분홍", purple: "보라", teal: "청록", yellow: "노란", orange: "주황", gray: "회색" })[_mgPet.colour] || _mgPet.colour) + " " + (({ snake: "뱀", slime: "슬라임" })[_mgPet.species] || Menagerie.speciesDef(_mgPet.species).name)` "Pet Care">><<set $petCareTarget to _mgPet.species>><</link>>
		<</capture>>
		<br>
	<</for>>
	<<if Menagerie.exists() and Menagerie.state().terrarium and !Menagerie.owned("snake")>>
		<<icon "pet/emptysnaketank.png">><<link [[빈 테라리움|emptySnakeTank]]>><</link>>
		<br>
	<</if>>
	<<set _mgCarried to Menagerie.carried()>>
	<<if _mgCarried>>
		<<petIcon _mgCarried.species>><<link `"당신의 " + (({ blue: "파란", red: "빨간", brown: "갈색", green: "초록", pink: "분홍", purple: "보라", teal: "청록", yellow: "노란", orange: "주황", gray: "회색" })[_mgCarried.colour] || _mgCarried.colour) + " " + (({ snake: "뱀", slime: "슬라임" })[_mgCarried.species] || Menagerie.speciesDef(_mgCarried.species).name)` "Pet Care">><<set $petCareTarget to _mgCarried.species>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "petShopClerk">>
	<<endevent>>
	<<if $per_npc.pet_shop_clerk>>
		<<loadNPC 0 pet_shop_clerk>>
	<<else>>
		<<generate1>><<saveNPC 0 pet_shop_clerk>>
	<</if>>
	<<person1>>
<</widget>>

<<widget "petClerkAction">>
	<<if $fame.bestiality gte 600>>
		<<switch random(1, 4)>>
			<<case 1>>
				점원이 바닥을 쓸고 있다. <<He>>【은는】 당신이 다가오자 올려다보고 얼굴을 찌푸린다.
			<<case 2>>
				점원이 카운터 뒤에 없다. 당신은 <<he>>【이가】 가게를 뛰어다니며 동물들에게 먹이를 주고 있는 것을 본다. 오래지 않아 <<he>>【은는】 돌아온다.
			<<case 3>>
				당신이 카운터에 다가가니 점원이 없다. 주위를 둘러보니 <<he>>【이가】 근처에서 선반을 채우고 있다. 카운터에 있는 당신을 알아본 <<He>>【은는】 노려본다. <<He>>【은는】 일을 천천히 마치고 나서야 느릿느릿 다가온다.
			<<default>>
				당신이 다가오자 점원이 얼굴을 찌푸린다.
		<</switch>>
	<<else>>
		<<switch random(1, 4)>>
			<<case 1>>
				점원이 바닥을 쓸고 있다. <<He>>【은는】 당신이 다가오자 올려다보고 미소 짓는다.
			<<case 2>>
				점원이 카운터 뒤에 없다. 당신은 <<he>>【이가】 가게를 뛰어다니며 동물들에게 먹이를 주고 있는 것을 본다. 오래지 않아 <<he>>【은는】 돌아온다.
			<<case 3>>
				당신이 카운터에 다가가니 점원이 없다. 주위를 둘러보니 <<he>>【이가】 근처에서 선반을 채우고 있다. <<He>>【은는】 카운터에 있는 당신을 알아보고 손을 흔들며, 선반에 마지막 물건 하나를 올려놓고 서둘러 다가온다.
			<<default>>
				점원이 당신이 카운터에 다가오자 미소 짓는다.
		<</switch>>
	<</if>>
<</widget>>

<<widget "petClerk">>
	<<if $fame.bestiality gte 600>>
		"<<print either(
			"아, 너구나. 뭘 원해?",
			"또 너야? 허튼짓하면 경비를 부를 거야.",
			"이제 '빨간 로켓' 말고 다른 걸 찾는 모양이지?",
			"내가 널 도와줘야 안 잘리니까 고마운 줄 알아.",
			"내 동물 중 하나라도 건드리면 네 시체는 아무도 못 찾게 해 줄 거야.",
			"뭘 원해, 짐승이랑 붙어먹는 변태야?",
			"또 트라우마 안겨 줄 동물을 찾으러 왔어? 다른 데나 가 봐, 이 정신 나간 인간아.",
			"지켜보고 있으니까, 동물들한테서 3미터 안으로는 오지 마.",
			"또 왔어? 그 역겨운 하렘에 불쌍한 동물 하나 더 끼워 넣으러?",
			"짐승한테 그렇게 박히고 싶으면 숲에 가서 길이나 잃어.")>>"
	<<else>>
		"<<print either(
			"찾으시는 건 다 있나요?",
			"특별히 찾으시는 게 있나요?",
			"오늘은 무엇을 도와드릴까요?",
			"하이 가 애완동물 가게에 오신 걸 환영합니다!",
			'"뭘 도와줄까?"',
			"안녕하세요! 파충류 코너는 보셨어요?",
			"안녕하세요! 오늘 반려동물을 입양해 보시겠어요?",
			"어서 오세요! 시끄러워서 죄송해요, 동물들이 가끔 좀 시끄럽거든요.")>>"
	<</if>>
<</widget>>

<<widget "garterNpc">>
	<<endevent>>
	<<if $per_npc.garter>>
		<<loadNPC 0 garter>>
	<<else>>
		<<generate1>><<saveNPC 0 garter>>
	<</if>>
	<<person1>>
<</widget>>

<<widget "garterFee">>
	<<menagerieShopPrice _args[0]>>
	<<if $money gte _mgPrice>>
		<<link `"지불한다 (" + formatMoney(_mgPrice) + ")"` "garterPaid">><<set $money -= _mgPrice>><</link>>
	<<else>>
		<span class="red">요구하는 값을 낼 돈이 없다.</span>
	<</if>>
	<br>
<</widget>>

<<widget "petRecoveryLinks">>
	<<if Menagerie.exists()>>
		<<petSync>>
		<<for _mgPet range Menagerie.lostAt(_args[0])>>
			<<capture _mgPet>>
				<br>
				<<switch _args[0]>>
					<<case "lake">>
						당신은 얕은 물속에서 움직이는 <span class="purple">잃어버린 반려동물</span>을 발견한다.
					<<case "ubm">>
						당신은 사육장 중 하나 안에서 움직이는 <span class="purple">잃어버린 반려동물</span>을 발견한다.
					<<default>>
						당신은 식물 사이를 지나가는 <span class="purple">잃어버린 반려동물</span>을 발견한다.
				<</switch>>
				<br>
				<<link `(({ blue: "파란", red: "빨간", brown: "갈색", green: "초록", pink: "분홍", purple: "보라", teal: "청록", yellow: "노란", orange: "주황", gray: "회색" })[_mgPet.colour] || _mgPet.colour) + " " + (({ snake: "뱀", slime: "슬라임" })[_mgPet.species] || Menagerie.speciesDef(_mgPet.species).name) + "에게 다가간다"` "Pet Recovered">>
					<<set $petRecoverTarget to _mgPet.species>>
					<<set $petRecoverReturn to $passage>>
				<</link>>
				<br>
			<</capture>>
		<</for>>
	<</if>>
<</widget>>

<<widget "garterCabinLink">>
	<<if Menagerie.exists() and (Menagerie.state().note or $garter)>>
		<<icon "shop-hunt/moldering-hutch.png">>
		<<if Time.dayState is "night" or Time.dayState is "dusk">>
			<<link [[수상한 오두막 (0:10)|MysteriousCabin]]>><<pass 10>><</link>>
		<<else>>
			<<link [[수상한 오두막 (0:10)|garterGone]]>><<pass 10>><</link>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "petCombatEnd">>
	<<if Menagerie.exists()>>
		<<set _mgEnd to Menagerie.combatEnd()>>
		<<if _mgEnd>>
			<br>
			<<if _mgEnd.outcome is "fled">>
				<span class="red">당신의 <<= _mgEnd.label>>【이가】 달아나 도망쳤다.</span>
			<<else>>
				<span class="red">당신이 막지 못하는 사이 누군가 당신의 <<= _mgEnd.label>>【을를】 데려갔다.</span>
			<</if>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "petSwimPanic">>
	<<if Menagerie.exists()>>
		<<set _mgSwim to Menagerie.swimPanic()>>
		<<if _mgSwim>>
			<br>
			<<switch _mgSwim.outcome>>
				<<case "thrash">>
					당신의 <<= _mgSwim.label>>【은는】 <span class="red">물에 들어가자마자 공황에 빠진다</span>.
					그것이 당신의 품에서 발버둥치며 날뛴다. 당신은 가까스로 붙들고 있지만, 그것이 빠져나가려다 당신을 다치게 한다.
					<<pain `Menagerie.Tuning.swimThrashPain`>><<ggpain>>
				<<case "swept">>
					당신의 <<= _mgSwim.label>>【이가】 공황에 빠져 <span class="red">당신의 팔에서 빠져나간다</span>.
					당신이 손을 뻗지만 놓친다. 수면 위로 올라왔을 때, 어디에서도 그것이 보이지 않는다.
					<<stress 6>><<gstress>>
				<<case "drown">>
					당신의 <<= _mgSwim.label>>【이가】 공황에 빠져 발버둥치다가 <span class="red">갑자기 멈춘다</span>.
					당신은 뒤따라 잠수하지만 찾지 못한다. 그것은 물속으로 사라졌고, 당신은 마지막으로 본 자리에 머문다.
					<<stress 20>><<gggstress>><<trauma 6>><<gtrauma>>
				<<default>>
					당신의 <<= _mgSwim.label>>【은는】 당신이 헤엄치는 동안 꽉 매달려 있다가 당신이 물에서 나온 뒤에야 놓는다.
			<</switch>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "petAttackReaction">>
	<<set _r to _args[0]>>
	<<set _named to _args[1]>>
	<br>
	<<if _named isnot "">>
		<<petAttackNamed _r _named>>
	<<elseif _r.consensual>>
		<<switch random(1, 3)>>
			<<case 1>>
				<<He>>【은는】 재빨리 당신에게서 몸을 뺀다. "방금 뭐였어, 씨발?"
			<<case 2>>
				<<He>>【은는】 몸을 뒤로 빼고 한 손으로 물린 자국을 덮는다. "이걸 데려온 거야? 여기에?!"
			<<default>>
				<<He>>【은는】 욕을 내뱉으며 당신에게서 물러나 당신 어깨 위의 <<= _r.label>>【을를】 노려본다.
		<</switch>>
		당신은 이에 동의했다. <span class="purple">하지만 당신의 <<= _r.label>>【은는】 동의하지 않았다</span>.
	<<else>>
		<<switch random(1, 3)>>
			<<case 1>>
				<<He>>【은는】 비명을 지르며 그것을 쳐서 떼어 내려 한다. <<His>> 당신을 잡은 손아귀가 느슨해진다.
			<<case 2>>
				"씨발!" <<He>>【은는】 뒤로 물러나 두 손을 들어 얼굴을 가린다.
			<<default>>
				<<He>>【은는】 비명을 지르며 한쪽 팔을 <<himself>>【와과】 당신의 어깨 사이로 들어 올린다.
		<</switch>>
	<</if>>
<</widget>>

<<widget "petAttackNamed">>
	<<set _r to _args[0]>>
	<<switch _args[1]>>
		<<case "Whitney">>
			<<if _r.consensual>>
				휘트니가 당신에게서 홱 몸을 빼며 당신 어깨 위의 동물을 가리킨다.
				"<span class="red">장난</span>하냐. 저 씨발 것 좀 치워!"
			<<else>>
				휘트니가 소리를 지르며 재빨리 당신을 놓는다. <<nnpc_He "Whitney">>【은는】 너무 놀란 나머지 당신에게 욕할 겨를도 없이 그 동물에게서 물러선다.
			<</if>>
		<<case "Robin">>
			로빈이 비명을 지르며 물러서서 손으로 물린 곳을 누른다.
			"괘-괜찮아." <<nnpc_he "Robin">>【이가】 서둘러 말한다. <<nnpc_He "Robin">>【은는】 당신 어깨 위의 동물을 본다. "무서워서 그런 거야. 일부러 아프게 하려던 건 아니야."
		<<case "Eden">>
			에덴이 물러나 당신 어깨 위의 동물을 보더니 당신 쪽으로 몸을 돌린다.
			"하!" <<nnpc_he "Eden">>【이가】 코웃음을 친다. "적어도 여기 있는 것 중 하나는 널 지켜야 할 때를 아네."
		<<case "Kylar">>
			카일러가 비명을 지르며 재빨리 물러선다. <<nnpc_He "Kylar">>【은는】 물린 곳을 문지르더니 당신의 반려동물을 본다.
			"그-그건 널 지키려던 거야." <<nnpc_he "Kylar">>【이가】 말한다. "내가... 내가 너무 가까이 다가가는 걸 알았던 거야."
		<<case "Avery">>
			에이버리가 재빨리 물러나 당신 어깨 위의 동물을 빤히 쳐다본다.
			"저 동물은 다시는 여기에 없을 거야."
		<<case "Sydney">>
			시드니가 헉 하고 숨을 들이쉬며 즉시 당신을 놓는다. <<nnpc_He "Sydney">>【은는】 물러서서 물린 자리를 문지른다.
			"미안해요! 놀라게 하려던 건 아니었어요." <<nnpc_he "Sydney">>【이가】 동물에게 말하고는 당신을 본다. "괜찮아요?"
		<<default>>
			<<nnpc_He _args[1]>>【은는】 당신에게서 홱 몸을 빼며 욕을 내뱉고는 당신 어깨 위의 동물을 쳐다본다.
	<</switch>>
	<<if _r.consensual>>
		<br>
		당신은 이에 동의했다. <span class="purple">하지만 당신의 <<= _r.label>>【은는】 동의하지 않았다</span>.
	<</if>>
<</widget>>

<<widget "menagerieShopPrice">>
	<<set _mgPrice to setup.inflation ? setup.inflation.price(_args[0]) : _args[0]>>
<</widget>>

<<widget "menagerieShop">>
	<<petSync>>
	<<set _mgM to Menagerie.state()>>
	<<set _mgT to Menagerie.Tuning>>
	<<set _mgSnakeBase to $fame.bestiality gte 600 ? _mgT.snakePriceFamous : _mgT.snakePrice>>
	__파충류와 용품:__
	<br>
	<<if !_mgM.terrarium>>
		<<menagerieShopPrice _mgT.terrariumPrice>>
		<<if $money gte _mgPrice>>
			<<icon "pet/emptysnaketank.png">><<link [[테라리움 구매 (<<printprice _mgT.terrariumPrice>>)|Pet Shop Terrarium]]>><</link>>
		<<else>>
			<<ind>><span class="red">테라리움을 살 돈이 부족하다 (<<printprice _mgT.terrariumPrice>>).</span>
		<</if>>
		<br>
	<<else>>
		<<if Menagerie.owned("snake")>>
			<<ind>><span class="green">집에 이미 뱀이 있다.</span>
			<br>
		<<else>>
			<<menagerieShopPrice _mgSnakeBase>>
			<<if $money gte _mgPrice>>
				<<icon "pet/bluesnaketank.png">><<link [[뱀 구매 (<<printprice _mgSnakeBase>>)|Pet Shop Snakes]]>><</link>>
			<<else>>
				<<ind>><span class="red">뱀을 살 돈이 부족하다 (<<printprice _mgSnakeBase>>).</span>
			<</if>>
			<br>
		<</if>>
	<</if>>
	<<menagerieShopPrice _mgT.feedPrice>>
	<<if $money gte _mgPrice>>
		<<icon "invite-fish.png">><<link [[동물 사료 구매 (<<printprice _mgT.feedPrice>>)|Pet Shop Feed]]>><</link>> | 분량: <span class="gold"><<= _mgM.feed>></span>
	<<else>>
		<<ind>><span class="red">동물 사료를 살 돈이 부족하다 (<<printprice _mgT.feedPrice>>).</span> | 분량: <span class="gold"><<= _mgM.feed>></span>
	<</if>>
	<br>
	<<if !_mgM.note and Menagerie.allPets().length and $fame.bestiality lt 600 and !$daily.petShopAsked>>
		<<investigateicon>><<link [[더 희귀한 동물에 대해 묻는다|Pet Shop Ask]]>><</link>>
		<br>
	<</if>>
<</widget>>
