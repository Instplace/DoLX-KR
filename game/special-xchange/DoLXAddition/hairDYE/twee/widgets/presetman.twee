:: Dye Harder Settings Widgets [widget]

<<widget "dhmCfgDoll">>
	<<switch _args[0]>>
		<<case "saved">>
			<<set _hairopt to "tmp0">>
		<<case "tmp">>
			<<set _hairopt to "tmp1">>
		<<default>>
			<<set _hairopt to "tmp0">>
	<</switch>>

	<div class="mannequin-inner" @style="'transform: translateX('+ $dhmod.movedoll + 'px);'">
		<<selectmodel "main" "preset1">>
		<<set _modeloptions.tanningEnabled to false>>
		<<set _modeloptions.mannequin to true>>
		<<set _modeloptions.hair_colour to _hairopt>>
		<<set _modeloptions.hair_fringe_colour to _hairopt>>
		<<set _modeloptions.show_face to false>>
		<<rendermodel "canvas-mannequin">>
	</div>
<</widget>>

<<widget "dhmCfgDollUpdate">>
	<<if _args[0] isnot undefined>>
		<<set _id to _args[0]>>
	<<else>>
		<<set _id to "saved">>
	<</if>>

	<<replace `'#presetman-mannequin-' + _id`>><<dhmCfgDoll _id>><</replace>>
<</widget>>

<!--
-- options
-- stolen —- i mean, borrowed from clothing store
-- game/overworld-town/loc-shop/clothing-v2.twee
-->

<<widget "dhmPmanBox">>
	<<if _args[0] isnot undefined>>
		<<set _id to _args[0]>>
	<<else>>
		<<set _id to "saved">>
	<</if>>

	<<switch _id>>
		<<case "saved">>
			<<set _presetList to dhmod.userPresets>>
		<<case "tmp">>
			<<set _presetList to _dhmLoaded.passed>>
	<</switch>>

	<div class="controls">
		<<capture _presetList>>
			<<if Object.keys(_presetList).length gt 0>>
				<div class="row">
					<div class="listbox">
						<<listbox `'_presetSelected' + _id` autoselect>>
							<<optionsfrom Object.keys(_presetList) >>
						<</listbox>>
					</div>
				</div>
				<div class="buttons row">
					<div @id="'rename' + _id" class="btn-rename">
						<<button "이름 변경">>
							<<run dhmShop.pmanBtnRename(T[`presetSelected${T.id}`], T.id)>>
						<</button>>
					</div>
					<div @id="'delete' + _id" class="btn-delete">
						<<button "삭제">>
							<<if confirm('프리셋 "' + T[`presetSelected${T.id}`] + '"을(를) 삭제하시겠습니까?')>>
								<<run dhmShop.pmanBtnDelete(T[`presetSelected${T.id}`], T.id)>>
							<</if>>
						<</button>>
					</div>
				</div>
			<<else>>
				프리셋 없음
			<</if>>
		<</capture>>
	</div>
<</widget>>

<<widget "dhmPresetLoader">>
	<<unset _dhmLoaded>>
	<label>
		프리셋 파일 가져오기
		<br>
		<input type="file" id="dhm-preset-loader" accept=".txt,.json" onchange="dhmShop.presetImport(this.files)" />
	</label>
<</widget>>

<<widget "dhmPresetLoaded">>
	<<dhmPresetview "tmp">>
	<hr>
	<div class="flexitem">
		<div class="row">
			<div id="dupe-report"></div>
			<label id="on-duplicate">
				<<checkbox "$dhmod.cfg.overwrite" false true autocheck>>
				이름이 겹치면 덮어쓰기 (체크하지 않으면 건너뜀)
			</label>
		</div>
		<div class="row buttons">
			<<button "가져오기 확인">>
				<<run dhmShop.onImportConfirm()>>
			<</button>>
			<<button "가져오기 취소">>
				<<replace "#presetman-loader">><<dhmPresetLoader>><</replace>>
			<</button>>
		</div>
	</div>
<</widget>>

<<widget "dhmReplaceSimilar">>
	<<replace `'#presetman-fallback' + _args[0]`>>
		<div class="flexitem">
			<div class="row">
				<<print setup.colours.hair_map[_args[1]].name_cap>>
			</div>
			<div class="row">
				<<dyeSwatch _args[1]>>
			</div>
		</div>
	<</replace>>
<</widget>>

<<widget "dhmPresetview">>
	<!-- {{{ -->
	<<if _args[0] isnot undefined>>
		<<set _id to _args[0]>>
	<<else>>
		<<set _id to "saved">>
	<</if>>

	<<capture _id>>
	<div class="subgrid">
		<div class="presetman-container flexitem">
			<div class="row">
				<table class="dhm prices">
					<tr><th>16진수:</th><td><span @id="'presetman-hex' + _id">--</span></td></tr>
					<tr><th>밝기:</th><td><span @id="'presetman-brightness' + _id">--</span></td></tr>
					<tr><th>비슷한 바닐라 색상 견본:</th><td class="swatch"><span @id="'presetman-fallback' + _id">--</span></td></tr>
				</table>
			</div>

			<div class="row" @id="'preset-dropdown-container-' + _id">
				<<dhmPmanBox _id>>
			</div>
		</div>
		
		<div class="column">
			<div @id="'doll-container-' + _id" class="no-numberify mannequin">
				<div @id="'presetman-mannequin-' + _id" class="mannequin">
					<<dhmCfgDoll _id>>
				</div>
			</div>
		</div>
	</div>
	<</capture>>
	<!-- }}} -->
<</widget>>

<<widget "dhmPresetManager">>
	<<if Object.keys(dhmod.userPresets).length gt 0>>
		<<dhmPresetview "saved">>
		<hr>
		<div class="flexitem">
			<div class="row buttons">
				<<button "저장된 프리셋 내보내기">>
					<<run dhmShop.presetExport()>>
				<</button>>
				<div class="background-red">
					<<button "저장된 프리셋 모두 삭제">>
						<<run dhmShop.pmanBtnPurge()>>
					<</button>>
				</div>
			</div>
		</div>

		<<run $(() => {
			dhmShop.pmanHook("saved");
			dhmShop.pmanOnChange(_presetSelectedsaved, "saved");
		});>>	
	<<else>>
		관리할 프리셋이 없다.
	<</if>>
<</widget>>

<<widget "dhmCfgLoad">>
	<div class="dhm">
		<div>
			<div class="settingsGrid">
				<div class="settingsHeader">염색 옵션</div>
				<div class="settingsToggleItemWide">
					<label>
						<<checkbox "$dhmod.cfg.ui" false true autocheck>>
						맞춤 UI 사용
					</label>
					<br>
					<label>
						<<checkbox "$dhmod.cfg.prices" false true autocheck>>
						맞춤 가격 사용
					</label>
				</div>
			</div>

			<div id="preset-manager" class="settingsGrid">
				<div class="settingsHeader">염색 프리셋</div>

				<div class="settingsToggleItem">
					<span class="gold bold">저장된 프리셋</span><br>
					<div id="presetman-saved">
						<<dhmPresetManager>>
					</div>
				</div>

				<div class="settingsToggleItem">
					<span class="gold bold">프리셋 가져오기</span>
					<div id="presetman-loader">
						<<dhmPresetLoader>>
					</div>
				</div>
			</div>
		</div>
	</div>
<</widget>>
